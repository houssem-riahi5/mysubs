Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي كينجدوم الموسم السادس *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:28.52,0:00:31.43,OP-Ara,,0,0,0,,اركض، اركض، ولا تلتفت لما مضى
Dialogue: 0,0:00:31.44,0:00:34.27,OP-Ara,,0,0,0,,وارقص، ارقص، حين يبلغ الحلم ذروته
Dialogue: 0,0:00:34.52,0:00:37.40,OP-Ara,,0,0,0,,لعلك تشاركني الصراخ بصوتٍ هادر يومًا
Dialogue: 0,0:00:37.69,0:00:42.53,OP-Ara,,0,0,0,,عش في نورٍ وبهاء
Dialogue: 0,0:00:45.14,0:00:50.15,OP-Ara,,0,0,0,,في نورٍ وبهاء
Dialogue: 0,0:00:53.40,0:00:57.39,OP-Ara,,0,0,0,,لا ضير إن لم تعش حياتك مزينةً بالجمال
Dialogue: 0,0:00:59.69,0:01:03.05,OP-Ara,,0,0,0,,فما الأحلام إلا نزواتٌ لا تعرف إلا نفسها
Dialogue: 0,0:01:05.06,0:01:07.03,OP-Ara,,0,0,0,,بدّد سنوات عمرك في السعي
Dialogue: 0,0:01:07.31,0:01:10.50,OP-Ara,,0,0,0,,اشتعل، ثمَّ تلاشَ، وصر ريحًا مرسلة
Dialogue: 0,0:01:10.94,0:01:13.60,OP-Ara,,0,0,0,,ليبقَ الأثر الأخير المُخلَّد
Dialogue: 0,0:01:14.06,0:01:17.06,OP-Ara,,0,0,0,,هو الحبّ ولا شيء دونه
Dialogue: 0,0:01:17.98,0:01:20.84,OP-Ara,,0,0,0,,اركض، اركض، وإياك أن تتوقّف
Dialogue: 0,0:01:20.98,0:01:23.84,OP-Ara,,0,0,0,,وارقص، ارقص، حين يبلغ الحلم ذروته
Dialogue: 0,0:01:23.94,0:01:26.82,OP-Ara,,0,0,0,,وحينها، أطلق لصرختك العنان
Dialogue: 0,0:01:27.17,0:01:29.84,OP-Ara,,0,0,0,,عش في نورٍ وبهاء
Dialogue: 0,0:01:29.97,0:01:32.84,OP-Ara,,0,0,0,,حتّى الدموع، تلمع كالنجوم وتبرق نورًا
Dialogue: 0,0:01:32.93,0:01:35.74,OP-Ara,,0,0,0,,صل أواصر المشاعر ببعضها، واحملها ملء كفيك
Dialogue: 0,0:01:35.98,0:01:38.81,OP-Ara,,0,0,0,,فأنتَ بحد ذاتك حلمٌ باهر
Dialogue: 0,0:01:39.15,0:01:40.15,OP-Ara,,0,0,0,,عش
Dialogue: 0,0:01:42.10,0:01:43.25,OP-Ara,,0,0,0,,تحلَّ بالحياة
Dialogue: 0,0:01:43.71,0:01:48.93,OP-Ara,,0,0,0,,في نورٍ وبهاء
Dialogue: 0,0:01:49.69,0:01:53.55,OP-Ara,,0,0,0,,في نورٍ وبهاء
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي كينجدوم الموسم السادس *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:23:27.35,0:23:32.60,ED-Ara,,0,0,0,,ثارت غرائزي وتردّد صداها في أعالي السماء
Dialogue: 0,0:23:33.25,0:23:38.20,ED-Ara,,0,0,0,,كما أسراب الطيور تحلق نحو الأعالي لحظة فكّ أسرها
Dialogue: 0,0:23:38.40,0:23:44.30,ED-Ara,,0,0,0,,سعيرٌ لا يعرف الخمود يتوهج بلون قرمزيّ
Dialogue: 0,0:23:45.04,0:23:50.15,ED-Ara,,0,0,0,,تخطَّ الصعاب عابرًا حدود أراضي الخصوم
Dialogue: 0,0:23:53.70,0:23:56.20,ED-Ara,,0,0,0,,تباهَ بجراحك الدامية
Dialogue: 0,0:23:59.55,0:24:02.10,ED-Ara,,0,0,0,,وهبّ واقفًا بقلبٍ يغلي متأججًا
Dialogue: 0,0:24:02.70,0:24:07.85,ED-Ara,,0,0,0,,لا تُخمد نارك الآن، ولنصرخ معًا
Dialogue: 0,0:24:08.60,0:24:13.60,ED-Ara,,0,0,0,,حتّى نقطع حبال المصير وتبرأ الروح من جسدها
Dialogue: 0,0:24:13.75,0:24:16.40,ED-Ara,,0,0,0,,أتختار درب الهلاك يمينًا أم ستمضي يسارًا؟
Dialogue: 0,0:24:16.65,0:24:19.65,ED-Ara,,0,0,0,,أم ستختار الاندثار؟
Dialogue: 0,0:24:20.25,0:24:25.40,ED-Ara,,0,0,0,,أرنا ما عقيدتك المزعومة تُؤثره
Dialogue: 0,0:24:26.20,0:24:31.40,ED-Ara,,0,0,0,,لا تُخمد نارك الآن، ولنصرخ معًا
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي صياد الشياطين *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:03:06.17,0:03:10.06,OP-Ara,,0,0,0,,في عتمة الليل دربي وحيدٌ أسير
Dialogue: 0,0:03:10.06,0:03:13.56,OP-Ara,,0,0,0,,وجهتي حُدِّدتْ وإلى صوتكِ أمضي
Dialogue: 0,0:03:13.56,0:03:17.13,OP-Ara,,0,0,0,,بين ضجيجِ المدينة العالي وقمرٍ بريقه تعالى
Dialogue: 0,0:03:17.13,0:03:20.34,OP-Ara,,0,0,0,,لم أجدكِ، فأنشدتُ لكِ لحنًا
Dialogue: 0,0:03:20.45,0:03:24.29,OP-Ara,,0,0,0,,تراءى لي أنّ الغد سيجمعنا لا محالة
Dialogue: 0,0:03:24.29,0:03:27.57,OP-Ara,,0,0,0,,...انتظرتُ بأملٍ حتّى أثخن شوقي، ولكن
Dialogue: 0,0:03:27.59,0:03:31.36,OP-Ara,,0,0,0,,ضحكتي علتْ في ذلك الميعاد
Dialogue: 0,0:03:31.36,0:03:34.20,OP-Ara,,0,0,0,,لأنّي أدركتُ أنّكِ لن تأتي
Dialogue: 0,0:03:34.67,0:03:38.94,OP-Ara,,0,0,0,,مع فيضِ هذه المشاعر الّتي تغمرني، في المطرِ بدأتُ المسير
Dialogue: 0,0:03:38.94,0:03:41.80,OP-Ara,,0,0,0,,لا تنسيني، أشعرُ أنّ دموعي وشيكةُ الانهمار
Dialogue: 0,0:03:41.80,0:03:43.83,OP-Ara,,0,0,0,,وما زالَ الظلامُ يُخيفني
Dialogue: 0,0:03:43.83,0:03:45.60,OP-Ara,,0,0,0,,خشيةَ أنْ تنساني ذاتَ يومٍ
Dialogue: 0,0:03:45.60,0:03:48.98,OP-Ara,,0,0,0,,سأجوب العالم بحثًا عنكِ مهما طال الزمان
Dialogue: 0,0:03:49.10,0:03:52.59,OP-Ara,,0,0,0,,بالرغم من أنَّ حياتي تعيسة
Dialogue: 0,0:03:52.67,0:03:56.18,OP-Ara,,0,0,0,,أليست إشراقة الفجر ساحرة؟
Dialogue: 0,0:03:56.25,0:03:59.68,OP-Ara,,0,0,0,,لنعد دائمًا ونحاول مجدّدًا
Dialogue: 0,0:03:59.80,0:04:03.98,OP-Ara,,0,0,0,,في المكان الّذي التقيتكِ فيه
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي صياد الشياطين *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:23.92,0:22:25.97,ED-Ara,,0,0,0,,كم من ليلةٍ مرّت وأنا أحصي عتمتها
Dialogue: 0,0:22:25.97,0:22:28.34,ED-Ara,,0,0,0,,حين أمضي في الدّرب الّذي جمعنا
Dialogue: 0,0:22:28.36,0:22:30.88,ED-Ara,,0,0,0,,لكلٍّ منّا قِصَصٌ نسجها الزمان
Dialogue: 0,0:22:31.05,0:22:33.62,ED-Ara,,0,0,0,,وكلٌّ منها في الروحِ ضياءٌ وسراج
Dialogue: 0,0:22:33.62,0:22:35.98,ED-Ara,,0,0,0,,وها أنا بدونكِ الآن أحيا وحيدًا
Dialogue: 0,0:22:35.98,0:22:38.74,ED-Ara,,0,0,0,,وحزني يغتني قوّةً في داخلي
Dialogue: 0,0:22:38.75,0:22:41.10,ED-Ara,,0,0,0,,مكانكِ عن عيني بعيدٌ الآن
Dialogue: 0,0:22:41.15,0:22:43.96,ED-Ara,,0,0,0,,لكن يا ليت صداي يبلغكِ أينما كنتِ
Dialogue: 0,0:22:44.02,0:22:46.53,ED-Ara,,0,0,0,,كم من دهرٍ مرّ وانسلّ على ما كان بيننا
Dialogue: 0,0:22:46.53,0:22:47.80,ED-Ara,,0,0,0,,والعجيب ما تغيّرتِ
Dialogue: 0,0:22:47.82,0:22:49.62,ED-Ara,,0,0,0,,أيّ حياةٍ دونكِ باهتةٌ لا طعم لها
Dialogue: 0,0:22:49.62,0:22:51.60,ED-Ara,,0,0,0,,للقياكِ في حياةٍ أخرى قلبي اطمأنّ
Dialogue: 0,0:22:51.60,0:22:54.79,ED-Ara,,0,0,0,,في أيّ خطٍّ للقدر سأسعى لأكون قربكِ عابرًا كلّ العوالم
Dialogue: 0,0:22:54.79,0:22:56.94,ED-Ara,,0,0,0,,سموتُ فوق الحقد وألم الفؤاد
Dialogue: 0,0:22:56.94,0:22:59.11,ED-Ara,,0,0,0,,هل بلغ قلبكِ هذا الصدى؟
Dialogue: 0,0:22:59.11,0:23:01.44,ED-Ara,,0,0,0,,غيابُكِ حاجزٌ يحولُ دون أن يبلغكِ صداي
Dialogue: 0,0:23:01.44,0:23:03.96,ED-Ara,,0,0,0,,غير أنّي ما انفككتُ بقلمي أنقشُ سيرتنا
Dialogue: 0,0:23:03.96,0:23:09.19,ED-Ara,,0,0,0,,كلّما عبرتُ ألف ليلةٍ عاد لقاؤنا يزهر
Dialogue: 0,0:23:09.29,0:23:14.38,ED-Ara,,0,0,0,,بألفِ صدىً أُناجيكِ ولغيركِ لا أُرتّل
Dialogue: 0,0:23:14.44,0:23:19.46,ED-Ara,,0,0,0,,ومع مطلع كلّ فجرٍ تدوّي مشاعري بشوقٍ
Dialogue: 0,0:23:19.52,0:23:22.66,ED-Ara,,0,0,0,,لنُدوّن معًا ألف ليلة وليلة
Dialogue: 0,0:23:22.66,0:23:25.41,ED-Ara,,0,0,0,,بلا كللٍ يمضي القلمُ في تدوينِ حكاياتنا
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة النهاية الكاملة لأنمي صياد الشياطين *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:21:20.03,0:21:24.74,ED-Ara,,0,0,0,,حُبّانِ يلتقيانِ في نسيج الزمن يتجاوران
Dialogue: 0,0:21:24.74,0:21:30.61,ED-Ara,,0,0,0,,بين ماضٍ من فرحٍ غاب وذكرى حزينة بقيتْ
Dialogue: 0,0:21:30.65,0:21:35.58,ED-Ara,,0,0,0,,صاغتنا المحبة قوّةً على المضي قدمًا بفضل وجودنا معًا
Dialogue: 0,0:21:35.58,0:21:39.87,ED-Ara,,0,0,0,,فتجاوزنا بها كلّ عثرةٍ وابتسمنا
Dialogue: 0,0:21:40.80,0:21:45.46,ED-Ara,,0,0,0,,حتّى لو كان العالم الّذي تُبصره عيناك غير عالمي
Dialogue: 0,0:21:45.85,0:21:50.79,ED-Ara,,0,0,0,,فلن يتغيّر هذا الشعور الّذي يحثني على البحث عنكِ أبدًا
Dialogue: 0,0:21:51.06,0:21:55.47,ED-Ara,,0,0,0,,حتّى وإن اتّخذ الحبّ شكلًا آخر
Dialogue: 0,0:21:55.47,0:22:00.09,ED-Ara,,0,0,0,,عساه يلامس قلبكِ أينما كنتِ
Dialogue: 0,0:22:00.09,0:22:05.38,ED-Ara,,0,0,0,,كلّما عبرتُ ألف ليلةٍ عاد لقاؤنا يزهر
Dialogue: 0,0:22:05.39,0:22:10.55,ED-Ara,,0,0,0,,بألفِ صدىً أُناجيكِ ولغيركِ لا أُرتّل
Dialogue: 0,0:22:10.56,0:22:15.62,ED-Ara,,0,0,0,,ومع مطلع كلّ فجرٍ تدوّي مشاعري بشوقٍ
Dialogue: 0,0:22:15.62,0:22:18.78,ED-Ara,,0,0,0,,لنُدوّن معًا ألف ليلة وليلة
Dialogue: 0,0:22:18.78,0:22:21.34,ED-Ara,,0,0,0,,بلا كللٍ يمضي القلمُ في تدوينِ حكاياتنا
Dialogue: 0,0:22:21.34,0:22:23.87,ED-Ara,,0,0,0,,هل هذا الألم الّذي يمزّق صدري
Dialogue: 0,0:22:23.87,0:22:26.37,ED-Ara,,0,0,0,,هو ألمٌ سببه العهد الّذي مضى وولّى؟
Dialogue: 0,0:22:26.39,0:22:28.93,ED-Ara,,0,0,0,,تائهٌ أنا أبحثُ عن أثركِ
Dialogue: 0,0:22:28.94,0:22:31.26,ED-Ara,,0,0,0,,وأنينُ كلماتي الّتي فقدت سبيلها بلا مستقرٍّ
Dialogue: 0,0:22:31.26,0:22:32.52,ED-Ara,,0,0,0,,أتصل إلى مسامعكِ؟
Dialogue: 0,0:22:32.52,0:22:33.81,ED-Ara,,0,0,0,,بلغتْني
Dialogue: 0,0:22:33.81,0:22:35.12,ED-Ara,,0,0,0,,أتتذكّرين؟
Dialogue: 0,0:22:35.12,0:22:36.29,ED-Ara,,0,0,0,,ما زلتُ أتذكّر
Dialogue: 0,0:22:36.29,0:22:41.17,ED-Ara,,0,0,0,,حتّى وإن غاب عنّي مرآكِ فإحساسي بكِ لا يغيب
Dialogue: 0,0:22:41.17,0:22:43.54,ED-Ara,,0,0,0,,تتزايدُ أبعادُ مشاعري من جديد
Dialogue: 0,0:22:43.54,0:22:46.28,ED-Ara,,0,0,0,,معًا سنعبرُ تلك الليلة ونتجاوز ظلالها
Dialogue: 0,0:22:46.28,0:22:48.59,ED-Ara,,0,0,0,,عُدَّ من واحد إلى عشرة ومن عشرة إلى مئة
Dialogue: 0,0:22:48.59,0:22:52.47,ED-Ara,,0,0,0,,وحتّى بعد مئةِ عامٍ وألفٍ أتمنّى لو ألقاكِ يا ليت
Dialogue: 0,0:22:53.47,0:22:58.90,ED-Ara,,0,0,0,,كلّما عبرتُ ألف ليلةٍ عاد لقاؤنا يزهر
Dialogue: 0,0:22:59.00,0:23:04.08,ED-Ara,,0,0,0,,بألفِ صدىً أُناجيكِ ولغيركِ لا أُرتّل
Dialogue: 0,0:23:04.14,0:23:09.18,ED-Ara,,0,0,0,,ومع مطلع كلّ فجرٍ تدوّي مشاعري بشوقٍ
Dialogue: 0,0:23:09.24,0:23:12.35,ED-Ara,,0,0,0,,لنُدوّن معًا ألف ليلة وليلة
Dialogue: 0,0:23:12.35,0:23:15.12,ED-Ara,,0,0,0,,بلا كللٍ يمضي القلمُ في تدوينِ حكاياتنا
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Tsuki ga Michibiku Isekai Douchuu الموسم الأول *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:01:06.70,0:01:09.03,OP-Ara,,0,0,0,,صدحتُ فعلًا بكلمات يُساء فهمها
Dialogue: 0,0:01:09.12,0:01:11.51,OP-Ara,,0,0,0,,بغية المجيء إلى هنا
Dialogue: 0,0:01:11.51,0:01:13.82,OP-Ara,,0,0,0,,وهذه الأغنية لُحّنت بصياحي أيضًا
Dialogue: 0,0:01:13.95,0:01:16.39,OP-Ara,,0,0,0,,هل لك أن تصدّق هذا؟
Dialogue: 0,0:01:26.25,0:01:28.64,OP-Ara,,0,0,0,,ويستمرّ مسلسل "أنا بخير" رغم كلّ شيء
Dialogue: 0,0:01:28.64,0:01:31.13,OP-Ara,,0,0,0,,رؤيتك هي ما أنشده
Dialogue: 0,0:01:31.13,0:01:33.54,OP-Ara,,0,0,0,,تلك الطرق المغتنمة المؤدية إلى ...المستقبل
Dialogue: 0,0:01:33.54,0:01:35.77,OP-Ara,,0,0,0,,أيمكنني أن أثق بها من أعماق قلبي؟
Dialogue: 0,0:01:35.77,0:01:38.91,OP-Ara,,0,0,0,,إذ إنها لا تملك قلبًا ولا ،اسمًا ولا تتحلى بذرّة فضيلة أو حكمة
Dialogue: 0,0:01:38.91,0:01:40.89,OP-Ara,,0,0,0,,!أنت !أنت سأعيدها على مسمعك مرّة أخرى
Dialogue: 0,0:01:40.89,0:01:43.59,OP-Ara,,0,0,0,,الطعام مريع رغم أنّه لا يتألّف سوى من حبوب ...الأرز
Dialogue: 0,0:01:43.59,0:01:45.29,OP-Ara,,0,0,0,,إلّا أنّ تقديمه هكذا مربح أكثر
Dialogue: 0,0:01:45.29,0:01:50.13,OP-Ara,,0,0,0,,ولكنّني لن أتأثّر بهم وسأكون صالحًا إلى أقصى حدّ
Dialogue: 0,0:01:50.13,0:01:53.07,OP-Ara,,0,0,0,,سأسير واثق الخطى في درب وعرٍ
Dialogue: 0,0:01:53.07,0:01:55.51,OP-Ara,,0,0,0,,فمهما حاولت تفادي كلماتهم فإنّ وابلها لا يتوقّف
Dialogue: 0,0:01:55.51,0:01:59.22,OP-Ara,,0,0,0,,...انتقاد وابل من النقد كالأمطار الصيفيّة
Dialogue: 0,0:01:59.36,0:02:00.35,OP-Ara,,0,0,0,,أهكذا هو الحال؟
Dialogue: 0,0:02:00.35,0:02:03.31,OP-Ara,,0,0,0,,،إذن اكتفيت منكم لذا فلتصمتوا جميعًا
Dialogue: 0,0:02:03.35,0:02:05.66,OP-Ara,,0,0,0,,الطقس صحوٌ باستثناء وقت منتصف الليل
Dialogue: 0,0:02:05.78,0:02:10.21,OP-Ara,,0,0,0,,لن أتقدّم أثناء ،الليل سأعتمد على ما يخبّئه المستقبل
Dialogue: 0,0:02:10.21,0:02:12.97,OP-Ara,,0,0,0,,حتّى وإن كانت مشاعري المتألّمة هي وقودي
Dialogue: 0,0:02:13.03,0:02:16.35,OP-Ara,,0,0,0,,موهبة الغناء مصيرها الذبول من فرط الإنهاك
Dialogue: 0,0:02:16.35,0:02:19.23,OP-Ara,,0,0,0,,أنا لا أمزح
Dialogue: 0,0:02:19.23,0:02:22.76,OP-Ara,,0,0,0,,،أجل أنا محض شخص قبيح وعالة بلا أيّ ميزةٍ
Dialogue: 0,0:02:22.76,0:02:24.93,OP-Ara,,0,0,0,,،ولكن حتّى العبقري يتمنّى أن يُعاد إحياؤه بعد موته
Dialogue: 0,0:02:24.93,0:02:28.02,OP-Ara,,0,0,0,,،إنّه المستقبل لوّح إلى المستقبل بيديك
Dialogue: 0,0:02:29.77,0:02:32.83,OP-Ara,,0,0,0,,،إنّه المستقبل لوّح إلى المستقبل بيديك
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Tsuki ga Michibiku Isekai Douchuu الموسم الأول *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:08.38,0:22:16.69,ED-Ara,,0,0,0,,لو مرّت كلّ أيّامي بسعادة
Dialogue: 0,0:22:17.36,0:22:20.10,ED-Ara,,0,0,0,,فلن أهتمّ بما يقوله غيري
Dialogue: 0,0:22:19.98,0:22:26.57,ED-Ara,,0,0,0,,التحديق بالقمر في السماء
Dialogue: 0,0:22:26.68,0:22:33.57,ED-Ara,,0,0,0,,يجعلني أحلم بالذهاب إلى هناك يومًا ما
Dialogue: 0,0:22:36.77,0:22:41.08,ED-Ara,,0,0,0,,شيءٌ مثل القدر وغيره
Dialogue: 0,0:22:41.08,0:22:43.46,ED-Ara,,0,0,0,,أريد رميَه بعيدًا، رميه بعيدًا
Dialogue: 0,0:22:43.46,0:22:45.93,ED-Ara,,0,0,0,,أريد رميَه بعيدًا فحسب
Dialogue: 0,0:22:45.93,0:22:53.39,ED-Ara,,0,0,0,,أريد المضيّ إلى ما أبعد من خيالي
Dialogue: 0,0:22:53.39,0:22:55.82,ED-Ara,,0,0,0,,أريد المضيّ أبعد من ذلك، أبعد من ذلك
Dialogue: 0,0:22:55.82,0:22:58.02,ED-Ara,,0,0,0,,أريد المضيّ أبعد من ذلك فحسب
Dialogue: 0,0:22:58.02,0:23:00.53,ED-Ara,,0,0,0,,سآخذك صحبتي
Dialogue: 0,0:23:04.17,0:23:11.86,ED-Ara,,0,0,0,,راودني حلمٌ لا ينتهي أبدًا
Dialogue: 0,0:23:11.86,0:23:14.40,ED-Ara,,0,0,0,,أريد الخروج منه، ولا أستطيع الخروج منه
Dialogue: 0,0:23:14.40,0:23:16.73,ED-Ara,,0,0,0,,لا أقوى على التغيّر، لكن ذلك غير مهمّ
Dialogue: 0,0:23:16.73,0:23:18.18,ED-Ara,,0,0,0,,فأنت لست هنا
Dialogue: 0,0:23:18.18,0:23:20.60,ED-Ara,,0,0,0,,أغمض عينيك
Dialogue: 0,0:23:20.60,0:23:26.48,ED-Ara,,0,0,0,,وانظر إذا بالفجر قد حلّ
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة البداية الأولى لأنمي Tsuki ga Michibiku Isekai Douchuu الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:27.67,0:00:32.19,OP-Ara,,0,0,0,,لو تسعفني الضحكات في التبرّم من كلِّ ما حولي
Dialogue: 0,0:00:52.57,0:00:55.15,OP-Ara,,0,0,0,,شددت الوثاق حتّى لا تتأذّى
Dialogue: 0,0:00:55.15,0:00:57.48,OP-Ara,,0,0,0,,كلماتٌ لا تعرف للألم صاحبًا
Dialogue: 0,0:00:57.48,0:01:01.38,OP-Ara,,0,0,0,,تُخفي وراءها قلّة الحيلة
Dialogue: 0,0:01:01.88,0:01:04.49,OP-Ara,,0,0,0,,والوحدة تستشري
Dialogue: 0,0:01:04.49,0:01:06.82,OP-Ara,,0,0,0,,داخل الفؤاد الأجوف
Dialogue: 0,0:01:06.82,0:01:10.67,OP-Ara,,0,0,0,,مُتَسائِلًا عن وجهة المسير
Dialogue: 0,0:01:10.92,0:01:15.52,OP-Ara,,0,0,0,,لو تسعفني الضحكات في التبرّم من كل ما حولي
Dialogue: 0,0:01:15.73,0:01:20.10,OP-Ara,,0,0,0,,كم أهوى حتّى أبسط الكلمات
Dialogue: 0,0:01:20.54,0:01:22.89,OP-Ara,,0,0,0,,وما هذه بمثاليّة
Dialogue: 0,0:01:22.89,0:01:25.65,OP-Ara,,0,0,0,,ولهذا لم أشعر بالرّضا
Dialogue: 0,0:01:25.69,0:01:27.69,OP-Ara,,0,0,0,,ولن يعود تدبّر الحال عليّ بنفعٍ
Dialogue: 0,0:01:27.73,0:01:30.35,OP-Ara,,0,0,0,,اغرورقت الأعين بالدموع
Dialogue: 0,0:01:30.35,0:01:32.35,OP-Ara,,0,0,0,,تحمل شوقًا للغدِ الآتي
Dialogue: 0,0:01:32.35,0:01:35.00,OP-Ara,,0,0,0,,يتورّد لونها من فيض الشّجى
Dialogue: 0,0:01:35.05,0:01:39.39,OP-Ara,,0,0,0,,آهٍ لو تفوّهت بكلمةٍ واحدة
Dialogue: 0,0:01:39.42,0:01:41.83,OP-Ara,,0,0,0,,إنّ هذا نداء حبّنا ينادينا
Dialogue: 0,0:01:41.83,0:01:44.53,OP-Ara,,0,0,0,,فأرجوك دعه يصل إليك
Dialogue: 0,0:01:44.54,0:01:46.39,OP-Ara,,0,0,0,,وما هذه بمثاليّة
Dialogue: 0,0:01:46.39,0:01:49.21,OP-Ara,,0,0,0,,ولهذا لم أشعر بالرّضا
Dialogue: 0,0:01:49.21,0:01:51.13,OP-Ara,,0,0,0,,تحمل شوقًا للغدِ الآتي
Dialogue: 0,0:01:51.13,0:01:53.77,OP-Ara,,0,0,0,,يتورّد لونها من فيض الشّجى
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة البداية الثانية لأنمي Tsuki ga Michibiku Isekai Douchuu الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:22.75,0:00:23.37,OP2-Ara,,0,0,0,,مرحى
Dialogue: 0,0:00:23.37,0:00:25.28,OP2-Ara,,0,0,0,,تقارن نفسك بشخصٍ آخر
Dialogue: 0,0:00:25.28,0:00:25.83,OP2-Ara,,0,0,0,,مرحى
Dialogue: 0,0:00:25.83,0:00:27.71,OP2-Ara,,0,0,0,,تطأطئ الرأس منكسرًا
Dialogue: 0,0:00:27.71,0:00:28.33,OP2-Ara,,0,0,0,,مرحى
Dialogue: 0,0:00:28.33,0:00:29.82,OP2-Ara,,0,0,0,,وأنا لم أتغيّر
Dialogue: 0,0:00:29.82,0:00:32.83,OP2-Ara,,0,0,0,,فهل ستحبّني على حالي؟
Dialogue: 0,0:00:42.08,0:00:44.22,OP2-Ara,,0,0,0,,لأنّها تفتقد الدراما
Dialogue: 0,0:00:44.22,0:00:46.86,OP2-Ara,,0,0,0,,فالأفلام المجهولة تُسيل الدمع
Dialogue: 0,0:00:46.86,0:00:49.20,OP2-Ara,,0,0,0,,"حتّى لو استنكرت صائحًا "عاجزًا" عاجزًا
Dialogue: 0,0:00:49.20,0:00:51.40,OP2-Ara,,0,0,0,,فشتّان ما بين المثاليّة والواقع
Dialogue: 0,0:00:51.40,0:00:53.86,OP2-Ara,,0,0,0,,أمازلت تفعل ذلك؟ هل تعي الأمر؟
Dialogue: 0,0:00:53.97,0:00:56.34,OP2-Ara,,0,0,0,,أنا وحدي في الكون
Dialogue: 0,0:00:56.34,0:00:58.64,OP2-Ara,,0,0,0,,هل ترتقب؟ هل تتوقّف؟
Dialogue: 0,0:00:58.64,0:01:01.52,OP2-Ara,,0,0,0,,إن كان للأمر أن يتحقّق فيا أهلًا بالانبعاث
Dialogue: 0,0:01:01.90,0:01:04.37,OP2-Ara,,0,0,0,,آه وإن صرت حاسدًا، آهٍ وإن صرت غيورًا
Dialogue: 0,0:01:04.40,0:01:06.32,OP2-Ara,,0,0,0,,أسير على خطى آخر، فإلى أين المنتهى؟
Dialogue: 0,0:01:06.32,0:01:11.26,OP2-Ara,,0,0,0,,أريد أن أبقى على حالي
Dialogue: 0,0:01:11.26,0:01:13.96,OP2-Ara,,0,0,0,,وتراني أقارن حالي بالآخرين
Dialogue: 0,0:01:13.96,0:01:16.33,OP2-Ara,,0,0,0,,لم يعد الليل يهمّني بعد الآن
Dialogue: 0,0:01:16.33,0:01:21.29,OP2-Ara,,0,0,0,,أودّ لو أميل إلى الحاضر
Dialogue: 0,0:01:21.41,0:01:26.09,OP2-Ara,,0,0,0,,وأودّ لو يتبدّل حالي
Dialogue: 0,0:01:26.09,0:01:30.14,OP2-Ara,,0,0,0,,ما بقي لي من نفسي سوى ما أكره
Dialogue: 0,0:01:30.34,0:01:34.25,OP2-Ara,,0,0,0,,غير أنّي للغد الأليم قاهرٌ
Dialogue: 0,0:01:34.28,0:01:36.75,OP2-Ara,,0,0,0,,لنتجاوز تخبّطنا بين السعادة والتعاسة بجسارة
Dialogue: 0,0:01:36.75,0:01:39.28,OP2-Ara,,0,0,0,,هيّا نمضي قُدمًا
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة النهاية الأولى لأنمي Tsuki ga Michibiku Isekai Douchuu الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:04.15,0:22:07.36,ED2-Ara,,0,0,0,,أريد فرض نفسي عليك
Dialogue: 0,0:22:07.61,0:22:11.85,ED2-Ara,,0,0,0,,ألست السبب وراء كلّ هذا؟
Dialogue: 0,0:22:12.08,0:22:15.28,ED2-Ara,,0,0,0,,أريد فرض حبّي عليك
Dialogue: 0,0:22:15.53,0:22:19.88,ED2-Ara,,0,0,0,,اتّبع خيط القدر الأحمر
Dialogue: 0,0:22:19.90,0:22:20.95,ED2-Ara,,0,0,0,,يا سبب وجودي
Dialogue: 0,0:22:24.87,0:22:28.06,ED2-Ara,,0,0,0,,كلمات غير متوقّعة
Dialogue: 0,0:22:28.32,0:22:31.01,ED2-Ara,,0,0,0,,وحبٌّ أشبه بعذر
Dialogue: 0,0:22:32.72,0:22:35.93,ED2-Ara,,0,0,0,,وصوت السماء ولون الرياح
Dialogue: 0,0:22:36.19,0:22:38.88,ED2-Ara,,0,0,0,,كلّ شيءٍ في حالة فوضى
Dialogue: 0,0:22:39.89,0:22:43.82,ED2-Ara,,0,0,0,,إن أفرطت في التفكير فستعمي بصيرتك
Dialogue: 0,0:22:43.82,0:22:47.01,ED2-Ara,,0,0,0,,كلّما لمستك أكثر زاد خوفي أكثر
Dialogue: 0,0:22:47.74,0:22:49.68,ED2-Ara,,0,0,0,,...مع ذلك، لسبب ما
Dialogue: 0,0:22:49.68,0:22:51.94,ED2-Ara,,0,0,0,,أبتسم بتعابير غير مألوفة
Dialogue: 0,0:22:51.94,0:22:59.17,ED2-Ara,,0,0,0,,أضحى الليل والصباح بلونك
Dialogue: 0,0:22:52.92,0:22:54.14,ED2-Ara-2,,0,0,0,,الليل
Dialogue: 0,0:22:59.19,0:23:03.45,ED2-Ara,,0,0,0,,التقت أعيننا ببعضها وبدأنا التحرّك
Dialogue: 0,0:23:03.50,0:23:07.02,ED2-Ara,,0,0,0,,الحبّ كالربيع
Dialogue: 0,0:23:07.17,0:23:11.22,ED2-Ara,,0,0,0,,لا يسعني الجزم ببقاء الأمور على حالها، ولكن
Dialogue: 0,0:23:11.37,0:23:15.27,ED2-Ara,,0,0,0,,إيّاك والاستيقاظ بعد، إيّاك والاستيقاظ بعد
Dialogue: 0,0:23:15.27,0:23:18.21,ED2-Ara,,0,0,0,,أريد فرض نفسي عليك
Dialogue: 0,0:23:18.42,0:23:22.65,ED2-Ara,,0,0,0,,ألست السبب وراء كلّ هذا؟
Dialogue: 0,0:23:22.90,0:23:26.09,ED2-Ara,,0,0,0,,أريد فرض حبّي عليك
Dialogue: 0,0:23:26.37,0:23:30.65,ED2-Ara,,0,0,0,,اتّبع خيط القدر الأحمر
Dialogue: 0,0:23:30.76,0:23:32.00,ED2-Ara,,0,0,0,,يا سبب وجودي
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة النهاية الثانية لأنمي Tsuki ga Michibiku Isekai Douchuu الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:11.54,0:22:14.21,ED3-Ara-3,,0,0,0,,بشريٌّ غير عاديٍّ
Dialogue: 0,0:22:22.47,0:22:26.10,ED3-Ara,,0,0,0,,أتحبّ البساطة؟ لا أظنّ ذلك
Dialogue: 0,0:22:26.10,0:22:29.84,ED3-Ara,,0,0,0,,تسعى طبيعيًّا لما يثير الحماس
Dialogue: 0,0:22:29.89,0:22:33.51,ED3-Ara,,0,0,0,,يهمّك الجوهر، لا المظهر
Dialogue: 0,0:22:33.51,0:22:39.50,ED3-Ara,,0,0,0,,تواصل سعيكَ الدؤوب نحو التحسّن
Dialogue: 0,0:22:38.92,0:22:41.29,ED3-Ara-2,,0,0,0,,لا تعترض طريقي
Dialogue: 0,0:22:40.73,0:22:44.78,ED3-Ara,,0,0,0,,لا شكّ أنّك تدري في أيّ طريق تمضي
Dialogue: 0,0:22:44.93,0:22:48.37,ED3-Ara,,0,0,0,,دون أن توقِف خطاك
Dialogue: 0,0:22:48.63,0:22:55.85,ED3-Ara,,0,0,0,,ضوء القمر المنير لعتمة الليل سيواصل إرشادك دومًا
Dialogue: 0,0:22:55.99,0:22:57.62,ED3-Ara,,0,0,0,,كلّا كلّا كلّا كلّا كلّا كلّا
Dialogue: 0,0:22:57.62,0:22:59.44,ED3-Ara,,0,0,0,,ما من مشكلة عندي
Dialogue: 0,0:22:58.97,0:22:59.95,ED3-Ara-2,,0,0,0,,كلّا كلّا
Dialogue: 0,0:22:59.44,0:23:03.12,ED3-Ara,,0,0,0,,ما من مشكلة حتّى في الأيّام المليئة بالحوادث
Dialogue: 0,0:23:03.30,0:23:05.81,ED3-Ara,,0,0,0,,للحياة صعوباتها
Dialogue: 0,0:23:05.81,0:23:10.49,ED3-Ara,,0,0,0,,إنّي مدركٌ لذلك
Dialogue: 0,0:23:10.77,0:23:12.40,ED3-Ara,,0,0,0,,كلّا كلّا كلّا كلّا كلّا كلّا
Dialogue: 0,0:23:12.40,0:23:14.22,ED3-Ara,,0,0,0,,ما من مشكلة في المستقبل أيضًا
Dialogue: 0,0:23:13.75,0:23:14.71,ED3-Ara-2,,0,0,0,,كلّا كلّا
Dialogue: 0,0:23:14.23,0:23:17.93,ED3-Ara,,0,0,0,,ما من مشكلة حتّى في الأيّام المليئة بالحوادث
Dialogue: 0,0:23:17.93,0:23:21.63,ED3-Ara-3,,0,0,0,,سنغدو منقطعي النظير حتّى في المواقف المجحفة
Dialogue: 0,0:23:21.82,0:23:24.19,ED3-Ara-3,,0,0,0,,إلى أن تُحلّ الأمور
Dialogue: 0,0:23:24.48,0:23:28.13,ED3-Ara-3,,0,0,0,,بشريٌّ غير عاديٍّ إلى الأبد
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Jigokuraku الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:03:05.16,0:03:07.96,OP-Ara,,0,0,0,,زهرةٌ وحيدةٌ لم يلحظها أحد
Dialogue: 0,0:03:07.97,0:03:10.56,OP-Ara,,0,0,0,,تفتّحت براعمها في خفاء
Dialogue: 0,0:03:10.57,0:03:13.12,OP-Ara,,0,0,0,,لا يسعني وصفها بالقرمزيِّ المتأجّج
Dialogue: 0,0:03:13.12,0:03:15.60,OP-Ara,,0,0,0,,بيد أنّها كانت تتألّقُ بحمرةٍ ساكنة
Dialogue: 0,0:03:15.60,0:03:18.37,OP-Ara,,0,0,0,,أثقالُ الماضي الّتي تُكبّلُ قدميَّ
Dialogue: 0,0:03:18.37,0:03:20.90,OP-Ara,,0,0,0,,لطالما أرغمتني على التوقّف
Dialogue: 0,0:03:20.98,0:03:23.53,OP-Ara,,0,0,0,,لو أنّي قطعتُ دابرَ هذه الحيرة
Dialogue: 0,0:03:23.60,0:03:26.74,OP-Ara,,0,0,0,,فهل سأزهر بجوارها يومًا يا ترى؟
Dialogue: 0,0:03:26.98,0:03:29.45,OP-Ara,,0,0,0,,هذا المستقبلُ الّذي ينسلُّ من بين أصابعي
Dialogue: 0,0:03:29.75,0:03:31.99,OP-Ara,,0,0,0,,أهو قصاصٌ لخطيئةٍ اقترفتها؟
Dialogue: 0,0:03:32.12,0:03:36.87,OP-Ara,,0,0,0,,لا أجني منه سوى جرح نفسي
Dialogue: 0,0:03:36.98,0:03:42.23,OP-Ara,,0,0,0,,حتّى السعادةُ اليسيرةُ، بتُّ أتهيّبُ من نيلها
Dialogue: 0,0:03:42.88,0:03:44.48,OP-Ara,,0,0,0,,أريدُ وضع حدٍّ لهذا
Dialogue: 0,0:03:44.49,0:03:47.05,OP-Ara,,0,0,0,,تفتّحتْ تلك الزهرةُ بشُمُوخٍ فحسب
Dialogue: 0,0:03:47.06,0:03:49.72,OP-Ara,,0,0,0,,وذلك وحدهُ كان كافيًا لغمر قلبي بالسعادة
Dialogue: 0,0:03:49.72,0:03:54.18,OP-Ara,,0,0,0,,حسبي أن أحمي هذه الزهرة الوحيدة
Dialogue: 0,0:03:54.80,0:03:57.46,OP-Ara,,0,0,0,,تمنّيتُ أن أكون قويًّا
Dialogue: 0,0:03:57.46,0:04:00.14,OP-Ara,,0,0,0,,فإذا بي أحتضنُ الضعفَ الّذي نبذتُه
Dialogue: 0,0:04:00.14,0:04:02.06,OP-Ara,,0,0,0,,لا سبيل لقطع دابر هذه الحيرة
Dialogue: 0,0:04:02.07,0:04:05.26,OP-Ara,,0,0,0,,وفي خضمّ ضياعي أجدُ ذاتي
Dialogue: 0,0:04:05.27,0:04:07.95,OP-Ara,,0,0,0,,كما تضربُ الجذورُ في الأرضِ بصلابة
Dialogue: 0,0:04:07.96,0:04:10.55,OP-Ara,,0,0,0,,وكما تتهادى مع الرياحِ في رقّةٍ عابرة
Dialogue: 0,0:04:10.57,0:04:13.50,OP-Ara,,0,0,0,,تتفتّقُ البراعمُ رويدًا رويدًا
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Jigokuraku الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:23:08.21,0:23:17.20,ED-Ara,,0,0,0,,في الضفّة الأخرى، ثمّة من تذوي روحه اليوم أيضًا
Dialogue: 0,0:23:17.21,0:23:20.19,ED-Ara,,0,0,0,,بيد أنّه ما زال صامدًا
Dialogue: 0,0:23:20.30,0:23:26.08,ED-Ara,,0,0,0,,يا لوحشةٍ تدمي فؤاده وتخترق صدره
Dialogue: 0,0:23:26.21,0:23:31.93,ED-Ara,,0,0,0,,حتّى خيوط الوصل غدتْ واهيةً متقطّعةً
Dialogue: 0,0:23:31.95,0:23:37.96,ED-Ara,,0,0,0,,تهشّم قناعه، وما عاد يقوى على التغاضي أكثر
Dialogue: 0,0:23:37.97,0:23:45.67,ED-Ara,,0,0,0,,عليه أن يحيا، فالغدُ يترقّب وصوله
Dialogue: 0,0:23:45.68,0:23:51.29,ED-Ara,,0,0,0,,سرمديّةٌ هي، وسريعةُ الزوال في آنٍ واحد
Dialogue: 0,0:23:51.29,0:23:57.52,ED-Ara,,0,0,0,,حسبه أن يظنّ خلوَّ الوجود من أيّ قلب
Dialogue: 0,0:23:57.67,0:24:03.48,ED-Ara,,0,0,0,,لشدّة سطوعه، وَرَقَةٌ ملمسهُ
Dialogue: 0,0:24:03.48,0:24:07.05,ED-Ara,,0,0,0,,...إنّه ذلك اليوم، اليوم الّذي
Dialogue: 0,0:24:07.05,0:24:13.00,ED-Ara,,0,0,0,,استعاد فيه ذاته
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Mato Seihei No Slave الموسم الأول *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:26.03,0:00:29.44,OP-Ara,,0,0,0,,إذ أصحو بلطفٍ ورويدًا
Dialogue: 0,0:00:31.02,0:00:34.91,OP-Ara,,0,0,0,,أحسّ بظلمة تدثّرني
Dialogue: 0,0:00:35.87,0:00:43.33,OP-Ara,,0,0,0,,وأطيق حزني والتياعي إذ انهمرت منّي الأدمعُ
Dialogue: 0,0:00:43.61,0:00:46.57,OP-Ara,,0,0,0,,آليت على نفسي التشبّث ببصيص أملٍ
Dialogue: 0,0:01:00.32,0:01:03.78,OP-Ara,,0,0,0,,إذ يراودني بعد الدهر دهرًا
Dialogue: 0,0:01:05.30,0:01:09.22,OP-Ara,,0,0,0,,حلمٌ بعيدُ المنال في ظاهره ولا تُدرك ركيزته
Dialogue: 0,0:01:10.20,0:01:14.74,OP-Ara,,0,0,0,,ظللت راجيةً أن يغدو الحلم حقيقةً
Dialogue: 0,0:01:15.31,0:01:19.89,OP-Ara,,0,0,0,,أيّان ما بسطت يداك إلى يديّ
Dialogue: 0,0:01:19.89,0:01:22.46,OP-Ara,,0,0,0,,راجيًا أنت على الدوام
Dialogue: 0,0:01:22.46,0:01:25.08,OP-Ara,,0,0,0,,صادقًا أنت على الدوام
Dialogue: 0,0:01:25.37,0:01:29.60,OP-Ara,,0,0,0,,أدرك أنّي سأُوفّق وأنت إلى جانبي
Dialogue: 0,0:01:29.65,0:01:34.87,OP-Ara,,0,0,0,,سأحيل هذا العالم بستانًا من الضياء
Dialogue: 0,0:01:35.15,0:01:40.58,OP-Ara,,0,0,0,,على يقين بنجاحي وأقوده إلى قريب الأجل
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Mato Seihei No Slave الموسم الأول *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:21:40.84,0:21:44.47,ED-Ara,,0,0,0,,ما بالك لا تروّحُ عن نفسك؟
Dialogue: 0,0:21:44.47,0:21:49.61,ED-Ara,,0,0,0,,إن وضعت يدك بيدي فلا غالب لنا
Dialogue: 0,0:21:49.61,0:21:54.26,ED-Ara,,0,0,0,,أيدينا مترابطة في وصالٍ متمسّك بك
Dialogue: 0,0:21:54.26,0:21:56.43,ED-Ara,,0,0,0,,لن أسمح لك بالرحيل أبدًا
Dialogue: 0,0:22:12.12,0:22:15.93,ED-Ara,,0,0,0,,لن تكفينا المثابرة وحدها
Dialogue: 0,0:22:16.13,0:22:19.89,ED-Ara,,0,0,0,,فتارةً تصادفنا أمورٌ على بَغْتَة
Dialogue: 0,0:22:19.97,0:22:22.24,ED-Ara,,0,0,0,,سوى أن تبدّل الحال يسير
Dialogue: 0,0:22:22.24,0:22:27.98,ED-Ara,,0,0,0,,ولا يطيب لنا المعشر إِلَى أَنْ يُكتب لنا اللقاء
Dialogue: 0,0:22:27.98,0:22:35.93,ED-Ara,,0,0,0,,ما بي من اختلاجة الطويّة وحمّى البَدَن إلّا من لهفةٍ إليك
Dialogue: 0,0:22:36.10,0:22:43.01,ED-Ara,,0,0,0,,تتسارع ضربات قلبي إذ تثنّى وتبدّل حاله
Dialogue: 0,0:22:43.01,0:22:46.43,ED-Ara,,0,0,0,,ما بالك لا تروّح عن نفسك؟
Dialogue: 0,0:22:46.48,0:22:51.60,ED-Ara,,0,0,0,,إن وضعت يدك بيدي فلا غالب لنا
Dialogue: 0,0:22:51.60,0:22:56.90,ED-Ara,,0,0,0,,أيدينا مترابطة تثير التَعاطف
Dialogue: 0,0:22:56.98,0:22:59.24,ED-Ara,,0,0,0,,في وصالٍ متمسّك بك
Dialogue: 0,0:22:59.24,0:23:03.45,ED-Ara,,0,0,0,,لن أسمح لك بالرحيل مرّة أخرى
Dialogue: 0,0:23:03.51,0:23:06.57,ED-Ara,,0,0,0,,لن أسمح لك بالرحيل أبدًا
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Mato Seihei No Slave الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:07:26.66,0:07:31.20,OP-Ara,,0,0,0,,غارقةٌ في صمتي وقد غاب عن حسّي أيّ مستقبلٍ
Dialogue: 0,0:07:31.54,0:07:36.15,OP-Ara,,0,0,0,,وكأنَّ الزمان توقّف وخُيّل إليَّ أنَّ كلّ شيءٍ قد انتهى
Dialogue: 0,0:07:36.55,0:07:42.45,OP-Ara,,0,0,0,,انطويتُ على نفسي، أصدُّ تارةً وأقترب تارةً، حتّى شُرِّعتْ مظلّةُ قلبي ببطءٍ
Dialogue: 0,0:07:42.58,0:07:46.15,OP-Ara,,0,0,0,,ورغم ذلك، دأبتُ على التظاهر بالقوّة
Dialogue: 0,0:07:46.93,0:07:50.59,OP-Ara,,0,0,0,,لن أطلب منك مواساتي
Dialogue: 0,0:07:50.19,0:07:51.84,OP-Ara-1,,0,0,0,,لن أطلب ذلك
Dialogue: 0,0:07:51.84,0:08:02.21,OP-Ara,,0,0,0,,أريدُ أن أغدو قويّةً وأتطلّع للأمام، غير أنَّ ضعفي يكاد يسحقني
Dialogue: 0,0:08:03.71,0:08:08.62,OP-Ara,,0,0,0,,حين التقيتكَ فاض العالمُ حولي ووهبتني الضياء
Dialogue: 0,0:08:08.62,0:08:13.56,OP-Ara,,0,0,0,,أنا الّتي خَلَتْ حياتي من أيّ أملٍ عدتُ أبتسم
Dialogue: 0,0:08:13.60,0:08:18.38,OP-Ara,,0,0,0,,وفي أحاديثنا العابرة كنتَ تمنحني الابتسامات دائمًا
Dialogue: 0,0:08:18.50,0:08:23.67,OP-Ara,,0,0,0,,لن أقولها لأنّي أحمرُّ خجلًا إن شكرتكَ، لكنّي أُضمرها في قلبي
Dialogue: 0,0:08:23.67,0:08:27.52,OP-Ara,,0,0,0,,هل سأتمكّن من المضيِّ قُدمًا في دربي يا ترى؟
Dialogue: 0,0:08:27.56,0:08:29.09,OP-Ara,,0,0,0,,يا نورًا أقْبِل إليَّ
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Mato Seihei No Slave الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:21:56.75,0:22:03.62,ED-Ara,,0,0,0,,أيّها الغامض، يا من تختلس النظر إليَّ وحيدًا
Dialogue: 0,0:22:19.47,0:22:22.24,ED-Ara,,0,0,0,,...أُعيدُ الكرّة وأدور في حلقة مفرغة
Dialogue: 0,0:22:22.25,0:22:24.82,ED-Ara,,0,0,0,,بسبب كثرة الأقاويل الّتي أرهقتني
Dialogue: 0,0:22:24.83,0:22:27.84,ED-Ara,,0,0,0,,أين توارتْ نشوة الانتصار؟
Dialogue: 0,0:22:28.04,0:22:29.49,ED-Ara,,0,0,0,,أين هي؟ أجبني
Dialogue: 0,0:22:30.19,0:22:32.96,ED-Ara,,0,0,0,,...في طور النّموّ وعلى شفا الهلع
Dialogue: 0,0:22:32.97,0:22:35.62,ED-Ara,,0,0,0,,سأصبّ جلَّ تركيزي على العناية
Dialogue: 0,0:22:35.63,0:22:38.12,ED-Ara,,0,0,0,,تأهّبٌ للقتال، يا له من تململٍ يثير الحنق
Dialogue: 0,0:22:38.12,0:22:40.12,ED-Ara,,0,0,0,,...أمّا الحذاء الزجاجيّ
Dialogue: 0,0:22:40.74,0:22:42.68,ED-Ara,,0,0,0,,فباتَ مُقيتًا
Dialogue: 0,0:22:42.70,0:22:45.97,ED-Ara,,0,0,0,,لذا لنكُفَّ عن هذه الترّهات
Dialogue: 0,0:22:46.16,0:22:48.16,ED-Ara,,0,0,0,,يراودني حدسٌ بنزالٍ ملحميّ
Dialogue: 0,0:22:48.85,0:22:50.92,ED-Ara,,0,0,0,,أتعي ذلك؟
Dialogue: 0,0:22:52.77,0:22:57.36,ED-Ara,,0,0,0,,أيّها الغامض، يا من تختلس النظر إليَّ وحيدًا
Dialogue: 0,0:22:57.57,0:23:00.74,ED-Ara,,0,0,0,,هذه حكايةٌ لا يختبرها سواك
Dialogue: 0,0:23:00.91,0:23:02.68,ED-Ara,,0,0,0,,فلتغدُ كلبًا وانصع
Dialogue: 0,0:23:03.44,0:23:08.09,ED-Ara,,0,0,0,,أيّها الغامض، لعلَّ تلك السلاسل قد أسكرتكَ
Dialogue: 0,0:23:08.11,0:23:11.34,ED-Ara,,0,0,0,,ارتعادٌ وهلع، وواقعٌ لا خيال
Dialogue: 0,0:23:11.38,0:23:14.07,ED-Ara,,0,0,0,,لا مجال للتعادل هنا أيّتها الأميرة الحالمة
Dialogue: 0,0:23:14.22,0:23:17.10,ED-Ara,,0,0,0,,أنتَ تختلس النظر إليَّ؟
Dialogue: 0,0:23:17.26,0:23:18.13,ED-Ara,,0,0,0,,راقبني إذن
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة النهاية الثانية لأنمي Mato Seihei No Slave الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:03.83,0:22:08.08,ED2-Ara,,0,0,0,,شُعاعُ الحُبّ
Dialogue: 0,0:22:18.25,0:22:21.92,ED2-Ara,,0,0,0,,أريد أن أعرف وأشتهي وألمس
Dialogue: 0,0:22:21.92,0:22:27.75,ED2-Ara,,0,0,0,,فيضُ مشاعري هذا يأبى التوقّف
Dialogue: 0,0:22:27.75,0:22:34.42,ED2-Ara,,0,0,0,,عذبٌ أنت، بل فائق العذوبة، فدعني ألج كيانك يا عزيزي
Dialogue: 0,0:22:34.42,0:22:37.79,ED2-Ara,,0,0,0,,سأُحسِن ترويضك، فقد حان وقت المكافأة
Dialogue: 0,0:22:38.00,0:22:42.63,ED2-Ara,,0,0,0,,بحرارةٍ تتأجّج من تلاقي أجسادنا
Dialogue: 0,0:22:42.75,0:22:45.74,ED2-Ara,,0,0,0,,بلغ الشحن أوجه
Dialogue: 0,0:22:45.76,0:22:47.96,ED2-Ara,,0,0,0,,والآن، حان وقت الإطلاق
Dialogue: 0,0:22:47.96,0:22:51.08,ED2-Ara,,0,0,0,,انطلق من يدي الآن يا شعاع حبّي
Dialogue: 0,0:22:51.08,0:22:54.79,ED2-Ara,,0,0,0,,مُصوّبًا نحو فؤادك يا شعاع حبّي
Dialogue: 0,0:22:54.79,0:22:58.63,ED2-Ara,,0,0,0,,سأعبر الفجوة الّتي بيننا
Dialogue: 0,0:22:58.63,0:23:00.75,ED2-Ara,,0,0,0,,ومن مسافةٍ معدومةٍ أُطلق
Dialogue: 0,0:23:00.75,0:23:02.25,ED2-Ara,,0,0,0,,!مرحى، مرحى، مرحى، مرحى
Dialogue: 0,0:23:02.25,0:23:05.67,ED2-Ara,,0,0,0,,لن تفلت من شُعاع حبّي
Dialogue: 0,0:23:05.67,0:23:09.29,ED2-Ara,,0,0,0,,حتّى أقاصي الأرض سيمضي شعاع حبّي
Dialogue: 0,0:23:09.29,0:23:13.04,ED2-Ara,,0,0,0,,أجل، الحبّ هو ما يغيّر العالم
Dialogue: 0,0:23:13.04,0:23:19.63,ED2-Ara,,0,0,0,,ويصبغه بلون الفؤاد حتّى دياجير الظلام
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Haite Kudasai, Takamine-san *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:01:59.18,0:02:02.50,OP-Ara,,0,0,0,,أودّ فقط أن أهمسَ حبًّا، آهٍ ما أحلى أن أهمسَ حبًّا
Dialogue: 0,0:02:02.68,0:02:06.96,OP-Ara,,0,0,0,,أرجوك لا تتوقّف
Dialogue: 0,0:02:06.96,0:02:10.22,OP-Ara,,0,0,0,,حبٌّ كالفراولة، كذبةٌ بحلاوة الفراولة
Dialogue: 0,0:02:10.22,0:02:15.82,OP-Ara,,0,0,0,,عليَّ أن أُقيّدك
Dialogue: 0,0:02:26.51,0:02:29.50,OP-Ara,,0,0,0,,اجثِ على ركبتيك وأقسم
Dialogue: 0,0:02:29.67,0:02:33.57,OP-Ara,,0,0,0,,بأطرافِ أصابِعي أمتدُّ نحوك وفي كلِّ حينٍ ألامسك
Dialogue: 0,0:02:33.57,0:02:36.50,OP-Ara,,0,0,0,,هذا سِرٌّ دفينٌ بين طيّاتِ الكتمانِ يُصان
Dialogue: 0,0:02:36.60,0:02:42.28,OP-Ara,,0,0,0,,فهو إثمٌ اقترفناه سويًّا وجذوره في الأعماق تمتدّ
Dialogue: 0,0:02:42.64,0:02:46.45,OP-Ara,,0,0,0,,عوالم تدور وتُعاد
Dialogue: 0,0:02:47.28,0:02:48.88,OP-Ara,,0,0,0,,أنتَ مُرادي، وأنتَ مُبتغاي
Dialogue: 0,0:02:48.88,0:02:53.15,OP-Ara,,0,0,0,,هذا سرٌّ دفينٌ يبقى
Dialogue: 0,0:02:53.15,0:02:56.62,OP-Ara,,0,0,0,,أودّ فقط أن أهمسَ حبًّا، آهٍ ما أحلى أن أهمسَ حبًّا
Dialogue: 0,0:02:56.62,0:03:00.58,OP-Ara,,0,0,0,,أرجوك لا تتوقّف
Dialogue: 0,0:03:00.58,0:03:04.18,OP-Ara,,0,0,0,,هذا اللّحنُ الّذي يترنّم صداه بيني وبينك
Dialogue: 0,0:03:04.22,0:03:07.07,OP-Ara,,0,0,0,,نستشعرُه حيثما كنّا
Dialogue: 0,0:03:07.07,0:03:10.27,OP-Ara,,0,0,0,,أودّ فقط أن أهمسَ حبًّا، آهٍ ما أحلى أن أهمسَ حبًّا
Dialogue: 0,0:03:10.53,0:03:14.80,OP-Ara,,0,0,0,,لا تبرحْ  قربي ما امتدَّ العمر
Dialogue: 0,0:03:14.80,0:03:17.94,OP-Ara,,0,0,0,,حبٌّ كالفراولة، كذبةٌ بحلاوة الفراولة
Dialogue: 0,0:03:17.94,0:03:20.00,OP-Ara,,0,0,0,,فلِمَ  لا تُحاول؟
Dialogue: 0,0:03:20.00,0:03:24.15,OP-Ara,,0,0,0,,وبين يديكَ مفتاحُ خلاصي
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Haite Kudasai, Takamine-san *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:21:40.52,0:21:44.98,ED-Ara,,0,0,0,,بين ذراعيكِ تشابكت عقارب الزمن
Dialogue: 0,0:21:44.98,0:21:46.87,ED-Ara,,0,0,0,,ذهنٌ حبيس أفكاره
Dialogue: 0,0:21:46.87,0:21:51.42,ED-Ara,,0,0,0,,إيّاك أن توهم نفسك بأنّه سيبقى عاقلًا
Dialogue: 0,0:21:53.02,0:21:57.64,ED-Ara,,0,0,0,,عقرب الثواني يُلحُّ على المضيّ قُدمًا
Dialogue: 0,0:21:57.64,0:21:59.35,ED-Ara,,0,0,0,,ذهنٌ حبيس أفكاره
Dialogue: 0,0:21:59.35,0:22:04.30,ED-Ara,,0,0,0,,لِنُعِدْ شريط الزمن بتدويرِ ذلك الزِّمام
Dialogue: 0,0:22:05.22,0:22:11.37,ED-Ara,,0,0,0,,خيالٌ مُترفٌ أصبح حلمًا يتبدّى في ظِلّ الغموض مخيّمًا
Dialogue: 0,0:22:11.37,0:22:17.25,ED-Ara,,0,0,0,,بلمسةٍ منك أَيْقِنْ ثمَّ جرّدها من ثوب الحقيقة
Dialogue: 0,0:22:17.30,0:22:20.81,ED-Ara,,0,0,0,,دعني أنسلّ من هنا بأسرع ما يكون
Dialogue: 0,0:22:20.83,0:22:23.95,ED-Ara,,0,0,0,,كلّما تكرّر الأمر اشتدّت مرارة إحساسه
Dialogue: 0,0:22:23.95,0:22:29.93,ED-Ara,,0,0,0,,رغم علمي بأنّه عابر إلّا أنّي ما زلتُ توّاقًا إليه
Dialogue: 0,0:22:30.15,0:22:33.61,ED-Ara,,0,0,0,,هذا الحلم الآثِم
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Kekkon Yubiwa Monogatari الموسم الأول *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:01:57.40,0:02:02.93,OP-Ara,,0,0,0,,أطراف أصابع متشابكة، نبض بداية جديدة
Dialogue: 0,0:02:02.99,0:02:08.69,OP-Ara,,0,0,0,,الولادة هي مجرّد انطلاقةٍ أولى في هذه الحياة
Dialogue: 0,0:02:08.76,0:02:14.30,OP-Ara,,0,0,0,,بريق عينيكِ الّذي سكن قلبي يومها
Dialogue: 0,0:02:14.35,0:02:15.91,OP-Ara,,0,0,0,,تلك الأحاسيس،‏
Dialogue: 0,0:02:15.49,0:02:16.42,OP-Ara-2,,0,0,0,,تلك الأحاسيس
Dialogue: 0,0:02:16.19,0:02:17.42,OP-Ara,,0,0,0,,ذلك الشغف‏،‏
Dialogue: 0,0:02:17.00,0:02:17.85,OP-Ara-2,,0,0,0,,ذلك الشغف
Dialogue: 0,0:02:17.62,0:02:20.01,OP-Ara,,0,0,0,,استعصى عليَّ وصفهما
Dialogue: 0,0:02:20.07,0:02:22.76,OP-Ara,,0,0,0,,عيناك، فيهما إصرارٌ لا يَلينُ
Dialogue: 0,0:02:22.91,0:02:26.35,OP-Ara,,0,0,0,,إيمانك، يلامس جوهر الحقيقة
Dialogue: 0,0:02:26.46,0:02:29.10,OP-Ara,,0,0,0,,حتّى في أعماق وَحْدَتهم،‏
Dialogue: 0,0:02:29.48,0:02:33.65,OP-Ara,,0,0,0,,يحملون شعلة أملٍ لا تنطفئ
Dialogue: 0,0:02:33.67,0:02:39.38,OP-Ara,,0,0,0,,أريد أن أكون درعًا يحميكِ في كلّ مستقبلٍ تختارينه
Dialogue: 0,0:02:39.44,0:02:44.99,OP-Ara,,0,0,0,,لن أسمح لكِ بالسير وحيدةً في هذا الدرب
Dialogue: 0,0:02:44.99,0:02:50.66,OP-Ara,,0,0,0,,أمام الرياح العاتية نقف ثابتين وأنظارنا موجّهةٌ نحو آفاق جديدة
Dialogue: 0,0:02:50.80,0:02:56.23,OP-Ara,,0,0,0,,سنشعّ كنورٍ حتّى لو كنّا في أعماق الهاوية
Dialogue: 0,0:02:56.43,0:03:03.98,OP-Ara,,0,0,0,,ونعدكِ بأن نكون معكِ في كلّ دربٍ نسلكه
Dialogue: 0,0:03:04.19,0:03:07.49,OP-Ara,,0,0,0,,خطوبة، أقسم بعينيكِ الساحرتين
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Kekkon Yubiwa Monogatari الموسم الأول *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:26.22,0:22:31.85,ED-Ara,,0,0,0,,عاجزةٌ عن التعبير عن عمق معنى وجودك بجانبي
Dialogue: 0,0:22:33.56,0:22:39.10,ED-Ara,,0,0,0,,لكنّي لم أجد أيّ سبب للانفصال عنك
Dialogue: 0,0:22:40.88,0:22:46.75,ED-Ara,,0,0,0,,الكلمات الزائفة الّتي ابتلعتها بشهيق عميق‏،‏
Dialogue: 0,0:22:48.22,0:22:54.03,ED-Ara,,0,0,0,,ما زالت تلازمني، عالقةً في أعماقي
Dialogue: 0,0:22:54.09,0:22:58.01,ED-Ara,,0,0,0,,مع ذلك، الدموع الّتي انسكبت
Dialogue: 0,0:22:58.05,0:23:01.46,ED-Ara,,0,0,0,,هل ستُوارى تحت رمال النسيان يومًا ما؟
Dialogue: 0,0:23:01.49,0:23:06.05,ED-Ara,,0,0,0,,ظننتُ أنّي على درايةٍ بالأمر، لكنّي كنت جاهلةً تمامًا
Dialogue: 0,0:23:06.05,0:23:08.43,ED-Ara,,0,0,0,,بما في أعماق قلبي
Dialogue: 0,0:23:09.50,0:23:12.93,ED-Ara,,0,0,0,,تسودني الجراح في كلّ مكان
Dialogue: 0,0:23:12.97,0:23:15.88,ED-Ara,,0,0,0,,هل ستعود إليّ تلك الابتسامة الّتي كانت تعلوني؟
Dialogue: 0,0:23:16.82,0:23:20.30,ED-Ara,,0,0,0,,بأيّ شكلٍ أورده؟
Dialogue: 0,0:23:20.30,0:23:23.19,ED-Ara,,0,0,0,,أريد أن أكون بجانبك
Dialogue: 0,0:23:23.47,0:23:27.11,ED-Ara,,0,0,0,,مع كلّ خطوةٍ واهنةٍ
Dialogue: 0,0:23:27.11,0:23:31.24,ED-Ara,,0,0,0,,ينبعث نورٌ جديد
Dialogue: 0,0:23:31.24,0:23:35.05,ED-Ara,,0,0,0,,حتّى لو افترقنا، ستبقى ذكرياتنا مخلّدة
Dialogue: 0,0:23:35.37,0:23:38.83,ED-Ara,,0,0,0,,دموعنا تنسجم مع بعضها مثل الأحجار الكريمة
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Kekkon Yubiwa Monogatari II *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:13.48,0:22:18.52,ED-Ara,,0,0,0,,ما فتئتُ أبوح لكَ بمشاعري في كلّ وقتٍ وحينٍ
Dialogue: 0,0:22:19.07,0:22:24.21,ED-Ara,,0,0,0,,لم أترك فرحةً إلّا ورويتها لك حتّى فاض الكيلُ تكرارًا
Dialogue: 0,0:22:24.97,0:22:29.49,ED-Ara,,0,0,0,,إذ أنّكَ معي تملأ الآفاق حيثما يمّمتُ وجهي
Dialogue: 0,0:22:29.85,0:22:32.58,ED-Ara,,0,0,0,,أجدني على سجيّتي بلا زيفٍ
Dialogue: 0,0:22:32.89,0:22:36.17,ED-Ara,,0,0,0,,فتُولدُ المشاعرُ وتغدو وليدةَ اللحظة
Dialogue: 0,0:22:36.46,0:22:39.15,ED-Ara,,0,0,0,,ضُمَّني، وابكِ، وانثر الوجد، وأصغِ لرجفة صوتي
Dialogue: 0,0:22:39.19,0:22:41.95,ED-Ara,,0,0,0,,إذ أرغب أن أُحوِّل كلَّ صوتٍ كهذا إلى أغنيةٍ تصلك
Dialogue: 0,0:22:42.24,0:22:43.78,ED-Ara,,0,0,0,,سأقولها مهما تعاقبت المرّاتُ وتكرّرت
Dialogue: 0,0:22:43.85,0:22:50.14,ED-Ara,,0,0,0,,على هذا المنوال، سأنسجُ ألحانَ الهوى ما لا يُعدّ
Dialogue: 0,0:23:08.05,0:23:12.74,ED-Ara,,0,0,0,,أحبّكَ أنتَ ولا أحد سواك
Dialogue: 0,0:23:13.13,0:23:18.53,ED-Ara,,0,0,0,,حين يُقعدني التعبُ وتتوهُ عن عينيّ الدروب
Dialogue: 0,0:23:18.88,0:23:24.24,ED-Ara,,0,0,0,,وحين تلسعني الجراح ويراودني خاطرُ التخلّي
Dialogue: 0,0:23:24.63,0:23:30.07,ED-Ara,,0,0,0,,سأتشبّثُ بيدك، فإيّاكَ أن تتركني
Dialogue: 0,0:23:30.38,0:23:37.11,ED-Ara,,0,0,0,,ولنُقْبِلْ معًا على ليلةٍ تُعَدُّ المليونَ في عدادِ خلودِنا
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Kekkon Yubiwa Monogatari II *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:01:28.53,0:01:33.64,OP-Ara,,0,0,0,,وميضٌ يشرخُ السماء طالبًا العودة
Dialogue: 0,0:01:33.94,0:01:38.90,OP-Ara,,0,0,0,,من شفاهٍ مُنكرةٍ للوداد سأوقظ الغد
Dialogue: 0,0:01:39.01,0:01:44.34,OP-Ara,,0,0,0,,لنفعم إشراقة هذا الفجر بدفءٍ يتّقد
Dialogue: 0,0:01:44.63,0:01:47.59,OP-Ara,,0,0,0,,والنور يحدُو خُطانا
Dialogue: 0,0:01:48.68,0:01:49.43,OP-Ara,,0,0,0,,بزوغ الفجر
Dialogue: 0,0:02:02.40,0:02:05.63,OP-Ara,,0,0,0,,أزمةٌ صامتةٌ في الأثير لا فِكاكَ منها
Dialogue: 0,0:02:07.31,0:02:11.01,OP-Ara,,0,0,0,,وما كان موضع السُّؤال هو نبضُ الأواصرِ بيننا
Dialogue: 0,0:02:11.30,0:02:16.40,OP-Ara,,0,0,0,,بقلوبٍ متّصلةٍ نستدلُّ على الطريق سويًّا
Dialogue: 0,0:02:16.52,0:02:20.53,OP-Ara,,0,0,0,,أجده الآن شعورًا راسخًا قويًّا
Dialogue: 0,0:02:20.83,0:02:24.51,OP-Ara,,0,0,0,,عند أبعد نقطةٍ من قاع الهاوية
Dialogue: 0,0:02:26.84,0:02:31.49,OP-Ara,,0,0,0,,دفء لثمكَ يسري في أناملي
Dialogue: 0,0:02:31.49,0:02:33.71,OP-Ara,,0,0,0,,قبلاتي تتْرى بقربكَ دومًا
Dialogue: 0,0:02:33.90,0:02:36.05,OP-Ara,,0,0,0,,قبلاتي تتْرى بقربكَ دومًا
Dialogue: 0,0:02:36.21,0:02:41.33,OP-Ara,,0,0,0,,ليتكرّر ذلك الوميض الّذي يشرخُ السماء طالبًا العودة
Dialogue: 0,0:02:41.61,0:02:46.56,OP-Ara,,0,0,0,,من شفاهٍ مُنكرةٍ للوداد سأوقظ الغد
Dialogue: 0,0:02:46.70,0:02:52.11,OP-Ara,,0,0,0,,لنفعم إشراقة هذا الفجر بجرأةٍ لا تلين
Dialogue: 0,0:02:52.40,0:02:55.15,OP-Ara,,0,0,0,,كي نحتضنَ قدومه
Dialogue: 0,0:02:56.37,0:02:57.08,OP-Ara,,0,0,0,,بزوغ الفجر
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Yomi no Tsugai *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:10.85,0:22:13.78,OP-Ara,,0,0,0,,بمِقدارِ ما كابدتُ من غُصَصٍ
Dialogue: 0,0:22:17.44,0:22:22.13,OP-Ara,,0,0,0,,تسري الأوجاع في أوردتي
Dialogue: 0,0:22:24.21,0:22:27.25,OP-Ara,,0,0,0,,متجاوزةً شغافَ قلبي
Dialogue: 0,0:22:31.06,0:22:35.42,OP-Ara,,0,0,0,,لتبغتني حين أواريها الثرى في غياهب النسيان
Dialogue: 0,0:22:35.44,0:22:37.45,OP-Ara,,0,0,0,,طِب نفسًا، فما في ذلك مَشقّةٌ
Dialogue: 0,0:22:37.45,0:22:39.14,OP-Ara,,0,0,0,,...فهذا النزرَ
Dialogue: 0,0:22:39.14,0:22:42.52,OP-Ara,,0,0,0,,فهذا النزرَ من الكمدِ والأسى
Dialogue: 0,0:22:42.60,0:22:48.76,OP-Ara,,0,0,0,,تجاوز عن نسيمهِ البارد وهو يتخلّل
Dialogue: 0,0:22:49.25,0:22:52.43,OP-Ara,,0,0,0,,عجزي هذا
Dialogue: 0,0:22:52.45,0:22:56.02,OP-Ara,,0,0,0,,وكلماتي ودموعي جمعاء
Dialogue: 0,0:22:56.03,0:22:59.96,OP-Ara,,0,0,0,,لا تلقِ لها بالًا، فلكلّ امرئٍ مَشرَبُه
Dialogue: 0,0:22:59.96,0:23:02.82,OP-Ara,,0,0,0,,سأعتكفُ على حِملِها وحدي الآن
Dialogue: 0,0:23:02.82,0:23:06.07,OP-Ara,,0,0,0,,إلى اللقاء إذن
Dialogue: 0,0:23:06.07,0:23:09.72,OP-Ara,,0,0,0,,سأخلّفُ كلَّ شيءٍ وراءي وأرحل
Dialogue: 0,0:23:09.72,0:23:13.01,OP-Ara,,0,0,0,,إلى سماءٍ لا يهتزُّ لها جفني
Dialogue: 0,0:23:13.14,0:23:22.16,OP-Ara,,0,0,0,,ساعيًا وراءَ نفسي الّتي تذروها الرياح
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Yomi no Tsugai *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:06.61,0:22:09.15,ED-Ara,,0,0,0,,،لا تُشِح بنظركَ عنّي
Dialogue: 0,0:22:09.87,0:22:14.30,ED-Ara,,0,0,0,,كي لا أبتعد عنكَ
Dialogue: 0,0:22:19.45,0:22:21.84,ED-Ara,,0,0,0,,،ضُمّني إليكَ
Dialogue: 0,0:22:22.60,0:22:27.29,ED-Ara,,0,0,0,,كي لا أجهش بالبكاء
Dialogue: 0,0:22:30.63,0:22:33.57,ED-Ara,,0,0,0,,،حين هبّتْ الرياحٌ دافعةً
Dialogue: 0,0:22:33.62,0:22:36.80,ED-Ara,,0,0,0,,،وسرى مدُّها في أوصالي
Dialogue: 0,0:22:37.05,0:22:43.01,ED-Ara,,0,0,0,,،وبلغتْ مجرى دمي
Dialogue: 0,0:22:46.20,0:22:56.20,ED-Ara,,0,0,0,,وجدتُ أجنحةً تُمكّنني من التحليق مجدّدًا
Dialogue: 0,0:22:57.15,0:23:06.36,ED-Ara,,0,0,0,,،إن لم تبرح عُشّكَ بعد
Dialogue: 0,0:23:06.36,0:23:12.72,ED-Ara,,0,0,0,,فلنحلّق معًا إذن
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Tongari Boushi no Atelier *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:01:15.56,0:01:18.28,OP-Ara,,0,0,0,,ستحملُ الرياحُ أنباءها إلينا
Dialogue: 0,0:01:18.28,0:01:20.28,OP-Ara,,0,0,0,,...ولو هممتُ بالرقص تحتَ ضوء القمر
Dialogue: 0,0:01:20.44,0:01:23.27,OP-Ara,,0,0,0,,لصبغني ليلُ التيه بظلامه
Dialogue: 0,0:01:23.33,0:01:26.04,OP-Ara,,0,0,0,,،كلّما رسمتُ لا أشعرُ بالاكتفاء
Dialogue: 0,0:01:26.05,0:01:29.59,OP-Ara,,0,0,0,,غير أنَّ توقي لهذه اللحظة شديدٌ
Dialogue: 0,0:01:29.82,0:01:34.26,OP-Ara,,0,0,0,,،كحَمَلٍ ضالٍّ ما زال يجهلُ طريقهُ
Dialogue: 0,0:01:34.27,0:01:38.93,OP-Ara,,0,0,0,,لا أعدو كوني نكرةً تخلو ممّا يميزُها
Dialogue: 0,0:01:39.07,0:01:42.08,OP-Ara,,0,0,0,,،لطالما ابتغيتُ غايةً أتلمّسُ خُطاها
Dialogue: 0,0:01:42.08,0:01:46.50,OP-Ara,,0,0,0,,رغمَ ما يؤولُ إليهِ العالمُ الآن
Dialogue: 0,0:01:48.19,0:01:52.16,OP-Ara,,0,0,0,,،تدوي أصداءُ صوتينا معًا
Dialogue: 0,0:01:52.18,0:01:55.59,OP-Ara,,0,0,0,,وكأنّها قدرٌ محتومٌ يربطُنا بيومٍ ما
Dialogue: 0,0:01:55.59,0:01:59.38,OP-Ara,,0,0,0,,...في أنشودةِ رنينٍ تتداخلُ ألحانُها
Dialogue: 0,0:01:59.40,0:02:03.69,OP-Ara,,0,0,0,,يا أيّامًا أشبهُ بدعاءٍ خافتٍ
Dialogue: 0,0:02:03.75,0:02:07.62,OP-Ara,,0,0,0,,...آمالي وأحلامي الّتي رسمتُها أكثر من غيري
Dialogue: 0,0:02:07.63,0:02:11.93,OP-Ara,,0,0,0,,لسحرٌ تتألّقُ فيه ألوانُ الحياة
Dialogue: 0,0:02:11.94,0:02:16.69,OP-Ara,,0,0,0,,...حتّى وإن اضمحلتْ الفوارق الّتي تفصلنا
Dialogue: 0,0:02:16.80,0:02:20.56,OP-Ara,,0,0,0,,...فلا ريب سيعترينا
Dialogue: 0,0:02:20.67,0:02:22.97,OP-Ara,,0,0,0,,في خضمِّ هذه الأيّام العجيبة
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Tongari Boushi no Atelier *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:06.26,0:22:10.45,ED-Ara,,0,0,0,,...واريتهُ في غياهبِ الليل
Dialogue: 0,0:22:11.51,0:22:16.84,ED-Ara,,0,0,0,,موقنةً أنَّ يومنا الموعود لن يأتي
Dialogue: 0,0:22:17.56,0:22:23.44,ED-Ara,,0,0,0,,...إن كان سيتداعى ويندثر بمجرّد لمسه
Dialogue: 0,0:22:24.07,0:22:30.78,ED-Ara,,0,0,0,,فهل سيبتلعُ الضبابُ ذلك الحلم يا ترى؟
Dialogue: 0,0:22:31.68,0:22:37.40,ED-Ara,,0,0,0,,،بين ثنايا الواقع والأمل جسدٌ أذودُ عنه سرًّا
Dialogue: 0,0:22:38.38,0:22:44.68,ED-Ara,,0,0,0,,ومطرٌ لا تُجففُه نار تلكَ الصراعات
Dialogue: 0,0:22:44.77,0:22:49.64,ED-Ara,,0,0,0,,،هواءٌ قارسٌ، وزهرةٌ تجمّدتْ أخيرًا
Dialogue: 0,0:22:50.05,0:22:52.00,ED-Ara,,0,0,0,,وسماءٌ أقفُ تحتها مشدوهةً
Dialogue: 0,0:22:53.17,0:22:59.21,ED-Ara,,0,0,0,,أما كُنّا بحاجةٍ لتلك السعادة يومًا؟
Dialogue: 0,0:22:59.45,0:23:04.36,ED-Ara,,0,0,0,,...ما هي إلّا لعنةٌ فاتنةٌ
Dialogue: 0,0:23:04.64,0:23:10.03,ED-Ara,,0,0,0,,في بمشهدٍ يُهتكُ فيه سترُ الضياءِ ببراءةٍ
Dialogue: 0,0:23:11.69,0:23:18.05,ED-Ara,,0,0,0,,ما هي إلّا لعنةٌ مُحبّبةٌ لا أكثر
Dialogue: 0,0:23:18.55,0:23:23.22,ED-Ara,,0,0,0,,،إن كانتْ ستسلبُ كلّ شيءٍ في طرفةِ عينٍ
Dialogue: 0,0:23:24.65,0:23:29.02,ED-Ara,,0,0,0,,فسيُخيّمُ عليكَ اليأسُ سرمدًا ولو للحظةٍ
Dialogue: 0,0:23:29.08,0:23:32.49,ED-Ara,,0,0,0,,...في صورةٍ واحدةٍ
Dialogue: 0,0:23:32.85,0:23:34.36,ED-Ara,,0,0,0,,لا أقوى على رؤيتها
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Serial Experiments Lain *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:16.82,0:00:23.16,OP-Ara,,0,0,0,,يبدو أنّكَ لا تعي الأمر
Dialogue: 0,0:00:21.91,0:00:28.34,OP-Ara-L,,0,0,0,,يا للأسف، خِلتُكَ رجلًا صادقًا
Dialogue: 0,0:00:26.58,0:00:33.09,OP-Ara,,0,0,0,,وكلُّ تلكَ المخاوفِ الّتي تتشبّثُ بها
Dialogue: 0,0:00:31.71,0:00:38.39,OP-Ara-L,,0,0,0,,ستغدو همسًا يتردّدُ في أذنيكَ
Dialogue: 0,0:00:37.18,0:00:41.77,OP-Ara,,0,0,0,,وتُدركُ أنَّ ما يقولونهُ قد يُدميكَ
Dialogue: 0,0:00:39.93,0:00:44.23,OP-Ara-L,,0,0,0,,وتعلمُ أنَّ للأمرِ وقعًا عظيمًا
Dialogue: 0,0:00:42.52,0:00:48.98,OP-Ara,,0,0,0,,ومع ذلكَ، لا يُخالجكَ أيُّ شعور
Dialogue: 0,0:00:47.69,0:00:54.65,OP-Ara-L,,0,0,0,,أهوي، وأتلاشى
Dialogue: 0,0:00:52.86,0:00:58.78,OP-Ara,,0,0,0,,خسرتُ كلَّ شيء
Dialogue: 0,0:01:17.51,0:01:26.81,OP-Ara,,0,0,0,,أهوي، وأتلاشى، وأغرق
Dialogue: 0,0:01:25.27,0:01:29.44,OP-Ara-L,,0,0,0,,أعنّي كي أتنفّس
Dialogue: 0,0:01:27.48,0:01:34.65,OP-Ara,,0,0,0,,أتألّمُ، وقد خسرتُ كلَّ شيء
Dialogue: 0,0:01:33.03,0:01:37.20,OP-Ara-L,,0,0,0,,إنّي أنهزم
Dialogue: 0,0:01:35.57,0:01:41.41,OP-Ara,,0,0,0,,أعنّي كي أتنفّس
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Serial Experiments Lain *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:31.49,0:22:40.29,ED-Ara,,0,0,0,,رغم براءتي، أجدني أتلقّى عقابًا
Dialogue: 0,0:22:40.29,0:22:46.88,ED-Ara,,0,0,0,,لم أكن زارع تلك البذور
Dialogue: 0,0:22:46.88,0:22:53.05,ED-Ara,,0,0,0,,بيد أنّي مُجبرٌ على اجتثاثِ الزهورِ الّتي تفتّقت منها
Dialogue: 0,0:22:59.60,0:23:04.23,ED-Ara,,0,0,0,,لا يسعني ادّعاء الجهل بالأمر
Dialogue: 0,0:23:04.23,0:23:08.70,ED-Ara,,0,0,0,,غير أنّي لا أذكر ضلوعي فيه
Dialogue: 0,0:23:08.70,0:23:14.99,ED-Ara,,0,0,0,,أظنّ أنَّ حرّيّتي كلّفتني ثمنًا باهظًا
Dialogue: 0,0:23:15.41,0:23:22.34,ED-Ara,,0,0,0,,لكنّي لا أذكر بيع روحي بهذا الرّخص
Dialogue: 0,0:23:22.50,0:23:30.34,ED-Ara,,0,0,0,,...إلى أن يحين موتي وأودّعكم
Dialogue: 0,0:23:31.22,0:23:40.10,ED-Ara,,0,0,0,,لن يقوى أحد على لمسي
Dialogue: 0,0:23:41.48,0:23:45.69,ED-Ara,,0,0,0,,أغلبُ الظنِّ أنّك غافلٌ
Dialogue: 0,0:23:45.69,0:23:54.74,ED-Ara,,0,0,0,,عن المارقين الأبديّين الّذين يجوبون الليل البعيد
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Ayakashi Triangle *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:01:49.94,0:01:55.29,OP-Ara,,0,0,0,,فجأةً شعرتُ بكيان حولي اخترق الأجواء مثل عاصفة من الرياح
Dialogue: 0,0:01:55.82,0:02:01.03,OP-Ara,,0,0,0,,ولمّا اقترب منّي، صرتُ مليئةً بنقاط الضعف دون أن أدرك
Dialogue: 0,0:02:01.51,0:02:04.09,OP-Ara,,0,0,0,,أريدكَ أن تحتضنني وتحميني
Dialogue: 0,0:02:04.41,0:02:07.06,OP-Ara,,0,0,0,,وأريدُ استهداف نقاط ضعفك
Dialogue: 0,0:02:07.31,0:02:09.76,OP-Ara,,0,0,0,,حتّى لو أخفيتها ستظل مكشوفةً
Dialogue: 0,0:02:10.20,0:02:12.69,OP-Ara,,0,0,0,,لأنّي جشعةٌ ولستُ سهلةً
Dialogue: 0,0:02:12.79,0:02:15.84,OP-Ara,,0,0,0,,صراحتكَ وحدها لا لا تكفي
Dialogue: 0,0:02:15.84,0:02:18.82,OP-Ara,,0,0,0,,أرني المزيد والمزيد من الحيل الّتي بجعبتك
Dialogue: 0,0:02:18.82,0:02:21.71,OP-Ara,,0,0,0,,لا يمكنني اتّخاذ قراري، لكن لا يسعني الانتظار أكثر
Dialogue: 0,0:02:21.71,0:02:24.17,OP-Ara,,0,0,0,,النصر لمن يتّخذ الخطوة الأولى
Dialogue: 0,0:02:24.17,0:02:27.36,OP-Ara,,0,0,0,,بنفسكَ الأشبه بالرياح المتّقدة
Dialogue: 0,0:02:27.36,0:02:30.24,OP-Ara,,0,0,0,,صوّب نحو الهدف واقلب زمام الأمور
Dialogue: 0,0:02:30.39,0:02:36.27,OP-Ara,,0,0,0,,ستكتمل الدائرة إن استمرّت الأحداث على هذا المنوال
Dialogue: 0,0:02:36.27,0:02:41.89,OP-Ara,,0,0,0,,سأفدي بروحي وجسدي لأبقى بجانبك فحسب
Dialogue: 0,0:02:41.89,0:02:47.15,OP-Ara,,0,0,0,,قشعريرة مرّت عبر عموديَّ الفقري حتّى بلغتْ أطراف أصابع قدمي
Dialogue: 0,0:02:47.92,0:02:50.70,OP-Ara,,0,0,0,,حبيبي، نبضات قلبي لا تهدأ
Dialogue: 0,0:02:50.79,0:02:53.62,OP-Ara,,0,0,0,,عزيزي، ماذا ستفعل لو صرتُ مشاكسةً
Dialogue: 0,0:02:53.70,0:02:56.38,OP-Ara,,0,0,0,,عزيزي الغالي، سأفعل أيَّ شيء لأجلك
Dialogue: 0,0:02:56.57,0:03:00.74,OP-Ara,,0,0,0,,سأصبح أيَّ شيء وستبقى نفسي كما عهدتها
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Ayakashi Triangle *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 5,0:22:10.16,0:22:14.25,ED-Ara,,0,0,0,,أدور وأدور، أدور وأدور
Dialogue: 5,0:22:23.30,0:22:26.63,ED-Ara,,0,0,0,,ترفرف في مهبّ الريح رغم انعدامها
Dialogue: 5,0:22:26.75,0:22:29.97,ED-Ara,,0,0,0,,وتجعل من الأشياء حقيقة، فيا تُرى من تكون؟
Dialogue: 5,0:22:30.26,0:22:33.34,ED-Ara,,0,0,0,,أشعر بنبضات قلبي وكأنّها طاحونة هواءٍ
Dialogue: 5,0:22:33.34,0:22:36.21,ED-Ara,,0,0,0,,تدور وتدور باستمرار
Dialogue: 5,0:22:36.37,0:22:39.72,ED-Ara,,0,0,0,,عبر كلّ ذكرياتنا القديمة
Dialogue: 5,0:22:39.84,0:22:43.04,ED-Ara,,0,0,0,,سنلتقي هنا والآن
Dialogue: 5,0:22:43.28,0:22:46.35,ED-Ara,,0,0,0,,حتّى لو انقلب مصيرنا رأسًا على عقب
Dialogue: 5,0:22:46.35,0:22:49.32,ED-Ara,,0,0,0,,ما زلتُ أريدك رغمًا عن ذلك
Dialogue: 5,0:22:49.33,0:22:51.21,ED-Ara,,0,0,0,,أقسمتُ بحمايتك
Dialogue: 5,0:22:51.21,0:22:52.91,ED-Ara,,0,0,0,,سأجعل من أمنيتك حقيقةً
Dialogue: 5,0:22:52.91,0:22:55.27,ED-Ara,,0,0,0,,سنتحدّى الزمان ونتشابك الأيدي
Dialogue: 5,0:22:55.29,0:22:57.89,ED-Ara,,0,0,0,,ركبتُ الرياح
Dialogue: 5,0:22:57.89,0:22:59.62,ED-Ara,,0,0,0,,الّتي جمعتنا وقرّبتنا
Dialogue: 5,0:22:59.62,0:23:03.62,ED-Ara,,0,0,0,,تتّجه نبضات قلبي نحوك
Dialogue: 5,0:23:03.72,0:23:07.24,ED-Ara,,0,0,0,,هذا لن يتغيّر ولن يتغيّر أبدًا
Dialogue: 5,0:23:07.24,0:23:10.03,ED-Ara,,0,0,0,,يا فتاتي الحلوة والبريئة
Dialogue: 5,0:23:10.03,0:23:13.54,ED-Ara,,0,0,0,,ما دامت هذه الرغبة راسخةً في قلبي
Dialogue: 5,0:23:13.54,0:23:17.43,ED-Ara,,0,0,0,,فلن أهتمّ حتّى لو لم يستيقظ جسدي
Dialogue: 5,0:23:17.61,0:23:21.43,ED-Ara,,0,0,0,,لن أمانع وسأتخلّى عنه
Dialogue: 5,0:23:21.52,0:23:25.05,ED-Ara,,0,0,0,,أدور وأدور، أدور وأدور
Dialogue: 5,0:23:25.05,0:23:28.38,ED-Ara,,0,0,0,,دورتان من الحياة مرتبطتان معًا
Dialogue: 5,0:23:28.44,0:23:32.01,ED-Ara,,0,0,0,,أدور وأدور باحثةً عنك
Dialogue: 5,0:23:32.01,0:23:35.20,ED-Ara,,0,0,0,,أطاردك بعينيّ باحثةً عن ظلّك
Dialogue: 5,0:23:35.40,0:23:38.52,ED-Ara,,0,0,0,,أدور وأدور
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية فيلم أنمي Date a Bullet *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:26:00.67,0:26:01.42,ED-Ara,,0,0,0,,قفزتُ عبر الزّمن‏ ساعيةً خلفَ رغبةٍ واحدة‏
Dialogue: 0,0:26:11.41,0:26:12.16,ED-Ara,,0,0,0,,تنعكس في عيوني حين أنّي متمسّكة بذلك اليوم
Dialogue: 0,0:26:32.92,0:26:33.67,ED-Ara,,0,0,0,,نلتقي، نفترق ثُمَّ نلتقي
Dialogue: 0,0:26:38.28,0:26:39.03,ED-Ara,,0,0,0,,عبر مُرور الزَّمن مرّةً أخرى
Dialogue: 0,0:26:54.36,0:26:55.11,ED-Ara,,0,0,0,,لذلك ليس عليَّ ذرفُ الدُّموع
Dialogue: 0,0:27:05.15,0:27:05.90,ED-Ara,,0,0,0,,وسأدفنُ خيبة الأمل هذه في نفسي، ثمَّ أتمنّى مرّةً أخرى
Dialogue: 0,0:27:48.04,0:27:48.84,ED2-Ara L Blue,,0,0,0,,في أعماق هذا القلب ما زلتِ محاصرة
Dialogue: 0,0:27:56.30,0:27:57.10,ED2-Ara D Blue,,0,0,0,,أنتِ وابتسامتُكِ الّتي لا تتلاشى أبدًا
Dialogue: 0,0:28:03.93,0:28:04.73,ED2-Ara Yellow,,0,0,0,,أطرافُ أصابعَ صغيرةٍ، خدودٌ محمرّةٌ، وخلودٌ بعيد المنال
Dialogue: 0,0:28:19.39,0:28:20.19,ED2-Ara Green,,0,0,0,,سأظلُّ متمسِّكةً بذلك الوقت الثّمين
Dialogue: 0,0:28:26.58,0:28:27.38,ED2-Ara Green LT,,0,0,0,,الوقت الثّمين
Dialogue: 0,0:28:27.84,0:28:28.64,ED2-Ara Violet,,0,0,0,,في حين أهمسُ بكلماتِ الفراق
Dialogue: 0,0:28:32.67,0:28:33.47,ED2-Ara Violet LT,,0,0,0,,في حين أهمس
Dialogue: 0,0:28:35.77,0:28:36.57,ED2-Ara Pink,,0,0,0,,لإخفاء تلكَ العيون الدَّامعة
Dialogue: 0,0:28:44.81,0:28:45.61,ED2-Ara Last,,0,0,0,,عن طريق التَّحديقِ في تلكَ الأيَّام
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Dosanko Gal wa Namara Menkoi *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:56.20,0:00:59.68,OP-Ara,,0,0,0,,ابتسامتكِ إشراقةٌ تُضاهي ضياء الشمس
Dialogue: 0,0:00:59.89,0:01:03.00,OP-Ara,,0,0,0,,فإذا بصقيعِ المدينةِ ينصهرُ من دِفئكِ
Dialogue: 0,0:01:03.29,0:01:05.58,OP-Ara,,0,0,0,,هيهاتَ أن يتوقّف هذا السيل الآن
Dialogue: 0,0:01:05.71,0:01:07.60,OP-Ara,,0,0,0,,يا لها من غيارو فاتنةٍ
Dialogue: 0,0:01:07.26,0:01:08.59,OP-Ara-R,,0,0,0,,غيارو هوكايدو جمالهنَّ آسرٌ
Dialogue: 0,0:01:08.68,0:01:10.05,OP-Ara,,0,0,0,,غيارو هوكايدو جمالهنَّ أخّاذٌ
Dialogue: 0,0:01:10.69,0:01:12.19,OP-Ara,,0,0,0,,غيارو هوكايدو جمالهنَّ آسرٌ
Dialogue: 0,0:01:14.13,0:01:15.56,OP-Ara,,0,0,0,,نقيّةٌ كبلورِ الثلج بجمالٍ لا يُضاهى
