Dialogue: 0,0:58:18.29,0:58:21.37,ED-Ara,,0,0,0,,‫متشابكان، متشابكان
Dialogue: 0,0:58:21.49,0:58:22.96,ED-Ara,,0,0,0,,‫خيوطنا
Dialogue: 0,0:58:23.01,0:58:26.65,ED-Ara,,0,0,0,,‫والمصير بأيدينا
Dialogue: 0,0:58:26.65,0:58:28.08,ED-Ara,,0,0,0,,‫شمسٌ آفلة، شمسٌ آفلة
Dialogue: 0,0:58:28.08,0:58:29.52,ED-Ara,,0,0,0,,‫قمرك، قمرنا
Dialogue: 0,0:58:29.52,0:58:31.13,ED-Ara,,0,0,0,,‫أتمتم بلحنٍ شجيّ
Dialogue: 0,0:58:31.13,0:58:32.43,ED-Ara,,0,0,0,,‫بكلماتٍ حلوة المعنى
Dialogue: 0,0:58:32.43,0:58:34.09,ED-Ara,,0,0,0,,‫الكريستالات والشهب
Dialogue: 0,0:58:34.09,0:58:35.60,ED-Ara,,0,0,0,,‫مضيئةٌ، مشتعلةٌ
Dialogue: 0,0:58:35.60,0:58:37.11,ED-Ara,,0,0,0,,‫ينشرون البهجة في نواحي السماء الأربع
Dialogue: 0,0:58:37.11,0:58:38.62,ED-Ara,,0,0,0,,ابقَ حيًّا
Dialogue: 0,0:58:38.62,0:58:39.79,ED-Ara,,0,0,0,,‫أنت الضياء
Dialogue: 0,0:58:39.79,0:58:41.34,ED-Ara,,0,0,0,,‫تشبعني بالرؤى
Dialogue: 0,0:58:41.34,0:58:42.78,ED-Ara,,0,0,0,,‫وتُذْكي الرّجا
Dialogue: 0,0:58:42.78,0:58:44.64,ED-Ara,,0,0,0,,‫وترافقني إلى النجوم الخافية
Dialogue: 0,0:58:44.64,0:58:45.79,ED-Ara,,0,0,0,,‫أنت هزيم الرّعد
Dialogue: 0,0:58:45.79,0:58:47.32,ED-Ara,,0,0,0,,‫توصل صوتي للمسامع
Dialogue: 0,0:58:47.32,0:58:48.69,ED-Ara,,0,0,0,,‫وتلقّنني فضيلة التواضع
Dialogue: 0,0:58:48.69,0:58:51.73,ED-Ara,,0,0,0,,‫لقّنتني معنى أن أكون راسخةً
Dialogue: 0,0:58:51.73,0:58:57.76,ED-Ara,,0,0,0,,‫ولهذا لم أعد خائفةً من الآن فصاعدًا
Dialogue: 0,0:58:57.76,0:59:00.91,ED-Ara,,0,0,0,,وأعترف بأَخطائي
Dialogue: 0,0:59:00.91,0:59:03.68,ED-Ara,,0,0,0,,‫أنت تقدّرني مصيبةً كنتُ أم مخطئةً
Dialogue: 0,0:59:03.68,0:59:06.90,ED-Ara,,0,0,0,,‫ورغم أنّك لست معي بعد الآن
Dialogue: 0,0:59:06.90,0:59:09.78,ED-Ara,,0,0,0,,‫منحتني الكثير لأتمكّن من مواصلة العيش
Dialogue: 0,0:59:09.78,0:59:14.15,ED-Ara,,0,0,0,,‫ثباتك، يبقى
Dialogue: 0,0:59:14.15,0:59:17.05,ED-Ara,,0,0,0,,‫بلا تقدير، وما كان ليكون
Dialogue: 0,0:59:17.51,0:59:20.55,ED-Ara,,0,0,0,,حُلمٌ متلاشٍ
Dialogue: 0,0:59:20.55,0:59:23.79,ED-Ara,,0,0,0,,‫قلّ لي، قلّ لي
Dialogue: 0,0:59:28.01,0:59:29.33,ED-Ara,,0,0,0,,‫بلا خوف
Dialogue: 0,0:59:29.50,0:59:32.79,ED-Ara,,0,0,0,,‫بل انهمرت دموعي امتنانًا فحسب
Dialogue: 0,0:59:34.50,0:59:36.05,ED-Ara,,0,0,0,,‫شمسٌ آفلة، شمسٌ آفلة
Dialogue: 0,0:59:36.05,0:59:37.60,ED-Ara,,0,0,0,,‫قمرك، قمرنا
Dialogue: 0,0:59:37.60,0:59:39.09,ED-Ara,,0,0,0,,‫ينشرون البهجة في نواحي السماء الأربع
Dialogue: 0,0:59:39.09,0:59:40.58,ED-Ara,,0,0,0,,‫ابقَ حيًّا
Dialogue: 0,0:59:40.58,0:59:41.86,ED-Ara,,0,0,0,,‫أنت الضياء
Dialogue: 0,0:59:41.86,0:59:43.31,ED-Ara,,0,0,0,,‫تعبر بين الصقيع
Dialogue: 0,0:59:43.31,0:59:49.15,ED-Ara,,0,0,0,,‫وبين الثرى تحيل الثلوج إلى حقول زهورٍ بيضاء ناصعة
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Goblin Slayer الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:59.90,0:01:02.73,OP-Ar,,0,0,0,,فاكهة سوداء، عصير فاكهة قرمزيّ
Dialogue: 0,0:01:02.73,0:01:07.61,OP-Ar,,0,0,0,,إنّه حرق لأحداث النهاية المحتومة
Dialogue: 0,0:01:07.61,0:01:13.55,OP-Ar,,0,0,0,,كُتبَ بناءً على رغبتهم في الدمار
Dialogue: 0,0:01:14.18,0:01:16.58,OP-Ar,,0,0,0,,في النهار والليل
Dialogue: 0,0:01:17.02,0:01:19.61,OP-Ar,,0,0,0,,نجوب الطرق باحثين
Dialogue: 0,0:01:19.61,0:01:22.74,OP-Ar,,0,0,0,,متشبّثين بأمل العثور على درب آخر
Dialogue: 0,0:01:22.97,0:01:24.35,OP-Ar,,0,0,0,,يقودنا إلى النعيم
Dialogue: 0,0:01:24.35,0:01:26.90,OP-Ar,,0,0,0,,النعيم يرتقب مبادرتنا
Dialogue: 0,0:01:26.90,0:01:29.72,OP-Ar,,0,0,0,,آملًا القتال
Dialogue: 0,0:01:29.72,0:01:30.72,OP-Ar,,0,0,0,,لا مكسب
Dialogue: 0,0:01:30.72,0:01:33.89,OP-Ar,,0,0,0,,إلّا الألم، إلّا الألم، إلّا الألم، إلّا الألم
Dialogue: 0,0:01:33.89,0:01:34.72,OP-Ar,,0,0,0,,جلّ هذا الألم
Dialogue: 0,0:01:34.72,0:01:38.14,OP-Ar,,0,0,0,,ألمي ليس بُغْيَة متعةٍ
Dialogue: 0,0:01:36.85,0:01:39.28,OP-Ar,,0,0,130,,عُدَّ معي واحد اثنان ثلاثة
Dialogue: 0,0:01:39.28,0:01:42.62,OP-Ar,,0,0,0,,كم تقدر أن تنزف دمًا
Dialogue: 0,0:01:43.20,0:01:46.40,OP-Ar,,0,0,0,,كم من مرّةٍ تنوي الصمود
Dialogue: 0,0:01:46.40,0:01:49.09,OP-Ar,,0,0,0,,كم من روحٍ تحتاج
Dialogue: 0,0:01:49.61,0:01:54.65,OP-Ar,,0,0,0,,شهدتُ نجمًا يضيء في الظلام
Dialogue: 0,0:01:55.06,0:02:03.50,OP-Ar,,0,0,0,,لذا لا تُخمد لهيبي حتّى يحرق كلّ ما لدينا
Dialogue: 0,0:02:03.50,0:02:08.25,OP-Ar,,0,0,0,,فوجودنا ليس دائمًا
Dialogue: 0,0:02:08.25,0:02:13.59,OP-Ar,,0,0,0,,لا تتوسّل طالبًا الرحمة
Dialogue: 0,0:02:13.62,0:02:15.16,OP-Ar,,0,0,0,,حينما أفوز
Dialogue: 0,0:02:15.25,0:02:16.82,OP-Ar,,0,0,0,,لن أسامح أبدًا
Dialogue: 0,0:02:16.82,0:02:18.36,OP-Ar,,0,0,0,,وسأفوز
Dialogue: 0,0:02:18.39,0:02:20.00,OP-Ar,,0,0,0,,وسأفوز
Dialogue: 0,0:02:20.00,0:02:26.85,OP-Ar,,0,0,0,,أجل سأفوز  في لعبتك ذات الطرف الواحد
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Goblin Slayer الموسم الثاني *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:02.61,0:22:07.31,ED-Ara,,0,0,0,,يتشوّه ويتلاشى كلّ ما من حولي
Dialogue: 0,0:22:07.85,0:22:13.49,ED-Ara,,0,0,0,,بينما يتباكى القمر في أعالي السماء الغائمة
Dialogue: 0,0:22:28.97,0:22:33.42,ED-Ara,,0,0,0,,أقف غريبةً ووحيدةً أمام مرآة ماءٍ مشوّهةٍ
Dialogue: 0,0:22:34.02,0:22:38.65,ED-Ara,,0,0,0,,حيث لا وجود لألمٍ في انعكاس ظلّ وجهٍ ضائع
Dialogue: 0,0:22:39.10,0:22:43.56,ED-Ara,,0,0,0,,يخيّم الليل علينا وهو موحش بشدّة
Dialogue: 0,0:22:43.81,0:22:47.96,ED-Ara,,0,0,0,,دافعًا بالرياح مثل أشعّة الشمس المنسدلة
Dialogue: 0,0:22:49.54,0:22:53.91,ED-Ara,,0,0,0,,يهيم كلّ شيءٍ ويثري الضوء ونحن ننظر إلى السماء
Dialogue: 0,0:22:54.28,0:22:58.65,ED-Ara,,0,0,0,,نحو وميض الشمس الّذي ما زال ينير هذا العالم
Dialogue: 0,0:22:59.45,0:23:04.06,ED-Ara,,0,0,0,,يتشوّه ويتلاشى كلّ ما من حولي
Dialogue: 0,0:23:04.61,0:23:09.35,ED-Ara,,0,0,0,,بينما يتباكى القمر في أعالي السماء الغائمة
Dialogue: 0,0:23:09.62,0:23:14.29,ED-Ara,,0,0,0,,لا يصلني شيءٌ ولا حتّى ألمه
Dialogue: 0,0:23:14.60,0:23:19.57,ED-Ara,,0,0,0,,يفيض الظلام مثل الفراغ ما بين ضربات البرق
Dialogue: 0,0:23:20.08,0:23:22.43,ED-Ara,,0,0,0,,صوت إلهيّ أصرخ تجاهه بأعلى صوتٍ
Dialogue: 0,0:23:22.67,0:23:24.98,ED-Ara,,0,0,0,,حين يتجلّى الضوء في الليل
Dialogue: 0,0:23:25.28,0:23:31.40,ED-Ara,,0,0,0,,أندفع إلى ما وراء الضباب
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Natsume Yuujinchou Shichi الحلقة الخاصّة من الموسم الأخير *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:10.99,0:00:14.46,OP-Ara,,0,0,0,,زهرةٌ تُزهر حين أنادي اسمها
Dialogue: 0,0:00:14.80,0:00:22.07,OP-Ara,,0,0,0,,وروح الريح العابثة تداعب السماء الزرقاء وتمضي
Dialogue: 0,0:00:22.31,0:00:31.07,OP-Ara,,0,0,0,,حين أمضي يمدّ نور الصباح يديه إليّ
Dialogue: 0,0:00:32.44,0:00:37.74,OP-Ara,,0,0,0,,توقّفتُ عن حصر النواقص والعوز
Dialogue: 0,0:00:37.77,0:00:43.40,OP-Ara,,0,0,0,,فما يزول بخطأ لا أُلقي له بالًا
Dialogue: 0,0:00:43.46,0:00:53.97,OP-Ara,,0,0,0,,تخلّيتُ عن العزلة وهذه الكفُّ لا تمسك سوى راحةِ يدك
Dialogue: 0,0:00:56.28,0:01:05.87,OP-Ara,,0,0,0,,العالم الّذي رسمناه معًا يزهو بأجمل الألوان البهيجة
Dialogue: 0,0:01:04.83,0:01:08.28,OP-Ara,,0,0,130,,شيءٌ يُشرق في أعماق قلبي
Dialogue: 0,0:01:06.96,0:01:17.08,OP-Ara,,0,0,0,,لقاؤنا منشورٌ سباعيُّ الألوان يضيء الوجود بانعكاسه الساحر
Dialogue: 0,0:01:17.12,0:01:25.21,OP-Ara,,0,0,0,,لأنَّ العيون لا ترى شيئًا إن كانت وحيدةً
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Natsume Yuujinchou Shichi الحلقة الخاصّة من الموسم الأخير *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:05.74,0:22:08.75,ED-Ara,,0,0,0,,‫تحت سماءٍ زاهية الصفاء،
Dialogue: 0,0:22:08.79,0:22:11.08,ED-Ara,,0,0,0,,كنتِ تبتسمين
Dialogue: 0,0:22:11.64,0:22:17.18,ED-Ara,,0,0,0,,كنتِ تطاردينني هذا الّذي يفرّ بعد أن يُمسَك به
Dialogue: 0,0:22:17.57,0:22:22.75,ED-Ara,,0,0,0,,‫ما كان بين يديَّ المربوطتين بظلّي المتطاول،
Dialogue: 0,0:22:23.50,0:22:28.66,ED-Ara,,0,0,0,,لم ألحظه فإذا بي قد نضجتُ شيئًا فشيئًا
Dialogue: 0,0:22:29.55,0:22:34.60,ED-Ara,,0,0,0,,‫تلك الكفّ الحنون الّتي كنتُ أُبعدها عنّي،
Dialogue: 0,0:22:35.41,0:22:40.64,ED-Ara,,0,0,0,,كم يلزمُني من عُمرٍ لأصارحكِ بمشاعري؟
Dialogue: 0,0:22:43.54,0:22:49.78,ED-Ara,,0,0,0,,‫تكملةُ حلم ذلك اليوم الّذي أردتُ نسيانه،
Dialogue: 0,0:22:49.78,0:22:53.11,ED-Ara,,0,0,0,,توارى عن الوجود دون أن أشعر
Dialogue: 0,0:22:53.11,0:22:55.31,ED-Ara,,0,0,0,,‫تمنّيتُ ذلك، ولكن...
Dialogue: 0,0:22:55.38,0:23:01.61,ED-Ara,,0,0,0,,لِمَ لا أحد يمكنه سدّ هذا الفراغ سِواكِ؟
Dialogue: 0,0:23:01.62,0:23:07.19,ED-Ara,,0,0,0,,‫وها أنا ذا أصبحتُ أحتاجُكِ،
Dialogue: 0,0:23:08.13,0:23:10.19,ED-Ara,,0,0,0,,مرّةً أخرى
Dialogue: 0,0:23:10.34,0:23:11.89,ED-Ara,,0,0,0,,‫في أحد الأيّام،
Dialogue: 0,0:23:11.89,0:23:16.09,ED-Ara,,0,0,0,,‫أتمنّى أن يبلغكِ صدى قلبي بصدقٍ،
Dialogue: 0,0:23:17.06,0:23:19.12,ED-Ara,,0,0,0,,مُتجسّدًا في كلمة شكرٍ
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة بداية أنمي Isekai de Cheat Skill *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:01:53.32,0:01:56.48,OP-Ara,,0,0,0,,لو أنّ نفسًا قادرةٌ على فناء الدنيا
Dialogue: 0,0:01:56.49,0:01:59.25,OP-Ara,,0,0,0,,فلا يُفنيها حتّى أعظم السحر
Dialogue: 0,0:01:59.25,0:02:02.16,OP-Ara,,0,0,0,,لن أدع أحدًا يسلبها منّي حتّى وإن طالني الموت
Dialogue: 0,0:02:02.42,0:02:05.91,OP-Ara,,0,0,0,,لن أدع أحدًا يسلب هذا القلب منّي
Dialogue: 0,0:02:19.29,0:02:21.64,OP-Ara,,0,0,0,,سأجعلها تزهر في رُبىً ساكنةٍ
Dialogue: 0,0:02:21.64,0:02:24.56,OP-Ara,,0,0,0,,فيه تتجلّى أمانٍ وأحلامٌ لا مثيل لها
Dialogue: 0,0:02:24.68,0:02:27.13,OP-Ara,,0,0,0,,كأنّي أُحيل الواقع إلى خيالٍ بضربةِ الأحلامِ
Dialogue: 0,0:02:27.13,0:02:30.41,OP-Ara,,0,0,0,,أأجعلُ هذا الخيال حقيقةً؟
Dialogue: 0,0:02:30.42,0:02:33.37,OP-Ara,,0,0,0,,في ذلك المضيق الّذي انتهيتُ فيه بعد كلِّ هذا الجهد
Dialogue: 0,0:02:33.37,0:02:36.10,OP-Ara,,0,0,0,,وحتّى في حياةٍ تتلاشى فيها السماءُ الزرقاء
Dialogue: 0,0:02:36.10,0:02:40.33,OP-Ara,,0,0,0,,ما زال في قلبي إيمانٌ بشيءٍ ما
Dialogue: 0,0:02:40.68,0:02:43.99,OP-Ara,,0,0,0,,لو كان بالإمكان لنسجتُ عالمًا جديدًا من العدم
Dialogue: 0,0:02:43.99,0:02:47.71,OP-Ara,,0,0,0,,مثل معجزةٍ تُزهرُ الأشجارَ اليابسة
Dialogue: 0,0:02:47.71,0:02:51.89,OP-Ara,,0,0,0,,لذا عليَّ أن أبلغ من القوّة حدًّا يجعلُ هذا واقعًا
Dialogue: 0,0:02:51.90,0:02:55.18,OP-Ara,,0,0,0,,لو أنَّ نفسًا قادرةٌ على فناء الدنيا
Dialogue: 0,0:02:55.18,0:02:57.93,OP-Ara,,0,0,0,,فلا يُفنيها حتّى أعظم السحر
Dialogue: 0,0:02:57.93,0:03:03.24,OP-Ara,,0,0,0,,هذا صحيح، الأسى والألم لن يضيعا سدًى
Dialogue: 0,0:03:03.38,0:03:06.19,OP-Ara,,0,0,0,,الغد الّذي ترتسم فيه بسماتنا
Dialogue: 0,0:03:06.19,0:03:07.46,OP-Ara,,0,0,0,,أريد رؤيته
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,* شارة نهاية أنمي Isekai de Cheat Skill *
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:22:01.61,0:22:04.19,ED-Ara,,0,0,0,,أخبرني، لِمَ نعيشُ يا تُرى؟
Dialogue: 0,0:22:04.95,0:22:07.96,ED-Ara,,0,0,0,,ولِمَ نحملُ كلَّ هذا الحقد؟
Dialogue: 0,0:22:08.80,0:22:11.30,ED-Ara,,0,0,0,,أخبرني، ما الّذي ينبغي علينا فعله
Dialogue: 0,0:22:12.15,0:22:15.09,ED-Ara,,0,0,0,,لنغدو أرقَّ قلوبًا؟
Dialogue: 0,0:22:15.85,0:22:18.53,ED-Ara,,0,0,0,,في ليلةٍ كهذه صادفتُك
Dialogue: 0,0:22:19.58,0:22:22.39,ED-Ara,,0,0,0,,وأنتَ تكاد تتهاوى بين يديّ
Dialogue: 0,0:22:22.95,0:22:25.87,ED-Ara,,0,0,0,,لأنَّ جراحي غائرةٌ
Dialogue: 0,0:22:26.67,0:22:29.65,ED-Ara,,0,0,0,,استطعتُ أن ألينَ جانبًا
Dialogue: 0,0:22:30.35,0:22:36.57,ED-Ara,,0,0,0,,تمطرُ علينا نوائبُ الدهر بأشكالِها
