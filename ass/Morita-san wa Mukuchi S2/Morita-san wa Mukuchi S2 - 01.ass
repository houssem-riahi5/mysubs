Dialogue: 0,0:00:36.92,0:00:37.89,Top,,0,0,0,,تفضّلي
Dialogue: 0,0:00:43.14,0:00:44.03,Top,,0,0,0,,تفضّلي
Dialogue: 0,0:00:52.30,0:00:53.31,Main,,0,0,0,,تفضّلي
Dialogue: 0,0:00:56.11,0:00:58.20,Main,,0,0,0,,يصعب العمل والجوّ هادئ هكذا
Dialogue: 0,0:00:59.50,0:01:01.62,Main,,0,0,0,,خمسة عشر مليمترًا من الأسفل
Dialogue: 0,0:01:01.62,0:01:03.50,Main,,0,0,0,,خمسة عشر مليمترًا من الأعلى
Dialogue: 0,0:01:04.14,0:01:07.29,Main,,0,0,0,,عليّ إنجاز الأمر بإتقان ودقة
Dialogue: 0,0:01:07.29,0:01:08.49,Main,,0,0,0,,تفضّلي
Dialogue: 0,0:01:12.28,0:01:13.23,Main,,0,0,0,,تفضّلي
Dialogue: 0,0:01:15.87,0:01:17.43,Main,,0,0,0,,عذرًا على ذلك
Dialogue: 0,0:01:17.43,0:01:19.72,Main,,0,0,0,,طال اجتماع الموظفين أكثر من الازم
Dialogue: 0,0:01:19.72,0:01:21.76,Main,,0,0,0,,!ما كان باليد حيلة
Dialogue: 0,0:01:21.76,0:01:23.93,Main,,0,0,0,,حسنٌ، لم يتبقَ سوى القليل
Dialogue: 0,0:01:25.86,0:01:29.02,Main,,0,0,0,,!شكرًا لكما، شكرًا
Dialogue: 0,0:01:34.62,0:01:36.53,Main,,0,0,0,,!حسنٌ، انتهيت
Dialogue: 0,0:01:36.53,0:01:39.00,Main,,0,0,0,,!يعود الفضل لكما، أنقذتماني
Dialogue: 0,0:01:39.60,0:01:41.33,Main,,0,0,0,,هذا واجب الأعضاء في النهاية
Dialogue: 0,0:01:42.50,0:01:44.03,Main,,0,0,0,,شكرًا
Dialogue: 0,0:01:46.55,0:01:48.46,Main,,0,0,0,,لسنا أطفالًا على أيّ حال
Dialogue: 0,0:01:48.46,0:01:50.64,Main,,0,0,0,,!موريتا-سان، يا لكِ من لطيفة
Dialogue: 0,0:01:51.33,0:01:54.09,Main,,0,0,0,,أمّا ياماموتو-سان فلستِ لطيفةً البتة
Dialogue: 0,0:01:54.09,0:01:57.15,Main,,0,0,0,,ما كنتُ لأسعد بمديحكِ لي على أيّ حال
Dialogue: 0,0:01:57.15,0:02:01.80,Main,,0,0,0,,!حسنٌ إذن، سأبتاع لكما مشروبًا مكافأةً على جهودكما
Dialogue: 0,0:02:01.80,0:02:02.98,Main,,0,0,0,,ماذا تودّان؟
Dialogue: 0,0:02:02.98,0:02:04.35,Main,,0,0,0,,سأشرب قهوة
Dialogue: 0,0:02:04.35,0:02:06.68,Main,,0,0,0,,دون سكر؟ مُحلاة؟
Dialogue: 0,0:02:06.68,0:02:08.56,Main,,0,0,0,,دون سكر ستكون جيدة
Dialogue: 0,0:02:08.56,0:02:10.73,Main,,0,0,0,,حسمتِ اختياركِ بسرعةٍ، أليس كذلك؟
Dialogue: 0,0:02:10.73,0:02:13.60,Main,,0,0,0,,دون سكر؟ مُحلاة؟
Dialogue: 0,0:02:13.63,0:02:16.32,Main,,0,0,0,,هل لديهم سكر زيادة وسكر خفيف أيضًا يا ترى؟
Dialogue: 0,0:02:20.26,0:02:21.56,Main,,0,0,0,,تفضّلي
Dialogue: 0,0:02:21.56,0:02:22.20,Main,,0,0,0,,تفضّلي
Dialogue: 0,0:02:22.20,0:02:25.04,Main,,0,0,0,,حسنٌ، سأذهب إلى أنشطة النادي
Dialogue: 0,0:02:26.41,0:02:28.53,Main,,0,0,0,,!شكرًا لكما
Dialogue: 0,0:02:30.70,0:02:31.50,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:02:33.10,0:02:36.01,Main,,0,0,0,,إن خمنت... لقلت إنّها عطشة للغاية
Dialogue: 0,0:02:38.49,0:02:39.96,Main,,0,0,0,,مايو، هل انتهيتِ؟
Dialogue: 0,0:02:41.41,0:02:43.45,Main,,0,0,0,,أتعطينني واحدة؟ شكرًا
Dialogue: 0,0:02:53.86,0:02:55.21,Main,,0,0,0,,!إنّها مرّة
Dialogue: 0,0:02:55.21,0:02:58.38,Main,,0,0,0,,أظن أنَّ لياماموتو-سان جانبًا لطيفًا أيضًا
Comment: 0,0:02:58.38,0:03:00.38,Main,,0,0,0,,
Comment: 0,0:02:58.38,0:03:00.38,Main,,0,0,0,,>>>> محاكاة <<<<
Comment: 0,0:02:58.38,0:03:00.38,Main,,0,0,0,,
