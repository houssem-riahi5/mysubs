Dialogue: 0,0:00:31.29,0:00:32.38,Top,,0,0,0,,!وجدتها
Dialogue: 0,0:00:32.38,0:00:34.79,Top,,0,0,0,,ما رأيكنَّ أن نبيت معًا هذه المرّة؟
Dialogue: 0,0:00:34.79,0:00:35.59,Top,,0,0,0,,.تبدو فكرةً جيّدة
Dialogue: 0,0:00:35.59,0:00:37.01,Top,,0,0,0,,!تبدو ممتعة
Dialogue: 0,0:00:37.01,0:00:39.47,Top,,0,0,0,,.لكنَّ منزلي ليس واسعًا بما يكفي
Dialogue: 0,0:00:39.47,0:00:42.22,Top,,0,0,0,,.رغم أنّك من طرحتِ هذه الفكرة
Dialogue: 0,0:00:42.22,0:00:44.89,Top,,0,0,0,,.أخي يدرسُ من أجل الامتحانات
Dialogue: 0,0:00:45.46,0:00:47.77,Top,,0,0,0,,ماذا عن منزلكِ يا هانا-تشان؟
Dialogue: 0,0:00:47.77,0:00:50.40,Main,,0,0,0,,...‏منزلي أشبهُ بساحةِ معركة‏
Dialogue: 0,0:00:50.40,0:00:52.99,Main,,0,0,0,,...إن أتيتُنَّ إلى منزلي، فأمّي وجدّتي ستكونان
Dialogue: 0,0:00:52.99,0:00:54.54,Main,,0,0,0,,!حسنٌ، لنبيت في منزل مايو إذن
Dialogue: 0,0:00:54.54,0:00:56.91,Main,,0,0,0,,!منزلُ مايو إذن
Dialogue: 0,0:01:03.51,0:01:05.01,Main,,0,0,0,,!مساءُ الخير
Dialogue: 0,0:01:05.23,0:01:06.30,Main,,0,0,0,,!أهلًا بكنَّ
Dialogue: 0,0:01:06.30,0:01:08.75,Main,,0,0,0,,!شكرًا على استضافتِنا
Dialogue: 0,0:01:09.09,0:01:11.56,Main,,0,0,0,,.يبدو الأمر كرحلة مدرسيّة
Dialogue: 0,0:01:11.56,0:01:12.92,Main,,0,0,0,,.أجل، أجل
Dialogue: 0,0:01:12.92,0:01:14.84,Main,,0,0,0,,...وحين نذكر الرحلات
Dialogue: 0,0:01:14.84,0:01:16.27,Main,,0,0,0,,!حرب الوسائد
Dialogue: 0,0:01:16.27,0:01:17.32,Main,,0,0,0,,.أجل، أجل
Dialogue: 0,0:01:17.32,0:01:19.39,Main,,0,0,0,,.انتهيتُ من إعداد الأفرشة
Dialogue: 0,0:01:23.82,0:01:27.00,Main,,0,0,0,,سيكون الأمر سيئًا لو رميتُ هذه، أليس كذلك؟
Dialogue: 0,0:01:27.00,0:01:28.04,Main,,0,0,0,,.أجل
Dialogue: 0,0:01:28.04,0:01:29.39,Main,,0,0,0,,.ستتأذين
Dialogue: 0,0:01:31.92,0:01:34.80,Main,,0,0,0,,!ما ألطف ثياب نومكِ يا هانا-تشان
Dialogue: 0,0:01:34.80,0:01:36.25,Main,,0,0,0,,!وأنتِ أيضًا يا ميكي-تشان
Dialogue: 0,0:01:36.25,0:01:38.25,Main,,0,0,0,,.ملابسكِ بسيطةٌ نوعًا ما
Dialogue: 0,0:01:38.25,0:01:40.47,Main,,0,0,0,,.ومع ذلك، ثمنُها باهظ
Dialogue: 0,0:01:40.47,0:01:42.29,Main,,0,0,0,,...أمّا مايو
Dialogue: 0,0:01:42.29,0:01:44.64,Main,,0,0,0,,!مثيرة
Dialogue: 0,0:01:44.64,0:01:46.82,Main,,0,0,0,,.أزرارُكِ ليست في مكانِها الصحيح
Dialogue: 0,0:01:47.44,0:01:50.00,Main,,0,0,0,,.لا لا، أقول إنَّ هذا خطؤكِ أنتِ
Dialogue: 0,0:01:50.00,0:01:52.73,Main,,0,0,0,,!لكن، لم يكن بيدي حيلة
Dialogue: 0,0:01:52.73,0:01:54.80,Main,,0,0,0,,أليس هذا خطأها يا هانا-تشان؟
Dialogue: 0,0:01:54.80,0:01:57.89,Main,,0,0,0,,...هذا صحيح، كان عليكِ الاجتهاد أكثر
Dialogue: 0,0:01:57.89,0:02:00.24,Main,,0,0,0,,حتّى أنتِ يا هانا-تشان؟
Dialogue: 0,0:02:00.89,0:02:03.07,Main,,0,0,0,,أيجدر بي ذلك؟
Dialogue: 0,0:02:03.07,0:02:06.66,Main,,0,0,0,,!لنتجاذب أطراف الحديث مع مايو الليلة
Dialogue: 0,0:02:06.66,0:02:09.21,Main,,0,0,0,,.أودُّ سماع ما في جعبتكِ يا مايو-تشان
Dialogue: 0,0:02:09.21,0:02:10.30,Main,,0,0,0,,.أجل، أجل
Dialogue: 0,0:02:10.30,0:02:12.57,Main,,0,0,0,,.لا يزال الليل في أوّله
Dialogue: 0,0:02:12.57,0:02:15.93,Main,,0,0,0,,...إن كنَّ يرغبنَ في ذلك
Dialogue: 0,0:02:17.01,0:02:19.69,Main,,0,0,0,,،بما أنّنا في الليل الآن
Dialogue: 0,0:02:19.69,0:02:22.58,Main,,0,0,0,,.ربّما عليّ التطرق في ذلك الأمر
Dialogue: 0,0:02:30.70,0:02:32.71,Main,,0,0,0,,.صباح الخير
Dialogue: 0,0:02:32.71,0:02:33.89,Main,,0,0,0,,ما الخطب؟
Dialogue: 0,0:02:33.89,0:02:35.55,Main,,0,0,0,,ألم تستطيعي النوم؟
Dialogue: 0,0:02:35.55,0:02:38.44,Main,,0,0,0,,،حين ذهبتُ إلى الحمّام ليلة البارحة
Dialogue: 0,0:02:42.89,0:02:46.02,Main,,0,0,0,,!كانت ثمّة امرأة جاثية عند المدخل
Dialogue: 0,0:02:46.02,0:02:48.17,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:02:48.17,0:02:50.35,Main,,0,0,0,,!أنا جادّة، رأيتها فعلًا
Dialogue: 0,0:02:50.35,0:02:51.71,Top,,0,0,0,,كنتِ متعبةً فحسب، أليس كذلك؟
Dialogue: 0,0:02:52.35,0:02:55.78,Top,,0,0,0,,!ليس الأمر كذلك، أنا أقول الحقيقة
Dialogue: 0,0:02:50.75,0:02:53.60,Main,,0,0,0,,...مايو، انتظرتُ طوال الليل
Dialogue: 0,0:02:53.60,0:02:55.78,Main,,0,0,0,,.ولم يعد والدكِ إلى المنزل قطّ
Dialogue: 0,0:02:55.78,0:02:57.36,Main,,0,0,0,,...عدتُ
Dialogue: 0,0:02:57.36,0:03:10.00,Main,,0,0,0,,!عزيزي
