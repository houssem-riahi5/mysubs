Dialogue: 10,0:00:07.73,0:00:08.86,Main,,0,0,0,,شوشو-سان
Dialogue: 10,0:00:10.61,0:00:12.86,Main,,0,0,0,,وردنا تقريرٌ من القائدة
Dialogue: 10,0:00:12.86,0:00:15.40,Main,,0,0,0,,يبدو أنَّ مأدبة أزوما قد انتهت
Dialogue: 10,0:00:17.23,0:00:18.40,Main,,0,0,0,,والنتيجة؟
Dialogue: 10,0:00:18.40,0:00:21.65,Main,,0,0,0,,الفائزة هي والدة هيماري-سان
Dialogue: 10,0:00:21.65,0:00:24.73,Main,,0,0,0,,حسنٌ، إنّها قائدة الفرقة التاسعة في النهاية
Dialogue: 10,0:00:24.73,0:00:26.23,Main,,0,0,0,,هذا هو الحال
Dialogue: 10,0:00:26.23,0:00:28.86,Main,,0,0,0,,هل أظهرت هيماري روح الفرقة السابعة؟
Dialogue: 10,0:00:28.86,0:00:32.44,Main,,0,0,0,,يبدو أنّها تصالحت مع عائلة أزوما
Dialogue: 10,0:00:32.44,0:00:34.77,Main,,0,0,0,,!واعترفوا بقوّتها
Dialogue: 10,0:00:35.54,0:00:36.73,Main,,0,0,0,,!هذا رائع
Dialogue: 10,0:00:36.73,0:00:39.68,Main,,0,0,0,,!أجل، لا شيء أفضل من العائلة السعيدة
Dialogue: 10,0:00:39.77,0:00:42.36,Main,,0,0,0,,هكذا إذن، هذا جيّد
Dialogue: 10,0:00:44.65,0:00:49.40,Main,,0,0,0,,قضى يوكي الأيام الخمسة الماضية ملازمًا لهيمارين في التدريب
Dialogue: 10,0:00:50.02,0:00:52.73,Main,,0,0,0,,لم أتمكن من التقرب منه إطلاقًا
Dialogue: 10,0:00:53.82,0:00:55.77,Main,,0,0,0,,!لكن دوري قد حان الآن
Dialogue: 10,0:00:56.07,0:00:57.69,Main,,0,0,0,,!خطتي محكمة
Dialogue: 10,0:00:57.69,0:01:01.48,Main,,0,0,0,,!سأوقع يوكي في حبّي هذه المرّة مهما كلف الأمر
Dialogue: 10,0:01:01.48,0:01:04.32,Top,,0,0,0,,!تمنح الرجال والنساء جرعة إضافية من الجرأة
Dialogue: 10,0:01:04.32,0:01:05.15,Top,,0,0,0,,!هذا صحيح
Dialogue: 10,0:01:05.15,0:01:06.94,Main,,0,0,0,,!بسحر الصيف
Dialogue: 10,0:01:06.94,0:01:08.40,Main,,0,0,0,,سحر؟
Dialogue: 10,0:02:45.19,0:02:49.15,Main,,0,0,0,,قضى المشاركون في مأدبة أزوما الليلة في قصر أزوما
Dialogue: 10,0:02:49.15,0:02:51.48,Main,,0,0,0,,لإراحة أجسادهم المتعبة
Dialogue: 10,0:02:55.52,0:02:58.48,Main,,0,0,0,,!الاستحمام في المنزل هو الأفضل
Dialogue: 10,0:03:00.94,0:03:03.48,Main,,0,0,0,,!يا له من يوم رائع
Dialogue: 10,0:03:04.36,0:03:07.23,Main,,0,0,0,,!خطر ببالي أمرٌ فجأةً
Dialogue: 10,0:03:07.23,0:03:08.44,Main,,0,0,0,,ما هو؟
Dialogue: 10,0:03:08.44,0:03:13.36,Main,,0,0,0,,حين كنّا صغارًا، شعرتُ أنّكِ بجانبي دائمًا
Dialogue: 10,0:03:13.36,0:03:14.40,Main,,0,0,0,,أجل
Dialogue: 10,0:03:14.69,0:03:18.32,Top,,0,0,0,,يا لظرافتكِ، ألا تدركين ذلك حتّى؟
Dialogue: 10,0:03:14.69,0:03:16.86,Main,,0,0,0,,أظن أنّه يمكنكِ قول ذلك
Dialogue: 10,0:03:17.40,0:03:19.82,Main,,0,0,0,,...هل كان ذلك
Dialogue: 10,0:03:20.07,0:03:22.44,Main,,0,0,0,,لأنّكِ كنتِ تحمينني من هوماري؟
Dialogue: 10,0:03:23.61,0:03:24.61,Main,,0,0,0,,ليس فعلًا
Dialogue: 10,0:03:24.61,0:03:27.77,Main,,0,0,0,,كنتِ صعبة المراس في صغركِ، هذا كلّ ما في الأمر
Dialogue: 10,0:03:30.57,0:03:32.23,Main,,0,0,0,,...شكرًا لكِ
Dialogue: 10,0:03:35.11,0:03:36.19,Main,,0,0,0,,...يا
Dialogue: 10,0:03:36.69,0:03:38.32,Main,,0,0,0,,أونيه-تشان
Dialogue: 10,0:03:44.11,0:03:46.61,Main,,0,0,0,,تبدين في مزاج جيد للغاية يا ياتشيهو
Dialogue: 10,0:03:46.61,0:03:47.82,Main,,0,0,0,,!مايا؟
Dialogue: 10,0:03:47.92,0:03:51.44,Main,,0,0,0,,تعالي لفرك ظهر أختكِ الكبرى كما في الأيام الخوالي
Dialogue: 10,0:03:51.44,0:03:52.61,Main,,0,0,0,,عذرًا؟
Dialogue: 10,0:03:56.40,0:03:58.07,Main,,0,0,0,,الكيان الأسمى
Dialogue: 10,0:03:58.07,0:04:01.65,Main,,0,0,0,,قدرة تتحكم بزوج من الأيدي الضخمة والمتينة بشكل فردي
Dialogue: 10,0:04:01.98,0:04:04.27,Main,,0,0,0,,ويمكن إخفاء هيئة اليدين أيضًا
Dialogue: 10,0:04:04.27,0:04:06.11,Main,,0,0,0,,لن أسمح لكِ بالرفض
Dialogue: 10,0:04:07.77,0:04:11.32,Main,,0,0,0,,!لِمَ تستخدمين قدرتكِ في الحمام؟
Dialogue: 10,0:04:13.98,0:04:17.27,Main,,0,0,0,,لم أخسر أمام هيماري بعد
Dialogue: 10,0:04:17.69,0:04:20.48,Main,,0,0,0,,،سأتسلل إلى غرفة يوكي لإغوائه
Dialogue: 10,0:04:20.48,0:04:22.27,Main,,0,0,0,,...وأجعله أسيرًا لي
Dialogue: 10,0:04:22.94,0:04:24.90,Main,,0,0,0,,!ثمَّ أسرقه
Dialogue: 10,0:04:26.98,0:04:30.11,Main,,0,0,0,,هذا محرج نوعًا ما في الواقع
Dialogue: 10,0:04:31.94,0:04:33.48,Main,,0,0,0,,!لننهِ الأمر
Dialogue: 10,0:04:33.73,0:04:35.77,Main,,0,0,0,,!غير موجود
Dialogue: 10,0:04:36.07,0:04:38.02,Main,,0,0,0,,تأخرتِ قليلًا
Dialogue: 10,0:04:38.94,0:04:43.07,Main,,0,0,0,,ذهبت هيماري والآخرون مع فوبوكي إلى الحيّز المكاني
Dialogue: 10,0:04:43.19,0:04:45.86,Main,,0,0,0,,يبدو أنّهم ذهبوا لمراجعة أحداث المأدبة
Dialogue: 10,0:04:46.44,0:04:48.07,Main,,0,0,0,,إنّهم مجدّون
Dialogue: 10,0:04:48.82,0:04:50.07,Main,,0,0,0,,!توبيرا-ساما
Dialogue: 10,0:04:50.40,0:04:54.36,Main,,0,0,0,,جئتُ للعبث مع واكورا يوكي أيضًا
Dialogue: 10,0:04:54.36,0:04:56.15,Main,,0,0,0,,!يا للخيبة
Dialogue: 10,0:04:56.15,0:04:57.90,Main,,0,0,0,,...ولكن
Dialogue: 10,0:04:58.15,0:05:00.98,Main,,0,0,0,,جسدكِ جسد طفلةٍ بالكامل
Dialogue: 10,0:05:02.40,0:05:05.23,Top,,0,0,0,,قدرة توبيرا؛ الزائل
Dialogue: 10,0:05:05.23,0:05:08.32,Top,,0,0,0,,تتيح لها امتصاص طاقة حياة الآخرين
Dialogue: 10,0:05:09.07,0:05:14.11,Main,,0,0,0,,استعادت توبيرا شبابها بامتصاص قوّة الحياة من الزهور
Dialogue: 10,0:05:14.32,0:05:21.69,Main,,0,0,0,,كما يمكنها تعزيز النمو أو العلاج عبر منح فائض قوّة الحياة للآخرين
Dialogue: 10,0:05:21.69,0:05:24.23,Main,,0,0,0,,يا لها من قدرة مرعبة
Dialogue: 10,0:05:24.23,0:05:27.44,Main,,0,0,0,,فكرتِ في أمر وقح للتو، أليس كذلك؟
Dialogue: 10,0:05:27.44,0:05:28.90,Main,,0,0,0,,!كلّا، مستحيل
Dialogue: 10,0:05:29.07,0:05:31.90,Main,,0,0,0,,...ومع ذلك، فوبوكي تلك
Dialogue: 10,0:05:31.90,0:05:34.07,Main,,0,0,0,,سبقتني إليه
Dialogue: 10,0:05:38.44,0:05:39.77,Main,,0,0,0,,هذا كلّ شيء
Dialogue: 10,0:05:39.77,0:05:43.36,Main,,0,0,0,,هذه نقاط الضعف الّتي لاحظتُها أثناء المأدبة
Dialogue: 10,0:05:43.51,0:05:46.48,Main,,0,0,0,,لا سيما ضعفُ حذركِ تجاه ما يقع خارج مجال رؤيتكِ
Dialogue: 10,0:05:46.48,0:05:48.11,Main,,0,0,0,,سأضع ذلك في الحسبان
Dialogue: 10,0:05:48.44,0:05:50.86,Main,,0,0,0,,شكرًا لكِ على الدرس القيم
Dialogue: 10,0:05:51.15,0:05:52.15,Main,,0,0,0,,على الرحب والسعة
Dialogue: 10,0:05:52.36,0:05:55.19,Main,,0,0,0,,لنراجع ذلك مجدّدًا فور عودتنا
Dialogue: 10,0:05:55.19,0:05:56.40,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:05:56.86,0:05:57.94,Main,,0,0,0,,لنتابع
Dialogue: 10,0:05:58.52,0:06:00.32,Main,,0,0,0,,جربي "التحول السماوي" هذه المرّة
Dialogue: 10,0:06:03.11,0:06:05.86,Main,,0,0,0,,!مُحال، تفعّلت الإعارة
Dialogue: 10,0:06:05.88,0:06:06.71,Main,,0,0,0,,!ويحي
Dialogue: 10,0:06:07.86,0:06:09.86,Main,,0,0,0,,...بما أنَّ الأمرَ آلَ إلى هذا
Dialogue: 10,0:06:09.86,0:06:11.69,Main,,0,0,0,,سأجرّب ركوبه
Dialogue: 10,0:06:12.65,0:06:14.19,Main,,0,0,0,,مهلًا لحظة
Dialogue: 10,0:06:14.19,0:06:17.40,Main,,0,0,0,,كنتُ أستخدم يوكي قبل قليل
Dialogue: 10,0:06:17.40,0:06:21.19,Main,,0,0,0,,...ثمَّ حدثت الإعارة، لذا مكافأته
Dialogue: 10,0:06:21.69,0:06:22.90,Main,,0,0,0,,!أُمّاه
Dialogue: 10,0:06:22.90,0:06:25.69,Main,,0,0,0,,!هل سيتعين عليّ أنا وفوبوكي مكافأته في الوقت ذاته؟
Dialogue: 10,0:06:34.90,0:06:36.86,Main,,0,0,0,,جسدي ثقيل
Dialogue: 10,0:06:37.23,0:06:39.02,Main,,0,0,0,,هذا شعور الإعارة إذن
Dialogue: 10,0:06:39.02,0:06:41.23,Main,,0,0,0,,لم أتوقّع حدوثها دون قصد
Dialogue: 10,0:06:41.36,0:06:43.52,Main,,0,0,0,,حسنٌ إذن، أرني ما لديك
Dialogue: 10,0:06:43.52,0:06:44.77,Main,,0,0,0,,!عُلم
Dialogue: 10,0:06:44.77,0:06:47.36,Main,,0,0,0,,هيماري، هلّا خضنا نزالًا خفيفًا؟
Dialogue: 10,0:06:48.94,0:06:50.23,Main,,0,0,0,,!بالتأكيد
Dialogue: 10,0:06:52.48,0:06:53.40,Main,,0,0,0,,!ها أنا ذا
Dialogue: 10,0:06:56.40,0:06:59.19,Main,,0,0,0,,...لستُ بالقوّة أو السرعة ذاتها
Dialogue: 10,0:06:59.52,0:07:00.44,Main,,0,0,0,,...لكن
Dialogue: 10,0:07:07.11,0:07:08.32,Main,,0,0,0,,!ارتددت؟
Dialogue: 10,0:07:11.02,0:07:12.65,Main,,0,0,0,,كأنّك مصنوع من المطاط
Dialogue: 10,0:07:15.86,0:07:18.36,Main,,0,0,0,,أيمكنك القفز في الهواء وتحطيم تلك الصخرة؟
Dialogue: 10,0:07:18.36,0:07:19.65,Main,,0,0,0,,حسنٌ
Dialogue: 10,0:07:23.19,0:07:24.40,Main,,0,0,0,,!عالٍ جدًّا
Dialogue: 10,0:07:30.86,0:07:33.65,Main,,0,0,0,,اجمع القوّة في ذراعكَ في النهاية
Dialogue: 10,0:07:37.94,0:07:39.65,Main,,0,0,0,,!يا لها من قوّة هائلة
Dialogue: 10,0:07:39.94,0:07:43.44,Main,,0,0,0,,يبدو أنَّ الاستفادة من مرونة جسدك لها تطبيقات عدّة
Dialogue: 10,0:07:44.52,0:07:46.98,Main,,0,0,0,,!أ-أنا مُرهق
Dialogue: 10,0:07:47.27,0:07:50.27,Main,,0,0,0,,أشتهي تناول شيء حلو بشدّة الآن
Dialogue: 10,0:07:52.02,0:07:53.52,Main,,0,0,0,,...إذن
Dialogue: 10,0:07:54.15,0:07:56.11,Main,,0,0,0,,!سنفعل هذا
Dialogue: 10,0:07:56.32,0:07:59.90,Main,,0,0,0,,تساءلت لِمَ قادني جسدي إلى المطبخ مباشرة
Dialogue: 10,0:07:59.90,0:08:03.57,Main,,0,0,0,,هذه مكافأتك إذن، يبدو أنّكَ مُرهق حقًّا
Dialogue: 10,0:08:14.98,0:08:17.52,Main,,0,0,0,,!كن ممتنًا لأنّني أطعمك
Dialogue: 10,0:08:30.40,0:08:31.73,Main,,0,0,0,,تعال هنا
Dialogue: 10,0:08:34.69,0:08:36.40,Main,,0,0,0,,...إنّها مكافأتك
Dialogue: 10,0:08:36.65,0:08:38.90,Main,,0,0,0,,لا داعي للتردد
Dialogue: 10,0:08:39.40,0:08:43.15,Main,,0,0,0,,!علي تقبّلها وإلّا لن تنتهي المكافأة
Dialogue: 10,0:08:46.52,0:08:50.69,Main,,0,0,0,,سيصبح تدريبك أكثر قسوةً من الآن فصاعدًا
Dialogue: 10,0:08:51.57,0:08:53.86,Main,,0,0,0,,تعالَ إلى منزل أزوما بين الحين والآخر
Dialogue: 10,0:08:54.52,0:08:56.65,Main,,0,0,0,,سأزيل عنكَ التعب
Dialogue: 10,0:08:58.44,0:09:01.11,Main,,0,0,0,,!كفى، ألا تزال مستمرة؟
Dialogue: 10,0:09:02.57,0:09:04.23,Main,,0,0,0,,!هذه هي الروح يا هيماري
Dialogue: 10,0:09:08.48,0:09:10.82,Main,,0,0,0,,!يا لكِ من فاحشة
Dialogue: 10,0:09:10.82,0:09:11.98,Main,,0,0,0,,والآن يا هيماري
Dialogue: 10,0:09:11.98,0:09:14.77,Main,,0,0,0,,تحلّي بقلبٍ رحيم
Dialogue: 10,0:09:18.90,0:09:20.19,Main,,0,0,0,,،كاواباتا-سان
Dialogue: 10,0:09:20.19,0:09:23.77,Main,,0,0,0,,لديكِ مقابلة صحفية وجلسة تصوير غدًا
Dialogue: 10,0:09:23.77,0:09:25.52,Main,,0,0,0,,سأرسل لكِ التفاصيل مجدّدًا
Dialogue: 10,0:09:25.52,0:09:27.44,Main,,0,0,0,,حسنٌ، شكرًا جزيلًا
Dialogue: 10,0:09:32.40,0:09:34.82,Main,,0,0,0,,أتساءل عمّا سيسألونني في المقابلة
Dialogue: 10,0:09:35.90,0:09:38.82,Main,,0,0,0,,!حسنٌ، أنا جميلةٌ نوعًا ما
Dialogue: 10,0:10:00.36,0:10:03.36,Main,,0,0,0,,!اجتزتِ الجولة الأولى من تجارب أداء الفرائس
Dialogue: 10,0:10:04.90,0:10:05.86,Main,,0,0,0,,!ويحي
Dialogue: 10,0:10:11.86,0:10:15.61,Main,,0,0,0,,!ستقول شيكوكو-نيه إنَّ إثارة الجلبة أمرٌ ممنوع
Dialogue: 10,0:10:29.77,0:10:31.86,Main,,0,0,0,,!حلّ موسم الصيف
Dialogue: 10,0:10:33.77,0:10:35.15,Main,,0,0,0,,حلّ؟
Dialogue: 10,0:10:35.15,0:10:36.82,Main,,0,0,0,,بل شارف على الانتهاء
Dialogue: 10,0:10:36.82,0:10:37.98,Main,,0,0,0,,!كلّا، كلّا
Dialogue: 10,0:10:38.19,0:10:40.77,Main,,0,0,0,,!صيفي يبدأ الآن
Dialogue: 10,0:10:40.77,0:10:42.40,Main,,0,0,0,,إنّها عطلةٌ طال انتظارها
Dialogue: 10,0:10:42.40,0:10:44.61,Main,,0,0,0,,لنسترخِ ونستمتع بيوم في العالم الحقيقي
Dialogue: 10,0:10:44.61,0:10:47.32,Main,,0,0,0,,مؤسف أنَّ هيماري لم تتمكن من الانضمام إلينا
Dialogue: 10,0:10:47.32,0:10:49.86,Main,,0,0,0,,لا يمكننا ترك المقرّ فارغًا
Dialogue: 10,0:10:50.11,0:10:51.15,Main,,0,0,0,,...وأنتِ
Dialogue: 10,0:10:51.15,0:10:53.90,Main,,0,0,0,,ألم تنسي في أيّ فرقة أنتِ؟
Dialogue: 10,0:10:53.90,0:10:56.48,Main,,0,0,0,,مررتُ في وقت استراحتي فحسب
Dialogue: 10,0:10:57.27,0:10:59.23,Main,,0,0,0,,!أنا مستعدة
Dialogue: 10,0:11:00.32,0:11:01.36,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:11:01.57,0:11:02.86,Main,,0,0,0,,!لنذهب للسباحة يا ناي
Dialogue: 10,0:11:02.86,0:11:03.69,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:11:13.23,0:11:15.52,Main,,0,0,0,,!قوامهنَّ مثاليّ
Dialogue: 10,0:11:16.48,0:11:18.48,Main,,0,0,0,,...رأيت القائدة إيزو تلك المرّة
Dialogue: 10,0:11:18.48,0:11:19.90,Main,,0,0,0,,كانت فاتنةً بحقّ
Dialogue: 10,0:11:22.57,0:11:24.82,Main,,0,0,0,,!لننضم إليهنَّ يا يوكي
Dialogue: 10,0:11:25.07,0:11:26.32,Main,,0,0,0,,!أ-أجل
Dialogue: 10,0:11:26.77,0:11:28.77,Main,,0,0,0,,،سأسدّ فجوة القوّة بيني وبين القائدة
Dialogue: 10,0:11:28.77,0:11:31.11,Main,,0,0,0,,!بالتعويض عن ذلك بالمهارة والمبادرة
Dialogue: 10,0:11:31.11,0:11:32.44,Main,,0,0,0,,لن أتراجع بعد الآن
Dialogue: 10,0:12:07.94,0:12:10.94,Main,,0,0,0,,حسنٌ، حان وقت عودتي للعمل
Dialogue: 10,0:12:10.94,0:12:13.32,Main,,0,0,0,,!حسنٌ، بالتوفيق
Dialogue: 10,0:12:18.69,0:12:20.32,Main,,0,0,0,,!كان ذلك ممتعًا
Dialogue: 10,0:12:22.23,0:12:26.77,Main,,0,0,0,,أتمنى أن يُشفى جسد أختي بسرعة لنلعب هكذا
Dialogue: 10,0:12:27.19,0:12:28.57,Main,,0,0,0,,احزر من أنا؟
Dialogue: 10,0:12:28.73,0:12:29.90,Main,,0,0,0,,شوشو-تشان؟
Dialogue: 10,0:12:32.82,0:12:35.57,Main,,0,0,0,,!يبدو أنّك عرفتني فورًا
Dialogue: 10,0:12:35.57,0:12:36.90,Main,,0,0,0,,ما الأمر؟
Dialogue: 10,0:12:37.44,0:12:39.77,Main,,0,0,0,,!سأكشف عن تقنيتي الجديدة هنا
Dialogue: 10,0:12:40.15,0:12:42.40,Main,,0,0,0,,!تحول إمبراطوري جزئي
Dialogue: 10,0:12:42.94,0:12:44.86,Main,,0,0,0,,!تكبير الثديين فحسب
Dialogue: 10,0:12:48.57,0:12:51.02,Main,,0,0,0,,...انتظرتُ دوري للاستحمام
Dialogue: 10,0:12:51.65,0:12:53.77,Main,,0,0,0,,!لكنّك استغرقت وقتًا طويلًا
Dialogue: 10,0:12:54.90,0:12:56.44,Main,,0,0,0,,!آ-آسف لجعلك تنتظرين
Dialogue: 10,0:12:56.82,0:12:57.73,Main,,0,0,0,,!تفضلي
Dialogue: 10,0:12:57.73,0:12:59.82,Main,,0,0,0,,!هذا يفلح، جعلته العطلة أكثر انفتاحًا
Dialogue: 10,0:12:59.82,0:13:01.27,Main,,0,0,0,,!سحر الصيف مذهل
Dialogue: 10,0:13:01.52,0:13:05.07,Main,,0,0,0,,!أعددتُ خططًا رومانسيةً شتّى لهذا اليوم
Dialogue: 10,0:13:05.07,0:13:07.27,Main,,0,0,0,,!لن أدعك تفلت منّي
Dialogue: 10,0:13:13.11,0:13:14.69,Main,,0,0,0,,يا له من منظرٌ جميل
Dialogue: 10,0:13:14.94,0:13:16.15,Main,,0,0,0,,شوشو-تشان
Dialogue: 10,0:13:16.52,0:13:20.32,Main,,0,0,0,,المناظر في ماتو متشابهة، لذا هذا المنظر يؤثر بي أكثر
Dialogue: 10,0:13:21.40,0:13:22.52,Main,,0,0,0,,!أجل
Dialogue: 10,0:13:24.52,0:13:28.36,Main,,0,0,0,,...أتعلم، مشاهدتنا للغروب معًا هكذا
Dialogue: 10,0:13:30.69,0:13:32.77,Main,,0,0,0,,تجعلنا نبدو كثنائي
Dialogue: 10,0:13:34.19,0:13:37.77,Main,,0,0,0,,ازدادت قصص المانغا الرومانسيّة في غرفتكِ يا شوشو-تشان
Dialogue: 10,0:13:37.77,0:13:38.77,Main,,0,0,0,,هل تأثرتِ بها؟
Dialogue: 10,0:13:39.27,0:13:40.61,Main,,0,0,0,,لاحظت ذلك؟
Dialogue: 10,0:13:40.61,0:13:44.02,Main,,0,0,0,,ذكرتِ سابقًا أنّكِ لا تهتمين بالمانغا الرومانسيّة
Dialogue: 10,0:13:44.02,0:13:44.86,Main,,0,0,0,,...حسنٌ
Dialogue: 10,0:13:44.86,0:13:47.44,Main,,0,0,0,,!أنا في سنّ المراهقة، إن صحّ التعبير
Dialogue: 10,0:13:48.07,0:13:49.15,Main,,0,0,0,,أفهمكِ
Dialogue: 10,0:13:49.77,0:13:50.90,Main,,0,0,0,,تفهم؟
Dialogue: 10,0:13:52.23,0:13:55.77,Main,,0,0,0,,ازددتِ ظرافةً مؤخرًا يا شوشو-تشان
Dialogue: 10,0:14:04.82,0:14:06.48,Main,,0,0,0,,حان الوقت
Dialogue: 10,0:14:06.48,0:14:08.15,Main,,0,0,0,,سأذهب للتدريب
Dialogue: 10,0:14:16.11,0:14:18.61,Main,,0,0,0,,!ضاعت كلّ خططي هباءً
Dialogue: 10,0:14:19.94,0:14:22.52,Main,,0,0,0,,!أشعر أنَّ هذا حدث من قبل
Dialogue: 10,0:14:22.52,0:14:25.15,Main,,0,0,0,,!يوكي، يا لك من فتى مخيف
Dialogue: 10,0:14:25.61,0:14:27.32,Main,,0,0,0,,!عليّ أن أصبح أقوى
Dialogue: 10,0:14:27.32,0:14:29.98,Main,,0,0,0,,!في القدرات وفي الحبّ
Dialogue: 10,0:14:32.19,0:14:34.69,Main,,0,0,0,,حسنٌ، لنبدأ التدريب
Dialogue: 10,0:14:34.69,0:14:37.07,Main,,0,0,0,,!"كيوكا-سان، لنتدرب على "التحول السماوي
Dialogue: 10,0:14:37.07,0:14:39.11,Main,,0,0,0,,التحول السماوي؟
Dialogue: 10,0:14:39.40,0:14:42.98,Main,,0,0,0,,تلك الهيئة أقل كفاءة وتنهك جسدك كثيرًا
Dialogue: 10,0:14:42.98,0:14:45.19,Main,,0,0,0,,اعتبرها ورقة رابحة أخيرة
Dialogue: 10,0:14:45.19,0:14:47.11,Main,,0,0,0,,هذه الهيئة هي الأساس
Dialogue: 10,0:14:47.11,0:14:47.94,Main,,0,0,0,,...لكن
Dialogue: 10,0:14:47.94,0:14:49.27,Main,,0,0,0,,...حسب رأيي
Dialogue: 10,0:14:49.27,0:14:53.52,Main,,0,0,0,,لم يخسر "التحول السماوي" أمام فوبوكي-سان بسبب نقص خبرتك
Dialogue: 10,0:14:53.82,0:14:57.44,Main,,0,0,0,,بل لأنّ قوته مفرطة ولم تتمكن من السيطرة عليه وحدك
Dialogue: 10,0:14:58.98,0:15:00.02,Main,,0,0,0,,فهمت
Dialogue: 10,0:15:00.02,0:15:03.73,Main,,0,0,0,,،لهذا ستتمكن من التحرك بسهولة مع المزيد من التدريب
Dialogue: 10,0:15:03.73,0:15:05.23,Main,,0,0,0,,حتّى في هيئة التحول السماوي
Dialogue: 10,0:15:05.44,0:15:06.44,Main,,0,0,0,,!عُلم
Dialogue: 10,0:15:07.19,0:15:11.19,Main,,0,0,0,,حاليًا، أريد التدرب على أنواع مختلفة من الهجمات بعيدة المدى
Dialogue: 10,0:15:11.19,0:15:12.40,Main,,0,0,0,,بعيدة المدى؟
Dialogue: 10,0:15:12.69,0:15:15.19,Main,,0,0,0,,كان لأحد آلهة الرعد الثمانية أجنحة
Dialogue: 10,0:15:15.19,0:15:17.57,Main,,0,0,0,,علينا توقع قدرة العدو على الطيران
Dialogue: 10,0:15:17.57,0:15:18.65,Main,,0,0,0,,فهمت
Dialogue: 10,0:15:18.90,0:15:20.98,Main,,0,0,0,,كلّ ما يسعني فعله الآن هو رمي الصخور عليهم
Dialogue: 10,0:15:20.98,0:15:23.19,Main,,0,0,0,,لديّ فكرة، لنجرّبها
Dialogue: 10,0:15:23.48,0:15:24.90,Main,,0,0,0,,!لنبدأ بالإحماء أولًا
Dialogue: 10,0:15:24.90,0:15:25.77,Main,,0,0,0,,!حاضر
Dialogue: 10,0:15:31.07,0:15:34.40,Main,,0,0,0,,هل كنتَ سريعًا هكذا في هيئتك العاديّة دائمًا؟
Dialogue: 10,0:15:34.69,0:15:36.32,Main,,0,0,0,,!هذه ثمار التدريب
Dialogue: 10,0:15:36.32,0:15:38.36,Main,,0,0,0,,أشعر أنَّ الأمر أكثر من ذلك
Dialogue: 10,0:15:39.90,0:15:43.48,Main,,0,0,0,,،كنت أتحول إلى هيئة "الزوبعة" كثيرًا مؤخرًا
Dialogue: 10,0:15:43.48,0:15:46.15,Main,,0,0,0,,لذا أشعر بخفةٍ في جسدي لسبب ما
Dialogue: 10,0:15:47.57,0:15:48.73,Main,,0,0,0,,...أيعقل
Dialogue: 10,0:15:48.73,0:15:49.98,Main,,0,0,0,,الزوبعة
Dialogue: 10,0:15:50.23,0:15:51.23,Main,,0,0,0,,النجم القاطع
Dialogue: 10,0:15:51.48,0:15:52.61,Main,,0,0,0,,صاهرُ الصخر
Dialogue: 10,0:15:52.62,0:15:53.82,Main,,0,0,0,,أجنحة العنقاء
Dialogue: 10,0:15:53.98,0:15:55.07,Main,,0,0,0,,الناب القاتل
Dialogue: 10,0:15:55.34,0:15:56.57,Main,,0,0,0,,القذيفة البشرية
Dialogue: 10,0:15:57.57,0:16:03.57,Main,,0,0,0,,!كلّما أعرته للأخريات، ازدادت قوّة هيئة العبد الأساسيّة؟
Dialogue: 10,0:16:04.40,0:16:08.02,Main,,0,0,0,,تزداد قوّة هيئة العبد الأساسيّة حين تعيرينني؟
Dialogue: 10,0:16:08.03,0:16:09.11,Main,,0,0,0,,بالضبط
Dialogue: 10,0:16:10.44,0:16:15.07,Main,,0,0,0,,عضلاتكَ تتعلم مزايا كلّ هيئة تتخذها مع الأخريات أثناء الإعارة
Dialogue: 10,0:16:15.27,0:16:18.61,Main,,0,0,0,,ممّا يجعلها وسيلة أكثر قيمة
Dialogue: 10,0:16:21.32,0:16:24.11,Main,,0,0,0,,...ومع ذلك، إن كنت تعارض الأمر
Dialogue: 10,0:16:24.11,0:16:25.19,Main,,0,0,0,,...في هذه الحالة
Dialogue: 10,0:16:26.15,0:16:29.86,Main,,0,0,0,,!قد يكون من الجيد إعارتي للأخريات أكثر
Dialogue: 10,0:16:40.07,0:16:41.77,Main,,0,0,0,,!على الأرجح
Dialogue: 10,0:16:47.73,0:16:48.65,Main,,0,0,0,,...كيوكا-سان
Dialogue: 10,0:16:50.94,0:16:53.07,Main,,0,0,0,,قاطعتها دون قصد
Dialogue: 10,0:16:53.07,0:16:55.94,Main,,0,0,0,,ماذا كانت كيوكا-سان ستقول يا ترى؟
Dialogue: 10,0:17:04.44,0:17:05.57,Main,,0,0,0,,...بالتفكير في الأمر
Dialogue: 10,0:17:06.15,0:17:08.44,Main,,0,0,0,,حدث الأمر ذاته حين قتلت وحيد القرن
Dialogue: 10,0:17:08.44,0:17:10.40,Main,,0,0,0,,،في اللحظات الحاسمة
Dialogue: 10,0:17:10.40,0:17:13.69,Main,,0,0,0,,تستخدم كيوكا-سان سيفها لمهاجمة العدو بنفسها
Dialogue: 10,0:17:14.02,0:17:18.11,Main,,0,0,0,,أنتَ تخدم سيّدتك كيوكا-سان بإخلاص، أليس كذلك؟
Dialogue: 10,0:17:19.44,0:17:22.98,Main,,0,0,0,,!أريد أن أكون مثلك
Dialogue: 10,0:17:28.48,0:17:31.23,Main,,0,0,0,,...حتّى وإن عنّى ذلك العمل مع الأخريات
Dialogue: 10,0:17:31.57,0:17:32.77,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:17:35.07,0:17:36.23,Main,,0,0,0,,...والآن
Dialogue: 10,0:17:36.23,0:17:40.57,Main,,0,0,0,,سنتناوب على ركوب واكورا يوكي اليوم
Dialogue: 10,0:17:41.82,0:17:44.27,Main,,0,0,0,,استلقِ هناك يا واكورا يوكي
Dialogue: 10,0:17:44.27,0:17:45.40,Main,,0,0,0,,!حاضر
Dialogue: 10,0:17:45.77,0:17:47.65,Main,,0,0,0,,!المعذرة
Dialogue: 10,0:17:49.27,0:17:51.11,Main,,0,0,0,,شُدّ عضلات بطنك
Dialogue: 10,0:17:52.94,0:17:55.65,Main,,0,0,0,,هـ-هكذا؟
Dialogue: 10,0:17:55.90,0:17:57.23,Main,,0,0,0,,!مرحى
Dialogue: 10,0:17:58.48,0:18:01.15,Main,,0,0,0,,لا يؤلمك جلوسي هكذا، صحيح؟
Dialogue: 10,0:18:04.61,0:18:06.40,Main,,0,0,0,,استرخِ فحسب
Dialogue: 10,0:18:07.77,0:18:10.22,Main,,0,0,0,,هذا تأديبٌ يا واكورا يوكي
Dialogue: 10,0:18:11.02,0:18:12.65,Top,,0,0,0,,!هيّا، لا تكن كسولًا
Dialogue: 10,0:18:32.73,0:18:34.94,Main,,0,0,0,,...يا له من حلم فظيع
Dialogue: 10,0:18:42.15,0:18:43.32,Main,,0,0,0,,لِمَ؟
Dialogue: 10,0:18:44.61,0:18:47.98,Main,,0,0,0,,لِمَ أشعر بضيقٍ في صدري؟
Dialogue: 10,0:18:53.77,0:18:54.77,Main,,0,0,0,,يوكي؟
Dialogue: 10,0:18:55.07,0:18:56.23,Main,,0,0,0,,!كيوكا-سان
Dialogue: 10,0:18:56.23,0:18:57.65,Main,,0,0,0,,!جئتِ في الوقت المناسب
Dialogue: 10,0:18:57.83,0:18:58.90,Main,,0,0,0,,لماذا؟
Dialogue: 10,0:18:59.19,0:19:01.32,Main,,0,0,0,,...بخصوص الإعارة
Dialogue: 10,0:19:03.82,0:19:04.86,Main,,0,0,0,,...أنا
Dialogue: 10,0:19:05.77,0:19:07.32,Main,,0,0,0,,!أكره الفكرة حقًّا
Dialogue: 10,0:19:09.23,0:19:12.57,Main,,0,0,0,,باستثناء حالات الطوارئ، أريد أن يكون الأساس
Dialogue: 10,0:19:12.57,0:19:14.98,Main,,0,0,0,,!هو العمل معكِ كما اعتدنا يا كيوكا-سان
Dialogue: 10,0:19:14.98,0:19:16.48,Main,,0,0,0,,...سابقًا
Dialogue: 10,0:19:16.48,0:19:19.69,Main,,0,0,0,,ظننتُ أنّه لا خيار أمامي إن أردتُ أن أصبح أقوى
Dialogue: 10,0:19:20.02,0:19:21.40,Main,,0,0,0,,...لكنَّ الأمر يزعجني
Dialogue: 10,0:19:21.90,0:19:26.02,Main,,0,0,0,,!أفضّلكِ يا كيوكا-سان في الأوقات العاديّة وفي المعارك الحاسمة
Dialogue: 10,0:19:30.05,0:19:33.82,Main,,0,0,0,,!فأنتِ السبب في شكل حياتي الحالية
Dialogue: 10,0:19:38.19,0:19:42.11,Main,,0,0,0,,!كما أنَّ التغييرات بعد الإعارة طفيفةٌ على أيّ حال
Dialogue: 10,0:19:42.17,0:19:44.32,Main,,0,0,0,,!لم ألاحظ ذلك حتّى قلته
Dialogue: 10,0:19:44.32,0:19:45.48,Main,,0,0,0,,...يوكي
Dialogue: 10,0:19:45.65,0:19:48.90,Main,,0,0,0,,والأهم من ذلك، أفضّل التدريب بانتظام معكِ يا كيوكا-سان
Dialogue: 10,0:19:48.90,0:19:49.94,Main,,0,0,0,,!يوكي
Dialogue: 10,0:19:51.73,0:19:53.11,Main,,0,0,0,,!أحسنتَ قولًا
Dialogue: 10,0:19:54.32,0:19:56.82,Main,,0,0,0,,!لهذا أنتَ عبدي بالضبط
Dialogue: 10,0:19:57.90,0:19:58.98,Main,,0,0,0,,!أجل
Dialogue: 10,0:19:59.94,0:20:01.86,Main,,0,0,0,,!حسنٌ، لنبدأ التدريب
Dialogue: 10,0:20:01.86,0:20:03.90,Main,,0,0,0,,!لنبتكر تقنيةً جديدةً
Dialogue: 10,0:20:09.52,0:20:12.52,Main,,0,0,0,,هذه السلاسل جزء من قدرتي
Dialogue: 10,0:20:12.90,0:20:17.44,Main,,0,0,0,,يجدر بي أن أتمكن من تمديدها بما أنّني اعتدتُ على يوكي الآن
Dialogue: 10,0:20:20.11,0:20:21.15,Main,,0,0,0,,لنفعلها
Dialogue: 10,0:20:21.15,0:20:22.07,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:20:29.40,0:20:30.44,Main,,0,0,0,,!يوكي
Dialogue: 10,0:20:30.44,0:20:31.27,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:20:38.86,0:20:40.44,Main,,0,0,0,,...هذا الضوء
Dialogue: 10,0:20:44.44,0:20:47.57,Main,,0,0,0,,يبدو أنَّ له استخدامات عدّة
Dialogue: 10,0:20:54.27,0:20:56.61,Main,,0,0,0,,أبليت بلاءً حسنًا الليلة يا يوكي
Dialogue: 10,0:20:57.11,0:20:59.44,Main,,0,0,0,,أصبحت لدينا خيارات أكثر في القتال الآن
Dialogue: 10,0:20:59.44,0:21:01.82,Main,,0,0,0,,!سأواصل العمل بجد
Dialogue: 10,0:21:20.19,0:21:21.44,Main,,0,0,0,,!أهذا بوق؟
Dialogue: 10,0:21:21.44,0:21:24.57,Main,,0,0,0,,نفخةٌ واحدةٌ تعني حالة طوارئ، أليس كذلك؟
Dialogue: 10,0:21:26.19,0:21:27.48,Main,,0,0,0,,!صارت ثلاث نفخات
Dialogue: 10,0:21:27.73,0:21:29.02,Main,,0,0,0,,...هذه الإشارة
Dialogue: 10,0:21:30.07,0:21:31.32,Main,,0,0,0,,!إنّهم آلهة الرعد الثمانية
Dialogue: 10,0:21:39.90,0:21:41.69,Main,,0,0,0,,سأضم هذه للمجموعة
Dialogue: 10,0:21:46.40,0:21:49.23,Main,,0,0,0,,!اقتربنا من العدد المطلوب
Dialogue: 10,0:21:53.52,0:21:56.19,Main,,0,0,0,,وأنا جائعةٌ للغاية
Dialogue: 10,0:23:26.73,0:23:30.19,Main,,0,0,0,,"في المرّة القادمة، الحلقة 8: "قائدة الفرقة الثانية
Dialogue: 10,0:23:30.22,0:23:32.62,Top,,0,0,0,,وإليكم مكافأة اليوم
Dialogue: 10,0:23:33.02,0:23:35.52,Top,,0,0,0,,نضجت هيمارين كثيرًا، أليس كذلك؟
Dialogue: 10,0:23:36.77,0:23:38.36,Top,,0,0,0,,!ستبذل ناي قصارى جهدها أيضًا
Dialogue: 10,0:23:39.15,0:23:40.23,Top,,0,0,0,,في ماذا؟
