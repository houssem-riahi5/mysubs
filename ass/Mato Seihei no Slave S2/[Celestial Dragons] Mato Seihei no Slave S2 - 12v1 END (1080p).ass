Dialogue: 10,0:00:02.06,0:00:03.04,Main,,0,0,0,,كيوكا
Dialogue: 10,0:00:03.38,0:00:05.42,Main,,0,0,0,,أعيريني العبد
Dialogue: 10,0:00:06.89,0:00:09.42,Main,,0,0,0,,يجدر بنا معرفة هيئة العبد الخاصّة بي
Dialogue: 10,0:00:10.17,0:00:12.92,Main,,0,0,0,,لا تضغطي على نفسكِ إن لم تستطيعي منحه مكافأةً
Dialogue: 10,0:00:16.42,0:00:17.63,Main,,0,0,0,,لا بأس
Dialogue: 10,0:00:17.83,0:00:19.67,Main,,0,0,0,,حسمتُ أمري
Dialogue: 10,0:00:19.96,0:00:22.42,Main,,0,0,0,,أريد زيادة أوراقي الرابحة
Dialogue: 10,0:00:25.17,0:00:26.46,Main,,0,0,0,,هذا صحيح
Dialogue: 10,0:00:27.54,0:00:30.88,Main,,0,0,0,,،بناءً على تصرّفاتها وهيئتها الأصليّة
Dialogue: 10,0:00:31.25,0:00:34.79,Main,,0,0,0,,لا بُدّ أنَّ كوسيتسو كانت حديثة الولادة بين آلهة الرعد الثمانية
Dialogue: 10,0:00:35.46,0:00:39.71,Main,,0,0,0,,من الآمن افتراض أنَّ الآلهة المتبقيّة أقوى منها
Dialogue: 10,0:00:40.04,0:00:41.67,Main,,0,0,0,,حيواتُ الناس على المحكّ هنا
Dialogue: 10,0:00:42.83,0:00:43.96,Main,,0,0,0,,يوكي
Dialogue: 10,0:00:44.71,0:00:47.29,Main,,0,0,0,,علينا أن نصبح أقوى قدر الإمكان
Dialogue: 10,0:00:47.29,0:00:48.46,Main,,0,0,0,,حاضر
Dialogue: 10,0:00:53.91,0:00:57.54,Main,,0,0,0,,!فأنتِ السبب في شكل حياتي الحالية
Dialogue: 10,0:00:58.33,0:01:00.42,Main,,0,0,0,,هذا ما قلته لي
Dialogue: 10,0:01:02.58,0:01:04.75,Main,,0,0,0,,لذا أنا بخير
Dialogue: 10,0:01:06.75,0:01:08.67,Main,,0,0,0,,لنُعركَ إذن
Dialogue: 10,0:01:09.83,0:01:10.75,Main,,0,0,0,,ميرا
Dialogue: 10,0:01:11.04,0:01:12.08,Main,,0,0,0,,حسنٌ
Dialogue: 10,0:01:25.46,0:01:27.92,Main,,0,0,0,,لم أتوقع أنّه قادرٌ على التحوّل لهيئةٍ كهذه
Dialogue: 10,0:01:28.21,0:01:30.96,Main,,0,0,0,,فهمت، هذا المجال يستهويني تمامًا
Dialogue: 10,0:01:33.71,0:01:35.33,Main,,0,0,0,,!سأخذه في جولةٍ تجريبيّة
Dialogue: 10,0:01:35.33,0:01:37.08,Main,,0,0,0,,!لننطلق
Dialogue: 10,0:01:52.25,0:01:53.58,Main,,0,0,0,,أجسدكَ بخير؟
Dialogue: 10,0:01:53.79,0:01:54.75,Main,,0,0,0,,!أجل
Dialogue: 10,0:01:54.75,0:01:56.50,Main,,0,0,0,,!هذه السرعة ممتعة
Dialogue: 10,0:01:57.58,0:02:00.00,Main,,0,0,0,,نسيم ماتو ليس سيّئًا أيضًا
Dialogue: 10,0:02:00.33,0:02:03.21,Main,,0,0,0,,لطالما أُعجبتُ بالدرّاجات الناريّة
Dialogue: 10,0:02:08.46,0:02:11.58,Main,,0,0,0,,أذكر أنّي أردتُ اصطحاب فتاةٍ في جولةٍ على متنها
Dialogue: 10,0:02:16.25,0:02:18.04,Main,,0,0,0,,تبدو في مزاجٍ جيّد
Dialogue: 10,0:02:18.04,0:02:19.29,Main,,0,0,0,,...والآن
Dialogue: 10,0:02:19.75,0:02:21.71,Main,,0,0,0,,!لنختبر خصائصك
Dialogue: 10,0:02:33.21,0:02:34.54,Main,,0,0,0,,!حشدٌ من الشوكي
Dialogue: 10,0:02:35.71,0:02:38.13,Main,,0,0,0,,يبدو أنَّ الشوكي يمقتون هذا الصوت
Dialogue: 10,0:02:39.25,0:02:40.38,Main,,0,0,0,,!اقضِ عليهم
Dialogue: 10,0:02:47.04,0:02:48.04,Main,,0,0,0,,!لنفعلها
Dialogue: 10,0:02:53.38,0:02:54.92,Main,,0,0,0,,!ادهسهم
Dialogue: 10,0:02:58.88,0:03:00.38,Main,,0,0,0,,!ضربةٌ قاضية
Dialogue: 10,0:03:06.88,0:03:08.17,Main,,0,0,0,,أما زلتَ صامدًا؟
Dialogue: 10,0:03:08.17,0:03:09.75,Main,,0,0,0,,!يسعني المواصلة
Dialogue: 10,0:03:10.54,0:03:11.75,Main,,0,0,0,,!جيّد
Dialogue: 10,0:03:11.89,0:03:14.25,Main,,0,0,0,,!لِنقم بدوريّةٍ في منطقة الفرقة الثانية إذن
Dialogue: 10,0:03:14.71,0:03:15.54,Main,,0,0,0,,!حاضر
Dialogue: 10,0:03:29.92,0:03:31.92,Main,,0,0,0,,صمدتَ طوال الطريق حتّى المسكن
Dialogue: 10,0:03:32.71,0:03:35.96,Main,,0,0,0,,استدراج العدوّ بالصوت مفيدٌ حقًّا
Dialogue: 10,0:03:36.13,0:03:38.42,Main,,0,0,0,,كما أنّك قويٌّ ومتينٌ أيضًا
Dialogue: 10,0:03:38.42,0:03:39.75,Main,,0,0,0,,لستَ سيّئًا إطلاقًا
Dialogue: 10,0:03:44.71,0:03:46.33,Main,,0,0,0,,اركب تلك السيّارة
Dialogue: 10,0:03:49.58,0:03:51.08,Main,,0,0,0,,...على ما يبدو
Dialogue: 10,0:03:51.08,0:03:53.67,Main,,0,0,0,,أنَّ وقت مكافأتكَ قد حان
Dialogue: 10,0:03:57.17,0:03:58.58,Main,,0,0,0,,...إذن
Dialogue: 10,0:04:01.46,0:04:04.08,Main,,0,0,0,,أيّ نوعٍ من المكافآت هذه؟
Dialogue: 10,0:04:04.08,0:04:07.04,Main,,0,0,0,,موعدٌ غراميٌّ في السيّارة... على ما يبدو
Dialogue: 10,0:04:09.10,0:04:10.71,Main,,0,0,0,,مـ-موعد؟
Dialogue: 10,0:04:15.96,0:04:18.00,Main,,0,0,0,,!لستَ سيّئًا كما ظننت
Dialogue: 10,0:04:18.38,0:04:19.33,Main,,0,0,0,,تفضّل
Dialogue: 10,0:04:20.79,0:04:23.29,Main,,0,0,0,,شـ-شكرًا لكِ
Dialogue: 10,0:04:24.29,0:04:27.79,Main,,0,0,0,,عجبًا، لِمَ أعطيته عصيري؟
Dialogue: 10,0:04:32.04,0:04:34.54,Main,,0,0,0,,!قـ-قبلةٌ غير مباشرة؟
Dialogue: 10,0:04:34.83,0:04:36.33,Main,,0,0,0,,!بدأ الأمر
Dialogue: 10,0:04:36.75,0:04:38.88,Main,,0,0,0,,د-دعني أشرب من عصيرك
Dialogue: 10,0:04:56.96,0:05:00.38,Main,,0,0,0,,!هذا صعب نوعًا ما
Dialogue: 10,0:05:05.04,0:05:06.63,Main,,0,0,0,,هذا هيّن
Dialogue: 10,0:05:15.04,0:05:18.29,Main,,0,0,0,,يبدو أنَّ الأمر سيستمرّ
Dialogue: 10,0:05:18.29,0:05:19.96,Main,,0,0,0,,هل أنتِ بخير؟
Dialogue: 10,0:05:20.21,0:05:21.79,Main,,0,0,0,,!أنا في أتمّ صحّة
Dialogue: 10,0:05:25.71,0:05:27.46,Main,,0,0,0,,أسنتمادى إلى هذا الحدّ؟
Dialogue: 10,0:05:28.88,0:05:32.33,Main,,0,0,0,,...أن أسمح لرجلٍ برؤيتي عاريةً
Dialogue: 10,0:05:35.75,0:05:39.04,Main,,0,0,0,,سأمنحكَ قبلةً حقيقيّةً هذه المرّة
Dialogue: 10,0:05:44.17,0:05:45.96,Main,,0,0,0,,...إن فعلتُ هذا
Dialogue: 10,0:05:53.58,0:05:55.88,Main,,0,0,0,,...إن تماديتُ إلى هذا الحدّ
Dialogue: 10,0:05:59.29,0:06:01.54,Main,,0,0,0,,فعليَّ تحمّل العواقب
Dialogue: 10,0:06:15.46,0:06:18.04,Main,,0,0,0,,يسعدني أنَّ ميرا-سان استعادتْ عافيتها
Dialogue: 10,0:06:19.25,0:06:22.83,Main,,0,0,0,,لكن هل أختي الكبرى والأخريات بخير يا ترى؟
Dialogue: 10,0:06:26.42,0:06:27.25,Main,,0,0,0,,...تينـ
Dialogue: 10,0:06:49.38,0:06:51.04,Main,,0,0,0,,!ها قد أتى
Dialogue: 10,0:06:52.00,0:06:53.13,Main,,0,0,0,,!أختي الكبرى
Dialogue: 10,0:06:53.13,0:06:54.63,Main,,0,0,0,,!وأنتما أيضًا
Dialogue: 10,0:07:04.96,0:07:08.13,Main,,0,0,0,,!أشعر بطاقة الأخ الصغير تُشحن بداخلي
Dialogue: 10,0:07:08.33,0:07:10.42,Main,,0,0,0,,يسعدني أنّكنَّ بخير
Dialogue: 10,0:07:10.88,0:07:14.46,Main,,0,0,0,,!الذهاب إلى يوكوهاما والعودة منها كان هيّنًا بفضل تينكا
Dialogue: 10,0:07:15.99,0:07:17.75,Main,,0,0,0,,العودة؟
Dialogue: 10,0:07:17.75,0:07:18.83,Main,,0,0,0,,أأنتِ من أوصلها إلى هناك؟
Dialogue: 10,0:07:18.83,0:07:19.83,Main,,0,0,0,,أجل
Dialogue: 10,0:07:19.83,0:07:23.67,Main,,0,0,0,,ساورني شكٌّ حين علمتُ أنَّ عدوّنا قادرٌ على التخلّل
Dialogue: 10,0:07:23.67,0:07:27.63,Main,,0,0,0,,فخمّنتُ أنّها مرتبطةٌ بأختي الكبرى وصديقاتها
Dialogue: 10,0:07:29.21,0:07:31.67,Main,,0,0,0,,!وأصابتْ كبد الحقيقة
Dialogue: 10,0:07:32.75,0:07:36.46,Main,,0,0,0,,!لطالما أحضرتْ لنا تينكا شتّى أنواع الهدايا مُنذ مدّة
Dialogue: 10,0:07:37.13,0:07:38.67,Main,,0,0,0,,!لم أكن أعلم
Dialogue: 10,0:07:39.29,0:07:42.92,Main,,0,0,0,,التحرّك بمفردي هو السبيل الأمثل لتقليل المخاطر
Dialogue: 10,0:07:43.29,0:07:48.04,Main,,0,0,0,,لكنّي علمتُ أنّكَ ستقلق على سلامتهنَّ هذه المرّة
Dialogue: 10,0:07:51.42,0:07:53.42,Main,,0,0,0,,!أحسنتِ يا تينكا
Dialogue: 10,0:07:56.83,0:07:58.42,Main,,0,0,0,,!شكرًا جزيًلا لكِ
Dialogue: 10,0:07:59.71,0:08:02.25,Main,,0,0,0,,مساعدة بعضنا البعض أمرٌ بديهيٌّ
Dialogue: 10,0:08:06.42,0:08:09.46,Main,,0,0,0,,!نحن مديناتٌ لكَ أيضًا
Dialogue: 10,0:08:09.46,0:08:11.17,Main,,0,0,0,,شكرًا لكَ
Dialogue: 10,0:08:11.17,0:08:13.17,Main,,0,0,0,,لا، لم أفعل شيئًا
Dialogue: 10,0:08:13.17,0:08:15.04,Main,,0,0,0,,بل يعود الفضل كلّه لكيوكا-سان
Dialogue: 10,0:08:15.04,0:08:17.08,Main,,0,0,0,,!لا تكن متواضعًا
Dialogue: 10,0:08:17.08,0:08:19.25,Main,,0,0,0,,سمعنا كلّ شيءٍ من أوبا
Dialogue: 10,0:08:19.25,0:08:22.42,Main,,0,0,0,,قالت إنّها كانت عمليّة إنقاذٍ بديعة
Dialogue: 10,0:08:22.42,0:08:23.92,Main,,0,0,0,,بديعة؟
Dialogue: 10,0:08:25.54,0:08:27.29,Main,,0,0,0,,!هيّا، لا تخجل
Dialogue: 10,0:08:27.29,0:08:30.08,Main,,0,0,0,,تينكا، ألديكِ دقيقة؟
Dialogue: 10,0:08:27.29,0:08:30.08,Top,,0,0,0,,كيوكا-سان هي البطلة الحقيقيّة حقًّا
Dialogue: 10,0:08:31.50,0:08:34.75,Main,,0,0,0,,أستلاحقني قوّات ردع الشياطين؟
Dialogue: 10,0:08:34.75,0:08:36.46,Main,,0,0,0,,،في الوقت الراهن
Dialogue: 10,0:08:37.17,0:08:42.13,Main,,0,0,0,,نحن منشغلون بتهديد آلهة الرعد الثمانية وطريقتهم الجديدة في نشر الشوكي
Dialogue: 10,0:08:42.71,0:08:46.21,Main,,0,0,0,,نحن غارقون في المشاكل، لذا أظنّكِ ستكونين بخير
Dialogue: 10,0:08:46.21,0:08:50.13,Main,,0,0,0,,حتّى قوّات ردع الشياطين بحاجةٍ لإجراء بعض التعديلات
Dialogue: 10,0:08:50.29,0:08:55.17,Main,,0,0,0,,كما أنّنا لم نجد أيّ أدلّةٍ لإعادتكِ أنتِ والأخريات إلى طبيعتكنَّ البشريّة
Dialogue: 10,0:08:55.71,0:08:59.46,Main,,0,0,0,,لكنّي سأواصل البحث عن معلوماتٍ حول مكتب أونميوريو
Dialogue: 10,0:08:59.46,0:09:00.63,Main,,0,0,0,,أجل
Dialogue: 10,0:09:01.17,0:09:03.54,Main,,0,0,0,,يبدو أنّ الأمر سيستغرق بعض الوقت
Dialogue: 10,0:09:03.54,0:09:06.50,Main,,0,0,0,,قد يكون من الأفضل الانتقال إلى مخبئٍ آخر من باب الاحتياط
Dialogue: 10,0:09:07.42,0:09:10.42,Main,,0,0,0,,في الوقت الحالي، عودة كوكو وناون سالمتين
Dialogue: 10,0:09:10.42,0:09:12.21,Main,,0,0,0,,!أمرٌ يفوق الوصف
Dialogue: 10,0:09:14.25,0:09:16.00,Main,,0,0,0,,هل جسديكما بخير؟
Dialogue: 10,0:09:18.52,0:09:21.33,Main,,0,0,0,,لسنا مصابات، غير أنّنا نشعر ببعض الإرهاق
Dialogue: 10,0:09:21.33,0:09:24.58,Main,,0,0,0,,لكنّه تحسّن كثيرًا الآن
Dialogue: 10,0:09:26.29,0:09:28.67,Main,,0,0,0,,لعلّي أستطيع مساعدتكما على الشعور بالتحسّن
Dialogue: 10,0:09:40.75,0:09:44.13,Main,,0,0,0,,!تدليككَ... رائعٌ حقًّا
Dialogue: 10,0:09:50.46,0:09:52.21,Main,,0,0,0,,!مـ-مذهل
Dialogue: 10,0:09:54.04,0:09:55.63,Main,,0,0,0,,...نقاطهما الحيويّة
Dialogue: 10,0:09:57.88,0:09:59.46,Main,,0,0,0,,...وتفاصيل جسديهما
Dialogue: 10,0:10:01.67,0:10:04.04,Main,,0,0,0,,أعرفها كلّها لسببٍ ما
Dialogue: 10,0:10:05.25,0:10:08.04,Main,,0,0,0,,...أهذا لأنّ كوسيتسو بداخلي
Dialogue: 10,0:10:08.04,0:10:10.21,Main,,0,0,0,,وقد اندمجتْ معهنّ سابقًا؟
Dialogue: 10,0:10:15.33,0:10:17.33,Main,,0,0,0,,!أشعر وكأنّي وُلدتُ من جديد
Dialogue: 10,0:10:17.79,0:10:19.00,Main,,0,0,0,,!يسعدني سماع ذلك
Dialogue: 10,0:10:20.50,0:10:22.63,Main,,0,0,0,,...العبرة بالخواتيم
Dialogue: 10,0:10:22.63,0:10:25.54,Main,,0,0,0,,لكنّي واجهتُ تحدّياتٍ جمّةً خلال معركة يوكوهاما
Dialogue: 10,0:10:26.33,0:10:28.00,Main,,0,0,0,,!يجدر بي بذل قصارى جهدي
Dialogue: 10,0:10:30.75,0:10:34.13,Main,,0,0,0,,!أراكَ في اجتماع القائدات القادم يا يوكي-كن
Dialogue: 10,0:10:34.13,0:10:35.08,Main,,0,0,0,,حسنٌ
Dialogue: 10,0:10:35.08,0:10:37.00,Main,,0,0,0,,شكرًا على كلّ شيءٍ يا تينكا-سان
Dialogue: 10,0:10:37.25,0:10:38.25,Main,,0,0,0,,!وداعًا
Dialogue: 10,0:10:45.46,0:10:46.67,Main,,0,0,0,,...أختي الكبرى
Dialogue: 10,0:11:01.79,0:11:04.50,Main,,0,0,0,,هبط حشدٌ من الشوكي على مدينةٍ كبرى
Dialogue: 10,0:11:04.50,0:11:06.71,Main,,0,0,0,,العالم في حالة فوضى
Dialogue: 10,0:11:06.71,0:11:11.92,Main,,0,0,0,,يبدو أنّكِ مشغولةٌ بزيارة أماكن شتّى لطمأنة الناس
Dialogue: 10,0:11:11.92,0:11:13.58,Main,,0,0,0,,بُورك عملكِ
Dialogue: 10,0:11:13.75,0:11:14.75,Main,,0,0,0,,أجل
Dialogue: 10,0:11:14.75,0:11:17.50,Main,,0,0,0,,!لعلّكِ تساعدينني في الترويح عن نفسي لاحقًا
Dialogue: 10,0:11:19.17,0:11:22.83,Main,,0,0,0,,مهام القائدة العليا كثيرةٌ حقًّا
Dialogue: 10,0:11:22.83,0:11:25.21,Main,,0,0,0,,إنّه عملٌ لا يسعني تحمّله
Dialogue: 10,0:11:27.00,0:11:31.21,Main,,0,0,0,,أبليتِ بلاءً حسنًا في حماية سكّان المدينة ممّا حال دون وقوع ذعرٍ يا ميرا
Dialogue: 10,0:11:31.88,0:11:35.33,Main,,0,0,0,,وتلقّينا رسائل شكرٍ من قوّات الشرطة أيضًا
Dialogue: 10,0:11:35.88,0:11:38.46,Main,,0,0,0,,هذا واجب قوّات ردع الشياطين
Dialogue: 10,0:11:38.79,0:11:44.92,Main,,0,0,0,,لكن تبيّن أنَّ المعارك الّتي تتطلّب حماية الكثير من المدنيين تُشكّل تحدّيًا حتّى للقائدات
Dialogue: 10,0:11:45.08,0:11:48.17,Main,,0,0,0,,ليتنا نستطيع حصر القتال في ماتو
Dialogue: 10,0:11:48.17,0:11:50.92,Main,,0,0,0,,لتتمكّن ياكومو-سان من المشاركة بكامل قوّتها
Dialogue: 10,0:11:50.92,0:11:54.54,Main,,0,0,0,,!أيّتها القائدة العليا، حان وقت الهجوم
Dialogue: 10,0:11:55.00,0:11:57.29,Main,,0,0,0,,،ازداد مستوى الخطر على العالم الحقيقيّ
Dialogue: 10,0:11:57.29,0:12:00.54,Main,,0,0,0,,لذا من البديهيّ أن تغيّر قوّات ردع الشياطين استراتيجيّاتها
Dialogue: 10,0:12:01.21,0:12:03.96,Main,,0,0,0,,،ومع ذلك، نجهل الكثير من الأمور
Dialogue: 10,0:12:03.96,0:12:06.04,Main,,0,0,0,,بما في ذلك موقع معقل عدوّنا
Dialogue: 10,0:12:06.04,0:12:07.75,Main,,0,0,0,,علينا القيام ببعض الاستطلاع
Dialogue: 10,0:12:08.13,0:12:11.83,Main,,0,0,0,,قد ترغب كوسيتسو في التحدّث بما أنّها بداخلي
Dialogue: 10,0:12:12.25,0:12:15.13,Main,,0,0,0,,لكنّها لم تظهر مُنذ المرّة الأولى
Dialogue: 10,0:12:15.13,0:12:16.50,Main,,0,0,0,,...في الوقت الراهن
Dialogue: 10,0:12:16.71,0:12:19.38,Main,,0,0,0,,سأعلن حالة الطوارئ في ماتو
Dialogue: 10,0:12:19.38,0:12:21.96,Main,,0,0,0,,مـ-ما الّذي يعنيه ذلك؟
Dialogue: 10,0:12:22.17,0:12:25.17,Main,,0,0,0,,،سأكشف عن وجود آلهة الرعد الثمانية للعامّة
Dialogue: 10,0:12:25.17,0:12:28.83,Main,,0,0,0,,وستكرّس قوّات ردع الشياطين كلّ جهودها لدرء الخطر الّذي تُمثلنَه
Dialogue: 10,0:12:28.83,0:12:31.08,Main,,0,0,0,,وسننسّق عن كثبٍ مع العالم الحقيقيّ
Dialogue: 10,0:12:31.88,0:12:37.46,Main,,0,0,0,,إظهار تحرّكاتنا والإعلان عنها على نطاقٍ واسعٍ سيُطمئن العالم الحقيقيّ
Dialogue: 10,0:12:37.69,0:12:39.08,Main,,0,0,0,,هذا قصدكِ إذن
Dialogue: 10,0:12:39.79,0:12:42.13,Main,,0,0,0,,حالة طوارئ إذن
Dialogue: 10,0:12:42.88,0:12:45.04,Main,,0,0,0,,آلهة الرعد الثمانية ليسوا خصمًا يُستهان به
Dialogue: 10,0:12:45.26,0:12:49.46,Main,,0,0,0,,أريدكنّ أن تصقلنَ قدراتكنّ استعدادًا للهجوم الوشيك
Dialogue: 10,0:12:49.46,0:12:50.58,Main,,0,0,0,,!حاضر
Dialogue: 10,0:12:59.75,0:13:01.71,Main,,0,0,0,,لِمَ استترتِ في داخلي؟
Dialogue: 10,0:13:06.83,0:13:09.96,Main,,0,0,0,,!لأنّكِ ضخمةٌ ودافئةٌ يا جوريو-نيه
Dialogue: 10,0:13:11.00,0:13:13.71,Main,,0,0,0,,!أشعر بالراحة هنا
Dialogue: 10,0:13:23.50,0:13:24.75,Main,,0,0,0,,جوريو
Dialogue: 10,0:13:25.71,0:13:27.58,Main,,0,0,0,,استُدعينا
Dialogue: 10,0:13:30.42,0:13:32.54,Main,,0,0,0,,اجتماع آلهة الرعد الثمانية
Dialogue: 10,0:13:35.63,0:13:38.42,Main,,0,0,0,,شيكوكو-نيه، جوريو-نيه
Dialogue: 10,0:13:38.75,0:13:40.83,Main,,0,0,0,,أجئتِ لاستقبالنا يا جاكون؟
Dialogue: 10,0:13:41.37,0:13:44.25,Main,,0,0,0,,هذا أقلّ ما يمكنني فعله بصفتي الصغرى
Dialogue: 10,0:13:46.25,0:13:48.50,Main,,0,0,0,,البقيّة ينتظرنَ بالدّاخل
Dialogue: 10,0:13:50.25,0:13:52.13,Main,,0,0,0,,أتسير أبحاثكِ على ما يرام؟
Dialogue: 10,0:13:52.29,0:13:53.25,Main,,0,0,0,,أجل
Dialogue: 10,0:13:53.33,0:13:56.29,Main,,0,0,0,,...ما زال هناك الكثير ممّا أودّ معرفته، ولكن
Dialogue: 10,0:13:56.75,0:14:00.17,Main,,0,0,0,,...كان يُفترض بي أن أكون غارقةً في أبحاثي الآن
Dialogue: 10,0:14:00.83,0:14:03.54,Main,,0,0,0,,لولا قوّات ردع الشياطين المزعجة
Dialogue: 10,0:14:13.13,0:14:14.38,Main,,0,0,0,,تأخّرتنّ
Dialogue: 10,0:14:22.37,0:14:24.17,Main,,0,0,0,,!تصدّيتِ لهجومي المُباغت
Dialogue: 10,0:14:24.71,0:14:26.75,Main,,0,0,0,,خشيتُ أن تكوني قد فقدتِ براعتكِ
Dialogue: 10,0:14:30.46,0:14:34.17,Main,,0,0,0,,على العكس، غضبي يمدّني بالقوّة
Dialogue: 10,0:14:36.98,0:14:38.79,Main,,0,0,0,,!هذا ما يُتوقّع من إلهة رعد
Dialogue: 10,0:14:39.88,0:14:44.46,Main,,0,0,0,,أرى أنّ شيكوكو-نيه تبدو أكثر استياءً منكما
Dialogue: 10,0:14:44.88,0:14:46.54,Main,,0,0,0,,ألوم نفسي
Dialogue: 10,0:14:46.54,0:14:49.67,Main,,0,0,0,,لم يكن يجدر بي ترك كوسيتسو تذهب بمفردها
Dialogue: 10,0:14:52.21,0:14:56.17,Main,,0,0,0,,لِنُبِد البشر ثأرًا لها إذن
Dialogue: 10,0:15:08.33,0:15:09.79,Main,,0,0,0,,تايكيوكو-نيه
Dialogue: 10,0:15:10.54,0:15:13.21,Main,,0,0,0,,اركعي يا شيكوكو
Dialogue: 10,0:15:15.42,0:15:18.50,Main,,0,0,0,,...وثقتُ بقدرتكِ على تولّي القيادة نيابةً عنّي
Dialogue: 10,0:15:18.50,0:15:21.08,Main,,0,0,0,,بما أنّني لا أستطيع مفارقة أمّي
Dialogue: 10,0:15:22.13,0:15:25.38,Main,,0,0,0,,مقتل إلهةٍ خطأٌ لا يُغتفر
Dialogue: 10,0:15:26.42,0:15:29.21,Main,,0,0,0,,لا يسعني مسامحة نفسي أيضًا
Dialogue: 10,0:15:34.74,0:15:39.88,Main,,0,0,0,,تجرّعي مرارة الألم ريثما تلتئم جراحكِ
Dialogue: 10,0:15:41.88,0:15:45.21,Main,,0,0,0,,ولا تدعي أمر كوسيتسو يثبّطْ عزيمتكِ
Dialogue: 10,0:15:46.13,0:15:49.50,Main,,0,0,0,,فقد أصدرتُ حكمي عليكِ بالفعل
Dialogue: 10,0:15:52.45,0:15:55.29,Main,,0,0,0,,إيّاكنَّ وتوبيخ شيكوكو من الآن فصاعدًا
Dialogue: 10,0:15:55.29,0:15:56.33,Main,,0,0,0,,عُلم
Dialogue: 10,0:15:56.67,0:15:59.00,Main,,0,0,0,,لم نلمها في بادئ الأمر
Dialogue: 10,0:15:59.38,0:16:02.04,Main,,0,0,0,,أليستِ تايكيوكو-نيه المنفردة بتوبيخها؟
Dialogue: 10,0:16:05.59,0:16:06.67,Main,,0,0,0,,...والآن
Dialogue: 10,0:16:06.67,0:16:07.88,Main,,0,0,0,,...كان يُفترض
Dialogue: 10,0:16:07.88,0:16:10.25,Main,,0,0,0,,...أن نشنّ هجومًا شاملًا
Dialogue: 10,0:16:10.25,0:16:12.00,Main,,0,0,0,,...بعد اكتمال عددنا نحن الثمانية، ولكن
Dialogue: 10,0:16:12.42,0:16:14.17,Main,,0,0,0,,ما الخطّة يا شيكوكو؟
Dialogue: 10,0:16:14.17,0:16:17.63,Main,,0,0,0,,قوّات ردع الشياطين تبرع في العمل الجماعيّ أكثر ممّا توقّعنا
Dialogue: 10,0:16:17.63,0:16:20.58,Main,,0,0,0,,...لذا ينبغي لنا حث الخطى لإقامة يوم التطهير
Dialogue: 10,0:16:20.58,0:16:22.83,Main,,0,0,0,,الّذي كان مقرّرًا بعد الهجوم الشامل
Dialogue: 10,0:16:23.63,0:16:27.46,Main,,0,0,0,,سنشنّ الهجوم الشامل بعد حلول يوم التطهير
Dialogue: 10,0:16:27.75,0:16:30.83,Main,,0,0,0,,ستزداد قوّتنا بشكلٍ هائلٍ أيضًا
Dialogue: 10,0:16:30.83,0:16:34.00,Main,,0,0,0,,وسنتمكّن من سحق قوات ردع الشياطين حتمًا
Dialogue: 10,0:16:34.21,0:16:35.42,Main,,0,0,0,,!مُحال
Dialogue: 10,0:16:35.71,0:16:37.08,Main,,0,0,0,,!هذا النهجُ شديدُ الهوان والضعف
Dialogue: 10,0:16:37.08,0:16:39.50,Main,,0,0,0,,إلى متى سنستمرّ في الاستعداد؟
Dialogue: 10,0:16:39.50,0:16:41.96,Main,,0,0,0,,"أُفضّل تسمّيته "حذرًا
Dialogue: 10,0:16:41.96,0:16:44.96,Main,,0,0,0,,قُتلتْ إحدى الآلهة، علينا الثأر لها
Dialogue: 10,0:16:44.96,0:16:47.21,Main,,0,0,0,,أتّفق مع رايرين وناروهيمي
Dialogue: 10,0:16:49.46,0:16:52.25,Main,,0,0,0,,حسنٌ، ما رأيكنَّ بحلٍّ وسط؟
Dialogue: 10,0:16:52.67,0:16:55.38,Main,,0,0,0,,...سنمضي قُدمًا في خطّة شيكوكو-نيه
Dialogue: 10,0:16:55.38,0:16:58.08,Main,,0,0,0,,لكنّنا سنشنّ هجومًا على قوات ردع الشياطين
Dialogue: 10,0:17:00.59,0:17:03.58,Main,,0,0,0,,وسيكون المهاجمون من المؤمنين
Dialogue: 10,0:17:04.08,0:17:05.71,Main,,0,0,0,,...المؤمنون
Dialogue: 10,0:17:05.71,0:17:08.92,Main,,0,0,0,,بشرٌ سابقون منحتهم الآلهة قوّةً
Dialogue: 10,0:17:09.30,0:17:13.33,Main,,0,0,0,,وسنضمّ أكفأ تابعٍ إلى آلهة الرعد الثمانية
Dialogue: 10,0:17:13.33,0:17:16.33,Main,,0,0,0,,سيبذلون قصارى جهدهم بسعادةٍ إن قلنا لهم هذا
Dialogue: 10,0:17:16.67,0:17:20.08,Main,,0,0,0,,وهي أيضًا ممّن يطمحون لبلوغ الألوهيّة
Dialogue: 10,0:17:20.39,0:17:21.29,Main,,0,0,0,,!لا مانع لديّ
Dialogue: 10,0:17:21.69,0:17:24.58,Main,,0,0,0,,سنرى ما إن كانت قويّةً بما يكفي للوقوف بجانبنا
Dialogue: 10,0:17:24.58,0:17:26.88,Main,,0,0,0,,ما قولكِ يا تايكيوكو-نيه؟
Dialogue: 10,0:17:26.88,0:17:29.92,Main,,0,0,0,,لا أمانع ما دامت شيكوكو موافقةً
Dialogue: 10,0:17:31.17,0:17:32.29,Main,,0,0,0,,حُسم الأمر إذن
Dialogue: 10,0:17:32.54,0:17:36.00,Main,,0,0,0,,رايرين وفوكوما، لديّ ما أودّ مناقشته معكما لاحقًا
Dialogue: 10,0:17:36.19,0:17:38.38,Main,,0,0,0,,تبدين وكأنّكِ تدبّرين مكيدةً ما
Dialogue: 10,0:17:38.56,0:17:41.29,Main,,0,0,0,,ما دمنا سنهاجم، فلنشنّ هجومًا كاسحًا
Dialogue: 10,0:17:41.29,0:17:42.79,Main,,0,0,0,,!هكذا يجب أن يكون الأمر
Dialogue: 10,0:17:43.00,0:17:47.75,Main,,0,0,0,,رغبة أمّي هي استخلاص ألف بشريٍّ يوميًّا على الأقلّ
Dialogue: 10,0:17:47.97,0:17:50.29,Main,,0,0,0,,لِنتحرّك لضمان حلول ذلك اليوم
Dialogue: 10,0:17:51.25,0:17:54.67,Main,,0,0,0,,!اجعلوهم يخرّون سُجّدًا أمام عظمتنا
Dialogue: 10,0:17:56.75,0:17:59.04,Top,,0,0,0,,...حالة طوارئ في ماتو
Dialogue: 10,0:17:59.04,0:18:01.46,Main,,0,0,0,,بدأ الأمر يشتدّ حقًّا
Dialogue: 10,0:18:01.46,0:18:03.29,Main,,0,0,0,,،بدأت آلهة الرعد الثمانية بالتحرّك
Dialogue: 10,0:18:03.29,0:18:06.00,Main,,0,0,0,,وقد عاثوا فسادًا في العالم الحقيقيّ بالفعل
Dialogue: 10,0:18:06.63,0:18:09.54,Main,,0,0,0,,...وعلينا نحن أيضًا
Dialogue: 10,0:18:09.54,0:18:12.13,Main,,0,0,0,,التركيز على أن نصبح أقوى من أيّ وقتٍ مضى
Dialogue: 10,0:18:12.13,0:18:13.96,Main,,0,0,0,,أقوى من أيّ وقتٍ مضى؟
Dialogue: 10,0:18:14.47,0:18:17.13,Main,,0,0,0,,أوّلها توسيع قدرات كلٍّ منّا
Dialogue: 10,0:18:17.13,0:18:19.83,Main,,0,0,0,,وثانيًا؛ تعزيز قدرة العبد
Dialogue: 10,0:18:21.13,0:18:24.04,Main,,0,0,0,,سأكون أكثر مبادرةً في إعارته من الآن فصاعدًا
Dialogue: 10,0:18:24.38,0:18:26.75,Main,,0,0,0,,لكن جميعًا، وللقائدات الأخريات
Dialogue: 10,0:18:27.71,0:18:30.88,Main,,0,0,0,,ستغدو الفرقة السابعة أقوى بجانب يوكي
Dialogue: 10,0:18:30.88,0:18:32.75,Main,,0,0,0,,لا تدعوا آلهة الرعد يثيرون ذعركم
Dialogue: 10,0:18:33.51,0:18:36.25,Main,,0,0,0,,!سنُخضعهنَّ جميعًا
Dialogue: 10,0:18:36.50,0:18:37.58,Main,,0,0,0,,!حاضر
Dialogue: 10,0:18:37.79,0:18:41.50,Main,,0,0,0,,!بما أنَّ الأمر حُسم، فلنبدأ التدريب لاحقًا يا يوكي
Dialogue: 10,0:18:41.50,0:18:44.25,Main,,0,0,0,,!استأثرتِ به لنفسكِ مؤخّرًا يا هيمارين
Dialogue: 10,0:18:44.25,0:18:46.21,Main,,0,0,0,,!حان دوري الآن
Dialogue: 10,0:18:46.38,0:18:48.25,Main,,0,0,0,,!ستبذل ناي قصارى جهدها أيضًا
Dialogue: 10,0:18:48.25,0:18:49.13,Main,,0,0,0,,أجل
Dialogue: 10,0:18:49.13,0:18:51.88,Main,,0,0,0,,سأتدرّب معكِ متى شئتِ يا ناي-تشان
Dialogue: 10,0:18:52.00,0:18:54.92,Main,,0,0,0,,!حقًّا؟! لنذهب الآن إذن
Dialogue: 10,0:18:54.92,0:18:55.67,Main,,0,0,0,,حسنٌ
Dialogue: 10,0:18:56.41,0:18:58.04,Main,,0,0,0,,!هذا ليس عدلًا
Dialogue: 10,0:18:59.46,0:19:00.88,Main,,0,0,0,,سنتناوب جميعًا
Dialogue: 10,0:19:00.88,0:19:02.96,Main,,0,0,0,,!إذن دوري هو التالي
Dialogue: 10,0:19:02.96,0:19:05.63,Top,,0,0,0,,!وأنا أيضًا، وأنا أيضًا
Dialogue: 10,0:19:02.96,0:19:05.63,Top,,0,0,0,,!لكنّي أريد الذهاب الآن حقًّا
Dialogue: 10,0:19:02.96,0:19:05.63,Top,,0,0,0,,!ناي تريد التدرّب أيضًا
Dialogue: 10,0:19:02.96,0:19:05.63,Main,,0,0,0,,!مهلًا، تمهّلنَ جميعًا
Dialogue: 10,0:19:02.96,0:19:05.63,Main,,0,0,0,,!هيّا، شكّل فريقًا معي يا يوكي
Dialogue: 10,0:19:08.96,0:19:11.54,Main,,0,0,0,,بُورك عملكَ في التدرّب مع الجميع
Dialogue: 10,0:19:11.88,0:19:12.96,Main,,0,0,0,,كيوكا-سان؟
Dialogue: 10,0:19:13.33,0:19:17.00,Main,,0,0,0,,...التدرّب مع ميرا، واللّقاء بأوبا والأخريات
Dialogue: 10,0:19:17.00,0:19:18.54,Main,,0,0,0,,...واجتماع القائدات
Dialogue: 10,0:19:18.92,0:19:21.46,Main,,0,0,0,,كانت الأيام حافلةً بعد معركة كوسيتسو
Dialogue: 10,0:19:22.42,0:19:23.79,Main,,0,0,0,,أجل
Dialogue: 10,0:19:23.79,0:19:25.88,Main,,0,0,0,,أشعر أنّي سأنهار في أيّ لحظة
Dialogue: 10,0:19:26.18,0:19:28.54,Main,,0,0,0,,أعلم، خذ بقيّة اليوم إجازةً
Dialogue: 10,0:19:28.90,0:19:30.50,Main,,0,0,0,,هذا أمرٌ بصفتي قائدتكَ
Dialogue: 10,0:19:30.50,0:19:31.63,Main,,0,0,0,,حاضر
Dialogue: 10,0:19:32.08,0:19:33.96,Main,,0,0,0,,...بمجرّد أن ترتاح
Dialogue: 10,0:19:35.04,0:19:39.08,Main,,0,0,0,,بمجرّد أن ترتاح، هل أنتَ مستعدٌّ للتدرّب معي أيضًا؟
Dialogue: 10,0:19:45.79,0:19:46.83,Main,,0,0,0,,!بالطبع
Dialogue: 10,0:19:46.83,0:19:48.71,Main,,0,0,0,,!علينا أن نصبح أقوى قدر الإمكان
Dialogue: 10,0:19:48.92,0:19:51.08,Main,,0,0,0,,...عليكِ التفوّق على القائدة العليا ياماشيرو
Dialogue: 10,0:19:51.08,0:19:53.96,Main,,0,0,0,,!لتصبحي أنتِ القائدة العليا يا كيوكا-سان
Dialogue: 10,0:19:55.08,0:19:58.83,Main,,0,0,0,,!كما هو متوقّعٌ من عبدي
Dialogue: 10,0:21:37.71,0:21:40.67,Main,,0,0,0,,القائدة العليا ياماشيرو؟
Dialogue: 10,0:21:40.96,0:21:43.79,Main,,0,0,0,,وجدتُ بعض وقت الفراغ، لذا أتيت
Dialogue: 10,0:21:44.29,0:21:45.42,Main,,0,0,0,,أين كيوكا؟
Dialogue: 10,0:21:45.42,0:21:47.21,Main,,0,0,0,,إنّها في مقرّ الفرقة الأولى
Dialogue: 10,0:21:47.21,0:21:49.04,Main,,0,0,0,,قالت إنَّ لديها شأنًا مع ميوغا-سان
Dialogue: 10,0:21:49.46,0:21:52.46,Main,,0,0,0,,فهمت، يا له من توقيتٍ سيّئ
Dialogue: 10,0:21:54.75,0:21:56.67,Main,,0,0,0,,أكنتَ تعدّ الطعام؟
Dialogue: 10,0:21:56.67,0:21:57.75,Main,,0,0,0,,...أجل
Dialogue: 10,0:22:05.33,0:22:06.88,Main,,0,0,0,,سآكل
Dialogue: 10,0:22:09.33,0:22:12.08,Main,,0,0,0,,...القائدة العليا تتناول وجبةً في مسكننا
Dialogue: 10,0:22:12.08,0:22:13.88,Main,,0,0,0,,يا له من مشهدٍ غريبٍ
Dialogue: 10,0:22:14.58,0:22:16.21,Main,,0,0,0,,...ومع ذلك
Dialogue: 10,0:22:16.92,0:22:19.54,Main,,0,0,0,,طريقة أكلها أنيقةٌ للغاية
Dialogue: 10,0:22:21.21,0:22:22.75,Main,,0,0,0,,شكرًا على الطعام
Dialogue: 10,0:22:22.75,0:22:24.38,Main,,0,0,0,,!بالهناء والشفاء
Dialogue: 10,0:22:25.04,0:22:27.88,Main,,0,0,0,,!من المطمئن أنّها أنهتْ طبقها
Dialogue: 10,0:22:28.50,0:22:30.04,Main,,0,0,0,,كان لذيذًا
Dialogue: 10,0:22:30.27,0:22:32.21,Main,,0,0,0,,طبقٌ يابانيٌّ يعكس روح الموسم
Dialogue: 10,0:22:34.08,0:22:35.46,Main,,0,0,0,,والآن مكافأتكَ
Dialogue: 10,0:22:36.88,0:22:37.88,Main,,0,0,0,,اجلس
Dialogue: 10,0:22:40.92,0:22:42.58,Main,,0,0,0,,...اجلس" تعني"
Dialogue: 10,0:22:43.92,0:22:45.21,Main,,0,0,0,,!هكذا
Dialogue: 10,0:22:46.04,0:22:47.58,Top,,0,0,0,,!فتى مطيع، فتى مطيع
Dialogue: 10,0:22:46.75,0:22:47.97,Main,,0,0,0,,...المعذرة
Dialogue: 10,0:22:47.58,0:22:49.08,Top,,0,0,0,,!فتى مطيع، فتى مطيع
Dialogue: 10,0:22:49.88,0:22:51.79,Main,,0,0,0,,...ما الّذي
Dialogue: 10,0:22:52.63,0:22:54.58,Top,,0,0,0,,!فتى مطيع، فتى مطيع
Dialogue: 10,0:22:52.63,0:22:54.58,Main,,0,0,0,,يحدث الآن؟
Dialogue: 10,0:22:54.58,0:22:56.25,Top,,0,0,0,,!فتى مطيع، فتى مطيع
Dialogue: 10,0:22:59.26,0:23:01.00,Main,,0,0,0,,الأمر مختلفٌ كما توقّعت
Dialogue: 10,0:23:01.54,0:23:04.75,Main,,0,0,0,,لا طائل منكَ حين تكون في هيئتكَ البشريّة
Dialogue: 10,0:23:10.69,0:23:13.88,Main,,0,0,0,,عليّ تأديبه بعد تحوّله لهيئة العبد
Dialogue: 10,0:23:14.21,0:23:15.79,Main,,0,0,0,,...وإلّا
Dialogue: 10,0:23:17.21,0:23:20.17,Main,,0,0,0,,فلن يُعدّ ذلك انتقامًا لما فعله حينها
Dialogue: 10,0:23:21.50,0:23:23.58,Main,,0,0,0,,سأعود حتمًا
Dialogue: 10,0:23:26.71,0:23:28.33,Main,,0,0,0,,!اطمئنّوا
Dialogue: 10,0:23:28.79,0:23:30.63,Main,,0,0,0,,!ثمة مكافأة
Dialogue: 10,0:23:31.00,0:23:33.38,Main,,0,0,0,,من المؤسف أنّكنَّ لم تظهرنَ كثيرًا
Dialogue: 10,0:23:33.38,0:23:36.33,Main,,0,0,0,,أشعر بالراحة لأنّني لم أضطر للقيام بأيّ تدريبٍ خاصٍّ
Dialogue: 10,0:23:36.50,0:23:38.08,Main,,0,0,0,,!ستشتدّ المعارك
Dialogue: 10,0:23:38.16,0:23:40.43,Main,,0,0,0,,!أترقّب تألّقكنَّ جميعًا
Comment: 0,0:23:39.96,0:23:41.96,Note,,0,0,0,,
Dialogue: 10,0:17:04.08,0:17:08.92,Note,,0,0,0,,المؤمنون: هم الأتباع الّذين يقدسون آلهة الرعد الثمانية ويأتمرون بأمرهم
