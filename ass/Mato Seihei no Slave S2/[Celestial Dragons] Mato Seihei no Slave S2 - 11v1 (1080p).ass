Dialogue: 10,0:00:17.13,0:00:18.38,Main,,0,0,0,,!الاندفاع السماويّ
Dialogue: 10,0:00:20.33,0:00:21.67,Main,,0,0,0,,...يوكي-كن
Dialogue: 10,0:00:22.29,0:00:25.58,Main,,0,0,0,,تزداد قوّةً باستمرار إذن
Dialogue: 10,0:00:31.50,0:00:33.96,Main,,0,0,0,,!والآن، لنحسم هذا الأمر
Dialogue: 10,0:00:34.18,0:00:36.63,Main,,0,0,0,,!ميرا-سان... سأنقذكِ الآن
Dialogue: 10,0:02:30.83,0:02:32.21,Main,,0,0,0,,هذه ورقتكما الرابحة إذن
Dialogue: 10,0:02:32.63,0:02:33.75,Main,,0,0,0,,!مثيرٌ للاهتمام
Dialogue: 10,0:02:37.29,0:02:39.04,Main,,0,0,0,,!حان دورنا الآن
Dialogue: 10,0:02:39.04,0:02:40.00,Main,,0,0,0,,!حاضر
Dialogue: 10,0:02:40.16,0:02:41.57,Main,,0,0,0,,!القبضة السماويّة
Dialogue: 10,0:02:44.29,0:02:46.29,Main,,0,0,0,,هذا متوقّع
Dialogue: 10,0:02:53.88,0:02:55.54,Main,,0,0,0,,!سلاسل غبية
Dialogue: 10,0:02:59.92,0:03:01.17,Main,,0,0,0,,!في الأعلى
Dialogue: 10,0:03:01.75,0:03:03.79,Main,,0,0,0,,!هذا ما يحدثُ لمن يقع في شباكها إذن
Dialogue: 10,0:03:04.13,0:03:06.29,Main,,0,0,0,,!ليستْ سلاسل عاديّةً إذن
Dialogue: 10,0:03:23.88,0:03:26.38,Main,,0,0,0,,...كوكو... ناون
Dialogue: 10,0:03:26.88,0:03:28.50,Main,,0,0,0,,!أمسكتُ بكِ
Dialogue: 10,0:03:29.08,0:03:30.92,Main,,0,0,0,,!انتهى أمركِ
Dialogue: 10,0:03:30.92,0:03:33.21,Main,,0,0,0,,!لا تتدخّلي
Dialogue: 10,0:03:34.08,0:03:35.92,Main,,0,0,0,,!!يوكي، ادعمني
Dialogue: 10,0:03:36.88,0:03:37.88,Main,,0,0,0,,!نيه-تشان
Dialogue: 10,0:03:43.83,0:03:46.21,Main,,0,0,0,,!النصل المتقاطع الجبّار
Dialogue: 10,0:04:02.04,0:04:03.67,Main,,0,0,0,,صدّيتِها إذن
Dialogue: 10,0:04:03.67,0:04:04.88,Main,,0,0,0,,...ومع ذلك
Dialogue: 10,0:04:05.54,0:04:08.75,Main,,0,0,0,,العقاب الإلهيّ واقعٌ لا محالة
Dialogue: 10,0:04:15.33,0:04:18.75,Main,,0,0,0,,!هجماتٌ متتاليةٌ، هذا مزعجٌ بحقّ
Dialogue: 10,0:04:18.75,0:04:20.42,Main,,0,0,0,,!سأواصل استدراجهنَّ
Dialogue: 10,0:04:25.88,0:04:27.75,Main,,0,0,0,,!باسم عائلة أزوما
Dialogue: 10,0:04:28.29,0:04:30.00,Main,,0,0,0,,!سنصمد هنا
Dialogue: 10,0:04:32.83,0:04:34.04,Spells,,0,0,0,,آمي نو ميتوري: طائر السماء المقدّس؛ قدرة تلاعب بالفضاء
Dialogue: 10,0:04:32.83,0:04:34.04,Main,,0,0,0,,!طائر السماء المقدّس
Dialogue: 10,0:04:38.04,0:04:39.47,Main,,0,0,0,,!الاندفاع السماويّ
Dialogue: 10,0:04:40.84,0:04:41.93,Main,,0,0,0,,...الاندفاع السماويّ
Dialogue: 10,0:04:42.45,0:04:45.74,Main,,0,0,0,,سأكون عند حُسنِ ظنّه حتمًا
Dialogue: 10,0:05:14.61,0:05:16.21,Main,,0,0,0,,قمم السحاب في العُلا
Dialogue: 10,0:05:16.61,0:05:19.96,Main,,0,0,0,,كم منها ينجلي ليُسفر عن جبلٍ مقمرٍ
Dialogue: 10,0:05:22.23,0:05:24.33,Main,,0,0,0,,...أحرّر عقلي من قيوده
Dialogue: 10,0:05:26.88,0:05:29.54,Main,,0,0,0,,لأُعزّز حركتي لفترةٍ وجيزة
Dialogue: 10,0:05:29.54,0:05:32.75,Main,,0,0,0,,التقنية الّتي طوّرتها لمجابهة آلهة الرعد الثمانية تحسّبًا
Dialogue: 10,0:05:39.13,0:05:41.63,Main,,0,0,0,,!سأريكِ تقنيّةً جبّارةً من تقنياتي أيضًا
Dialogue: 10,0:05:42.04,0:05:43.17,Main,,0,0,0,,!اشهدي
Dialogue: 10,0:05:45.08,0:05:47.29,Main,,0,0,0,,!على بهائي الأخّاذ
Dialogue: 10,0:05:48.75,0:05:50.75,Main,,0,0,0,,!استنسختْ ذراعها فحسب إذن
Dialogue: 10,0:06:24.42,0:06:29.08,Main,,0,0,0,,!ارتعدا رعبًا أمام عقاباتي الإلهيّة المليون
Dialogue: 10,0:06:30.38,0:06:31.67,Main,,0,0,0,,...تذكّر
Dialogue: 10,0:06:31.67,0:06:33.17,Main,,0,0,0,,!تلك الصورة
Dialogue: 10,0:06:43.21,0:06:45.42,Main,,0,0,0,,!اخترقا وابل هجماتي الإلهيّة؟
Dialogue: 10,0:06:45.42,0:06:47.04,Main,,0,0,0,,!رغم أنّي نويتُ القضاء عليهما
Dialogue: 10,0:06:50.08,0:06:51.13,Main,,0,0,0,,كانت بطيئةً إذن
Dialogue: 10,0:06:51.63,0:06:53.96,Main,,0,0,0,,!سأندفع بقوّةٍ أكبر في الضربة التاليّة
Dialogue: 10,0:06:55.43,0:06:56.29,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:06:56.92,0:07:00.79,Main,,0,0,0,,!سأرسل نُسخي لتسديد الضربة القاضيّة من باب الاحتياط
Dialogue: 10,0:07:01.17,0:07:02.08,Main,,0,0,0,,!انطلقنَ
Dialogue: 10,0:07:09.96,0:07:11.08,Main,,0,0,0,,ما الخطب؟
Dialogue: 10,0:07:12.75,0:07:14.38,Main,,0,0,0,,!اذهبي معهنَّ
Dialogue: 10,0:07:29.13,0:07:30.13,Main,,0,0,0,,!ميرا؟
Dialogue: 10,0:07:32.29,0:07:33.63,Main,,0,0,0,,...نُسخكِ بطيئةٌ
Dialogue: 10,0:07:34.92,0:07:37.58,Main,,0,0,0,,لم تمتصّي ميرا بالكامل إذن
Dialogue: 10,0:07:44.49,0:07:45.63,Main,,0,0,0,,!كفاكِ هراءً
Dialogue: 10,0:07:47.54,0:07:48.96,Main,,0,0,0,,!لنفعلها يا يوكي
Dialogue: 10,0:07:48.96,0:07:49.96,Main,,0,0,0,,!حاضر
Dialogue: 10,0:08:01.50,0:08:02.88,Main,,0,0,0,,!سحقًا لكِ يا ميرا
Dialogue: 10,0:08:03.79,0:08:06.13,Main,,0,0,0,,!سأمتصّكِ بالكامل فورًا
Dialogue: 10,0:08:07.79,0:08:09.79,Main,,0,0,0,,!أنا فاتنة
Dialogue: 10,0:08:10.96,0:08:12.42,Main,,0,0,0,,!أنا إلهة
Dialogue: 10,0:08:16.51,0:08:17.88,Main,,0,0,0,,...أهبُ جسدي
Dialogue: 10,0:08:18.71,0:08:20.54,Main,,0,0,0,,!لكيوكا-سان
Dialogue: 10,0:08:26.46,0:08:28.67,Main,,0,0,0,,اختفى يوكي؟
Dialogue: 10,0:08:30.93,0:08:31.67,Main,,0,0,0,,...كلّا
Dialogue: 10,0:08:32.67,0:08:36.33,Main,,0,0,0,,!يوكي بداخل ذلك السيف
Dialogue: 10,0:08:50.04,0:08:53.38,Main,,0,0,0,,!ذوقي مرارة العقاب الإلهيّ
Dialogue: 10,0:09:03.67,0:09:05.38,Main,,0,0,0,,!سيف الإخضاع
Dialogue: 10,0:09:07.25,0:09:08.04,Main,,0,0,0,,...مـ
Dialogue: 10,0:09:15.54,0:09:16.54,Main,,0,0,0,,...هذا
Dialogue: 10,0:09:17.78,0:09:19.58,Main,,0,0,0,,...أنا الكامنُ في هذا النصل
Dialogue: 10,0:09:20.00,0:09:22.33,Main,,0,0,0,,سأطيح بها بضربتي القاضيّة
Dialogue: 10,0:09:23.54,0:09:25.42,Main,,0,0,0,,...وبدمج قوّة الاندفاع السماويّ
Dialogue: 10,0:09:25.83,0:09:27.50,Main,,0,0,0,,وفنوني القتاليّة
Dialogue: 10,0:09:30.54,0:09:32.17,Main,,0,0,0,,!التقنية المزدوجة المطلقة
Dialogue: 10,0:09:57.83,0:10:00.17,Main,,0,0,0,,!جميعهنَّ على قيد الحياة
Dialogue: 10,0:10:12.54,0:10:15.92,Main,,0,0,0,,...إن قاومتِ أو حاولتِ التخلّل
Dialogue: 10,0:10:17.24,0:10:18.17,Main,,0,0,0,,فسأقتلكِ
Dialogue: 10,0:10:30.33,0:10:31.92,Main,,0,0,0,,أهذه هيئتها الأصليّة؟
Dialogue: 10,0:10:35.21,0:10:36.38,Main,,0,0,0,,!احذري
Dialogue: 10,0:10:36.88,0:10:39.63,Main,,0,0,0,,...إن أصررتِ على امتصاصي
Dialogue: 10,0:10:50.75,0:10:52.63,Main,,0,0,0,,فقد حان وقت خضوعكِ
Dialogue: 10,0:11:10.48,0:11:11.67,Main,,0,0,0,,...الاندفاع السماويّ
Dialogue: 10,0:11:13.04,0:11:14.75,Main,,0,0,0,,أحسنتَ استغلاله
Dialogue: 10,0:11:18.42,0:11:20.13,Main,,0,0,0,,!شكرًا لكِ
Dialogue: 10,0:11:24.38,0:11:27.83,Main,,0,0,0,,صحيح، ماذا سنفعل بشأن نيه-تشان والأخريات؟
Dialogue: 10,0:11:30.33,0:11:32.29,Main,,0,0,0,,دع الأمر لي
Dialogue: 10,0:11:37.29,0:11:40.13,Main,,0,0,0,,!لا تتحرّكي، سأطلق النار إن فعلتِ
Dialogue: 10,0:11:54.71,0:11:56.33,Main,,0,0,0,,!هربتْ نحو المجاري
Dialogue: 10,0:11:57.67,0:12:00.50,Main,,0,0,0,,!شكرًا لكِ يا تينكا-سان
Dialogue: 10,0:12:03.50,0:12:05.83,Main,,0,0,0,,!يبدو أنّكم قهرتم إلهةً
Dialogue: 10,0:12:07.25,0:12:10.21,Main,,0,0,0,,تولّوا العلاج وأبلغوا المقرّ بهزيمة العدوّ
Dialogue: 10,0:12:10.21,0:12:13.25,Main,,0,0,0,,سأؤمّن المحيط من باب الاحتياط
Dialogue: 10,0:12:13.25,0:12:15.71,Main,,0,0,0,,سأتولّى إرسال التقرير
Dialogue: 10,0:12:15.71,0:12:19.33,Main,,0,0,0,,!دعوا العلاج لي، فطاقتي تفيض
Dialogue: 10,0:12:22.21,0:12:23.42,Main,,0,0,0,,!هذا صحيح
Dialogue: 10,0:12:23.42,0:12:27.38,Main,,0,0,0,,!سنتعافى في لمح البصر بفضل وجود توبيرا-سان
Dialogue: 10,0:12:33.79,0:12:37.00,Main,,0,0,0,,...هذا سيئ، شعرتُ بالارتياح أخيرًا، ولكن
Dialogue: 10,0:12:37.63,0:12:41.50,Main,,0,0,0,,...أشعر وكأنّي... سأفقد
Dialogue: 10,0:12:58.21,0:12:59.21,Main,,0,0,0,,أهلًا
Dialogue: 10,0:13:02.25,0:13:03.79,Main,,0,0,0,,!كوسيتسو
Dialogue: 10,0:13:04.04,0:13:07.88,Main,,0,0,0,,لا تذعر، فهذا ليس واقعًا
Dialogue: 10,0:13:08.79,0:13:13.42,Main,,0,0,0,,إنّه عالمكَ الداخليّ، أشبه بقصرٍ عقليّ
Dialogue: 10,0:13:30.17,0:13:33.21,Main,,0,0,0,,عالمي... الداخليّ؟
Dialogue: 10,0:13:33.54,0:13:39.25,Main,,0,0,0,,فقدتُ جسدي الماديّ، فتجسّدتُ حيث بقيتْ آثار طاقتي
Dialogue: 10,0:13:39.25,0:13:40.33,Main,,0,0,0,,طاقة؟
Dialogue: 10,0:13:40.33,0:13:43.63,Main,,0,0,0,,تجرّعتَ رحيقًا إلهيًّا شديد التركيز، أتذكر؟
Dialogue: 10,0:13:46.79,0:13:48.21,Main,,0,0,0,,ذلك إذن
Dialogue: 10,0:13:49.04,0:13:52.75,Main,,0,0,0,,الآلهة لا تتلاشى في الهواء هكذا ببساطة
Dialogue: 10,0:13:53.54,0:13:56.46,Main,,0,0,0,,ومع ذلك، فقد فنيَ جسدي الماديّ
Dialogue: 10,0:13:56.46,0:14:01.92,Main,,0,0,0,,يستحيل عليَّ التأثير على العالم الخارجيّ، ناهيكَ عن القتال
Dialogue: 10,0:14:06.42,0:14:08.00,Main,,0,0,0,,...أنا وأنتَ
Dialogue: 10,0:14:08.42,0:14:11.38,Main,,0,0,0,,مُجبران على التعايش معًا
Dialogue: 10,0:14:18.04,0:14:19.92,Main,,0,0,0,,...أنتَ على وشك الاستيقاظ
Dialogue: 10,0:14:20.42,0:14:23.58,Main,,0,0,0,,حسنٌ، يسعنا التحدّث متى شئنا من الآن فصاعدًا
Dialogue: 10,0:14:23.78,0:14:28.17,Main,,0,0,0,,اعتبر نفسكَ محظوظًا لاستضافتكَ إلهةً فاتنةً بداخلكَ
Dialogue: 10,0:14:28.33,0:14:31.04,Main,,0,0,0,,مـ-محظوظ؟
Dialogue: 10,0:14:40.29,0:14:41.92,Main,,0,0,0,,أين أنا؟
Dialogue: 10,0:14:43.58,0:14:46.67,Main,,0,0,0,,!مسكن الفرقة السابعة في ماتو يا يوكي-سان
Dialogue: 10,0:14:50.85,0:14:52.79,Main,,0,0,0,,أكان ذلك حلمًا؟
Dialogue: 10,0:14:55.42,0:14:58.71,Main,,0,0,0,,!اهدأ رجاءً، هذا أمرٌ من رئيستك
Dialogue: 10,0:14:59.25,0:15:00.96,Main,,0,0,0,,حـ-حاضر
Dialogue: 10,0:15:04.25,0:15:08.21,Main,,0,0,0,,فقدتَ وعيكَ بعد معركة يوكوهاما يا يوكي-سان
Dialogue: 10,0:15:08.58,0:15:10.63,Main,,0,0,0,,ونمتَ ليومين تقريبًا
Dialogue: 10,0:15:11.30,0:15:13.83,Main,,0,0,0,,لذا أحضروني إلى هنا
Dialogue: 10,0:15:13.83,0:15:15.75,Main,,0,0,0,,عُولجتْ جراحكَ بالكامل
Dialogue: 10,0:15:16.13,0:15:18.96,Main,,0,0,0,,!ويبدو أنّكَ في أتمّ صحّةٍ
Dialogue: 10,0:15:18.96,0:15:22.17,Main,,0,0,0,,القائدة في المقرّ الرئيسيّ مع القائدة كاميونتين والأخريات
Dialogue: 10,0:15:22.17,0:15:24.54,Main,,0,0,0,,لتقديم تقريرٍ عمّا حدث في يوكوهاما
Dialogue: 10,0:15:24.54,0:15:25.96,Main,,0,0,0,,...في هذه الحالة
Dialogue: 10,0:15:25.96,0:15:28.04,Main,,0,0,0,,يجدر بي العودة للعمل أنا أيضًا
Dialogue: 10,0:15:29.58,0:15:30.79,Main,,0,0,0,,...بالنسبة لليوم
Dialogue: 10,0:15:32.17,0:15:33.67,Main,,0,0,0,,!عليك أن ترتاح
Dialogue: 10,0:15:37.00,0:15:39.08,Main,,0,0,0,,ستتولّى ناي إعداد الطعام
Dialogue: 10,0:15:39.08,0:15:41.13,Main,,0,0,0,,وسأجهّز لكَ الحمام أيضًا
Dialogue: 10,0:15:41.50,0:15:42.96,Main,,0,0,0,,شكرًا لكِ
Dialogue: 10,0:15:44.63,0:15:48.25,Main,,0,0,0,,!سأقبل عرض ناي وأستحمّ أولًا
Dialogue: 10,0:15:51.88,0:15:53.58,Main,,0,0,0,,راودني شعورٌ بأنّكَ استيقظتَ
Dialogue: 10,0:15:53.58,0:15:56.17,Main,,0,0,0,,فقد بدأ جسدي يتحرّك من تلقاء نفسه
Dialogue: 10,0:15:56.75,0:15:58.00,Main,,0,0,0,,!صحيح
Dialogue: 10,0:15:58.00,0:16:00.00,Main,,0,0,0,,!لم تمنحني مكافأتي بعد
Dialogue: 10,0:16:00.46,0:16:01.75,Main,,0,0,0,,كيف حالكَ؟
Dialogue: 10,0:16:01.75,0:16:02.88,Main,,0,0,0,,!في أتمّ صحّةٍ
Dialogue: 10,0:16:03.13,0:16:05.46,Main,,0,0,0,,!وأنا كذلك، طاقتي تفيض
Dialogue: 10,0:16:07.29,0:16:09.88,Main,,0,0,0,,!سمعتُ أنّكَ من أنقذني
Dialogue: 10,0:16:09.88,0:16:11.33,Main,,0,0,0,,!شكرًا لك
Dialogue: 10,0:16:12.13,0:16:13.88,Main,,0,0,0,,هذا بفضل تعاون الجميع
Dialogue: 10,0:16:14.13,0:16:15.54,Main,,0,0,0,,هذا صحيح
Dialogue: 10,0:16:15.54,0:16:18.17,Main,,0,0,0,,إنّه انتصارٌ حقّقته قوات ردع الشياطين بأكملها
Dialogue: 10,0:16:20.67,0:16:22.25,Main,,0,0,0,,وخاصّةً أنتِ يا ميرا
Dialogue: 10,0:16:22.25,0:16:24.75,Main,,0,0,0,,قاومتِ حتّى بعد أن ابتلعتكِ
Dialogue: 10,0:16:24.75,0:16:26.29,Main,,0,0,0,,عنيدةٌ كما عهدتكِ
Dialogue: 10,0:16:28.58,0:16:33.13,Main,,0,0,0,,فكرةُ تركها تمتصّ كلّ طاقتي أثارتْ حنقي
Dialogue: 10,0:16:34.21,0:16:36.54,Main,,0,0,0,,!هذا توقيتٌ مثاليٌّ بما أنّنا مجتمعون هنا
Dialogue: 10,0:16:36.54,0:16:38.63,Main,,0,0,0,,سنعقد جلسة تقييمٍ، لذا ساعداني
Dialogue: 10,0:16:41.13,0:16:44.13,Main,,0,0,0,,عذرًا، لكنَّ جلسة التقييم ستُعقد لاحقًا
Dialogue: 10,0:16:45.26,0:16:46.63,Main,,0,0,0,,!لماذا؟
Dialogue: 10,0:16:48.17,0:16:51.46,Main,,0,0,0,,ستبدأ المكافأة، لذا غادرا رجاءً
Dialogue: 10,0:16:54.63,0:16:56.42,Main,,0,0,0,,سأمنحه مكافأةً أنا أيضًا
Dialogue: 10,0:16:56.42,0:16:57.88,Main,,0,0,0,,!لماذا؟
Dialogue: 10,0:16:58.13,0:17:00.00,Main,,0,0,0,,كما قلتِ يا كيو-تشين
Dialogue: 10,0:17:00.00,0:17:02.21,Main,,0,0,0,,هذا النصر يعود لقوات ردع الشياطين
Dialogue: 10,0:17:03.42,0:17:07.21,Main,,0,0,0,,لذا ينبغي لمن يقدر على مكافأتِه أن يُبادر
Dialogue: 10,0:17:07.21,0:17:09.17,Main,,0,0,0,,أهذه هي المشكلة؟
Dialogue: 10,0:17:10.17,0:17:13.42,Main,,0,0,0,,...أنقذني بنفسه في النهاية
Dialogue: 10,0:17:14.88,0:17:17.13,Main,,0,0,0,,سـ-سأساعدكنَّ
Dialogue: 10,0:17:17.13,0:17:18.75,Main,,0,0,0,,لا تضغطي على نفسكِ
Dialogue: 10,0:17:18.75,0:17:19.42,Main,,0,0,0,,...مـ
Dialogue: 10,0:17:19.67,0:17:22.92,Main,,0,0,0,,هذا النمط يعني أنّنا سنستحم معًا
Dialogue: 10,0:17:23.04,0:17:26.00,Main,,0,0,0,,!نـ-نستحمّ؟
Dialogue: 10,0:17:26.63,0:17:29.17,Main,,0,0,0,,!نحن لم نتبادل المذكّرات حتّى
Dialogue: 10,0:17:29.17,0:17:30.38,Main,,0,0,0,,!هذا مستحيل
Dialogue: 10,0:17:32.40,0:17:33.92,Main,,0,0,0,,!ما خطبكِ يا تينكا؟
Dialogue: 10,0:17:34.06,0:17:36.54,Main,,0,0,0,,جسدكِ لا يتحرّك من تلقاء نفسه، أليس كذلك؟
Dialogue: 10,0:17:37.38,0:17:39.67,Main,,0,0,0,,!لا تتردّد إطلاقًا
Dialogue: 10,0:17:59.09,0:18:01.63,Main,,0,0,0,,!أشعر بالخجل الشديد لدرجة أنّي عاجزةٌ عن خلع ملابسي
Dialogue: 10,0:18:02.00,0:18:04.38,Main,,0,0,0,,!رغم أنّي من اقترحتُ ذلك
Dialogue: 10,0:18:07.08,0:18:11.17,Main,,0,0,0,,...رـ-رؤية مشهدٍ كهذا أمامي
Dialogue: 10,0:18:13.13,0:18:15.83,Main,,0,0,0,,!يصيبني بالتوتر لدرجة الشلل
Dialogue: 10,0:18:16.13,0:18:18.08,Main,,0,0,0,,أتشعر بالدوار؟
Dialogue: 10,0:18:18.08,0:18:20.33,Main,,0,0,0,,أظنّ أنّه خجلٌ
Dialogue: 10,0:18:27.46,0:18:29.96,Main,,0,0,0,,...فعل شيءٍ كهذا في ينبوعٍ ساخنٍ
Dialogue: 10,0:18:29.96,0:18:31.38,Main,,0,0,0,,يا لكَ من منحرف
Dialogue: 10,0:18:36.69,0:18:38.58,Main,,0,0,0,,أبليتَ بلاءً حسنًا حينها
Dialogue: 10,0:18:44.71,0:18:46.17,Main,,0,0,0,,...عـ-عذرًا
Dialogue: 10,0:18:46.28,0:18:48.83,Main,,0,0,0,,!ثـ-ثمّة أمرٌ يجدر بكنَّ معرفته
Dialogue: 10,0:18:49.13,0:18:50.25,Main,,0,0,0,,ما هو؟
Dialogue: 10,0:18:55.70,0:18:57.83,Main,,0,0,0,,...إلهةٌ بداخل يوكي-كن
Dialogue: 10,0:18:58.06,0:18:59.88,Main,,0,0,0,,تبدو غير ضارّةٍ رغم ذلك
Dialogue: 10,0:18:59.88,0:19:03.46,Main,,0,0,0,,يصعب الجزم ما إن كان ذلك مجرّد حلمٍ
Dialogue: 10,0:19:04.08,0:19:05.13,Main,,0,0,0,,أجل
Dialogue: 10,0:19:05.25,0:19:07.71,Main,,0,0,0,,ولا يسعني التحدّث إليها الآن أيضًا
Dialogue: 10,0:19:08.96,0:19:11.46,Main,,0,0,0,,سأحرص على مراقبتكَ عن كثبٍ
Dialogue: 10,0:19:13.13,0:19:14.83,Main,,0,0,0,,سنرى كيف ستؤول الأمور
Dialogue: 10,0:19:14.98,0:19:16.83,Main,,0,0,0,,واصل إبلاغي بأيّ تطوّرات
Dialogue: 10,0:19:17.25,0:19:19.13,Main,,0,0,0,,!حـ-حاضر
Dialogue: 10,0:19:24.21,0:19:27.67,Main,,0,0,0,,!كـ-كما توقّعت، لا يسعني خلع ملابسي
Dialogue: 10,0:19:33.98,0:19:38.25,Main,,0,0,0,,...عقدتْ كيوكا وميرا جلسة تقييمٍ لمعركة كوسيتسو
Dialogue: 10,0:19:38.25,0:19:40.96,Main,,0,0,0,,تحسّبًا لهجوم آلهة الرعد الثمانية القادم
Dialogue: 10,0:19:41.38,0:19:44.49,Main,,0,0,0,,لا سيّما اللحظة الّتي هُزمتْ فيها ميرا أمام كوسيتسو
Dialogue: 10,0:19:44.80,0:19:47.12,Main,,0,0,0,,راجعتا تلك اللحظة بدقّةٍ
Dialogue: 10,0:19:52.86,0:19:55.92,Main,,0,0,0,,اندفعتُ لمهاجمتها بشكلٍ متهورٍ للغاية كما توقّعت
Dialogue: 10,0:19:56.13,0:20:00.04,Main,,0,0,0,,لكن كان ذلك بسبب إرهاقكِ من إنقاذ سكّان المدينة
Dialogue: 10,0:20:00.30,0:20:03.71,Main,,0,0,0,,أردتُ القضاء على الإلهة بصفتي قائدةً أيضًا
Dialogue: 10,0:20:04.75,0:20:08.92,Main,,0,0,0,,كانت النتيجة جيّدة، لكن لا يسعني الاكتفاء بذلك
Dialogue: 10,0:20:09.33,0:20:12.88,Main,,0,0,0,,رغم براعة ميرا-سان، إلّا أنّها قاسيةٌ على نفسها للغاية
Dialogue: 10,0:20:14.02,0:20:14.88,Main,,0,0,0,,كيوكا
Dialogue: 10,0:20:16.00,0:20:18.13,Main,,0,0,0,,أعيريني العبد
Dialogue: 10,0:21:52.33,0:21:56.08,Main,,0,0,0,,!هذه قصّة حلمٍ راود يوكي
Dialogue: 10,0:21:56.84,0:21:57.97,Main,,0,0,0,,!ثانوية؟
Dialogue: 10,0:21:58.27,0:21:59.50,Main,,0,0,0,,!ما الّذي أفعله هنا؟
Dialogue: 10,0:22:08.66,0:22:09.50,Main,,0,0,0,,!أنت
Dialogue: 10,0:22:10.67,0:22:12.92,Main,,0,0,0,,!لا تشردْ هكذا منذ الصباح الباكر
Dialogue: 10,0:22:12.92,0:22:14.67,Main,,0,0,0,,!آ-آسف
Dialogue: 10,0:22:16.33,0:22:18.29,Main,,0,0,0,,!مرحبًا أيّها الزميل الأصغر
Dialogue: 10,0:22:23.73,0:22:26.03,Main,,0,0,0,,!ستبدأ الحصّة قريبًا
Dialogue: 10,0:22:26.16,0:22:27.33,Main,,0,0,0,,!اذهبوا إلى الفصل
Dialogue: 10,0:22:27.33,0:22:30.17,Main,,0,0,0,,!الجميع طلابٌ هنا
Dialogue: 10,0:22:32.00,0:22:36.21,Main,,0,0,0,,هذا عالمكَ، ويسعني افتعال أمورٍ كهذه
Dialogue: 10,0:22:36.21,0:22:37.88,Main,,0,0,0,,!هذا من صنيعِ الإلهة إذن
Dialogue: 10,0:22:38.10,0:22:39.88,Main,,0,0,0,,...بناءً على ذكرياتك
Dialogue: 10,0:22:40.00,0:22:43.08,Main,,0,0,0,,لم تحظَ بقرينةٍ في أيام دراستكَ إذن
Dialogue: 10,0:22:44.99,0:22:46.71,Main,,0,0,0,,سأكون قرينتكَ
Dialogue: 10,0:22:53.21,0:22:55.02,Main,,0,0,0,,!لنكمل تزاوجنا
Dialogue: 10,0:23:00.29,0:23:01.36,Main,,0,0,0,,مـ-ما الّذي يحدث؟
Dialogue: 10,0:23:01.92,0:23:04.17,Main,,0,0,0,,!جسدي يتحرّك من تلقاء نفسه مجدّدًا
Dialogue: 10,0:23:05.58,0:23:06.92,Main,,0,0,0,,!حافظ على هدوئك
Dialogue: 10,0:23:06.92,0:23:09.58,Main,,0,0,0,,!لديكَ الكثير من الأسئلة لتطرحها
Dialogue: 10,0:23:11.38,0:23:14.71,Main,,0,0,0,,!عليَّ تدارك هذا الموقف
Dialogue: 10,0:23:22.37,0:23:23.42,Main,,0,0,0,,!هرب
Dialogue: 10,0:23:23.42,0:23:25.42,Main,,0,0,0,,يوكي يتهرّب من الحصّة
Dialogue: 10,0:23:26.83,0:23:29.71,Main,,0,0,0,,!"في المرّة القادمة، الحلقة 12: "تجمّع الآلهة
Dialogue: 10,0:23:30.25,0:23:31.92,Main,,0,0,0,,وإليكم مكافأة اليوم
Dialogue: 10,0:23:31.92,0:23:34.17,Main,,0,0,0,,!مرحبًا بكم في ثانوية العبيد
Dialogue: 10,0:23:34.17,0:23:36.33,Main,,0,0,0,,أليس لديكَ قرينة؟
Dialogue: 10,0:23:36.50,0:23:37.67,Main,,0,0,0,,...حسنٌ، في هذه الحالة
Dialogue: 10,0:23:37.67,0:23:39.97,Main,,0,0,0,,سأكون قرينتكَ
Comment: 0,0:23:40.29,0:23:42.29,Signs,,0,0,0,,
Dialogue: 10,0:02:40.16,0:02:41.57,Note,,0,0,0,,القبضة السماويّة؛ هجمة جسديّة ساحقة تظهر حصريًا في هيئة "الاندفاع السماويّ"، حيث يُركّز يوكي كامل طاقته المنبعثة من الرابط مع كيوكا في قبضة واحدة متفجرة
Dialogue: 10,0:04:38.04,0:04:40.68,Note,,0,0,0,,‫الاندفاع السماويّ؛ هيئة متطوّرة من "الزوبعة"، تمنح تعزيزات أكبر من الهيئة الأصليّة، غير أنَّ استخدامها يستهلك طاقة أكبر ممّا يجعله يعود إلى هيئة "الزوبعة" المعتادة بعد فترة
Dialogue: 10,0:04:41.54,0:04:45.97,Note,,0,0,0,,الزهرة السماويّة؛ هيئة متطوّرة من قدرة "النجوم المتلألئة"، تمنح طفرة هائلة في القدرات الحسيّة والإدراكيّة تتجاوز الهيئة الأصليّة بمراحل؛ حيث تتيح ليوكي وكيوكا التنبؤ بحركات العدو بدقة مطلقة ورؤية نقاط الضعف الخفيّة
Dialogue: 0,0:09:03.67,0:09:05.38,Note,,0,0,0,,سيف الإخضاع؛ تقنية هجوميّة مشتركة تجمع بين مهارة كيوكا في المبارزة وطاقة يوكي، حيث يتشكل نصل ضخم من الطاقة المركزة يقطع الأعداء بضربة واحدة قاصمة
Comment: 0,0:23:40.29,0:23:42.29,Signs,,0,0,0,,
