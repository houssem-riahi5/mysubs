Dialogue: 10,0:00:58.17,0:01:00.25,Main,,0,0,0,,!شبعتُ تمامًا
Dialogue: 10,0:01:01.58,0:01:03.63,Main,,0,0,0,,قوات ردع الشياطين مجدّدًا؟
Dialogue: 10,0:01:04.33,0:01:09.54,Main,,0,0,0,,التهمتُ ميرا للتوّ، لذا لم يعد لديَّ متّسعٌ للمزيد
Dialogue: 10,0:03:01.29,0:03:03.14,Main,,0,0,0,,!شبعتُ تمامًا
Dialogue: 10,0:03:04.56,0:03:06.21,Main,,0,0,0,,قوات ردع الشياطين مجدّدًا؟
Dialogue: 10,0:03:06.98,0:03:11.82,Main,,0,0,0,,التهمتُ ميرا للتوّ، لذا لم يعد لديَّ متّسعٌ للمزيد
Dialogue: 10,0:03:27.75,0:03:30.21,Main,,0,0,0,,يا لها من قوّةٍ بديعة
Dialogue: 10,0:03:32.38,0:03:35.88,Main,,0,0,0,,كما هو متوقّع من قوّة القائدة ميرا
Dialogue: 10,0:03:36.71,0:03:38.54,Main,,0,0,0,,!أيّتها الحقيرة
Dialogue: 10,0:03:40.13,0:03:41.29,Main,,0,0,0,,...والآن
Dialogue: 10,0:03:41.29,0:03:42.50,Main,,0,0,0,,!قوليها بملء فيكِ
Dialogue: 10,0:03:42.75,0:03:45.63,Main,,0,0,0,,!مجّدي كوسيتسو البديعة
Dialogue: 10,0:04:00.65,0:04:03.33,Spells,,0,0,0,,ميداري يامازاكورا: أزهار الكرز العاصفة؛ وابل من الضربات بالسيف
Dialogue: 10,0:04:00.65,0:04:03.33,Main,,0,0,0,,!!أزهار الكرز العاصفة
Dialogue: 10,0:04:06.04,0:04:07.29,Main,,0,0,0,,...أخبرتكِ
Dialogue: 10,0:04:08.46,0:04:09.67,Main,,0,0,0,,!أنَّ هذا لن يجدي نفعًا
Dialogue: 10,0:04:11.17,0:04:13.96,Main,,0,0,0,,!أتمكّنتْ من إيقاف وابل هجماتي الخاطفة؟
Dialogue: 10,0:04:23.63,0:04:27.00,Main,,0,0,0,,أظننتما أنَّ هذا كافٍ لمجابهة إلهة؟
Dialogue: 10,0:04:27.00,0:04:28.42,Main,,0,0,0,,،لِعلمكما فحسب
Dialogue: 10,0:04:28.68,0:04:33.54,Main,,0,0,0,,بقيّة آلهة الرعد الثمانية أقوى منّي بكثيرٍ حين يبلغنَ أوج قوّتهنَّ
Dialogue: 10,0:04:36.49,0:04:39.42,Main,,0,0,0,,على كلٍّ، سأتفوّق عليهنَّ في النهاية
Dialogue: 10,0:04:42.58,0:04:48.33,Main,,0,0,0,,بقاؤكما على قيد الحياة يعود لحذر شيكوكو-نيه لا أكثر
Dialogue: 10,0:04:50.04,0:04:53.29,Main,,0,0,0,,أنتَ واكورا يوكي، أليس كذلك؟
Dialogue: 10,0:04:53.66,0:04:56.92,Main,,0,0,0,,رفضتَ دعوتي البديعة سابقًا
Dialogue: 10,0:04:56.92,0:04:58.79,Main,,0,0,0,,يا لكَ من وقح
Dialogue: 10,0:05:00.58,0:05:03.96,Main,,0,0,0,,لنكمل ما بدأناه بهيئتينا الحاليّتين
Dialogue: 10,0:05:05.54,0:05:07.18,Main,,0,0,0,,!كفاكِ هراءً
Dialogue: 10,0:05:13.83,0:05:15.79,Main,,0,0,0,,سأجعلكَ ملكي
Dialogue: 10,0:05:29.75,0:05:32.79,Main,,0,0,0,,...أيّ امرأةٍ تقترب من أخي
Dialogue: 10,0:05:33.33,0:05:35.58,Main,,0,0,0,,!سأسحقها
Dialogue: 10,0:05:36.50,0:05:37.67,Main,,0,0,0,,!نيه-تشان
Dialogue: 10,0:05:38.83,0:05:40.46,Main,,0,0,0,,!أنتِ إذن
Dialogue: 10,0:05:49.33,0:05:52.04,Main,,0,0,0,,أشعر بطاقة كوكو وناون
Dialogue: 10,0:05:56.13,0:05:58.38,Main,,0,0,0,,!إنّهما بداخلها
Dialogue: 10,0:05:59.71,0:06:02.00,Main,,0,0,0,,!الذين التهمتهم ما زالوا على قيد الحياة
Dialogue: 10,0:06:02.88,0:06:04.17,Main,,0,0,0,,...هذا يعني
Dialogue: 10,0:06:05.29,0:06:07.21,Main,,0,0,0,,!سنجبرها على لفظ ميرا والآخريات
Dialogue: 10,0:06:07.21,0:06:08.33,Main,,0,0,0,,!أجل
Dialogue: 10,0:06:08.90,0:06:11.08,Main,,0,0,0,,!سنقضي على كوسيتسو هنا
Dialogue: 10,0:06:12.47,0:06:15.58,Main,,0,0,0,,أيسعكِ قول ذلك بعد رؤية هذا؟
Dialogue: 10,0:06:24.21,0:06:27.17,Main,,0,0,0,,التهمتُ ميرا
Dialogue: 10,0:06:29.96,0:06:33.13,Main,,0,0,0,,لذا يسعني استخدام قدرتها الآن
Dialogue: 10,0:06:44.28,0:06:48.25,Main,,0,0,0,,هل أدمّر المدينة وأُعلن عن ميلاد إلهةٍ جديدة؟
Dialogue: 10,0:06:49.59,0:06:51.67,Main,,0,0,0,,!حان وقت ورقتي الرابحة
Dialogue: 10,0:06:56.28,0:06:59.46,Main,,0,0,0,,!اتبعوا الشخص الّذي أمامكم وواصلوا التحرّك
Dialogue: 10,0:07:00.20,0:07:01.75,Main,,0,0,0,,من القطاع الثالث إلى المقرّ الرئيسيّ
Dialogue: 10,0:07:01.75,0:07:04.83,Main,,0,0,0,,أوشكنا على الانتهاء من إجلاء السكّان
Dialogue: 10,0:07:06.61,0:07:08.04,Main,,0,0,0,,!ما هذا الشيء؟
Dialogue: 10,0:07:14.34,0:07:16.63,Main,,0,0,0,,!أهذا... شوكي؟
Dialogue: 10,0:07:18.33,0:07:20.75,Main,,0,0,0,,!يا لضخامته
Dialogue: 10,0:07:24.59,0:07:26.58,Main,,0,0,0,,أكان هناك وحشٌ كهذا؟
Dialogue: 10,0:07:26.58,0:07:28.92,Main,,0,0,0,,!لا تدعه يخيفكَ يا يوكي
Dialogue: 10,0:07:29.10,0:07:34.17,Main,,0,0,0,,!يبدو أنَّ إبقائي هنا كان خطأً فادحًا من ميرا
Dialogue: 10,0:07:35.04,0:07:36.92,Main,,0,0,0,,اتّخذتْ ميرا القرار الصائب
Dialogue: 10,0:07:40.38,0:07:43.67,Main,,0,0,0,,إن تركناكِ تهربين، فسيشكّل ذلك خطرًا جسيمًا لاحقًا
Dialogue: 10,0:07:43.67,0:07:45.21,Main,,0,0,0,,ونتيجةً لذلك
Dialogue: 10,0:07:45.21,0:07:47.88,Main,,0,0,0,,اُلتهمتْ وأُقيمَ مهرجانٌ من النسخ
Dialogue: 10,0:07:52.19,0:07:54.17,Main,,0,0,0,,!نحن قوات ردع الشياطين
Dialogue: 10,0:07:54.17,0:07:55.96,Main,,0,0,0,,!ستبدأ المعركة الحقيقيّة الآن
Dialogue: 10,0:07:59.38,0:08:00.46,Main,,0,0,0,,!رين-ساما
Dialogue: 10,0:08:01.94,0:08:04.79,Main,,0,0,0,,!نحنُ جاهزاتٌ لإرسال تعزيزاتٍ إلى يوكوهاما
Dialogue: 10,0:08:20.38,0:08:22.04,Main,,0,0,0,,!من نخبة مقاتلينا
Dialogue: 10,0:08:27.83,0:08:29.38,Main,,0,0,0,,!سأقولها مرّةً أخرى
Dialogue: 10,0:08:29.38,0:08:32.21,Main,,0,0,0,,!كوسيتسو، سنقضي عليكِ هنا
Dialogue: 10,0:08:33.13,0:08:36.33,Main,,0,0,0,,!سأسحقكِ بجيشي الإلهيّ
Dialogue: 10,0:08:45.50,0:08:48.29,Main,,0,0,0,,!أنا القائدة العليا لقوات ردع الشياطين
Dialogue: 10,0:08:48.29,0:08:50.75,Main,,0,0,0,,!هَلُمّوا إليَّ جميعًا
Dialogue: 10,0:08:51.46,0:08:53.29,Main,,0,0,0,,...القائدة العليا
Dialogue: 10,0:08:53.42,0:08:56.25,Main,,0,0,0,,القائدة العليا؟ أهي الأرفع شأنًا؟
Dialogue: 10,0:08:56.79,0:08:58.59,Main,,0,0,0,,!هذا يجعل هزيمتها أمرًا يستحقّ العناء
Dialogue: 10,0:08:58.79,0:09:00.50,Main,,0,0,0,,!تمهّلي
Dialogue: 10,0:09:01.42,0:09:02.88,Main,,0,0,0,,ابتلعنَ الطعم
Dialogue: 10,0:09:02.88,0:09:04.83,Main,,0,0,0,,سنستدرجهنَّ نحو الجسر
Dialogue: 10,0:09:04.83,0:09:06.46,Main,,0,0,0,,!لا تدعيهنَّ يلحقنَ بنا
Dialogue: 10,0:09:07.17,0:09:10.42,Main,,0,0,0,,!يا إلهي، يا لهنَّ من قطيع
Dialogue: 10,0:09:10.83,0:09:12.38,Main,,0,0,0,,!قلّ عددهنَّ
Dialogue: 10,0:09:12.57,0:09:14.29,Main,,0,0,0,,!كلّه بفضل توبيرا-سان
Dialogue: 10,0:09:14.98,0:09:16.42,Main,,0,0,0,,لنبدأ نحن أيضًا
Dialogue: 10,0:09:25.54,0:09:27.88,Main,,0,0,0,,جيّد، أُخليتْ جميع السيّارات أيضًا
Dialogue: 10,0:09:27.88,0:09:28.96,Main,,0,0,0,,أنزلينا
Dialogue: 10,0:09:28.96,0:09:29.92,Main,,0,0,0,,حاضر
Dialogue: 10,0:09:35.17,0:09:36.58,Main,,0,0,0,,عددهم كبير
Dialogue: 10,0:09:37.63,0:09:39.38,Main,,0,0,0,,وفّري لي بعض الوقت
Dialogue: 10,0:09:39.38,0:09:40.83,Main,,0,0,0,,عُلم
Dialogue: 10,0:09:43.83,0:09:46.42,Main,,0,0,0,,ها نحنُ ذي!
Dialogue: 10,0:09:54.57,0:09:57.18,Spells,,0,0,0,,الكيان الأسمى: قوةٌ خفيّة تتجلّى على هيئة يدٍ غير مرئية تتحكّم بها مايا بحرية؛ يسعها إخفائها وتقييد الخصوم أو إيقافهم عن الحركة أو إعادة تشكيلها باستخدام عناصر الطبيعة
Dialogue: 10,0:09:54.57,0:09:55.88,Main,,0,0,0,,!الكيان الأسمى
Dialogue: 10,0:10:05.58,0:10:07.25,Main,,0,0,0,,...رصاصٌ من ريش
Dialogue: 10,0:10:07.40,0:10:08.71,Main,,0,0,0,,إنّه قويّ
Dialogue: 10,0:10:09.29,0:10:11.54,Main,,0,0,0,,...حطّم اليد إلى أشلاء في ثوانٍ
Dialogue: 10,0:10:13.96,0:10:14.96,Main,,0,0,0,,...في هذه الحالة
Dialogue: 10,0:10:19.96,0:10:23.88,Main,,0,0,0,,!سأواصل استدعاء أيدٍ جديدة لتكون بمثابة درعٍ
Dialogue: 10,0:10:26.66,0:10:29.79,Main,,0,0,0,,!لنرى إلى متى ستصمدين، أتحرّق شوقًا لمعرفة ذلك
Dialogue: 10,0:10:42.00,0:10:44.21,Main,,0,0,0,,هل اكتمل العقاب الإلهيّ يا ترى؟
Dialogue: 10,0:11:05.33,0:11:06.83,Main,,0,0,0,,!أنتِ عنيدةٌ بحقّ
Dialogue: 10,0:11:07.69,0:11:09.96,Main,,0,0,0,,لكنّكِ منهكةٌ بالفعل
Dialogue: 10,0:11:10.24,0:11:12.25,Main,,0,0,0,,!لنُنهِ الأمر بعشر ثوانٍ أخرى
Dialogue: 10,0:11:12.32,0:11:15.46,Main,,0,0,0,,!حان الوقت لأذيقها مرارة العقاب الإلهيّ
Dialogue: 10,0:11:16.28,0:11:17.38,Main,,0,0,0,,ما رأيكنّ؟
Dialogue: 10,0:11:17.67,0:11:20.13,Main,,0,0,0,,!مُوافقات
Dialogue: 10,0:11:22.88,0:11:24.54,Main,,0,0,0,,هذا يكفي يا مايا
Dialogue: 10,0:11:26.31,0:11:27.92,Main,,0,0,0,,باتَ بإمكاني الامتصاص الآن
Dialogue: 10,0:11:32.92,0:11:34.13,Spells,,0,0,0,,الزائل: قدرة على امتصاص الطاقة الحيوية للكائنات والتحكّم بتدفّقها؛ مما يمكّنها من تسريع عمر الكائنات الحيّة أو إرجاعه سواءً لنفسها أو لغيرها
Dialogue: 10,0:11:32.92,0:11:34.13,Main,,0,0,0,,!الزائل
Dialogue: 10,0:11:52.25,0:11:55.92,Main,,0,0,0,,ما الّذي... فعلتِه؟
Dialogue: 10,0:11:56.54,0:11:59.13,Main,,0,0,0,,سلبتُ طاقة حياتكِ
Dialogue: 10,0:12:04.75,0:12:07.08,Main,,0,0,0,,!الزائل؛ من مسافة صفر
Dialogue: 10,0:12:18.25,0:12:20.54,Main,,0,0,0,,عملٌ ممتازٌ يا توبيرا-ساما
Dialogue: 10,0:12:21.38,0:12:23.83,Main,,0,0,0,,أحييكِ على ثباتكِ يا مايا
Dialogue: 10,0:12:28.54,0:12:31.63,Main,,0,0,0,,!أشعر وكأنَّ حواسّي عادتْ إلى أوجها مجدّدًا
Dialogue: 10,0:12:33.88,0:12:34.88,Main,,0,0,0,,!رين-ساما
Dialogue: 10,0:12:34.88,0:12:39.21,Main,,0,0,0,,وفقًا للتقرير الّذي تلقّيناه، نجحنا في تفريق قوّات العدوّ
Dialogue: 10,0:12:40.24,0:12:43.04,Main,,0,0,0,,...ومع ذلك، الوضع في يوكوهاما
Dialogue: 10,0:12:43.32,0:12:44.67,Main,,0,0,0,,أدرك ذلك
Dialogue: 10,0:12:47.42,0:12:51.29,Main,,0,0,0,,سأشارك في القتال من واشنطن باستخدام قدرتي
Dialogue: 10,0:13:10.58,0:13:12.58,Main,,0,0,0,,:قدرة رين
Dialogue: 10,0:13:12.58,0:13:24.29,Spells,,0,0,0,,وحدةُ كلِّ ما في الكون اللامتناهي؛ قدرة بوذية متعددة حسب الماندالا الّتي تظهر على حدقتي عينيها\Nالماندالا = تجسيد بصري لقوة كونية أو قانون من قوانين الوجود
Dialogue: 10,0:13:12.58,0:13:16.38,Main,,0,0,0,,وحدةُ كلِّ ما في الكون اللامتناهي
Dialogue: 10,0:13:19.33,0:13:24.29,Main,,0,0,0,,تعزّز قوّتها بعكس القدرة ذاتها في كلتا عينيها
Dialogue: 10,0:14:27.54,0:14:31.00,Main,,0,0,0,,ما فعلتِه للتوّ... هل وجّهتِه نحو اليابان؟
Dialogue: 10,0:14:32.63,0:14:36.50,Main,,0,0,0,,لن يصيب أيَّ طائرة، لذا لا تقلقي
Dialogue: 10,0:14:37.38,0:14:42.08,Main,,0,0,0,,استخدمتْ قدرةً بتلك القوّة دون أن تتصبّب عرقًا حتّى
Dialogue: 10,0:14:43.57,0:14:45.67,Main,,0,0,0,,سأترك الباقي لأتباعي
Dialogue: 10,0:14:45.85,0:14:47.42,Main,,0,0,0,,لنكمل اجتماعنا
Dialogue: 10,0:14:48.29,0:14:50.38,Main,,0,0,0,,...ياماشيرو رين
Dialogue: 10,0:14:50.38,0:14:52.92,Main,,0,0,0,,إنّها جواب الأرض بحقّ
Dialogue: 10,0:14:55.88,0:14:57.50,Main,,0,0,0,,!مخرج الطوارئ من هنا
Dialogue: 10,0:14:58.29,0:15:01.29,Main,,0,0,0,,!أرجو إعطاء الأولويّة لحماية الجرحى
Dialogue: 10,0:15:23.30,0:15:24.71,Main,,0,0,0,,!انظروا
Dialogue: 10,0:15:25.21,0:15:28.83,Main,,0,0,0,,ألا يجدر بكم القلق بشأن ذلك الشيء قليلًا؟
Dialogue: 10,0:15:30.58,0:15:34.13,Main,,0,0,0,,إنّه يمتلك قدرةً مرعبة
Dialogue: 10,0:15:38.79,0:15:40.58,Main,,0,0,0,,...كما ترون
Dialogue: 10,0:15:50.83,0:15:52.25,Main,,0,0,0,,إنّها القائدة العليا
Dialogue: 10,0:15:52.97,0:15:55.08,Main,,0,0,0,,وفرتْ لنا دعمًا من الأراضي الأمريكية
Dialogue: 10,0:15:55.32,0:15:56.58,Main,,0,0,0,,كان ضخمًا للغاية
Dialogue: 10,0:15:57.00,0:15:58.38,Main,,0,0,0,,فأصبح هدفًا سهلًا
Dialogue: 10,0:16:05.68,0:16:08.17,Main,,0,0,0,,...كانت تلك ورقتي الرابحة
Dialogue: 10,0:16:09.83,0:16:15.96,Main,,0,0,0,,!كانت الورقة الرابحة الّتي منحتني إيّاها شيكوكو-نيه
Dialogue: 10,0:16:16.46,0:16:17.33,Main,,0,0,0,,!يوكي
Dialogue: 10,0:16:17.33,0:16:18.25,Main,,0,0,0,,!حاضر
Dialogue: 10,0:16:28.13,0:16:29.29,Spells,,0,0,0,,آمي نو ميتوري: طائر السماء المقدّس؛ قدرة تلاعب بالفضاء
Dialogue: 10,0:16:28.13,0:16:29.29,Main,,0,0,0,,طائر السماء المقدّس
Dialogue: 10,0:16:33.79,0:16:35.13,Main,,0,0,0,,!نطاقها واسع
Dialogue: 10,0:16:39.92,0:16:41.17,Main,,0,0,0,,!لا يُعلى عليكِ أبدًا
Dialogue: 10,0:16:41.31,0:16:42.54,Main,,0,0,0,,!تينكا-سان
Dialogue: 10,0:16:49.79,0:16:54.21,Main,,0,0,0,,في خضمّ المعركة، قد تحمل الكلمات الموجزة أعمق المعاني
Dialogue: 10,0:16:55.79,0:16:59.42,Main,,0,0,0,,!وقد وصلتني مشاعر يوكي-كن
Dialogue: 10,0:17:06.33,0:17:08.63,Main,,0,0,0,,نُسخي بطيئة
Dialogue: 10,0:17:08.84,0:17:11.75,Main,,0,0,0,,لعلّي أحتاج إلى التدرّب لإتقانها
Dialogue: 10,0:17:13.50,0:17:15.96,Main,,0,0,0,,...ومع ذلك، جسدي الحقيقيّ
Dialogue: 10,0:17:16.21,0:17:17.67,Main,,0,0,0,,!ليس لقمةً سائغة
Dialogue: 10,0:17:22.13,0:17:25.33,Main,,0,0,0,,!ما الّذي تفعلينه... بأختي؟
Dialogue: 10,0:17:28.33,0:17:31.00,Main,,0,0,0,,!من أين أتتْ هذه القوّة؟
Dialogue: 10,0:17:34.75,0:17:36.38,Main,,0,0,0,,!كانت هذه نسخةً أيضًا
Dialogue: 10,0:17:40.13,0:17:42.46,Main,,0,0,0,,!أنا... هنا
Dialogue: 10,0:17:45.63,0:17:49.71,Main,,0,0,0,,يبدو أنَّ التخلّل أكثر فعاليّةً في القتال من قدرة الهلام
Dialogue: 10,0:17:52.71,0:17:57.58,Main,,0,0,0,,!ما الّذي تفعلينه... بأخي؟
Dialogue: 10,0:18:05.71,0:18:07.25,Main,,0,0,0,,...سأصبُّ
Dialogue: 10,0:18:08.89,0:18:10.25,Main,,0,0,0,,...كلّ قوّتي
Dialogue: 10,0:18:12.13,0:18:14.13,Main,,0,0,0,,!في ضربةٍ واحدة
Dialogue: 10,0:18:48.33,0:18:49.75,Main,,0,0,0,,!أنلتُ منها؟
Dialogue: 10,0:18:57.67,0:19:01.13,Main,,0,0,0,,أنتِ أيضًا بقوّة قائدةٍ إذن
Dialogue: 10,0:19:27.18,0:19:31.00,Main,,0,0,0,,بدأتْ بنصب الفخاخ بإخفاء نسخها تحت الأرض إذن
Dialogue: 10,0:19:41.00,0:19:45.50,Main,,0,0,0,,سأتولّى أمر تعزيزاتكنَّ بعد أن أقضي عليكنَّ
Dialogue: 10,0:19:46.33,0:19:50.08,Main,,0,0,0,,لأنّني أستطيع مواصلة القتال إلى الأبد
Dialogue: 10,0:19:55.42,0:19:56.67,Main,,0,0,0,,...يوكي
Dialogue: 10,0:19:58.04,0:19:59.54,Main,,0,0,0,,فعّل هيئة الاندفاع السماويّ
Dialogue: 10,0:20:00.88,0:20:02.71,Main,,0,0,0,,!أظنّ أنّه خيارنا الوحيد
Dialogue: 10,0:20:05.71,0:20:08.13,Main,,0,0,0,,!احرص على استغلالها إلى أقصى حدّ
Dialogue: 10,0:20:08.30,0:20:09.13,Main,,0,0,0,,!حاضر
Dialogue: 10,0:20:12.50,0:20:15.04,Main,,0,0,0,,هذه ورقتكما الرابحة إذن
Dialogue: 10,0:20:16.25,0:20:17.50,Main,,0,0,0,,يوكي؟
Dialogue: 10,0:20:18.08,0:20:19.21,Main,,0,0,0,,!يوكي-كن
Dialogue: 10,0:20:41.63,0:20:43.13,Main,,0,0,0,,!الاندفاع السماويّ
Dialogue: 10,0:20:44.46,0:20:47.38,Main,,0,0,0,,!ميرا-سان... سأنقذكِ الآن
Dialogue: 10,0:22:26.29,0:22:29.17,Main,,0,0,0,,يا له من تدفّقٍ هائلٍ للقوّة
Dialogue: 10,0:22:30.42,0:22:35.21,Main,,0,0,0,,يبدو أنَّ واكورا يوكي يمتلك إمكاناتٍ هائلةً أيضًا
Dialogue: 10,0:22:35.35,0:22:36.83,Main,,0,0,0,,راق لي
Dialogue: 10,0:22:39.67,0:22:41.67,Main,,0,0,0,,،إن تقاعستْ هيماري
Dialogue: 10,0:22:41.76,0:22:44.50,Main,,0,0,0,,فربّما أرسل الأخريات لمساعدتها في الإيقاع به
Dialogue: 10,0:23:10.96,0:23:14.00,Main,,0,0,0,,يسعني تولّي زمام الأمور وتعليمهنَّ الأساسيّات أولًا
Dialogue: 10,0:23:14.75,0:23:16.42,Main,,0,0,0,,!المزيد من الأعداء في طريقهم إلينا
Dialogue: 10,0:23:17.25,0:23:18.42,Main,,0,0,0,,!أعلم ذلك
Dialogue: 10,0:23:20.42,0:23:21.67,Main,,0,0,0,,!لنفعلها
Dialogue: 10,0:23:21.93,0:23:23.42,Main,,0,0,0,,!نحن في المرحلة الحاسمة
Dialogue: 10,0:23:26.54,0:23:30.13,Main,,0,0,0,,"في المرّة القادمة، الحلقة 11: "العبد: السماء
Dialogue: 10,0:23:30.42,0:23:31.63,Main,,0,0,0,,وإليكم مكافأة اليوم
Dialogue: 10,0:23:32.04,0:23:34.79,Main,,0,0,0,,الهديّة... هي... أنا
Dialogue: 10,0:23:35.67,0:23:37.54,Main,,0,0,0,,!لطالما أردتُ تجربة هذا
Dialogue: 10,0:23:37.74,0:23:40.02,Main,,0,0,0,,!آمل أن تُقبِّلني أنا والشوكولاتة
Comment: 0,0:23:40.04,0:23:42.04,Signs,,0,0,0,,
Dialogue: 10,0:20:41.63,0:20:43.13,Note,,0,0,0,,‫الاندفاع السماويّ؛ هيئة متطوّرة من "الزوبعة"، تمنح تعزيزات أكبر من الهيئة الأصليّة، غير أنَّ استخدامها يستهلك طاقة أكبر ممّا يجعله يعود إلى هيئة "الزوبعة" المعتادة بعد فترة
Comment: 0,0:23:40.04,0:23:42.04,Signs,,0,0,0,,
