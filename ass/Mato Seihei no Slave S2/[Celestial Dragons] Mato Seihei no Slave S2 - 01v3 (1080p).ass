Dialogue: 10,0:00:04.62,0:00:06.45,Main,,0,0,0,,من قوات ردع الشياطين إلى الفرقة السادسة
Dialogue: 10,0:00:06.87,0:00:10.01,Main,,0,0,0,,فُتح الممرّ في سابورو عبر النقطة 682
Dialogue: 10,0:00:10.58,0:00:13.14,Main,,0,0,0,,مصير العديد من المواطنين مجهول
Dialogue: 10,0:00:13.83,0:00:15.38,Main,,0,0,0,,عُلم من الفرقة السادسة
Dialogue: 10,0:00:15.87,0:00:17.81,Main,,0,0,0,,سنرسل فرقة بحث إلى ماتو
Dialogue: 10,0:00:18.08,0:00:19.51,Main,,0,0,0,,عُلم أيّها المقرّ
Dialogue: 10,0:00:19.81,0:00:21.51,Main,,0,0,0,,أعداد الشوكي في ازدياد
Dialogue: 10,0:00:21.60,0:00:23.06,Main,,0,0,0,,توخّوا الحذر رجاءً
Dialogue: 10,0:00:41.14,0:00:42.23,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:00:42.52,0:00:44.70,Main,,0,0,0,,!لنجعله يومًا مثمرًا آخر
Dialogue: 10,0:00:51.56,0:00:52.44,Main,,0,0,0,,!يوكي
Dialogue: 10,0:00:52.89,0:00:54.64,Main,,0,0,0,,تولّ أمر الغسيل
Dialogue: 10,0:00:57.68,0:00:59.02,Main,,0,0,0,,والفطور أيضًا
Dialogue: 10,0:01:00.01,0:01:01.81,Main,,0,0,0,,!أريد "شيو رامن" هذا الصباح
Dialogue: 10,0:01:09.35,0:01:10.39,Main,,0,0,0,,!يوكي-سان
Dialogue: 10,0:01:11.14,0:01:12.98,Main,,0,0,0,,ما الأمر يا ناي-تشان؟
Dialogue: 10,0:01:13.31,0:01:16.27,Main,,0,0,0,,أتساعدني في جرد المؤن؟
Dialogue: 10,0:01:17.31,0:01:19.52,Main,,0,0,0,,يبدو أنّه لم يتبقَ سوى زجاجتي صلصة صويا
Dialogue: 10,0:01:20.10,0:01:22.18,Main,,0,0,0,,...زجاجتان
Dialogue: 10,0:01:22.18,0:01:23.56,Main,,0,0,0,,!يوكي
Dialogue: 10,0:01:25.06,0:01:27.43,Main,,0,0,0,,!مستعدة للتدليك
Dialogue: 10,0:01:27.43,0:01:28.85,Main,,0,0,0,,!حاضر
Dialogue: 10,0:01:31.23,0:01:34.85,Main,,0,0,0,,!يوكي، أنتَ بارع في التدليك
Dialogue: 10,0:01:34.85,0:01:38.85,Main,,0,0,0,,!شوشو-تشان، لِمَ أنتِ بهيئتكِ العملاقة؟
Dialogue: 10,0:01:39.15,0:01:40.65,Main,,0,0,0,,...لأنَّ
Dialogue: 10,0:01:41.23,0:01:44.93,Main,,0,0,0,,الضغط على نقاطي الحيوية أسهل هكذا
Dialogue: 10,0:01:45.93,0:01:47.10,Main,,0,0,0,,!يوكي
Dialogue: 10,0:01:47.10,0:01:49.98,Main,,0,0,0,,!اختلطتْ ملابس شوشو الداخلية مع ملابسي
Dialogue: 10,0:01:51.43,0:01:52.89,Main,,0,0,0,,آسف يا هيماري
Dialogue: 10,0:01:53.00,0:01:56.49,Main,,0,0,0,,هذا لا يجوز يا يوكي، عليك توخّي الحذر أكثر
Dialogue: 10,0:01:56.53,0:01:57.55,Main,,0,0,0,,مهلًا مهلًا
Dialogue: 10,0:01:57.56,0:01:59.98,Main,,0,0,0,,...يتطلب ذلك القدرة على التمييز بينهما
Dialogue: 10,0:02:00.56,0:02:02.10,Main,,0,0,0,,!يوكي-سان
Dialogue: 10,0:02:03.07,0:02:04.10,Main,,0,0,0,,واجبكِ المدرسي؟
Dialogue: 10,0:02:04.14,0:02:05.82,Main,,0,0,0,,أثمة جزء استعصى عليكِ؟
Dialogue: 10,0:02:06.03,0:02:09.75,Main,,0,0,0,,أجل، لكنّك تبدو مشغولًا الآن
Dialogue: 10,0:02:06.88,0:02:08.10,Top,,0,0,0,,...أجل، هناك هناك
Dialogue: 10,0:02:09.93,0:02:11.06,Main,,0,0,0,,لا بأس
Dialogue: 10,0:02:11.23,0:02:13.02,Main,,0,0,0,,أتمانعين الانتظار قليلًا؟
Dialogue: 10,0:02:14.48,0:02:16.14,Main,,0,0,0,,واكورا يوكي
Dialogue: 10,0:02:17.54,0:02:21.74,Main,,0,0,0,,الفتى الوحيد في قوات ردع الشياطين المكوّنة من الإناث فحسب
Dialogue: 10,0:02:23.68,0:02:24.68,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:02:25.68,0:02:27.93,Main,,0,0,0,,كيوكا-سان، أعتذر عن التأخير
Dialogue: 10,0:02:28.31,0:02:29.14,Main,,0,0,0,,لا
Dialogue: 10,0:02:30.87,0:02:31.71,Main,,0,0,0,,لا بأس
Dialogue: 10,0:02:32.61,0:02:34.92,Main,,0,0,0,,وجدتُ بعض الشوكي فأخضعتهم
Dialogue: 10,0:02:36.03,0:02:40.20,Main,,0,0,0,,قائدة الفرقة السابعة؛ أوزين كيوكا
Dialogue: 10,0:02:41.18,0:02:43.14,Main,,0,0,0,,لنبدأ التدريب فورًا
Dialogue: 10,0:02:43.14,0:02:44.14,Main,,0,0,0,,!حاضر
Dialogue: 10,0:02:46.27,0:02:47.48,Main,,0,0,0,,!إنذار طوارئ
Dialogue: 10,0:02:48.48,0:02:49.52,Main,,0,0,0,,!أيّتها القائدة
Dialogue: 10,0:02:49.64,0:02:50.98,Main,,0,0,0,,وقعت كارثة مجدّدًا
Dialogue: 10,0:02:51.14,0:02:53.77,Main,,0,0,0,,علق 8 مدنيين في ماتو
Dialogue: 10,0:02:54.15,0:02:55.52,Main,,0,0,0,,أمّنّا حماية 6 منهم
Dialogue: 10,0:02:55.52,0:02:57.89,Main,,0,0,0,,ولا يزال البحث جاريًا عن الاثنين الباقيين
Dialogue: 10,0:02:57.89,0:03:00.56,Main,,0,0,0,,!تلقينا طلب دعم من المقرّ
Dialogue: 10,0:03:00.56,0:03:02.73,Main,,0,0,0,,ناي، أيمكنكِ العثور عليهم بقدرتكِ؟
Dialogue: 10,0:03:02.78,0:03:03.53,Main,,0,0,0,,!أجل
Dialogue: 10,0:03:04.18,0:03:05.43,Spells,,0,0,0,,برومِس: وعد؛ قدرة استبصار، إدراك ومراقبة الكيانات والأجسام داخل ماتو دون أن يشعروا بها
Dialogue: 10,0:03:04.18,0:03:05.43,Main,,0,0,0,,وعد
Dialogue: 10,0:03:07.23,0:03:09.48,Main,,0,0,0,,رصدت إشارات حيوية
Dialogue: 10,0:03:11.27,0:03:14.18,Main,,0,0,0,,تأكدت من وجود وكرٍ للشوكي بالجوار
Dialogue: 10,0:03:15.02,0:03:15.81,Main,,0,0,0,,!كيوكا-سان
Dialogue: 10,0:03:15.81,0:03:18.10,Main,,0,0,0,,أرسلي الإحداثيات إلى الفرقة السادسة
Dialogue: 10,0:03:18.10,0:03:19.64,Main,,0,0,0,,!الفرقة السابعة، تحركوا
Dialogue: 10,0:03:19.64,0:03:20.64,Main,,0,0,0,,!حاضر
Dialogue: 10,0:03:20.64,0:03:22.23,Main,,0,0,0,,هل أنتَ مستعد يا يوكي؟
Dialogue: 10,0:03:22.23,0:03:23.48,Main,,0,0,0,,!بالطبع
Dialogue: 10,0:03:26.27,0:03:27.35,Spells,,0,0,0,,سليف: العبد؛ قدرة تسمح لكيوكا باستخدام يوكي واكورا كعبد في القتال
Dialogue: 10,0:03:26.27,0:03:27.35,Main,,0,0,0,,!العبد
Dialogue: 10,0:03:35.02,0:03:35.85,Main,,0,0,0,,!أونيه-تشان
Dialogue: 10,0:03:45.10,0:03:46.02,Main,,0,0,0,,!هيماري
Dialogue: 10,0:03:46.02,0:03:46.89,Main,,0,0,0,,!عُلم
Dialogue: 10,0:03:47.69,0:03:48.64,Spells,,0,0,0,,ليرنينغ: تعلّم؛ قدرة نسخ بركات الخوخ الخاصة بالفتيات الأخريات
Dialogue: 10,0:03:47.69,0:03:48.64,Main,,0,0,0,,!تعلّم
Dialogue: 10,0:03:49.04,0:03:50.19,Spells,,0,0,0,,بانغ بانغ بانغ: الفتاة المسلحة؛ بركة خوخ ساكي توكوياما من الوحدة الخامسة
Dialogue: 10,0:03:49.04,0:03:50.19,Main,,0,0,0,,!بانغ بانغ بانغ
Dialogue: 10,0:03:55.31,0:03:57.56,Main,,0,0,0,,نحن قوات ردع الشياطين، أنتما في أمان الآن
Dialogue: 10,0:03:58.60,0:03:59.64,Main,,0,0,0,,!شوشو
Dialogue: 10,0:03:59.64,0:04:01.02,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:04:01.18,0:04:03.06,Spells,,0,0,0,,بارادايم شيفت: التحرّر الإمبراطوري؛ سيطرة مطلقة على حجم الجسد
Dialogue: 10,0:04:01.18,0:04:03.06,Main,,0,0,0,,!التحرّر الإمبراطوري
Dialogue: 10,0:04:10.42,0:04:11.38,Main,,0,0,0,,!أسرعا بالركوب
Dialogue: 10,0:04:11.98,0:04:12.85,Main,,0,0,0,,!حاضر
Dialogue: 10,0:04:16.38,0:04:17.60,Main,,0,0,0,,!اثنان إذن
Dialogue: 10,0:04:18.77,0:04:20.56,Main,,0,0,0,,!لا بأس، تعاليا
Dialogue: 10,0:04:27.77,0:04:28.85,Main,,0,0,0,,!انتبهي
Dialogue: 10,0:04:31.85,0:04:33.14,Main,,0,0,0,,!يوكي
Dialogue: 10,0:04:35.85,0:04:36.89,Main,,0,0,0,,!كيوكا-سان
Dialogue: 10,0:04:37.69,0:04:40.43,Spells,,0,0,0,,ميداري يامازاكورا: أزهار الكرز العاصفة؛ وابل من الضربات بالسيف
Dialogue: 10,0:04:37.69,0:04:40.43,Main,,0,0,0,,!أزهار الكرز العاصفة
Dialogue: 10,0:04:48.23,0:04:49.89,Main,,0,0,0,,!كما هو متوقع من القائدة
Dialogue: 10,0:04:49.89,0:04:51.98,Main,,0,0,0,,!شكرًا يا يوكي
Dialogue: 10,0:04:53.31,0:04:54.93,Main,,0,0,0,,توخّوا الحذر
Dialogue: 10,0:04:55.52,0:04:57.81,Main,,0,0,0,,ألتقط إشارةً قويّةً بالجوار
Dialogue: 10,0:04:58.02,0:04:59.23,Main,,0,0,0,,!إنّه شوكي من نوع خاص
Dialogue: 10,0:05:01.06,0:05:02.95,Spells,,0,0,0,,غولدن آور: الساعة الذهبية؛ قدرة تحكم بالزمن لفترات قصيرة
Dialogue: 10,0:05:01.06,0:05:02.95,Main,,0,0,0,,!الساعة الذهبية
Dialogue: 10,0:05:03.81,0:05:05.18,Main,,0,0,0,,!حسبكِ
Dialogue: 10,0:05:05.18,0:05:08.73,Main,,0,0,0,,وجود أخت صغرى عديمة النفع أمر مزعج حقًّا
Dialogue: 10,0:05:09.43,0:05:11.31,Main,,0,0,0,,أليس كذلك يا هيماري؟
Dialogue: 10,0:05:11.31,0:05:12.60,Main,,0,0,0,,!ياتشيهو
Dialogue: 10,0:05:16.73,0:05:19.35,Main,,0,0,0,,أقدر دعمك أيّتها القائدة أوزين
Dialogue: 10,0:05:19.35,0:05:22.02,Main,,0,0,0,,!ستتولى الفرقة السادسة الأمر من هنا
Dialogue: 10,0:05:23.23,0:05:25.43,Spells,,0,0,0,,كريزي شيب: الخروف المجنون؛ قدرة تعزيز مؤقتة
Dialogue: 10,0:05:23.23,0:05:25.43,Main,,0,0,0,,!الخروف المجنون
Dialogue: 10,0:05:25.43,0:05:26.35,Main,,0,0,0,,!ثلاثة
Dialogue: 10,0:05:30.39,0:05:33.68,Main,,0,0,0,,!أيّتها القائدة
Dialogue: 10,0:05:35.56,0:05:37.18,Main,,0,0,0,,أحسنتِ يا ساهارا
Dialogue: 10,0:05:39.18,0:05:40.39,Spells,,0,0,0,,آمي نو ميتوري: طائر السماء المقدّس؛ قدرة تلاعب بالفضاء
Dialogue: 10,0:05:39.18,0:05:40.39,Main,,0,0,0,,طائر السماء المقدّس
Dialogue: 10,0:05:43.68,0:05:45.43,Main,,0,0,0,,!كما هو متوقع من تينكا-سان
Dialogue: 10,0:05:53.48,0:05:54.52,Main,,0,0,0,,يوكي؟
Dialogue: 10,0:05:54.61,0:05:55.68,Main,,0,0,0,,...وأنا أيضًا
Dialogue: 10,0:05:56.40,0:05:59.35,Main,,0,0,0,,...لإنقاذ أختي
Dialogue: 10,0:06:00.10,0:06:01.85,Main,,0,0,0,,!دعيني أتولى الأمر
Dialogue: 10,0:06:02.23,0:06:04.18,Main,,0,0,0,,!لا خيار أمامي سوى أن أصبح أقوى
Dialogue: 10,0:06:05.14,0:06:08.14,Main,,0,0,0,,!أرني ثمار تدريبك إذن يا يوكي
Dialogue: 10,0:06:08.14,0:06:09.02,Main,,0,0,0,,!حاضر
Dialogue: 10,0:06:32.81,0:06:33.89,Main,,0,0,0,,...هذا
Dialogue: 10,0:06:40.64,0:06:42.31,Main,,0,0,0,,!حان وقت الإخضاع
Dialogue: 10,0:06:56.35,0:06:59.18,Main,,0,0,0,,يوكي-كن رائع كما توقعت
Dialogue: 10,0:06:59.26,0:07:01.35,Main,,0,0,0,,يزداد حبّي له أكثر فأكثر
Dialogue: 10,0:07:06.81,0:07:10.68,Main,,0,0,0,,لا بدّ أنَّ هذه قدرة الاستعباد المُشاع عنها
Dialogue: 10,0:08:43.93,0:08:47.85,Main,,0,0,0,,عاد جميع المدنيين الّذين أنقذناهم إلى العالم الحقيقي بسلام
Dialogue: 10,0:08:48.10,0:08:51.35,Main,,0,0,0,,لا توجد إصابات خطيرة أو مضاعفات تدعو للقلق
Dialogue: 10,0:08:51.64,0:08:53.39,Main,,0,0,0,,!هذا مطمئن
Dialogue: 10,0:08:54.23,0:08:56.68,Main,,0,0,0,,أجل، وأنتَ أبليت حسنًا هناك
Dialogue: 10,0:08:56.68,0:09:00.68,Main,,0,0,0,,ولكن لِمَ ترغب في مكافآت كهذه دائمًا؟
Dialogue: 10,0:09:00.68,0:09:02.85,Main,,0,0,0,,!ليس وكأنّني أرغب في هذا
Dialogue: 10,0:09:03.23,0:09:05.27,Main,,0,0,0,,،حين كنتُ أستعبد الشوكي
Dialogue: 10,0:09:05.42,0:09:07.98,Main,,0,0,0,,كان لحم الخنزير يكفيهم
Dialogue: 10,0:09:11.39,0:09:15.18,Main,,0,0,0,,ولكن مُنذ استعبادك، لا تطلب سوى هذه الأمور
Dialogue: 10,0:09:15.25,0:09:16.11,Main,,0,0,0,,!منحرف
Dialogue: 10,0:09:16.14,0:09:17.60,Main,,0,0,0,,!آ-آسف
Dialogue: 10,0:09:18.23,0:09:21.68,Main,,0,0,0,,لكنّنا كسبنا الكثير، وهذه حقيقة
Dialogue: 10,0:09:22.09,0:09:23.31,Spells,,0,0,0,,سليف: العبد؛ قدرة تسمح لكيوكا باستخدام يوكي واكورا كعبد في القتال
Dialogue: 10,0:09:22.09,0:09:23.31,Main,,0,0,0,,..."قدرتي "العبد
Dialogue: 10,0:09:23.45,0:09:27.10,Main,,0,0,0,,لا تقتصر على استعباد الهدف فحسب على ما يبدو
Dialogue: 10,0:09:27.52,0:09:31.06,Main,,0,0,0,,كلّما ازدادت قوّتكَ يا يوكي، اتسع نطاق استراتيجيّاتنا
Dialogue: 10,0:09:31.43,0:09:33.31,Main,,0,0,0,,،ظننتها قدرةً رديئة
Dialogue: 10,0:09:33.52,0:09:36.35,Main,,0,0,0,,لكن بوجودكَ معي، قد أظفر بمنصب القائدة العليا
Dialogue: 10,0:09:36.99,0:09:39.48,Main,,0,0,0,,...إن أصبحتِ القائدة العليا
Dialogue: 10,0:09:39.48,0:09:40.68,Main,,0,0,0,,أجل
Dialogue: 10,0:09:41.56,0:09:44.56,Main,,0,0,0,,سأتمكن من إعادة هيكلة قوات ردع الشياطين
Dialogue: 10,0:09:44.63,0:09:46.98,Main,,0,0,0,,وكشف أسرار مكتب أونميوريو
Dialogue: 10,0:09:47.09,0:09:48.85,Main,,0,0,0,,!حينها يمكننا مساعدة أختي
Dialogue: 10,0:09:49.00,0:09:49.68,Main,,0,0,0,,أجل
Dialogue: 10,0:09:49.81,0:09:53.93,Main,,0,0,0,,وإيجاد طريقة لإعادة البشر الّذين تحولوا إلى شوكي لطبيعتهم
Dialogue: 10,0:09:54.31,0:09:58.06,Main,,0,0,0,,!في هذه الحالة، عليّ بذل قصارى جهدي لتحقيق ذلك
Dialogue: 10,0:09:58.73,0:10:01.98,Main,,0,0,0,,!لأجل أختي، ولأجل كيوكا-سان
Dialogue: 10,0:10:02.48,0:10:05.93,Main,,0,0,0,,!كيوكا-سان! سأساعدكِ بكلّ ما أوتيت من قوة
Dialogue: 10,0:10:08.67,0:10:10.81,Main,,0,0,0,,!هذه الروح المطلوبة يا يوكي
Dialogue: 10,0:10:12.64,0:10:15.73,Main,,0,0,0,,فهمت، يوكي يبلي حسنًا إذن
Dialogue: 10,0:10:15.73,0:10:16.68,Main,,0,0,0,,أجل
Dialogue: 10,0:10:16.96,0:10:19.31,Main,,0,0,0,,يتقنُ عملهُ كمدبّرٍ منزليّ
Dialogue: 10,0:10:19.73,0:10:21.23,Main,,0,0,0,,،أما عن براعته القتالية
Dialogue: 10,0:10:21.23,0:10:23.93,Main,,0,0,0,,صار أشدّ بأسًا ممّا كان عليه حين التقينا
Dialogue: 10,0:10:23.93,0:10:25.31,Main,,0,0,0,,!وجبات خفيفة
Dialogue: 10,0:10:25.73,0:10:27.23,Main,,0,0,0,,ماذا نقول؟
Dialogue: 10,0:10:27.23,0:10:28.68,Main,,0,0,0,,!شكرًا لكِ
Dialogue: 10,0:10:29.56,0:10:32.56,Main,,0,0,0,,الفتيان الّذين يبذلون جهدهم رائعون حقًّا
Dialogue: 10,0:10:34.10,0:10:36.98,Main,,0,0,0,,!أخي رائع مُنذ صِغره
Dialogue: 10,0:10:36.98,0:10:39.18,Main,,0,0,0,,وأنا ممتنة لكِ أيضًا
Dialogue: 10,0:10:39.83,0:10:41.23,Main,,0,0,0,,،كونكِ جزءًا من قوات ردع الشياطين
Dialogue: 10,0:10:41.23,0:10:44.42,Main,,0,0,0,,أراهن أنّكِ تبذلين جهودًا مضنيةً للحفاظ على سلامتنا
Dialogue: 10,0:10:44.42,0:10:46.14,Main,,0,0,0,,لا داعي لشكري
Dialogue: 10,0:10:46.81,0:10:48.56,Main,,0,0,0,,ومع ذلك، أنا ممتنة لكِ
Dialogue: 10,0:10:50.52,0:10:51.81,Main,,0,0,0,,...أونيه-سان
Dialogue: 10,0:10:51.81,0:10:54.52,Main,,0,0,0,,سنصبح عائلةً يومًا ما في النهاية
Dialogue: 10,0:10:57.81,0:10:59.48,Main,,0,0,0,,يجدر بي العودة
Dialogue: 10,0:10:59.81,0:11:01.68,Main,,0,0,0,,لديّ الكثير لأفعله قبل الاجتماع
Dialogue: 10,0:11:01.68,0:11:02.81,Main,,0,0,0,,اجتماع؟
Dialogue: 10,0:11:02.81,0:11:03.77,Main,,0,0,0,,أجل
Dialogue: 10,0:11:03.77,0:11:05.89,Main,,0,0,0,,سيُعقد اجتماع لقادة الفِرق
Dialogue: 10,0:11:06.18,0:11:08.02,Main,,0,0,0,,بخصوص الآلهة
Dialogue: 10,0:11:08.02,0:11:09.27,Main,,0,0,0,,...الآلهة
Dialogue: 10,0:11:09.45,0:11:12.35,Main,,0,0,0,,أولئكَ الأوغاد الّذين اختطفوا ناون وكوكو
Dialogue: 10,0:11:12.60,0:11:13.77,Main,,0,0,0,,،لسبب ما
Dialogue: 10,0:11:13.77,0:11:17.68,Main,,0,0,0,,يبدو أنَّ يوكي-كن تلقى استدعاءً من القائدة العليا أيضًا
Comment: 10,0:11:17.80,0:11:18.64,Main,,0,0,0,,
Dialogue: 10,0:11:20.43,0:11:22.35,Main,,0,0,0,,هذا مقرّ الفرقة العاشرة إذن
Dialogue: 10,0:11:22.35,0:11:24.93,Main,,0,0,0,,والمقرّ الرئيسي لقوات ردع الشياطين
Dialogue: 10,0:11:25.27,0:11:27.31,Main,,0,0,0,,لِمَ تريد القائدة العليا رؤيتي؟
Dialogue: 10,0:11:27.31,0:11:28.48,Main,,0,0,0,,لا أعلم
Dialogue: 10,0:11:29.10,0:11:31.35,Main,,0,0,0,,لكن سأحذرك من أمر واحد
Dialogue: 10,0:11:32.60,0:11:35.48,Main,,0,0,0,,لا تنظر في عيني القائدة العليا ياماشيرو
Dialogue: 10,0:11:35.48,0:11:37.85,Main,,0,0,0,,هل لقُدرتِها علاقة بذلك؟
Dialogue: 10,0:11:37.85,0:11:39.10,Main,,0,0,0,,ليس كذلك
Dialogue: 10,0:11:39.10,0:11:40.98,Main,,0,0,0,,ستقع في ورطة إن نِلْتَ إعجابها
Dialogue: 10,0:11:43.56,0:11:45.31,Main,,0,0,0,,!مرحبًا يا كيوكا
Dialogue: 10,0:11:45.81,0:11:47.14,Main,,0,0,0,,تأخرتِ
Dialogue: 10,0:11:47.48,0:11:48.52,Main,,0,0,0,,ميرا
Dialogue: 10,0:11:49.47,0:11:52.17,Main,,0,0,0,,!سمعتُ أنّكِ انتقمتِ لمسقطِ رأسكِ
Dialogue: 10,0:11:52.39,0:11:54.06,Main,,0,0,0,,مبارك لكِ
Dialogue: 10,0:11:54.06,0:11:55.81,Main,,0,0,0,,...ولكن لا تنسي
Dialogue: 10,0:11:55.98,0:11:58.56,Main,,0,0,0,,أنا أقوى منكِ بكثير
Dialogue: 10,0:11:58.56,0:12:01.06,Main,,0,0,0,,!القائدة العليا التالية ستكون أنا
Dialogue: 10,0:12:01.06,0:12:02.06,Main,,0,0,0,,أنتِ مخطئة
Dialogue: 10,0:12:02.06,0:12:04.43,Main,,0,0,0,,بل أنا من ستكون القائدة العليا التالية
Dialogue: 10,0:12:07.78,0:12:09.73,Main,,0,0,0,,أنتَ أيّها العبد الّذي كَثُرتْ حوله الأقاويل
Dialogue: 10,0:12:10.23,0:12:12.73,Main,,0,0,0,,...أنتَ ميتٌ لا محالة
Dialogue: 10,0:12:13.77,0:12:16.27,Main,,0,0,0,,!رباط حذائكَ مفكوكٌ
Dialogue: 10,0:12:17.35,0:12:20.48,Main,,0,0,0,,الغفلة البسيطة في ماتو قد تجلب خطرًا جسيمًا
Dialogue: 10,0:12:22.81,0:12:23.93,Main,,0,0,0,,!كن يقظًا
Dialogue: 10,0:12:23.93,0:12:25.56,Main,,0,0,0,,!شـ-شكرًا جزيلًا لكِ
Dialogue: 10,0:12:25.66,0:12:26.60,Main,,0,0,0,,العفو
Dialogue: 10,0:12:27.77,0:12:29.52,Main,,0,0,0,,سأسبقكما
Dialogue: 10,0:12:30.27,0:12:32.89,Main,,0,0,0,,!آمل أن تكون بقية ملابسي مرتبة
Dialogue: 10,0:12:32.89,0:12:34.73,Main,,0,0,0,,أكانت تنتظر وصولنا؟
Dialogue: 10,0:12:38.77,0:12:39.64,Main,,0,0,0,,بيل
Dialogue: 10,0:12:41.35,0:12:43.68,Main,,0,0,0,,...الـ-القائدة أوزين
Dialogue: 10,0:12:43.98,0:12:45.85,Main,,0,0,0,,ألن تصعدي إلى قاعة الاجتماعات؟
Dialogue: 10,0:12:46.75,0:12:48.31,Main,,0,0,0,,...لـ-لكن
Dialogue: 10,0:12:48.89,0:12:52.89,Main,,0,0,0,,،تعرضت الفرقة الثالثة لهزيمة نكراء على يد العدو
Dialogue: 10,0:12:52.89,0:12:55.73,Main,,0,0,0,,!ولم نحقّق أيّ إنجاز
Dialogue: 10,0:12:56.44,0:12:59.85,Main,,0,0,0,,!أعرف أنَّ القائدة العليا ستسخر منّي في الاجتماع
Dialogue: 10,0:12:59.85,0:13:01.68,Main,,0,0,0,,!أشعر بألم في معدتي الآن
Dialogue: 10,0:13:02.23,0:13:04.90,Spells,,0,0,0,,كانوبس: النجم العظيم؛ قدرة على عزل وانتزاع الحياة من الأشياء المادية
Dialogue: 10,0:13:02.23,0:13:04.90,Main,,0,0,0,,قدرتكِ "النجم العظيم" مذهلة حقًّا
Dialogue: 10,0:13:04.91,0:13:06.06,Main,,0,0,0,,تحلّي ببعض الثّقة
Dialogue: 10,0:13:07.35,0:13:09.64,Main,,0,0,0,,أظن أنَّ قائدات مثلها موجودات أيضًا
Dialogue: 10,0:13:12.89,0:13:13.93,Main,,0,0,0,,أهلًا
Dialogue: 10,0:13:14.89,0:13:15.68,Main,,0,0,0,,كيف الحال؟
Dialogue: 10,0:13:15.68,0:13:16.89,Main,,0,0,0,,!مرحبًا
Dialogue: 10,0:13:21.06,0:13:23.60,Main,,0,0,0,,!هؤلاء هنَّ قائدات قوات ردع الشياطين
Dialogue: 10,0:13:24.56,0:13:25.77,Main,,0,0,0,,إنّها قادمة
Dialogue: 10,0:13:30.31,0:13:32.02,Main,,0,0,0,,...القائدة العليا
Dialogue: 10,0:13:32.59,0:13:33.81,Main,,0,0,0,,ياماشيرو رين
Dialogue: 10,0:13:36.43,0:13:39.48,Main,,0,0,0,,...قيل لي ألّا أنظر في عينيها، ولكن
Dialogue: 10,0:13:39.59,0:13:41.39,Main,,0,0,0,,سأختلس النظر قليلًا فحسب
Dialogue: 10,0:13:48.13,0:13:50.56,Main,,0,0,0,,يسعدني رؤيتكنَّ جميعًا
Dialogue: 10,0:13:50.56,0:13:51.60,Main,,0,0,0,,...والآن
Dialogue: 10,0:13:53.56,0:13:55.85,Main,,0,0,0,,لنبدأ اجتماع القائِدات
Dialogue: 10,0:14:01.53,0:14:04.06,Main,,0,0,0,,أولًا، لنبدأ بشؤون الفرقة الأولى
Dialogue: 10,0:14:04.47,0:14:06.73,Main,,0,0,0,,أعلن بموجب هذا تسليم الشعلة للجيل الجديد
Dialogue: 10,0:14:06.98,0:14:09.27,Main,,0,0,0,,سأتنحى عن منصبي كنائبة للقائدة
Dialogue: 10,0:14:09.89,0:14:12.39,Main,,0,0,0,,!لا يزال بإمكانكِ القتال يا ريو-سان
Dialogue: 10,0:14:12.64,0:14:14.23,Main,,0,0,0,,العمل في قوات ردع الشياطين شاقٌ
Dialogue: 10,0:14:14.43,0:14:17.23,Main,,0,0,0,,من الأفضل أن تتولّى الشابّات القيادة
Dialogue: 10,0:14:18.89,0:14:21.18,Main,,0,0,0,,أَلْقِ التحيّةَ على الجميع
Dialogue: 10,0:14:21.81,0:14:24.02,Main,,0,0,0,,!مرحبًا، أنا تاتارا كونومي
Dialogue: 10,0:14:24.10,0:14:27.47,Main,,0,0,0,,!ما زلت طالبة ثانوية وقليلة الخبرة، لكنّني سأبذل قصارى جهدي
Dialogue: 10,0:14:27.66,0:14:29.31,Main,,0,0,0,,!أرجو أن تعتنوا بي
Dialogue: 10,0:14:29.45,0:14:30.54,Main,,0,0,0,,!طالبة ثانوية؟
Dialogue: 10,0:14:30.77,0:14:34.10,Main,,0,0,0,,إنّها تلميذتي الّتي دربتها بنفسي
Dialogue: 10,0:14:34.23,0:14:37.10,Main,,0,0,0,,أمهلوها بضع سنوات وستغدو مؤهلةً لمنصب القائدة العليا
Dialogue: 10,0:14:37.25,0:14:38.73,Main,,0,0,0,,!أضمن ذلك
Dialogue: 10,0:14:38.83,0:14:41.43,Main,,0,0,0,,يبدو أنّه لا يسعني التهاون بصفتي تلميذتها الأقدم
Dialogue: 10,0:14:41.58,0:14:44.55,Main,,0,0,0,,حسنٌ، أنوي البقاء كقائدة عليا
Dialogue: 10,0:14:44.59,0:14:47.43,Main,,0,0,0,,!كلّا، بل أنا من سأكون القائدة العليا التالية
Dialogue: 10,0:14:47.56,0:14:50.93,Main,,0,0,0,,أظن أنّه يمكنني تولي زمام الأمور أنا أيضًا
Dialogue: 10,0:14:51.73,0:14:55.68,Main,,0,0,0,,لِمَ استدعت القائدة العليا ياماشيرو يوكي-كن يا ترى؟
Dialogue: 10,0:14:55.79,0:14:57.84,Main,,0,0,0,,!أنا من ستصبح القائدة العليا
Dialogue: 10,0:14:57.87,0:15:00.52,Main,,0,0,0,,ستحمل عائلة أزوما اللقب تاليًّا
Dialogue: 10,0:15:04.59,0:15:07.25,Main,,0,0,0,,الجميع مفعمات بالحماس، هذا ممتع حقًّا
Dialogue: 10,0:15:07.31,0:15:08.93,Main,,0,0,0,,تبدو في مزاج جيّد
Dialogue: 10,0:15:09.04,0:15:11.19,Main,,0,0,0,,!آمل ألّا يحدث شيء ما
Dialogue: 10,0:15:11.85,0:15:14.93,Main,,0,0,0,,!الجوّ هادئ لكنّه مخيف
Dialogue: 10,0:15:15.12,0:15:16.52,Main,,0,0,0,,والآن إلى الموضوع الرئيسي
Dialogue: 10,0:15:18.40,0:15:21.39,Main,,0,0,0,,"بخصوص عدوّنا الّذي يلقّب نفسه بـ "آلهة الرعد الثمانية
Dialogue: 10,0:15:22.29,0:15:25.73,Main,,0,0,0,,إنّهم ظرفاء، لكن من المؤسف أنّهم يريدون تدمير البشريّة
Dialogue: 10,0:15:25.80,0:15:29.39,Main,,0,0,0,,أطاحت صاحبة الشعر الأسود بالفرقة الثالثة
Dialogue: 10,0:15:30.06,0:15:33.68,Main,,0,0,0,,وأرسلت مفتولة العضلات هذه الفرقتين السادسة والسابعة إلى المستشفى
Dialogue: 10,0:15:34.39,0:15:37.68,Main,,0,0,0,,أمّا هذه، فقد تولّت تينكا إبادتها شخصيًّا
Dialogue: 10,0:15:38.81,0:15:41.23,Main,,0,0,0,,لا يسعنا الجزم بموتها من عدمه
Dialogue: 10,0:15:41.89,0:15:46.35,Main,,0,0,0,,المهم هو أنَّ القائِدات قادراتٌ على هزيمة الآلهة
Dialogue: 10,0:15:47.01,0:15:49.68,Main,,0,0,0,,إن ظهرت "آلهة الرعد الثمانية"، ستتولى القائدات القتال
Dialogue: 10,0:15:49.91,0:15:51.48,Main,,0,0,0,,احرصنَ على ذلك
Dialogue: 10,0:15:52.43,0:15:55.02,Main,,0,0,0,,!عُلم، سأقضي عليهم
Dialogue: 10,0:15:55.09,0:15:57.18,Main,,0,0,0,,...أحسنتِ، ولكن
Dialogue: 10,0:15:57.25,0:15:59.14,Main,,0,0,0,,ثمّة فرقة تثير قلقي
Dialogue: 10,0:16:00.31,0:16:04.52,Main,,0,0,0,,ضعف الفرقة الثالثة هو مسؤوليتكِ كقائدة يا بيل
Dialogue: 10,0:16:04.52,0:16:06.14,Main,,0,0,0,,!آ-آسفة
Dialogue: 10,0:16:06.42,0:16:09.89,Main,,0,0,0,,لذا سأدربكِ بنفسي لاحقًا
Comment: 10,0:16:10.03,0:16:10.77,Main,,0,0,0,,
Dialogue: 10,0:16:10.99,0:16:12.06,Main,,0,0,0,,لا تقلقي
Dialogue: 10,0:16:12.16,0:16:13.89,Main,,0,0,0,,،"طالما نكون داخل حاجز "غينا
Dialogue: 10,0:16:13.97,0:16:17.18,Main,,0,0,0,,ستُشفى أيّ إصابة مروعة تتعرضين لها
Dialogue: 10,0:16:17.95,0:16:19.18,Main,,0,0,0,,لديّ مسألة للنقاش
Dialogue: 10,0:16:19.64,0:16:22.23,Main,,0,0,0,,الاكتفاء بالتصدي للعدو حين يأتي أسلوب مُتهاون
Dialogue: 10,0:16:22.45,0:16:24.68,Main,,0,0,0,,علينا ابتكار استراتيجية هجوميّة
Dialogue: 10,0:16:24.68,0:16:26.77,Main,,0,0,0,,للقضاء على آلهة الرعد الثمانية والشوكي
Dialogue: 10,0:16:27.31,0:16:29.93,Main,,0,0,0,,نحن لا نعرف كلّ شيء عن ماتو أيضًا
Dialogue: 10,0:16:30.62,0:16:35.68,Main,,0,0,0,,الأسلوبُ المضادّ القائم على استدراج العدوّ إلينا ثمَّ استنزاف قواه هو الخيار الأضمن
Dialogue: 10,0:16:35.76,0:16:37.81,Main,,0,0,0,,،مُنذ تسلمي لمنصب القائدة العليا
Dialogue: 10,0:16:37.89,0:16:40.52,Main,,0,0,0,,انخفض عدد حوادث ماتو بشكل كبير
Dialogue: 10,0:16:40.55,0:16:43.02,Main,,0,0,0,,وهذا دليلٌ على صحّة أسلوبي
Dialogue: 10,0:16:43.39,0:16:45.81,Main,,0,0,0,,يبدو أنَّ هذا النهج لن يتغير
Dialogue: 10,0:16:46.00,0:16:47.35,Main,,0,0,0,,أيّ مقترحات أخرى؟
Dialogue: 10,0:16:47.66,0:16:48.39,Main,,0,0,0,,لا
Dialogue: 10,0:16:49.86,0:16:53.02,Main,,0,0,0,,"أعلم، لن أتطرّق إلى أمر "مكتب أونميوريو
Dialogue: 10,0:16:53.27,0:16:55.73,Main,,0,0,0,,لكي لا تتوخى القائدة العليا الحذر منّا
Dialogue: 10,0:16:55.89,0:16:58.85,Main,,0,0,0,,والآن، بخصوص ذلك الفتى هناك
Dialogue: 10,0:16:59.39,0:17:02.18,Main,,0,0,0,,وجوده ضروري لقدرة كيوكا
Dialogue: 10,0:17:02.42,0:17:04.10,Main,,0,0,0,,اعتبرنه مجرد أداة
Dialogue: 10,0:17:04.18,0:17:05.57,Main,,0,0,0,,!اسمي واكورا يوكي
Dialogue: 10,0:17:05.68,0:17:08.68,Main,,0,0,0,,!أعمل عادةً كمسؤول رعاية في مسكن الفرقة السابعة
Dialogue: 10,0:17:12.80,0:17:14.18,Main,,0,0,0,,إنّه ظريف
Dialogue: 10,0:17:14.35,0:17:17.23,Main,,0,0,0,,تمنيتُ لو حظيتُ بفتى واحد على الأقل
Dialogue: 10,0:17:18.40,0:17:21.35,Main,,0,0,0,,فوبوكي-سان هي والدة هيماري وياتشيهو
Dialogue: 10,0:17:21.73,0:17:23.06,Main,,0,0,0,,!إنّها شابة
Dialogue: 10,0:17:23.73,0:17:26.48,Main,,0,0,0,,!نيه-ساما، أيّتها القائدات، لدينا حالة طارئة
Dialogue: 10,0:17:26.48,0:17:28.31,Main,,0,0,0,,ما الأمر يا غينا؟
Dialogue: 10,0:17:28.48,0:17:30.02,Main,,0,0,0,,حشد هائل من الشوكي
Dialogue: 10,0:17:30.02,0:17:33.27,Main,,0,0,0,,!يزحف نحو مقرّ قوات ردع الشياطين
Dialogue: 10,0:17:33.46,0:17:35.39,Main,,0,0,0,,!يـ-يا له من عددٍ مهول
Dialogue: 10,0:17:36.56,0:17:38.48,Main,,0,0,0,,!اهدئي يا بيل-تان
Dialogue: 10,0:17:38.98,0:17:40.43,Main,,0,0,0,,!ياكومو-تشان؟
Dialogue: 10,0:17:40.93,0:17:43.64,Main,,0,0,0,,القائدات مجتمعات هنا
Dialogue: 10,0:17:43.75,0:17:45.93,Main,,0,0,0,,لذا لا داعي للخوف
Dialogue: 10,0:17:46.28,0:17:48.81,Main,,0,0,0,,!حسنٌ فهمت، اتركيني
Dialogue: 10,0:17:49.35,0:17:51.99,Main,,0,0,0,,...قدوم حشدٍ من العدو أثناء اجتماع القائِدات
Dialogue: 10,0:17:52.23,0:17:53.52,Main,,0,0,0,,أمر مريب
Dialogue: 10,0:17:54.02,0:17:57.18,Main,,0,0,0,,كونومي، وميرا، ياكومو، وفوبوكي، اعترضنَ طريقهم
Dialogue: 10,0:17:57.29,0:17:59.23,Main,,0,0,0,,أمّا البقية، فراقبنَ تحركات العدوّ
Dialogue: 10,0:17:59.36,0:18:00.33,Main,,0,0,0,,!عُلم
Dialogue: 10,0:18:01.18,0:18:04.02,Main,,0,0,0,,...أيًّا كان العدوّ وأيًّا كانت مخططاته
Dialogue: 10,0:18:04.20,0:18:07.40,Main,,0,0,0,,محاولة الهجوم على مقرّي أمر لا يُغتفر
Dialogue: 10,0:18:08.35,0:18:11.77,Main,,0,0,0,,سأتولى معاقبة قائد العدوّ بنفسي
Dialogue: 10,0:18:12.76,0:18:13.39,Main,,0,0,0,,!يوكي
Dialogue: 10,0:18:13.48,0:18:14.26,Main,,0,0,0,,!حاضر
Dialogue: 10,0:18:18.20,0:18:20.98,Main,,0,0,0,,أيّتها القائدة العليا، اسمحي لي بالخروج أيضًا
Dialogue: 10,0:18:21.24,0:18:22.63,Main,,0,0,0,,لعب دور الدفاع لا يناسبني
Dialogue: 10,0:18:23.41,0:18:24.31,Main,,0,0,0,,!تقرير
Dialogue: 10,0:18:24.73,0:18:27.14,Main,,0,0,0,,!العدو حشد من الشوكي العاديّين
Dialogue: 10,0:18:27.42,0:18:29.82,Main,,0,0,0,,سيأتي المزيد، ابقينَ متأهبات
Dialogue: 10,0:18:30.11,0:18:34.20,Main,,0,0,0,,!ولكن، انفجر بعض الشوكي بقوةٍ بمجرد قتلهم
Dialogue: 10,0:18:34.69,0:18:37.43,Main,,0,0,0,,!يبدو أنّهم مُنحوا قدرة ما
Dialogue: 10,0:18:37.55,0:18:38.93,Main,,0,0,0,,ثمّة سرٌّ خلف هذا
Dialogue: 10,0:18:39.09,0:18:41.52,Main,,0,0,0,,!قضينَ عليهم أثناء تحولي
Dialogue: 10,0:18:41.81,0:18:44.18,Main,,0,0,0,,!رُصدتْ خمسة أشكال بشريّة منفصلة عن قطيع الشوكي
Dialogue: 10,0:18:44.33,0:18:45.43,Main,,0,0,0,,!على بعد 4 كيلومترات
Dialogue: 10,0:18:45.52,0:18:47.23,Main,,0,0,0,,لا بدَّ أنّهم المدبرون
Dialogue: 10,0:18:47.92,0:18:49.10,Main,,0,0,0,,سأخرج إلى هناك
Dialogue: 10,0:18:49.48,0:18:50.85,Main,,0,0,0,,تعالي أنتِ أيضًا يا كيوكا
Dialogue: 10,0:18:51.05,0:18:52.48,Main,,0,0,0,,تينكا والبقية، ابقينَ هنا
Dialogue: 10,0:18:52.57,0:18:53.14,Main,,0,0,0,,!حاضر
Dialogue: 10,0:19:00.67,0:19:03.12,Main,,0,0,0,,!والآن، لتبدأ الموجة الثانية من الشوكي
Dialogue: 10,0:19:03.14,0:19:06.56,Main,,0,0,0,,تلاعبي بهم ليصلوا إلى مقرّ قوات ردع الشياطين هذه المرّة
Dialogue: 10,0:19:06.60,0:19:08.88,Main,,0,0,0,,وإلّا ضاعت قدرتي المتفجرة سدى
Dialogue: 10,0:19:12.35,0:19:14.68,Main,,0,0,0,,إرهابيّات من دولة أجنبية إذن
Dialogue: 10,0:19:15.35,0:19:17.23,Main,,0,0,0,,أظنّكنَّ تسعينَ خلف ثمار الخوخ
Dialogue: 10,0:19:17.73,0:19:19.10,Main,,0,0,0,,!ياماشيرو رين
Dialogue: 10,0:19:19.24,0:19:20.60,Main,,0,0,0,,!حفرتِ قبركِ بيدكِ
Dialogue: 10,0:19:20.64,0:19:21.74,Main,,0,0,0,,!تحولي إلى حجر
Dialogue: 10,0:19:24.73,0:19:28.22,Main,,0,0,0,,خطتكنّ هي اغتيال جميع القائِدات بتفجيرنا إذن
Dialogue: 10,0:19:28.72,0:19:29.64,Main,,0,0,0,,!لا يجدي نفعًا
Dialogue: 10,0:19:31.38,0:19:32.70,Main,,0,0,0,,!احترقي
Dialogue: 10,0:19:35.40,0:19:38.06,Main,,0,0,0,,هل كانت قدرة متعلقة بالكلمات؟
Dialogue: 10,0:19:38.43,0:19:43.38,Main,,0,0,0,,أحد واجبات قوات ردع الشياطين هي حماية موارد ماتو من المجرمين أمثالكنَّ
Dialogue: 10,0:19:43.39,0:19:44.37,Main,,0,0,0,,!سحقًا لكِ
Dialogue: 10,0:19:45.48,0:19:46.31,Main,,0,0,0,,!انطلق
Dialogue: 10,0:19:46.32,0:19:49.39,Main,,0,0,0,,!واجهي غضب السايبورغ ذي القوّة الخارقة
Dialogue: 10,0:19:53.52,0:19:54.27,Main,,0,0,0,,!تبًا
Dialogue: 10,0:19:58.52,0:20:00.81,Main,,0,0,0,,!إن كنت سأسقط، فسآخذكِ معي
Dialogue: 10,0:20:00.81,0:20:02.68,Main,,0,0,0,,قدرةٌ انفجاريّة؟
Dialogue: 10,0:20:02.79,0:20:04.73,Main,,0,0,0,,تفجير ذاتي واسع النطاق لأمر مزعج بحقّ
Dialogue: 10,0:20:06.30,0:20:07.66,Main,,0,0,0,,!لا أنفجر؟
Dialogue: 10,0:20:07.77,0:20:09.18,Main,,0,0,0,,،حين كنت طفلة
Dialogue: 10,0:20:09.18,0:20:12.60,Main,,0,0,0,,كنت أشعر بالإثارة عند رؤية خرائط المناطق النائية على الإنترنت
Dialogue: 10,0:20:13.10,0:20:15.48,Main,,0,0,0,,،"مصطلح "قطب يتعذر الوصول إليه
Dialogue: 10,0:20:15.60,0:20:17.43,Main,,0,0,0,,له وقع شاعري
Dialogue: 10,0:20:17.59,0:20:19.77,Main,,0,0,0,,من يدري ما الموجود هناك
Dialogue: 10,0:20:20.80,0:20:22.08,Main,,0,0,0,,ما رأيكِ أن تذهبي للتحقّق من الأمر؟
Dialogue: 10,0:20:22.53,0:20:24.10,Main,,0,0,0,,في قاع البحر البعيد
Dialogue: 10,0:20:29.68,0:20:31.18,Main,,0,0,0,,تأخرتما
Dialogue: 10,0:20:32.60,0:20:34.02,Main,,0,0,0,,!ماذا حدث هنا؟
Dialogue: 10,0:20:35.02,0:20:38.98,Main,,0,0,0,,قدرتكِ مذهلة كالعادة أيّتها القائدة العليا
Dialogue: 10,0:20:41.10,0:20:44.43,Spells,,0,0,0,,بيروكيانا: وحدةُ كلِّ ما في الكون اللامتناهي؛ قدرة بوذية متعددة حسب الماندالا الّتي تظهر على حدقتي عينيها\Nالماندالا = تجسيد بصري لقوة كونية أو قانون من قوانين الوجود
Dialogue: 10,0:20:41.10,0:20:44.43,Main,,0,0,0,,وحدةُ كلِّ ما في الكون اللامتناهي
Dialogue: 10,0:20:44.97,0:20:47.52,Main,,0,0,0,,!الكون اللامتناهي
Dialogue: 10,0:20:47.81,0:20:49.10,Main,,0,0,0,,كيوكا
Dialogue: 10,0:20:49.27,0:20:51.27,Main,,0,0,0,,ألغي هيئة العبد
Dialogue: 10,0:21:00.62,0:21:05.60,Main,,0,0,0,,الفتى الّذي تمكن من تعزيز قدرة كيوكا ونال إعجاب تينكا
Dialogue: 10,0:21:07.73,0:21:09.89,Main,,0,0,0,,بدأ يثير اهتمامي نوعًا ما
Dialogue: 10,0:21:10.95,0:21:12.51,Main,,0,0,0,,،بما أنّكِ جعلته يعمل كعبد لكِ
Dialogue: 10,0:21:12.51,0:21:14.77,Main,,0,0,0,,فأنتِ ملزمة بمنحه مكافأة، أليس كذلك؟
Dialogue: 10,0:21:14.77,0:21:16.23,Main,,0,0,0,,!كيف تبدو يا ترى؟
Dialogue: 10,0:21:24.52,0:21:25.64,Main,,0,0,0,,هذا كلّ شيء؟
Dialogue: 10,0:21:25.84,0:21:28.77,Main,,0,0,0,,كلّ ما فعله هذه المرّة هو الإسراع بنا إلى هنا
Dialogue: 10,0:21:29.77,0:21:31.52,Main,,0,0,0,,وهذا كلّ ما يحتاجه؟
Dialogue: 10,0:21:31.98,0:21:33.31,Main,,0,0,0,,إنّه ظريف
Dialogue: 10,0:21:34.73,0:21:35.56,Main,,0,0,0,,هات يدك
Dialogue: 10,0:21:40.06,0:21:41.14,Main,,0,0,0,,...هذه المرأة
Dialogue: 10,0:21:41.28,0:21:43.56,Main,,0,0,0,,...رغم اختلاف مظهرها
Dialogue: 10,0:21:44.26,0:21:45.93,Main,,0,0,0,,إلّا أنّها تذكرني بأختي
Dialogue: 10,0:21:49.70,0:21:52.66,Main,,0,0,0,,هذه القائدة العليا المسؤولة عن قوات ردع الشياطين؛
Dialogue: 10,0:21:53.22,0:21:54.47,Main,,0,0,0,,ياماشيرو رين
Dialogue: 10,0:23:26.64,0:23:29.77,Main,,0,0,0,,"في المرّة القادمة، الحلقة الثانية: "ظِلُّ رين
Dialogue: 10,0:23:30.18,0:23:32.18,Main,,0,0,0,,!مكافأةُ اليوم
Dialogue: 10,0:23:32.58,0:23:34.39,Main,,0,0,0,,!تبدو القائدة منحرفةً للغاية
Dialogue: 10,0:23:34.39,0:23:36.84,Main,,0,0,0,,!وملابسها الداخلية ظريفة، لم أتوقع ذلك
Dialogue: 10,0:23:37.23,0:23:38.44,Main,,0,0,0,,هل من خطب في ذلك؟
Dialogue: 10,0:23:38.45,0:23:40.25,Main,,0,0,0,,!الـ-القائدة
Comment: 0,0:23:40.25,0:23:42.25,Main,,0,0,0,,
Dialogue: 10,0:01:00.01,0:01:01.81,Note,,0,0,0,,شيو رامن: يُقدَّم في مرق خفيف يعتمد أساسًا على الملح، ويكون طعمه أخف وأنقى من الأنواع الّتي تعتمد على الصويا أو الميسو
Dialogue: 10,0:09:44.63,0:09:46.98,Note,,0,0,0,,أونميوريو: هو مكتب حكومي ياباني قديم كان مسؤولًا عن فن الأونميودو، أي تعاليم الين واليانغ
