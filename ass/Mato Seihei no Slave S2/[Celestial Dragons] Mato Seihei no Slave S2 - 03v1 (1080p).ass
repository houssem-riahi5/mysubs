Dialogue: 10,0:00:02.58,0:00:03.71,Main,,0,0,0,,...حسنٌ
Dialogue: 10,0:00:03.88,0:00:05.13,Main,,0,0,0,,!الفرقة الخامسة
Dialogue: 10,0:00:06.21,0:00:07.42,Main,,0,0,0,,!الفرقة السادسة
Dialogue: 10,0:00:08.46,0:00:10.13,Main,,0,0,0,,!والفرقة السابعة
Dialogue: 10,0:00:10.13,0:00:11.21,Main,,0,0,0,,!حاضر
Dialogue: 10,0:00:11.42,0:00:13.46,Main,,0,0,0,,!لنبدأ التدريب المشترك
Dialogue: 10,0:00:13.46,0:00:14.96,Main,,0,0,0,,!ابذلنَ قصارى جهدكنَّ
Dialogue: 10,0:00:15.21,0:00:16.96,Top,,0,0,0,,!حسنٌ
Dialogue: 10,0:00:18.92,0:00:20.46,Spells,,0,0,0,,بانغ بانغ بانغ: الفتاة المسلحة؛ بركة خوخ ساكي توكوياما من الوحدة الخامسة
Dialogue: 10,0:00:18.92,0:00:20.46,Main,,0,0,0,,!بانغ بانغ بانغ
Dialogue: 10,0:01:00.62,0:01:02.02,Main,,0,0,0,,خذي الأمر بجدّية
Dialogue: 10,0:01:03.24,0:01:04.88,Main,,0,0,0,,!أنا جادّة
Dialogue: 10,0:01:05.61,0:01:08.46,Main,,0,0,0,,صحيح، ألن يشارك العبد الصغير؟
Dialogue: 10,0:01:08.79,0:01:11.21,Main,,0,0,0,,لدى يوكي أعمالٌ في المسكن عليه إنجازها
Dialogue: 10,0:01:11.71,0:01:14.46,Main,,0,0,0,,إنّه متقنٌ لأعمال الطّهي والغسيل
Dialogue: 10,0:01:14.46,0:01:18.46,Main,,0,0,0,,ويمكنكِ استشعار مدى اهتمامه بنا من خلال جهوده
Dialogue: 10,0:01:18.46,0:01:21.42,Main,,0,0,0,,ولكن ألا يجدر بكِ التدرّب على قدرتكِ؟
Dialogue: 10,0:01:21.60,0:01:24.15,Main,,0,0,0,,سأركّز على ذلك غدًا
Dialogue: 10,0:03:12.79,0:03:13.75,Main,,0,0,0,,!هناك
Dialogue: 10,0:03:21.28,0:03:23.44,Main,,0,0,0,,!كما هو متوقّع منكِ يا ساكي-سان
Dialogue: 10,0:03:24.04,0:03:27.58,Main,,0,0,0,,حاولي التركيز على هدفكِ أكثر
Dialogue: 10,0:03:27.83,0:03:30.25,Main,,0,0,0,,!شكرًا لكِ على النصيحة
Dialogue: 10,0:03:35.08,0:03:38.00,Main,,0,0,0,,يعجبني صوتكِ يا ساكي-سان
Dialogue: 10,0:03:43.00,0:03:44.39,Main,,0,0,0,,!شكرًا لكِ
Dialogue: 10,0:03:45.54,0:03:47.30,Main,,0,0,0,,!تعملين بجدٍّ
Dialogue: 10,0:03:48.12,0:03:50.58,Main,,0,0,0,,ياتشيهو، ما الأمر؟
Dialogue: 10,0:03:57.63,0:04:00.63,Main,,0,0,0,,ألا تظنّين أنّكِ تفتقرين إلى القوّة؟
Dialogue: 10,0:04:01.96,0:04:06.92,Main,,0,0,0,,لا مانع لديّ من مرافقتكِ في التدريب
Dialogue: 10,0:04:07.16,0:04:08.17,Main,,0,0,0,,لا داعي لذلك
Dialogue: 10,0:04:11.17,0:04:14.11,Main,,0,0,0,,!ساكي-سان، لنتابع رجاءً
Dialogue: 10,0:04:30.38,0:04:31.83,Main,,0,0,0,,!ها أنا ذي
Dialogue: 10,0:04:32.58,0:04:33.67,Main,,0,0,0,,!هاتي ما عندكِ
Dialogue: 10,0:04:34.08,0:04:35.13,Main,,0,0,0,,!توقّفنَ
Dialogue: 10,0:04:38.92,0:04:42.92,Main,,0,0,0,,!أنتِ تزدادين قوّةً رغم عدم استخدامكِ لقدرتكِ
Dialogue: 10,0:04:44.29,0:04:47.00,Main,,0,0,0,,أريدكِ أن تُنازليني في الجولة التالية
Dialogue: 10,0:04:47.38,0:04:49.38,Main,,0,0,0,,يمكنكِ استخدام قدرتكِ
Dialogue: 10,0:04:49.57,0:04:51.46,Main,,0,0,0,,!فهمت
Dialogue: 10,0:04:53.08,0:04:54.46,Main,,0,0,0,,!ابدأنَ
Dialogue: 10,0:04:54.83,0:04:57.63,Spells,,0,0,0,,كريزي شيب: الخروف المجنون؛ قدرة تعزيز مؤقّتة
Dialogue: 10,0:04:54.83,0:04:56.63,Main,,0,0,0,,!الخروف المجنون
Dialogue: 10,0:04:56.63,0:04:57.63,Main,,0,0,0,,!ثلاثة
Dialogue: 10,0:05:00.54,0:05:02.42,Main,,0,0,0,,!إليكِ الضربة الرئيسيّة
Dialogue: 10,0:05:09.24,0:05:11.96,Main,,0,0,0,,عليكِ استخدام المزيد من القوّة في المناورات أيضًا
Dialogue: 10,0:05:26.49,0:05:32.67,Main,,0,0,0,,!سأكشف سرّ الجاذبية الّتي تتمتّعين بها يا تين-سان
Dialogue: 10,0:05:33.13,0:05:38.38,Main,,0,0,0,,لن أكشف هذا السرّ إلّا لفتى واحد في هذا العالم
Dialogue: 10,0:05:56.25,0:05:58.00,Main,,0,0,0,,!أحسنتِ
Dialogue: 10,0:05:58.00,0:06:00.25,Main,,0,0,0,,!فاجأتِني
Dialogue: 10,0:06:01.25,0:06:02.71,Main,,0,0,0,,يا للخسارة
Dialogue: 10,0:06:02.96,0:06:04.98,Main,,0,0,0,,لم أكن حادّةً بما يكفي على ما يبدو
Dialogue: 10,0:06:05.54,0:06:08.96,Main,,0,0,0,,الفكرة جيّدة، لكن ما يزال أمامكِ الكثير
Dialogue: 0,0:06:10.00,0:06:11.42,Spells,,0,0,0,,نايت ستورم: عاصفة الليل؛ تحكّم بالهواء كسلاح مطلق، من هجمات بعيدة المدى عبر الزوابع، إلى دعم الحلفاء بالحركة والطيران
Dialogue: 10,0:06:10.00,0:06:11.42,Main,,0,0,0,,عاصفة الليل
Dialogue: 10,0:06:11.75,0:06:13.54,Main,,0,0,0,,هل يمكنكِ إصابتي الآن؟
Dialogue: 10,0:06:15.16,0:06:16.53,Spells,,0,0,0,,آمي نو ميتوري: طائر السماء المقدّس؛ قدرة تلاعب بالفضاء
Dialogue: 10,0:06:15.16,0:06:16.53,Main,,0,0,0,,طائر السماء المقدّس
Dialogue: 10,0:06:26.50,0:06:27.96,Main,,0,0,0,,!كان ذلك وشيكًا
Dialogue: 10,0:06:29.82,0:06:32.39,Main,,0,0,0,,!سيكون هذا تدريبًا ممتعًا
Dialogue: 10,0:06:32.42,0:06:35.04,Main,,0,0,0,,!أتحرّق شوقًا لدخول الحمام لاحقًا
Dialogue: 10,0:06:35.61,0:06:37.88,Main,,0,0,0,,يبدو وكأنَّ الاستحمام هو هدفكِ الرئيسي
Dialogue: 10,0:06:38.00,0:06:40.92,Main,,0,0,0,,!بشرةٌ لامعةٌ ومتعرّقةٌ
Dialogue: 10,0:06:40.92,0:06:42.75,Main,,0,0,0,,!لا أطيق الانتظار
Dialogue: 10,0:06:42.75,0:06:46.50,Main,,0,0,0,,!حسنٌ، حان وقت الجدّ
Dialogue: 10,0:06:47.88,0:06:50.79,Main,,0,0,0,,أحسنتِ، أتطلع لذلك
Dialogue: 10,0:06:58.83,0:07:00.75,Main,,0,0,0,,!عُدنا
Dialogue: 10,0:07:01.21,0:07:03.46,Main,,0,0,0,,هـ-هل أنتما بخير؟
Dialogue: 10,0:07:05.36,0:07:07.08,Main,,0,0,0,,وأنتما أيضًا؟
Dialogue: 10,0:07:07.08,0:07:09.29,Main,,0,0,0,,فلتأتِ إليّ من لديها إصابة
Dialogue: 10,0:07:10.19,0:07:12.13,Main,,0,0,0,,الحمام أوّلًا
Dialogue: 10,0:07:12.32,0:07:13.38,Main,,0,0,0,,!فورًا
Dialogue: 10,0:07:13.83,0:07:16.50,Main,,0,0,0,,أتريدين أن تبقى ندبةٌ على وجهكِ اللطيف؟
Dialogue: 10,0:07:33.71,0:07:35.29,Main,,0,0,0,,!أشعر بتحسن
Dialogue: 10,0:07:38.25,0:07:42.00,Main,,0,0,0,,!قدرتكِ مذهلةٌ يا كايكو-سان
Dialogue: 10,0:07:42.13,0:07:44.71,Main,,0,0,0,,شُفيتنَّ تمامًا الآن
Dialogue: 10,0:07:46.33,0:07:47.71,Main,,0,0,0,,!شكرًا جزيلًا لكِ
Dialogue: 10,0:07:48.42,0:07:51.25,Main,,0,0,0,,بالمناسبة، أين القائِدات؟
Dialogue: 10,0:07:54.30,0:07:57.17,Main,,0,0,0,,أشغلتهنَّ قليلًا، كي لا يثِرنَ المتاعب
Dialogue: 10,0:08:00.40,0:08:03.96,Main,,0,0,0,,إذن، فرصتنا لدخول الحمام هي الآن
Dialogue: 10,0:08:04.09,0:08:05.29,Main,,0,0,0,,أجل
Dialogue: 10,0:08:05.50,0:08:08.14,Main,,0,0,0,,هيماري، افركي ظهري
Dialogue: 10,0:08:08.65,0:08:10.58,Main,,0,0,0,,!ما باليد حيلة
Dialogue: 10,0:08:14.33,0:08:15.46,Main,,0,0,0,,ما الخطب؟
Dialogue: 10,0:08:16.40,0:08:18.08,Main,,0,0,0,,...لـ-لا شيء
Dialogue: 10,0:08:18.51,0:08:19.50,Main,,0,0,0,,...حسنٌ
Dialogue: 10,0:08:19.57,0:08:23.92,Main,,0,0,0,,حسدتُكِ على قدرتكِ لا أكثر يا كايكو-سان
Dialogue: 10,0:08:24.67,0:08:28.75,Main,,0,0,0,,...لو كانت ناي تملك قدرة شفاء الجروح بمجرّد النظر
Dialogue: 10,0:08:28.92,0:08:32.54,Main,,0,0,0,,لكانت ناي أكثر نفعًا
Dialogue: 10,0:08:34.15,0:08:36.58,Main,,0,0,0,,،بفضل قدرتكِ على الاستطلاع
Dialogue: 10,0:08:37.19,0:08:40.66,Main,,0,0,0,,نمنع الشوكي من أخذ زمام المبادرة
Dialogue: 10,0:08:42.46,0:08:44.58,Main,,0,0,0,,،إن كنتُ أنا من يعالج الإصابات
Dialogue: 10,0:08:44.72,0:08:48.88,Main,,0,0,0,,فأنتِ تملكين قدرةً استباقيّةً تمنع وقوع الإصابات من الأساس
Dialogue: 10,0:08:49.38,0:08:52.17,Main,,0,0,0,,أنتِ عونٌ كبيرٌ لرفيقاتكِ
Dialogue: 10,0:08:54.44,0:08:56.67,Main,,0,0,0,,!هـ-هذا صحيح
Dialogue: 10,0:08:56.89,0:09:00.50,Main,,0,0,0,,هيّا، لننضم للبقيّة في الحمام
Dialogue: 10,0:09:00.77,0:09:01.67,Main,,0,0,0,,!حاضر
Dialogue: 10,0:09:07.85,0:09:10.25,Main,,0,0,0,,!زال التعب عنّي
Dialogue: 10,0:09:12.02,0:09:14.88,Main,,0,0,0,,ازدادت قوّة إعصار ياكومو
Dialogue: 10,0:09:14.88,0:09:18.63,Main,,0,0,0,,أظن أنّها قادرةٌ على نسف مدينةٍ بأكملها إن قاتلتْ بجدّيّة
Dialogue: 10,0:09:18.87,0:09:22.21,Main,,0,0,0,,...لو تخلّتْ عن عادتها في التلمّس كلّما سنحت لها الفرصة
Dialogue: 10,0:09:22.35,0:09:24.16,Main,,0,0,0,,لكنتُ احترمتُها
Dialogue: 10,0:09:24.79,0:09:28.17,Main,,0,0,0,,على الأقل اتّخذت القائدة تدابير لسلامتنا
Dialogue: 10,0:09:31.00,0:09:32.04,Main,,0,0,0,,حسنٌ
Dialogue: 10,0:09:32.87,0:09:35.46,Main,,0,0,0,,!أنتَ هناك
Dialogue: 10,0:09:37.25,0:09:38.63,Main,,0,0,0,,!ياكومو-سان؟
Dialogue: 10,0:09:39.96,0:09:44.75,Main,,0,0,0,,قيّدتني تين-سان والبقيّة، لكن كان لديهما سببٌ وجيهٌ لذلك
Dialogue: 10,0:09:44.92,0:09:48.92,Main,,0,0,0,,بل تمَّ عزلكِ لأنّكِ تهاجمين الفتيات في الحمام، أليس كذلك؟
Dialogue: 10,0:09:50.58,0:09:53.84,Main,,0,0,0,,قالت إنّها ستغضب إن استخدمتُ قدرتي للهرب
Dialogue: 10,0:09:53.86,0:09:55.84,Main,,0,0,0,,!هدّدتني كيوكا بذلك
Dialogue: 10,0:09:55.87,0:09:57.12,Main,,0,0,0,,...لذا
Dialogue: 10,0:09:58.46,0:10:01.33,Main,,0,0,0,,ما رأيكَ أن تفكّ قيدي؟
Dialogue: 10,0:10:01.92,0:10:05.17,Main,,0,0,0,,!قد تكون فرصتكَ للمس فتاةٍ
Dialogue: 10,0:10:08.63,0:10:10.42,Main,,0,0,0,,...آسف
Dialogue: 10,0:10:10.42,0:10:14.13,Main,,0,0,0,,أمرتني كيوكا-سان ألّا أفكّ قيدكِ
Dialogue: 10,0:10:14.38,0:10:16.46,Main,,0,0,0,,!يا لكَ من مخلص
Dialogue: 10,0:10:18.29,0:10:19.42,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:10:22.21,0:10:27.50,Main,,0,0,0,,يمكنني الإفلات دون استخدام قدرتي على أيّ حال
Dialogue: 10,0:10:27.50,0:10:29.04,Main,,0,0,0,,ما خطب هذه الفتاة؟
Dialogue: 10,0:10:31.46,0:10:32.75,Main,,0,0,0,,...والآن
Dialogue: 10,0:10:33.50,0:10:37.54,Main,,0,0,0,,لنتجاذب أطراف الحديث يا عبد-تشان
Dialogue: 10,0:10:47.46,0:10:49.46,Main,,0,0,0,,ما الأمر؟
Dialogue: 10,0:10:50.13,0:10:53.63,Main,,0,0,0,,لا بدَّ أنّها قلقةٌ لأنَّ ياكومو هادئةٌ على غير العادة
Dialogue: 10,0:10:53.96,0:10:57.00,Main,,0,0,0,,أظنّها تنتظر خروجنا من الحمام
Dialogue: 10,0:10:58.38,0:11:02.75,Main,,0,0,0,,فالتلامس الجسديّ مع الفتيات يتصدّر قائمة أولويات القائدة
Dialogue: 10,0:11:02.75,0:11:04.04,Main,,0,0,0,,...أولويـ
Dialogue: 10,0:11:06.88,0:11:09.50,Main,,0,0,0,,ثمّة أمرٌ أريد سؤالكَ عنه
Dialogue: 10,0:11:09.50,0:11:10.46,Main,,0,0,0,,!تفضّلي
Dialogue: 10,0:11:12.38,0:11:14.04,Main,,0,0,0,,...أيّها العبد-تشان
Dialogue: 10,0:11:14.04,0:11:18.38,Main,,0,0,0,,هل تستخدم يديكَ البارعتين لخدمة كيوكا كلّ ليلة؟
Dialogue: 10,0:11:19.25,0:11:20.42,Main,,0,0,0,,!خدمة؟
Dialogue: 10,0:11:24.17,0:11:26.04,Main,,0,0,0,,!أقصد أمورًا منحرفةً
Dialogue: 10,0:11:26.17,0:11:29.25,Main,,0,0,0,,!أراهن أنّك تدلّك ثدييها بدل كتفيها
Dialogue: 10,0:11:29.25,0:11:31.58,Main,,0,0,0,,!بالطبع لا أفعل
Dialogue: 10,0:11:31.71,0:11:33.75,Main,,0,0,0,,ماذا؟ حقًّا؟
Dialogue: 10,0:11:33.91,0:11:37.71,Main,,0,0,0,,لو كنتَ بارعًا، لكنتُ مهتمّةً بخدماتكَ أيضًا
Dialogue: 10,0:11:39.25,0:11:44.00,Main,,0,0,0,,...رائحة الفتيات زكيّة، ولمسهنَّ ممتع
Dialogue: 10,0:11:44.14,0:11:45.63,Main,,0,0,0,,...ولكن حين رأيتكَ يا عبد-تشان
Dialogue: 10,0:11:45.63,0:11:49.29,Main,,0,0,0,,تساءلتُ عن شعور لمس الفتيان
Dialogue: 10,0:11:49.54,0:11:52.88,Main,,0,0,0,,أليس لديكِ حبيب يا ياكومو-سان؟
Dialogue: 10,0:11:54.67,0:11:57.17,Main,,0,0,0,,كلّا، فأنا مشغولة
Dialogue: 10,0:11:57.41,0:11:59.21,Main,,0,0,0,,أظنّ أنَّ الجميع كذلك
Dialogue: 10,0:12:00.90,0:12:02.79,Main,,0,0,0,,إذن، لِمَ أنا بالذات؟
Dialogue: 10,0:12:03.12,0:12:06.25,Main,,0,0,0,,،بصراحة، الفتيان لا يملكون قدرات
Dialogue: 10,0:12:06.25,0:12:09.38,Main,,0,0,0,,لذا لم أشعر تجاههم سوى بالشفقة
Dialogue: 10,0:12:10.02,0:12:13.46,Main,,0,0,0,,لكنّكَ تبدّد شعوري بالحذر
Dialogue: 10,0:12:13.54,0:12:16.38,Main,,0,0,0,,أهي هالة الأخ الصغير يا ترى؟
Dialogue: 10,0:12:16.59,0:12:17.46,Main,,0,0,0,,أخ صغير؟
Dialogue: 10,0:12:17.76,0:12:19.96,Main,,0,0,0,,هل أنتِ أخت كبرى أيضًا يا ياكومو-سان؟
Dialogue: 10,0:12:22.17,0:12:23.75,Main,,0,0,0,,!أجل
Dialogue: 10,0:12:23.92,0:12:25.83,Main,,0,0,0,,!لديّ الكثير من الأخوات الصغيرات
Dialogue: 10,0:12:25.94,0:12:28.88,Main,,0,0,0,,اخترتُ هذا العمل لأكسب المال بصفتي الأخت الكبرى
Dialogue: 10,0:12:28.99,0:12:31.88,Main,,0,0,0,,اعتدتُ أنا وأخواتي على المزاح والتلامس
Dialogue: 10,0:12:31.96,0:12:35.29,Main,,0,0,0,,!لهذا لا أقاوم رغبتي في التلامس الجسديّ
Dialogue: 10,0:12:40.36,0:12:42.54,Main,,0,0,0,,!أشعر بخروج الأخريات من الحمام
Dialogue: 10,0:12:42.80,0:12:45.25,Main,,0,0,0,,!سأذهب لتأمّل أجسادهنَّ قبل أن يرتدين ملابسهنَّ
Dialogue: 10,0:12:45.33,0:12:46.88,Main,,0,0,0,,!أراكَ لاحقًا
Dialogue: 10,0:12:50.17,0:12:52.21,Main,,0,0,0,,إنّها فتاة متحرّرةٌ حقًّا
Dialogue: 10,0:12:53.52,0:12:55.25,Main,,0,0,0,,تشبه الرياح حقًّا
Dialogue: 10,0:13:03.13,0:13:06.33,Main,,0,0,0,,حسنٌ إذن، سنذهب نحن إلى مقرّ الفرقة العاشرة
Dialogue: 10,0:13:06.58,0:13:07.92,Main,,0,0,0,,توخّينَ الحذر
Dialogue: 10,0:13:09.45,0:13:12.75,Main,,0,0,0,,تتغيّر فِرق التّدريب باستمرار إذن
Dialogue: 10,0:13:13.43,0:13:16.29,Main,,0,0,0,,تحسّبًا لتحرّك آلهة الرعد الثمانية كمجموعاتٍ
Dialogue: 10,0:13:16.48,0:13:18.50,Main,,0,0,0,,علينا إتقان العمل الجماعيّ
Dialogue: 10,0:13:20.41,0:13:23.04,Main,,0,0,0,,سأنشغل مع كيوكا بممارسة الفاحشة
Dialogue: 10,0:13:23.22,0:13:25.12,Main,,0,0,0,,!لذا ابدأنَ تدريبكنَّ
Dialogue: 10,0:13:25.18,0:13:26.96,Main,,0,0,0,,لا تقوليها بهذه الطريقة
Dialogue: 10,0:13:28.63,0:13:30.25,Main,,0,0,0,,هل نتبارز أوّلًا؟
Dialogue: 10,0:13:31.13,0:13:32.92,Main,,0,0,0,,...قبل ذلك
Dialogue: 10,0:13:34.40,0:13:36.83,Main,,0,0,0,,...بخصوص موضوع قدرة الإعارة
Dialogue: 10,0:13:37.20,0:13:39.25,Main,,0,0,0,,...والشروط الّتي ذكرتِها البارحة
Dialogue: 10,0:13:39.25,0:13:41.83,Main,,0,0,0,,ماذا أخبرتكِ القائدة العليا بالضّبط؟
Dialogue: 10,0:13:41.83,0:13:43.50,Main,,0,0,0,,أتعنين المكافأة؟
Dialogue: 10,0:13:45.54,0:13:47.21,Main,,0,0,0,,،المكافأة لا مفرّ منها
Dialogue: 10,0:13:47.38,0:13:49.79,Main,,0,0,0,,لكن لا يمكن التحكّم بنتائج الإعارة
Dialogue: 10,0:13:49.90,0:13:51.83,Main,,0,0,0,,وقد تحدث أمور غير متوقّعة
Dialogue: 10,0:13:53.52,0:13:55.21,Main,,0,0,0,,!لا مشكلة
Dialogue: 10,0:13:57.80,0:14:00.88,Main,,0,0,0,,،إن تحوّل لهيئةٍ ذات قدرةٍ خاصّة
Dialogue: 10,0:14:01.12,0:14:03.54,Main,,0,0,0,,!فقد يفيدنا في إبادة الشوكي
Dialogue: 10,0:14:05.87,0:14:07.43,Main,,0,0,0,,لا خيار أمامي إذن
Dialogue: 10,0:14:25.75,0:14:26.96,Main,,0,0,0,,!أجنحة؟
Dialogue: 10,0:14:27.54,0:14:29.33,Main,,0,0,0,,سأجرّب الأمر
Dialogue: 10,0:14:39.71,0:14:41.54,Main,,0,0,0,,!تذكّري أنّه مجرّد إعارة
Dialogue: 10,0:14:42.04,0:14:44.63,Main,,0,0,0,,!ياكومو-سان ليست سارقة
Dialogue: 10,0:14:58.63,0:14:59.92,Main,,0,0,0,,!أنا أطير
Dialogue: 10,0:15:01.58,0:15:04.17,Main,,0,0,0,,الطيران شعورٌ رائع، أليس كذلك؟
Dialogue: 10,0:15:04.79,0:15:10.42,Main,,0,0,0,,لكن إن اقتصر الأمر على الطيران، فقدرتي تفي بالغرض
Dialogue: 10,0:15:10.65,0:15:13.54,Main,,0,0,0,,قدرتكِ هي التحكّم بالرياح، أليس كذلك؟
Dialogue: 10,0:15:14.24,0:15:15.14,Main,,0,0,0,,!أجل
Dialogue: 10,0:15:15.24,0:15:18.54,Main,,0,0,0,,!إحداث الأعاصير ورفع الأشياء
Dialogue: 10,0:15:21.95,0:15:24.79,Main,,0,0,0,,هل يمكنني التحليق بأقصى سرعة؟
Dialogue: 10,0:15:25.71,0:15:26.88,Main,,0,0,0,,!بالتأكيد
Dialogue: 10,0:15:33.29,0:15:35.70,Main,,0,0,0,,!يا له من تسارع
Dialogue: 10,0:15:36.00,0:15:39.92,Main,,0,0,0,,ماذا سيحدث إن دمجته مع قدرتي؟
Dialogue: 10,0:15:41.75,0:15:43.38,Spells,,0,0,0,,نايت ستورم: عاصفة الليل؛ تحكّم بالهواء كسلاح مطلق، من هجمات بعيدة المدى عبر الزوابع، إلى دعم الحلفاء بالحركة والطيران
Dialogue: 10,0:15:41.75,0:15:43.38,Main,,0,0,0,,!عاصفة الليل
Dialogue: 10,0:15:45.58,0:15:48.17,Main,,0,0,0,,!يمكنني الطيران أسرع بفضل هذه الرياح
Dialogue: 10,0:15:58.88,0:16:01.75,Main,,0,0,0,,!تجاوزتَ سرعتي أنا حتّى
Dialogue: 10,0:16:12.50,0:16:14.29,Main,,0,0,0,,!قضيتُ على الشوكي في الأسفل
Dialogue: 10,0:16:14.50,0:16:17.38,Main,,0,0,0,,!حسنٌ، واصل الطيران هكذا
Dialogue: 10,0:16:17.63,0:16:18.50,Main,,0,0,0,,!حاضر
Dialogue: 10,0:16:32.37,0:16:35.21,Main,,0,0,0,,!آسف، شعرتُ بتعب فجأةً
Dialogue: 10,0:16:35.43,0:16:38.13,Main,,0,0,0,,!نفد وقودك، لا بأس
Dialogue: 10,0:16:38.33,0:16:40.88,Main,,0,0,0,,هذه الهيئة ضعيفة وتفتقر للقدرة على التحمّل
Dialogue: 10,0:16:41.13,0:16:43.04,Main,,0,0,0,,!استخدامها ليس سهلًا
Dialogue: 10,0:16:48.69,0:16:51.49,Main,,0,0,0,,!يبدو أنَّ وقت المكافأة قد حان
Dialogue: 10,0:16:53.32,0:16:54.96,Main,,0,0,0,,...حسنٌ
Dialogue: 10,0:16:56.63,0:17:01.17,Main,,0,0,0,,لنكتشف كيف يبدو ملمس الفتيان
Dialogue: 10,0:17:04.92,0:17:08.13,Main,,0,0,0,,!بدأتُ أشعر بالقشعريرة
Dialogue: 10,0:17:14.31,0:17:18.54,Main,,0,0,0,,!يبدو أنَّ مكافأتكَ هي أن أتحسّس جسدكَ كما يحلو لي
Dialogue: 10,0:17:20.03,0:17:21.98,Main,,0,0,0,,!هيّا، اخلع ملابسك
Dialogue: 10,0:17:27.22,0:17:28.73,Main,,0,0,0,,!أنتِ بارعةٌ للغاية
Dialogue: 10,0:17:28.79,0:17:30.38,Main,,0,0,0,,!تدرّبتُ على ذلك
Dialogue: 10,0:17:32.27,0:17:34.54,Main,,0,0,0,,،إن استمتعتُ بلمسكَ
Dialogue: 10,0:17:34.84,0:17:39.00,Main,,0,0,0,,!فسأضمّكَ إلى حريمي بشكلٍ خاصّ يا عبد-تشان
Dialogue: 10,0:17:39.63,0:17:41.21,Main,,0,0,0,,حريم؟
Dialogue: 10,0:17:44.13,0:17:50.63,Main,,0,0,0,,!طموحي هو بناء حريم من فتيات قوات ردع الشياطين الفاتنات
Dialogue: 10,0:17:51.46,0:17:53.71,Main,,0,0,0,,!يا له من طموحٍ هائل
Dialogue: 10,0:17:53.71,0:17:55.79,Main,,0,0,0,,!خاصّةً مع فتيات مثلهنَّ
Dialogue: 10,0:17:56.31,0:17:59.04,Main,,0,0,0,,!ولن أدّخر جهدًا لتحقيق ذلك
Dialogue: 10,0:17:59.33,0:18:03.75,Main,,0,0,0,,!فالفرقة الخامسة تُعرف بتفانيها وتعاونها
Dialogue: 10,0:18:09.84,0:18:10.60,Main,,0,0,0,,حسنٌ
Dialogue: 10,0:18:18.13,0:18:20.58,Main,,0,0,0,,...ملامسة بشرة شخصٍ آخر
Dialogue: 10,0:18:28.33,0:18:31.04,Main,,0,0,0,,هي إحدى طرق التلامس
Dialogue: 10,0:18:34.13,0:18:37.21,Main,,0,0,0,,!وجهكَ المحمرّ ظريفٌ للغاية
Dialogue: 10,0:18:39.49,0:18:41.79,Main,,0,0,0,,قوامكَ بريّ بشكل ملحوظ
Dialogue: 10,0:18:43.36,0:18:46.00,Main,,0,0,0,,هكذا هم الفتيان إذن
Dialogue: 10,0:18:47.13,0:18:49.63,Main,,0,0,0,,ظهركَ خشنٌ وما إلى ذلك
Dialogue: 10,0:18:49.63,0:18:52.13,Main,,0,0,0,,!إنّه شعور لا بأس به
Dialogue: 10,0:18:52.24,0:18:54.29,Main,,0,0,0,,حان وقت التذوّق
Dialogue: 10,0:19:02.44,0:19:03.92,Main,,0,0,0,,ظريفٌ
Dialogue: 10,0:19:06.04,0:19:07.63,Main,,0,0,0,,أيّها العبد-تشان
Dialogue: 10,0:19:08.88,0:19:11.08,Main,,0,0,0,,!انضمامكَ لحريمي
Dialogue: 10,0:19:11.15,0:19:12.42,Main,,0,0,0,,!قد تمّ
Dialogue: 10,0:19:15.77,0:19:17.38,Main,,0,0,0,,حريم؟
Dialogue: 10,0:19:18.11,0:19:19.79,Main,,0,0,0,,أنتَ سعيدٌ، أليس كذلك؟
Dialogue: 10,0:19:19.85,0:19:21.63,Main,,0,0,0,,!افرح بذلك
Dialogue: 10,0:19:23.53,0:19:25.04,Main,,0,0,0,,...لـ-لن أفعل
Dialogue: 10,0:19:26.87,0:19:30.58,Main,,0,0,0,,!والآن ليبدأ التحسّس من الأمام
Dialogue: 10,0:19:32.04,0:19:33.75,Main,,0,0,0,,!هيّا، هيّا
Dialogue: 10,0:19:33.75,0:19:36.00,Main,,0,0,0,,!مهلًا يا ياكومو-سان
Dialogue: 10,0:19:36.63,0:19:39.67,Main,,0,0,0,,تقنيات ياكومو-سان جيّدة، أليس كذلك؟
Dialogue: 10,0:19:39.72,0:19:41.92,Main,,0,0,0,,!انتهت المكافأة
Dialogue: 10,0:19:43.04,0:19:46.71,Main,,0,0,0,,،منزل عائلتي يقع في منطقة باردة في الشمال
Dialogue: 10,0:19:46.98,0:19:48.65,Main,,0,0,0,,وكان منزلًا رخيصًا
Dialogue: 10,0:19:50.00,0:19:52.75,Main,,0,0,0,,،كانت الرياح تتسلّل عبر شقوقه بقوّة
Dialogue: 10,0:19:52.97,0:19:56.75,Main,,0,0,0,,لذا كنت أنا وأخواتي الأربع نتلاصق هكذا
Dialogue: 10,0:19:57.08,0:20:03.08,Main,,0,0,0,,!كنّا فقراء لدرجة أنّنا كنّا نتقاسم فطيرةً واحدةً
Dialogue: 10,0:20:03.08,0:20:05.58,Main,,0,0,0,,!كانت لذيذةً بحقّ
Dialogue: 10,0:20:07.34,0:20:10.71,Main,,0,0,0,,!هذا هو أخي الصغير، أنتَ الأفضل
Dialogue: 10,0:20:11.92,0:20:14.38,Main,,0,0,0,,إنّها أختٌ كبرى حقًّا
Dialogue: 10,0:20:15.56,0:20:17.75,Main,,0,0,0,,،بما أنّني أجني المال في قوات ردع الشياطين
Dialogue: 10,0:20:17.90,0:20:21.00,Main,,0,0,0,,فلن تقلق أخواتي بشأن مصاريف دراستهنَّ
Dialogue: 10,0:20:21.18,0:20:22.83,Main,,0,0,0,,...الأمور مستقرّة، ولكن
Dialogue: 10,0:20:22.93,0:20:24.17,Main,,0,0,0,,...ياكومو-سان
Dialogue: 10,0:20:27.04,0:20:30.75,Main,,0,0,0,,!أشتاق إلى ذلك التلامس الجسديّ
Dialogue: 10,0:20:31.21,0:20:32.88,Main,,0,0,0,,...في الواقع
Dialogue: 10,0:20:34.25,0:20:36.92,Main,,0,0,0,,...حين تتحرّك يا عبد-تشان
Dialogue: 10,0:20:38.00,0:20:40.50,Main,,0,0,0,,...وتحتكّ أجسادنا
Dialogue: 10,0:20:43.13,0:20:45.21,Main,,0,0,0,,...أشعر
Dialogue: 10,0:20:45.96,0:20:48.00,Main,,0,0,0,,!بالمتعة
Dialogue: 10,0:20:58.05,0:21:00.17,Main,,0,0,0,,!أنا منبهرةٌ للغاية
Dialogue: 10,0:21:06.92,0:21:10.83,Main,,0,0,0,,،يمكن استخدام هيئتي في أسلوب الكرّ والفرّ
Dialogue: 10,0:21:10.83,0:21:13.33,Main,,0,0,0,,أو ربّما للهجمات المباغتة
Dialogue: 10,0:21:13.33,0:21:16.88,Main,,0,0,0,,سأضع في الحسبان أنّك تطيرين أسرع من أيّ أحد آخر
Dialogue: 10,0:21:17.79,0:21:21.13,Main,,0,0,0,,!لنجرّب الأمر بين الحين والآخر يا عبد-تشان
Dialogue: 10,0:21:21.13,0:21:22.17,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:21:24.83,0:21:27.00,Main,,0,0,0,,...أودّ التدرّب أكثر، لكن
Dialogue: 10,0:21:27.17,0:21:29.29,Main,,0,0,0,,حان وقت مغادرة الفرقة السابعة
Dialogue: 10,0:21:29.50,0:21:30.27,Main,,0,0,0,,أجل
Dialogue: 10,0:21:31.30,0:21:33.71,Main,,0,0,0,,سنتدرّب مع الفرقة العاشرة
Dialogue: 10,0:21:35.67,0:21:38.04,Main,,0,0,0,,...يبدو أنّنا سنجري تدريبات مشتركة
Dialogue: 10,0:21:38.21,0:21:40.54,Main,,0,0,0,,لضمان التنسيق الدقيق والفعّال
Dialogue: 10,0:21:40.92,0:21:42.63,Main,,0,0,0,,...الفرقة العاشرة
Dialogue: 10,0:21:46.99,0:21:49.58,Main,,0,0,0,,إنّها فرقة القائدة العليا
Dialogue: 10,0:21:52.88,0:21:55.21,Main,,0,0,0,,أيّ نوع من التدريبات سيكون يا ترى؟
Dialogue: 10,0:23:26.83,0:23:29.54,Main,,0,0,0,,"في المرّة القادمة، الحلقة الرابعة: "هيجان
Dialogue: 10,0:23:30.21,0:23:32.74,Main,,0,0,0,,!مكافأةُ اليوم
Dialogue: 10,0:23:33.04,0:23:35.25,Main,,0,0,0,,!لا بدَّ من مشروبٍ منعشٍ بعد الحمام
Dialogue: 10,0:23:35.63,0:23:38.42,Main,,0,0,0,,!اسقِني من فمكِ
Dialogue: 10,0:23:38.42,0:23:40.13,Main,,0,0,0,,!اهربوا جميعًا
Comment: 0,0:00:00.00,0:00:00.00,Signs,,0,0,0,,
