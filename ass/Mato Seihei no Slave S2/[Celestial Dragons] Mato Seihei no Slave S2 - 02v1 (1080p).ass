Dialogue: 10,0:00:04.81,0:00:06.11,Main,,0,0,0,,إنّه ظريف
Dialogue: 10,0:00:07.69,0:00:08.30,Main,,0,0,0,,هات يدك
Dialogue: 10,0:00:12.35,0:00:14.48,Main,,0,0,0,,كما توقعت تمامًا
Dialogue: 10,0:00:14.62,0:00:16.46,Main,,0,0,0,,يشبه الكلب نوعًا ما
Dialogue: 10,0:00:17.10,0:00:18.03,Main,,0,0,0,,...هذه المرأة
Dialogue: 10,0:00:18.16,0:00:20.25,Main,,0,0,0,,...رغم اختلاف مظهرها
Dialogue: 10,0:00:21.16,0:00:22.79,Main,,0,0,0,,إلّا أنّها تذكرني بأختي
Dialogue: 10,0:00:24.58,0:00:27.26,Main,,0,0,0,,هذه القائدة العليا المسؤولة عن قوات ردع الشياطين؛
Dialogue: 10,0:00:28.08,0:00:29.26,Main,,0,0,0,,ياماشيرو رين
Dialogue: 10,0:00:33.88,0:00:35.62,Main,,0,0,0,,سأسبقكما بالعودة
Dialogue: 10,0:00:36.67,0:00:39.38,Main,,0,0,0,,راقبا هؤلاء حتّى وصول فرقة الاسترداد
Dialogue: 10,0:00:40.77,0:00:41.56,Main,,0,0,0,,عُلم
Dialogue: 10,0:00:47.00,0:00:48.48,Main,,0,0,0,,...بما أنّها تتنقل بتلك الطريقة
Dialogue: 10,0:00:48.83,0:00:52.03,Main,,0,0,0,,،يظنّ البعض أنَّ قدرة القائدة العليا هي الطيران
Dialogue: 10,0:00:52.46,0:00:54.58,Main,,0,0,0,,لكنَّ ذلك غيضٌ من فيضِ ما تستطيع فعله
Dialogue: 10,0:00:56.03,0:00:58.36,Main,,0,0,0,,لا بدَّ أنّهنَّ هُزمنَ لسوء فهمهنَّ لقُدرَتِها
Dialogue: 10,0:00:59.18,0:01:01.43,Main,,0,0,0,,إنّهنَّ بشر، أليس كذلك؟
Dialogue: 10,0:01:01.77,0:01:04.09,Main,,0,0,0,,يقال إنّه لا يمكن الحصول على ثمار الخوخ إلّا في ماتو اليابان
Dialogue: 10,0:01:04.42,0:01:06.21,Main,,0,0,0,,هل أتينَ لسرقتها يا ترى؟
Dialogue: 10,0:01:07.16,0:01:10.89,Main,,0,0,0,,،نحن نزوّد الدول الأجنبية بالخوخ دوريًّا
Dialogue: 10,0:01:11.13,0:01:12.72,Main,,0,0,0,,لكن يبدو أنّهم يطمعون في المزيد
Dialogue: 10,0:01:13.44,0:01:17.57,Main,,0,0,0,,ماتو كيانٌ خطير يجلب الصراعات
Dialogue: 10,0:02:54.95,0:02:58.42,Main,,0,0,0,,شكرًا لكِ على توصيلنا
Dialogue: 10,0:02:58.75,0:03:01.31,Main,,0,0,0,,لا عليكِ، كنّا في دوريةٍ على أيّ حال
Dialogue: 10,0:03:01.86,0:03:05.24,Main,,0,0,0,,انتهى اجتماع القائِدات بسلاسةٍ على غير المتوقع
Dialogue: 10,0:03:05.89,0:03:09.70,Main,,0,0,0,,لأنَّ القائدة العليا ستتولى استجواب المهاجمات بنفسها
Dialogue: 10,0:03:10.60,0:03:13.81,Main,,0,0,0,,يبدو أنَّ الاجتماعات ستُعقد بكثرةٍ مستقبلًا
Dialogue: 10,0:03:14.15,0:03:18.36,Main,,0,0,0,,وستزداد المهام المشتركة بين الفِرق أيضًا
Dialogue: 10,0:03:23.75,0:03:25.94,Main,,0,0,0,,كيف هو حال تلميذاتكِ؟
Dialogue: 10,0:03:25.94,0:03:28.38,Main,,0,0,0,,لا بأس بهنَّ
Dialogue: 10,0:03:28.38,0:03:31.38,Main,,0,0,0,,...حتّى لو دربتهنَّ في البيئة ذاتها
Dialogue: 10,0:03:31.38,0:03:32.94,Main,,0,0,0,,...فلا يمكن لأيٍّ منهنَّ
Dialogue: 10,0:03:32.94,0:03:35.93,Main,,0,0,0,,أن تضاهي قوّتكِ الجسدية يا كيوكا
Dialogue: 10,0:03:36.60,0:03:39.60,Main,,0,0,0,,!كان أُسلوبكِ القتالي في إسقاط الشوكي وأنتِ عزلاء مذهلًا
Dialogue: 10,0:03:39.76,0:03:41.82,Main,,0,0,0,,أرجو أن تدربيني في المرّة القادمة
Dialogue: 10,0:03:42.18,0:03:43.88,Main,,0,0,0,,حسنٌ، لا مانع لدي
Dialogue: 10,0:03:44.14,0:03:46.73,Main,,0,0,0,,!حقًّا؟ هذا يسعدني
Dialogue: 10,0:03:50.59,0:03:53.65,Main,,0,0,0,,جميع القائِدات ذوات شخصيّات قويّة
Dialogue: 10,0:03:57.87,0:03:59.37,Main,,0,0,0,,ناهيكِ عن ميوغا-سان
Dialogue: 10,0:03:59.53,0:04:02.29,Main,,0,0,0,,تتمتع بحيويّةٍ مذهلةٍ رغم تقدّمها في السنِّ
Dialogue: 10,0:04:03.16,0:04:05.79,Main,,0,0,0,,...بصفتها قائدةً ناصحةً تضبط جموح الشباب
Dialogue: 10,0:04:05.92,0:04:07.74,Main,,0,0,0,,كانت تشغل منصب المعلمة
Dialogue: 10,0:04:08.02,0:04:11.65,Main,,0,0,0,,أظن أنَّ فوبوكي-سان من الفرقة التاسعة ستتولى هذا الدور مستقبلًا
Dialogue: 10,0:04:12.57,0:04:16.92,Main,,0,0,0,,بالمناسبة، أدركتُ الآن الهالة المخيفة الّتي تحيط بالقائدة العليا
Dialogue: 10,0:04:17.38,0:04:19.83,Main,,0,0,0,,وضعتك نصب عينيها الآن
Dialogue: 10,0:04:20.21,0:04:21.43,Main,,0,0,0,,حقًّا؟
Dialogue: 10,0:04:21.77,0:04:24.15,Main,,0,0,0,,القائدة العليا تحبُّ الحيوانات
Dialogue: 10,0:04:24.94,0:04:26.26,Main,,0,0,0,,خاصةً الكلاب
Dialogue: 10,0:04:29.38,0:04:31.36,Main,,0,0,0,,كان هناك قائدات أخريات أيضًا
Dialogue: 10,0:04:31.91,0:04:33.71,Main,,0,0,0,,هل أثارت اهتمامكَ إحداهنَّ؟
Dialogue: 10,0:04:37.93,0:04:41.47,Main,,0,0,0,,...رأيتُ كيف تحترمكِ القائِدات الأصغر سنًّا
Dialogue: 10,0:04:43.04,0:04:47.23,Main,,0,0,0,,فأدركتُ مجدّدًا مدى روعتكِ يا كيوكا-سان
Dialogue: 10,0:04:50.42,0:04:53.02,Main,,0,0,0,,هل أصبحتَ تُجيد التملق الآن؟
Dialogue: 10,0:04:53.84,0:04:55.28,Main,,0,0,0,,!أنا جادٌّ فيما أقول
Dialogue: 0,0:05:02.85,0:05:04.77,Main,,0,0,0,,فهمت
Dialogue: 10,0:05:25.10,0:05:28.60,Main,,0,0,0,,أنتِ تستغرقين وقتًا طويلًا في فركِ جسدكِ
Dialogue: 10,0:05:29.77,0:05:30.98,Main,,0,0,0,,حقًّا؟
Dialogue: 10,0:05:31.62,0:05:34.81,Main,,0,0,0,,انتهاء الاجتماع مبكرًا فرصةٌ لا تُعوّض
Dialogue: 10,0:05:35.20,0:05:37.56,Main,,0,0,0,,سأذهب للتسلّي في غرفة يوكي
Dialogue: 10,0:05:55.58,0:05:58.77,Main,,0,0,0,,تبدو متعبًا، لذا ستساعدكَ ناي
Dialogue: 10,0:06:02.33,0:06:03.46,Main,,0,0,0,,أنتِ خير عونٍ
Dialogue: 10,0:06:05.13,0:06:08.07,Main,,0,0,0,,هذا بديهي، فناي هي رئيسة يوكي-سان
Dialogue: 10,0:06:09.90,0:06:11.41,Main,,0,0,0,,شكرًا لكِ يا ناي-تشان
Dialogue: 10,0:06:18.85,0:06:20.10,Main,,0,0,0,,...نيه-تشان
Dialogue: 10,0:06:20.89,0:06:23.81,Main,,0,0,0,,بذلتُ جهدي طوال اليوم
Dialogue: 10,0:06:55.45,0:06:57.46,Main,,0,0,0,,!بهدوء
Dialogue: 10,0:07:00.89,0:07:03.15,Main,,0,0,0,,نجحتُ في التسلّل
Dialogue: 10,0:07:07.16,0:07:08.73,Main,,0,0,0,,!يوكي
Dialogue: 10,0:07:08.93,0:07:10.63,Main,,0,0,0,,!لنلعب
Dialogue: 10,0:07:10.86,0:07:12.63,Main,,0,0,0,,!سأكون جريئةً اليوم
Dialogue: 10,0:07:23.64,0:07:24.93,Main,,0,0,0,,كما توقّعت
Dialogue: 10,0:07:25.03,0:07:28.61,Main,,0,0,0,,يمكنني دخول الحاجز إن كبحتُ قوّتي
Dialogue: 10,0:07:29.47,0:07:31.64,Main,,0,0,0,,إنّه أمامي مباشرةً
Dialogue: 10,0:07:32.21,0:07:34.28,Main,,0,0,0,,يغطُّ في نومٍ عميقٍ
Dialogue: 10,0:07:34.58,0:07:37.45,Main,,0,0,0,,سآخذه معي الآن
Dialogue: 10,0:07:40.59,0:07:42.26,Main,,0,0,0,,!لا تلمسي يوكي
Dialogue: 10,0:07:48.26,0:07:51.44,Main,,0,0,0,,أنتِ مجرّد جنديّةٍ عاديّةٍ، أليس كذلك؟
Dialogue: 10,0:07:51.45,0:07:53.45,Main,,0,0,0,,...وتتجرئين على
Dialogue: 10,0:07:58.96,0:08:00.62,Main,,0,0,0,,متسلّلةٌ غير شرعيّةٍ إذن
Dialogue: 10,0:08:00.69,0:08:02.46,Main,,0,0,0,,أنتِ من يقول ذلك؟
Dialogue: 10,0:08:03.78,0:08:06.31,Main,,0,0,0,,!المرأة الّتي قاتلت رايرين إذن
Dialogue: 10,0:08:08.12,0:08:10.28,Main,,0,0,0,,!لن أدعكِ تؤذين يوكي
Dialogue: 10,0:08:11.58,0:08:13.63,Main,,0,0,0,,لنهدأ قليلًا
Dialogue: 10,0:08:14.16,0:08:17.51,Main,,0,0,0,,جئتُنَّ لأجله، أليس كذلك؟
Dialogue: 10,0:08:17.59,0:08:19.28,Main,,0,0,0,,وأنا كذلك
Dialogue: 10,0:08:20.65,0:08:23.80,Main,,0,0,0,,لنخض منافسةً لا قتالًا
Dialogue: 10,0:08:27.01,0:08:30.10,Main,,0,0,0,,من تبرع في إغوائه أكثر تفوز
Dialogue: 10,0:08:30.14,0:08:31.04,Main,,0,0,0,,إذن، ما رأيكنَّ؟
Dialogue: 10,0:08:31.23,0:08:31.94,Main,,0,0,0,,...ما
Dialogue: 10,0:08:32.00,0:08:32.79,Main,,0,0,0,,!أقبل التَّحدّي
Dialogue: 10,0:08:32.94,0:08:33.79,Main,,0,0,0,,!ماذا؟
Dialogue: 10,0:08:51.76,0:08:54.40,Main,,0,0,0,,ألن تشاركي أنتِ أيضًا؟
Dialogue: 10,0:08:55.35,0:08:57.19,Main,,0,0,0,,تعالي إلى هنا
Dialogue: 10,0:09:01.11,0:09:02.61,Main,,0,0,0,,...أنا أيضًا
Dialogue: 10,0:09:05.51,0:09:07.23,Main,,0,0,0,,!لا، مهلًا
Dialogue: 10,0:09:07.76,0:09:09.99,Main,,0,0,0,,!الأمر غريبٌ برمّته
Dialogue: 10,0:09:13.69,0:09:15.49,Main,,0,0,0,,...جسدي ثقيلٌ
Dialogue: 10,0:09:15.92,0:09:18.42,Main,,0,0,0,,!وثمّة عدوةٌ تلمس يوكي
Dialogue: 10,0:09:18.78,0:09:21.51,Main,,0,0,0,,!كما أنّه من المستحيل أن يتقبّل هذا
Dialogue: 10,0:09:31.68,0:09:34.37,Main,,0,0,0,,هل وقعتا تحت تأثير تقنية الوهم يا ترى؟
Dialogue: 10,0:09:34.54,0:09:37.25,Main,,0,0,0,,فهي فعّالةٌ أكثر في الأماكن الضيّقة
Dialogue: 10,0:09:37.25,0:09:39.52,Main,,0,0,0,,اقتربا
Dialogue: 10,0:09:42.35,0:09:44.56,Main,,0,0,0,,التحرّك بتهوّرٍ سيُضعف التقنيّة
Dialogue: 10,0:09:45.03,0:09:48.08,Main,,0,0,0,,لذا سأنتظر اقترابهما بصبرٍ
Dialogue: 10,0:09:56.28,0:09:58.99,Main,,0,0,0,,!كما ظننت، لن ينطلي وهمٌ بسيط على قائدة
Dialogue: 10,0:09:58.99,0:10:00.93,Main,,0,0,0,,!كفاكِ ألاعيبَ رخيصةً
Dialogue: 10,0:10:09.00,0:10:10.50,Main,,0,0,0,,...أتعلمين
Dialogue: 10,0:10:10.50,0:10:13.26,Main,,0,0,0,,هذه المرّة الثانية الّتي تضربينني فيها
Dialogue: 10,0:10:13.26,0:10:16.24,Main,,0,0,0,,لن أنسى هذا
Dialogue: 10,0:10:23.77,0:10:26.46,Main,,0,0,0,,يوكي-كن، هل أنتَ بخير؟
Dialogue: 10,0:10:29.54,0:10:31.91,Main,,0,0,0,,عجبًا، ماذا حدث؟
Dialogue: 10,0:10:32.14,0:10:35.63,Main,,0,0,0,,تسلّلتْ إحدى آلهة الرعد الثمانية إلى غرفتكَ
Dialogue: 10,0:10:36.72,0:10:38.24,Main,,0,0,0,,وهذا أمرٌ لا يُغتفر
Dialogue: 10,0:10:39.55,0:10:41.78,Main,,0,0,0,,آسف، لم أشعر بشيء
Dialogue: 10,0:10:41.88,0:10:43.49,Main,,0,0,0,,كنتما تحميانني إذن
Dialogue: 10,0:10:43.91,0:10:45.20,Main,,0,0,0,,شكرًا لكما
Dialogue: 10,0:10:46.29,0:10:49.33,Main,,0,0,0,,هي من بذلتْ جهدها أولًا
Dialogue: 10,0:10:50.26,0:10:52.30,Main,,0,0,0,,أنا كنت مجرّد دعمٍ
Dialogue: 10,0:10:52.46,0:10:54.33,Main,,0,0,0,,شكرًا لكِ يا شوشو-تشان
Dialogue: 10,0:10:58.45,0:11:02.35,Main,,0,0,0,,!اعتمد عليّ، سأحميكَ دائمًا يا يوكي
Dialogue: 10,0:11:02.47,0:11:05.43,Main,,0,0,0,,سأتسلّل في المرّة القادمة
Dialogue: 10,0:11:11.78,0:11:13.45,Main,,0,0,0,,أبلغتُ المقرّ بما حدث
Dialogue: 10,0:11:13.86,0:11:16.69,Main,,0,0,0,,سننام جميعًا هنا حتّى يتمَّ تعزيز الحاجز
Dialogue: 10,0:11:16.78,0:11:19.47,Main,,0,0,0,,!هذا ممتعٌ، كأنّنا في رحلةٍ
Dialogue: 10,0:11:20.39,0:11:23.07,Main,,0,0,0,,فهمت، هكذا سارت الأمور
Dialogue: 10,0:11:23.58,0:11:25.16,Main,,0,0,0,,سنتناوب على الحراسة
Dialogue: 10,0:11:25.58,0:11:26.50,Main,,0,0,0,,!لنخلد للنوم
Dialogue: 10,0:11:29.22,0:11:33.99,Main,,0,0,0,,تعزيز الحاجز كإجراء مضادٍّ لغزو العدوّ
Dialogue: 10,0:11:34.12,0:11:37.47,Main,,0,0,0,,ظهور إحدى الآلهة في غرفته حادثةٌ مثيرةٌ للاهتمام
Dialogue: 10,0:11:39.77,0:11:42.49,Main,,0,0,0,,واكورا يوكي؟
Dialogue: 10,0:11:44.63,0:11:49.30,Main,,0,0,0,,حين يرغب الجميع بشيءٍ ما، أرغب في الحصول عليه لنفسي
Dialogue: 10,0:12:08.00,0:12:11.63,Main,,0,0,0,,لن أستسلم مهما كانت الظروف
Dialogue: 10,0:12:19.93,0:12:23.46,Main,,0,0,0,,حسنٌ، حسنٌ، الجميع نيامٌ
Dialogue: 10,0:12:24.30,0:12:28.83,Main,,0,0,0,,لتحقيق السعادة مع يوكي، لا بدَّ من بعض الجرأة
Dialogue: 10,0:12:33.57,0:12:35.24,Main,,0,0,0,,عذرًا
Dialogue: 10,0:12:37.37,0:12:38.64,Main,,0,0,0,,!تادا
Dialogue: 10,0:12:38.88,0:12:40.92,Main,,0,0,0,,أطلتُ عليكَ يا يوكي
Dialogue: 10,0:12:43.83,0:12:44.51,Main,,0,0,0,,حسنٌ
Dialogue: 10,0:12:44.55,0:12:46.54,Main,,0,0,0,,...مهاجمته وهو نائم
Dialogue: 10,0:12:47.75,0:12:51.76,Main,,0,0,0,,يا لكِ من شوكي بشريّةٍ فاجرةٍ
Dialogue: 10,0:13:03.90,0:13:05.84,Main,,0,0,0,,!مهلًا يا هيمارين
Dialogue: 10,0:13:05.84,0:13:07.95,Main,,0,0,0,,!أنا جادّة
Dialogue: 10,0:13:09.66,0:13:10.94,Main,,0,0,0,,!مؤلم
Dialogue: 10,0:13:32.19,0:13:34.19,Main,,0,0,0,,شوشو، حان وقت تبديل الحراسة
Dialogue: 10,0:13:59.95,0:14:03.08,Main,,0,0,0,,!جاءت إلى فراشي وهي نائمة
Dialogue: 10,0:14:04.09,0:14:06.52,Main,,0,0,0,,...ناي-تشان، هيّا عودي إلى فراشـ
Dialogue: 10,0:14:09.63,0:14:10.80,Main,,0,0,0,,!ناي-تشان؟
Dialogue: 10,0:14:11.59,0:14:12.60,Main,,0,0,0,,...أبي
Dialogue: 10,0:14:15.06,0:14:19.97,Main,,0,0,0,,أبي... أمي... أين أنتما؟
Dialogue: 10,0:14:20.16,0:14:23.16,Main,,0,0,0,,...صحيح، والدا ناي-تشان
Dialogue: 10,0:14:23.49,0:14:28.85,Main,,0,0,0,,اختفى والدا ناي فجأةً في أحد الأيام
Dialogue: 10,0:14:29.13,0:14:31.39,Main,,0,0,0,,وصُنّف ذلك ككارثة ماتو
Dialogue: 10,0:14:35.22,0:14:36.30,Main,,0,0,0,,لا بأس
Dialogue: 10,0:14:37.43,0:14:38.93,Main,,0,0,0,,ستعثرين عليهما حتمًا
Dialogue: 10,0:14:53.25,0:14:57.00,Main,,0,0,0,,!آسفة، آسفة، آسفة
Dialogue: 10,0:14:57.09,0:14:59.31,Main,,0,0,0,,كانت ناي تهذي أثناء نومها
Dialogue: 10,0:14:59.58,0:15:00.74,Main,,0,0,0,,لا عليكِ
Dialogue: 10,0:15:01.06,0:15:03.16,Main,,0,0,0,,يقع اللّوم على آلهة الرعد الثمانية
Dialogue: 10,0:15:04.05,0:15:05.07,Main,,0,0,0,,لنبدأ فورًا
Dialogue: 10,0:15:05.25,0:15:06.99,Main,,0,0,0,,سنجري بحثًا حول محيط المسكن
Dialogue: 10,0:15:07.55,0:15:09.43,Main,,0,0,0,,ناي، سأستخدم الإعارة
Dialogue: 10,0:15:09.62,0:15:11.68,Main,,0,0,0,,!حسنٌ، بكلِّ سرورٍ
Dialogue: 10,0:15:18.67,0:15:19.96,Main,,0,0,0,,عذرًا
Dialogue: 10,0:15:20.63,0:15:21.40,Main,,0,0,0,,ناي
Dialogue: 10,0:15:31.31,0:15:34.54,Main,,0,0,0,,الرصد مهمٌّ، لكن ابحثي عن أيّ شيءٍ مريبٍ
Dialogue: 10,0:15:35.04,0:15:36.88,Main,,0,0,0,,مثل نقوش لعنةٍ أو ما شابه
Dialogue: 10,0:15:37.12,0:15:38.78,Main,,0,0,0,,...بما أنَّ العدو تسلّل إلى هنا
Dialogue: 10,0:15:39.53,0:15:41.72,Main,,0,0,0,,فلا ندري ما الّذي زرعه حول المسكن
Dialogue: 10,0:15:54.70,0:15:55.78,Main,,0,0,0,,كلّ شيءٍ سليم
Dialogue: 10,0:15:56.01,0:15:58.40,Main,,0,0,0,,لا يوجد شيءٍ مريبٍ على الأرض أو خلف الصخور
Dialogue: 10,0:16:05.67,0:16:07.71,Main,,0,0,0,,شكرًا لجهودكَ يا يوكي-سان
Dialogue: 10,0:16:08.25,0:16:09.45,Main,,0,0,0,,وأنتِ كذلك يا ناي-تشان
Dialogue: 10,0:16:11.83,0:16:13.91,Main,,0,0,0,,تأكّدنا من سلامة المكان
Dialogue: 10,0:16:14.78,0:16:15.82,Main,,0,0,0,,وهذا مكسبٌ بحدِّ ذاته
Dialogue: 10,0:16:16.14,0:16:17.02,Main,,0,0,0,,...ومع ذلك
Dialogue: 10,0:16:17.34,0:16:19.91,Main,,0,0,0,,شعرتُ وكأنَّ أحدًا يراقبنا من الأعلى
Dialogue: 10,0:16:21.47,0:16:22.53,Main,,0,0,0,,من الأعلى؟
Dialogue: 10,0:16:27.31,0:16:28.68,Main,,0,0,0,,كنتُ أراقبكم
Dialogue: 10,0:16:29.40,0:16:31.84,Main,,0,0,0,,منذ تحوّلكَ مع ناي
Dialogue: 10,0:16:32.49,0:16:33.95,Main,,0,0,0,,!القائدة العليا
Dialogue: 10,0:16:35.55,0:16:39.04,Main,,0,0,0,,طوّرتِ قدرتكِ بشكلٍ جيّدٍ يا كيوكا
Dialogue: 10,0:16:40.11,0:16:43.41,Main,,0,0,0,,ما شروط استخدام الآخرين لقدرة العبد؟
Dialogue: 10,0:16:44.12,0:16:47.97,Main,,0,0,0,,لا يزال الأمر قيد التجربة، لذا لا يمكنني الجزم
Dialogue: 10,0:16:49.65,0:16:51.83,Main,,0,0,0,,لا بأس، أخبريني
Dialogue: 10,0:16:52.33,0:16:54.80,Main,,0,0,0,,يمكنكِ العودة لمهامكِ يا ناي
Dialogue: 10,0:16:54.89,0:16:56.02,Main,,0,0,0,,!حـ-حاضر
Dialogue: 10,0:17:01.85,0:17:04.82,Main,,0,0,0,,...عند تغيير الراكب بعد استعباد يوكي
Dialogue: 10,0:17:05.32,0:17:08.26,Main,,0,0,0,,تتغيّر خصائص العبد
Dialogue: 10,0:17:09.14,0:17:10.40,Main,,0,0,0,,...وبناءً على تلك الخصائص
Dialogue: 10,0:17:10.51,0:17:13.18,Main,,0,0,0,,قد تتّسع خياراتنا الاستراتيجيّة بشكلٍ كبيرٍ
Dialogue: 10,0:17:13.29,0:17:16.59,Main,,0,0,0,,تطوّرٌ مثيرٌ للاهتمام، أريد تجربته أنا أيضًا
Dialogue: 10,0:17:17.99,0:17:20.21,Main,,0,0,0,,الإعارة تستنزف طاقتي بشدّة
Dialogue: 10,0:17:20.33,0:17:22.35,Main,,0,0,0,,فلا يمكنني استخدامها بشكلٍ مُتتابع
Dialogue: 10,0:17:22.92,0:17:24.79,Main,,0,0,0,,!ماذا؟
Dialogue: 10,0:17:26.75,0:17:27.76,Main,,0,0,0,,...ولكن
Dialogue: 10,0:17:28.60,0:17:31.56,Main,,0,0,0,,إمكانية جعله عبدي خبرٌ سارٌّ
Dialogue: 10,0:17:35.26,0:17:37.29,Main,,0,0,0,,يوكي عبدي أنا
Dialogue: 10,0:17:47.33,0:17:50.08,Main,,0,0,0,,لديّ عملٌ في العالم الحقيقيّ لفترة
Dialogue: 10,0:17:51.07,0:17:53.63,Main,,0,0,0,,أراكَ لاحقًا يا واكورا يوكي
Dialogue: 10,0:18:08.21,0:18:09.31,Main,,0,0,0,,كيوكا-سان؟
Dialogue: 10,0:18:10.04,0:18:14.13,Main,,0,0,0,,حذّرتكَ قبل الاجتماع من النظر في عيني القائدة العليا
Dialogue: 10,0:18:14.32,0:18:15.05,Main,,0,0,0,,ماذا؟
Dialogue: 10,0:18:15.30,0:18:18.48,Main,,0,0,0,,!ومع ذلك نظرتَ إليها فورًا
Dialogue: 10,0:18:20.03,0:18:22.33,Main,,0,0,0,,!من الواضح أنّها تضعكَ نصب عينيها الآن
Dialogue: 10,0:18:22.42,0:18:23.78,Main,,0,0,0,,آ-آسف
Dialogue: 10,0:18:23.81,0:18:25.80,Main,,0,0,0,,!لم أتوقّع أنّها كانت تعلم أنّي أنظر إليها
Dialogue: 10,0:18:25.87,0:18:29.66,Main,,0,0,0,,تلك النظرة ليست السبب الوحيد لاهتمامها بكَ على الأرجح
Dialogue: 10,0:18:29.84,0:18:31.99,Main,,0,0,0,,!استعد للموت
Dialogue: 10,0:18:36.09,0:18:38.63,Main,,0,0,0,,كان يجدر بي أمركَ بدل تحذيرك
Dialogue: 10,0:18:38.99,0:18:40.40,Main,,0,0,0,,سأتوخّى الحذر
Dialogue: 10,0:18:42.59,0:18:45.01,Main,,0,0,0,,...إن نلتُ اهتمام القائدة العليا
Dialogue: 10,0:18:45.07,0:18:46.25,Main,,0,0,0,,فماذا سيحدث؟
Dialogue: 10,0:18:46.55,0:18:50.53,Main,,0,0,0,,ستتّخذ ذرائع شتّى لتعبث بكَ كدميةٍ
Dialogue: 10,0:18:50.71,0:18:52.80,Main,,0,0,0,,وبيل من الفرقة الثالثة خير مثالٍ
Dialogue: 10,0:18:53.63,0:18:54.83,Main,,0,0,0,,...دمية
Dialogue: 10,0:18:55.33,0:18:58.41,Main,,0,0,0,,سنعمل مع فِرقٍ مختلفةٍ من الآن فصاعدًا
Dialogue: 10,0:18:58.85,0:19:01.43,Main,,0,0,0,,...وإن انتشر خبر الإعارة قبل ذلك
Dialogue: 10,0:19:01.67,0:19:03.35,Main,,0,0,0,,فسيحدثُ جلبةً كبيرةً
Dialogue: 10,0:19:09.83,0:19:12.66,Main,,0,0,0,,بالمناسبة، لِكَم شخصًا سأعدُّ الطعام؟
Dialogue: 10,0:19:19.87,0:19:23.46,Main,,0,0,0,,كيوكا-سان، سأعدّ طعامًا لعشرة أشخاص اليوم، أليس كذلك؟
Dialogue: 10,0:19:23.86,0:19:26.43,Main,,0,0,0,,أجل، ولا تنسَ تجهيز الينابيع الساخنة
Dialogue: 10,0:19:26.66,0:19:28.47,Main,,0,0,0,,سيكون تدريبًا مشتركًا لثلاث فِرقٍ
Dialogue: 10,0:19:28.75,0:19:29.94,Main,,0,0,0,,سيكون يومًا حافلًا
Dialogue: 10,0:19:30.28,0:19:31.10,Main,,0,0,0,,حاضر
Dialogue: 10,0:19:31.53,0:19:34.38,Main,,0,0,0,,أنا متشوّقةٌ لطعام يوكي-كن
Dialogue: 10,0:19:34.48,0:19:36.44,Main,,0,0,0,,اعتمدي عليّ في الأعمال المنزليّة
Dialogue: 10,0:19:37.06,0:19:39.57,Main,,0,0,0,,أجل، وأنا سأجني المال
Dialogue: 10,0:19:40.14,0:19:40.78,Main,,0,0,0,,...جَنْيُ المال
Dialogue: 10,0:19:40.78,0:19:41.78,Main,,0,0,0,,!إنّهنَّ قادمات
Dialogue: 10,0:19:43.91,0:19:46.54,Main,,0,0,0,,!يا لها من قوّةٍ هائلةٍ
Dialogue: 10,0:19:46.57,0:19:49.09,Main,,0,0,0,,طريقة تنقّلهنَّ صاخبةٌ كالعادة
Dialogue: 10,0:19:49.34,0:19:52.34,Main,,0,0,0,,من المدهش أنّها لا تسبّب أيّ حوادث جانبيّة
Dialogue: 10,0:19:52.53,0:19:54.20,Main,,0,0,0,,مـ-ما هذا؟
Dialogue: 10,0:19:55.22,0:19:57.16,Main,,0,0,0,,!إنّها تقترب منّا
Dialogue: 10,0:19:59.31,0:20:00.46,Main,,0,0,0,,الفرقة الخامسة
Dialogue: 10,0:20:03.67,0:20:05.06,Main,,0,0,0,,كيف الحال؟
Dialogue: 10,0:20:05.92,0:20:08.77,Main,,0,0,0,,قائدة الفرقة الخامسة؛ إيزو ياكومو-سان
Dialogue: 10,0:20:09.02,0:20:10.79,Main,,0,0,0,,...بفضل قدرتها على المناورة
Dialogue: 10,0:20:10.99,0:20:13.50,Main,,0,0,0,,اختير مقرّ الفرقة السابعة موقعًا للتدريب
Dialogue: 10,0:20:13.90,0:20:16.71,Main,,0,0,0,,لنبذل جهدنا لجعل هذا التدريب المشترك مفيدًا للطرفين
Dialogue: 10,0:20:19.09,0:20:21.52,Main,,0,0,0,,سررتُ بلقائكما
Dialogue: 10,0:20:23.35,0:20:25.36,Main,,0,0,0,,...جسمكِ رشيقٌ ومشدودٌ
Dialogue: 10,0:20:25.36,0:20:27.00,Main,,0,0,0,,!رائع يا كيوكا
Dialogue: 10,0:20:27.34,0:20:30.00,Main,,0,0,0,,زدتِ إثارةً مؤخرًا يا تين-سان، أليس كذلك؟
Dialogue: 10,0:20:32.15,0:20:34.51,Main,,0,0,0,,تحبين التّلمُّس كعادتكِ
Dialogue: 10,0:20:35.34,0:20:37.55,Main,,0,0,0,,سأكسر إصبعكِ إن لمستِ مكانًا غريبًا
Dialogue: 10,0:20:37.86,0:20:40.35,Main,,0,0,0,,لا تبالغي، لا أرى مشكلةً في ذلك
Dialogue: 10,0:20:42.21,0:20:43.95,Main,,0,0,0,,...اصطفاف القائِدات
Dialogue: 10,0:20:44.13,0:20:45.51,Main,,0,0,0,,مشهدٌ بديعٌ
Dialogue: 10,0:20:46.47,0:20:49.17,Main,,0,0,0,,أهلًا بالعبد المشهور
Dialogue: 10,0:20:50.79,0:20:51.91,Main,,0,0,0,,المشهور؟
Dialogue: 10,0:20:52.57,0:20:55.60,Main,,0,0,0,,قدرة العبد قابلة للإعارة، أليس كذلك؟
Dialogue: 10,0:20:55.84,0:20:57.79,Main,,0,0,0,,هل سمعتِ ذلك من القائدة العليا؟
Dialogue: 10,0:20:58.26,0:20:59.81,Main,,0,0,0,,قبل قليل
Dialogue: 10,0:20:59.81,0:21:01.83,Main,,0,0,0,,سيعلم الجميع قريبًا على أيّ حال
Dialogue: 10,0:21:02.50,0:21:06.40,Main,,0,0,0,,أريد تجربة الإعارة أنا أيضًا
Dialogue: 10,0:21:06.65,0:21:08.55,Main,,0,0,0,,أنتِ من فرقةٍ أخرى
Dialogue: 10,0:21:08.70,0:21:11.19,Main,,0,0,0,,يجب أن يكون متاحًا لي وقت الحاجة
Dialogue: 10,0:21:11.56,0:21:13.62,Main,,0,0,0,,لا تقلقي بشأن ذلك
Dialogue: 10,0:21:13.73,0:21:15.76,Main,,0,0,0,,فقد أصبح التنسيق بيننا وثيقًا
Dialogue: 10,0:21:16.96,0:21:20.12,Main,,0,0,0,,هذه القدرة تتطلّب منح مكافأةٍ للعبد
Dialogue: 10,0:21:20.25,0:21:22.51,Main,,0,0,0,,لا أمانع ذلك إطلاقًا
Dialogue: 10,0:21:23.10,0:21:25.22,Main,,0,0,0,,التدريب هو الأولويّة القصوى الآن
Dialogue: 10,0:21:25.44,0:21:27.89,Main,,0,0,0,,سنناقش تعزيز القدرات لاحقًا
Dialogue: 10,0:21:28.17,0:21:30.18,Main,,0,0,0,,عُد إلى موقعكَ يا يوكي
Dialogue: 10,0:21:30.32,0:21:31.48,Main,,0,0,0,,!حـ-حاضر
Dialogue: 10,0:21:32.77,0:21:33.84,Main,,0,0,0,,!يا للخسارة
Dialogue: 10,0:21:35.80,0:21:36.66,Main,,0,0,0,,...إذن
Dialogue: 10,0:21:37.48,0:21:38.58,Main,,0,0,0,,الفرقة الخامسة
Dialogue: 10,0:21:40.10,0:21:41.10,Main,,0,0,0,,الفرقة السادسة
Dialogue: 10,0:21:42.59,0:21:44.11,Main,,0,0,0,,والفرقة السابعة
Dialogue: 10,0:21:44.29,0:21:45.09,Main,,0,0,0,,!حاضر
Dialogue: 10,0:21:45.44,0:21:47.13,Main,,0,0,0,,لنبدأ التدريب المشترك
Dialogue: 10,0:21:47.55,0:21:48.82,Main,,0,0,0,,سيكون تدريبًا شاقًا
Dialogue: 10,0:21:49.32,0:21:50.81,Top,,0,0,0,,عُلم
Dialogue: 10,0:23:26.63,0:23:29.71,Main,,0,0,0,,"في المرّة القادمة، الحلقة الثالثة: "العاصفة القادمة
Dialogue: 10,0:23:30.09,0:23:32.24,Main,,0,0,0,,!مكافأةُ اليوم
Dialogue: 10,0:23:32.46,0:23:33.97,Main,,0,0,0,,يدان ناعمتان
Dialogue: 10,0:23:33.97,0:23:35.73,Main,,0,0,0,,وفخذان مشدودان
Dialogue: 10,0:23:35.82,0:23:38.04,Main,,0,0,0,,وبشرةٌ مصقولةٌ بعنايةٍ
Dialogue: 10,0:23:38.10,0:23:40.02,Main,,0,0,0,,!الضربة القاضية مضمونة بهذا
