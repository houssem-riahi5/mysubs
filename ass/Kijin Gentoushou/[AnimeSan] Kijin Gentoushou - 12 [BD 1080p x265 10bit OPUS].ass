Dialogue: 0,0:00:05.88,0:00:07.08,Main,,0,0,0,,أشعر بالنعاس
Dialogue: 0,0:00:07.75,0:00:12.00,Main,,0,0,0,,ألا يجدر بكَ تحذير جاركَ ولو لمرّة؟
Dialogue: 0,0:00:12.04,0:00:15.25,Main,,0,0,0,,فالنوم لا يُطاق مع هذه الجلبة منذ الصباح
Dialogue: 0,0:00:15.88,0:00:16.75,Main,,0,0,0,,أنتَ محقّ
Dialogue: 0,0:00:18.21,0:00:21.58,Main,,0,0,0,,أيّها الشقيّة! هل لديكِ اعتراض؟
Dialogue: 0,0:00:21.58,0:00:22.62,Main,,0,0,0,,!مُطلقًا
Dialogue: 0,0:00:22.83,0:00:25.21,Main,,0,0,0,,!أ-أنتما، توقفا عن هذا حالًا
Dialogue: 0,0:00:25.21,0:00:26.08,Main,,0,0,0,,!مـ-مهلًا
Dialogue: 0,0:00:28.00,0:00:30.00,Main,,0,0,0,,يا لها من ضوضاء
Dialogue: 0,0:00:30.33,0:00:32.04,Main,,0,0,0,,!جـ-جينيا-كن
Dialogue: 0,0:00:32.15,0:00:34.13,Main,,0,0,0,,من أنت؟
Dialogue: 0,0:00:34.91,0:00:37.54,Main,,0,0,0,,أهو سَكِيرٌ ثائر... أم أنّه شيءٌ أعتى؟
Dialogue: 0,0:00:37.79,0:00:41.67,Main,,0,0,0,,!أعتقد أنَّ الاحتمال الثاني هو الأرجح
Dialogue: 0,0:00:41.79,0:00:42.67,Main,,0,0,0,,على الأرجح
Dialogue: 0,0:00:43.04,0:00:46.63,Main,,0,0,0,,عَمَّ تتحدث أيّها الشقي؟
Dialogue: 0,0:00:47.16,0:00:50.17,Main,,0,0,0,,أظنّه أكبر منكَ سنًّا رغم مظهره
Dialogue: 0,0:00:50.54,0:00:51.96,Main,,0,0,0,,...أتسخر مـ
Dialogue: 0,0:00:57.05,0:00:58.27,Main,,0,0,0,,!فعلها
Dialogue: 0,0:01:01.46,0:01:02.83,Main,,0,0,0,,أأنتَ التالي؟
Dialogue: 0,0:01:04.58,0:01:05.50,Main,,0,0,0,,...أيّها الوغـ
Dialogue: 0,0:01:11.63,0:01:13.46,Main,,0,0,0,,لا تتساهلُ أبدًا
Dialogue: 0,0:01:13.63,0:01:15.33,Main,,0,0,0,,بل تساهلتُ كثيرًا
Dialogue: 0,0:01:15.46,0:01:17.04,Main,,0,0,0,,لا شكَّ في ذلك
Dialogue: 0,0:01:26.58,0:01:29.04,Main,,0,0,0,,أما زلتما قادران على النهوض؟
Dialogue: 0,0:01:30.04,0:01:33.58,Main,,0,0,0,,!أيّها الوغد! سأقتلك
Dialogue: 0,0:01:34.83,0:01:36.33,Main,,0,0,0,,لا مفرّ إذن
Dialogue: 0,0:01:57.92,0:02:00.58,Main,,0,0,0,,!توقّف أيّها الوغد
Dialogue: 0,0:02:03.67,0:02:05.67,Main,,0,0,0,,ما الّذي حدث؟
Dialogue: 0,0:02:06.67,0:02:07.92,Main,,0,0,0,,ماذا فعلتَ؟
Dialogue: 0,0:02:11.71,0:02:15.38,Main,,0,0,0,,تسوكوموغامي المحار؛ يصنع السراب
Dialogue: 0,0:02:15.75,0:02:18.83,Main,,0,0,0,,يسعه إظهار ما تريده لمن تريده فقط
Dialogue: 0,0:02:18.96,0:02:20.04,Main,,0,0,0,,مُفيد، أليس كذلك؟
Dialogue: 0,0:02:20.17,0:02:21.96,Main,,0,0,0,,ما الّذي أريتهما إياه بالضبط؟
Dialogue: 0,0:02:22.46,0:02:24.83,Main,,0,0,0,,من الأفضل ألّا تسأل
Dialogue: 0,0:02:25.54,0:02:29.17,Main,,0,0,0,,جينيا-كن، شكرًا جزيلًا لك
Dialogue: 0,0:02:29.50,0:02:30.50,Main,,0,0,0,,لا عليكِ
Dialogue: 0,0:02:30.63,0:02:31.75,Main,,0,0,0,,وأنتَ أيضًا يا أكيتسو-سان
Dialogue: 0,0:02:31.96,0:02:34.92,Main,,0,0,0,,لا، لم أفعل شيئًا يُذكر
Dialogue: 0,0:02:35.17,0:02:36.83,Main,,0,0,0,,كنتَ تتفرّج فحسب
Dialogue: 0,0:02:38.96,0:02:41.46,Main,,0,0,0,,ما زلتِ كما عهدتكِ أيّتها الآنسة الصغيرة
Dialogue: 0,0:02:42.00,0:02:44.38,Main,,0,0,0,,أوفو-تشان، هل لي بطبق تيمبورا سوبا؟
Dialogue: 0,0:02:44.58,0:02:45.33,Main,,0,0,0,,حاضر
Dialogue: 0,0:02:45.71,0:02:47.83,Main,,0,0,0,,جينيا-كن، أتريد طبق كاكي سوبا؟
Dialogue: 0,0:02:48.17,0:02:48.92,Main,,0,0,0,,أجل
Dialogue: 0,0:04:22.25,0:04:23.00,Main,,0,0,0,,...إذن
Dialogue: 0,0:04:23.25,0:04:29.29,Main,,0,0,0,,كاد أبي يطرده من رئاسة الخدم، لذا فهو يعمل باستماتة منذ الصباح
Dialogue: 0,0:04:29.42,0:04:31.92,Main,,0,0,0,,هل لاحظتِ أيَّ تغيّر في تصرفات زينجي؟
Dialogue: 0,0:04:32.29,0:04:33.04,Main,,0,0,0,,ليس حقًّا
Dialogue: 0,0:04:33.71,0:04:37.42,Main,,0,0,0,,يبدو أنَّ ما حدث البارحة كان بسبب الإفراط في الشرب
Dialogue: 0,0:04:39.67,0:04:42.75,Main,,0,0,0,,آسفة لإقلاقكَ، كلّ شيء على ما يرام الآن
Dialogue: 0,0:04:43.21,0:04:44.21,Main,,0,0,0,,فهمت
Dialogue: 0,0:04:44.67,0:04:46.83,Main,,0,0,0,,حسنٌ، عليَّ الذهاب
Dialogue: 0,0:04:47.13,0:04:49.97,Main,,0,0,0,,...ربّما يتحسّن مزاج والدي إن ابتعتُ له بعض الساكي في طريقي عودتـ
Dialogue: 0,0:04:49.97,0:04:50.75,Main,,0,0,0,,لا تفعلي
Dialogue: 0,0:04:52.67,0:04:53.58,Main,,0,0,0,,لماذا؟
Dialogue: 0,0:04:53.75,0:04:57.04,Main,,0,0,0,,باتَ يشرب بقايا الثلج كلّ ليلة، أليس كذلك؟
Dialogue: 0,0:04:57.76,0:04:59.08,Main,,0,0,0,,ذلك الخمر مجهول المصدر
Dialogue: 0,0:04:59.58,0:05:02.79,Main,,0,0,0,,أخبري جوزو-دونو أن يشرب نوعًا آخر
Dialogue: 0,0:05:03.79,0:05:05.54,Main,,0,0,0,,!حـ-حسنٌ
Dialogue: 0,0:05:06.17,0:05:07.29,Main,,0,0,0,,أعتمد عليكِ
Dialogue: 0,0:05:08.17,0:05:10.79,Main,,0,0,0,,توخّي الحذر في طريق عودتكِ، فالأوضاع غير مستقرّة مؤخرًا
Dialogue: 0,0:05:11.33,0:05:15.54,Main,,0,0,0,,لم أكن أعلم أنّك تجيد إلقاء خطابات الآباء أيضًا
Dialogue: 0,0:05:15.88,0:05:18.88,Main,,0,0,0,,لكن لا تقلق، شكرًا لك
Dialogue: 0,0:05:21.58,0:05:24.71,Main,,0,0,0,,!يبدو أنَّ العصفور لا يزال عصفورًا
Dialogue: 0,0:05:25.58,0:05:28.50,Main,,0,0,0,,أجل، أمامه طريق طويل ليغدو محارًا
Dialogue: 0,0:05:37.17,0:05:40.46,Main,,0,0,0,,أهلًا أيّها الرونين، ألديكَ رفيق اليوم؟
Dialogue: 0,0:05:40.52,0:05:42.52,Main,,0,0,0,,لا تبالِ به، إنّه مجرّد صدفة
Dialogue: 0,0:05:42.58,0:05:45.58,Main,,0,0,0,,أيتوجب عليكَ أن تكون لئيمًا معي دائمًا؟
Dialogue: 0,0:05:46.25,0:05:48.29,Main,,0,0,0,,حسنٌ، لا يهم
Dialogue: 0,0:05:48.88,0:05:51.42,Main,,0,0,0,,تحقّقتُ ممّا طلبته
Dialogue: 0,0:05:51.79,0:05:53.00,Main,,0,0,0,,هل عرفتِ شيئًا؟
Dialogue: 0,0:05:54.04,0:05:56.63,Main,,0,0,0,,أين صُنع بقايا الثلج؟
Dialogue: 0,0:05:56.92,0:06:00.42,Main,,0,0,0,,وكيف دخل إلى إيدو... الأمر ليس واضحًا تمامًا
Dialogue: 0,0:06:01.04,0:06:06.29,Main,,0,0,0,,تبيّن أنَّ متجرًا للساكي في كوراماي يحتكر توريده ويوزعه في أنحاء إيدو
Dialogue: 0,0:06:06.79,0:06:08.83,Main,,0,0,0,,أتذكر ميزوكيا؟
Dialogue: 0,0:06:09.88,0:06:14.54,Main,,0,0,0,,المالك الّذي طلب منّا سابقًا القضاء على شيطانٍ استوطن مخزنه
Dialogue: 0,0:06:16.04,0:06:19.46,Main,,0,0,0,,،سأل بعض الزبائن عن مكان صنع الساكي
Dialogue: 0,0:06:19.71,0:06:24.58,Main,,0,0,0,,"لكنَّ المالك راوغ قائلًا إنّه "نوع جديد يتدفق من نبع
Dialogue: 0,0:06:25.75,0:06:30.21,Main,,0,0,0,,أيظن نفسه الابن البارّ الّذي وجد نبع كيكوسوي في الأساطير؟
Dialogue: 0,0:06:30.21,0:06:31.92,Main,,0,0,0,,يا له من رجل
Dialogue: 0,0:06:32.13,0:06:33.42,Main,,0,0,0,,أتّفق معك
Dialogue: 0,0:06:34.25,0:06:39.29,Main,,0,0,0,,خرج المالك الليلة لجلب البضاعة، ويُقال إنّه سيعود مساء الغد
Dialogue: 0,0:06:39.29,0:06:41.21,Main,,0,0,0,,لِمَ لا تذهب لمقابلته؟
Dialogue: 0,0:06:41.46,0:06:43.38,Main,,0,0,0,,أجل، شكرًا لكِ
Dialogue: 0,0:06:46.00,0:06:47.21,Main,,0,0,0,,أمر آخر
Dialogue: 0,0:06:47.79,0:06:52.76,Main,,0,0,0,,يُشاع أنَّ امرأة حسناء ذات شعرٍ ذهبيٍّ تتردد على ميزوكيا من حينٍ لآخر
Dialogue: 0,0:06:53.66,0:06:58.11,Main,,0,0,0,,ربّما صُنع بقايا الثلج في بلاد أجنبيّة
Dialogue: 0,0:06:58.11,0:06:58.91,Main,,0,0,0,,!أنتِ مُخطئة
Dialogue: 0,0:06:59.61,0:07:01.96,Main,,0,0,0,,!ماذا؟ أفزعتني
Dialogue: 0,0:07:04.13,0:07:04.88,Main,,0,0,0,,عذرًا
Dialogue: 0,0:07:05.71,0:07:09.76,Main,,0,0,0,,هل تعرف شيئًا عن هذه الحسناء الشقراء؟
Dialogue: 0,0:07:20.04,0:07:22.75,Main,,0,0,0,,أبي، كفى رجاءً
Dialogue: 0,0:07:22.80,0:07:24.39,Main,,0,0,0,,!قلتُ لكِ اخرسي
Dialogue: 0,0:07:24.41,0:07:26.60,Main,,0,0,0,,يتشاجران مجدّدًا؟
Dialogue: 0,0:07:26.76,0:07:28.65,Main,,0,0,0,,يا لهما من أبٍ وابنة
Dialogue: 0,0:07:28.92,0:07:29.92,Main,,0,0,0,,أجل
Dialogue: 0,0:07:32.25,0:07:33.79,Main,,0,0,0,,!أ-أبي
Dialogue: 0,0:07:34.75,0:07:35.21,Main,,0,0,0,,!جينيا
Dialogue: 0,0:07:45.13,0:07:47.04,Main,,0,0,0,,تحوّل إلى شيطان إذن
Dialogue: 0,0:08:33.15,0:08:34.35,Main,,0,0,0,,أحسنت
Dialogue: 0,0:08:40.17,0:08:43.42,Main,,0,0,0,,لدينا الكثير لنسأله لمالك المتجر
Dialogue: 0,0:08:50.63,0:08:51.79,Main,,0,0,0,,أبي
Dialogue: 0,0:08:52.00,0:08:52.88,Main,,0,0,0,,نعم
Dialogue: 0,0:08:53.33,0:08:54.83,Main,,0,0,0,,اعذرني
Dialogue: 0,0:09:03.40,0:09:05.79,Main,,0,0,0,,...بخصوص زينجي
Dialogue: 0,0:09:06.29,0:09:07.08,Main,,0,0,0,,ما الأمر؟
Dialogue: 0,0:09:08.08,0:09:09.08,Main,,0,0,0,,هل أنتَ غاضب؟
Dialogue: 0,0:09:10.58,0:09:14.88,Main,,0,0,0,,بل خائب أملي، رغم أنّني اعتنيتُ به
Dialogue: 0,0:09:17.50,0:09:20.04,Main,,0,0,0,,لكنّه ما زال شابًا
Dialogue: 0,0:09:20.96,0:09:27.58,Main,,0,0,0,,ما دام يعمل بجدٍّ ويعيش حياته، فلا شيء يستحيل إصلاحه
Dialogue: 0,0:09:28.04,0:09:30.50,Main,,0,0,0,,هل ستسامح زينجي؟
Dialogue: 0,0:09:31.38,0:09:33.04,Main,,0,0,0,,الأمر يعتمد عليه
Dialogue: 0,0:09:33.21,0:09:38.71,Main,,0,0,0,,حجم الخطأ لا يُقاس بالخبرة
Dialogue: 0,0:09:39.50,0:09:45.29,Main,,0,0,0,,أحيانًا لا ندرك فداحة الأمر إلّا بعد فوات الأوان
Dialogue: 0,0:09:46.04,0:09:49.50,Main,,0,0,0,,هل حدث لكَ أمر كهذا يا أبي؟
Dialogue: 0,0:09:49.75,0:09:50.70,Main,,0,0,0,,!من يدري
Dialogue: 0,0:09:51.33,0:09:55.63,Main,,0,0,0,,...لكن، حتّى لو ندمنا ندمًا شديدًا لاحقًا
Dialogue: 0,0:09:55.88,0:10:01.46,Main,,0,0,0,,على الشباب أن يعيشوا حياتهم كما يحلو لهم بتفانٍ
Dialogue: 0,0:10:02.54,0:10:04.67,Main,,0,0,0,,،وحين يتعثرون
Dialogue: 0,0:10:04.67,0:10:09.46,Main,,0,0,0,,فواجب الآباء توفير مكانٍ يعودون إليه
Dialogue: 0,0:10:10.39,0:10:14.04,Main,,0,0,0,,لذا يا ناتسو، عيشي كما يحلو لكِ
Dialogue: 0,0:10:14.42,0:10:17.17,Main,,0,0,0,,كما يحلو لي؟
Dialogue: 0,0:10:19.62,0:10:23.33,Main,,0,0,0,,فلا شيء يستحيل إصلاحه
Dialogue: 0,0:10:24.38,0:10:25.04,Main,,0,0,0,,حاضر
Dialogue: 0,0:10:26.50,0:10:30.46,Main,,0,0,0,,أبي، عليكَ التقليل من الشرب قليلًا
Dialogue: 0,0:10:30.76,0:10:33.18,Main,,0,0,0,,يطيبُ لي الشربُ الآن
Dialogue: 0,0:10:33.76,0:10:34.96,Main,,0,0,0,,بفضل صحبتكِ
Dialogue: 0,0:10:36.85,0:10:40.17,Main,,0,0,0,,صحيح، أحضرتُ لكَ بعض الحلوى
Dialogue: 0,0:10:40.58,0:10:42.58,Main,,0,0,0,,حقًّا؟ سآكلها لاحقًا
Dialogue: 0,0:10:43.58,0:10:45.88,Main,,0,0,0,,مـ-من أنتِ؟
Dialogue: 0,0:10:46.25,0:10:50.54,Main,,0,0,0,,ألكَ رغبةٌ في خمرٍ يُسقط البشر؟
Dialogue: 0,0:10:51.17,0:10:53.75,Main,,0,0,0,,يُسقط البشر؟
Dialogue: 0,0:10:54.33,0:10:59.67,Main,,0,0,0,,في قلب كلِّ امرئٍ غشاوةٌ وكدرٌ
Dialogue: 0,0:11:00.65,0:11:05.50,Main,,0,0,0,,مهما أشحتَ بنظركَ أو حاولتَ إخفاءهما، فهما قاطنان فيه
Dialogue: 0,0:11:05.77,0:11:07.58,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:11:08.13,0:11:10.83,Main,,0,0,0,,ما عليكَ سوى نبشها لتبدو جليّة
Dialogue: 0,0:11:11.04,0:11:14.88,Main,,0,0,0,,الحسد، الشهوة، الغرور
Dialogue: 0,0:11:15.90,0:11:21.11,Main,,0,0,0,,تُنحّي شرَّ النّيات جانبًا خلف وُجوهٍ رصينةٍ للتُربك أغوار قلوبهم؛
Dialogue: 0,0:11:21.79,0:11:23.21,Main,,0,0,0,,وتعكّر صفائها
Dialogue: 0,0:11:23.96,0:11:25.67,Main,,0,0,0,,...حتّى
Dialogue: 0,0:11:26.79,0:11:32.38,Main,,0,0,0,,تصبغ الكراهية القلب الحقيقي بالبياض كالثلج
Dialogue: 0,0:11:33.44,0:11:35.09,Main,,0,0,0,,...واسمه
Dialogue: 0,0:11:35.36,0:11:36.97,Main,,0,0,0,,بقايا الثلج
Dialogue: 0,0:11:37.75,0:11:40.13,Main,,0,0,0,,...إن صُبغ الجميع بالكراهية
Dialogue: 0,0:11:40.54,0:11:42.54,Main,,0,0,0,,فهل سيلاحظني يا ترى؟
Dialogue: 0,0:11:44.25,0:11:45.26,Main,,0,0,0,,...سأنتظارك
Dialogue: 0,0:11:46.03,0:11:47.25,Main,,0,0,0,,هنا
Dialogue: 0,0:12:13.04,0:12:17.54,Main,,0,0,0,,بهذا سأغدو التاجر الأول في إيدو
Dialogue: 0,0:12:21.13,0:12:23.58,Main,,0,0,0,,تبدو تجارتكَ رابحة يا ميزوكيا
Dialogue: 0,0:12:24.92,0:12:26.21,Main,,0,0,0,,...أنتَ
Dialogue: 0,0:12:26.42,0:12:30.00,Main,,0,0,0,,التقينا قبل عامين، أتذكرني؟
Dialogue: 0,0:12:30.21,0:12:32.29,Main,,0,0,0,,أ-أجل، بالطبع
Dialogue: 0,0:12:32.83,0:12:36.13,Main,,0,0,0,,أنتَ من قضى على الشيطان في المخزن
Dialogue: 0,0:12:36.56,0:12:41.75,Main,,0,0,0,,أنا ممتنّ لكَ، لكن لا يحقّ لكَ دخول ملكيتي دون إذن
Dialogue: 0,0:12:42.04,0:12:45.75,Main,,0,0,0,,لديَّ عمل معكَ، وسأغادر فور انتهائه
Dialogue: 0,0:12:46.13,0:12:48.46,Main,,0,0,0,,وما هو؟
Dialogue: 0,0:12:48.94,0:12:50.50,Main,,0,0,0,,أبحث عن ساكي معيّن
Dialogue: 0,0:12:51.58,0:12:54.00,Main,,0,0,0,,لديكَ بقايا الثلج، أليس كذلك؟
Dialogue: 0,0:12:55.04,0:12:56.21,Main,,0,0,0,,...ذلك
Dialogue: 0,0:12:57.19,0:12:58.80,Main,,0,0,0,,يا له من منظر
Dialogue: 0,0:12:58.98,0:12:59.88,Main,,0,0,0,,من أنتَ؟
Dialogue: 0,0:12:59.93,0:13:01.65,Main,,0,0,0,,كلّ هذا بقايا الثلج
Dialogue: 0,0:13:01.67,0:13:02.45,Main,,0,0,0,,!أنت
Dialogue: 0,0:13:02.46,0:13:04.13,Main,,0,0,0,,!إنّها كميّةٌ مهولةٌ حقًّا
Dialogue: 0,0:13:05.75,0:13:10.42,Main,,0,0,0,,إنّه ساكي رائج ولم أجده في أيّ متجر، كنتُ في ورطة
Dialogue: 0,0:13:12.17,0:13:16.42,Main,,0,0,0,,بالطبع، فقد جلبته للتو
Dialogue: 0,0:13:16.58,0:13:18.37,Main,,0,0,0,,حقًّا؟ ومن أين؟
Dialogue: 0,0:13:18.67,0:13:23.17,Main,,0,0,0,,لا يمكنني إخبارك، فهذا مصدر رزقي
Dialogue: 0,0:13:24.00,0:13:25.58,Main,,0,0,0,,هذا مؤسف
Dialogue: 0,0:13:26.00,0:13:29.88,Main,,0,0,0,,إذن، سأغيّر أسلوبي في السؤال
Dialogue: 0,0:13:36.88,0:13:39.29,Main,,0,0,0,,ناتسو، أتشربين؟
Dialogue: 0,0:13:40.02,0:13:41.12,Main,,0,0,0,,...ولكن
Dialogue: 0,0:13:45.42,0:13:47.04,Main,,0,0,0,,حسنٌ، رشفة واحدة فقط
Dialogue: 0,0:13:52.46,0:13:54.17,Main,,0,0,0,,هلّا سكبتِ لي كأسًا؟
Dialogue: 0,0:13:54.54,0:13:55.54,Main,,0,0,0,,حاضر
Dialogue: 0,0:14:07.88,0:14:11.42,Main,,0,0,0,,لذيذ، ألا تظنين ذلك؟
Dialogue: 0,0:14:17.25,0:14:20.29,Main,,0,0,0,,كثرت الحوادث الغريبة مؤخرًا
Dialogue: 0,0:14:20.83,0:14:23.42,Main,,0,0,0,,أشخاص يرتكبون الجرائم تحت تأثير السُكر
Dialogue: 0,0:14:23.67,0:14:26.96,Main,,0,0,0,,وجميعهم شربوا بقايا الثلج
Dialogue: 0,0:14:29.13,0:14:33.17,Main,,0,0,0,,هذا الساكي ليس عاديًا، من أين حصلتَ عليه؟
Dialogue: 0,0:14:33.67,0:14:35.38,Main,,0,0,0,,!أ-أوياما
Dialogue: 0,0:14:35.58,0:14:38.56,Main,,0,0,0,,،ثمّة نبع في منتصف جبل أوياما بمقاطعة ساغامي
Dialogue: 0,0:14:38.63,0:14:40.88,Main,,0,0,0,,!مـ-من هناك يتدفق
Dialogue: 0,0:14:41.17,0:14:43.42,Main,,0,0,0,,!كلّ ما فعلته هو تعبئته
Dialogue: 0,0:14:44.15,0:14:46.63,Main,,0,0,0,,فهمت، لا تبالي بحياتكَ إذن
Dialogue: 0,0:14:47.03,0:14:48.60,Main,,0,0,0,,عنادكَ مثير للإعجاب
Dialogue: 0,0:14:48.85,0:14:50.83,Main,,0,0,0,,خذه معكَ إلى القبر
Dialogue: 0,0:14:52.13,0:14:53.47,Main,,0,0,0,,!لا أكذب
Dialogue: 0,0:14:53.52,0:14:57.08,Main,,0,0,0,,!النبع كلّه خمر، صدّقني رجاءً
Dialogue: 0,0:14:57.50,0:14:59.83,Main,,0,0,0,,إذن، ما حقيقة هذا الخمر؟
Dialogue: 0,0:15:00.04,0:15:01.73,Main,,0,0,0,,!لـ-لا أعرف
Dialogue: 0,0:15:01.74,0:15:05.03,Main,,0,0,0,,!تلك المرأة هي من أخبرتني
Dialogue: 0,0:15:05.13,0:15:06.13,Main,,0,0,0,,امرأة؟
Dialogue: 0,0:15:06.60,0:15:10.88,Main,,0,0,0,,امرأة ذات شعر ذهبيّ، قالت إنَّ من يدمن شربه ستتملّكه الكراهية
Dialogue: 0,0:15:11.30,0:15:13.29,Main,,0,0,0,,هذا كلّ ما أخبرتني به
Dialogue: 0,0:15:13.92,0:15:16.46,Main,,0,0,0,,وبعته رغم علمكَ بذلك؟
Dialogue: 0,0:15:16.67,0:15:22.21,Main,,0,0,0,,!قلتُ إنَّ الإفراط فيه يسبب الجنون قليلًا، وهذا طبيعي في الخمر
Dialogue: 0,0:15:22.38,0:15:24.71,Main,,0,0,0,,!ما العيب في أن يبيع التاجر بضاعته؟
Dialogue: 0,0:15:25.08,0:15:27.67,Main,,0,0,0,,من أجل المال إذن
Dialogue: 0,0:15:28.00,0:15:31.42,Main,,0,0,0,,ظننتُ أنَّ لديكَ سببًا وجيهًا، لكنّكَ مجرّد حثالة
Dialogue: 0,0:15:32.38,0:15:36.21,Main,,0,0,0,,جينيا، هذا الرجل مجرّد بائع
Dialogue: 0,0:15:36.42,0:15:38.04,Main,,0,0,0,,لكنّنا تأكدنا من الأمر
Dialogue: 0,0:15:38.64,0:15:42.38,Main,,0,0,0,,سبب الاضطرابات هو بقايا الثلج بلا ريب
Dialogue: 0,0:15:42.63,0:15:45.79,Main,,0,0,0,,لنتخلص من الخمر هنا، ثمَّ نتجه إلى أوياما
Dialogue: 0,0:15:46.13,0:15:47.67,Main,,0,0,0,,!تـ-تتخلص منه؟
Dialogue: 0,0:15:47.71,0:15:49.42,Main,,0,0,0,,!ماذا تقول؟
Dialogue: 0,0:15:49.71,0:15:53.33,Main,,0,0,0,,بالطبع، لا يمكننا ترك شيء خطير كهذا
Dialogue: 0,0:15:54.08,0:15:55.58,Main,,0,0,0,,!لا تعبث معي
Dialogue: 0,0:15:57.71,0:16:00.04,Main,,0,0,0,,ما زال لديَّ ما أسألكَ عنه
Dialogue: 0,0:16:00.04,0:16:01.25,Main,,0,0,0,,...مهلًا، أنتَ
Dialogue: 0,0:16:02.08,0:16:05.00,Main,,0,0,0,,أخبرني بكلّ شيء عن تلك المرأة
Dialogue: 0,0:16:10.38,0:16:12.25,Main,,0,0,0,,!قلتُ لكَ تكلم
Dialogue: 0,0:16:15.42,0:16:16.46,Main,,0,0,0,,!توقّف
Dialogue: 0,0:16:21.58,0:16:24.17,Main,,0,0,0,,مؤلم! هل أنتَ جدار؟
Dialogue: 0,0:16:24.46,0:16:27.71,Main,,0,0,0,,سيموت إن لم تتوقّف حقًّا
Dialogue: 0,0:16:28.79,0:16:32.21,Main,,0,0,0,,تلك المرأة الشقراء، هل تعرفها؟
Dialogue: 0,0:16:32.75,0:16:33.53,Main,,0,0,0,,كلّا
Dialogue: 0,0:16:34.37,0:16:36.92,Main,,0,0,0,,لن أرغمكَ على التحدث
Dialogue: 0,0:16:37.04,0:16:41.92,Main,,0,0,0,,لكن إن قتلتَه، سأضطر لقتلكَ، أليس كذلك؟
Dialogue: 0,0:16:42.50,0:16:45.88,Main,,0,0,0,,أنتَ محقّ، شكرًا لإيقافي
Dialogue: 0,0:16:46.21,0:16:50.71,Main,,0,0,0,,!توقّف، ماذا عساي أقوله حين تشكرني على لكمك
Dialogue: 0,0:16:51.04,0:16:52.33,Main,,0,0,0,,!لن أسمح لكما
Dialogue: 0,0:16:52.63,0:16:53.80,Main,,0,0,0,,!لن أسمح لكما
Dialogue: 0,0:16:53.81,0:16:55.50,Main,,0,0,0,,!لا، هذا خمري
Dialogue: 0,0:16:58.26,0:17:00.32,Main,,0,0,0,,!أنت، ماذا تفعل؟
Dialogue: 0,0:17:00.34,0:17:01.71,Main,,0,0,0,,!لا تشربه
Dialogue: 0,0:17:01.96,0:17:05.50,Main,,0,0,0,,!اخرس، تريدون سرقته منّي
Dialogue: 0,0:17:06.23,0:17:08.38,Main,,0,0,0,,!توقّف، لن تتمكن من العودة
Dialogue: 0,0:17:22.25,0:17:24.33,Main,,0,0,0,,الجميع يحمل الكراهية
Dialogue: 0,0:17:24.88,0:17:29.29,Main,,0,0,0,,لكنَّ هذا الخمر يؤججها لتصبح حقدًا
Dialogue: 0,0:17:30.08,0:17:32.29,Main,,0,0,0,,ويُسقط البشر ليغدوا شياطين
Dialogue: 0,0:17:32.83,0:17:36.96,Main,,0,0,0,,بقايا الثلج خمر صُنع ليخلق الشياطين
Dialogue: 0,0:17:37.25,0:17:38.88,Main,,0,0,0,,...أذكر ذلك الفتى كيكو
Dialogue: 0,0:17:39.50,0:17:42.88,Main,,0,0,0,,أردتَ أن تُري ذلك للصبيّ في متجرك
Dialogue: 0,0:17:43.20,0:17:45.04,Main,,0,0,0,,!وجعلته يشربه أيضًا
Dialogue: 0,0:17:45.75,0:17:49.50,Main,,0,0,0,,!فقط لتعرف العواقب بنفسك
Dialogue: 0,0:18:21.77,0:18:24.25,Main,,0,0,0,,هجماتكَ عشوائيّة
Dialogue: 0,0:18:24.54,0:18:25.83,Main,,0,0,0,,تسوكوموغامي؟
Dialogue: 0,0:18:26.08,0:18:29.40,Main,,0,0,0,,فوكوراسوزومي، يمنحني الحماية
Dialogue: 0,0:18:29.60,0:18:30.88,Main,,0,0,0,,لطيف أليس كذلك؟
Dialogue: 0,0:18:31.04,0:18:32.92,Main,,0,0,0,,شكرًا، أنقذتني
Dialogue: 0,0:18:33.08,0:18:34.17,Main,,0,0,0,,لا عليك
Dialogue: 0,0:18:48.50,0:18:50.54,Main,,0,0,0,,!انطلق يا طائري الورقي
Dialogue: 0,0:19:07.25,0:19:10.63,Main,,0,0,0,,إنّه قويّ للغاية بالنسبة لمولود جديد
Dialogue: 0,0:19:10.87,0:19:12.47,Main,,0,0,0,,!ثمّة خطب ما
Dialogue: 0,0:19:14.63,0:19:16.67,Main,,0,0,0,,!كان هذا مدبّرًا منذ البداية
Dialogue: 0,0:19:17.25,0:19:19.83,Main,,0,0,0,,لا، بل كان فخًا مُدبّرًا
Dialogue: 0,0:19:21.46,0:19:27.38,Main,,0,0,0,,...إن كان الخمر من صُنع تلك المرأة وليس نبعًا طبيعيًّا
Dialogue: 0,0:19:28.17,0:19:34.33,Main,,0,0,0,,فلا عجب أنّه صُمّم لردع من يتقصى حقيقته
Dialogue: 0,0:19:34.93,0:19:36.69,Main,,0,0,0,,أيُعقل هذا؟
Dialogue: 0,0:19:37.13,0:19:39.03,Main,,0,0,0,,من تكون تلك المرأة؟
Dialogue: 0,0:19:45.63,0:19:46.89,Main,,0,0,0,,...أنتِ
Dialogue: 0,0:19:47.77,0:19:49.92,Main,,0,0,0,,!ما الّذي فعلتِه؟
Dialogue: 0,0:19:52.58,0:19:54.92,Main,,0,0,0,,ما بكَ متوتر هكذا؟
Dialogue: 0,0:19:54.98,0:19:59.67,Main,,0,0,0,,لا وقت لدينا، والد ناتسو يشرب ذلك الخمر كلّ ليلة
Dialogue: 0,0:19:59.96,0:20:01.17,Main,,0,0,0,,والد الآنسة الصغيرة؟
Dialogue: 0,0:20:01.54,0:20:03.92,Main,,0,0,0,,فهمت، هذا سيّء
Dialogue: 0,0:20:04.22,0:20:08.71,Main,,0,0,0,,اذهب يا جينيا، سأتولى أمره
Dialogue: 0,0:20:08.96,0:20:10.42,Main,,0,0,0,,أكيتسو ماساغورو
Dialogue: 0,0:20:10.75,0:20:12.54,Main,,0,0,0,,ما هذا الوجه؟
Dialogue: 0,0:20:12.79,0:20:16.75,Main,,0,0,0,,أتظن أنّني سأعجز عن هزيمته؟
Dialogue: 0,0:20:18.92,0:20:20.63,Main,,0,0,0,,لا تستخف بي
Dialogue: 0,0:20:21.00,0:20:26.50,Main,,0,0,0,,البشر عنيدون للغاية، وأكثر ممّا تتخيله
Dialogue: 0,0:20:27.09,0:20:29.67,Main,,0,0,0,,لذا اذهب إلى الآنسة الصغيرة
Dialogue: 0,0:20:29.92,0:20:30.83,Main,,0,0,0,,...ولكن
Dialogue: 0,0:20:31.42,0:20:37.42,Main,,0,0,0,,ليكن في علمك، مهاراتي ليست ضعيفة ليقلق عليَّ شيطان
Dialogue: 0,0:20:37.75,0:20:38.79,Main,,0,0,0,,ممتنّ لك
Dialogue: 0,0:20:42.88,0:20:47.04,Main,,0,0,0,,حسنٌ، قد أضطر لمواجهته يومًا ما
Dialogue: 0,0:20:47.29,0:20:49.08,Main,,0,0,0,,سأكشف عن ورقتي الرابحة
Dialogue: 0,0:20:50.75,0:20:51.96,Main,,0,0,0,,حسنٌ، لنبدأ
Dialogue: 0,0:20:54.59,0:20:56.75,Main,,0,0,0,,!أقبل يا شوكي-ساما
Dialogue: 0,0:21:03.21,0:21:04.50,Main,,0,0,0,,أتفاجأت؟
Dialogue: 0,0:21:04.71,0:21:08.46,Main,,0,0,0,,...حين ألمَّ العياءُ بإمبراطور الصين
Dialogue: 0,0:21:08.46,0:21:13.21,Main,,0,0,0,,سحق شوكي-ساما الشيطان الّذي تملكه بسهولةٍ
Dialogue: 0,0:21:14.00,0:21:16.67,Main,,0,0,0,,خبرته في قتال الشياطين مختلفة عنكم تمامًا
Dialogue: 0,0:21:17.11,0:21:19.73,Main,,0,0,0,,...إن كنتَ تُصِرّ على صدام العمالقة
Dialogue: 0,0:21:19.75,0:21:21.17,Main,,0,0,0,,!فهلمّ إليّ
Dialogue: 0,0:21:43.46,0:21:44.29,Main,,0,0,0,,!أرجوك
Dialogue: 0,0:21:48.08,0:21:49.61,Main,,0,0,0,,!لأصل في الوقت المناسب
Dialogue: 0,0:22:04.63,0:22:05.59,Main,,0,0,0,,...سأنتظارك
Dialogue: 0,0:22:06.60,0:22:07.92,Main,,0,0,0,,هنا
Comment: 0,0:00:00.00,0:00:00.00,Notes,,0,0,0,,
Comment: 0,0:00:00.00,0:00:00.00,Notes,,0,0,0,,> > > > > Start Main Notes < < < < <
