Dialogue: 0,0:00:15.63,0:00:17.25,Main,,0,0,0,,صباح الخير يا زينجي-سان
Dialogue: 0,0:00:17.25,0:00:18.54,Main,,0,0,0,,صباح الخير
Dialogue: 0,0:00:18.79,0:00:21.38,Main,,0,0,0,,تبدينَ اليوم أكثر جمالًا من الأمس
Dialogue: 0,0:00:21.38,0:00:22.67,Main,,0,0,0,,هل حدث شيء مميز؟
Dialogue: 0,0:00:22.67,0:00:24.04,Main,,0,0,0,,!لا
Dialogue: 0,0:00:24.58,0:00:27.58,Main,,0,0,0,,زينجي، أراكَ مُفعمًا بالحيوية هذا الصباح
Dialogue: 0,0:00:27.58,0:00:29.29,Main,,0,0,0,,!لا لا، بل أنتَ كذلك
Dialogue: 0,0:00:29.29,0:00:31.79,Main,,0,0,0,,ما رأيكَ أن تمرّ علينا بعد العمل إن كان ذلك يناسبك؟
Dialogue: 0,0:00:31.79,0:00:33.04,Main,,0,0,0,,سأفكر في الأمر
Dialogue: 0,0:00:37.04,0:00:38.21,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:00:54.92,0:00:57.13,Main,,0,0,0,,أعتذر عن التأخير يا سيدي
Dialogue: 0,0:01:01.54,0:01:03.13,Main,,0,0,0,,هل هذا بخصوص رينا؟
Dialogue: 0,0:01:03.88,0:01:04.63,Main,,0,0,0,,أجل
Dialogue: 0,0:01:05.63,0:01:07.04,Main,,0,0,0,,سأترك الباقي عليك
Dialogue: 0,0:01:07.50,0:01:10.25,Main,,0,0,0,,وأطلعه على كافة التفاصيل بنفسك
Dialogue: 0,0:02:56.92,0:03:00.21,Main,,0,0,0,,أنا زينجي، وأعمل مساعدًا في متجر سوغايا
Dialogue: 0,0:03:01.75,0:03:03.13,Main,,0,0,0,,أُدعى جينيا
Dialogue: 0,0:03:04.79,0:03:06.63,Main,,0,0,0,,تشرفتُ بمعرفتك
Dialogue: 0,0:03:06.92,0:03:08.13,Main,,0,0,0,,...أعلم أن هذا مباشر، ولكن
Dialogue: 0,0:03:08.14,0:03:10.21,Main,,0,0,0,,كم مقدار ما أطلعك سيّدي عليه؟
Dialogue: 0,0:03:11.46,0:03:16.25,Main,,0,0,0,,حدثني جوزو-دونو عن ابنته المتبناة الّتي يحبها كثيرًا
Dialogue: 0,0:03:16.83,0:03:20.75,Main,,0,0,0,,ويخشى أن تكون حياتها مهددةً من قِبل شيطانٍ، وهذا ما يستدعي قتله
Dialogue: 0,0:03:21.21,0:03:22.17,Main,,0,0,0,,هذا جلّ ما قيل لي
Dialogue: 0,0:03:22.54,0:03:25.33,Main,,0,0,0,,ألم يُفصح لكَ عن أيّ تفاصيل إضافية؟
Dialogue: 0,0:03:28.67,0:03:33.29,Main,,0,0,0,,المطلوب منك هو حراسة الآنسة ناتسو الّتي ستبلغ 13 عامًا هذه السنة
Dialogue: 0,0:03:33.67,0:03:37.92,Main,,0,0,0,,أصبح سيّدي متعلقًا بها بشدّة، حتّى أنّه لا يطيق أن يصيبها مكروه
Dialogue: 0,0:03:38.08,0:03:39.87,Main,,0,0,0,,لكن بدأ الأمر منذ حوالي ثلاثة أيام
Dialogue: 0,0:03:40.17,0:03:46.58,Main,,0,0,0,,"ظهر شيطان في الحديقة الّتي تُطل عليها نافذة غرفة ابنته وهو يكرر عبارة "أعيدوا لي ابنتي
Dialogue: 0,0:03:46.96,0:03:48.50,Main,,0,0,0,,أعيدوا لي ابنتي؟
Dialogue: 0,0:03:48.71,0:03:54.46,Main,,0,0,0,,أجل، الخلاصة هي أن الشيطان يسعى لخطف الآنسة ناتسو لأنّه يعتقد أنّها ابنته
Dialogue: 0,0:03:54.46,0:03:55.42,Main,,0,0,0,,!زينجي
Dialogue: 0,0:03:56.04,0:03:57.63,Main,,0,0,0,,ما الّذي تفعله بالتكاسل هنا؟
Dialogue: 0,0:03:58.58,0:04:00.58,Main,,0,0,0,,!سأخبر والدي بهذا
Dialogue: 0,0:04:02.63,0:04:04.04,Main,,0,0,0,,!الآنسة ناتسو؟
Dialogue: 0,0:04:04.46,0:04:07.17,Main,,0,0,0,,هل أنتَ الحارس الشخصي الّذي عيّنه والدي لحمايتي؟
Dialogue: 0,0:04:07.17,0:04:08.71,Main,,0,0,0,,تبدو يافعًا في السنّ
Dialogue: 0,0:04:09.00,0:04:10.53,Main,,0,0,0,,أُدعى جينيا
Dialogue: 0,0:04:09.71,0:04:11.34,Top,,0,0,0,,!لا أرغب في أيّ مقدمات
Dialogue: 0,0:04:11.50,0:04:12.78,Main,,0,0,0,,يمكنك الانصراف
Dialogue: 0,0:04:12.79,0:04:15.50,Main,,0,0,0,,!أيّتها الآنسة، ما الّذي تقولينه هكذا فجأة
Dialogue: 0,0:04:15.71,0:04:20.04,Main,,0,0,0,,!من الواضح أنّه مجرد محتالٍ استغل هذه الحكاية المريبة لكسب بعض المال اليسير
Dialogue: 0,0:04:20.04,0:04:24.34,Main,,0,0,0,,حسنٌ، السيّد هو من اختاره شخصيًا، لذا أستبعد أن يكون محتالًا
Dialogue: 0,0:04:24.36,0:04:25.46,Main,,0,0,0,,!اصمت
Dialogue: 0,0:04:26.58,0:04:29.13,Main,,0,0,0,,أكره فكرة أن يكون حارسي الشخصي رونين
Dialogue: 0,0:04:29.13,0:04:31.96,Main,,0,0,0,,لن ندفع لكَ أيّ فلسٍ واحد
Dialogue: 0,0:04:32.08,0:04:34.17,Main,,0,0,0,,اطرد هذا الشخص بسرعة
Dialogue: 0,0:04:34.17,0:04:34.79,Main,,0,0,0,,!ماذا؟
Dialogue: 0,0:04:39.92,0:04:43.71,Main,,0,0,0,,!في الواقع، كلّ من الأب والابنة متشابهان سواءٌ في حملهما للأسلحة أو فظاظتهما
Dialogue: 0,0:04:46.21,0:04:47.21,Main,,0,0,0,,آسف
Dialogue: 0,0:04:55.67,0:04:56.58,Main,,0,0,0,,أيّتها الآنسة
Dialogue: 0,0:04:57.48,0:04:58.42,Main,,0,0,0,,زينجي؟
Dialogue: 0,0:04:58.75,0:05:01.67,Main,,0,0,0,,ما الّذي تفعله؟ وفي هذه الساعة المتأخرة من الليل؟
Dialogue: 0,0:05:02.00,0:05:06.25,Main,,0,0,0,,حسنٌ، هذا لأنّكِ رفضتِ الحارس الشخصي
Dialogue: 0,0:05:06.75,0:05:11.46,Main,,0,0,0,,فقلتُ في نفسي ربما وجودي قد يكون نافعًا لردع الشياطين مثلما تُستخدم الفزّاعات لطرد الطيور
Dialogue: 0,0:05:12.58,0:05:13.63,Main,,0,0,0,,زينجي
Dialogue: 0,0:05:15.38,0:05:20.25,Main,,0,0,0,,تتفوه بهذا الكلام، لكنّك في قرارة نفسك تظن أنّي كاذبة، أليس كذلك؟
Dialogue: 0,0:05:20.67,0:05:21.75,Main,,0,0,0,,...في الواقع
Dialogue: 0,0:05:25.29,0:05:26.46,Main,,0,0,0,,كما توقعت
Dialogue: 0,0:05:27.33,0:05:29.54,Main,,0,0,0,,حتّى والدي يظن أنّي أكذب
Dialogue: 0,0:05:29.71,0:05:31.66,Main,,0,0,0,,لهذا وظف ذلك الرونين لحمايتي
Dialogue: 0,0:05:31.96,0:05:33.40,Main,,0,0,0,,هذا جلي
Dialogue: 0,0:05:34.25,0:05:36.17,Main,,0,0,0,,أعتقد أنّكِ مخطئةٌ في ذلك
Dialogue: 0,0:05:36.63,0:05:41.13,Main,,0,0,0,,السيّد يهتم لأمركِ ويشعر بالقلق عليكِ طوال الوقت
Dialogue: 0,0:05:41.67,0:05:43.71,Main,,0,0,0,,هذا أمرٌ لا شك فيه
Dialogue: 0,0:05:44.38,0:05:48.46,Main,,0,0,0,,لكنّك تعلم أنّي لستُ ابنته من صُلبه
Dialogue: 0,0:05:48.46,0:05:49.54,Main,,0,0,0,,...أعيدوا لي
Dialogue: 0,0:05:52.79,0:05:54.17,Main,,0,0,0,,ما الخطب أيّتها الآنسة؟
Dialogue: 0,0:05:54.46,0:05:56.69,Main,,0,0,0,,!لقد جاء، لقد جاء
Dialogue: 0,0:05:56.70,0:05:57.71,Main,,0,0,0,,!ما الّذي قد جاء؟
Dialogue: 0,0:05:57.71,0:06:00.00,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:03.29,0:06:04.25,Main,,0,0,0,,!هذا مُحال
Dialogue: 0,0:06:04.71,0:06:05.75,Main,,0,0,0,,!زينجي
Dialogue: 0,0:06:06.13,0:06:08.17,Main,,0,0,0,,!أيّتها الآنسة، لا تبارحِ الغرفة رجاءً
Dialogue: 0,0:06:12.08,0:06:15.29,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:17.21,0:06:19.46,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:20.50,0:06:23.04,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:24.00,0:06:26.13,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:24.58,0:06:27.00,Top,,0,0,0,,!أيّتها الآنسة، سيكون كلّ شيءٍ على ما يرام
Dialogue: 0,0:06:27.00,0:06:28.71,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:39.08,0:06:40.25,Main,,0,0,0,,ما اسمك؟
Dialogue: 0,0:06:43.17,0:06:45.63,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:46.38,0:06:51.04,Main,,0,0,0,,!أعيدوا لي... ابنتي
Dialogue: 0,0:07:02.79,0:07:04.58,Main,,0,0,0,,!يـ-يا لقوته
Dialogue: 0,0:07:07.04,0:07:07.83,Main,,0,0,0,,تلاشى
Dialogue: 0,0:07:08.92,0:07:10.54,Main,,0,0,0,,هل أنتِ بخير أيّتها الآنسة؟
Dialogue: 0,0:07:11.08,0:07:13.29,Main,,0,0,0,,!أأنتَ... الرونين الّذي كان هنا سابقًا
Dialogue: 0,0:07:14.58,0:07:18.33,Main,,0,0,0,,حسنٌ إذن، كم ستدفعين لي مقابل قطعي للشيطان؟
Dialogue: 0,0:07:20.08,0:07:21.25,Main,,0,0,0,,هل مات؟
Dialogue: 0,0:07:24.29,0:07:27.50,Main,,0,0,0,,حين يموت الشياطين، يتحولون إلى غبار أبيض ثمَّ يتلاشون
Dialogue: 0,0:07:28.13,0:07:31.75,Main,,0,0,0,,إلى هذه اللحظة، لم أرَ شيطانًا يموت بغير هذه الطريقة
Dialogue: 0,0:07:32.25,0:07:34.50,Main,,0,0,0,,...هذا يعني أنَّ ذلك الشيطان
Dialogue: 0,0:07:34.50,0:07:35.73,Main,,0,0,0,,سيعود مجدّدًا
Dialogue: 0,0:07:36.67,0:07:39.46,Main,,0,0,0,,...أيعقل أنَّ ذلك الشيطان
Dialogue: 0,0:07:50.60,0:07:52.18,Main,,0,0,0,,كنتَ عونًا لي البارحة
Dialogue: 0,0:07:52.72,0:07:55.06,Main,,0,0,0,,قلتَ إنّ الشيطان سيعود ليلة البارحة
Dialogue: 0,0:07:55.14,0:07:57.44,Main,,0,0,0,,آسف، لكننا سنحتاج مساعدتكَ هذه الليلة أيضًا
Dialogue: 0,0:07:57.52,0:07:58.52,Main,,0,0,0,,بكلّ سرور
Dialogue: 0,0:07:59.69,0:08:00.98,Main,,0,0,0,,زينجي-دونو
Dialogue: 0,0:08:01.06,0:08:04.57,Main,,0,0,0,,هل تمانع إخباري ببعض التفاصيل الإضافية عن ناتسو-دونو؟
Dialogue: 0,0:08:04.65,0:08:05.82,Main,,0,0,0,,عن الآنسة ناتسو؟
Dialogue: 0,0:08:05.90,0:08:07.49,Main,,0,0,0,,"أعيدوا لي ابنتي"
Dialogue: 0,0:08:08.11,0:08:10.28,Main,,0,0,0,,يساورني بعض القلق حيال ما قاله ذلك الشيطان
Dialogue: 0,0:08:10.37,0:08:11.91,Main,,0,0,0,,فهمت
Dialogue: 0,0:08:12.41,0:08:16.58,Main,,0,0,0,,والدا الآنسة الحقيقيان هُما في الواقع من أقارب السيّد
Dialogue: 0,0:08:16.66,0:08:17.96,Main,,0,0,0,,لكنّهما تُوفيا منذ زمن بعيد
Dialogue: 0,0:08:18.54,0:08:20.71,Main,,0,0,0,,...أتفهم سبب قلقك، ولكن
Dialogue: 0,0:08:20.79,0:08:22.88,Main,,0,0,0,,اطمئن، هذا ضرب من المستحيل
Dialogue: 0,0:08:22.96,0:08:24.55,Main,,0,0,0,,،فضلًا عن ذلك، لو كان ما تفكر فيه صحيحًا
Dialogue: 0,0:08:24.63,0:08:26.84,Main,,0,0,0,,لما تبناها السيّد في المقام الأول
Dialogue: 0,0:08:29.93,0:08:32.47,Main,,0,0,0,,قُتلتْ زوجته على يد شيطان
Dialogue: 0,0:08:32.55,0:08:34.97,Main,,0,0,0,,ويبدو أنَّ ابنه خرج من المنزل ولم يعد منذئذٍ
Dialogue: 0,0:08:35.39,0:08:38.06,Main,,0,0,0,,ظلّ السيّد يقول إنَّ الشياطين هي المسؤولة عن كلّ ما حدث
Dialogue: 0,0:08:40.27,0:08:44.73,Main,,0,0,0,,بالنسبة له، الشياطين هُم أعداؤه الّذين سلبوه عائلته
Dialogue: 0,0:08:44.82,0:08:47.40,Main,,0,0,0,,،لو كانت الآنسة ناتسو ابنة ذلك الشيطان فعلًا
Dialogue: 0,0:08:47.49,0:08:49.99,Main,,0,0,0,,،وحتّى لو كان الاحتمال ضئيلًا
Dialogue: 0,0:08:50.07,0:08:51.53,Main,,0,0,0,,لما كان ليتبناها من الأساس
Dialogue: 0,0:08:52.37,0:08:53.58,Main,,0,0,0,,فهمت
Dialogue: 0,0:09:09.55,0:09:10.63,Main,,0,0,0,,ناتسو
Dialogue: 0,0:09:11.76,0:09:14.56,Main,,0,0,0,,هل ثمة مشكلة مع الرجل الّذي كلفته بحراستكِ؟
Dialogue: 0,0:09:14.83,0:09:15.67,Main,,0,0,0,,كلّا
Dialogue: 0,0:09:15.89,0:09:19.69,Main,,0,0,0,,يزعم أنّه رونين، لكنّه لا يبدو شخصًا سيئًا
Dialogue: 0,0:09:19.77,0:09:22.77,Main,,0,0,0,,علاوةً، أنتَ من اخترته يا والدي
Dialogue: 0,0:09:22.86,0:09:25.23,Main,,0,0,0,,شكرًا على قلقك بشأني
Dialogue: 0,0:09:25.32,0:09:26.61,Main,,0,0,0,,هذا بديهي
Dialogue: 0,0:09:26.69,0:09:29.53,Main,,0,0,0,,ما من أبٍ لا يشعر بالقلق على ابنته
Dialogue: 0,0:09:34.66,0:09:36.66,Main,,0,0,0,,...أخبرني يا والدي
Dialogue: 0,0:09:36.74,0:09:39.08,Main,,0,0,0,,لِمَ وظفتَ ذلك الرجل بالذات؟
Dialogue: 0,0:09:43.92,0:09:48.92,Main,,0,0,0,,مؤخرًا، انتشرت شائعات عن ظهور بعض الشياطين في إيدو
Dialogue: 0,0:09:49.55,0:09:54.55,Main,,0,0,0,,لكن في الوقت نفسه، ثمة أيضًا شائعاتٌ عن رجلٍ بمقدوره قتل الشياطين بسيفه فحسب
Dialogue: 0,0:09:54.64,0:09:56.56,Main,,0,0,0,,هل هو ذلك الرونين؟
Dialogue: 0,0:09:56.64,0:09:57.31,Main,,0,0,0,,أجل
Dialogue: 0,0:09:57.34,0:09:58.97,Main,,0,0,0,,،يزعمون أنّه مُقابل المال
Dialogue: 0,0:09:59.06,0:10:01.27,Main,,0,0,0,,سيقتل أيّ شيطان
Dialogue: 0,0:10:01.35,0:10:03.23,Main,,0,0,0,,قِيل إنّه كفؤ في عمله
Dialogue: 0,0:10:03.31,0:10:05.56,Main,,0,0,0,,والأهم من ذلك، أنّه جديرٌ بالثقة
Dialogue: 0,0:10:06.06,0:10:08.78,Main,,0,0,0,,إنّه الحارس الأمثل لحمايتكِ
Dialogue: 0,0:10:09.86,0:10:13.28,Main,,0,0,0,,!أنتَ تصدقني إذن يا والدي
Dialogue: 0,0:10:21.04,0:10:22.79,Main,,0,0,0,,،حين يتعلق الأمر بقصص الرعب
Dialogue: 0,0:10:22.87,0:10:25.58,Main,,0,0,0,,ثمة العديد من الحكايات المختلفة الّتي تتناقلها الألسن
Dialogue: 0,0:10:26.25,0:10:29.63,Main,,0,0,0,,،الأشباح الباهتة، وأشباح الصفصاف
Dialogue: 0,0:10:29.71,0:10:34.13,Main,,0,0,0,,ساراياشكي، والشياطين، رأس البقرة
Dialogue: 0,0:10:34.22,0:10:38.31,Main,,0,0,0,,لكن قصص الرعب المفبركة ليست مخيفة
Dialogue: 0,0:10:41.39,0:10:44.56,Main,,0,0,0,,لا شكّ أنَّ السيّد يعتصره الألم في الواقع
Dialogue: 0,0:10:44.65,0:10:46.90,Main,,0,0,0,,قُتلتْ زوجته على يد شيطان
Dialogue: 0,0:10:46.98,0:10:49.23,Main,,0,0,0,,وابنه اختُطِف من قِبل شيطانة
Dialogue: 0,0:10:49.32,0:10:52.44,Main,,0,0,0,,لكنّه ما يزال يؤمن بأنّ ابنه سيعود يومًا ما
Dialogue: 0,0:10:52.49,0:10:55.27,Main,,0,0,0,,لهذا لم يتبنَّ ولدًا بل فتاةً بدلًا من ذلك
Dialogue: 0,0:10:55.82,0:10:57.87,Main,,0,0,0,,...المخيف حقًّا هو
Dialogue: 0,0:10:57.95,0:11:00.62,Main,,0,0,0,,الحقيقة الّتي لا يمكن إنكارها
Dialogue: 0,0:11:04.54,0:11:06.04,Main,,0,0,0,,أيّتها الآنسة، لا يجوز أن تخرجي
Dialogue: 0,0:11:06.12,0:11:07.84,Main,,0,0,0,,لِمَ أنتَ هنا يا زينجي؟
Dialogue: 0,0:11:08.67,0:11:11.09,Main,,0,0,0,,أردتُ تدارك إهانة يوم أمس
Dialogue: 0,0:11:11.17,0:11:12.30,Main,,0,0,0,,أمزح
Dialogue: 0,0:11:14.55,0:11:16.30,Main,,0,0,0,,لا أهتم بتاتًا
Dialogue: 0,0:11:16.97,0:11:18.22,Main,,0,0,0,,هذا قاسٍ
Dialogue: 0,0:11:18.30,0:11:20.60,Main,,0,0,0,,سامحيني رجاءً أيّتها الآنسة
Dialogue: 0,0:11:20.68,0:11:22.93,Main,,0,0,0,,إذن، خذني معك في المرّة القادمة
Dialogue: 0,0:11:23.02,0:11:24.85,Main,,0,0,0,,حينها سأسامحك
Dialogue: 0,0:11:25.02,0:11:26.08,Main,,0,0,0,,بالطبع
Dialogue: 0,0:11:26.08,0:11:28.19,Main,,0,0,0,,إن كان هذا يرضيكِ، يمكنكِ الذهاب حيثما تشائين
Dialogue: 0,0:11:30.02,0:11:31.98,Main,,0,0,0,,أنتْ، ما اسمك؟
Dialogue: 0,0:11:32.65,0:11:33.65,Main,,0,0,0,,جينيا
Dialogue: 0,0:11:34.82,0:11:35.99,Main,,0,0,0,,جينيا إذن
Dialogue: 0,0:11:36.07,0:11:38.07,Main,,0,0,0,,حسنٌ، سأناديك به
Dialogue: 0,0:11:38.16,0:11:40.95,Main,,0,0,0,,يبدو أنّ والدي يحترمكَ كثيرًا
Dialogue: 0,0:11:41.79,0:11:45.00,Main,,0,0,0,,لذا، سأثق بكَ هذه المرّة فقط
Dialogue: 0,0:11:45.50,0:11:48.58,Main,,0,0,0,,يبدو أنّكِ تُكِنين له احترامًا كبيرًا يا ناتسو-دونو
Dialogue: 0,0:11:48.67,0:11:50.13,Main,,0,0,0,,هذا بديهي
Dialogue: 0,0:11:50.21,0:11:52.09,Main,,0,0,0,,فقد رباني حتّى صرتُ على ما أنا عليه الآن
Dialogue: 0,0:11:52.17,0:11:54.01,Main,,0,0,0,,كيف لي ألّا أكون ممتنةً له؟
Dialogue: 0,0:11:55.17,0:11:56.18,Main,,0,0,0,,فهمت
Dialogue: 0,0:11:56.63,0:11:58.26,Main,,0,0,0,,يا لها من علاقة وثيقة بين أبٍ وابنته
Dialogue: 0,0:11:58.68,0:12:01.14,Main,,0,0,0,,ويبدو أن جوزو-دونو يكترث لأمركِ أيضًا
Dialogue: 0,0:12:02.14,0:12:03.77,Main,,0,0,0,,أتعتقد ذلك؟
Dialogue: 0,0:12:04.89,0:12:07.94,Main,,0,0,0,,بالمناسبة، صادف أنّي سمعتُ شيئًا في ذلك اليوم
Dialogue: 0,0:12:08.02,0:12:10.09,Main,,0,0,0,,...وهو أنّ جوزو-دونو لديه ابن
Dialogue: 0,0:12:09.47,0:12:10.65,Top,,0,0,0,,!لا أعرف
Dialogue: 0,0:12:11.15,0:12:13.57,Main,,0,0,0,,!لا أعرف شيئًا عن ابنه الّذي غادر البيت
Dialogue: 0,0:12:14.78,0:12:15.78,Main,,0,0,0,,فهمت
Dialogue: 0,0:12:16.90,0:12:18.36,Main,,0,0,0,,آسف على ما بدر منّي
Dialogue: 0,0:12:20.87,0:12:21.87,Main,,0,0,0,,...أنت
Dialogue: 0,0:12:22.28,0:12:25.58,Main,,0,0,0,,هل يمكن لشيطانٍ وإنسانٍ أن ينجبا طفلًا؟
Dialogue: 0,0:12:25.66,0:12:26.66,Main,,0,0,0,,هذا ممكن
Dialogue: 0,0:12:27.46,0:12:32.17,Main,,0,0,0,,..."إذن، لعلَّ ذلك الشيطان الّذي يقول "أعيدوا لي ابنتي
Dialogue: 0,0:12:32.54,0:12:34.96,Main,,0,0,0,,ذلك الشيطان لا يمتُّ لكِ بصلةٍ كأب
Dialogue: 0,0:12:35.05,0:12:36.84,Main,,0,0,0,,كيف لك أن تكون واثقًا لهذا الحد؟
Dialogue: 0,0:12:36.92,0:12:38.97,Main,,0,0,0,,لأنّي أعرف ذلك الشيطان
Dialogue: 0,0:12:39.05,0:12:40.05,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:12:39.05,0:12:40.05,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:12:40.47,0:12:43.01,Main,,0,0,0,,بيني وبينه علاقة أو ماضٍ مشترك
Dialogue: 0,0:12:43.10,0:12:45.47,Main,,0,0,0,,ذلك الشيطان لا يمتُّ لكِ بصلةٍ كأب
Dialogue: 0,0:12:45.56,0:12:47.48,Main,,0,0,0,,وهذا لا ريب فيه
Dialogue: 0,0:12:48.10,0:12:49.31,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:12:49.85,0:12:51.10,Main,,0,0,0,,لستُ من الكاذبين
Dialogue: 0,0:12:54.82,0:12:57.36,Main,,0,0,0,,كيف يولدُ الشياطين في اعتقادك؟
Dialogue: 0,0:12:58.07,0:12:59.36,Main,,0,0,0,,كيف يولدون؟
Dialogue: 0,0:12:59.45,0:13:00.95,Main,,0,0,0,,حسنٌ، هذا بديهي
Dialogue: 0,0:13:01.03,0:13:03.20,Main,,0,0,0,,...إنّهم نتاج والِديهم، لكن
Dialogue: 0,0:13:03.28,0:13:04.74,Main,,0,0,0,,كيف يولدون فعلًا؟
Dialogue: 0,0:13:05.37,0:13:07.91,Main,,0,0,0,,تتعدّد السّبلُ الّتي يُولد بها الشياطين
Dialogue: 0,0:13:08.00,0:13:11.54,Main,,0,0,0,,،ثمة حالات يكون فيها الأمر ناتجًا عن تزاوجٍ بين الشياطين
Dialogue: 0,0:13:11.63,0:13:15.59,Main,,0,0,0,,وأحيانًا، يُولدون نتيجة اعتداء شيطانٍ على بشريّ بغرض اللهو
Dialogue: 0,0:13:16.67,0:13:19.26,Main,,0,0,0,,بينما ثمة آخرون يُولدون من العدم
Dialogue: 0,0:13:19.34,0:13:20.72,Main,,0,0,0,,من العدم؟
Dialogue: 0,0:13:20.80,0:13:22.89,Main,,0,0,0,,،تحمل المشاعر قوّةً في طيّاتها
Dialogue: 0,0:13:22.97,0:13:24.85,Main,,0,0,0,,وكلّما كانت مظلمة، زادت هذه القوّة
Dialogue: 0,0:13:25.76,0:13:32.27,Main,,0,0,0,,الغضب، الكراهية، الحسد، الهوس، الحزن، الجوع
Dialogue: 0,0:13:32.35,0:13:36.53,Main,,0,0,0,,هذه المشاعر الدفينة الّتي طال أمدها ستتراكم ببطء وتتكثف
Dialogue: 0,0:13:36.61,0:13:38.65,Main,,0,0,0,,لتُشكل شيطانًا في النهاية
Dialogue: 0,0:13:39.49,0:13:44.41,Main,,0,0,0,,هذه الشياطين الّتي وُلِدتْ من العدم هي مشاعرٌ تحولتْ إلى لحمٍ ودم
Dialogue: 0,0:13:48.41,0:13:50.12,Main,,0,0,0,,هلّا أخبرتني باسمك؟
Dialogue: 0,0:13:50.54,0:13:53.04,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:14:00.38,0:14:02.96,Main,,0,0,0,,هل تفتقر إلى الذكاء لدرجة أنّك عاجز عن لفظ اسمك حتّى؟
Dialogue: 0,0:14:01.66,0:14:04.70,Top,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:14:03.98,0:14:05.22,Main,,0,0,0,,ما الّذي تفعله؟
Dialogue: 0,0:14:05.30,0:14:06.76,Main,,0,0,0,,!لا تتصرف بهذا التهور
Dialogue: 0,0:14:06.85,0:14:07.76,Main,,0,0,0,,هل يجوز لي قطعه؟
Dialogue: 0,0:14:07.79,0:14:09.58,Main,,0,0,0,,...بالطبع، أسرع و
Dialogue: 0,0:14:09.58,0:14:11.44,Main,,0,0,0,,سؤالي موجهٌ لكِ يا ناتسو-دونو
Dialogue: 0,0:14:12.69,0:14:13.69,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:14:14.31,0:14:15.81,Main,,0,0,0,,سأعيد السؤال
Dialogue: 0,0:14:15.90,0:14:17.32,Main,,0,0,0,,هل يجوز لي قطعه؟
Dialogue: 0,0:14:19.07,0:14:21.28,Main,,0,0,0,,،حتّى لو قطعته وأزلتُ رأسه
Dialogue: 0,0:14:21.36,0:14:22.99,Main,,0,0,0,,سيعود الشيطان للظهور مجدّدًا
Dialogue: 0,0:14:24.49,0:14:25.57,Main,,0,0,0,,لماذا؟
Dialogue: 0,0:14:25.66,0:14:26.95,Main,,0,0,0,,هذا بديهي
Dialogue: 0,0:14:27.03,0:14:30.12,Main,,0,0,0,,لأنَّ هذا الشيطان... هو تجسيدٌ لمشاعركِ يا ناتسو-دونو
Dialogue: 0,0:14:30.91,0:14:37.38,Main,,0,0,0,,ظهر تلبيةً لأمنيتكِ، وأثار اضطرابًا كافيًّا ليسترعي اهتمام والدكِ العزيز
Dialogue: 0,0:14:37.84,0:14:38.88,Main,,0,0,0,,فهمت
Dialogue: 0,0:14:38.96,0:14:41.59,Main,,0,0,0,,ليُعرب عن خوفه عليكِ كما تفعل أيّ عائلة حقيقيّة
Dialogue: 0,0:14:42.17,0:14:45.93,Main,,0,0,0,,وسيهاجم الشيطان الّذين يتفوهون بأقوالٍ لا ترغبين في سماعها
Dialogue: 0,0:14:46.01,0:14:48.56,Main,,0,0,0,,!يا له من شيطانٍ عينُ ما رغبتِ به
Dialogue: 0,0:14:48.64,0:14:52.06,Main,,0,0,0,,هكذا إذن، اتضحتْ لي الصورة أخيرًا
Dialogue: 0,0:14:52.14,0:14:55.69,Main,,0,0,0,,لكن في قرارةِ نفسكِ، لطالما أردتِ حدوثَ هذا، أليس كذلك؟
Dialogue: 0,0:14:55.77,0:14:57.11,Main,,0,0,0,,!توقف
Dialogue: 0,0:14:58.40,0:15:00.28,Main,,0,0,0,,...ما السبب وراء اتخاذ هذا الشيطان
Dialogue: 0,0:15:00.36,0:15:03.14,Main,,0,0,0,,هذه الهيئة البشعة يا ترى؟
Dialogue: 0,0:15:03.49,0:15:05.82,Main,,0,0,0,,مهما قطعته سيعود للظهور فورًا
Dialogue: 0,0:15:05.91,0:15:07.28,Main,,0,0,0,,مرارًا وتكرارًا
Dialogue: 0,0:15:07.37,0:15:10.79,Main,,0,0,0,,ما دمتِ غير راضية، فلن يختفي هذا الشيطان أبدًا
Dialogue: 0,0:15:10.87,0:15:12.54,Main,,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:15:12.62,0:15:13.91,Main,,0,0,0,,إذن، ماذا عليّ أن أفعل؟
Dialogue: 0,0:15:14.00,0:15:15.33,Main,,0,0,0,,كلمةٌ واحدة
Dialogue: 0,0:15:15.42,0:15:17.42,Main,,0,0,0,,"كلّ ما عليكِ قوله هو "اقطعه
Dialogue: 0,0:15:18.59,0:15:23.13,Main,,0,0,0,,كنتُ أغضّ الطّرف دائمًا عن الأشياء الّتي لا أريد مواجهتها وأخفي جانبي الضعيف
Dialogue: 0,0:15:23.84,0:15:25.88,Main,,0,0,0,,لكنّي تُقت أن يُحبني أحدهم
Dialogue: 0,0:15:26.59,0:15:27.68,Main,,0,0,0,,...ومع ذلك
Dialogue: 0,0:15:27.76,0:15:29.66,Main,,0,0,0,,لم أستطع أن أصدق ذلك
Dialogue: 0,0:15:30.22,0:15:33.39,Main,,0,0,0,,،لهذا خطر ببالي أنّه لو تعرضتُ لهجومٍ من قبل شيطانٍ يزعم أنّي من عائلته
Dialogue: 0,0:15:33.48,0:15:36.85,Main,,0,0,0,,لكان والدي ليوليني مزيدًا من الاهتمام
Dialogue: 0,0:15:37.73,0:15:42.03,Main,,0,0,0,,هكذا اتخذتْ هذه المشاعر المشينة في قلبي شكلًا
Dialogue: 0,0:15:43.24,0:15:44.30,Main,,0,0,0,,...ذلك الشيطان
Dialogue: 0,0:15:43.00,0:15:45.93,Top,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:15:44.90,0:15:45.82,Main,,0,0,0,,هو أنا
Dialogue: 0,0:15:48.16,0:15:50.53,Main,,0,0,0,,...من يستحق أن يُقطع في الواقع
Dialogue: 0,0:15:50.77,0:15:51.58,Main,,0,0,0,,أنا لا غيري
Dialogue: 0,0:15:51.66,0:15:55.29,Main,,0,0,0,,!من سيُقطَع هو ذلك الشيطان، وليس أنتِ
Dialogue: 0,0:15:55.37,0:15:57.58,Main,,0,0,0,,،حتّى لو كان ذلك الشيطان تجسيدًا لمشاعركِ
Dialogue: 0,0:15:57.67,0:15:59.42,Main,,0,0,0,,فهو لا يُمثلها كلّها
Dialogue: 0,0:15:59.92,0:16:03.85,Main,,0,0,0,,أنا على درايةٍ تامّةٍ بمدى حبّ السيّد لكِ
Dialogue: 0,0:16:04.38,0:16:10.12,Main,,0,0,0,,وفوق ذلك، أنا على يقينٍ بأنّ السيّد... يعتبركِ فردًا من عائلته العزيزة
Dialogue: 0,0:16:13.27,0:16:16.14,Main,,0,0,0,,أنتِ والسيّد على حدٍّ سواء في سوء التعبير عن مشاعركما
Dialogue: 0,0:16:16.77,0:16:18.85,Main,,0,0,0,,،حان الوقت لتُواجِها بعضكما بصدقٍ
Dialogue: 0,0:16:18.94,0:16:22.90,Main,,0,0,0,,وتتبادلا حديثًا نابعًا من القلب كما تفعل أيّ عائلة حقيقيّة
Dialogue: 0,0:16:22.98,0:16:24.23,Main,,0,0,0,,زينجي
Dialogue: 0,0:16:30.95,0:16:32.08,Main,,0,0,0,,!اقطعه
Dialogue: 0,0:16:37.58,0:16:40.08,Main,,0,0,0,,ذلك الشيطان هو مشاعري الداخلية
Dialogue: 0,0:16:40.17,0:16:45.92,Main,,0,0,0,,كنتُ خائفةً من الحقيقة، فظللتُ أتجاهلُ أمورًا عدّة، هذا ما كنتُ عليه حتّى الآن
Dialogue: 0,0:16:46.30,0:16:48.26,Main,,0,0,0,,لكن سأكون مختلفة من الآن فصاعدًا
Dialogue: 0,0:16:48.34,0:16:50.30,Main,,0,0,0,,سأسعى جاهدة لأكون على هذا النحو
Dialogue: 0,0:16:51.39,0:16:52.39,Main,,0,0,0,,لهذا تحديدًا
Dialogue: 0,0:17:03.19,0:17:05.82,Main,,0,0,0,,هل انتهى الأمر؟
Dialogue: 0,0:17:28.38,0:17:29.68,Main,,0,0,0,,كما توقعت
Dialogue: 0,0:17:30.51,0:17:33.89,Main,,0,0,0,,،إن كنت قد وُلدت من مشاعر ناتسو-دونو
Dialogue: 0,0:17:33.97,0:17:37.85,Main,,0,0,0,,فإنَّ وجودك يفقد معناه بمجرد أن تنكرك
Dialogue: 0,0:17:37.93,0:17:39.56,Main,,0,0,0,,...ومع ذلك
Dialogue: 0,0:17:40.27,0:17:44.25,Main,,0,0,0,,ثمة امرأة أخرى في عائلة سوغايا يمكن أن تصبح شيطانة
Dialogue: 0,0:17:44.90,0:17:47.57,Main,,0,0,0,,قُتلتْ زوجته على يد شيطان
Dialogue: 0,0:17:47.65,0:17:52.49,Main,,0,0,0,,"السبب وراء تكرار هذا الشيطان لعبارة "أعيدوا لي ابنتي
Dialogue: 0,0:17:52.57,0:17:57.54,Main,,0,0,0,,هو وجود مشاعر أخرى إلى جانب مشاعر ناتسو-دونو
Dialogue: 0,0:18:03.46,0:18:06.38,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:18:07.05,0:18:10.63,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:18:11.18,0:18:13.64,Main,,0,0,0,,...بمعنى آخر، ابنة هذه الشيطانة
Dialogue: 0,0:18:13.72,0:18:16.39,Main,,0,0,0,,هي الطفلة الّتي أنجبتها زوجة جوزو
Dialogue: 0,0:18:19.02,0:18:23.40,Main,,0,0,0,,لم يخطر ببالي قطّ أن يجمعني بكِ القدر بهذه الصورة
Dialogue: 0,0:18:24.10,0:18:28.23,Main,,0,0,0,,لأكون صادقًا، لم أعد أتذكّركِ
Dialogue: 0,0:18:28.73,0:18:32.40,Main,,0,0,0,,أود أن أعرف اسمكِ قبل الوداع
Dialogue: 0,0:18:33.03,0:18:36.66,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:18:40.37,0:18:43.04,Main,,0,0,0,,،الجميع يعيشون في الحاضر
Dialogue: 0,0:18:43.75,0:18:46.25,Main,,0,0,0,,ولا يمكن لأحدٍ أن يظل أسيرًا للماضي
Dialogue: 0,0:18:46.92,0:18:47.92,Main,,0,0,0,,...لهذا
Dialogue: 0,0:18:49.42,0:18:51.47,Main,,0,0,0,,أرجو أن ترقدي بسلام
Dialogue: 0,0:18:51.55,0:18:54.59,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:19:00.93,0:19:02.33,Main,,0,0,0,,...يا أماه
Dialogue: 0,0:19:08.11,0:19:11.40,Main,,0,0,0,,جينيا، كنتَ خير عونٍ لنا مجدّدًا
Dialogue: 0,0:19:11.49,0:19:13.11,Main,,0,0,0,,هيّا، قولي شيئًا أيّتها الآنسة
Dialogue: 0,0:19:14.99,0:19:17.87,Main,,0,0,0,,إن بقيتِ هكذا، فسيظهر الشيطان مجدّدًا
Dialogue: 0,0:19:17.88,0:19:19.67,Main,,0,0,0,,!حسنٌ، فهمت
Dialogue: 0,0:19:20.91,0:19:22.37,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:19:22.45,0:19:28.09,Main,,0,0,0,,سأحاول تغيير نفسي، بالرغم من أنّه من المُحال التغيّر بين عشيةٍ وضحاها
Dialogue: 0,0:19:29.46,0:19:30.67,Main,,0,0,0,,شكرًا لك
Dialogue: 0,0:19:31.55,0:19:32.63,Main,,0,0,0,,لا داعي لشكري
Dialogue: 0,0:19:32.71,0:19:34.22,Main,,0,0,0,,فقد تلقّيتُ أجري بالفعل
Dialogue: 0,0:19:34.80,0:19:37.01,Main,,0,0,0,,...أديتُ عملي فحسب
Dialogue: 0,0:19:37.39,0:19:38.43,Main,,0,0,0,,كلّا
Dialogue: 0,0:19:38.51,0:19:40.97,Main,,0,0,0,,بل أتيتُ لردّ الدّين
Dialogue: 0,0:19:41.02,0:19:41.89,Main,,0,0,0,,دين؟
Dialogue: 0,0:19:42.22,0:19:45.81,Main,,0,0,0,,العيش لفترةٍ طويلةٍ لا يعني بالضرورة أنّ المرء شخصٌ بالغ
Dialogue: 0,0:19:45.89,0:19:49.36,Main,,0,0,0,,لكن مع مرور السنين تُدرك بعض الأمور
Dialogue: 0,0:19:50.07,0:19:53.61,Main,,0,0,0,,في صغري، اعتقدتُ أنّ كلّ ما أبصرهُ بعيني هو كلّ شيء
Dialogue: 0,0:19:54.11,0:19:55.95,Main,,0,0,0,,كنتُ أعتقد أنّ إيذاء الآخرين كان أمرًا خاطئًا
Dialogue: 0,0:19:56.53,0:20:02.20,Main,,0,0,0,,لكنّي لم أملك النضج الكافي لأتصور وجود أشياء مستترّة
Dialogue: 0,0:20:03.00,0:20:08.21,Main,,0,0,0,,أردتُ أن أسدّد الدّين الّذي تراكم بسبب عدم نضجي حين تخلّيتُ عنهم آنذاك
Dialogue: 0,0:20:09.04,0:20:11.88,Main,,0,0,0,,لا فكرة لدي عمّا تتحدث عنه
Dialogue: 0,0:20:12.34,0:20:16.01,Main,,0,0,0,,الخلاصة هي أنّه من الحكمة أن تحسني إلى والديكِ
Dialogue: 0,0:20:16.09,0:20:18.05,Main,,0,0,0,,!لستُ بحاجةٍ إلى سماع هذا منك
Dialogue: 0,0:20:19.89,0:20:20.89,Main,,0,0,0,,إلى اللقاء
Dialogue: 0,0:20:28.90,0:20:30.15,Main,,0,0,0,,هل رحل؟
Dialogue: 0,0:20:31.32,0:20:32.23,Main,,0,0,0,,أجل
Dialogue: 0,0:20:32.32,0:20:35.24,Main,,0,0,0,,كان عليك أن تخرج لتوديعه يا سيّدي
Dialogue: 0,0:20:35.32,0:20:37.32,Main,,0,0,0,,لم تكن هناك حاجة لذلك
Dialogue: 0,0:20:37.40,0:20:41.58,Main,,0,0,0,,من اللحظة الأولى الّتي رأيته فيها، كنتُ على يقينٍ بأنّه سينجز الأمر
Dialogue: 0,0:20:41.99,0:20:46.62,Main,,0,0,0,,على حدِّ قول الآنسة، يبدو أنّك تُكنّ لجينيا تقديرًا كبيرًا
Dialogue: 0,0:20:46.91,0:20:48.83,Main,,0,0,0,,هل ثمة سببٌ معينٌ لذلك؟
Dialogue: 0,0:20:49.12,0:20:50.71,Main,,0,0,0,,لا تطرح أسئلةً غبية
Dialogue: 0,0:20:51.29,0:20:54.00,Main,,0,0,0,,كيف لأبٍ ألّا يميز ابنه
Dialogue: 0,0:20:54.09,0:20:54.74,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:20:54.79,0:20:56.88,Main,,0,0,0,,عُد إلى عملكَ بسرعة
Dialogue: 0,0:20:56.97,0:20:59.38,Main,,0,0,0,,!وإلّا لن أجعلك تتولى المتجر
Dialogue: 0,0:20:59.47,0:21:01.26,Main,,0,0,0,,!اعفني من هذا
Dialogue: 0,0:21:01.35,0:21:03.35,Main,,0,0,0,,حسنٌ إذن، أستأذنكِ أيّتها الآنسة
Dialogue: 0,0:21:04.85,0:21:06.10,Main,,0,0,0,,...المعذرة
Dialogue: 0,0:21:07.10,0:21:09.14,Main,,0,0,0,,...والدي
Dialogue: 0,0:21:09.23,0:21:11.52,Main,,0,0,0,,هل ثمة أيّ شيءٍ يمكنني المساعدة فيه؟
Dialogue: 0,0:21:12.40,0:21:13.90,Main,,0,0,0,,ما الّذي دهاكِ فجأة؟
Dialogue: 0,0:21:13.98,0:21:18.90,Main,,0,0,0,,لأنّه... أخبرني أحدهم أنّه من الحكمة أن أحسِّن إلى والدَيّ
Dialogue: 0,0:21:24.03,0:21:28.37,Main,,0,0,0,,ليس عليكِ القلق بشأن هذا الأمر
Dialogue: 0,0:21:29.58,0:21:34.38,Main,,0,0,0,,يا بنيتي، أن تعيشي أطول من والديكِ هو أسمى أشكال البرِّ بهما
Dialogue: 0,0:21:35.25,0:21:36.51,Main,,0,0,0,,والدي
Dialogue: 0,0:21:36.84,0:21:40.26,Main,,0,0,0,,هذا وحده يجعلني راضيًا
Dialogue: 0,0:21:44.72,0:21:46.22,Main,,0,0,0,,و-والدي
Dialogue: 0,0:21:46.31,0:21:48.89,Main,,0,0,0,,ومع ذلك، هل ثمة أيّ شيءٍ يمكنني المساعدة فيه؟
Dialogue: 0,0:04:26.58,0:04:29.13,توضيح,,0,0,0,,رونين‏:‏ بلا سيد وهذا حين يفقد الساموراي سيده إما بوفاته أو بسقوطه من السلطة أو بتخليه عنه‏،‏ حينها يصبح ‏"‏رونين‏"‏
Dialogue: 0,0:10:26.25,0:10:29.63,توضيح,,0,0,0,,الأشباح الباهتة: هي أشباح هادئة وغير ملحوظة تحمل قوة مرعبة تؤثر بشكل غير مباشر على من يلتقي بها\Nأشباح تحت شجر الصفصاف: هي أشباح تظهر في أماكن مظلمة ومهجورة، وعادةً ما تكون أرواحًا معذبةً تبحث عن الانتقام أو الراحة
Dialogue: 0,0:10:29.71,0:10:34.13,توضيح,,0,0,0,,ساراياشِكي: قصة تحكي عن امرأة خادمة تُدعى أوجين، قُتلت ظلمًا بعد كسرها لطبق ثمين، لكن حتّى بعد موتها ظلت روحها تبحث عن ذلك الطبق المكسور\Nرأس البقرة: تحكي عن رجل يلتقي برأس بقرة غريب في مكان مهجور، ليكتشف أنّه يحمل قوة شريرة تجلب المصائب
Dialogue: 0,0:00:01.81,0:00:07.93,Sign,,0,0,0,,حقبة كايي\Nالعام الثالث
