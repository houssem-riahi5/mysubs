Dialogue: 0,0:00:02.42,0:00:05.71,Main,,0,0,0,,أنا آسفة، أنا آسفة، أنا آسفة
Dialogue: 0,0:00:05.71,0:00:06.58,Main,,0,0,0,,!اخرسي
Dialogue: 0,0:00:09.54,0:00:10.67,Main,,0,0,0,,فتاة مزعجة
Dialogue: 0,0:00:11.17,0:00:12.93,Main,,0,0,0,,أنتِ خطأ فادح
Dialogue: 0,0:00:13.38,0:00:14.08,Main,,0,0,0,,!تعالي
Dialogue: 0,0:00:15.54,0:00:18.67,Main,,0,0,0,,!لا، لا
Dialogue: 0,0:00:19.33,0:00:22.08,Main,,0,0,0,,!أنقذني يا جينتا
Dialogue: 0,0:00:27.75,0:00:28.71,Main,,0,0,0,,!أبي
Dialogue: 0,0:00:29.33,0:00:30.46,Main,,0,0,0,,!أنا آسفة
Dialogue: 0,0:00:34.79,0:00:38.29,Main,,0,0,0,,...أ-أنا آسفة
Dialogue: 0,0:01:11.08,0:01:13.96,Main,,0,0,0,,!سوزوني! سوزوني
Dialogue: 0,0:01:17.75,0:01:18.63,Main,,0,0,0,,!سوزوني
Dialogue: 0,0:01:29.13,0:01:29.96,Main,,0,0,0,,!سوزوني
Dialogue: 0,0:01:32.67,0:01:33.96,Main,,0,0,0,,...أخي
Dialogue: 0,0:01:34.54,0:01:35.67,Main,,0,0,0,,!سوزوني
Dialogue: 0,0:01:37.38,0:01:39.54,Main,,0,0,0,,أنا آسف، كان يجب أن أفعل شيئًا لإنقاذكِ
Dialogue: 0,0:01:39.71,0:01:43.67,Main,,0,0,0,,!لا تقل ذلك يا جينتا، ستوقعُ نفسكَ في ورطة
Dialogue: 0,0:01:44.83,0:01:47.38,Main,,0,0,0,,لذلك انسَ أمري وعُد إلى المنزل
Dialogue: 0,0:01:48.13,0:01:48.75,Main,,0,0,0,,اتفقنا؟
Dialogue: 0,0:01:52.13,0:01:52.96,Main,,0,0,0,,لنغادر
Dialogue: 0,0:01:53.54,0:01:54.21,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:02:07.75,0:02:09.58,Main,,0,0,0,,هل تشعرين بالبرد يا سوزوني؟
Dialogue: 0,0:02:09.88,0:02:12.92,Main,,0,0,0,,طالما أنتَ هنا، سأكون على ما يرام
Dialogue: 0,0:02:25.92,0:02:28.63,Main,,0,0,0,,إن لم يكن لديكما مأوى، فتعاليا لتسكنا معي
Dialogue: 0,0:02:32.42,0:02:34.92,Main,,0,0,0,,أخي، أخي
Dialogue: 0,0:02:36.79,0:02:38.67,Main,,0,0,0,,!استيقظتَ إذن
Dialogue: 0,0:02:45.83,0:02:47.92,Main,,0,0,0,,حسنٌ، حان الوقت لكي تنزل
Dialogue: 0,0:02:48.88,0:02:50.25,Main,,0,0,0,,عليك أن تمشي على قدميك الآن
Dialogue: 0,0:03:02.38,0:03:04.25,Main,,0,0,0,,...ما أغرب هذا المكان
Dialogue: 0,0:03:04.42,0:03:09.08,Main,,0,0,0,,شُيدت هذه القرية لإيواء الحدادين الّذين يستخدمون أفرانًا كبيرةً لصناعة سيوف الكاتانا
Dialogue: 0,0:03:12.83,0:03:14.00,Main,,0,0,0,,حسنٌ، تفضلا بالدخول
Dialogue: 0,0:03:14.88,0:03:16.79,Main,,0,0,0,,!أهلًا بعودتك يا أبي
Dialogue: 0,0:03:17.63,0:03:19.92,Main,,0,0,0,,لقد عدت، هل كنتِ فتاةً مُطيعة؟
Dialogue: 0,0:03:20.29,0:03:20.96,Main,,0,0,0,,!أجل
Dialogue: 0,0:03:27.00,0:03:27.83,Main,,0,0,0,,من هما؟
Dialogue: 0,0:03:28.50,0:03:29.75,Main,,0,0,0,,طفلان بحاجةٍ إلى مأوى
Dialogue: 0,0:03:30.54,0:03:32.46,Main,,0,0,0,,سيعيشانِ معنا من الآن فصاعدًا
Dialogue: 0,0:03:33.13,0:03:34.75,Main,,0,0,0,,هنا في منزلنا؟
Dialogue: 0,0:03:34.92,0:03:37.67,Main,,0,0,0,,أجل، سأضمهما إلى أسرتنا
Dialogue: 0,0:03:38.33,0:03:39.00,Main,,0,0,0,,لا تمانعين؟
Dialogue: 0,0:03:40.17,0:03:40.83,Main,,0,0,0,,!أجل
Dialogue: 0,0:03:43.33,0:03:46.00,Main,,0,0,0,,اسمي شيرايوكي، وأنت ما اسمك؟
Dialogue: 0,0:03:46.46,0:03:47.88,Main,,0,0,0,,...جـ-جينتا
Dialogue: 0,0:03:49.71,0:03:53.29,Main,,0,0,0,,مرحبًا، هل لي بمعرفة اسمكِ أيضًا؟
Dialogue: 0,0:03:59.04,0:04:00.21,Main,,0,0,0,,سوزوني
Dialogue: 0,0:04:00.42,0:04:01.54,Main,,0,0,0,,!شكرًا لكِ
Dialogue: 0,0:04:03.79,0:04:05.13,Main,,0,0,0,,أرجو أن نكون على وفاق بدءًا من الآن
Dialogue: 0,0:04:05.75,0:04:08.79,Main,,0,0,0,,!تشرفتُ بمعرفتكِ يا شيرايوكي-تشان
Dialogue: 0,0:04:10.08,0:04:11.42,Main,,0,0,0,,"يمكنك أن تناديني بدون "تشان
Dialogue: 0,0:04:11.88,0:04:14.88,Main,,0,0,0,,!لأنّنا سنصبح عائلةً واحدة من الآن فصاعدًا
Dialogue: 0,0:04:31.25,0:04:32.42,Main,,0,0,0,,هل تواجه صعوبةً في النوم؟
Dialogue: 0,0:04:37.63,0:04:39.54,Main,,0,0,0,,هل أنتَ ساموراي يا موتوهارو-سان؟
Dialogue: 0,0:04:39.79,0:04:41.71,Main,,0,0,0,,لا، أنا حارس
Dialogue: 0,0:04:44.50,0:04:46.83,Main,,0,0,0,,وظيفتي هي حماية الأشياء الثمينة والأشخاص أيضًا
Dialogue: 0,0:05:55.13,0:05:59.50,Main,,0,0,0,,!شيرايوكي-تشان، أنتِ تفرطين في أكل الدانغو، لنذهب لقطف الخضروات في المرّة القادمة
Dialogue: 0,0:05:59.71,0:06:03.00,Main,,0,0,0,,لا أستطيع منع نفسي فوالدتكِ تعدُ ألذ دانغو يا تشيتوسي-تشان
Dialogue: 0,0:06:03.29,0:06:04.25,Main,,0,0,0,,أرأيتِ؟
Dialogue: 0,0:06:04.25,0:06:05.29,Main,,0,0,0,,!تشيتوسي
Dialogue: 0,0:06:06.13,0:06:06.96,Main,,0,0,0,,أمي
Dialogue: 0,0:06:07.33,0:06:08.33,Main,,0,0,0,,!حسنٌ، إلى اللقاء الآن
Dialogue: 0,0:06:08.33,0:06:09.13,Main,,0,0,0,,أراكِ لاحقًا
Dialogue: 0,0:06:09.13,0:06:10.54,Main,,0,0,0,,أراكَ لاحقًا يا جينتا-ني
Dialogue: 0,0:06:11.83,0:06:13.63,Main,,0,0,0,,لقد عدت يا أمي
Dialogue: 0,0:06:14.08,0:06:18.17,Main,,0,0,0,,...أتعرفين، ذهبتُ اليوم أنا وأصدقائي إلى النهر للعب في الماء واستمتعنا كثيرًا
Dialogue: 0,0:06:31.42,0:06:33.33,Main,,0,0,0,,...فيما يخص أمكِ يا شيرايوكي
Dialogue: 0,0:06:34.29,0:06:36.50,Main,,0,0,0,,اسمها يوكازي-سان، أليس كذلك؟
Dialogue: 0,0:06:37.17,0:06:41.83,Main,,0,0,0,,أعلم أنّها هي من يسرت لنا الحصول على التصريح للعيش هنا في قرية كادونو
Dialogue: 0,0:06:44.42,0:06:46.54,Main,,0,0,0,,هي لا تبارح ذلك الضريح أبدًا، أليس كذلك؟
Dialogue: 0,0:06:47.29,0:06:50.17,Main,,0,0,0,,أجل، لأنّها إيتسوكيهيمي
Dialogue: 0,0:06:50.71,0:06:51.71,Main,,0,0,0,,إيتسوكيهيمي؟
Dialogue: 0,0:06:52.33,0:06:55.33,Main,,0,0,0,,أجل، إنّه اسم آخر لكاهنة النار
Dialogue: 0,0:06:56.04,0:07:00.92,Main,,0,0,0,,الوحيدان المسموح لهما برؤية الكاهنة هم شيخ القرية وحارسها الّذي هو والدنا
Dialogue: 0,0:07:02.08,0:07:07.83,Main,,0,0,0,,وفقًا للقوانين، يجب على الكاهنة ألّا تختلط مع عامة الناس لكي لا تدنس قوتها المقدسة
Dialogue: 0,0:07:09.67,0:07:12.29,Main,,0,0,0,,...مضت سنوات مُذ أن رأيتها آخر مرّة
Dialogue: 0,0:07:14.63,0:07:16.50,Main,,0,0,0,,حسنٌ، لنعد إلى المنزل
Dialogue: 0,0:07:34.21,0:07:35.46,Main,,0,0,0,,ما يزال أمامك الكثير
Dialogue: 0,0:07:36.71,0:07:37.96,Main,,0,0,0,,الممارسة هي من تجعل المرء مثاليًا
Dialogue: 0,0:07:37.96,0:07:39.54,Main,,0,0,0,,!أعلم
Dialogue: 0,0:07:40.25,0:07:43.67,Main,,0,0,0,,...لكن، أشعر وكأنّني لم أحرز أيّ تقدم يذكر
Dialogue: 0,0:07:46.88,0:07:47.96,Main,,0,0,0,,اسمع يا جينتا
Dialogue: 0,0:07:48.38,0:07:50.04,Main,,0,0,0,,لا شيء يبقى على حاله
Dialogue: 0,0:07:50.42,0:07:53.00,Main,,0,0,0,,،رغم شعورك بأنّك لم تتغير
Dialogue: 0,0:07:53.25,0:07:55.50,Main,,0,0,0,,إلا أنّك في الحقيقة تتغير تدريجيًّا
Dialogue: 0,0:07:56.83,0:07:59.58,Main,,0,0,0,, لذا ارفع رأسك، ستصبح أشد قوّة بمرور الأيام
Dialogue: 0,0:08:00.46,0:08:01.96,Main,,0,0,0,,أضمن لك ذلك
Dialogue: 0,0:08:02.79,0:08:03.50,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:08:03.83,0:08:06.50,Main,,0,0,0,,حسنٌ، حان الوقت لأذهب لأداء واجباتي
Dialogue: 0,0:08:06.92,0:08:07.96,Main,,0,0,0,,!موتوهارو-سان
Dialogue: 0,0:08:08.42,0:08:09.79,Main,,0,0,0,,شكرًا على اليوم
Dialogue: 0,0:08:10.21,0:08:10.96,Main,,0,0,0,,على الرحب
Dialogue: 0,0:08:17.83,0:08:19.79,Main,,0,0,0,,!تفضل متاعك يا أبي
Dialogue: 0,0:08:19.79,0:08:20.88,Main,,0,0,0,,شكرًا لكِ
Dialogue: 0,0:08:23.00,0:08:24.46,Main,,0,0,0,,!رافقتك السلامة
Dialogue: 0,0:08:24.46,0:08:25.29,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:08:36.21,0:08:37.50,Main,,0,0,0,,مؤسف أنّك خسرت
Dialogue: 0,0:08:38.04,0:08:39.00,Main,,0,0,0,,هل ما زلت تشعر بالألم هنا؟
Dialogue: 0,0:08:39.46,0:08:40.46,Main,,0,0,0,,كفِّ عن هذا
Dialogue: 0,0:08:40.71,0:08:44.38,Main,,0,0,0,,لا عليك، لا عليك، ستواسيك أختك الكبيرة
Dialogue: 0,0:08:44.54,0:08:48.04,Main,,0,0,0,,!كيف تكونين أختي الكبرى وأنتِ أصغر منّي سنًا
Dialogue: 0,0:08:48.58,0:08:51.92,Main,,0,0,0,,!لأنّني أتصرف بمسؤولية، لذا هذا يجعلني الشخص الأكثر رزانة
Dialogue: 0,0:08:57.26,0:08:58.56,Main,,0,0,0,,!سـ-سوزوني
Dialogue: 0,0:08:58.58,0:09:00.67,Main,,0,0,0,,...صباح الخير يا أخي
Dialogue: 0,0:09:01.83,0:09:03.04,Main,,0,0,0,,ماذا هناك؟
Dialogue: 0,0:09:03.04,0:09:05.33,Main,,0,0,0,,!لـ-لا، لا شيء
Dialogue: 0,0:09:07.33,0:09:09.63,Main,,0,0,0,,حسنٌ، لنذهب لتناول الفطور أولًا
Dialogue: 0,0:09:09.63,0:09:10.30,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:09:15.50,0:09:16.13,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:09:20.50,0:09:23.63,Main,,0,0,0,,كنت على قدر المسؤولية في مهمة قتل الشياطين هذه المرّة
Dialogue: 0,0:09:24.21,0:09:28.38,Main,,0,0,0,,جينتا، لا تلين لك عزيمة أمام تلك المسوخ الّتي تقتات على اللحوم
Dialogue: 0,0:09:29.00,0:09:30.96,Main,,0,0,0,,إخلاصك يملأني سرورًا
Dialogue: 0,0:09:31.67,0:09:36.13,Main,,0,0,0,,على الإطلاق، قمتُ بواجباتي بصفتي حارسًا للقرية لا أكثر
Dialogue: 0,0:09:37.08,0:09:39.38,Main,,0,0,0,,أيّ نوعٍ من الشياطين ظهر هذه المرّة؟
Dialogue: 0,0:09:39.67,0:09:43.33,Main,,0,0,0,,كان يتنكر في هيئة بشري ليتسلل إلى كادونو خلسةً
Dialogue: 0,0:09:46.08,0:09:48.88,Main,,0,0,0,,على الأرجح أنَّ هدفه كان الأميرة
Dialogue: 0,0:09:55.29,0:09:58.71,Main,,0,0,0,,تمتلك الشياطين بشكل طبيعي دورة حياةٍ تتجاوز الألف سنة
Dialogue: 0,0:09:59.00,0:10:02.67,Main,,0,0,0,,قيل في الأساطير أنَّ أكل كبد الكاهنة وهو طازج قد يجعلهم خالدين
Dialogue: 0,0:10:03.29,0:10:06.86,Main,,0,0,0,,...لا داعي للخوض في حكاياتٍ لا نعلم صحتها من عدمها
Dialogue: 0,0:10:05.87,0:10:06.91,Top,,0,0,0,,إنّها حقيقية
Dialogue: 0,0:10:06.86,0:10:09.96,Main,,0,0,0,,تمَّ التهام كبد الكاهنة السابقة يوكازي وهي حية على يد شيطان
Dialogue: 0,0:10:10.17,0:10:14.54,Main,,0,0,0,,ولم نتمكن من القضاء على ذلك الوحش إلا بعد أن قدم موتوهارو روحه فداءً
Dialogue: 0,0:10:16.13,0:10:18.17,Main,,0,0,0,,قد يكون مبتغاهم هو الياراي
Dialogue: 0,0:10:18.92,0:10:21.83,Main,,0,0,0,,السيف المقدس المتوارث عبر الأجيال بين كاهنات النار
Dialogue: 0,0:10:22.58,0:10:24.96,Main,,0,0,0,,أظن أنَّ له أهميةً كبيرةً لدى الشياطين كذلك
Dialogue: 0,0:10:26.79,0:10:30.75,Main,,0,0,0,,تقول الأسطورة أنَّ ياراي سيف الكاتانا صُنع باستخدام أفضل تقنيات الحدادة في كادونو
Dialogue: 0,0:10:30.83,0:10:34.88,Main,,0,0,0,,وأنّه ذو طبيعة روحانية ظل سليمًا رغم مرور ألف عام
Dialogue: 0,0:10:35.63,0:10:40.33,Main,,0,0,0,,...من الممكن أن الشياطين يرغبون في الحصول على تلك القوة
Dialogue: 0,0:10:41.67,0:10:42.67,Main,,0,0,0,,...لكن
Dialogue: 0,0:10:43.58,0:10:45.38,Main,,0,0,0,,أجل، أعرف ما تود قوله
Dialogue: 0,0:10:50.96,0:10:54.67,Main,,0,0,0,,لا داعي لكلّ هذا التوتر، سيكون كلّ شيءٍ على ما يرام  يا أبي
Dialogue: 0,0:10:54.88,0:10:58.54,Main,,0,0,0,,حاليًا، لدى الكاهنة حارسان يتوليان حمايتها لعلمك
Dialogue: 0,0:10:58.75,0:10:59.71,Main,,0,0,0,,كيوماسا
Dialogue: 0,0:11:00.25,0:11:04.63,Main,,0,0,0,,ناهيك عن كون أحدهما حارسًا غريب الأطوار لا يجيد شيئًا سوى التلويح بسيفه
Dialogue: 0,0:11:05.13,0:11:05.92,Main,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:11:06.25,0:11:07.50,Main,,0,0,0,,ما الّذي ترمي إليه؟
Dialogue: 0,0:11:08.13,0:11:11.96,Main,,0,0,0,,أنتَ تعلم أن هذا الضريح المقدس ليس مكانًا لمثل هذه الخلافات التافهة
Dialogue: 0,0:11:12.50,0:11:14.42,Main,,0,0,0,,أجل، أستميحكِ عذرًا
Dialogue: 0,0:11:14.71,0:11:16.63,Main,,0,0,0,,وهذا ينطبق عليك أيضًا يا كيوماسا
Dialogue: 0,0:11:16.83,0:11:17.88,Main,,0,0,0,,أنا أيضًا؟
Dialogue: 0,0:11:18.13,0:11:20.95,Main,,0,0,0,,أجل، أنتَ حارس، أليس كذلك؟
Dialogue: 0,0:11:21.00,0:11:25.54,Main,,0,0,0,,صحيح أنّني حارس، لكن وظيفتي تقتصر على حمايتكِ فقط
Dialogue: 0,0:11:27.08,0:11:28.29,Main,,0,0,0,,كيوماسا
Dialogue: 0,0:11:28.67,0:11:30.67,Main,,0,0,0,,حسنٌ، حسنٌ، فهمت
Dialogue: 0,0:11:35.13,0:11:38.77,Main,,0,0,0,,حسنٌ إذن، بهذا نختتم اجتماعنا
Dialogue: 0,0:12:00.33,0:12:03.19,Main,,0,0,0,,هل أنتَ الوحيد الّذي لم يغادر؟
Dialogue: 0,0:12:03.33,0:12:04.04,Main,,0,0,0,,أجل
Dialogue: 0,0:12:04.71,0:12:06.50,Main,,0,0,0,,إذن لا داعي للرسميات
Dialogue: 0,0:12:17.33,0:12:18.38,Main,,0,0,0,,!صاحبة السمو
Dialogue: 0,0:12:21.96,0:12:26.08,Main,,0,0,0,,كم مرّةً عليّ أن أخبرك بأن تتوقف عن التحدث بهذه الطريقة يا جينتا؟
Dialogue: 0,0:12:26.25,0:12:28.08,Main,,0,0,0,,لكن يجب عليّ احترام مكانتكِ
Dialogue: 0,0:12:29.46,0:12:32.75,Main,,0,0,0,,...أعلم أن هذا قد يكون صعبًا عليك، ولكن
Dialogue: 0,0:12:32.81,0:12:35.75,Main,,0,0,0,,أتمنى أن تستخدم اسمي عندما نكون بمفردنا فقط
Dialogue: 0,0:12:36.58,0:12:40.21,Main,,0,0,0,,بما أنّك الشخص الوحيد المتبقي الّذي يمكنه مناداتي باسمي الآن
Dialogue: 0,0:12:41.08,0:12:42.21,Main,,0,0,0,,...ولكن
Dialogue: 0,0:12:47.38,0:12:48.54,Main,,0,0,0,,شيرايوكي
Dialogue: 0,0:12:51.92,0:12:53.46,Main,,0,0,0,,آسفة على أنانيتي
Dialogue: 0,0:12:53.89,0:12:56.89,Main,,0,0,0,,لا يجوز أن أواصل الاتكال عليك دائمًا يا جينتا
Dialogue: 0,0:12:57.13,0:12:58.67,Main,,0,0,0,,أنا حارسكِ الشخصي
Dialogue: 0,0:12:59.21,0:13:02.50,Main,,0,0,0,,ما المشكلة في اعتماد الكاهنة على حارسها؟
Dialogue: 0,0:13:04.92,0:13:05.75,Main,,0,0,0,,شكرًا لك
Dialogue: 0,0:13:07.38,0:13:09.96,Main,,0,0,0,,بالمناسبة، سوزو-تشان متواجدة هنا
Dialogue: 0,0:13:13.42,0:13:14.58,Main,,0,0,0,,!شيرايوكي
Dialogue: 0,0:13:27.88,0:13:29.88,Main,,0,0,0,,،إن تمَّ ضبطها وهي تتسلل إلى هذا المكان
Dialogue: 0,0:13:29.88,0:13:34.63,Main,,0,0,0,,فلا تلومنّي حين يطردونها لعدم احترامها لصاحبة السمو
Dialogue: 0,0:13:34.79,0:13:36.21,Main,,0,0,0,,لا تقل ذلك
Dialogue: 0,0:13:36.58,0:13:38.50,Main,,0,0,0,,جاءت سوزو-تشان لرؤيتك يا جينتا
Dialogue: 0,0:13:38.79,0:13:39.67,Main,,0,0,0,,أنا؟
Dialogue: 0,0:13:41.54,0:13:44.38,Main,,0,0,0,,،كنتَ بعيدًا عن المنزل لمدة يومين بسبب مهمة صيد الشياطين
Dialogue: 0,0:13:44.58,0:13:46.42,Main,,0,0,0,,لذا أظن أنّها لم تعد قادرةً على تحمل غيابك
Dialogue: 0,0:13:47.08,0:13:49.38,Main,,0,0,0,,ومع ذلك، هذا ليس مبررًا لخرق القوانين
Dialogue: 0,0:13:49.96,0:13:51.79,Main,,0,0,0,,!استيقظي يا سوزوني
Dialogue: 0,0:13:56.58,0:13:58.21,Main,,0,0,0,,صباح الخير يا أخي
Dialogue: 0,0:14:00.58,0:14:01.96,Main,,0,0,0,,!أهلًا بعودتك
Dialogue: 0,0:14:03.38,0:14:04.45,Main,,0,0,0,,لقد عدت
Dialogue: 0,0:14:08.29,0:14:12.33,Main,,0,0,0,,سوزوني، أخبرتكِ مرارًا وتكرارًا أنَّ هذا المعبد محظور
Dialogue: 0,0:14:12.46,0:14:14.70,Main,,0,0,0,,هذا ليس مكانًا يُسمح بدخوله
Dialogue: 0,0:14:14.75,0:14:18.21,Main,,0,0,0,,لكن لِمَ يُسمح لك بالمجيء وأنا لا؟
Dialogue: 0,0:14:18.83,0:14:21.33,Main,,0,0,0,,هذه هي القوانين، وعليك اتباعها
Dialogue: 0,0:14:21.33,0:14:22.70,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:14:23.92,0:14:25.50,Main,,0,0,0,,كونك الأخ الأكبر ليس بالأمر السهل
Dialogue: 0,0:14:26.29,0:14:28.54,Main,,0,0,0,,ثمة أحد قادم، التزمي الصمت يا سوزوني
Dialogue: 0,0:14:28.54,0:14:30.50,Main,,0,0,0,,!لا تقلق، أعرف مخرجًا سريًا
Dialogue: 0,0:14:30.71,0:14:31.41,Main,,0,0,0,,!تمهلي
Dialogue: 0,0:14:31.79,0:14:33.13,Main,,0,0,0,,!أراك لاحقًا
Dialogue: 0,0:14:38.29,0:14:39.38,Main,,0,0,0,,بوركت جهودك
Dialogue: 0,0:14:39.75,0:14:41.71,Main,,0,0,0,,سوزوني-تشان فتاة لطيفة بحقّ
Dialogue: 0,0:14:41.92,0:14:44.46,Main,,0,0,0,,بصراحة، كان اليوم مرهقًا جدًّا
Dialogue: 0,0:14:55.29,0:14:58.04,Main,,0,0,0,,هل تسمحين لي بدقيقةٍ من وقتكِ يا صاحبة السمو؟
Dialogue: 0,0:14:58.33,0:15:01.58,Main,,0,0,0,,آمل سماع ردّكِ على الاقتراح الّذي قدمته لكِ منذ عدّة أيام
Dialogue: 0,0:15:02.33,0:15:04.17,Main,,0,0,0,,هكذا إذن
Dialogue: 0,0:15:05.71,0:15:07.00,Main,,0,0,0,,أستميحكِ عذرًا
Dialogue: 0,0:15:12.71,0:15:16.79,Main,,0,0,0,,جينتا، هل تمانع الخروج لبضع دقائق؟
Dialogue: 0,0:15:17.29,0:15:19.64,Main,,0,0,0,,ولكن، واجبي يقتضي البقاء بجانبها
Dialogue: 0,0:15:19.08,0:15:19.99,Top,,0,0,0,,جينتا
Dialogue: 0,0:15:20.29,0:15:21.88,Main,,0,0,0,,يمكنك الانصراف
Dialogue: 0,0:15:23.54,0:15:24.13,Main,,0,0,0,,سمعًا وطاعة
Dialogue: 0,0:15:28.54,0:15:29.21,Main,,0,0,0,,جينتا
Dialogue: 0,0:15:30.33,0:15:33.96,Main,,0,0,0,,جينتا، أرجو منك الاستمرار في حماية كادونو بصفتك حارسها
Dialogue: 0,0:15:51.04,0:15:53.00,Main,,0,0,0,,...جينتا، أنا
Dialogue: 0,0:15:53.54,0:15:55.04,Main,,0,0,0,,أريد أن أصبح إيتسوكيهيمي
Dialogue: 0,0:16:00.33,0:16:03.00,Main,,0,0,0,,لأنّي أحب قرية كادونو الّتي لطالما حمتها أمي
Dialogue: 0,0:16:03.63,0:16:07.54,Main,,0,0,0,,إن كنتُ قادرةً على أن أكون سندًا لك، فهذا يكفيني
Dialogue: 0,0:16:11.92,0:16:12.63,Main,,0,0,0,,...لكن
Dialogue: 0,0:16:13.42,0:16:14.88,Main,,0,0,0,,لن يكون بمقدوري رؤيتك مرّة أخرى
Dialogue: 0,0:16:19.08,0:16:20.92,Main,,0,0,0,,إذن، سآتي لرؤيتكِ
Dialogue: 0,0:16:21.67,0:16:23.21,Main,,0,0,0,,...صحيح أنّي ضعيف الآن، لكن
Dialogue: 0,0:16:23.67,0:16:25.13,Main,,0,0,0,,!سأصبح أقوى
Dialogue: 0,0:16:25.58,0:16:29.79,Main,,0,0,0,,سأسير على خطى موتوهارو-سان وأتدرب بجدٍ حتّى أقدر على دحر أيّ شيطان
Dialogue: 0,0:16:30.42,0:16:33.21,Main,,0,0,0,,حينها سأصبح حارس القرية وآتي لرؤيتكِ
Dialogue: 0,0:16:56.96,0:16:57.96,Main,,0,0,0,,كيف تسير الأمور؟
Dialogue: 0,0:16:58.46,0:16:59.67,Main,,0,0,0,,بسلاسة
Dialogue: 0,0:17:00.08,0:17:05.13,Main,,0,0,0,,بالرغم من أنّها قدرتي الخاصة، إلا أنّها بدت خيالية لدرجة لا تُصدق
Dialogue: 0,0:17:05.50,0:17:08.71,Main,,0,0,0,,لكنّي تأكدت من ذلك الآن بأم عيني
Dialogue: 0,0:17:09.25,0:17:13.22,Main,,0,0,0,,لا شك في ذلك، إنّها تبدو مثل الّتي رأيتها تمامًا
Dialogue: 0,0:17:30.29,0:17:33.04,Main,,0,0,0,,أخي، يبدو أنّك غير مُشغول اليوم
Dialogue: 0,0:17:34.00,0:17:36.46,Main,,0,0,0,,أخبروني أنّهم لا يحتاجون خدماتي في المعبد إلّا بعد فترة الظهيرة
Dialogue: 0,0:17:40.75,0:17:42.54,Main,,0,0,0,,!حقًّا؟
Dialogue: 0,0:17:46.46,0:17:47.79,Main,,0,0,0,,هل هناك شيء على وجهي؟
Dialogue: 0,0:17:48.46,0:17:50.42,Main,,0,0,0,,ضمادتكِ بدأت تنفك
Dialogue: 0,0:17:53.54,0:17:54.88,Main,,0,0,0,,هل هذا جيد؟
Dialogue: 0,0:17:55.58,0:17:56.42,Main,,0,0,0,,أجل
Dialogue: 0,0:18:03.29,0:18:05.71,Main,,0,0,0,,يبدو أنّنا عثرنا على السعادة فعلًا
Dialogue: 0,0:18:06.33,0:18:10.25,Main,,0,0,0,,وجودكَ فقط ما يلزمني لأكون سعيدةً يا أخي
Dialogue: 0,0:18:12.21,0:18:13.25,Main,,0,0,0,,!صباح الخير
Dialogue: 0,0:18:15.04,0:18:16.13,Main,,0,0,0,,الأميرة؟
Dialogue: 0,0:18:19.79,0:18:21.21,Main,,0,0,0,,!ما الّذي تفعلينه هنا؟
Dialogue: 0,0:18:21.42,0:18:22.71,Main,,0,0,0,,!تملصت
Dialogue: 0,0:18:22.92,0:18:25.79,Main,,0,0,0,,جينتا، أيمكنكَ قضاء اليوم بأكمله معي؟
Dialogue: 0,0:18:26.04,0:18:27.80,Main,,0,0,0,,تملصتِ؟
Dialogue: 0,0:18:27.88,0:18:29.09,Main,,0,0,0,,...لكن لا يمكن للكاهنة
Dialogue: 0,0:18:28.18,0:18:29.66,Top,,0,0,0,,لا تقلق
Dialogue: 0,0:18:29.68,0:18:32.29,Main,,0,0,0,,أوسامو موافق على خطط اليوم
Dialogue: 0,0:18:32.96,0:18:36.29,Main,,0,0,0,,!أخي، لنتناول الإفطار معًا كما كنا نفعل في الأيام الخوالي
Dialogue: 0,0:18:37.58,0:18:38.63,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:18:38.71,0:18:40.00,Main,,0,0,0,,!أسرع يا أخي
Dialogue: 0,0:18:40.00,0:18:42.66,Main,,0,0,0,,!من غير اللائق أن نترك الأميرة تخدم نفسها
Dialogue: 0,0:18:42.71,0:18:44.79,Main,,0,0,0,,!تمهلي، لا تتحمسي كثيرًا
Dialogue: 0,0:18:53.92,0:18:56.46,Main,,0,0,0,,كان عليكَ تقديم شيءٍ أطيب طعمًا
Dialogue: 0,0:18:56.46,0:18:57.42,Main,,0,0,0,,توقفي عن التذمر
Dialogue: 0,0:18:57.88,0:18:59.67,Main,,0,0,0,,أخي، هل أنتَ طباخ سيء أم ماذا؟
Dialogue: 0,0:18:59.67,0:19:00.75,Main,,0,0,0,,سأضربكِ
Dialogue: 0,0:19:01.08,0:19:05.21,Main,,0,0,0,,جينتا لطيف جدًّا، لذا من المستحيل أن يضرب سوزو-تشان، أليس كذلك؟
Dialogue: 0,0:19:06.38,0:19:08.92,Main,,0,0,0,,،بصفتي أخًا، سأوبخ عندما يكون التوبيخ ضروريًا
Dialogue: 0,0:19:09.08,0:19:10.75,Main,,0,0,0,,وسأرفع يدي إن لزم الأمر
Dialogue: 0,0:19:11.96,0:19:14.11,Main,,0,0,0,,لكن هذا لن يحدث أبدًا، أليس كذلك؟
Dialogue: 0,0:19:14.13,0:19:16.25,Main,,0,0,0,,هل تعتقدين ذلك أيضًا يا سوزو-تشان؟
Dialogue: 0,0:19:16.25,0:19:18.88,Main,,0,0,0,,أجل، لأنّه أخي
Dialogue: 0,0:19:18.92,0:19:20.96,Main,,0,0,0,,!سأضربكما بجدية
Dialogue: 0,0:19:22.58,0:19:24.33,Main,,0,0,0,,إذن، لِمَ لا تجرب؟
Dialogue: 0,0:19:24.46,0:19:26.21,Main,,0,0,0,,يمكنك أن تضربني ضربةً خفيفة
Dialogue: 0,0:19:36.67,0:19:39.88,Main,,0,0,0,,حسنٌ، لم تفعلا شيئًا سيئًا على أيّ حال
Dialogue: 0,0:19:40.13,0:19:41.58,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:19:51.25,0:19:52.56,Main,,0,0,0,,تبدين سعيدة
Dialogue: 0,0:19:52.63,0:19:55.83,Main,,0,0,0,,لأنّكَ ستقضي اليوم بأكمله مع الأميرة
Dialogue: 0,0:19:56.08,0:19:58.00,Main,,0,0,0,,لهذا سوزو سعيدة
Dialogue: 0,0:19:58.38,0:19:59.92,Main,,0,0,0,,لِمَ تشعر بالسعادة حيال ذلك؟
Dialogue: 0,0:20:00.17,0:20:02.29,Main,,0,0,0,,لأن سوزو تحب أخاها كثيرًا
Dialogue: 0,0:20:02.50,0:20:05.46,Main,,0,0,0,,لهذا أنا سعيدة حين يكون أخي سعيدًا
Dialogue: 0,0:20:09.79,0:20:11.02,Main,,0,0,0,,اعتني بالمنزل
Dialogue: 0,0:20:11.21,0:20:13.46,Main,,0,0,0,,!حسنٌ، رافقتك السلامة
Dialogue: 0,0:20:18.79,0:20:20.83,Main,,0,0,0,,!حسنٌ، لنذهب لتناول الدانغو
Dialogue: 0,0:20:37.33,0:20:39.08,Main,,0,0,0,,سوزوني-تشان لطيفة بحقّ
Dialogue: 0,0:20:39.29,0:20:40.09,Main,,0,0,0,,أجل
Dialogue: 0,0:20:43.88,0:20:46.21,Main,,0,0,0,,!رأيتُ جينتا-ساما يتمشى مع امرأة جميلة
Dialogue: 0,0:20:49.79,0:20:51.71,Main,,0,0,0,,جينتا-ساما برفقة امرأة جميلة؟
Dialogue: 0,0:20:51.71,0:20:53.71,Main,,0,0,0,,!هل بياكويا-ساما على علمٍ بهذا؟
Dialogue: 0,0:20:53.71,0:20:54.92,Main,,0,0,0,,!يا لها من فضيحة
Dialogue: 0,0:20:57.00,0:20:58.83,Main,,0,0,0,,تشيتوسي، عذرًا على إزعاجكِ
Dialogue: 0,0:20:59.04,0:21:00.71,Main,,0,0,0,,!جينتا-ساما
Dialogue: 0,0:21:00.88,0:21:02.88,Main,,0,0,0,,!أهلًا... وسهلًا بك
Dialogue: 0,0:21:03.50,0:21:05.17,Main,,0,0,0,,هل لي أن أعرف من هذه السيدة؟
Dialogue: 0,0:21:05.17,0:21:07.96,Main,,0,0,0,,إنّها من معارفي، لا تطرحي المزيد من الأسئلة
Dialogue: 0,0:21:09.83,0:21:11.54,Main,,0,0,0,,!أريد عشرة طلبات دانغو
Dialogue: 0,0:21:11.54,0:21:12.69,Main,,0,0,0,,!اثنتان تكفيان
Dialogue: 0,0:21:12.88,0:21:13.96,Main,,0,0,0,,وأيضًا بعض الشاي
Dialogue: 0,0:21:19.00,0:21:21.25,Main,,0,0,0,,يبدو أنَّ تشيتوسي-تشان لم تتعرف عليّ
Dialogue: 0,0:21:21.50,0:21:23.71,Main,,0,0,0,,لم تتقابلا وجهًا لوجه منذ سنوات
Dialogue: 0,0:21:23.96,0:21:24.96,Main,,0,0,0,,لا عجب في ذلك
Dialogue: 0,0:21:25.50,0:21:27.33,Main,,0,0,0,,...أعرف ذلك، ولكن
Dialogue: 0,0:21:36.42,0:21:37.52,Main,,0,0,0,,شكرًا لك
Dialogue: 0,0:21:38.13,0:21:39.72,Main,,0,0,0,,عذرًا عن التأخير
Dialogue: 0,0:21:44.17,0:21:45.38,Main,,0,0,0,,...هذا
Dialogue: 0,0:21:45.38,0:21:47.71,Main,,0,0,0,,إيسوبي موتشي، كنتَ تُحِبها في صِغرك، أليس كذلك؟
Dialogue: 0,0:21:48.13,0:21:49.68,Main,,0,0,0,,أتتذكرين ذلك؟
Dialogue: 0,0:21:49.83,0:21:51.92,Main,,0,0,0,,،أجل، كان لدينا القليل
Dialogue: 0,0:21:51.92,0:21:53.37,Main,,0,0,0,,فقلت لِمَ لا أقدمها لـ جينتا-ني
Dialogue: 0,0:21:53.39,0:21:55.92,Main,,0,0,0,,آ-آسفة
Dialogue: 0,0:21:57.06,0:21:58.26,Main,,0,0,0,,لا أمانع ذلك
Dialogue: 0,0:22:04.04,0:22:04.84,Main,,0,0,0,,لذيذ
Dialogue: 0,0:22:06.75,0:22:08.71,Main,,0,0,0,,خذ راحتك في أكلها
Dialogue: 0,0:22:12.33,0:22:14.58,Main,,0,0,0,,يبدو أنَّ تشيتوسي-تشان كانت متوترة
Dialogue: 0,0:22:14.75,0:22:16.25,Main,,0,0,0,,لا ألومها
Dialogue: 0,0:22:16.79,0:22:18.75,Main,,0,0,0,,...فأنا الآن في نظرها
Dialogue: 0,0:22:18.75,0:22:22.00,Main,,0,0,0,,حارس القرية وليس أخوها الكبير جينتا
Dialogue: 0,0:22:23.46,0:22:24.46,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:22:28.46,0:22:30.21,Main,,0,0,0,,لا شيء يدوم للأبد
Dialogue: 0,0:22:30.79,0:22:32.79,Main,,0,0,0,,هذا ما كان والدي يقوله دائمًا
Dialogue: 0,0:22:32.83,0:22:33.67,Main,,0,0,0,,أجل
Dialogue: 0,0:22:33.88,0:22:38.29,Main,,0,0,0,,كان دائمًا يسعى لتعليمي دروسًا مهمةً في الحياة
Dialogue: 0,0:22:39.38,0:22:44.00,Main,,0,0,0,,ما زلتُ أشعر وكأنّه يوجهني لأسير على خطاه حتّى الآن
Dialogue: 0,0:22:44.92,0:22:46.10,Main,,0,0,0,,هكذا إذن
Dialogue: 0,0:22:46.88,0:22:53.50,Main,,0,0,0,,أتمنى أن نستمر في الحفاظ على جمال طبيعة قرية كادونو مثلما فعل والديّ
Dialogue: 0,0:22:54.50,0:22:55.25,Main,,0,0,0,,أجل
Dialogue: 0,0:23:03.88,0:23:05.11,Main,,0,0,0,,شكرًا على اليوم
Dialogue: 0,0:23:05.29,0:23:07.25,Main,,0,0,0,,لا، بل أنا الّذي استمتعت بوقتي
Dialogue: 0,0:23:07.54,0:23:10.13,Main,,0,0,0,,هكذا إذن، يسعدني سماع ذلك
Dialogue: 0,0:23:10.67,0:23:13.71,Main,,0,0,0,,...شعرت بالسوء لأنّي جعلتك تسايرني في نزوةٍ أخرى من نزواتي الأنانية
Dialogue: 0,0:23:17.71,0:23:19.43,Main,,0,0,0,,هل أنتِ راضية الآن؟
Dialogue: 0,0:23:19.67,0:23:20.29,Main,,0,0,0,,أجل
Dialogue: 0,0:23:24.63,0:23:27.88,Main,,0,0,0,,في الواقع، أردتُ فقط فرصةً لنتبادل الحديث هنا
Dialogue: 0,0:23:28.21,0:23:30.49,Main,,0,0,0,,هذا هو المكان هو نقطة البداية بالنسبة لي
Dialogue: 0,0:23:31.38,0:23:33.88,Main,,0,0,0,,لهذا رأيت أنّه المكان الأنسب لأشاركك فيه ما لديَّ من أخبار
Dialogue: 0,0:23:34.67,0:23:36.38,Main,,0,0,0,,هل ستصغي إليّ؟
Dialogue: 0,0:23:37.38,0:23:38.01,Main,,0,0,0,,أجل
Dialogue: 0,0:23:42.50,0:23:45.17,Main,,0,0,0,,أنا... على وشك الزواج من كيوماسا
Dialogue: 0,0:23:49.58,0:23:51.88,Main,,0,0,0,,تلقيتُ توبيخًا من الزعيم بالأمس
Dialogue: 0,0:23:52.79,0:23:54.46,Main,,0,0,0,,،قال إنّه إذا كانت الشياطين تستهدفني
Dialogue: 0,0:23:54.96,0:23:58.63,Main,,0,0,0,,فعليَّ إنجابُ وريثٍ قبل أن أصبح مثل سلَفي
Dialogue: 0,0:24:00.08,0:24:03.71,Main,,0,0,0,,،كيوماسا حارس، كما أنّه من عائلة كادونو
Dialogue: 0,0:24:04.21,0:24:06.08,Main,,0,0,0,,وسيصبح زعيم القرية يومًا ما
Dialogue: 0,0:24:07.79,0:24:11.13,Main,,0,0,0,,،الغرض من زواجنا سيصب في مصلحة الجميع
Dialogue: 0,0:24:13.92,0:24:15.79,Main,,0,0,0,,وأنا بدوري أتفق مع ذلك
Dialogue: 0,0:24:19.21,0:24:22.58,Main,,0,0,0,,أنا الآن شيرايوكي، لذا سأقول ما عندي
Dialogue: 0,0:24:28.13,0:24:30.88,Main,,0,0,0,,أنا أحبك يا جينتا
Dialogue: 0,0:24:34.67,0:24:36.33,Main,,0,0,0,,لكن من الآن فصاعدًا أنا بياكويا
Dialogue: 0,0:24:36.92,0:24:38.98,Main,,0,0,0,,لا يمكنني العودة إلى كوني شيرايوكي
Dialogue: 0,0:24:40.33,0:24:45.42,Main,,0,0,0,,لأكون صريحة، كنتُ مستعدةً للرحيل وبدء حياةٍ جديدةٍ معكَ في مكان آخر
Dialogue: 0,0:24:46.63,0:24:50.76,Main,,0,0,0,,لكنّي كنتُ على يقين بأنّك لن تتخذ هذا الدرب أبدًا
Dialogue: 0,0:24:51.46,0:24:52.63,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:24:52.96,0:24:56.11,Main,,0,0,0,,هل هذا يعني أنّك لا تحبني؟
Dialogue: 0,0:24:56.75,0:25:01.38,Main,,0,0,0,,الّتي أقسمتُ على حمايتِها ليست شيرايوكي بل بياكويا
Dialogue: 0,0:25:02.33,0:25:05.50,Main,,0,0,0,,...السبب وراء عزمي على اتقان فن السيف منذ صغري هو
Dialogue: 0,0:25:06.04,0:25:10.79,Main,,0,0,0,,لأنّي احترمتُ إرادتكِ في أن تصبحي إيتسوكيهيمي
Dialogue: 0,0:25:12.63,0:25:15.29,Main,,0,0,0,,،لو اخترتُ دربًا يجمعني معكِ
Dialogue: 0,0:25:15.96,0:25:18.13,Main,,0,0,0,,،فسأكون قد أهدرتُ تدريباتي
Dialogue: 0,0:25:18.92,0:25:21.17,Main,,0,0,0,,وأنكرتُ إرادتكِ أنتِ أيضًا
Dialogue: 0,0:25:22.13,0:25:26.00,Main,,0,0,0,,لا يمكنني... التعايش مع ذلك أبدًا
Dialogue: 0,0:25:27.08,0:25:29.38,Main,,0,0,0,,أنتَ مثلي تمامًا كما توقعت يا جينتا
Dialogue: 0,0:25:30.13,0:25:35.38,Main,,0,0,0,,شخص يختار أن يسير في درب حياته الخاصة بدلًا من اتباع مشاعر الآخرين في النهاية
Dialogue: 0,0:25:36.92,0:25:39.25,Main,,0,0,0,,قررتُ أن أصبح إيتسوكيهيمي بمحض إرادتي
Dialogue: 0,0:25:40.21,0:25:44.71,Main,,0,0,0,,لذلك إن تجاهلتُ كوني كاهنة، لن أستطيع النظر في وجهكَ مرّة أخرى يا جينتا
Dialogue: 0,0:25:45.67,0:25:51.58,Main,,0,0,0,,إن كان الدرب الّذي سرتُ فيه حتّى الآن كذبة، فمن المؤكد أنَّ قلبي الّذي يُحبك سيصبح كذبةً كذلك
Dialogue: 0,0:25:53.50,0:25:54.38,Main,,0,0,0,,...لهذا
Dialogue: 0,0:25:55.17,0:25:57.25,Main,,0,0,0,,سأستمر في العيش بصفتي إيتسوكيهيمي
Dialogue: 0,0:26:01.58,0:26:05.96,Main,,0,0,0,,لكي يظل قلبي صادقًا، ويدوم حبّي لكَ حتّى النهاية
Dialogue: 0,0:26:06.83,0:26:07.54,Main,,0,0,0,,أجل
Dialogue: 0,0:26:08.29,0:26:13.17,Main,,0,0,0,,إذن سأفعل المثل وأستمر في العيش بصفتي حارسكِ لحمايتكِ دائمًا
Dialogue: 0,0:26:13.96,0:26:14.63,Main,,0,0,0,,أجل
Dialogue: 0,0:26:29.25,0:26:32.54,Main,,0,0,0,,تمَّ الإبلاغ عن وجود شيطانين يجوبان غابة تابو
Dialogue: 0,0:26:33.04,0:26:35.08,Main,,0,0,0,,سيبقى كيوماسا هنا لحراسة كادونو
Dialogue: 0,0:26:35.58,0:26:39.21,Main,,0,0,0,,وفي هذه الأثناء، ستدخل الغابة وتؤدي واجباتك كحارس
Dialogue: 0,0:26:39.38,0:26:42.38,Main,,0,0,0,,حسنٌ، قبلتُ مهمة القضاء على الشياطين
Dialogue: 0,0:26:46.00,0:26:47.71,Main,,0,0,0,,أتمنى لك التوفيق
Dialogue: 0,0:26:54.42,0:26:55.31,Main,,0,0,0,,!يا هذا
Dialogue: 0,0:26:56.92,0:26:57.84,Main,,0,0,0,,!يا هذا
Dialogue: 0,0:26:59.25,0:27:01.06,Main,,0,0,0,,لمَ لا تقول شيئًا؟
Dialogue: 0,0:27:01.17,0:27:03.17,Main,,0,0,0,,سمعتَ عن أمري مع بياكو، أليس كذلك؟
Dialogue: 0,0:27:04.13,0:27:04.93,Main,,0,0,0,,أجل
Dialogue: 0,0:27:05.08,0:27:06.83,Main,,0,0,0,,وأنتَ راضٍ بهذا حقًّا؟
Dialogue: 0,0:27:06.96,0:27:08.97,Main,,0,0,0,,!ما الّذي يدور في ذهنك؟
Dialogue: 0,0:27:08.99,0:27:12.71,Main,,0,0,0,,بالطبع، سلامة الأميرة والسلام في قرية كادونو
Dialogue: 0,0:27:13.13,0:27:15.17,Main,,0,0,0,,!أنتَ أيضًا لديكَ مشاعر تجاه بياكويا
Dialogue: 0,0:27:18.17,0:27:20.17,Main,,0,0,0,,هل أنتَ راضٍ بهذا حقًّا؟
Dialogue: 0,0:27:21.67,0:27:24.39,Main,,0,0,0,,!أنتَ... ثمة خطب ما في عقلك
Dialogue: 0,0:27:25.21,0:27:26.79,Main,,0,0,0,,أوافقك الرأي
Dialogue: 0,0:27:43.00,0:27:45.41,Main,,0,0,0,,مرحبًا أيّتها آنسة الصغيرة
Dialogue: 0,0:28:13.17,0:28:16.08,Main,,0,0,0,,كنت أعتقد أنّي سأصيبك على حين غرة
Dialogue: 0,0:28:16.54,0:28:19.42,Main,,0,0,0,,أنتَ بمفردك؟ سمعتُ أنكما اثنان
Dialogue: 0,0:28:19.77,0:28:22.48,Main,,0,0,0,,ذهب رفيقي إلى قرية كادونو
Dialogue: 0,0:28:23.33,0:28:24.13,Main,,0,0,0,,فهمت
Dialogue: 0,0:29:06.96,0:29:08.75,Main,,0,0,0,,كنتُ أعلم أنَّ هذا سيكون مثيرًا للاهتمام
Dialogue: 0,0:29:10.63,0:29:15.63,Main,,0,0,0,,نعيش نحن الشياطين لأكثر من ألفي عام، بينما أنتم البشر حياتكم قصيرة للغاية
Dialogue: 0,0:29:16.08,0:29:22.08,Main,,0,0,0,,لكنكم تتقدمون وتتطورون بفضل إرادتكم ومهاراتكم الّتي ترثونها
Dialogue: 0,0:29:23.04,0:29:25.80,Main,,0,0,0,,البشر حقًّا مثيرون للاهتمام
Dialogue: 0,0:29:26.04,0:29:27.67,Main,,0,0,0,,لهذا تحديدًا أريد أن أطرح عليكَ سؤالًا
Dialogue: 0,0:29:28.13,0:29:31.27,Main,,0,0,0,,لِمَ تحمل ذلك السيف أيّها البشري؟
Dialogue: 0,0:29:31.50,0:29:35.42,Main,,0,0,0,,تحديتَ قوانين الطبيعة لتكتسب القوّة، ولكن ما الّذي ستقطعه؟
Dialogue: 0,0:29:36.83,0:29:41.08,Main,,0,0,0,,!لأجل قومي، سأستله على كلِّ من يهدّد الّذين عليَّ حمايتهم
Dialogue: 0,0:29:41.96,0:29:45.21,Main,,0,0,0,,هل تعرفين ماهيتي؟
Dialogue: 0,0:29:45.92,0:29:46.88,Main,,0,0,0,,...شيطان
Dialogue: 0,0:29:47.50,0:29:49.79,Main,,0,0,0,,أجل، مثلكِ تمامًا
Dialogue: 0,0:29:50.13,0:29:51.83,Main,,0,0,0,,نحن رفاق
Dialogue: 0,0:29:52.33,0:29:53.71,Main,,0,0,0,,...كلا، سوزو
Dialogue: 0,0:29:54.71,0:29:55.75,Main,,0,0,0,,بشرية
Dialogue: 0,0:29:59.13,0:30:01.38,Main,,0,0,0,,أخوكِ، شخصٌ طيب
Dialogue: 0,0:30:02.54,0:30:06.38,Main,,0,0,0,,أعني، أليس السبب وراء رغبتكِ في البقاء كبشرية هو أخوكِ؟
Dialogue: 0,0:30:06.92,0:30:11.29,Main,,0,0,0,,إن كانت حماية أخيكِ هي من رسختْ هذه الفكرة فيكِ
Dialogue: 0,0:30:11.50,0:30:14.08,Main,,0,0,0,,فهذا أمر مذهل بحقّ
Dialogue: 0,0:30:15.29,0:30:16.00,Main,,0,0,0,,!أجل
Dialogue: 0,0:30:16.59,0:30:18.92,Main,,0,0,0,,أنتِ تحبين أخاكِ كثيرًا، أليس كذلك؟
Dialogue: 0,0:30:20.08,0:30:21.42,Main,,0,0,0,,...لأنَّ أخي
Dialogue: 0,0:30:21.42,0:30:23.13,Main,,0,0,0,,هو كلّ شيء بالنسبة لي
Dialogue: 0,0:30:25.88,0:30:27.71,Main,,0,0,0,,إنّها فتاة رغم صغر سنّها
Dialogue: 0,0:30:32.04,0:30:34.97,Main,,0,0,0,,أحدهم يسعى إلى إلحاق الأذى بأخيكِ
Dialogue: 0,0:30:35.33,0:30:37.60,Main,,0,0,0,,هل يمكنكِ أن تعينيني بقوتكِ؟
Dialogue: 0,0:30:37.63,0:30:39.25,Main,,0,0,0,,قوة سوزو؟
Dialogue: 0,0:30:39.46,0:30:42.82,Main,,0,0,0,,أجل، كلّ ما عليكِ فعله هو مرافقتي لبرهة
Dialogue: 0,0:30:43.38,0:30:46.08,Main,,0,0,0,,لا تقلقي، نحن الشياطين لا نكذب
Dialogue: 0,0:30:46.08,0:30:48.78,Main,,0,0,0,,لن ألحق بكِ أيّ أذى
Dialogue: 0,0:30:50.92,0:30:51.98,Main,,0,0,0,,لن أذهب
Dialogue: 0,0:30:52.13,0:30:55.92,Main,,0,0,0,,حتّى وإن لم تؤذيني، لا أستطيع أن أضمن عدم إيذائكِ لأخي
Dialogue: 0,0:30:56.50,0:30:57.62,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:30:58.33,0:31:00.67,Main,,0,0,0,,إذن، ما رأيكِ بهذا؟
Dialogue: 0,0:31:24.21,0:31:25.33,Main,,0,0,0,,ما كان ذلك؟
Dialogue: 0,0:31:25.92,0:31:28.18,Main,,0,0,0,,قوتي هي رؤية المستقبل
Dialogue: 0,0:31:28.25,0:31:33.75,Main,,0,0,0,,يمكنني مشاركة الآخرين رؤىً من المستقبل الّذي شاهدته حتّى لو كانت لمحةً قصيرةً
Dialogue: 0,0:31:35.17,0:31:37.67,Main,,0,0,0,,لم أسمع بهذا أبدًا، ما الّذي رأيته؟
Dialogue: 0,0:31:38.00,0:31:39.21,Main,,0,0,0,,ما الّذي رأيته؟
Dialogue: 0,0:31:40.92,0:31:43.44,Main,,0,0,0,,بالطبع، ذلك ليس مجرد وهم
Dialogue: 0,0:31:43.50,0:31:44.40,Main,,0,0,0,,أنتِ تكذبين
Dialogue: 0,0:31:44.79,0:31:46.04,Main,,0,0,0,,لا تصدقينني؟
Dialogue: 0,0:31:46.54,0:31:48.25,Main,,0,0,0,,إذن، لنذهب ونتأكد بأنفسنا
Dialogue: 0,0:31:55.96,0:31:57.90,Main,,0,0,0,,لأجل أخيكِ
Dialogue: 0,0:31:58.29,0:31:59.92,Main,,0,0,0,,لأجل أخي؟
Dialogue: 0,0:32:27.67,0:32:29.04,Main,,0,0,0,,سأسألك بدوري
Dialogue: 0,0:32:29.29,0:32:32.04,Main,,0,0,0,,أيّها الشيطان، ما الّذي يدفعك لإيذاء البشر؟
Dialogue: 0,0:32:32.50,0:32:34.36,Main,,0,0,0,,لأنّي من الشياطين
Dialogue: 0,0:32:34.48,0:32:37.05,Main,,0,0,0,,هل تقصد أنَّ الشياطين تقتل البشر بحكم طبيعتهم؟
Dialogue: 0,0:32:37.29,0:32:38.41,Main,,0,0,0,,كلا
Dialogue: 0,0:32:38.54,0:32:41.92,Main,,0,0,0,,عزمتُ على تحقيق ما ينبغي تحقيقه على هذه الأرض
Dialogue: 0,0:32:42.33,0:32:46.80,Main,,0,0,0,,لذلك أسعى لتحقيق تلك الغاية، ولا أملك القدرة على فعل أيّ شيء آخر
Dialogue: 0,0:32:47.08,0:32:49.88,Main,,0,0,0,,لا يمكن للشياطين أن تتنصّل من حقيقتها كشياطين
Dialogue: 0,0:32:51.79,0:32:53.25,Main,,0,0,0,,لا يمكنكَ كبح جماح نفسك؟
Dialogue: 0,0:32:53.42,0:32:55.38,Main,,0,0,0,,لو كان بإمكاننا ذلك، لما لُقبنا بالشياطين
Dialogue: 0,0:32:56.17,0:32:57.21,Main,,0,0,0,,هكذا إذن
Dialogue: 0,0:32:57.75,0:32:59.21,Main,,0,0,0,,في هذه الحالة، لن أتوانى
Dialogue: 0,0:32:59.42,0:33:00.54,Main,,0,0,0,,لا حاجة لذلك
Dialogue: 0,0:33:01.29,0:33:03.13,Main,,0,0,0,,،بفضل قدرتي على الاستيعاب
Dialogue: 0,0:33:03.46,0:33:05.92,Main,,0,0,0,,،فإنّي أتغذى على الشياطين لاكتساب قواهم
Dialogue: 0,0:33:06.17,0:33:09.17,Main,,0,0,0,,!ممّا يضاعف قوتي لدرجة تغير بنيتي الجسدية
Dialogue: 0,0:34:06.21,0:34:08.91,Main,,0,0,0,,حققتُ غايتي الّتي وُجدتُ من أجلها
Dialogue: 0,0:34:09.75,0:34:13.67,Main,,0,0,0,,الشيطان الآخر الّذي كان معي لديه قوة الاستبصار
Dialogue: 0,0:34:14.13,0:34:17.08,Main,,0,0,0,,ما رآه ذلك الشيطان كان مستقبلًا بعيدًا
Dialogue: 0,0:34:17.21,0:34:19.58,Main,,0,0,0,,بعد 170 عامًا من الآن
Dialogue: 0,0:34:20.42,0:34:26.17,Main,,0,0,0,,مشهد ظهور ملك الشياطين هنا في كادونو
Dialogue: 0,0:34:27.08,0:34:31.75,Main,,0,0,0,,هكذا عرفنا أنَّ الّذي يُدعى بملك الشياطين يعيش في هذه الأرض
Dialogue: 0,0:34:31.92,0:34:34.83,Main,,0,0,0,,لهذا جئنا إلى هنا
Dialogue: 0,0:34:35.33,0:34:38.47,Main,,0,0,0,,شيطان يعيش في كادونو؟
Dialogue: 0,0:34:44.46,0:34:46.79,Main,,0,0,0,,...أيّها البشري، خذ هذا
Dialogue: 0,0:34:46.92,0:34:48.54,Main,,0,0,0,,كهدية وداع
Dialogue: 0,0:34:51.88,0:34:57.38,Main,,0,0,0,,قلتَ إنّك ستستل سيفكَ على كلِّ من يهدّد الّذين عليكَ حمايتهم
Dialogue: 0,0:34:57.63,0:34:59.38,Main,,0,0,0,,إذن، سأطرح عليكَ سؤالًا آخر
Dialogue: 0,0:34:59.83,0:35:04.79,Main,,0,0,0,,ماذا سيحدث حين يصبح الّذين أقسمتَ على حمايتهم غير جديرين بتلك الحماية؟
Dialogue: 0,0:35:04.88,0:35:07.75,Main,,0,0,0,,من ستقطعه بسيفك حينها إذن؟
Dialogue: 0,0:35:09.83,0:35:13.29,Main,,0,0,0,,أخبرني أيّها البشري، لِمَ تحمل ذلك السيف؟
Dialogue: 0,0:35:15.50,0:35:16.50,Main,,0,0,0,,كيوماسا
Dialogue: 0,0:35:17.54,0:35:19.21,Main,,0,0,0,,توقف، هذا ليس الوقت المناسب
Dialogue: 0,0:35:19.54,0:35:21.71,Main,,0,0,0,,!انتظر على الأقل حتّى نعلم إن كان جينتا بسلام
Dialogue: 0,0:35:22.04,0:35:23.92,Main,,0,0,0,,هذا هو الوقت المناسب
Dialogue: 0,0:35:24.00,0:35:25.79,Main,,0,0,0,,إن سارت الأمور على ما يرام، فسينتهي كلِّ شيء في ليلةٍ واحدة
Dialogue: 0,0:35:26.42,0:35:30.58,Main,,0,0,0,,أم تريدينني أن أنتظر حتّى يكون موجودًا ليسمع تأوهاتكِ؟
Dialogue: 0,0:35:32.17,0:35:33.63,Main,,0,0,0,,الأمر يعود إليكِ
Dialogue: 0,0:35:35.96,0:35:38.01,Main,,0,0,0,,أنا؟
Dialogue: 0,0:35:39.00,0:35:40.38,Main,,0,0,0,,!سأصبح أقوى
Dialogue: 0,0:35:40.67,0:35:44.75,Main,,0,0,0,,سأسير على خطى موتوهارو-سان وأتدرب بجدٍ حتّى أقدر على دحر أيّ شيطان
Dialogue: 0,0:35:57.13,0:36:00.66,Main,,0,0,0,,اخترتُ هذا الدرب من أجل كادونو
Dialogue: 0,0:36:09.21,0:36:11.75,Main,,0,0,0,,لأني إيتسوكيهيمي
Dialogue: 0,0:36:12.38,0:36:14.21,Main,,0,0,0,,...لِمَ أنتما
Dialogue: 0,0:36:23.67,0:36:26.82,Main,,0,0,0,,أرأيتِ؟ كان الأمر صحيحًا
Dialogue: 0,0:36:35.96,0:36:37.75,Main,,0,0,0,,سوزو-تشان؟
Dialogue: 0,0:36:39.71,0:36:42.63,Main,,0,0,0,,أيّتها الأميرة، لماذا؟
Dialogue: 0,0:36:48.25,0:36:49.50,Main,,0,0,0,,!ما زالتُ على قيد الحياة
Dialogue: 0,0:37:02.61,0:37:03.58,Main,,0,0,0,,سوزوني
Dialogue: 0,0:37:13.50,0:37:17.08,Main,,0,0,0,,اعتقدتُ أنّكِ تحبين جينتا أيّتها الأميرة
Dialogue: 0,0:37:17.24,0:37:21.73,Main,,0,0,0,,لكن الظاهر أنّكِ مستعدةٌ للتعايش مع أيّ رجل كان
Dialogue: 0,0:37:21.74,0:37:22.50,Main,,0,0,0,,!أنتِ مخطئة
Dialogue: 0,0:37:22.50,0:37:23.64,Main,,0,0,0,,!إذن لماذا؟
Dialogue: 0,0:37:24.25,0:37:26.12,Main,,0,0,0,,لماذا أيّتها الأميرة؟
Dialogue: 0,0:37:26.90,0:37:29.44,Main,,0,0,0,,لأجل من كنتُ أعاني؟
Dialogue: 0,0:37:32.38,0:37:35.29,Main,,0,0,0,,،مهما كان الأمر مؤلمًا أو صعبًا
Dialogue: 0,0:37:35.92,0:37:40.46,Main,,0,0,0,,إن تزوجتِ أخي أيّتها الأميرة لكنتُ قد باركتُ لكما من كلِّ قلبي
Dialogue: 0,0:37:41.04,0:37:44.79,Main,,0,0,0,,لأنّي كنتُ على يقينٍ بأنّ ذلك سيشعره بالسعادة
Dialogue: 0,0:37:45.54,0:37:47.00,Main,,0,0,0,,مجرد التفكير في ذلك
Dialogue: 0,0:37:47.71,0:37:51.25,Main,,0,0,0,,هو ما جعلني أتحمل رؤية يده تلمس يد شخصٍ آخر
Dialogue: 0,0:37:51.75,0:37:54.92,Main,,0,0,0,,!ومع ذلك... لماذا؟
Dialogue: 0,0:37:56.93,0:37:59.66,Main,,0,0,0,,...سوزو-تشان، أنتِ
Dialogue: 0,0:38:00.33,0:38:01.63,Main,,0,0,0,,...من أجل جينتا
Dialogue: 0,0:38:02.33,0:38:03.79,Main,,0,0,0,,...لأنّكِ أحببتِه
Dialogue: 0,0:38:04.46,0:38:09.88,Main,,0,0,0,,لهذا لم تسمحي لجسدكِ وروحكِ بالنضوج لتبقي أخته الصغيرة طوال هذا الوقت؟
Dialogue: 0,0:38:10.46,0:38:14.14,Main,,0,0,0,,...اعتقدتُ أنّي ما زلتُ قادرةً على التحمل لأجلكِ
Dialogue: 0,0:38:14.33,0:38:15.33,Main,,0,0,0,,...ومع ذلك
Dialogue: 0,0:38:15.71,0:38:16.50,Main,,0,0,0,,أنا آسفة
Dialogue: 0,0:38:17.46,0:38:21.51,Main,,0,0,0,,ولكن، لا أستطيع أن أكون غير ما أنا عليه الآن
Dialogue: 0,0:38:22.38,0:38:25.08,Main,,0,0,0,,عليَّ أن أعيش بصفتي إيتسوكيهيمي لأجل كادونو
Dialogue: 0,0:38:25.50,0:38:29.43,Main,,0,0,0,,لأنّي أرى أنَّ هذه هي الطريقة الوحيدة المناسبة لردّ مشاعره
Dialogue: 0,0:38:31.37,0:38:33.40,Main,,0,0,0,,ما الّذي تتحدثين عنه؟
Dialogue: 0,0:38:37.46,0:38:41.33,Main,,0,0,0,,،بعد أن سلبتِ منّي كلّ ما كنتُ أصبو إليه
Dialogue: 0,0:38:41.71,0:38:44.96,Main,,0,0,0,,ستتخلين عنه لأجل شخص تافه؟
Dialogue: 0,0:38:45.79,0:38:48.38,Main,,0,0,0,,كيف لكِ أن تفعلي هذا؟
Dialogue: 0,0:38:57.91,0:39:01.95,Main,,0,0,0,,!إلى أيّ مدى تظنين أنّكِ قادرة على جعلي أبدو كالحمقاء؟
Dialogue: 0,0:39:01.95,0:39:02.79,Main,,0,0,0,,...أنا
Dialogue: 0,0:39:05.04,0:39:08.18,Main,,0,0,0,,أطبقِ فمكِ القذر ذاك الآن
Dialogue: 0,0:39:08.54,0:39:11.38,Main,,0,0,0,,أرأيتِ؟ كلّ ما قلته لكِ كان صحيحًا
Dialogue: 0,0:39:11.83,0:39:14.41,Main,,0,0,0,,هذه الأميرة امرأةٌ عديمة الأخلاق
Dialogue: 0,0:39:14.71,0:39:16.29,Main,,0,0,0,,لا يجوزُ العفو عنها
Dialogue: 0,0:39:16.58,0:39:21.98,Main,,0,0,0,,رغم خيانتِها لأخيكِ العزيز، إلّا أنّها ستظل محميةً ولن يتغير شيء
Dialogue: 0,0:39:22.00,0:39:25.53,Main,,0,0,0,,تضحك عليه بينما تراه يقاتل وهو يجهل الحقيقة
Dialogue: 0,0:39:22.46,0:39:25.39,Top,,0,0,0,,!سوزو-تشان، لا تستمعي لهذه الشيطانة
Dialogue: 0,0:39:25.58,0:39:31.23,Top,,0,0,0,,!سوزو-تشان، انظري إليّ، أرجوكِ يا سوزو-تشان، سوزو-تشان
Dialogue: 0,0:39:25.58,0:39:31.11,Main,,0,0,0,,أليس من المؤسف أن يُجرح أخوكِ بسبب هذه المرأة الوضيعة؟
Dialogue: 0,0:39:31.50,0:39:36.58,Main,,0,0,0,,إذن لنفكر معًا، ما الّذي يمكنكِ فعله من أجل أخيكِ؟
Dialogue: 0,0:39:31.50,0:39:35.23,Top,,0,0,0,,!تلك الشيطانة تكذب عليكِ، لا تصدقيها
Dialogue: 0,0:39:36.96,0:39:40.33,Main,,0,0,0,,مثل: يا ليت هذه المرأة تختفي من الوجود
Dialogue: 0,0:39:41.08,0:39:43.21,Main,,0,0,0,,!سوزو-تشان، لا
Dialogue: 0,0:40:03.67,0:40:04.92,Main,,0,0,0,,سوزو-تشان؟
Dialogue: 0,0:40:05.71,0:40:07.75,Main,,0,0,0,,أيّتها الأميرة
Dialogue: 0,0:40:07.93,0:40:09.38,Main,,0,0,0,,موتي؟
Dialogue: 0,0:40:12.66,0:40:14.64,Main,,0,0,0,,تمهل أيّها الوسيم
Dialogue: 0,0:40:14.79,0:40:17.39,Main,,0,0,0,,!هذه المعركة تقتصر على النساء فحسب
Dialogue: 0,0:40:21.38,0:40:24.12,Main,,0,0,0,,لا ينبغي أن تكون قادرًا على استخدام ذلك السيف الآن
Dialogue: 0,0:40:24.29,0:40:29.17,Main,,0,0,0,,أليس من البديهي أن تموتي بالسيف الّذي تُقدسينه أيّتها الأميرة؟
Dialogue: 0,0:40:30.17,0:40:32.65,Main,,0,0,0,,أما أنت، فما زال لديكَ دور هام لتلعبه
Dialogue: 0,0:40:35.96,0:40:37.36,Main,,0,0,0,,!استمتعا بوقتكما
Dialogue: 0,0:40:44.83,0:40:46.29,Main,,0,0,0,,سيكون هذا مثيرًا للاهتمام
Dialogue: 0,0:40:47.08,0:40:48.42,Main,,0,0,0,,...سوزو-تشان
Dialogue: 0,0:40:56.45,0:40:58.14,Main,,0,0,0,,!شيرايوكي، سوزوني
Dialogue: 0,0:41:19.08,0:41:20.91,Main,,0,0,0,,...شيرايو
Dialogue: 0,0:41:29.54,0:41:32.44,Main,,0,0,0,,أهلًا بعودتك، هل تأذيت؟
Dialogue: 0,0:41:40.67,0:41:42.68,Top,,0,0,0,,أرجو أن نكون على وفاق بدءًا من الآن
Dialogue: 0,0:41:40.67,0:41:42.64,Main,,0,0,0,,أريد أن أصبح إيتسوكيهيمي
Dialogue: 0,0:41:42.64,0:41:45.98,Main,,0,0,0,,سأسعى لأكون أختًا كبيرةً صالحةً وأُدخل السرور إلى قلبك
Dialogue: 0,0:41:43.38,0:41:44.40,Top,,0,0,0,,!تملصت
Dialogue: 0,0:41:44.40,0:41:46.14,Top,,0,0,0,,!لأنّنا سنصبح عائلةً واحدة من الآن فصاعدًا
Dialogue: 0,0:41:46.00,0:41:48.29,Main,,0,0,0,,أنا أحبك يا جينتا
Dialogue: 0,0:42:11.00,0:42:13.63,Main,,0,0,0,, كان ذلك وشيكًا، ما الّذي دهاك فجأة؟
Dialogue: 0,0:42:20.13,0:42:22.08,Main,,0,0,0,,أخي، هل أنتَ بخير؟
Dialogue: 0,0:42:22.17,0:42:23.42,Main,,0,0,0,,هل حدث شيء ما؟
Dialogue: 0,0:42:25.50,0:42:26.83,Main,,0,0,0,,أهذه أنتِ يا سوزوني؟
Dialogue: 0,0:42:27.00,0:42:27.91,Main,,0,0,0,,أجل
Dialogue: 0,0:42:28.50,0:42:29.54,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:42:29.75,0:42:31.25,Main,,0,0,0,,!كما أخبرتك
Dialogue: 0,0:42:32.00,0:42:32.95,Main,,0,0,0,,إذن، لماذا؟
Dialogue: 0,0:42:33.29,0:42:35.63,Main,,0,0,0,,ما الّذي فعلتِه لشيرايوكي؟
Dialogue: 0,0:42:36.21,0:42:38.39,Main,,0,0,0,,لِمَ هذا العبوس؟
Dialogue: 0,0:42:38.58,0:42:40.63,Main,,0,0,0,,قتلتْ سوزو الأميرة لأجلك
Dialogue: 0,0:42:40.88,0:42:42.33,Main,,0,0,0,,!عليك أن تكون مبتهجًا
Dialogue: 0,0:42:42.50,0:42:44.46,Main,,0,0,0,,ما الّذي تقولينه؟
Dialogue: 0,0:42:45.00,0:42:49.23,Main,,0,0,0,,سمعتُ أنَّ الأميرة ستتزوج من رجل آخر
Dialogue: 0,0:42:49.29,0:42:53.67,Main,,0,0,0,,تظاهرتْ بأنّها تحبك ثمَّ غدرتْ بك، إنّها امرأة وضيعة
Dialogue: 0,0:42:54.04,0:42:57.42,Main,,0,0,0,,لهذا لا داعي لتقلق بشأنها
Dialogue: 0,0:42:58.79,0:43:00.89,Main,,0,0,0,,...أرجوكِ، توقفي
Dialogue: 0,0:43:01.92,0:43:05.69,Main,,0,0,0,,هل ما زلتَ تحبّ الأميرة بعد كلّ ما حدث؟
Dialogue: 0,0:43:06.00,0:43:09.83,Main,,0,0,0,,هل تحزن على موتها حتّى بعد أن طعنتكَ في ظهرك؟
Dialogue: 0,0:43:10.83,0:43:12.48,Main,,0,0,0,,...ولكن
Dialogue: 0,0:43:12.49,0:43:18.51,Main,,0,0,0,,بما أنّها ماتت الآن، لن تشهد زواج الأميرة من شخص آخر غيرك
Dialogue: 0,0:43:18.58,0:43:19.79,Main,,0,0,0,,أليس هذا رائعًا؟
Dialogue: 0,0:43:21.67,0:43:23.27,Main,,0,0,0,,هل يمكننا العودة إلى بيتنا الآن؟
Dialogue: 0,0:43:23.29,0:43:24.58,Main,,0,0,0,,!فأنا مرهقة
Dialogue: 0,0:43:24.63,0:43:26.13,Main,,0,0,0,,مُرهقة؟
Dialogue: 0,0:43:26.21,0:43:29.62,Main,,0,0,0,,أجل، فقد أزحتُ عنّا الكثير من العوائق
Dialogue: 0,0:43:29.63,0:43:33.49,Main,,0,0,0,,،دستِ على أهل كادونو الّذين قاموا بتربيتِنا كأبنائهم
Dialogue: 0,0:43:33.54,0:43:35.00,Main,,0,0,0,,ثمَّ قتلتِ شيرايوكي
Dialogue: 0,0:43:35.63,0:43:39.50,Main,,0,0,0,,!وبعد أن دمرتِ كلّ شيء، تقولين هذا الكلام؟
Dialogue: 0,0:43:40.00,0:43:41.67,Main,,0,0,0,,ما الّذي تقصده؟
Dialogue: 0,0:43:42.59,0:43:44.46,Main,,0,0,0,,فهمت
Dialogue: 0,0:43:46.17,0:43:51.45,Main,,0,0,0,,سوزوني الّتي أعرفها لم تعد موجودة بعد
Dialogue: 0,0:43:59.58,0:44:00.75,Main,,0,0,0,,أخي؟
Dialogue: 0,0:44:02.75,0:44:04.30,Main,,0,0,0,,يا لي من سخيف
Dialogue: 0,0:44:05.71,0:44:08.75,Main,,0,0,0,,لم يتبقَ لي أيّ شيءٍ على الإطلاق
Dialogue: 0,0:44:17.09,0:44:18.53,Main,,0,0,0,,هذا غير صحيح
Dialogue: 0,0:44:18.90,0:44:21.80,Main,,0,0,0,,بقي شيء واحد
Dialogue: 0,0:44:22.25,0:44:25.25,Main,,0,0,0,,لِمَ ترمقني بتلك النظرة؟
Dialogue: 0,0:44:24.13,0:44:27.79,Top,,0,0,0,,!أشعر بكرهٍ شديد تُجاه كلّ شيء وما بيدي حيلة
Dialogue: 0,0:44:25.58,0:44:27.79,Main,,0,0,0,,!فعلتُ هذا لأسعدكَ فحسب
Dialogue: 0,0:44:27.79,0:44:29.80,Main,,0,0,0,,!لهذا قتلتُ تلك الوضيعة
Dialogue: 0,0:44:29.33,0:44:30.75,Top,,0,0,0,,!هذا يكفي، أطبقِ فمكِ
Dialogue: 0,0:44:40.75,0:44:41.93,Main,,0,0,0,,فهمت
Dialogue: 0,0:44:43.00,0:44:46.15,Main,,0,0,0,,!ستتخلى عنّي مثلما فعل الجميع في النهاية إذن
Dialogue: 0,0:44:47.63,0:44:50.47,Main,,0,0,0,,خلتُ أنّك لستَ مثلهم
Dialogue: 0,0:44:50.54,0:44:54.03,Main,,0,0,0,,خلتُ أنّك ستقف بجانبي دائمًا
Dialogue: 0,0:44:55.33,0:44:56.47,Main,,0,0,0,,إذن لا بأس
Dialogue: 0,0:44:56.67,0:44:59.08,Main,,0,0,0,,لا أريد شيئًا، لن أصدق شيئًا بعد الآن
Dialogue: 0,0:44:59.54,0:45:04.67,Main,,0,0,0,,!إن كنتَ سترفضني أنا سوزو، فلن يكون لأيّ شيءٍ قيمة
Dialogue: 0,0:45:05.54,0:45:06.67,Main,,0,0,0,,سحقًا لكلّ شيء
Dialogue: 0,0:45:07.02,0:45:08.52,Main,,0,0,0,,وأنتَ كذلك
Dialogue: 0,0:45:12.14,0:45:13.80,Main,,0,0,0,,لِمَ لا تستسلم فحسب؟
Dialogue: 0,0:45:13.80,0:45:16.62,Main,,0,0,0,,!لا جدوى من إهدار حياتك، لديكَ فرصةٌ الآن
Dialogue: 0,0:45:16.62,0:45:17.93,Main,,0,0,0,,!أخبرتكِ أن تُطبقي فمكِ
Dialogue: 0,0:45:25.67,0:45:26.63,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:45:26.96,0:45:28.43,Main,,0,0,0,,!فلتمتْ إذن
Dialogue: 0,0:45:46.00,0:45:47.92,Main,,0,0,0,,إذن، لِمَ لا تجرب؟
Dialogue: 0,0:45:47.92,0:45:49.63,Main,,0,0,0,,يمكنك أن تضربني ضربةً خفيفة
Dialogue: 0,0:46:03.71,0:46:04.96,Main,,0,0,0,,ما زلتِ قادرةً على الوقوف؟
Dialogue: 0,0:46:07.29,0:46:08.74,Main,,0,0,0,,في هذه الحالة
Dialogue: 0,0:46:20.71,0:46:21.88,Main,,0,0,0,,!أنتِ
Dialogue: 0,0:46:24.21,0:46:25.50,Main,,0,0,0,,اهربي
Dialogue: 0,0:46:42.38,0:46:43.88,Main,,0,0,0,,!انتظري، سوزوني
Dialogue: 0,0:46:45.13,0:46:47.71,Main,,0,0,0,,أشعر بكراهية تُجاه كلّ شيء الآن
Dialogue: 0,0:46:48.17,0:46:50.17,Main,,0,0,0,,لذلك سأدمر كلّ شيء
Dialogue: 0,0:46:50.67,0:46:56.63,Main,,0,0,0,,البشر، الأمم، وكلّ شيءٍ في هذا الوجود، سأدمره كله
Dialogue: 0,0:46:57.33,0:46:58.75,Main,,0,0,0,,لا تنسَ هذا
Dialogue: 0,0:46:59.29,0:47:05.32,Main,,0,0,0,, مهما طال الزمن، سآتي لرؤيتكَ مرّة أخرى
Dialogue: 0,0:47:11.29,0:47:13.57,Main,,0,0,0,,فعلتُها، لقد فعلتُها
Dialogue: 0,0:47:14.08,0:47:17.06,Main,,0,0,0,,حققتُ الغاية من وجودي
Dialogue: 0,0:47:19.71,0:47:22.75,Main,,0,0,0,,أهذا ما تعتبرونه غايتكم؟
Dialogue: 0,0:47:22.88,0:47:24.13,Main,,0,0,0,,هذا الجنون؟
Dialogue: 0,0:47:25.63,0:47:26.79,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:47:27.63,0:47:29.55,Main,,0,0,0,,لقد رأيته
Dialogue: 0,0:47:29.88,0:47:34.09,Main,,0,0,0,,المستقبل الّذي عجزنا فيه نحن الشياطين عن مواكبته
Dialogue: 0,0:47:34.33,0:47:38.01,Main,,0,0,0,,النور الّذي سيضيء الظلام وسيسلبنا بيوتنا
Dialogue: 0,0:47:38.63,0:47:43.74,Main,,0,0,0,,وفي النهاية، سيصبح الشياطين مجرد خرافاتٍ من العصور القديمة
Dialogue: 0,0:47:44.29,0:47:45.66,Main,,0,0,0,,...لكن الآن
Dialogue: 0,0:47:46.33,0:47:48.09,Main,,0,0,0,,أنا راضية
Dialogue: 0,0:47:48.50,0:47:50.99,Main,,0,0,0,,فقد حميتُ مستقبل أبناء جنسي
Dialogue: 0,0:48:17.96,0:48:21.39,Main,,0,0,0,,ما هذا الحارس؟ ما الاختلاف؟
Dialogue: 0,0:48:21.46,0:48:25.54,Main,,0,0,0,,أنا... لم أقدر على فعل شيءٍ
Dialogue: 0,0:48:25.75,0:48:27.85,Main,,0,0,0,,لم أستطع حماية أيّ شيء
Dialogue: 0,0:48:29.08,0:48:33.56,Main,,0,0,0,,شيرايوكي... أحببتكِ كثيرًا
Dialogue: 0,0:49:30.15,0:49:31.62,Main,,0,0,0,,سأغادر كادونو
Dialogue: 0,0:49:32.76,0:49:34.95,Main,,0,0,0,,،عليَّ أن أصقل نفسي من جديد
Dialogue: 0,0:49:35.71,0:49:38.93,Main,,0,0,0,,وأستعد لقتال ملك الشياطين الّذي سينزل على هذه الأرض
Dialogue: 0,0:49:39.75,0:49:40.97,Main,,0,0,0,,هل أنتَ متأكد؟
Dialogue: 0,0:49:41.17,0:49:44.50,Main,,0,0,0,,...إن كانت هذه القصة حقيقية، فملك الشياطين هو
Dialogue: 0,0:49:44.51,0:49:47.10,Main,,0,0,0,,عليَّ أن أضع حدًّا لهذا الأمر
Dialogue: 0,0:49:47.21,0:49:50.33,Main,,0,0,0,,هل ستستسلم للكراهية وتقتل أختك؟
Dialogue: 0,0:49:50.63,0:49:53.95,Main,,0,0,0,,جينتا، هل هذا ما تريده حقًّا؟
Dialogue: 0,0:49:54.00,0:49:56.33,Main,,0,0,0,,سوزوني هي فرد من عائلتي العزيزة
Dialogue: 0,0:49:56.50,0:49:58.05,Main,,0,0,0,,...لكن شيرايوكي
Dialogue: 0,0:49:58.42,0:50:00.82,Main,,0,0,0,,ما زلتُ أحمل في قلبي ضغينةً على مقتلها
Dialogue: 0,0:50:01.25,0:50:03.98,Main,,0,0,0,,ما يزال الكره يطاردني حتّى الآن
Dialogue: 0,0:50:04.54,0:50:06.12,Main,,0,0,0,,يلحّ عليّ أن أقتلها
Dialogue: 0,0:50:07.58,0:50:12.52,Main,,0,0,0,,مع ذلك... إن كان هذا ممكنًا، أودّ أن أجد حلًّا سلميًّا
Dialogue: 0,0:50:13.17,0:50:18.30,Main,,0,0,0,,الآن بعد أن تحولتَ إلى شيطان، ظننتُ أنّك لن ترغب إلّا بسفك الدماء
Dialogue: 0,0:50:18.75,0:50:22.81,Main,,0,0,0,,لكن يبدو أنّه ما زال فيكَ بعضٌ من بقايًا إنسانيتك
Dialogue: 0,0:50:23.42,0:50:24.67,Main,,0,0,0,,خذ هذا معك
Dialogue: 0,0:50:30.88,0:50:31.85,Main,,0,0,0,,اسلّه من غمده
Dialogue: 0,0:50:40.04,0:50:43.39,Main,,0,0,0,,أصبحت الآن مالكًا لـ ياراي
Dialogue: 0,0:50:43.88,0:50:47.35,Main,,0,0,0,,لذا عليكَ اتباع التقاليد ووراثة الليل
Dialogue: 0,0:50:47.50,0:50:50.08,Main,,0,0,0,,"ومن الآن فصاعدًا، لك أن تحمل اسم "جينيا
Dialogue: 0,0:50:50.25,0:50:52.90,Main,,0,0,0,,ولكن، لا يجوز لي أن أحمله
Dialogue: 0,0:50:53.08,0:50:55.66,Main,,0,0,0,,،الآن بعد أن انتهى نسل عائلة إيتسوكيهيمي
Dialogue: 0,0:50:55.72,0:51:00.83,Main,,0,0,0,,من الأفضل أن تستخدمه بدلًا من أن يُترك في المعبد ويغطيه الغبار
Dialogue: 0,0:51:01.46,0:51:05.89,Main,,0,0,0,,فضلًا عن ذلك، واثقٌ بأن الأميرة ستكون سعيدةً بهذا
Dialogue: 0,0:51:10.21,0:51:11.44,Main,,0,0,0,,سامحني
Dialogue: 0,0:51:12.21,0:51:16.98,Main,,0,0,0,,كنتُ أعلم أنّك والأميرة تكنّان مشاعرَ لبعضكما
Dialogue: 0,0:51:17.08,0:51:21.83,Main,,0,0,0,,لكن في الوقت نفسه، كنتُ أعلم أنَّ كيوماسا لديه مشاعرٌ تجاهها
Dialogue: 0,0:51:22.21,0:51:24.87,Main,,0,0,0,,،في الوقت الّذي كنتُ أزعم فيه أنَّ ذلك من أجل مستقبل كادونو
Dialogue: 0,0:51:24.88,0:51:29.94,Main,,0,0,0,,كنتُ أصرّ على زواج كيوماسا والأميرة بسبب عاطفة الأبوة في الواقع
Dialogue: 0,0:51:30.64,0:51:33.79,Main,,0,0,0,,هذه المأساة تقع على عاتقي
Dialogue: 0,0:51:41.33,0:51:46.44,Main,,0,0,0,,،إن كنتَ تنوي العودة إلى كادونو بعد سنوات طويلة
Dialogue: 0,0:51:46.54,0:51:49.97,Main,,0,0,0,,فسأبني لك ضريحًا كهديةٍ على الأقل لك
Dialogue: 0,0:51:50.25,0:51:53.31,Main,,0,0,0,,وسيكون اسمه... ضريح جينتا
Dialogue: 0,0:51:54.13,0:51:58.45,Main,,0,0,0,,،مع أنَّ البشر ومناظر الطبيعة لا يدومان طويلًا مثل الشياطين
Dialogue: 0,0:51:58.79,0:52:02.56,Main,,0,0,0,,إلّا أنَّ هناك أشياء يمكن أن تدوم حتّى لو كانت الحياة زائلة
Dialogue: 0,0:52:04.17,0:52:05.58,Main,,0,0,0,,!جينتا-ني
Dialogue: 0,0:52:06.88,0:52:08.53,Main,,0,0,0,,هل سترحل حقًّا؟
Dialogue: 0,0:52:09.67,0:52:13.41,Main,,0,0,0,,!في نظري، ستبقى أنتَ الأخ الّذي أعرفه دائمًا
Dialogue: 0,0:52:18.42,0:52:22.05,Main,,0,0,0,,سأعود مجدّدًا، اتركي لي بعضًا من موتشي إيزوبي حينما أعود
Dialogue: 0,0:52:22.79,0:52:24.26,Main,,0,0,0,,هذا وعدٌ قاطع
Dialogue: 0,0:52:24.42,0:52:26.41,Main,,0,0,0,,لا يمكنك التراجع عنه
Dialogue: 0,0:52:42.58,0:52:44.19,Main,,0,0,0,,...فهمت الآن
Dialogue: 0,0:52:44.67,0:52:49.79,Main,,0,0,0,,لِمَ قالت تلك الشيطانة أنّها تشعر بالرضا بعد تحقيقها الغايةَ من وجودها يا ترى؟
Dialogue: 0,0:52:51.80,0:52:54.80,Main,,0,0,0,,بعد 170 عامًا إذن
Dialogue: 0,0:52:59.79,0:53:04.58,Main,,0,0,0,,لطالما ظننتُ أنَّ أحداث الماضي الغابر لا علاقة لها بي
Dialogue: 0,0:53:05.46,0:53:08.47,Main,,0,0,0,,...ولكن، اتضح لي أنَّ سبب دموعه
Dialogue: 0,0:53:08.47,0:53:09.42,Main,,0,0,0,,أستميحكِ عذرًا
Dialogue: 0,0:53:09.88,0:53:13.01,Main,,0,0,0,,كان مرتبطًا بسبب وجودي هنا الآن
Dialogue: 0,0:53:13.08,0:53:15.07,Main,,0,0,0,,هل أنتِ كاهنة هذا الضريح؟
Dialogue: 0,0:53:15.38,0:53:17.25,Main,,0,0,0,,...لهذا السبب سأعرف
Dialogue: 0,0:53:17.83,0:53:21.81,Main,,0,0,0,,...ما مرَّ به في دربه الطويل الّذي قطعه
Dialogue: 0,0:53:22.01,0:53:23.96,Main,,0,0,0,,على مدى 170 عامًا
Dialogue: 0,0:06:09.13,0:06:10.54,توضيح,,0,0,0,,ني: تعني "الأخ الأكبر" وتستخدم لإظهار الود أو الاحترام تجاه شخص أكبر سنًا أو أقرب للمرء سواء كان أخ حقيقي أو شخص يُعتبر كأخ
Dialogue: 0,0:06:47.29,0:06:51.71,توضيح,,0,0,0,,إيتسوكيهيمي = كاهنة النار
Dialogue: 0,0:15:53.54,0:15:55.04,توضيح,,0,0,0,,إيتسوكيهيمي = كاهنة النار
Dialogue: 0,0:21:45.38,0:21:47.71,توضيح,,0,0,0,,إيسوبي موتشي هو كعك أرز ياباني مشوي مغطى بصلصة الصويا الحلوة والمالحة وملفوف بأعشاب النوري البحرية
Dialogue: 0,0:21:51.92,0:21:53.37,توضيح,,0,0,0,,ني: تعني "الأخ الأكبر" وتستخدم لإظهار الود أو الاحترام تجاه شخص أكبر سنًا أو أقرب للمرء سواء كان أخ حقيقي أو شخص يُعتبر كأخ
Dialogue: 0,0:23:54.96,0:23:58.63,توضيح,,0,0,0,,تقصد الكاهنة السابقة
