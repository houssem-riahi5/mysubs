Dialogue: 0,0:00:10.17,0:00:13.39,Main,,0,0,0,,خُذ لكَ رشفةً لتروي ظمأك أوّلًا
Dialogue: 0,0:00:14.61,0:00:15.72,Main,,0,0,0,,لن أتردد إذن
Dialogue: 0,0:00:31.17,0:00:33.69,Main,,0,0,0,,حسنٌ، سأدخل في صلب الموضوع
Dialogue: 0,0:00:33.72,0:00:36.28,Main,,0,0,0,,أريد أن أطلب منك خدمةً
Dialogue: 0,0:00:36.61,0:00:43.30,Main,,0,0,0,,جاءني صاحب متجر لوحاتٍ فنيّة من قرية تينما ليخبرني أنّه اقتنى شيئًا غريبًا
Dialogue: 0,0:00:45.01,0:00:47.66,Main,,0,0,0,,يزعم أنّها لوحةٌ لشيطان
Dialogue: 0,0:00:48.17,0:00:52.97,Main,,0,0,0,,وتُعرف بلوحات "كودانزاكا الفنيّة" على ما يبدو
Dialogue: 0,0:00:53.38,0:00:56.96,Main,,0,0,0,,إن كانت لوحةً لشيطانٍ فلا بدَّ من وجود شائعاتٍ غريبةٍ تدور حولها
Dialogue: 0,0:00:57.27,0:01:00.01,Main,,0,0,0,,قد لا تكون "الشائعات" هي الوصف الدقيق
Dialogue: 0,0:01:00.25,0:01:05.17,Main,,0,0,0,,يبدو أنَّ الفنان الّذي رسم هذه اللوحة ألمّتْ به وعكةٌ صحيّةٌ وهو الآن طريحُ الفراش
Dialogue: 0,0:01:05.88,0:01:10.16,Main,,0,0,0,,قِيل إنَّ هذا عقابٌ لاستغلاله لوحة شيطانٍ لأغراضٍ ربحية
Dialogue: 0,0:01:10.99,0:01:12.27,Main,,0,0,0,,ما رأيك؟
Dialogue: 0,0:01:13.92,0:01:16.94,Main,,0,0,0,,تبدو لي لوحةً فنيّةً عاديّةً من النّظرة الأولى
Dialogue: 0,0:01:17.00,0:01:22.50,Main,,0,0,0,,لكن، تُظهر الكيانات الغامضة حقيقتها حين يتوفر المحفز المناسب
Dialogue: 0,0:01:22.63,0:01:24.72,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:01:24.95,0:01:27.03,Main,,0,0,0,,إن لم يكن كيانًا يُسبب الأذى فهذا جيد
Dialogue: 0,0:01:27.05,0:01:32.02,Main,,0,0,0,,وإن تبين أنّه قد يجلب المصائب فأريدكَ أن تتولى أمره
Dialogue: 0,0:01:32.83,0:01:34.37,Main,,0,0,0,,سمعًا وطاعة
Dialogue: 0,0:01:34.63,0:01:38.26,Main,,0,0,0,,وبالطبع، لن أطلب منك العمل بلا مقابل
Dialogue: 0,0:01:38.33,0:01:40.53,Main,,0,0,0,,سأدفع لك ما يوازي جهدك
Dialogue: 0,0:01:41.01,0:01:42.32,Main,,0,0,0,,ممتنٌ لك
Dialogue: 0,0:01:43.98,0:01:48.37,Main,,0,0,0,,سأدعوك لتناول كأس شرابٍ بمجرد انتهاء هذه الواقعة
Dialogue: 0,0:03:25.71,0:03:28.54,Main,,0,0,0,,جينيا-كن، أهلًا بك
Dialogue: 0,0:03:28.58,0:03:29.70,Main,,0,0,0,,تفضّل
Dialogue: 0,0:03:31.00,0:03:32.86,Main,,0,0,0,,لا بدَّ أنَّ الجو كان باردًا في الخارج
Dialogue: 0,0:03:34.60,0:03:36.05,Main,,0,0,0,,هل تريد طبق كاكي-سوبا؟
Dialogue: 0,0:03:36.06,0:03:36.80,Main,,0,0,0,,أجل
Dialogue: 0,0:03:37.92,0:03:39.39,Main,,0,0,0,,هل جينيا هنا؟
Dialogue: 0,0:03:39.96,0:03:41.31,Main,,0,0,0,,أنتَ هنا إذن
Dialogue: 0,0:03:41.71,0:03:45.76,Main,,0,0,0,,عذرًا، أحتاج مساعدتك في أمرٍ يتعلق بلوحات كودانزاكا الفنيّة
Dialogue: 0,0:03:46.10,0:03:48.06,Main,,0,0,0,,لوحات كودانزاكا الفنيّة؟
Dialogue: 0,0:03:48.17,0:03:51.31,Main,,0,0,0,,هذا صحيح، كلّها لوحاتٌ لشيطان
Dialogue: 0,0:03:51.45,0:03:55.18,Main,,0,0,0,,وقِيل إنَّ مالكها قد طرأتْ عليه تغيّرات أو أصابته لعنةٌ ما
Dialogue: 0,0:03:55.66,0:03:57.55,Main,,0,0,0,,يبدو أنّها ممزقة
Dialogue: 0,0:03:57.62,0:04:00.18,Main,,0,0,0,,أجل، أسقطتها عن غير قصد
Dialogue: 0,0:04:00.18,0:04:02.74,Main,,0,0,0,,لوحةٌ ملعونةٌ سقطتْ منك وتمزقتْ؟
Dialogue: 0,0:04:02.76,0:04:05.49,Main,,0,0,0,,لا تجلبْ مثل هذه الأشياء إلى محلّي رجاءً
Dialogue: 0,0:04:05.49,0:04:07.34,Main,,0,0,0,,آ-آسف
Dialogue: 0,0:04:08.86,0:04:10.23,Main,,0,0,0,,أريدك أن ترى هذا
Dialogue: 0,0:04:11.35,0:04:12.71,Main,,0,0,0,,...هذه
Dialogue: 0,0:04:12.79,0:04:15.56,Main,,0,0,0,,قِيل إن صاحب متجر لوحاتٍ فنيّةٍ من قرية تينما قد اقتنى هذه اللوحة
Dialogue: 0,0:04:15.59,0:04:18.43,Main,,0,0,0,,"وعلى ما يبدو أنّها لوحات "كودانزاكا الفنيّة
Dialogue: 0,0:04:18.53,0:04:21.09,Main,,0,0,0,,وقِيل أيضًا أنّها لوحةٌ لشيطان
Dialogue: 0,0:04:21.17,0:04:23.83,Main,,0,0,0,,تبدو مطابقةً تمامًا للّتي أحضرتها
Dialogue: 0,0:04:24.63,0:04:29.16,Main,,0,0,0,,...كيف أقولها... وجود عدّة لوحاتٍ ملعونةٍ تدور حولها الشائعات
Dialogue: 0,0:04:29.21,0:04:31.22,Main,,0,0,0,,يجعل القصّة مريبةً بعض الشيء
Dialogue: 0,0:04:31.29,0:04:32.33,Main,,0,0,0,,أتفق معك
Dialogue: 0,0:04:33.09,0:04:35.74,Main,,0,0,0,,تبدو لي لوحةً فنيّةً جميلةً من النظرة الأولى
Dialogue: 0,0:04:35.91,0:04:38.87,Main,,0,0,0,,هل لاحظتَ أيّ شيءٍ غريبٍ فيها يا زينجي-سان؟
Dialogue: 0,0:04:38.92,0:04:40.41,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:04:40.44,0:04:44.44,Main,,0,0,0,,ما زالت الألوان زاهيةً قليلًا، ولا تبدو على الورق أيّ علاماتِ تلفٍ
Dialogue: 0,0:04:44.46,0:04:47.46,Main,,0,0,0,,أعتقد أنّه لم يمضِ أكثر من عامٍ على طباعتها
Dialogue: 0,0:04:47.50,0:04:51.08,Main,,0,0,0,,وأيضًا، أعرف ذلك المتجر المتخصص باللوحات الفنيّة في تينما
Dialogue: 0,0:04:51.38,0:04:54.67,Main,,0,0,0,,إن طلبتُ منهم خدمةً، فلن يكون من الصعب تحديد هويّة الرسام
Dialogue: 0,0:04:54.92,0:04:56.17,Main,,0,0,0,,سيكون ذلك خير عون
Dialogue: 0,0:04:56.46,0:05:00.04,Main,,0,0,0,,ليس بالأمر الجلل، فأنا مدينٌ لك على مساعدتك للآنسة ناتسو
Dialogue: 0,0:05:00.17,0:05:02.83,Main,,0,0,0,,هذه هي طريقتي لردّ الجميل
Dialogue: 0,0:05:06.29,0:05:08.80,Main,,0,0,0,,انتظرني هنا، سأذهب لأسأل
Dialogue: 0,0:05:12.00,0:05:13.67,Main,,0,0,0,,هذا أنتَ إذن يا زينجي-سان
Dialogue: 0,0:05:14.21,0:05:15.63,Main,,0,0,0,,أتيتَ في الوقت المناسب
Dialogue: 0,0:05:15.67,0:05:17.08,Main,,0,0,0,,وصلتني للتو بعض اللوحات الفنية الجميلة
Dialogue: 0,0:05:17.08,0:05:19.68,Main,,0,0,0,,عذرًا، لنؤجل هذا إلى وقتٍ لاحق
Dialogue: 0,0:05:20.21,0:05:23.88,Main,,0,0,0,,هل لديك أيٌّ من لوحات كودانزاكا الفنيّة يا سيّدي؟
Dialogue: 0,0:05:24.21,0:05:27.61,Main,,0,0,0,,إن كنتَ تقصد تلك فهي ليستْ متاحةً للعرض حاليًّا
Dialogue: 0,0:05:27.88,0:05:32.29,Main,,0,0,0,,توقفتُ عن عرضها في واجهة المحلّ بعد أن سمعتُ أنّها لوحةٌ لشيطان
Dialogue: 0,0:05:32.83,0:05:35.29,Main,,0,0,0,,أليست تلك مجرد إشاعةٍ ابتدَعها الرسام؟
Dialogue: 0,0:05:35.46,0:05:36.74,Main,,0,0,0,,كلّا
Dialogue: 0,0:05:36.92,0:05:40.12,Main,,0,0,0,,في الواقع، أعلم أنَّ الرسام طريحُ الفراش جراء وعكةٍ صحيّةٍ ألمتْ به
Dialogue: 0,0:05:40.88,0:05:45.50,Main,,0,0,0,,كما أنَّ هناك أقاويلَ عن مقتل أحد المشترين للوحة
Dialogue: 0,0:05:46.00,0:05:49.05,Main,,0,0,0,,لا أريد أن تنتشر أيّ أقاويل سيّئة عن متجري
Dialogue: 0,0:05:50.07,0:05:51.83,Main,,0,0,0,,هذا يثير بعض التساؤلات
Dialogue: 0,0:05:52.08,0:05:55.84,Main,,0,0,0,,بالمناسبة، هل يعيش هذا الرسام بالقرب من هنا؟
Dialogue: 0,0:05:59.00,0:06:00.61,Main,,0,0,0,,عذرًا عن التأخير
Dialogue: 0,0:06:00.92,0:06:02.24,Main,,0,0,0,,ما الّذي تحمله في يدك؟
Dialogue: 0,0:06:02.42,0:06:04.17,Main,,0,0,0,,لـ-لا شيء يستحق الذكر
Dialogue: 0,0:06:04.79,0:06:06.94,Main,,0,0,0,,الأهم من ذلك، حصلتُ على بعض المعلومات
Dialogue: 0,0:06:07.08,0:06:09.58,Main,,0,0,0,,عرفتُ أنَّ الرسام يعيش في ساكايتشو
Dialogue: 0,0:06:09.96,0:06:12.83,Main,,0,0,0,,شكرًا على مساعدتك، سأتكفل بالباقي
Dialogue: 0,0:06:13.58,0:06:15.14,Main,,0,0,0,,!توخَّ الحذر
Dialogue: 0,0:06:15.25,0:06:16.29,Main,,0,0,0,,سأفعل
Dialogue: 0,0:06:22.67,0:06:25.71,Main,,0,0,0,,عفوًا، هل ساغادوشو-دونو موجود هنا؟
Dialogue: 0,0:06:26.29,0:06:29.23,Main,,0,0,0,,أجل، تفضّل بالدخول
Dialogue: 0,0:06:32.83,0:06:35.42,Main,,0,0,0,,مرّ وقتٌ طويل مُنذ أن زارني أحد
Dialogue: 0,0:06:36.29,0:06:37.93,Main,,0,0,0,,من حضرتُك؟
Dialogue: 0,0:06:37.96,0:06:40.61,Main,,0,0,0,,معذرةً، أدعى جينيا
Dialogue: 0,0:06:40.63,0:06:44.03,Main,,0,0,0,,تجشمتُ عناء زيارتك بنفسي لأستفسر عن بعض الأمور
Dialogue: 0,0:06:44.21,0:06:48.59,Main,,0,0,0,,دعك من الرسميات فأنا لستُ بشخصٍ بتلك الأهمية
Dialogue: 0,0:06:48.71,0:06:50.57,Main,,0,0,0,,على أيّ حال، تفضّل بالجلوس
Dialogue: 0,0:07:02.79,0:07:06.20,Main,,0,0,0,,قِيل لي إنّك طريح الفراش جراءَ وعكةٍ صحيّةٍ يا ساجا-دونو
Dialogue: 0,0:07:06.27,0:07:09.01,Main,,0,0,0,,ليست بوعكةٍ صحيّةٍ بالمعنى الحرفي
Dialogue: 0,0:07:09.03,0:07:12.16,Main,,0,0,0,,إنّما يُصاب المرء بالوهن مع الكِبر لا غير
Dialogue: 0,0:07:12.33,0:07:16.21,Main,,0,0,0,,لم يعد جسدي يُطاوعني لأرسم كما كنتُ أفعل في الماضي
Dialogue: 0,0:07:17.33,0:07:19.48,Main,,0,0,0,,إذن هذا ليس بسبب لعنة لوحة الشيطان؟
Dialogue: 0,0:07:19.58,0:07:22.82,Main,,0,0,0,,عجبًا، من قال لك هذا يا صاحب الوجه العابس؟
Dialogue: 0,0:07:22.84,0:07:24.67,Main,,0,0,0,,هل أنتَ مبعوثٌ من ضريح سينغيندو؟
Dialogue: 0,0:07:25.08,0:07:26.72,Main,,0,0,0,,ليس كذلك
Dialogue: 0,0:07:26.88,0:07:29.63,Main,,0,0,0,,لكنّي سمعتُ أنّك من رسم هذه اللوحة
Dialogue: 0,0:07:30.33,0:07:31.91,Main,,0,0,0,,...كودانزاكا
Dialogue: 0,0:07:31.97,0:07:35.00,Main,,0,0,0,,هذا يبعث على الحنين بحقّ
Dialogue: 0,0:07:35.25,0:07:39.60,Main,,0,0,0,,كنتُ أتحرى الشائعات الّتي تدور حول لوحات كودانزاكا الفنيّة بغرض معرفة مدى صحتها
Dialogue: 0,0:07:39.69,0:07:42.78,Main,,0,0,0,,هلّا تتكرم بإخباري بما تعرفه عنها؟
Dialogue: 0,0:07:43.21,0:07:45.92,Main,,0,0,0,,حسنٌ، لا مانع لدي
Dialogue: 0,0:07:46.21,0:07:48.13,Main,,0,0,0,,...من أين أبدأ يا ترى
Dialogue: 0,0:07:49.04,0:07:54.89,Main,,0,0,0,,أولًا، اسم "كودانزاكا" لا تمتُّ له صلةٌ بمنطقة كودانزاكا في إيدو
Dialogue: 0,0:07:54.90,0:07:56.91,Main,,0,0,0,,بل المقصود به المرأة الّتي في اللوحة
Dialogue: 0,0:07:57.67,0:08:00.98,Main,,0,0,0,,هل تعني أنّه اسم المرأة الّتي في اللوحة؟
Dialogue: 0,0:08:01.25,0:08:03.42,Main,,0,0,0,,ليس كذلك تحديدًا
Dialogue: 0,0:08:03.46,0:08:08.14,Main,,0,0,0,,في غابر الزمان، أطلق عليها هذا الاسم رجلٌ كان يتدلّى من خصره سيفٌ صنع في كادونو
Dialogue: 0,0:08:10.04,0:08:11.89,Main,,0,0,0,,"وهو "كودانزاكا
Dialogue: 0,0:08:12.14,0:08:16.32,Main,,0,0,0,,في الماضي، اعتاد رجلٌ يُدعى موتوهارو التردد على هذا المكان كثيرًا
Dialogue: 0,0:08:25.87,0:08:28.42,Main,,0,0,0,,لم أقدر على حماية المرأة الّتي أحببتها حتّى
Dialogue: 0,0:08:29.08,0:08:32.14,Main,,0,0,0,,سحقًا، يا لي من مثيرٍ للشفقة
Dialogue: 0,0:08:33.60,0:08:35.60,Main,,0,0,0,,جينتا
Dialogue: 0,0:08:37.33,0:08:41.40,Main,,0,0,0,,لأكون صريحًا، كنتُ أكره يوكازي في البداية
Dialogue: 0,0:08:42.12,0:08:47.20,Main,,0,0,0,,لم يكن اختياري كحارسٍ للضريح أمرًا سلبيًّا، لكنّي لم أفهم ما كان يجول خاطرها
Dialogue: 0,0:08:48.41,0:08:52.33,Main,,0,0,0,,ومع الوقت بدأت أشعر برغبةٍ في حمايتها
Dialogue: 0,0:08:53.54,0:08:55.45,Main,,0,0,0,,أو هذا ما كان ينبغي أن يحدث
Dialogue: 0,0:08:56.25,0:08:59.52,Main,,0,0,0,,يتغير مظهر كلّ شيءٍ مع مرور الوقت
Dialogue: 0,0:09:00.42,0:09:04.52,Main,,0,0,0,,حتّى قلبي الّذي أقسم على حمايتها للأبد لم يبقَ سرمديًّا
Dialogue: 0,0:09:05.63,0:09:07.83,Main,,0,0,0,,إيّاك أن تصبح مثلي
Dialogue: 0,0:09:08.71,0:09:13.35,Main,,0,0,0,,جينتا، كُنْ رجلًا يعتز بكراهيته
Dialogue: 0,0:09:18.58,0:09:19.85,Main,,0,0,0,,سأترك الباقي عليك
Dialogue: 0,0:09:20.08,0:09:23.68,Main,,0,0,0,,اعتنِ بشيرايوكي، وكُنْ لطيفًا مع سوزوني
Dialogue: 0,0:09:24.20,0:09:25.17,Main,,0,0,0,,اتفقنا؟
Dialogue: 0,0:09:31.79,0:09:34.27,Main,,0,0,0,,...معذرةً، هل يمكنكَ أن تخبرني
Dialogue: 0,0:09:34.72,0:09:37.70,Main,,0,0,0,,المزيد عن هذا الرجل الّذي يُدعى موتوهارو أيضًا؟
Dialogue: 0,0:09:39.13,0:09:43.21,Main,,0,0,0,,كادونو هي مسقط رأسي، أمّا موتوهارو فهو والدي بالتبني
Dialogue: 0,0:09:43.33,0:09:48.37,Main,,0,0,0,,هكذا إذن، أنتَ ابنه بالتبني
Dialogue: 0,0:09:48.67,0:09:50.66,Main,,0,0,0,,سأخبرك إن كان هذا ما تبتغيه
Dialogue: 0,0:09:50.69,0:09:55.54,Main,,0,0,0,,في كلّ الأحوال، لا بدَّ من ذِكر موتوهارو إن كُنّا سنتطرق إلى موضوع كودانزاكا
Dialogue: 0,0:09:57.44,0:10:00.00,Main,,0,0,0,,...في الأيام الخوالي حين كنتُ في ريعان شبابي
Dialogue: 0,0:10:08.58,0:10:11.33,Main,,0,0,0,,هل أنتِ من سكان هذه المنطقة؟
Dialogue: 0,0:10:12.29,0:10:14.10,Main,,0,0,0,,أجل، هذا صحيح
Dialogue: 0,0:10:14.68,0:10:17.50,Main,,0,0,0,,سأكون تحتَ رعايتكِ ابتداءً من اليوم واسمي ساغا دوشو
Dialogue: 0,0:10:17.75,0:10:18.61,Main,,0,0,0,,وأنتِ؟
Dialogue: 0,0:10:19.72,0:10:22.31,Main,,0,0,0,,لا يمكنني الإفصاح عن اسمي، لكنّي لا أكذب
Dialogue: 0,0:10:22.45,0:10:24.53,Main,,0,0,0,,لذا لا مشكلة إن بقيتُ بِلا اسمٍ
Dialogue: 0,0:10:24.92,0:10:26.27,Main,,0,0,0,,بِلا اسم؟
Dialogue: 0,0:10:34.17,0:10:36.66,Main,,0,0,0,,عجبًا، تبدو اليوم نشيطًا أيضًا
Dialogue: 0,0:10:36.97,0:10:38.49,Main,,0,0,0,,هل وُفِقْتَ في رسم لوحة مميزة؟
Dialogue: 0,0:10:38.70,0:10:42.31,Main,,0,0,0,,أجل، سأشقّ طريقي لأكون رسامًا مشهورًا في إيدو
Dialogue: 0,0:10:42.80,0:10:44.21,Main,,0,0,0,,يا له من هراء
Dialogue: 0,0:10:44.21,0:10:46.42,Main,,0,0,0,,ما أقوله ليس بهراءٍ، أنا جادٌّ حقًّا
Dialogue: 0,0:10:47.36,0:10:48.40,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:10:51.23,0:10:53.47,Main,,0,0,0,,أنا حارس الضريح موتوهارو
Dialogue: 0,0:10:53.54,0:10:57.23,Main,,0,0,0,,أتيتُ حاملًا هذه الرسالة بناءً على أوامر الكاهنة
Dialogue: 0,0:10:57.42,0:10:59.92,Main,,0,0,0,,تساءلتُ عن مصدر هذا الضجيج فإذا به أنت؟
Dialogue: 0,0:10:59.96,0:11:01.37,Main,,0,0,0,,!سحقًا
Dialogue: 0,0:11:01.78,0:11:05.17,Main,,0,0,0,,لِمَ على حارس الكاهنة أن يعمل كساعي بريد؟
Dialogue: 0,0:11:05.54,0:11:07.27,Main,,0,0,0,,!تبًا
Dialogue: 0,0:11:07.33,0:11:09.17,Main,,0,0,0,,!تلك المرأة لا تتسم باللطافة مُطلقًا
Dialogue: 0,0:11:11.71,0:11:13.39,Main,,0,0,0,,هل تتشكى مجدّدًا؟
Dialogue: 0,0:11:13.40,0:11:16.63,Main,,0,0,0,,يبدو أنّك مستاءٌ للغاية من كاهنة الضريح
Dialogue: 0,0:11:17.17,0:11:18.29,Main,,0,0,0,,أجل، هذا صحيح
Dialogue: 0,0:11:18.54,0:11:23.30,Main,,0,0,0,,حسبتُ أنّي حصلتُ على وظيفةٍ مرموقة، لكن وجدتُ نفسي ساعي بريد أنقل الرسائل إلى إيدو
Dialogue: 0,0:11:23.76,0:11:26.72,Main,,0,0,0,, تبدو تلك المرأة أكثر شرًا من الشياطين نفسها
Dialogue: 0,0:11:31.67,0:11:37.79,Main,,0,0,0,,كان والدكَ يأتي إلى إيدو مرّةً في السنة ويتشكى بكثرة
Dialogue: 0,0:11:38.08,0:11:39.63,Main,,0,0,0,,موتوهارو-سان؟
Dialogue: 0,0:11:39.96,0:11:44.86,Main,,0,0,0,,ماذا؟ هل كان حريصًا على ألفاظه حين كان معك؟
Dialogue: 0,0:11:45.63,0:11:48.88,Main,,0,0,0,,للأسف، إنّه رجلٌ مستهترٌ على عكس توقعك
Dialogue: 0,0:11:50.21,0:11:53.67,Main,,0,0,0,,حسنٌ، كُنّا نتحدث عن كودانزاكا، أليس كذلك؟
Dialogue: 0,0:11:54.38,0:11:55.92,Main,,0,0,0,,...تلك اللوحة في الأصل
Dialogue: 0,0:11:55.92,0:12:00.35,Main,,0,0,0,,مطبوعةٌ رسمتها بصبغة "بيني-إي" حين كانت عديمةُ الاسم تعيش في الجوار
Dialogue: 0,0:12:00.42,0:12:04.09,Main,,0,0,0,,وبعدها بفترةٍ، أعرب ضريح سينغيندو عن اهتمامه ببيعها
Dialogue: 0,0:12:04.42,0:12:09.96,Main,,0,0,0,,والأعمال المعروضة في السوق حاليًّا تمّت طباعتها من قالبٍ خشبي نحتهُ اعتمادًا على رسمةٍ من لوحةٍ أوليّة
Dialogue: 0,0:12:10.75,0:12:14.35,Main,,0,0,0,,إذن، أهذا يعني أنَّ المرأة الّتي في اللوحة هي عديمة الاسم؟
Dialogue: 0,0:12:14.83,0:12:18.81,Main,,0,0,0,,يمكنك القول أنّها كذلك والعكس أيضًا
Dialogue: 0,0:12:19.23,0:12:23.72,Main,,0,0,0,,لِمَ وصفتَ كودانزاكا بأنّها لوحة شيطانية؟
Dialogue: 0,0:12:24.08,0:12:27.33,Main,,0,0,0,,لأنّها فعلًا لوحةٌ لشيطان
Dialogue: 0,0:12:27.57,0:12:30.71,Main,,0,0,0,,في جوهرها لعنةٌ وهذا لا ريب فيه
Dialogue: 0,0:12:31.79,0:12:37.73,Main,,0,0,0,,حسنٌ، إن أردنا التعمق في هذا الأمر فعليّ أن أسألك أولًا
Dialogue: 0,0:12:38.08,0:12:41.04,Main,,0,0,0,,ما الّذي تبادر في ذهنك حين رأيت كودانزاكا أول مرّة؟
Dialogue: 0,0:12:45.18,0:12:52.59,Main,,0,0,0,,رؤية الكاهنة بجانب النهر وهي ترتدي عقدًا من اليشم ذكرتني بأسطورة الأميرة نوناكاوا من شينانو
Dialogue: 0,0:12:53.25,0:12:55.11,Main,,0,0,0,,...غير أنَّ السيف الّذي بحوزتها
Dialogue: 0,0:12:55.13,0:12:59.18,Main,,0,0,0,,جعلني أفكر في إمكانية وجود علاقةٍ بين كادونو وكاهنة الضريح؟
Dialogue: 0,0:12:59.29,0:13:02.55,Main,,0,0,0,,أجل، أجل، أجل، هذا كافٍ
Dialogue: 0,0:13:02.58,0:13:05.00,Main,,0,0,0,,والآن لنتناول موضوع لوحة الشيطان
Dialogue: 0,0:13:05.63,0:13:08.58,Main,,0,0,0,,لكن من المحتمل أن تندم بمجرد سماع هذا
Dialogue: 0,0:13:09.35,0:13:13.11,Main,,0,0,0,,"وقد تقول في نفسك "يا ليتني لم أعرف
Dialogue: 0,0:13:18.64,0:13:23.37,Main,,0,0,0,,،كان موتوهارو يأتي إلى إيدو بانتظام لأداء واجبه
Dialogue: 0,0:13:23.42,0:13:26.96,Main,,0,0,0,,ويشتكي هنا وهناك ثمَّ يعود إلى موطنه
Dialogue: 0,0:13:27.37,0:13:32.29,Main,,0,0,0,,لكن، لاحظتُ أنَّ موقفه تُجاه الكاهنة بدأ يتغير تدريجيًّا
Dialogue: 0,0:13:32.50,0:13:34.36,Main,,0,0,0,,...إلى أن جاءت تلك اللحظة
Dialogue: 0,0:13:36.03,0:13:37.79,Main,,0,0,0,,أريدك أن ترسم لي لوحة
Dialogue: 0,0:13:38.30,0:13:39.16,Main,,0,0,0,,لوحة؟
Dialogue: 0,0:13:39.33,0:13:41.75,Main,,0,0,0,,دعني أخمن، هل هي لوحةٌ للكاهنة؟
Dialogue: 0,0:13:42.03,0:13:43.23,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:13:43.31,0:13:46.21,Main,,0,0,0,,!بالرغم من كثرة شكواك منها بالأمس
Dialogue: 0,0:13:46.23,0:13:49.25,Main,,0,0,0,,ولم تُصالحها فحسب، بل وقعتَ في غرامها
Dialogue: 0,0:13:49.63,0:13:50.83,Main,,0,0,0,,لا تسخر منّي
Dialogue: 0,0:13:51.91,0:13:55.83,Main,,0,0,0,,علاوةً على ذلك، لديها ظروفها الخاصة
Dialogue: 0,0:13:56.60,0:14:01.49,Main,,0,0,0,,لكن، حتّى لو قلتُ إنّي سأرسم، إلّا أنّي لا أعرف الكاهنة شخصيًّا
Dialogue: 0,0:14:01.67,0:14:03.44,Main,,0,0,0,,لن نواجه أيّ مشكلة في هذه الحالة
Dialogue: 0,0:14:03.74,0:14:05.81,Main,,0,0,0,,فلدينا عديمة الاسم
Dialogue: 0,0:14:06.02,0:14:08.89,Main,,0,0,0,,عديمة الاسم؟ ما الّذي تقصده؟
Dialogue: 0,0:14:09.33,0:14:13.64,Main,,0,0,0,,...يعود أصل عديمة الاسم إلى شينانو، ولكن
Dialogue: 0,0:14:13.83,0:14:17.49,Main,,0,0,0,,يبدو أنّها مرّتْ بظروفٍ سيّئة أجبرتها على الهروب إلى كادونو
Dialogue: 0,0:14:18.78,0:14:22.84,Main,,0,0,0,,ثمَّ غادرتْ كادونو واستقرتْ هنا في إيدو على ما يبدو
Dialogue: 0,0:14:23.13,0:14:28.43,Main,,0,0,0,,تمهل، هذا مفاجئ، ولكن ما علاقة هذا بحديثنا عن لوحة الكاهنة؟
Dialogue: 0,0:14:28.45,0:14:30.02,Main,,0,0,0,,ثمّة صلةٌ بينهما
Dialogue: 0,0:14:31.97,0:14:33.50,Main,,0,0,0,,...يوكازي في الواقع
Dialogue: 0,0:14:34.00,0:14:36.32,Main,,0,0,0,,صورةٌ طبق الأصل من عديمة الاسم
Dialogue: 0,0:14:36.99,0:14:41.02,Main,,0,0,0,,...أيعقل أنَّ المرأة الّتي في لوحة كودانزاكا الفنيّة هي يوكازي-سان
Dialogue: 0,0:14:41.67,0:14:43.75,Main,,0,0,0,,كاهنة كادونو؟
Dialogue: 0,0:14:44.13,0:14:45.92,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:14:46.74,0:14:54.30,Main,,0,0,0,,رسمتُها بناءً على شبيهتها عديمة الاسم، إضافةً إلى نصائح موتوهارو وبعضٍ من مخيلتي فأصبحت كودانزاكا
Dialogue: 0,0:14:55.75,0:15:01.95,Main,,0,0,0,,ظننتُ أنّها الأميرة نوناكاوا، لكن ما رُسم فعليًا كان الكاهنة وياراي إذن
Dialogue: 0,0:15:03.83,0:15:05.77,Main,,0,0,0,,إذن لِمَ سُميتْ بلوحة الشيطان؟
Dialogue: 0,0:15:06.17,0:15:12.17,Main,,0,0,0,,"بدأ الأمر حين قال موتوهارو أنَّ تلك المرأة تبدو "أكثر شرًا من الشياطين نفسها
Dialogue: 0,0:15:12.21,0:15:13.86,Main,,0,0,0,,ولهذا سُميتْ بلوحة الشيطان
Dialogue: 0,0:15:14.08,0:15:17.69,Main,,0,0,0,,إنّه مجرد اسم ساخرٍ مستوحًى من شكواه في الماضي
Dialogue: 0,0:15:18.38,0:15:24.52,Main,,0,0,0,,لكن بدأتُ أشعر بوهن الشيخوخة بعد أن رسمتُ اللوحة الأوليّة في ضريح سينغيندو بدافع الحنين
Dialogue: 0,0:15:24.81,0:15:27.27,Main,,0,0,0,,...والآن، صرتُ أتساءل أحيانًا
Dialogue: 0,0:15:27.54,0:15:33.26,Main,,0,0,0,,لعلَّ هذا عقابٌ على اتّجاري بمشاعر الآخرين من خلال لوحة شيطان
Dialogue: 0,0:15:33.49,0:15:39.34,Main,,0,0,0,,وهكذا ظنَّ ضريح سينغيندو أنّها لوحةٌ فنيّةٌ ملعونةٌ تُسبب الأمراض
Dialogue: 0,0:15:39.61,0:15:44.33,Main,,0,0,0,,هذه هي القصة بأكملها، مجرد سلسلةٍ من الصدف لا أكثر
Dialogue: 0,0:15:44.58,0:15:48.67,Main,,0,0,0,,إنّها مجرد لوحةٍ عاديّة لا شيء مريب فيها
Dialogue: 0,0:15:49.85,0:15:52.58,Main,,0,0,0,,لِمَ ظننتَ أنّي سأندم على معرفة هذا؟
Dialogue: 0,0:15:52.79,0:15:55.93,Main,,0,0,0,,أليست لوحة كودانزاكا في غاية الجمال؟
Dialogue: 0,0:15:58.78,0:16:00.97,Main,,0,0,0,,حسنٌ، ما رأيك يا موتوهارو؟
Dialogue: 0,0:16:01.63,0:16:03.95,Main,,0,0,0,,لا، غير مقبولة
Dialogue: 0,0:16:09.19,0:16:11.17,Main,,0,0,0,,هل كنتَ تُصغي إلى كلامي؟
Dialogue: 0,0:16:11.32,0:16:12.96,Main,,0,0,0,,يوكازي لا تبدو هكذا
Dialogue: 0,0:16:20.67,0:16:22.72,Main,,0,0,0,,أما زلتَ غير راضٍ؟
Dialogue: 0,0:16:22.73,0:16:24.62,Main,,0,0,0,,ماذا تريدني أن أفعل؟
Dialogue: 0,0:16:25.65,0:16:27.42,Main,,0,0,0,,زِدها جمالًا
Dialogue: 0,0:16:28.04,0:16:33.70,Main,,0,0,0,,خلاصة القول، كودانزاكا هي الكاهنة الّتي جمّلها موتوهارو
Dialogue: 0,0:16:34.61,0:16:36.88,Main,,0,0,0,,صحيح، ثمّة شيء آخر
Dialogue: 0,0:16:37.76,0:16:42.42,Main,,0,0,0,,،حين قلت إنَّ كودانزاكا ذكّرتك بالأميرة نوناكاوا
Dialogue: 0,0:16:42.42,0:16:44.21,Main,,0,0,0,,كان لدى موتوهارو رؤيةٌ مغايرة
Dialogue: 0,0:16:45.29,0:16:49.23,Main,,0,0,0,,قال إنّها تشبه الإلهة ياساكاتومي إلى حد كبير
Dialogue: 0,0:16:49.73,0:16:51.58,Main,,0,0,0,,هل لديك معرفةٌ عنها؟
Dialogue: 0,0:16:52.08,0:16:55.65,Main,,0,0,0,,علّمني موتوهارو-سان القليل عن الأساطير المحلية حين كنتُ صغيرًا
Dialogue: 0,0:16:56.07,0:16:58.69,Main,,0,0,0,,أليست إلهةً تُعبد في ضريح سووا بشينانو؟
Dialogue: 0,0:16:58.81,0:16:59.95,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:17:00.04,0:17:04.26,Main,,0,0,0,,ربما استوحى ذلك من عديمة الاسم بما أنّها وُلدتْ في شينانو
Dialogue: 0,0:17:04.38,0:17:08.55,Main,,0,0,0,,لكن أن يٌشبهها كلٌّ من الأب والابن بإلهة شينانو لأمرٌ عجيبٌ بحقّ
Dialogue: 0,0:17:14.51,0:17:16.65,Main,,0,0,0,,تبدو في غايّة الرضا الآن
Dialogue: 0,0:17:17.00,0:17:19.84,Main,,0,0,0,,إذن، ما رأيك أن تمنح اللوحة اسمًا؟
Dialogue: 0,0:17:19.98,0:17:20.95,Main,,0,0,0,,اسمًا؟
Dialogue: 0,0:17:21.73,0:17:23.42,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:17:24.39,0:17:26.26,Main,,0,0,0,,إلهة ياساكاتومي
Dialogue: 0,0:17:26.54,0:17:27.41,Main,,0,0,0,,كلا
Dialogue: 0,0:17:27.77,0:17:30.29,Main,,0,0,0,,زوجتي تفوق الإلهة جمالًا
Dialogue: 0,0:17:30.31,0:17:31.74,Main,,0,0,0,,الجمال الإلهي لا يكفي
Dialogue: 0,0:17:32.17,0:17:36.25,Main,,0,0,0,,...بما أنّها تفوق الإلهة جمالًا، فإن أفضل اسم لها
Dialogue: 0,0:17:37.83,0:17:39.42,Main,,0,0,0,,كودانزاكا
Dialogue: 0,0:17:40.13,0:17:43.43,Main,,0,0,0,,أرأيت؟ أخبرتك أنّك ستندم على معرفتك لهذا
Dialogue: 0,0:17:43.75,0:17:47.01,Main,,0,0,0,,لوحة كودانزاكا الفنيّة ما هي إلّا نتيجة وقوع والدك في الحبّ
Dialogue: 0,0:17:47.08,0:17:49.23,Main,,0,0,0,,هذه هي لعنة والدك
Dialogue: 0,0:17:49.53,0:17:52.97,Main,,0,0,0,,بعبارة أخرى، هذا ما جعلها لوحةً ملعونة
Dialogue: 0,0:17:53.87,0:17:55.32,Main,,0,0,0,,فهمت
Dialogue: 0,0:17:55.78,0:17:59.87,Main,,0,0,0,,كودانزاكا ليست بلعنة إنّما هي ساحرة
Dialogue: 0,0:17:59.97,0:18:04.68,Main,,0,0,0,,...بالحديث عن ذلك، أرى أنّك تُناديها دائمًا بـ "كودانزاكا"، ولكن
Dialogue: 0,0:18:04.69,0:18:09.34,Main,,0,0,0,,"أريدك أن تعي بأنَّ معناها "والدتي أجمل من الآلهة
Dialogue: 0,0:18:10.08,0:18:12.04,Main,,0,0,0,,ارحمني قليلًا
Dialogue: 0,0:18:14.28,0:18:17.16,Main,,0,0,0,,أخيرًا زالتْ عن وجهك تلك الكآبة
Dialogue: 0,0:18:17.96,0:18:19.76,Main,,0,0,0,,جعلتني أضحك
Dialogue: 0,0:18:20.32,0:18:24.50,Main,,0,0,0,,،على كلٍ، بما أنّك لم تكن تعرف معنى كودانزاكا حتّى الآن
Dialogue: 0,0:18:24.54,0:18:27.65,Main,,0,0,0,,فهذا يعني أنَّ موتوهارو لم يخبر أطفاله عنها
Dialogue: 0,0:18:30.35,0:18:31.19,Main,,0,0,0,,انظر
Dialogue: 0,0:18:33.20,0:18:34.33,Main,,0,0,0,,ما هذه؟
Dialogue: 0,0:18:34.67,0:18:36.97,Main,,0,0,0,,مجرد مسودةٍ رسمتها آنذاك
Dialogue: 0,0:18:37.22,0:18:40.45,Main,,0,0,0,,سأكون ممتنًّا لو تغاضيتَ عن كونها متسخةً قليلًا
Dialogue: 0,0:18:41.16,0:18:45.72,Main,,0,0,0,,مع أنّي قلتُ الكثير، أرجو ألّا تكره موتوهارو
Dialogue: 0,0:18:45.88,0:18:49.84,Main,,0,0,0,,رغم حماقته، كان رجلًا يُحبّ عائلته
Dialogue: 0,0:18:50.15,0:18:53.97,Main,,0,0,0,,قلّتْ زياراته إلى إيدو بعد أن وُلدتْ ابنته
Dialogue: 0,0:18:54.00,0:18:58.07,Main,,0,0,0,,ثمَّ أخبرني بأنّه تبنّى طفلين في آخر زيارةٍ له
Dialogue: 0,0:18:58.32,0:19:00.56,Main,,0,0,0,,ومن يومها لم يَعُد مجدّدًا
Dialogue: 0,0:19:00.77,0:19:02.55,Main,,0,0,0,,هذا ما كان عليه دومًا
Dialogue: 0,0:19:11.58,0:19:13.82,Main,,0,0,0,,أجل، أعرف
Dialogue: 0,0:19:14.81,0:19:19.47,Main,,0,0,0,,كان والدي دائمًا... يعلّمني أسمى قيم الحياة
Dialogue: 0,0:19:21.38,0:19:22.87,Main,,0,0,0,,هكذا إذن
Dialogue: 0,0:19:26.88,0:19:28.63,Main,,0,0,0,,تفضّل طبق الكاكي-سوبا
Dialogue: 0,0:19:30.26,0:19:33.92,Main,,0,0,0,,ما بكَ أيّها السيّد تحدق فيَّ هكذا؟
Dialogue: 0,0:19:34.41,0:19:35.42,Main,,0,0,0,,لا شيء
Dialogue: 0,0:19:35.81,0:19:37.52,Main,,0,0,0,,مجرد إعجابٍ بكونك والدًا صالحًا
Dialogue: 0,0:19:38.78,0:19:42.22,Main,,0,0,0,,ما بكَ حقًّا يا جينيا-كن؟
Dialogue: 0,0:19:42.71,0:19:46.53,Main,,0,0,0,,هل حدث شيء يتعلق بتلك اللوحة الفنية؟
Dialogue: 0,0:19:47.10,0:19:49.74,Main,,0,0,0,,لم يحدث شيء يستحق الذكر
Dialogue: 0,0:19:50.04,0:19:50.97,Main,,0,0,0,,...كلّ ما في الأمر
Dialogue: 0,0:19:51.46,0:19:55.97,Main,,0,0,0,,هو أنّي اكتشفتُ جانبًا لم أكن أعرفه عن والدي
Dialogue: 0,0:19:55.98,0:19:57.40,Main,,0,0,0,,أو هذا ما ينبغي أن أقوله
Dialogue: 0,0:19:57.58,0:19:59.58,Main,,0,0,0,,هذه هي طبيعة الآباء
Dialogue: 0,0:19:59.96,0:20:03.79,Main,,0,0,0,,والدي مثله مثل غيره ليس مثاليًّا إلى حدِّ الكمال
Dialogue: 0,0:20:04.15,0:20:09.83,Main,,0,0,0,,كثير الكلام، يقلق كثيرًا ويذعر حين يتوتر، وأحيانًا يسهو
Dialogue: 0,0:20:10.08,0:20:12.64,Main,,0,0,0,,هل تتحدثين عنّي؟
Dialogue: 0,0:20:13.21,0:20:14.99,Main,,0,0,0,,لا على الإطلاق
Dialogue: 0,0:20:15.02,0:20:16.53,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:20:18.50,0:20:21.63,Main,,0,0,0,,هذه الصفات هي ما تجعل منه والدي
Dialogue: 0,0:20:23.43,0:20:25.20,Main,,0,0,0,,هكذا هو الأمر إذن
Dialogue: 0,0:20:28.67,0:20:31.78,Main,,0,0,0,,لم يكن هناك أيّ شيء غريب بخصوص اللوحة الفنية
Dialogue: 0,0:20:32.43,0:20:37.02,Main,,0,0,0,,ما جعلها تُعرف بـ"لوحة الشيطان" هو مجرد ندمٍ طفيفٍ في نفسِ الرسام
Dialogue: 0,0:20:37.58,0:20:40.30,Main,,0,0,0,,لن يترتب عليها أيّ ضرر سواءً أبقيتها أو بِعتها
Dialogue: 0,0:20:40.54,0:20:43.21,Main,,0,0,0,,وماذا عن الإشاعة المتعلقة بالمتوفى؟
Dialogue: 0,0:20:43.42,0:20:46.46,Main,,0,0,0,,اعذرني على صراحتي، كان الأمر محض صدفة
Dialogue: 0,0:20:46.90,0:20:51.97,Main,,0,0,0,,،حصلتُ على اللوحة الفنية الّتي كانت بحوزة الشخص المتوفى
Dialogue: 0,0:20:51.99,0:20:54.04,Main,,0,0,0,,ولم أجد فيها أيّ شيء غريب أيضًا
Dialogue: 0,0:20:54.32,0:20:58.23,Main,,0,0,0,,فعلًا، ما بلغني لا يستحقّ كلّ هذا التهويل
Dialogue: 0,0:20:58.58,0:21:01.39,Main,,0,0,0,,هل القدر هو من يجمع بين السعادة والشقاء؟
Dialogue: 0,0:21:01.84,0:21:03.30,Main,,0,0,0,,بوركَ عملك
Dialogue: 0,0:21:03.42,0:21:05.60,Main,,0,0,0,,سأعطيك أجركَ قبل أن تُغادر
Dialogue: 0,0:21:05.87,0:21:08.40,Main,,0,0,0,,أما الآن فاروِ عطشك
Dialogue: 0,0:21:09.88,0:21:11.58,Main,,0,0,0,,تفضّل، سأسكب لك كأسًا
Dialogue: 0,0:21:18.04,0:21:19.47,Main,,0,0,0,,سأسكب لك بدوري
Dialogue: 0,0:21:28.29,0:21:30.97,Main,,0,0,0,,هل تشرب الساكي بشكل منتظم؟
Dialogue: 0,0:21:33.04,0:21:35.66,Main,,0,0,0,,كان الساكي ملجئي للهروب من الواقع
Dialogue: 0,0:21:38.90,0:21:41.98,Main,,0,0,0,,ومع الوقت تحول إلى وسيلةٍ للاستمتاع
Dialogue: 0,0:21:42.63,0:21:45.37,Main,,0,0,0,,لا سيّما أنَّ طعمه تحسّن مؤخرًا
Dialogue: 0,0:21:45.96,0:21:48.43,Main,,0,0,0,,هل أنتَ من محبي الساكي؟
Dialogue: 0,0:21:48.54,0:21:49.38,Main,,0,0,0,,أجل
Dialogue: 0,0:21:50.11,0:21:52.89,Main,,0,0,0,,أشرب ما يكفيني لأتسامر تحتَ ضوء القمر
Dialogue: 0,0:21:56.52,0:21:59.85,Main,,0,0,0,,لنشرب معًا مجدّدًا إن سنحتْ لنا الفرصة
Dialogue: 0,0:22:04.54,0:22:07.76,Main,,0,0,0,,بالتأكيد، إن تيسر الأمر
Comment: 0,0:00:00.00,0:00:00.00,Notes,,0,0,0,,
