Dialogue: 0,0:00:14.63,0:00:16.25,Main,,0,0,0,,صباح الخير يا زينجي-سان
Dialogue: 0,0:00:16.25,0:00:17.54,Main,,0,0,0,,صباح الخير
Dialogue: 0,0:00:17.79,0:00:20.38,Main,,0,0,0,,تبدينَ اليوم أكثر جمالًا من الأمس
Dialogue: 0,0:00:20.38,0:00:21.67,Main,,0,0,0,,هل حدث شيء مميز؟
Dialogue: 0,0:00:21.67,0:00:23.04,Main,,0,0,0,,!لا
Dialogue: 0,0:00:23.58,0:00:26.58,Main,,0,0,0,,زينجي، أراكَ مُفعمًا بالحيوية هذا الصباح
Dialogue: 0,0:00:26.58,0:00:28.29,Main,,0,0,0,,!لا لا، بل أنتَ كذلك
Dialogue: 0,0:00:28.29,0:00:30.79,Main,,0,0,0,,ما رأيكَ أن تمرّ علينا بعد العمل إن كان ذلك يناسبك؟
Dialogue: 0,0:00:30.79,0:00:32.04,Main,,0,0,0,,سأفكر في الأمر
Dialogue: 0,0:00:36.04,0:00:37.21,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:00:53.92,0:00:56.13,Main,,0,0,0,,أعتذر عن التأخير يا سيدي
Dialogue: 0,0:01:00.54,0:01:02.13,Main,,0,0,0,,هل هذا بخصوص رينا؟
Dialogue: 0,0:01:02.88,0:01:03.63,Main,,0,0,0,,أجل
Dialogue: 0,0:01:04.63,0:01:06.04,Main,,0,0,0,,سأترك الباقي عليك
Dialogue: 0,0:01:06.50,0:01:09.25,Main,,0,0,0,,وأطلعه على كافة التفاصيل بنفسك
Dialogue: 0,0:02:55.92,0:02:59.21,Main,,0,0,0,,أنا زينجي، وأعمل مساعدًا في متجر سوغايا
Dialogue: 0,0:03:00.75,0:03:02.13,Main,,0,0,0,,أُدعى جينيا
Dialogue: 0,0:03:03.79,0:03:05.63,Main,,0,0,0,,تشرفتُ بمعرفتك
Dialogue: 0,0:03:05.92,0:03:07.13,Main,,0,0,0,,...أعلم أن هذا مباشر، ولكن
Dialogue: 0,0:03:07.14,0:03:09.21,Main,,0,0,0,,كم مقدار ما أطلعك سيّدي عليه؟
Dialogue: 0,0:03:10.46,0:03:15.25,Main,,0,0,0,,حدثني جوزو-دونو عن ابنته المتبناة الّتي يحبها كثيرًا
Dialogue: 0,0:03:15.83,0:03:19.75,Main,,0,0,0,,ويخشى أن تكون حياتها مهددةً من قِبل شيطانٍ، وهذا ما يستدعي قتله
Dialogue: 0,0:03:20.21,0:03:21.17,Main,,0,0,0,,هذا جلّ ما قيل لي
Dialogue: 0,0:03:21.54,0:03:24.33,Main,,0,0,0,,ألم يُفصح لكَ عن أيّ تفاصيل إضافية؟
Dialogue: 0,0:03:27.67,0:03:32.29,Main,,0,0,0,,المطلوب منك هو حراسة الآنسة ناتسو الّتي ستبلغ 13 عامًا هذه السنة
Dialogue: 0,0:03:32.67,0:03:36.92,Main,,0,0,0,,أصبح سيّدي متعلقًا بها بشدّة، حتّى أنّه لا يطيق أن يصيبها مكروه
Dialogue: 0,0:03:37.08,0:03:38.87,Main,,0,0,0,,لكن بدأ الأمر منذ حوالي ثلاثة أيام
Dialogue: 0,0:03:39.17,0:03:45.58,Main,,0,0,0,,"ظهر شيطان في الحديقة الّتي تُطل عليها نافذة غرفة ابنته وهو يكرر عبارة "أعيدوا لي ابنتي
Dialogue: 0,0:03:45.96,0:03:47.50,Main,,0,0,0,,أعيدوا لي ابنتي؟
Dialogue: 0,0:03:47.71,0:03:53.46,Main,,0,0,0,,أجل، الخلاصة هي أن الشيطان يسعى لخطف الآنسة ناتسو لأنّه يعتقد أنّها ابنته
Dialogue: 0,0:03:53.46,0:03:54.42,Main,,0,0,0,,!زينجي
Dialogue: 0,0:03:55.04,0:03:56.63,Main,,0,0,0,,ما الّذي تفعله بالتكاسل هنا؟
Dialogue: 0,0:03:57.58,0:03:59.58,Main,,0,0,0,,!سأخبر والدي بهذا
Dialogue: 0,0:04:01.63,0:04:03.04,Main,,0,0,0,,!الآنسة ناتسو؟
Dialogue: 0,0:04:03.46,0:04:06.17,Main,,0,0,0,,هل أنتَ الحارس الشخصي الّذي عيّنه والدي لحمايتي؟
Dialogue: 0,0:04:06.17,0:04:07.71,Main,,0,0,0,,تبدو يافعًا في السنّ
Dialogue: 0,0:04:08.00,0:04:09.53,Main,,0,0,0,,أُدعى جينيا
Dialogue: 0,0:04:08.71,0:04:10.34,Top,,0,0,0,,!لا أرغب في أيّ مقدمات
Dialogue: 0,0:04:10.50,0:04:11.78,Main,,0,0,0,,يمكنك الانصراف
Dialogue: 0,0:04:11.79,0:04:14.50,Main,,0,0,0,,!أيّتها الآنسة، ما الّذي تقولينه هكذا فجأة
Dialogue: 0,0:04:14.71,0:04:19.04,Main,,0,0,0,,!من الواضح أنّه مجرد محتالٍ استغل هذه الحكاية المريبة لكسب بعض المال اليسير
Dialogue: 0,0:04:19.04,0:04:23.34,Main,,0,0,0,,حسنٌ، السيّد هو من اختاره شخصيًا، لذا أستبعد أن يكون محتالًا
Dialogue: 0,0:04:23.36,0:04:24.46,Main,,0,0,0,,!اصمت
Dialogue: 0,0:04:25.58,0:04:28.13,Main,,0,0,0,,أكره فكرة أن يكون حارسي الشخصي رونين
Dialogue: 0,0:04:28.13,0:04:30.96,Main,,0,0,0,,لن ندفع لكَ أيّ فلسٍ واحد
Dialogue: 0,0:04:31.08,0:04:33.17,Main,,0,0,0,,اطرد هذا الشخص بسرعة
Dialogue: 0,0:04:33.17,0:04:33.79,Main,,0,0,0,,!ماذا؟
Dialogue: 0,0:04:38.92,0:04:42.71,Main,,0,0,0,,!في الواقع، كلّ من الأب والابنة متشابهان سواءٌ في حملهما للأسلحة أو فظاظتهما
Dialogue: 0,0:04:45.21,0:04:46.21,Main,,0,0,0,,آسف
Dialogue: 0,0:04:54.67,0:04:55.58,Main,,0,0,0,,أيّتها الآنسة
Dialogue: 0,0:04:56.48,0:04:57.42,Main,,0,0,0,,زينجي؟
Dialogue: 0,0:04:57.75,0:05:00.67,Main,,0,0,0,,ما الّذي تفعله؟ وفي هذه الساعة المتأخرة من الليل؟
Dialogue: 0,0:05:01.00,0:05:05.25,Main,,0,0,0,,حسنٌ، هذا لأنّكِ رفضتِ الحارس الشخصي
Dialogue: 0,0:05:05.75,0:05:10.46,Main,,0,0,0,,فقلتُ في نفسي ربما وجودي قد يكون نافعًا لردع الشياطين مثلما تُستخدم الفزّاعات لطرد الطيور
Dialogue: 0,0:05:11.58,0:05:12.63,Main,,0,0,0,,زينجي
Dialogue: 0,0:05:14.38,0:05:19.25,Main,,0,0,0,,تتفوه بهذا الكلام، لكنّك في قرارة نفسك تظن أنّي كاذبة، أليس كذلك؟
Dialogue: 0,0:05:19.67,0:05:20.75,Main,,0,0,0,,...في الواقع
Dialogue: 0,0:05:24.29,0:05:25.46,Main,,0,0,0,,كما توقعت
Dialogue: 0,0:05:26.33,0:05:28.54,Main,,0,0,0,,حتّى والدي يظن أنّي أكذب
Dialogue: 0,0:05:28.71,0:05:30.66,Main,,0,0,0,,لهذا وظف ذلك الرونين لحمايتي
Dialogue: 0,0:05:30.96,0:05:32.40,Main,,0,0,0,,هذا جلي
Dialogue: 0,0:05:33.25,0:05:35.17,Main,,0,0,0,,أعتقد أنّكِ مخطئةٌ في ذلك
Dialogue: 0,0:05:35.63,0:05:40.13,Main,,0,0,0,,السيّد يهتم لأمركِ ويشعر بالقلق عليكِ طوال الوقت
Dialogue: 0,0:05:40.67,0:05:42.71,Main,,0,0,0,,هذا أمرٌ لا شك فيه
Dialogue: 0,0:05:43.38,0:05:47.46,Main,,0,0,0,,لكنّك تعلم أنّي لستُ ابنته من صُلبه
Dialogue: 0,0:05:47.46,0:05:48.54,Main,,0,0,0,,...أعيدوا لي
Dialogue: 0,0:05:51.79,0:05:53.17,Main,,0,0,0,,ما الخطب أيّتها الآنسة؟
Dialogue: 0,0:05:53.46,0:05:55.69,Main,,0,0,0,,!لقد جاء، لقد جاء
Dialogue: 0,0:05:55.70,0:05:56.71,Main,,0,0,0,,!ما الّذي قد جاء؟
Dialogue: 0,0:05:56.71,0:05:59.00,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:02.29,0:06:03.25,Main,,0,0,0,,!هذا مُحال
Dialogue: 0,0:06:03.71,0:06:04.75,Main,,0,0,0,,!زينجي
Dialogue: 0,0:06:05.13,0:06:07.17,Main,,0,0,0,,!أيّتها الآنسة، لا تبارحِ الغرفة رجاءً
Dialogue: 0,0:06:11.08,0:06:14.29,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:16.21,0:06:18.46,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:19.50,0:06:22.04,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:23.00,0:06:25.13,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:23.58,0:06:26.00,Top,,0,0,0,,!أيّتها الآنسة، سيكون كلّ شيءٍ على ما يرام
Dialogue: 0,0:06:26.00,0:06:27.71,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:38.08,0:06:39.25,Main,,0,0,0,,ما اسمك؟
Dialogue: 0,0:06:42.17,0:06:44.63,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:06:45.38,0:06:50.04,Main,,0,0,0,,!أعيدوا لي... ابنتي
Dialogue: 0,0:07:01.79,0:07:03.58,Main,,0,0,0,,!يـ-يا لقوته
Dialogue: 0,0:07:06.04,0:07:06.83,Main,,0,0,0,,تلاشى
Dialogue: 0,0:07:07.92,0:07:09.54,Main,,0,0,0,,هل أنتِ بخير أيّتها الآنسة؟
Dialogue: 0,0:07:10.08,0:07:12.29,Main,,0,0,0,,!أأنتَ... الرونين الّذي كان هنا سابقًا
Dialogue: 0,0:07:13.58,0:07:17.33,Main,,0,0,0,,حسنٌ إذن، كم ستدفعين لي مقابل قطعي للشيطان؟
Dialogue: 0,0:07:19.08,0:07:20.25,Main,,0,0,0,,هل مات؟
Dialogue: 0,0:07:23.29,0:07:26.50,Main,,0,0,0,,حين يموت الشياطين، يتحولون إلى غبار أبيض ثمَّ يتلاشون
Dialogue: 0,0:07:27.13,0:07:30.75,Main,,0,0,0,,إلى هذه اللّحظة، لم أرَ شيطانًا يموت بغير هذه الطريقة
Dialogue: 0,0:07:31.25,0:07:33.50,Main,,0,0,0,,...هذا يعني أنَّ ذلك الشيطان
Dialogue: 0,0:07:33.50,0:07:34.73,Main,,0,0,0,,سيعود مجدّدًا
Dialogue: 0,0:07:35.67,0:07:38.46,Main,,0,0,0,,...أيعقل أنَّ ذلك الشيطان
Dialogue: 0,0:07:49.60,0:07:51.18,Main,,0,0,0,,كنتَ عونًا لي البارحة
Dialogue: 0,0:07:51.72,0:07:54.06,Main,,0,0,0,,قلتَ إنّ الشيطان سيعود ليلة البارحة
Dialogue: 0,0:07:54.14,0:07:56.44,Main,,0,0,0,,آسف، لكننا سنحتاج مساعدتكَ هذه الليلة أيضًا
Dialogue: 0,0:07:56.52,0:07:57.52,Main,,0,0,0,,بكلّ سرور
Dialogue: 0,0:07:58.69,0:07:59.98,Main,,0,0,0,,زينجي-دونو
Dialogue: 0,0:08:00.06,0:08:03.57,Main,,0,0,0,,هل تمانع إخباري ببعض التفاصيل الإضافية عن ناتسو-دونو؟
Dialogue: 0,0:08:03.65,0:08:04.82,Main,,0,0,0,,عن الآنسة ناتسو؟
Dialogue: 0,0:08:04.90,0:08:06.49,Main,,0,0,0,,"أعيدوا لي ابنتي"
Dialogue: 0,0:08:07.11,0:08:09.28,Main,,0,0,0,,يساورني بعض القلق حيال ما قاله ذلك الشيطان
Dialogue: 0,0:08:09.37,0:08:10.91,Main,,0,0,0,,فهمت
Dialogue: 0,0:08:11.41,0:08:15.58,Main,,0,0,0,,والدا الآنسة الحقيقيان هُما في الواقع من أقارب السيّد
Dialogue: 0,0:08:15.66,0:08:16.96,Main,,0,0,0,,لكنّهما تُوفيا منذ زمن بعيد
Dialogue: 0,0:08:17.54,0:08:19.71,Main,,0,0,0,,...أتفهم سبب قلقك، ولكن
Dialogue: 0,0:08:19.79,0:08:21.88,Main,,0,0,0,,اطمئن، هذا ضرب من المستحيل
Dialogue: 0,0:08:21.96,0:08:23.55,Main,,0,0,0,,،فضلًا عن ذلك، لو كان ما تفكر فيه صحيحًا
Dialogue: 0,0:08:23.63,0:08:25.84,Main,,0,0,0,,لما تبناها السيّد في المقام الأول
Dialogue: 0,0:08:28.93,0:08:31.47,Main,,0,0,0,,قُتلتْ زوجته على يد شيطان
Dialogue: 0,0:08:31.55,0:08:33.97,Main,,0,0,0,,ويبدو أنَّ ابنه خرج من المنزل ولم يعد منذئذٍ
Dialogue: 0,0:08:34.39,0:08:37.06,Main,,0,0,0,,ظلّ السيّد يقول إنَّ الشياطين هي المسؤولة عن كلّ ما حدث
Dialogue: 0,0:08:39.27,0:08:43.73,Main,,0,0,0,,بالنسبة له، الشياطين هُم أعداؤه الّذين سلبوه عائلته
Dialogue: 0,0:08:43.82,0:08:46.40,Main,,0,0,0,,،لو كانت الآنسة ناتسو ابنة ذلك الشيطان فعلًا
Dialogue: 0,0:08:46.49,0:08:48.99,Main,,0,0,0,,،وحتّى لو كان الاحتمال ضئيلًا
Dialogue: 0,0:08:49.07,0:08:50.53,Main,,0,0,0,,لما كان ليتبناها من الأساس
Dialogue: 0,0:08:51.37,0:08:52.58,Main,,0,0,0,,فهمت
Dialogue: 0,0:09:08.55,0:09:09.63,Main,,0,0,0,,ناتسو
Dialogue: 0,0:09:10.76,0:09:13.56,Main,,0,0,0,,هل ثمّة مشكلة مع الرجل الّذي كلفته بحراستكِ؟
Dialogue: 0,0:09:13.83,0:09:14.67,Main,,0,0,0,,كلّا
Dialogue: 0,0:09:14.89,0:09:18.69,Main,,0,0,0,,يزعم أنّه رونين، لكنّه لا يبدو شخصًا سيئًا
Dialogue: 0,0:09:18.77,0:09:21.77,Main,,0,0,0,,علاوةً، أنتَ من اخترته يا والدي
Dialogue: 0,0:09:21.86,0:09:24.23,Main,,0,0,0,,شكرًا على قلقك بشأني
Dialogue: 0,0:09:24.32,0:09:25.61,Main,,0,0,0,,هذا بديهي
Dialogue: 0,0:09:25.69,0:09:28.53,Main,,0,0,0,,ما من أبٍ لا يشعر بالقلق على ابنته
Dialogue: 0,0:09:33.66,0:09:35.66,Main,,0,0,0,,...أخبرني يا والدي
Dialogue: 0,0:09:35.74,0:09:38.08,Main,,0,0,0,,لِمَ وظفتَ ذلك الرجل بالذات؟
Dialogue: 0,0:09:42.92,0:09:47.92,Main,,0,0,0,,مؤخرًا، انتشرت شائعات عن ظهور بعض الشياطين في إيدو
Dialogue: 0,0:09:48.55,0:09:53.55,Main,,0,0,0,,لكن في الوقت نفسه، ثمّة أيضًا شائعاتٌ عن رجلٍ بمقدوره قتل الشياطين بسيفه فحسب
Dialogue: 0,0:09:53.64,0:09:55.56,Main,,0,0,0,,هل هو ذلك الرونين؟
Dialogue: 0,0:09:55.64,0:09:56.31,Main,,0,0,0,,أجل
Dialogue: 0,0:09:56.34,0:09:57.97,Main,,0,0,0,,،يزعمون أنّه مُقابل المال
Dialogue: 0,0:09:58.06,0:10:00.27,Main,,0,0,0,,سيقتل أيّ شيطان
Dialogue: 0,0:10:00.35,0:10:02.23,Main,,0,0,0,,قِيل إنّه كفؤ في عمله
Dialogue: 0,0:10:02.31,0:10:04.56,Main,,0,0,0,,والأهم من ذلك، أنّه جديرٌ بالثقة
Dialogue: 0,0:10:05.06,0:10:07.78,Main,,0,0,0,,إنّه الحارس الأمثل لحمايتكِ
Dialogue: 0,0:10:08.86,0:10:12.28,Main,,0,0,0,,!أنتَ تصدقني إذن يا والدي
Dialogue: 0,0:10:20.04,0:10:21.79,Main,,0,0,0,,،حين يتعلق الأمر بقصص الرعب
Dialogue: 0,0:10:21.87,0:10:24.58,Main,,0,0,0,,ثمّة العديد من الحكايات المختلفة الّتي تتناقلها الألسن
Dialogue: 0,0:10:25.25,0:10:28.63,Main,,0,0,0,,،الأشباح الباهتة، وأشباح الصفصاف
Dialogue: 0,0:10:28.71,0:10:33.13,Main,,0,0,0,,ساراياشكي، والشياطين، رأس البقرة
Dialogue: 0,0:10:33.22,0:10:37.31,Main,,0,0,0,,لكن قصص الرعب المفبركة ليست مخيفة
Dialogue: 0,0:10:40.39,0:10:43.56,Main,,0,0,0,,لا شكّ أنَّ السيّد يعتصره الألم في الواقع
Dialogue: 0,0:10:43.65,0:10:45.90,Main,,0,0,0,,قُتلتْ زوجته على يد شيطان
Dialogue: 0,0:10:45.98,0:10:48.23,Main,,0,0,0,,وابنه اختُطِف من قِبل شيطانة
Dialogue: 0,0:10:48.32,0:10:51.44,Main,,0,0,0,,لكنّه ما يزال يؤمن بأنّ ابنه سيعود يومًا ما
Dialogue: 0,0:10:51.49,0:10:54.27,Main,,0,0,0,,لهذا لم يتبنَّ ولدًا بل فتاةً بدلًا من ذلك
Dialogue: 0,0:10:54.82,0:10:56.87,Main,,0,0,0,,...المخيف حقًّا هو
Dialogue: 0,0:10:56.95,0:10:59.62,Main,,0,0,0,,الحقيقة الّتي لا يمكن إنكارها
Dialogue: 0,0:11:03.54,0:11:05.04,Main,,0,0,0,,أيّتها الآنسة، لا يجوز أن تخرجي
Dialogue: 0,0:11:05.12,0:11:06.84,Main,,0,0,0,,لِمَ أنتَ هنا يا زينجي؟
Dialogue: 0,0:11:07.67,0:11:10.09,Main,,0,0,0,,أردتُ تدارك إهانة يوم أمس
Dialogue: 0,0:11:10.17,0:11:11.30,Main,,0,0,0,,أمزح
Dialogue: 0,0:11:13.55,0:11:15.30,Main,,0,0,0,,لا أهتم بتاتًا
Dialogue: 0,0:11:15.97,0:11:17.22,Main,,0,0,0,,هذا قاسٍ
Dialogue: 0,0:11:17.30,0:11:19.60,Main,,0,0,0,,سامحيني رجاءً أيّتها الآنسة
Dialogue: 0,0:11:19.68,0:11:21.93,Main,,0,0,0,,إذن، خذني معك في المرّة القادمة
Dialogue: 0,0:11:22.02,0:11:23.85,Main,,0,0,0,,حينها سأسامحك
Dialogue: 0,0:11:24.02,0:11:25.08,Main,,0,0,0,,بالطبع
Dialogue: 0,0:11:25.08,0:11:27.19,Main,,0,0,0,,إن كان هذا يرضيكِ، يمكنكِ الذهاب حيثما تشائين
Dialogue: 0,0:11:29.02,0:11:30.98,Main,,0,0,0,,أنتْ، ما اسمك؟
Dialogue: 0,0:11:31.65,0:11:32.65,Main,,0,0,0,,جينيا
Dialogue: 0,0:11:33.82,0:11:34.99,Main,,0,0,0,,جينيا إذن
Dialogue: 0,0:11:35.07,0:11:37.07,Main,,0,0,0,,حسنٌ، سأناديك به
Dialogue: 0,0:11:37.16,0:11:39.95,Main,,0,0,0,,يبدو أنّ والدي يحترمكَ كثيرًا
Dialogue: 0,0:11:40.79,0:11:44.00,Main,,0,0,0,,لذا، سأثق بكَ هذه المرّة فقط
Dialogue: 0,0:11:44.50,0:11:47.58,Main,,0,0,0,,يبدو أنّكِ تُكِنين له احترامًا كبيرًا يا ناتسو-دونو
Dialogue: 0,0:11:47.67,0:11:49.13,Main,,0,0,0,,هذا بديهي
Dialogue: 0,0:11:49.21,0:11:51.09,Main,,0,0,0,,فقد رباني حتّى صرتُ على ما أنا عليه الآن
Dialogue: 0,0:11:51.17,0:11:53.01,Main,,0,0,0,,كيف لي ألّا أكون ممتنةً له؟
Dialogue: 0,0:11:54.17,0:11:55.18,Main,,0,0,0,,فهمت
Dialogue: 0,0:11:55.63,0:11:57.26,Main,,0,0,0,,يا لها من علاقة وثيقة بين أبٍ وابنته
Dialogue: 0,0:11:57.68,0:12:00.14,Main,,0,0,0,,ويبدو أن جوزو-دونو يكترث لأمركِ أيضًا
Dialogue: 0,0:12:01.14,0:12:02.77,Main,,0,0,0,,أتعتقد ذلك؟
Dialogue: 0,0:12:03.89,0:12:06.94,Main,,0,0,0,,بالمناسبة، صادف أنّي سمعتُ شيئًا في ذلك اليوم
Dialogue: 0,0:12:07.02,0:12:09.09,Main,,0,0,0,,...وهو أنّ جوزو-دونو لديه ابن
Dialogue: 0,0:12:08.47,0:12:09.65,Top,,0,0,0,,!لا أعرف
Dialogue: 0,0:12:10.15,0:12:12.57,Main,,0,0,0,,!لا أعرف شيئًا عن ابنه الّذي غادر البيت
Dialogue: 0,0:12:13.78,0:12:14.78,Main,,0,0,0,,فهمت
Dialogue: 0,0:12:15.90,0:12:17.36,Main,,0,0,0,,آسف على ما بدر منّي
Dialogue: 0,0:12:19.87,0:12:20.87,Main,,0,0,0,,...أنت
Dialogue: 0,0:12:21.28,0:12:24.58,Main,,0,0,0,,هل يمكن لشيطانٍ وإنسانٍ أن ينجبا طفلًا؟
Dialogue: 0,0:12:24.66,0:12:25.66,Main,,0,0,0,,هذا ممكن
Dialogue: 0,0:12:26.46,0:12:31.17,Main,,0,0,0,,..."إذن، لعلَّ ذلك الشيطان الّذي يقول "أعيدوا لي ابنتي
Dialogue: 0,0:12:31.54,0:12:33.96,Main,,0,0,0,,ذلك الشيطان لا يمتُّ لكِ بصلةٍ كأب
Dialogue: 0,0:12:34.05,0:12:35.84,Main,,0,0,0,,كيف لك أن تكون واثقًا لهذا الحد؟
Dialogue: 0,0:12:35.92,0:12:37.97,Main,,0,0,0,,لأنّي أعرف ذلك الشيطان
Dialogue: 0,0:12:38.05,0:12:39.05,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:12:38.05,0:12:39.05,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:12:39.47,0:12:42.01,Main,,0,0,0,,بيني وبينه علاقة أو ماضٍ مشترك
Dialogue: 0,0:12:42.10,0:12:44.47,Main,,0,0,0,,ذلك الشيطان لا يمتُّ لكِ بصلةٍ كأب
Dialogue: 0,0:12:44.56,0:12:46.48,Main,,0,0,0,,وهذا لا ريب فيه
Dialogue: 0,0:12:47.10,0:12:48.31,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:12:48.85,0:12:50.10,Main,,0,0,0,,لستُ من الكاذبين
Dialogue: 0,0:12:53.82,0:12:56.36,Main,,0,0,0,,كيف يولدُ الشياطين في اعتقادك؟
Dialogue: 0,0:12:57.07,0:12:58.36,Main,,0,0,0,,كيف يولدون؟
Dialogue: 0,0:12:58.45,0:12:59.95,Main,,0,0,0,,حسنٌ، هذا بديهي
Dialogue: 0,0:13:00.03,0:13:02.20,Main,,0,0,0,,...إنّهم نتاج والِديهم، لكن
Dialogue: 0,0:13:02.28,0:13:03.74,Main,,0,0,0,,كيف يولدون فعلًا؟
Dialogue: 0,0:13:04.37,0:13:06.91,Main,,0,0,0,,تتعدّد السّبلُ الّتي يُولد بها الشياطين
Dialogue: 0,0:13:07.00,0:13:10.54,Main,,0,0,0,,،ثمّة حالات يكون فيها الأمر ناتجًا عن تزاوجٍ بين الشياطين
Dialogue: 0,0:13:10.63,0:13:14.59,Main,,0,0,0,,وأحيانًا، يُولدون نتيجة اعتداء شيطانٍ على بشريّ بغرض اللهو
Dialogue: 0,0:13:15.67,0:13:18.26,Main,,0,0,0,,بينما ثمّة آخرون يُولدون من العدم
Dialogue: 0,0:13:18.34,0:13:19.72,Main,,0,0,0,,من العدم؟
Dialogue: 0,0:13:19.80,0:13:21.89,Main,,0,0,0,,،تحمل المشاعر قوّةً في طيّاتها
Dialogue: 0,0:13:21.97,0:13:23.85,Main,,0,0,0,,وكلّما كانت مظلمة، زادت هذه القوّة
Dialogue: 0,0:13:24.76,0:13:31.27,Main,,0,0,0,,الغضب، الكراهية، الحسد، الهوس، الحزن، الجوع
Dialogue: 0,0:13:31.35,0:13:35.53,Main,,0,0,0,,هذه المشاعر الدفينة الّتي طال أمدها ستتراكم ببطء وتتكثف
Dialogue: 0,0:13:35.61,0:13:37.65,Main,,0,0,0,,لتُشكل شيطانًا في النهاية
Dialogue: 0,0:13:38.49,0:13:43.41,Main,,0,0,0,,هذه الشياطين الّتي وُلِدتْ من العدم هي مشاعرٌ تحولتْ إلى لحمٍ ودم
Dialogue: 0,0:13:47.41,0:13:49.12,Main,,0,0,0,,هلّا أخبرتني باسمك؟
Dialogue: 0,0:13:49.54,0:13:52.04,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:13:59.38,0:14:01.96,Main,,0,0,0,,هل تفتقر إلى الذكاء لدرجة أنّك عاجز عن لفظ اسمك حتّى؟
Dialogue: 0,0:14:00.66,0:14:03.70,Top,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:14:02.98,0:14:04.22,Main,,0,0,0,,ما الّذي تفعله؟
Dialogue: 0,0:14:04.30,0:14:05.76,Main,,0,0,0,,!لا تتصرف بهذا التهور
Dialogue: 0,0:14:05.85,0:14:06.76,Main,,0,0,0,,هل يجوز لي قطعه؟
Dialogue: 0,0:14:06.79,0:14:08.58,Main,,0,0,0,,...بالطبع، أسرع و
Dialogue: 0,0:14:08.58,0:14:10.44,Main,,0,0,0,,سؤالي موجهٌ لكِ يا ناتسو-دونو
Dialogue: 0,0:14:11.69,0:14:12.69,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:14:13.31,0:14:14.81,Main,,0,0,0,,سأعيد السؤال
Dialogue: 0,0:14:14.90,0:14:16.32,Main,,0,0,0,,هل يجوز لي قطعه؟
Dialogue: 0,0:14:18.07,0:14:20.28,Main,,0,0,0,,،حتّى لو قطعته وأزلتُ رأسه
Dialogue: 0,0:14:20.36,0:14:21.99,Main,,0,0,0,,سيعود الشيطان للظهور مجدّدًا
Dialogue: 0,0:14:23.49,0:14:24.57,Main,,0,0,0,,لماذا؟
Dialogue: 0,0:14:24.66,0:14:25.95,Main,,0,0,0,,هذا بديهي
Dialogue: 0,0:14:26.03,0:14:29.12,Main,,0,0,0,,لأنَّ هذا الشيطان... هو تجسيدٌ لمشاعركِ يا ناتسو-دونو
Dialogue: 0,0:14:29.91,0:14:36.38,Main,,0,0,0,,ظهر تلبيةً لأمنيتكِ، وأثار اضطرابًا كافيًّا ليسترعي اهتمام والدكِ العزيز
Dialogue: 0,0:14:36.84,0:14:37.88,Main,,0,0,0,,فهمت
Dialogue: 0,0:14:37.96,0:14:40.59,Main,,0,0,0,,ليُعرب عن خوفه عليكِ كما تفعل أيّ عائلة حقيقيّة
Dialogue: 0,0:14:41.17,0:14:44.93,Main,,0,0,0,,وسيهاجم الشيطان الّذين يتفوهون بأقوالٍ لا ترغبين في سماعها
Dialogue: 0,0:14:45.01,0:14:47.56,Main,,0,0,0,,!يا له من شيطانٍ عينُ ما رغبتِ به
Dialogue: 0,0:14:47.64,0:14:51.06,Main,,0,0,0,,هكذا إذن، اتضحتْ لي الصورة أخيرًا
Dialogue: 0,0:14:51.14,0:14:54.69,Main,,0,0,0,,لكن في قرارةِ نفسكِ، لطالما أردتِ حدوثَ هذا، أليس كذلك؟
Dialogue: 0,0:14:54.77,0:14:56.11,Main,,0,0,0,,!توقف
Dialogue: 0,0:14:57.40,0:14:59.28,Main,,0,0,0,,...ما السبب وراء اتخاذ هذا الشيطان
Dialogue: 0,0:14:59.36,0:15:02.14,Main,,0,0,0,,هذه الهيئة البشعة يا ترى؟
Dialogue: 0,0:15:02.49,0:15:04.82,Main,,0,0,0,,مهما قطعته سيعود للظهور فورًا
Dialogue: 0,0:15:04.91,0:15:06.28,Main,,0,0,0,,مرارًا وتكرارًا
Dialogue: 0,0:15:06.37,0:15:09.79,Main,,0,0,0,,ما دمتِ غير راضية، فلن يختفي هذا الشيطان أبدًا
Dialogue: 0,0:15:09.87,0:15:11.54,Main,,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:15:11.62,0:15:12.91,Main,,0,0,0,,إذن، ماذا عليّ أن أفعل؟
Dialogue: 0,0:15:13.00,0:15:14.33,Main,,0,0,0,,كلمةٌ واحدة
Dialogue: 0,0:15:14.42,0:15:16.42,Main,,0,0,0,,"كلّ ما عليكِ قوله هو "اقطعه
Dialogue: 0,0:15:17.59,0:15:22.13,Main,,0,0,0,,كنتُ أغضّ الطّرف دائمًا عن الأشياء الّتي لا أريد مواجهتها وأخفي جانبي الضعيف
Dialogue: 0,0:15:22.84,0:15:24.88,Main,,0,0,0,,لكنّي تُقت أن يُحبني أحدهم
Dialogue: 0,0:15:25.59,0:15:26.68,Main,,0,0,0,,...ومع ذلك
Dialogue: 0,0:15:26.76,0:15:28.66,Main,,0,0,0,,لم أستطع أن أصدق ذلك
Dialogue: 0,0:15:29.22,0:15:32.39,Main,,0,0,0,,،لهذا خطر ببالي أنّه لو تعرضتُ لهجومٍ من قبل شيطانٍ يزعم أنّي من عائلته
Dialogue: 0,0:15:32.48,0:15:35.85,Main,,0,0,0,,لكان والدي ليوليني مزيدًا من الاهتمام
Dialogue: 0,0:15:36.73,0:15:41.03,Main,,0,0,0,,هكذا اتخذتْ هذه المشاعر المشينة في قلبي شكلًا
Dialogue: 0,0:15:42.24,0:15:43.30,Main,,0,0,0,,...ذلك الشيطان
Dialogue: 0,0:15:42.00,0:15:44.93,Top,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:15:43.90,0:15:44.82,Main,,0,0,0,,هو أنا
Dialogue: 0,0:15:47.16,0:15:49.53,Main,,0,0,0,,...من يستحق أن يُقطع في الواقع
Dialogue: 0,0:15:49.77,0:15:50.58,Main,,0,0,0,,أنا لا غيري
Dialogue: 0,0:15:50.66,0:15:54.29,Main,,0,0,0,,!من سيُقطَع هو ذلك الشيطان، وليس أنتِ
Dialogue: 0,0:15:54.37,0:15:56.58,Main,,0,0,0,,،حتّى لو كان ذلك الشيطان تجسيدًا لمشاعركِ
Dialogue: 0,0:15:56.67,0:15:58.42,Main,,0,0,0,,فهو لا يُمثلها كلّها
Dialogue: 0,0:15:58.92,0:16:02.85,Main,,0,0,0,,أنا على درايةٍ تامّةٍ بمدى حبّ السيّد لكِ
Dialogue: 0,0:16:03.38,0:16:09.12,Main,,0,0,0,,وفوق ذلك، أنا على يقينٍ بأنّ السيّد... يعتبركِ فردًا من عائلته العزيزة
Dialogue: 0,0:16:12.27,0:16:15.14,Main,,0,0,0,,أنتِ والسيّد على حدٍّ سواء في سوء التعبير عن مشاعركما
Dialogue: 0,0:16:15.77,0:16:17.85,Main,,0,0,0,,،حان الوقت لتُواجِها بعضكما بصدقٍ
Dialogue: 0,0:16:17.94,0:16:21.90,Main,,0,0,0,,وتتبادلا حديثًا نابعًا من القلب كما تفعل أيّ عائلة حقيقيّة
Dialogue: 0,0:16:21.98,0:16:23.23,Main,,0,0,0,,زينجي
Dialogue: 0,0:16:29.95,0:16:31.08,Main,,0,0,0,,!اقطعه
Dialogue: 0,0:16:36.58,0:16:39.08,Main,,0,0,0,,ذلك الشيطان هو مشاعري الداخلية
Dialogue: 0,0:16:39.17,0:16:44.92,Main,,0,0,0,,كنتُ خائفةً من الحقيقة، فظللتُ أتجاهلُ أمورًا عدّة، هذا ما كنتُ عليه حتّى الآن
Dialogue: 0,0:16:45.30,0:16:47.26,Main,,0,0,0,,لكن سأكون مختلفة من الآن فصاعدًا
Dialogue: 0,0:16:47.34,0:16:49.30,Main,,0,0,0,,سأسعى جاهدة لأكون على هذا النحو
Dialogue: 0,0:16:50.39,0:16:51.39,Main,,0,0,0,,لهذا تحديدًا
Dialogue: 0,0:17:02.19,0:17:04.82,Main,,0,0,0,,هل انتهى الأمر؟
Dialogue: 0,0:17:27.38,0:17:28.68,Main,,0,0,0,,كما توقعت
Dialogue: 0,0:17:29.51,0:17:32.89,Main,,0,0,0,,،إن كنت قد وُلدت من مشاعر ناتسو-دونو
Dialogue: 0,0:17:32.97,0:17:36.85,Main,,0,0,0,,فإنَّ وجودك يفقد معناه بمجرد أن تنكرك
Dialogue: 0,0:17:36.93,0:17:38.56,Main,,0,0,0,,...ومع ذلك
Dialogue: 0,0:17:39.27,0:17:43.25,Main,,0,0,0,,ثمّة امرأة أخرى في عائلة سوغايا يمكن أن تصبح شيطانة
Dialogue: 0,0:17:43.90,0:17:46.57,Main,,0,0,0,,قُتلتْ زوجته على يد شيطان
Dialogue: 0,0:17:46.65,0:17:51.49,Main,,0,0,0,,"السبب وراء تكرار هذا الشيطان لعبارة "أعيدوا لي ابنتي
Dialogue: 0,0:17:51.57,0:17:56.54,Main,,0,0,0,,هو وجود مشاعر أخرى إلى جانب مشاعر ناتسو-دونو
Dialogue: 0,0:18:02.46,0:18:05.38,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:18:06.05,0:18:09.63,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:18:10.18,0:18:12.64,Main,,0,0,0,,...بمعنى آخر، ابنة هذه الشيطانة
Dialogue: 0,0:18:12.72,0:18:15.39,Main,,0,0,0,,هي الطفلة الّتي أنجبتها زوجة جوزو
Dialogue: 0,0:18:18.02,0:18:22.40,Main,,0,0,0,,لم يخطر ببالي قطّ أن يجمعني بكِ القدر بهذه الصورة
Dialogue: 0,0:18:23.10,0:18:27.23,Main,,0,0,0,,لأكون صادقًا، لم أعد أتذكّركِ
Dialogue: 0,0:18:27.73,0:18:31.40,Main,,0,0,0,,أود أن أعرف اسمكِ قبل الوداع
Dialogue: 0,0:18:32.03,0:18:35.66,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:18:39.37,0:18:42.04,Main,,0,0,0,,،الجميع يعيشون في الحاضر
Dialogue: 0,0:18:42.75,0:18:45.25,Main,,0,0,0,,ولا يمكن لأحدٍ أن يظل أسيرًا للماضي
Dialogue: 0,0:18:45.92,0:18:46.92,Main,,0,0,0,,...لهذا
Dialogue: 0,0:18:48.42,0:18:50.47,Main,,0,0,0,,أرجو أن ترقدي بسلام
Dialogue: 0,0:18:50.55,0:18:53.59,Main,,0,0,0,,!أعيدوا لي ابنتي
Dialogue: 0,0:18:59.93,0:19:01.33,Main,,0,0,0,,...يا أماه
Dialogue: 0,0:19:07.11,0:19:10.40,Main,,0,0,0,,جينيا، كنتَ خير عونٍ لنا مجدّدًا
Dialogue: 0,0:19:10.49,0:19:12.11,Main,,0,0,0,,هيّا، قولي شيئًا أيّتها الآنسة
Dialogue: 0,0:19:13.99,0:19:16.87,Main,,0,0,0,,إن بقيتِ هكذا، فسيظهر الشيطان مجدّدًا
Dialogue: 0,0:19:16.88,0:19:18.67,Main,,0,0,0,,!حسنٌ، فهمت
Dialogue: 0,0:19:19.91,0:19:21.37,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:19:21.45,0:19:27.09,Main,,0,0,0,,سأحاول تغيير نفسي، بالرغم من أنّه من المُحال التغيّر بين عشيةٍ وضحاها
Dialogue: 0,0:19:28.46,0:19:29.67,Main,,0,0,0,,شكرًا لك
Dialogue: 0,0:19:30.55,0:19:31.63,Main,,0,0,0,,لا داعي لشكري
Dialogue: 0,0:19:31.71,0:19:33.22,Main,,0,0,0,,فقد تلقّيتُ أجري بالفعل
Dialogue: 0,0:19:33.80,0:19:36.01,Main,,0,0,0,,...أديتُ عملي فحسب
Dialogue: 0,0:19:36.39,0:19:37.43,Main,,0,0,0,,كلّا
Dialogue: 0,0:19:37.51,0:19:39.97,Main,,0,0,0,,بل أتيتُ لردّ الدّين
Dialogue: 0,0:19:40.02,0:19:40.89,Main,,0,0,0,,دين؟
Dialogue: 0,0:19:41.22,0:19:44.81,Main,,0,0,0,,العيش لفترةٍ طويلةٍ لا يعني بالضرورة أنّ المرء شخصٌ بالغ
Dialogue: 0,0:19:44.89,0:19:48.36,Main,,0,0,0,,لكن مع مرور السنين تُدرك بعض الأمور
Dialogue: 0,0:19:49.07,0:19:52.61,Main,,0,0,0,,في صغري، اعتقدتُ أنّ كلّ ما أبصرهُ بعيني هو كلّ شيء
Dialogue: 0,0:19:53.11,0:19:54.95,Main,,0,0,0,,كنتُ أعتقد أنّ إيذاء الآخرين كان أمرًا خاطئًا
Dialogue: 0,0:19:55.53,0:20:01.20,Main,,0,0,0,,لكنّي لم أملك النضج الكافي لأتصور وجود أشياء مستترّة
Dialogue: 0,0:20:02.00,0:20:07.21,Main,,0,0,0,,أردتُ أن أسدّد الدّين الّذي تراكم بسبب عدم نضجي حين تخلّيتُ عنهم آنذاك
Dialogue: 0,0:20:08.04,0:20:10.88,Main,,0,0,0,,لا فكرة لدي عمّا تتحدث عنه
Dialogue: 0,0:20:11.34,0:20:15.01,Main,,0,0,0,,الخلاصة هي أنّه من الحكمة أن تحسني إلى والديكِ
Dialogue: 0,0:20:15.09,0:20:17.05,Main,,0,0,0,,!لستُ بحاجةٍ إلى سماع هذا منك
Dialogue: 0,0:20:18.89,0:20:19.89,Main,,0,0,0,,إلى اللقاء
Dialogue: 0,0:20:27.90,0:20:29.15,Main,,0,0,0,,هل رحل؟
Dialogue: 0,0:20:30.32,0:20:31.23,Main,,0,0,0,,أجل
Dialogue: 0,0:20:31.32,0:20:34.24,Main,,0,0,0,,كان عليك أن تخرج لتوديعه يا سيّدي
Dialogue: 0,0:20:34.32,0:20:36.32,Main,,0,0,0,,لم تكن هناك حاجة لذلك
Dialogue: 0,0:20:36.40,0:20:40.58,Main,,0,0,0,,من اللّحظة الأولى الّتي رأيته فيها، كنتُ على يقينٍ بأنّه سينجز الأمر
Dialogue: 0,0:20:40.99,0:20:45.62,Main,,0,0,0,,على حدِّ قول الآنسة، يبدو أنّك تُكنّ لجينيا تقديرًا كبيرًا
Dialogue: 0,0:20:45.91,0:20:47.83,Main,,0,0,0,,هل ثمّة سببٌ معينٌ لذلك؟
Dialogue: 0,0:20:48.12,0:20:49.71,Main,,0,0,0,,لا تطرح أسئلةً غبية
Dialogue: 0,0:20:50.29,0:20:53.00,Main,,0,0,0,,كيف لأبٍ ألّا يميز ابنه
Dialogue: 0,0:20:53.09,0:20:53.74,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:20:53.79,0:20:55.88,Main,,0,0,0,,عُد إلى عملكَ بسرعة
Dialogue: 0,0:20:55.97,0:20:58.38,Main,,0,0,0,,!وإلّا لن أجعلك تتولى المتجر
Dialogue: 0,0:20:58.47,0:21:00.26,Main,,0,0,0,,!اعفني من هذا
Dialogue: 0,0:21:00.35,0:21:02.35,Main,,0,0,0,,حسنٌ إذن، أستأذنكِ أيّتها الآنسة
Dialogue: 0,0:21:03.85,0:21:05.10,Main,,0,0,0,,...المعذرة
Dialogue: 0,0:21:06.10,0:21:08.14,Main,,0,0,0,,...والدي
Dialogue: 0,0:21:08.23,0:21:10.52,Main,,0,0,0,,هل ثمّة أيّ شيءٍ يمكنني المساعدة فيه؟
Dialogue: 0,0:21:11.40,0:21:12.90,Main,,0,0,0,,ما الّذي دهاكِ فجأة؟
Dialogue: 0,0:21:12.98,0:21:17.90,Main,,0,0,0,,لأنّه... أخبرني أحدهم أنّه من الحكمة أن أحسِّن إلى والدَيّ
Dialogue: 0,0:21:23.03,0:21:27.37,Main,,0,0,0,,ليس عليكِ القلق بشأن هذا الأمر
Dialogue: 0,0:21:28.58,0:21:33.38,Main,,0,0,0,,يا بنيتي، أن تعيشي أطول من والديكِ هو أسمى أشكال البرِّ بهما
Dialogue: 0,0:21:34.25,0:21:35.51,Main,,0,0,0,,والدي
Dialogue: 0,0:21:35.84,0:21:39.26,Main,,0,0,0,,هذا وحده يجعلني راضيًا
Dialogue: 0,0:21:43.72,0:21:45.22,Main,,0,0,0,,و-والدي
Dialogue: 0,0:21:45.31,0:21:47.89,Main,,0,0,0,,ومع ذلك، هل ثمّة أيّ شيءٍ يمكنني المساعدة فيه؟
Comment: 0,0:00:00.00,0:00:00.00,Notes,,0,0,0,,
