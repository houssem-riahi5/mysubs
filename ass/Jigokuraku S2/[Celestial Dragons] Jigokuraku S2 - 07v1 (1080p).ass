Dialogue: 0,0:00:18.22,0:00:20.00,Main,,0,0,0,,ستبدأ المعركة الحقيقيّة الآن
Dialogue: 0,0:00:37.77,0:00:39.27,Main,,0,0,0,,يا للأسف
Dialogue: 0,0:00:50.66,0:00:52.36,Main,,0,0,0,,يجدر بنا التراجع في الوقت الراهن
Dialogue: 0,0:00:52.36,0:00:55.12,Main,,0,0,0,,هذا يكفي
Dialogue: 0,0:01:03.38,0:01:04.92,Main,,0,0,0,,لا أنوي الموت
Dialogue: 0,0:01:04.92,0:01:07.81,Main,,0,0,0,,غايتي هي العودة إلى الديار حيًّا
Dialogue: 0,0:01:10.23,0:01:13.97,Main,,0,0,0,,لأحيا وألقى زوجتي
Dialogue: 0,0:01:24.00,0:01:25.51,Main,,0,0,0,,ساغيري؟
Dialogue: 0,0:01:25.51,0:01:27.49,Main,,0,0,0,,لا شيء، لنسرع
Dialogue: 0,0:01:28.54,0:01:32.10,Main,,0,0,0,,علينا بلوغ الإكسير في أسرع وقتٍ ممكن
Dialogue: 0,0:01:32.72,0:01:35.28,Main,,0,0,0,,هذا واجبنا الآن
Dialogue: 0,0:01:35.28,0:01:37.49,Main,,0,0,0,,لا نملك وقتًا للوقوف مكتوفي الأيدي
Dialogue: 0,0:01:42.61,0:01:45.57,Main,,0,0,0,,أجل، سيتدبّر غابيمارو الأمر حتمًا
Dialogue: 0,0:01:47.32,0:01:49.91,Main,,0,0,0,,والآخرون أيضًا
Dialogue: 0,0:03:42.19,0:03:43.88,Main,,0,0,0,,تعال إلى هنا يا توما
Dialogue: 0,0:03:44.83,0:03:47.52,Main,,0,0,0,,أبرمتُ اتفاقًا مع هؤلاء بالفعل
Dialogue: 0,0:03:47.52,0:03:50.21,Main,,0,0,0,,سيمنحوننا الخلود إن انضممنا إليهم
Dialogue: 0,0:03:50.21,0:03:53.21,Main,,0,0,0,,نحن نتكيّف، اصعد إلى هنا
Dialogue: 0,0:03:53.71,0:03:56.47,Main,,0,0,0,,أخي؟ ما الّذي تفعله هنا؟
Dialogue: 0,0:03:56.90,0:04:00.48,Main,,0,0,0,,...كلّا، لا يهمّ السبب، الأهمّ من ذلك
Dialogue: 0,0:04:02.82,0:04:04.06,Main,,0,0,0,,اذهب
Dialogue: 0,0:04:04.25,0:04:05.96,Main,,0,0,0,,أليس هذا شقيقكَ العزيز؟
Dialogue: 0,0:04:06.05,0:04:07.24,Main,,0,0,0,,اذهب إليه فورًا
Dialogue: 0,0:04:07.70,0:04:10.10,Main,,0,0,0,,أم أنّك متردّد بسببنا؟
Dialogue: 0,0:04:10.43,0:04:13.86,Main,,0,0,0,,أأنتَ متأكّد؟ قد نصبح اثنين ضدّ أربعة في أسوأ الحالات
Dialogue: 0,0:04:15.86,0:04:19.83,Main,,0,0,0,,انضمام هذا الضعيف إليهم لن يُحدث فارقًا يُذكر
Dialogue: 0,0:04:20.31,0:04:23.12,Main,,0,0,0,,سأقطعهم جميعًا عن بكرة أبيهم
Dialogue: 0,0:04:23.12,0:04:26.37,Main,,0,0,0,,سمعتَ ما قاله، وداعًا إذن
Dialogue: 0,0:04:36.53,0:04:38.92,Main,,0,0,0,,كان ذلك جليًّا
Dialogue: 0,0:04:38.92,0:04:41.12,Main,,0,0,0,,أكنتَ تمنحه الدفعة الّتي يحتاجها؟
Dialogue: 0,0:04:41.80,0:04:44.64,Main,,0,0,0,,أنتَ عطوفٌ على نحوٍ مفاجئ
Dialogue: 0,0:04:44.64,0:04:46.52,Main,,0,0,0,,لا تُسئ الفهم
Dialogue: 0,0:04:46.98,0:04:51.40,Main,,0,0,0,,السيطرة على عدوٍّ متردّدٍ أسهل من حليفٍ متردّدٍ فحسب
Dialogue: 0,0:04:52.17,0:04:55.02,Main,,0,0,0,,فهمت، لا يسعني إنكار ذلك
Dialogue: 0,0:05:34.45,0:05:35.19,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:05:55.67,0:05:58.35,Main,,0,0,0,,لم تفقد براعتكَ يا توما
Dialogue: 0,0:05:59.90,0:06:02.05,Main,,0,0,0,,أتسخر منّي؟
Dialogue: 0,0:06:04.36,0:06:06.80,Main,,0,0,0,,فكّكَ لضفيرتكَ يعني أنّكَ تكذب
Dialogue: 0,0:06:07.71,0:06:09.60,Main,,0,0,0,,هذه إشارةٌ بديهيّة
Dialogue: 0,0:06:14.23,0:06:16.89,Main,,0,0,0,,عنيتُ تحرّكاتك
Dialogue: 0,0:06:17.30,0:06:19.11,Main,,0,0,0,,تحسّنتْ كثيرًا
Dialogue: 0,0:06:19.79,0:06:24.36,Main,,0,0,0,,غدوتَ رجلًا بحقٍّ، بالكاد تعرّفتُ عليك
Dialogue: 0,0:06:28.92,0:06:31.70,Main,,0,0,0,,أقدّر لكم اعتناءكم بشقيقي
Dialogue: 0,0:06:31.70,0:06:34.25,Main,,0,0,0,,أشكركم على ذلك
Dialogue: 0,0:06:34.25,0:06:36.17,Main,,0,0,0,,شكرًا لكم
Dialogue: 0,0:06:36.17,0:06:40.17,Main,,0,0,0,,هذا عربون تقديري، خذوه
Dialogue: 0,0:06:40.17,0:06:42.48,Main,,0,0,0,,هذا أسوأ من معاداته
Dialogue: 0,0:06:42.48,0:06:43.99,Main,,0,0,0,,أوافقك الرأي
Dialogue: 0,0:06:43.99,0:06:46.05,Main,,0,0,0,,!يا للقسوة
Dialogue: 0,0:06:46.40,0:06:50.06,Main,,0,0,0,,ظننتُ أنّه بوسعنا أن نغدو أصدقاء
Dialogue: 0,0:06:50.50,0:06:53.06,Main,,0,0,0,,أتريدين منّي مواساتكِ؟
Dialogue: 0,0:06:55.08,0:06:56.98,Main,,0,0,0,,لستَ من النوع الّذي يروقني
Dialogue: 0,0:06:58.05,0:07:01.01,Main,,0,0,0,,خيانة، وهجومٌ مباغت
Dialogue: 0,0:07:01.01,0:07:04.45,Main,,0,0,0,,البشرُ مخادعون بحقّ
Dialogue: 0,0:07:04.94,0:07:07.43,Main,,0,0,0,,تجرّأتَ على إيذاء تاوفا
Dialogue: 0,0:07:07.43,0:07:09.70,Main,,0,0,0,,ستدفع ثمن ذلك غاليًا
Dialogue: 0,0:07:09.70,0:07:14.71,Main,,0,0,0,,مخادعون؟ يا لرقيّ ألفاظكم أيّها الخالدون
Dialogue: 0,0:07:14.71,0:07:17.56,Main,,0,0,0,,!نحن قطّاع طرق
Dialogue: 0,0:07:19.43,0:07:22.49,Main,,0,0,0,,!نكذب، ونخدع، ونسلب كلّ شيء
Dialogue: 0,0:07:22.49,0:07:25.38,Main,,0,0,0,,!نحن أشرار إيو؛ الأخوان آزا
Dialogue: 0,0:07:35.25,0:07:37.17,Main,,0,0,0,,الأمر أشبه بما حدث حينها
Dialogue: 0,0:07:48.11,0:07:50.70,Main,,0,0,0,,!ستكون النتيجة ذاتها مهما تكرّر الأمر
Dialogue: 0,0:08:17.43,0:08:19.69,Main,,0,0,0,,سينجوتسو: شظيّة القصدير
Dialogue: 0,0:08:26.91,0:08:28.74,Main,,0,0,0,,كان ذلك وشيكًا
Dialogue: 0,0:08:29.14,0:08:30.68,Main,,0,0,0,,المعذرة
Dialogue: 0,0:08:30.68,0:08:32.75,Main,,0,0,0,,لكنَّ حركاتك متقنةٌ
Dialogue: 0,0:08:33.60,0:08:34.49,Main,,0,0,0,,!أجل
Dialogue: 0,0:08:34.49,0:08:37.62,Main,,0,0,0,,تبرز ندبته حين يشتدّ حماسه
Dialogue: 0,0:08:37.62,0:08:38.97,Main,,0,0,0,,يسهل توقّع أفعاله
Dialogue: 0,0:08:56.18,0:08:58.02,Main,,0,0,0,,...هذان الاثنان
Dialogue: 0,0:09:02.40,0:09:04.79,Main,,0,0,0,,يقاتلان وكأنّهما جسدٌ واحد
Dialogue: 0,0:09:12.02,0:09:15.83,Main,,0,0,0,,أتقن هذا الرجل التاو وبات قادرًا على استشعاره
Dialogue: 0,0:09:16.58,0:09:18.58,Main,,0,0,0,,كما تحسّنتْ قدراته البدنيّة
Dialogue: 0,0:09:19.89,0:09:23.16,Main,,0,0,0,,لكنَّ التغيّر الأعظم طرأ على هذا الرجل
Dialogue: 0,0:09:24.61,0:09:26.69,Main,,0,0,0,,سحقًا للرشاقة
Dialogue: 0,0:09:26.69,0:09:29.34,Main,,0,0,0,,ما تحتاجه للتلويح بالسيف هو رباطة الجأش
Dialogue: 0,0:09:32.98,0:09:36.60,Main,,0,0,0,,أن تكون مستعدًّا لسلب حياة أحدهم بيديك
Dialogue: 0,0:09:41.92,0:09:44.61,Main,,0,0,0,,هذا نقيض ما كان عليه الأمر حينها
Dialogue: 0,0:09:46.86,0:09:48.92,Main,,0,0,0,,إنّهما اثنان في جسدٍ واحد
Dialogue: 0,0:09:48.92,0:09:52.40,Main,,0,0,0,,كلّا، بل اثنان يقاتلان كجسدٍ واحد
Dialogue: 0,0:09:54.55,0:09:55.87,Main,,0,0,0,,الأمر مقزّزٌ
Dialogue: 0,0:09:56.78,0:09:58.99,Main,,0,0,0,,لا أكترث لأمر الطقوس
Dialogue: 0,0:09:58.99,0:10:01.45,Main,,0,0,0,,سأقتلكَ مجدّدًا
Dialogue: 0,0:10:08.95,0:10:11.70,Main,,0,0,0,,قُطع رأسي وكان ذلك مزعجًا بحقّ
Dialogue: 0,0:10:11.70,0:10:14.51,Main,,0,0,0,,لكن يصبح ريين مخيفًا حين نعصي أوامره
Dialogue: 0,0:10:16.89,0:10:19.02,Main,,0,0,0,,لنُنهِ هذا الأمر بسرعة
Dialogue: 0,0:10:19.90,0:10:21.77,Main,,0,0,0,,هلمّا إليّ
Dialogue: 0,0:10:21.77,0:10:23.77,Main,,0,0,0,,!بديع
Dialogue: 0,0:10:23.77,0:10:26.27,Main,,0,0,0,,!مؤخّرةٌ مثيرة، وصدرٌ فاتن
Dialogue: 0,0:10:26.27,0:10:28.57,Main,,0,0,0,,!إنّه تجسيدٌ لامرأةٍ مثاليّة
Dialogue: 0,0:10:29.02,0:10:30.28,Main,,0,0,0,,أوافقك الرأي
Dialogue: 0,0:10:31.27,0:10:35.33,Main,,0,0,0,,،بقدرتها على التجدّد وقوامها الخارق
Dialogue: 0,0:10:35.33,0:10:37.66,Main,,0,0,0,,إنّها تجسيدٌ لخالدةٍ أسطوريّة
Dialogue: 0,0:10:38.89,0:10:40.49,Main,,0,0,0,,!شكرًا لكما
Dialogue: 0,0:10:41.12,0:10:42.23,Main,,0,0,0,,إنّها سريعة
Dialogue: 0,0:10:51.92,0:10:55.30,Main,,0,0,0,,لكنَّ تلقّي المديح منكَ يصيبني بالقشعريرة أيّها العجوز
Dialogue: 0,0:10:56.65,0:10:59.55,Main,,0,0,0,,أنتَ وسيمٌ على نحوٍ مفاجئ
Dialogue: 0,0:11:01.31,0:11:03.68,Main,,0,0,0,,أترغب في ممارسة البوتشوجوتسو معي؟
Dialogue: 0,0:11:03.68,0:11:05.76,Main,,0,0,0,,رغم أنّي سأحوّلك إلى تان في النهاية
Dialogue: 0,0:11:07.91,0:11:10.32,Main,,0,0,0,,...يؤسفني رفض عرضكِ
Dialogue: 0,0:11:10.91,0:11:14.07,Main,,0,0,0,,فجلّ اهتمامي منصبٌّ على ما بداخلكِ فحسب
Dialogue: 0,0:11:14.85,0:11:17.48,Main,,0,0,0,,ما بداخلي؟ يا لكَ من منحرف
Dialogue: 0,0:11:17.48,0:11:19.71,Main,,0,0,0,,سأريكَ إن أردت
Dialogue: 0,0:11:19.82,0:11:21.58,Main,,0,0,0,,لا تتجاهليني
Dialogue: 0,0:11:23.99,0:11:28.71,Main,,0,0,0,,أنتِ مثيرةٌ وقويّة، سيذيع صيتي إن قتلتكِ
Dialogue: 0,0:11:28.71,0:11:31.61,Main,,0,0,0,,أنتِ المرأة المثاليّة بحقّ
Dialogue: 0,0:11:32.22,0:11:34.34,Main,,0,0,0,,امنحيني المزيد من وقتكِ
Dialogue: 0,0:11:36.21,0:11:39.22,Main,,0,0,0,,!حسنٌ، ها أنا ذي
Dialogue: 0,0:12:04.91,0:12:06.04,Main,,0,0,0,,!مُذهل
Dialogue: 0,0:12:06.41,0:12:07.54,Main,,0,0,0,,!أحسنت
Dialogue: 0,0:12:19.18,0:12:23.10,Main,,0,0,0,,!كان ذلك وشيكًا، لكنّكما قويّان حقًّا
Dialogue: 0,0:12:23.99,0:12:27.10,Main,,0,0,0,,!هذا هجوم التاو الخفيّ إذن
Dialogue: 0,0:12:27.60,0:12:30.19,Main,,0,0,0,,لنهاجم مجدّدًا يا أيًّا-كان-إيمون
Dialogue: 0,0:12:32.26,0:12:33.81,Main,,0,0,0,,!إنّه أسايمون
Dialogue: 0,0:12:34.22,0:12:36.26,Main,,0,0,0,,لن نقوى على هزيمتها بهذا المعدّل
Dialogue: 0,0:12:37.87,0:12:43.24,Main,,0,0,0,,لهزيمة التينسين-ساما، علينا تدمير التاندين خاصّتهم بتاو مضادّ
Dialogue: 0,0:12:43.24,0:12:46.73,Main,,0,0,0,,،لكن على نقيض غابيمارو والآخرين
Dialogue: 0,0:12:46.73,0:12:50.59,Main,,0,0,0,,ما زلنا عاجزين عن استخدام التاو كما ينبغي
Dialogue: 0,0:13:05.39,0:13:10.74,Main,,0,0,0,,حسنٌ، حان الوقت أخيرًا لطقس الهيكي... جي؟ فوكوشو؟
Dialogue: 0,0:13:10.80,0:13:12.56,Main,,0,0,0,,!طقس الهيكيجي فوكوشو
Dialogue: 0,0:13:12.75,0:13:14.66,Main,,0,0,0,,!أليس كذلك؟ قلتها
Dialogue: 0,0:13:15.01,0:13:17.03,Main,,0,0,0,,...قرابين هذه المرّة هما
Dialogue: 0,0:13:17.40,0:13:22.66,Main,,0,0,0,,هذا الرجل الشديد القوّة، وذلك الفتى الصغير الفائق السرعة
Dialogue: 0,0:13:25.16,0:13:26.47,Main,,0,0,0,,كما توقّعت
Dialogue: 0,0:13:28.84,0:13:31.76,Main,,0,0,0,,لا تُبصر العيون التاو
Dialogue: 0,0:13:32.50,0:13:35.40,Main,,0,0,0,,،بما أنّنا سنخوض معارك تعتمد على التاو
Dialogue: 0,0:13:35.40,0:13:38.94,Main,,0,0,0,,علينا تعلّم استشعاره أولًا
Dialogue: 0,0:13:39.43,0:13:40.34,Main,,0,0,0,,...والآن
Dialogue: 0,0:13:43.97,0:13:47.35,Main,,0,0,0,,هل يمكنكما استشعار التاو خاصّتي؟
Dialogue: 0,0:13:47.35,0:13:48.38,Main,,0,0,0,,كلّا
Dialogue: 0,0:13:56.45,0:14:01.15,Main,,0,0,0,,يستحيل صدّ هجمات التاو لكونها خفيّة
Dialogue: 0,0:14:02.72,0:14:04.24,Main,,0,0,0,,...تلك التينسين-ساما
Dialogue: 0,0:14:04.50,0:14:07.71,Main,,0,0,0,,أظنّ أنَّ اسمها تاوفا، وعنصرها هو الخشب
Dialogue: 0,0:14:07.71,0:14:12.12,Main,,0,0,0,,يضادّ عنصري المعدنيّ عنصرها، لذا الأفضليّة لنا
Dialogue: 0,0:14:12.12,0:14:15.85,Main,,0,0,0,,لكنَّ تأثيره سيكون ضعيفًا لعجزي عن التحكّم به
Dialogue: 0,0:14:15.85,0:14:17.60,Main,,0,0,0,,علينا تدبير خطّةٍ ما
Dialogue: 0,0:14:17.60,0:14:18.88,Main,,0,0,0,,!اصمت
Dialogue: 0,0:14:18.88,0:14:22.37,Main,,0,0,0,,إيّاكَ وذكر التاو أمامي مجدّدًا
Dialogue: 0,0:14:22.37,0:14:24.89,Main,,0,0,0,,تعلّمه معقّدٌ للغاية
Dialogue: 0,0:14:25.63,0:14:29.39,Main,,0,0,0,,بدأ الأمر يغدو ممتعًا للتو، فلا تفسده
Dialogue: 0,0:14:30.01,0:14:31.27,Main,,0,0,0,,ممتع؟
Dialogue: 0,0:14:36.14,0:14:37.98,Main,,0,0,0,,التاو مهمٌّ للغاية
Dialogue: 0,0:14:37.98,0:14:40.07,Main,,0,0,0,,فهو يتيح لك قراءة حركات خصمكَ
Dialogue: 0,0:14:41.38,0:14:45.03,Main,,0,0,0,,فهمت، إنّها تتفوّق على الدوشي بمراحل
Dialogue: 0,0:14:54.41,0:14:56.33,Main,,0,0,0,,كما أنّه يتّجه حيثما تشاء
Dialogue: 0,0:15:00.53,0:15:03.09,Main,,0,0,0,,أرأيت؟ أليس عمليًّا؟
Dialogue: 0,0:15:04.60,0:15:06.57,Main,,0,0,0,,لِمَ لا تستسلمان فحسب؟
Dialogue: 0,0:15:06.57,0:15:08.91,Main,,0,0,0,,لن تقويا على هزيمتي دون التاو
Dialogue: 0,0:15:08.91,0:15:12.10,Main,,0,0,0,,سيسعدني أن تكفّا عن المقاومة وتدعاني أحوّلكما إلى تان
Dialogue: 0,0:15:13.11,0:15:14.60,Main,,0,0,0,,لم ننتهِ بعد
Dialogue: 0,0:15:14.60,0:15:17.26,Main,,0,0,0,,ألستِ تستمتعين أيضًا؟
Dialogue: 0,0:15:17.86,0:15:21.61,Main,,0,0,0,,ففي النهاية، أمضيتِ ألف عامٍ في تعذيب البشر
Dialogue: 0,0:15:26.74,0:15:30.24,Main,,0,0,0,,لا متعة في هذا إطلاقًا
Dialogue: 0,0:15:31.12,0:15:33.75,Main,,0,0,0,,نُمضي وقتنا كلّه في التدرّب على الخلود هنا
Dialogue: 0,0:15:34.88,0:15:37.77,Main,,0,0,0,,ونستدرج البشر لنتغذّى عليهم
Dialogue: 0,0:15:38.39,0:15:40.25,Main,,0,0,0,,ونكرّر ذلك مرارًا وتكرارًا
Dialogue: 0,0:15:40.75,0:15:42.75,Main,,0,0,0,,،فعلنا ذلك لألف عامٍ
Dialogue: 0,0:15:43.37,0:15:45.93,Main,,0,0,0,,لكنّي أشكّ في بلوغنا الخلود المثاليّ
Dialogue: 0,0:15:46.27,0:15:49.62,Main,,0,0,0,,حتّى لو واصلنا لألف عامٍ آخر
Dialogue: 0,0:15:52.45,0:15:55.76,Main,,0,0,0,,أدرك مودان ذلك، وحتّى جوفا
Dialogue: 0,0:15:56.25,0:15:58.31,Main,,0,0,0,,بل الجميع أدرك ذلك
Dialogue: 0,0:15:59.27,0:16:02.21,Main,,0,0,0,,سأفقد صوابي إن لم أضحك
Dialogue: 0,0:16:03.71,0:16:07.53,Main,,0,0,0,,أو لعلّي أضحك لأنّي فقدتُ صوابي بالفعل
Dialogue: 0,0:16:12.37,0:16:15.11,Main,,0,0,0,,لا أجد متعةً في هذا إطلاقًا
Dialogue: 0,0:16:22.68,0:16:25.78,Main,,0,0,0,,لم أدرك أنَّ التاو بهذه القوّة
Dialogue: 0,0:16:27.56,0:16:28.93,Main,,0,0,0,,هل استسلمتما؟
Dialogue: 0,0:16:28.93,0:16:32.67,Main,,0,0,0,,أظنّ أنَّ الموت السريع أفضل من الموت البطيء
Dialogue: 0,0:16:34.60,0:16:37.21,Main,,0,0,0,,هذا اكتشافٌ مذهل
Dialogue: 0,0:16:37.21,0:16:39.89,Main,,0,0,0,,مرحلةٌ جديدةٌ في دراسة الحياة
Dialogue: 0,0:16:39.89,0:16:42.44,Main,,0,0,0,,والأروع من ذلك أنّه يسعني لمسه
Dialogue: 0,0:16:42.44,0:16:45.15,Main,,0,0,0,,كأنّنا اكتسبنا عضوًا جديدًا
Dialogue: 0,0:16:46.07,0:16:48.25,Main,,0,0,0,,عليَّ العودة بهذه المعرفة إلى الديار
Dialogue: 0,0:16:48.25,0:16:50.57,Main,,0,0,0,,ستُحدث ثورةً في كلّ ما نعرفه عن الطبّ
Dialogue: 0,0:16:50.91,0:16:53.25,Main,,0,0,0,,...ظننتُ أنّني درستُ الكثير، ولكن
Dialogue: 0,0:16:53.25,0:16:56.08,Main,,0,0,0,,ما زالت هناك مجالاتٌ أخرى للبحث فيها
Dialogue: 0,0:16:56.48,0:16:59.58,Main,,0,0,0,,ألم أطلب منك ألّا تفسد المتعة؟
Dialogue: 0,0:17:00.42,0:17:04.84,Main,,0,0,0,,لا شيء يضاهي متعة اللعب بدميةٍ جديدة
Dialogue: 0,0:17:04.84,0:17:07.07,Main,,0,0,0,,أشعر وكأنّنا نحن الدمية هنا
Dialogue: 0,0:17:07.07,0:17:08.34,Main,,0,0,0,,!اخرس
Dialogue: 0,0:17:09.59,0:17:12.63,Main,,0,0,0,,تبدوان مستمتعين حقًّا
Dialogue: 0,0:17:14.84,0:17:16.56,Main,,0,0,0,,يا لحظّكما
Dialogue: 0,0:17:19.88,0:17:22.60,Main,,0,0,0,,لا بُدَّ أنّكما مختلّان عقليًّا
Dialogue: 0,0:17:22.60,0:17:24.48,Main,,0,0,0,,!وأنتِ كذلك
Dialogue: 0,0:17:24.48,0:17:26.98,Main,,0,0,0,,!الاندفاع وحده ليس فنًّا
Dialogue: 0,0:17:31.26,0:17:36.08,Main,,0,0,0,,ما هذا... الشعور؟
Dialogue: 0,0:17:48.51,0:17:51.01,Main,,0,0,0,,!تفادى التاو
Dialogue: 0,0:17:51.01,0:17:55.35,Main,,0,0,0,,فهمت، أدركتُ ماهيّة التاو الآن
Dialogue: 0,0:17:58.01,0:18:01.61,Main,,0,0,0,,لا يمكنكَ رؤيته إطلاقًا، أكانت تلك ضربة حظٍّ؟
Dialogue: 0,0:18:05.45,0:18:08.33,Main,,0,0,0,,لعلَّ صغر سنّ نوروغاي له دورٌ في ذلك
Dialogue: 0,0:18:08.88,0:18:11.50,Main,,0,0,0,,...أظنّ أنَّ سبب عجزكما عن التحكّم بالتاو يعود إلى
Dialogue: 0,0:18:11.50,0:18:14.26,Main,,0,0,0,,!حسنٌ، لا أعرف كيف أصف ذلك
Dialogue: 0,0:18:14.78,0:18:16.78,Main,,0,0,0,,عقولكما متحجّرة
Dialogue: 0,0:18:17.22,0:18:21.10,Main,,0,0,0,,أنتما لا تؤمنان بما لا تُبصره أعينكما، أليس كذلك؟
Dialogue: 0,0:18:21.79,0:18:24.29,Main,,0,0,0,,لا يمكن التحكّم بالتاو بالعقل
Dialogue: 0,0:18:24.29,0:18:28.67,Main,,0,0,0,,عليكما الانفصال عن الواقع وإطلاق العنان لحواسّكما
Dialogue: 0,0:18:29.14,0:18:31.54,Main,,0,0,0,,هيّا، ابذلا جهدًا أكبر قليلًا
Dialogue: 0,0:18:31.54,0:18:32.75,Main,,0,0,0,,لستُ مهتمًّا
Dialogue: 0,0:18:32.75,0:18:35.41,Main,,0,0,0,,لن أضيّع وقتي على ما أعجز عن فعله
Dialogue: 0,0:18:35.41,0:18:38.30,Main,,0,0,0,,لا أؤمن إلّا بما يسعني قطعه
Dialogue: 0,0:18:38.30,0:18:40.80,Main,,0,0,0,,لا يسعني الإيمان بما لا أستطيع لمسه
Dialogue: 0,0:18:41.16,0:18:44.52,Main,,0,0,0,,عليَّ أن أشرّحه، وأستخرجه، وألمسه بنفسي
Dialogue: 0,0:18:44.52,0:18:46.19,Main,,0,0,0,,عمَّ تتحدّث؟
Dialogue: 0,0:18:46.19,0:18:48.98,Main,,0,0,0,,لسنا أصدقاءَ في النهاية
Dialogue: 0,0:18:48.98,0:18:51.48,Main,,0,0,0,,كلٌّ منّا حرٌّ في أفعاله
Dialogue: 0,0:18:56.02,0:18:57.07,Main,,0,0,0,,وداعًا
Dialogue: 0,0:19:06.16,0:19:09.00,Main,,0,0,0,,فهمتُ قصدكَ يا تشيبي-إيمون
Dialogue: 0,0:19:09.30,0:19:10.92,Main,,0,0,0,,إنّه مجرّد حلٍّ مؤقّت
Dialogue: 0,0:19:10.92,0:19:12.93,Main,,0,0,0,,الأهمّ من ذلك، راقبني عن كثب
Dialogue: 0,0:19:12.93,0:19:14.87,Main,,0,0,0,,...إن تمكّنتَ من استشعار التاو
Dialogue: 0,0:19:16.22,0:19:18.80,Main,,0,0,0,,!فستسنح لنا فرصةٌ لشنّ هجومٍ مضادّ
Dialogue: 0,0:19:25.19,0:19:27.92,Main,,0,0,0,,لا يمكنكَ المراوغة من مسافةٍ قريبة، أليس كذلك؟
Dialogue: 0,0:19:46.19,0:19:49.13,Main,,0,0,0,,أستواصل تلقّي الضربات هكذا؟
Dialogue: 0,0:19:49.13,0:19:51.88,Main,,0,0,0,,ليتسنّى له مراقبة التاو خاصّتي؟
Dialogue: 0,0:19:52.68,0:19:55.38,Main,,0,0,0,,يا لوفائك لرفيقك، هذا رائع
Dialogue: 0,0:19:55.86,0:19:59.14,Main,,0,0,0,,!لسنا رفيقين
Dialogue: 0,0:20:00.16,0:20:05.52,Main,,0,0,0,,لسنا رفيقين، لكنّي أظنّ أنّنا أقرب لذلك
Dialogue: 0,0:20:06.01,0:20:09.27,Main,,0,0,0,,أنا مجرمٌ محكومٌ بالإعدام، أواثقٌ من كلامك؟
Dialogue: 0,0:20:09.27,0:20:13.26,Main,,0,0,0,,أنتَ تعتني بالآخرين جيّدًا، كما فعلتَ مع توما
Dialogue: 0,0:20:14.22,0:20:16.15,Main,,0,0,0,,،أدركُ مكانة كلٍّ منّا
Dialogue: 0,0:20:16.15,0:20:19.66,Main,,0,0,0,,ولا أنوي التغاضي عن جرائمك الّتي اقترفتها
Dialogue: 0,0:20:21.33,0:20:24.16,Main,,0,0,0,,لكنّي تعرّفتُ عليك
Dialogue: 0,0:20:25.49,0:20:27.16,Main,,0,0,0,,فالمجرمون المحكومون بالإعدام بشرٌ أيضًا
Dialogue: 0,0:20:28.16,0:20:30.67,Main,,0,0,0,,ومعاشرتهم تولّد التعاطف
Dialogue: 0,0:20:32.17,0:20:36.67,Main,,0,0,0,,،في هذا الوقت القصير والعصيب، فتحنا قلوبنا
Dialogue: 0,0:20:36.67,0:20:39.60,Main,,0,0,0,,واستخرجنا ما بداخله، ولمسناه
Dialogue: 0,0:20:40.43,0:20:42.74,Main,,0,0,0,,وما دمتُ قادرًا على لمسه، فالأمر بسيط
Dialogue: 0,0:20:42.74,0:20:44.93,Main,,0,0,0,,الساموراي والمجرمون سواسية
Dialogue: 0,0:20:45.51,0:20:47.26,Main,,0,0,0,,...لدينا دمٌ، ولحمٌ، وعظام
Dialogue: 0,0:20:47.68,0:20:50.44,Main,,0,0,0,,ورغبةٌ في الحياة
Dialogue: 0,0:20:50.44,0:20:52.31,Main,,0,0,0,,الأمر أشبه بالتشريح
Dialogue: 0,0:20:54.65,0:20:57.29,Main,,0,0,0,,تشبيهكَ مزعجٌ للغاية، لم أستوعبه
Dialogue: 0,0:20:59.35,0:21:00.96,Main,,0,0,0,,لن أكرّره مجدّدًا إذن
Dialogue: 0,0:21:03.81,0:21:10.21,Main,,0,0,0,,لن أقول مجدّدًا إنَّ غايتي الحقيقيّة هي عودتنا جميعًا أحياء
Dialogue: 0,0:21:14.71,0:21:17.96,Main,,0,0,0,,إن لم تكونوا رفاقًا، فلا داعي للحزن إذن
Dialogue: 0,0:21:22.01,0:21:24.46,Main,,0,0,0,,...لا أرى شيئًا، لكن
Dialogue: 0,0:21:25.18,0:21:27.97,Main,,0,0,0,,يسعني استشعار ذلك، الفتى الصغير في ورطة
Dialogue: 0,0:21:28.18,0:21:31.98,Main,,0,0,0,,عليكما الانفصال عن الواقع وإطلاق العنان لحواسّكما
Dialogue: 0,0:21:45.56,0:21:49.03,Main,,0,0,0,,...تمكّنتُ من استشعار التاو خاصّتها حينها
Dialogue: 0,0:21:49.75,0:21:52.24,Main,,0,0,0,,لأنَّ الدماء شوّشتْ رؤيتي في إحدى عينيّ
Dialogue: 0,0:21:54.00,0:21:57.38,Main,,0,0,0,,اعتمدتُ على حواسّي لعجزي عن الرؤية حينها
Dialogue: 0,0:22:00.76,0:22:04.76,Main,,0,0,0,,فقأتُ إحداهما، والأخرى مشوّشة
Dialogue: 0,0:22:05.29,0:22:08.26,Main,,0,0,0,,فهمت، لا أرى شيئًا
Dialogue: 0,0:22:09.05,0:22:12.81,Main,,0,0,0,,لكنّي أستشعره بوضوحٍ الآن
Dialogue: 0,0:22:23.40,0:22:24.90,Main,,0,0,0,,تفاداه مجدّدًا
Dialogue: 0,0:22:24.90,0:22:26.66,Main,,0,0,0,,...مذهل يا غانتيتسو
Dialogue: 0,0:22:33.89,0:22:36.48,Main,,0,0,0,,أنتِ امرأةٌ مذهلةٌ بحقّ
Dialogue: 0,0:22:36.48,0:22:38.00,Main,,0,0,0,,لكِ جزيل الشكر
Dialogue: 0,0:22:40.96,0:22:46.44,Main,,0,0,0,,!إنّه يزداد حدّةً وصلابةً وقوّةً كلّما حُمّي وطُرق
Dialogue: 0,0:22:46.89,0:22:48.14,Main,,0,0,0,,القضيب؟
Dialogue: 0,0:22:48.14,0:22:49.39,Main,,0,0,0,,سيف؟
Dialogue: 0,0:22:50.56,0:22:53.89,Main,,0,0,0,,!بدأ الأمر يغدو مثيرًا للاهتمام
Comment: 0,0:22:52.25,0:22:52.25,Note,,0,0,0,,
