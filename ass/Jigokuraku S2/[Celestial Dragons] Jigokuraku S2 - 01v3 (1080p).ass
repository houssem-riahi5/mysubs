Dialogue: 0,0:00:21.20,0:00:22.88,Main,,0,0,0,,...شينسينكيو
Dialogue: 0,0:00:22.88,0:00:25.95,Main,,0,0,0,,أنتَ الوحيد الّذي عاد من تلك الجزيرة
Dialogue: 0,0:00:26.22,0:00:28.88,Main,,0,0,0,,اشرح لنا ما حدث بالتفصيل
Dialogue: 0,0:00:29.14,0:00:31.18,Main,,0,0,0,,يامادا أسايمون جيكا
Dialogue: 0,0:00:32.58,0:00:34.76,Main,,0,0,0,,حسنٌ، حسنٌ، التفاصيل إذن
Dialogue: 0,0:00:34.82,0:00:37.04,Main,,0,0,0,,رغم أنّي لا أظن أنَّ الأمر سيُحدث فارقًا
Dialogue: 0,0:00:37.77,0:00:39.84,Main,,0,0,0,,هل يمكنني إراحة ساقي؟
Dialogue: 0,0:00:40.62,0:00:41.69,Main,,0,0,0,,لا؟
Dialogue: 0,0:00:42.14,0:00:43.22,Main,,0,0,0,,حسنٌ، حسنٌ
Dialogue: 0,0:00:43.68,0:00:47.15,Main,,0,0,0,,حسنٌ، من أين أبدأ يا ترى؟
Dialogue: 0,0:00:47.76,0:00:52.65,Main,,0,0,0,,...سعيًا للحصول على إكسير الحياة بأمرٍ من الشوغون
Dialogue: 0,0:00:52.97,0:00:58.93,Main,,0,0,0,,توجهنا نحن عشيرة يامادا أسايمون والمجرمون إلى شينسينكيو قبل يومين
Dialogue: 0,0:00:59.46,0:01:03.17,Main,,0,0,0,,كنتُ مسؤولًا عن هوروبو؛ قاتلُ الرهبان
Dialogue: 0,0:01:03.61,0:01:08.62,Main,,0,0,0,,...قتله آزا تشوبي على متن القارب قبل أن نرسو
Dialogue: 0,0:01:09.15,0:01:12.31,Main,,0,0,0,,...وبينما كنت أرتجف قهرًا لعجزي عن إتمام واجبي
Dialogue: 0,0:01:12.31,0:01:14.30,Main,,0,0,0,,...عدتُ أدراجي مكرهًا
Dialogue: 0,0:01:14.71,0:01:17.31,Main,,0,0,0,,لكن جرفني التيار ورسوتُ في النهاية
Dialogue: 0,0:01:17.39,0:01:20.26,Main,,0,0,0,,مهلًا، هل نزلتَ على الجزيرة؟
Dialogue: 0,0:01:20.32,0:01:22.02,Main,,0,0,0,,أجل، نوعًا ما
Dialogue: 0,0:01:22.33,0:01:25.52,Main,,0,0,0,,!يُفترض أنَّ ستين شخصًا فُقدوا هناك
Dialogue: 0,0:01:25.92,0:01:29.59,Main,,0,0,0,,...احترتُ في إكمال المهمّة، ولكن
Dialogue: 0,0:01:29.89,0:01:33.57,Main,,0,0,0,,...شعرتُ بوجوب إبلاغ ذوي المجرمين بمصيرهم
Dialogue: 0,0:01:33.80,0:01:35.47,Main,,0,0,0,,وحدث ما حدث ثمَّ عُدت
Dialogue: 0,0:01:35.48,0:01:38.58,Main,,0,0,0,,مهلًا مهلًا، اشرح "حدث ما حدث" هذه؟
Dialogue: 0,0:01:38.86,0:01:42.12,Main,,0,0,0,,لا طائل من الشرح
Dialogue: 0,0:01:42.33,0:01:44.96,Main,,0,0,0,,الأفضل ألّا تقربوا تلك الجزيرة مجدّدًا
Dialogue: 0,0:01:45.40,0:01:48.59,Main,,0,0,0,,فهي ليست جزيرةً من هذا العالم
Dialogue: 0,0:01:48.80,0:01:51.54,Main,,0,0,0,,أأحمقٌ من ينكش عش الدبابير أم طفل؟
Dialogue: 0,0:01:51.58,0:01:56.08,Main,,0,0,0,,!أ-أيّها الوغد، أتلمح إلى أنَّ الحكومة حمقاء؟
Dialogue: 0,0:01:56.08,0:01:57.88,Main,,0,0,0,,...لا، بل
Dialogue: 0,0:01:58.23,0:01:59.68,Main,,0,0,0,,أعتذر بشدة
Dialogue: 0,0:02:00.56,0:02:03.35,Main,,0,0,0,,إنّه رجلٌ فظٌّ نعجز عن التعامل معه
Dialogue: 0,0:02:04.20,0:02:08.47,Main,,0,0,0,,تقع المسؤوليّة على عاتق عشيرة يامادا، وأنا بصفتي المدرب الحالي
Dialogue: 0,0:02:08.97,0:02:10.35,Main,,0,0,0,,أرجو أن تتقبلوا اعتذاري
Dialogue: 0,0:02:11.46,0:02:13.11,Main,,0,0,0,,أتظن أنَّ اعتذارًا واحدًا يكفي؟
Dialogue: 0,0:02:12.32,0:02:13.11,Top,,0,0,0,,!أنت
Dialogue: 0,0:02:13.19,0:02:16.78,Main,,0,0,0,,ماذا؟ لا داعي لإظهار الاحترام للأسايمون
Dialogue: 0,0:02:16.78,0:02:17.87,Main,,0,0,0,,ألا تعلم؟
Dialogue: 0,0:02:18.30,0:02:19.99,Main,,0,0,0,,...إنّه من تلك الحادثة
Dialogue: 0,0:02:22.01,0:02:25.61,Main,,0,0,0,,حـ-حسنٌ، لا بُدَّ أنّك منهكٌ من رحلة العودة
Dialogue: 0,0:02:25.96,0:02:28.69,Main,,0,0,0,,سنغضّ الطرف عن سلوكك غير المهذب
Dialogue: 0,0:02:30.52,0:02:34.52,Main,,0,0,0,,سأقرأ الآن الرسالة الّتي سلمني إيّاها الشوغون
Dialogue: 0,0:02:34.91,0:02:36.25,Main,,0,0,0,,أنصت جيّدًا
Dialogue: 0,0:02:36.82,0:02:43.10,Main,,0,0,0,,تُؤمر عائلة يامادا بالعودة إلى شينسينكيو لمراقبة من نزلوا عليها
Dialogue: 0,0:02:43.41,0:02:45.73,Main,,0,0,0,,اختاروا أنسب الأعضاء لهذه المهمّة
Dialogue: 0,0:02:45.86,0:02:48.19,Main,,0,0,0,,يامادا أسايمون شوغين
Dialogue: 0,0:04:22.29,0:04:24.60,Top,,0,0,0,,نحن الساموراي مجرد بيادق في النهاية
Dialogue: 0,0:04:24.73,0:04:28.75,Top,,0,0,0,,نحنُ حيواتٌ يُسمح بهدرها مهما فعلنا
Dialogue: 0,0:04:29.03,0:04:30.32,Main,,0,0,0,,!جيكا-دونو
Dialogue: 0,0:04:30.75,0:04:35.13,Main,,0,0,0,,كان موقفك أمام كبار المسؤولين مبالغًا فيه
Dialogue: 0,0:04:36.51,0:04:39.38,Main,,0,0,0,,ظننتُكَ ستتدبر الأمر
Dialogue: 0,0:04:39.55,0:04:41.54,Main,,0,0,0,,وقد فعلت، أليس كذلك؟
Dialogue: 0,0:04:42.26,0:04:44.74,Main,,0,0,0,,حتّى أنا لا يسعني التغاضي عن تصرفاتك
Dialogue: 0,0:04:45.04,0:04:49.13,Main,,0,0,0,,تحلَّ بآداب الساموراي ولو كنتَ أخي الأكبر
Dialogue: 0,0:04:50.51,0:04:53.02,Main,,0,0,0,,حقًّا؟ أعتذر إذن
Dialogue: 0,0:04:54.11,0:04:56.42,Main,,0,0,0,,أنا أنوب عن إيزين-دونو حاليًّا
Dialogue: 0,0:04:57.46,0:04:59.72,Main,,0,0,0,,ولا يسعني تدنيس منصبه في غيابه
Dialogue: 0,0:05:01.08,0:05:02.97,Main,,0,0,0,,يا للإخلاص
Dialogue: 0,0:05:03.23,0:05:07.79,Main,,0,0,0,,ولكن بخصوص التعزيزات، هل بقي مجرمون صالحون للاستخدام؟
Dialogue: 0,0:05:08.07,0:05:12.46,Main,,0,0,0,,يبدو أنّهم سيرسلون شينوبي قرية إيواغاكوري إلى الجزيرة تاليًّا
Dialogue: 0,0:05:16.29,0:05:19.18,Main,,0,0,0,,...نتيجةً لإعادة فرز من سيرسلون إلى الجزيرة
Dialogue: 0,0:05:19.51,0:05:23.72,Main,,0,0,0,,قيل إنَّ شينوبي قرية إيواغاكوري قتلوا كلّ المرشحين من المجرمين
Dialogue: 0,0:05:24.29,0:05:28.68,Main,,0,0,0,,سُرَّ الشوغون بذلك واختار أربعة شينوبي من الحاضرين
Dialogue: 0,0:05:29.84,0:05:34.67,Main,,0,0,0,,بصفتي زعيم إيواغاكوري، يسعدني التعاون مع الشوغون
Dialogue: 0,0:05:35.08,0:05:39.49,Main,,0,0,0,,نسيتُ شيئًا على تلك الجزيرة أيضًا
Dialogue: 0,0:05:40.14,0:05:44.95,Main,,0,0,0,,كان الاعتماد على المجرمين مزحةً ثقيلةً مُنذ البداية
Dialogue: 0,0:05:45.22,0:05:46.73,Main,,0,0,0,,ستكون ضمن التعزيزات أيضًا يا جيكا-دونو
Dialogue: 0,0:05:47.01,0:05:49.31,Main,,0,0,0,,ستذهب إلى الجزيرة بعد بضعة أيام
Dialogue: 0,0:05:50.95,0:05:52.03,Main,,0,0,0,,!مستحيل
Dialogue: 0,0:05:52.40,0:05:55.00,Main,,0,0,0,,لا أريد التورط في هذا
Dialogue: 0,0:05:55.18,0:05:56.39,Main,,0,0,0,,...جيكا-دونو
Dialogue: 0,0:05:59.72,0:06:05.47,Main,,0,0,0,,قال إيزين-دونو إنّه سيرسل تقريرًا في اليوم الثاني مهما كلف الأمر
Dialogue: 0,0:06:05.98,0:06:07.89,Main,,0,0,0,,ونحن في اليوم الثالث الآن
Dialogue: 0,0:06:08.47,0:06:10.10,Main,,0,0,0,,الأمر لا يقتصر على إيزين-دونو فحسب
Dialogue: 0,0:06:10.52,0:06:13.90,Main,,0,0,0,,هل تينزا وكيشو، وساغيري والآخرون بخير يا ترى؟
Dialogue: 0,0:06:14.40,0:06:19.53,Main,,0,0,0,,أجد الانتظار أمرًا لا يُطاق حين أفكر في سلامتهم
Dialogue: 0,0:06:19.93,0:06:23.28,Main,,0,0,0,,أجل، هذا مُقلق
Dialogue: 0,0:06:23.69,0:06:24.70,Main,,0,0,0,,...ولهذا
Dialogue: 0,0:06:25.56,0:06:29.58,Main,,0,0,0,,سنذهب إلى الجزيرة وننهي المهمّة بسرعة
Dialogue: 0,0:06:29.19,0:06:30.51,Top,,0,0,0,,...مـ-معذرةً
Dialogue: 0,0:06:31.52,0:06:32.91,Main,,0,0,0,,...سيّدي الساموراي
Dialogue: 0,0:06:33.15,0:06:35.17,Main,,0,0,0,,ماذا نفعل بهذا؟
Dialogue: 0,0:06:35.17,0:06:37.49,Main,,0,0,0,,هذا الشيء؟
Dialogue: 0,0:06:38.63,0:06:44.71,Main,,0,0,0,,ظننتُ أنَّ كبار المسؤولين سيقتنعون بخطورة الجزيرة لو أريتهم إياه
Dialogue: 0,0:06:45.05,0:06:51.06,Main,,0,0,0,,لكن لم تسنح لي الفرصة لعرضه في النهاية
Dialogue: 0,0:06:51.38,0:06:56.09,Main,,0,0,0,,جعلتكم تسحبونه وتثبتونه بلا طائل
Dialogue: 0,0:06:57.78,0:06:59.55,Main,,0,0,0,,آسف، آسف
Dialogue: 0,0:06:59.65,0:07:02.06,Main,,0,0,0,,سآخذك إلى حيّ المتعة في وقتٍ لاحق
Dialogue: 0,0:07:02.71,0:07:06.34,Main,,0,0,0,,أم تفضّل المجيء إلى مخدعي؟
Dialogue: 0,0:07:06.56,0:07:07.95,Main,,0,0,0,,كلاهما يناسبني
Dialogue: 0,0:07:07.95,0:07:09.28,Main,,0,0,0,,...في الواقع
Dialogue: 0,0:07:09.91,0:07:11.97,Main,,0,0,0,,!لا تلمس ذلك يا سيّدي الساموراي
Dialogue: 0,0:07:12.08,0:07:14.37,Main,,0,0,0,,!قد تكون المجسات حيّة
Dialogue: 0,0:07:14.47,0:07:16.87,Main,,0,0,0,,كلّا، إنّها ميتة بالفعل
Dialogue: 0,0:07:17.34,0:07:18.95,Main,,0,0,0,,لا أشعر بموجات حياته
Dialogue: 0,0:07:19.96,0:07:22.03,Main,,0,0,0,,لنذهب يا جيكا-دونو
Dialogue: 0,0:07:22.84,0:07:25.80,Main,,0,0,0,,موجات حياته؟
Dialogue: 0,0:07:27.41,0:07:28.59,Main,,0,0,0,,أطلنا عليكما
Dialogue: 0,0:07:29.07,0:07:30.99,Main,,0,0,0,,انتهينا من تقديم تقريرنا لكبار المسؤولين
Dialogue: 0,0:07:31.43,0:07:34.10,Main,,0,0,0,,سنذهب نحن الأربعة إلى الجزيرة كما هو مخطط
Dialogue: 0,0:07:34.44,0:07:36.73,Main,,0,0,0,,اختيرنا لقوتنا فحسب هذه المرّة
Dialogue: 0,0:07:37.41,0:07:38.63,Main,,0,0,0,,أنتَ قادمٌ معنا أيضًا يا جيكا-دونو
Dialogue: 0,0:07:38.69,0:07:42.23,Main,,0,0,0,,عجبًا، لا أذكر أنّي وافقتُ على ذلك
Dialogue: 0,0:07:42.54,0:07:46.45,Main,,0,0,0,,سننطلق فورًا... إلى شينسينكيو
Dialogue: 0,0:07:49.47,0:07:51.68,Main,,0,0,0,,التاو هو الحياة ذاتها
Dialogue: 0,0:07:52.28,0:07:56.95,Main,,0,0,0,,استخدامه يعني استهلاك الحياة ذاتها
Dialogue: 0,0:07:57.38,0:08:03.64,Main,,0,0,0,,الإفراط في استخدامه يؤثر على الجسد أو الروح
Dialogue: 0,0:08:04.22,0:08:06.76,Main,,0,0,0,,أليس الجسد والروح شيئين مختلفين؟
Dialogue: 0,0:08:07.17,0:08:11.95,Main,,0,0,0,,كلّا، كلاهما شكلٌ من أشكال التاو
Dialogue: 0,0:08:12.98,0:08:15.02,Main,,0,0,0,,أنتما تُناقشان مواضيعَ معقدةً مجدّدًا
Dialogue: 0,0:08:15.28,0:08:17.51,Main,,0,0,0,,اتفقنا ألّا نتحدث عن تلك الأمور هنا، أليس كذلك؟
Dialogue: 0,0:08:18.10,0:08:19.41,Main,,0,0,0,,سامحيني
Dialogue: 0,0:08:22.03,0:08:23.91,Main,,0,0,0,,أمزح فحسب
Dialogue: 0,0:08:23.91,0:08:25.28,Main,,0,0,0,,لا تحنِ رأسك
Dialogue: 0,0:08:25.58,0:08:27.07,Main,,0,0,0,,بل ارفعه عاليًا
Dialogue: 0,0:08:28.02,0:08:30.17,Main,,0,0,0,,!ارفع رأسك عاليًا
Dialogue: 0,0:08:32.45,0:08:33.79,Main,,0,0,0,,ما رأيك يا رين؟
Dialogue: 0,0:08:34.05,0:08:36.95,Main,,0,0,0,,أليست ساحة التدريب الجديدة رائعة؟
Dialogue: 0,0:08:37.29,0:08:39.96,Main,,0,0,0,,أجل، إنّها رائعة يا تاوفا
Dialogue: 0,0:08:40.60,0:08:44.90,Main,,0,0,0,,،تعلّم حركات تنفّس مختلفة في الماء وعلى اليابسة
Dialogue: 0,0:08:45.14,0:08:47.57,Main,,0,0,0,,تُعدّ تدريبًا على دوين وتايسوكو
Dialogue: 0,0:08:47.68,0:08:49.57,Main,,0,0,0,,والموسيقى تحفز التأمل
Dialogue: 0,0:08:49.67,0:08:52.47,Main,,0,0,0,,ممّا يسمح بالتدرب على كلّ من شويتسو وشوتين
Dialogue: 0,0:08:52.86,0:08:54.14,Main,,0,0,0,,تلك الغرفة جيدة أيضًا
Dialogue: 0,0:08:54.32,0:08:56.35,Main,,0,0,0,,يمكن للمرء التركيز على البوتشوجوتسو فيها
Dialogue: 0,0:08:56.56,0:08:57.60,Main,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:08:57.95,0:08:58.98,Main,,0,0,0,,هذا سخيف
Dialogue: 0,0:08:59.47,0:09:01.10,Main,,0,0,0,,أعني البوتشوجوتسو بحد ذاته
Dialogue: 0,0:09:01.78,0:09:06.31,Main,,0,0,0,,البقاء في المنتصف بين الين واليانغ كما أفعل هو الخيار الأمثل
Dialogue: 0,0:09:07.02,0:09:08.36,Main,,0,0,0,,أخالفك الرأي
Dialogue: 0,0:09:09.01,0:09:11.53,Main,,0,0,0,,للتاو خصائص تختلف باختلاف الحياة
Dialogue: 0,0:09:12.21,0:09:17.08,Main,,0,0,0,,الاتحاد مع الآخرين يُنتج طاقةً جديدةً للتاو
Dialogue: 0,0:09:27.40,0:09:30.95,Main,,0,0,0,,بالغتَ كثيرًا يا جوفا-كن، كان ذلك مذهلًا
Dialogue: 0,0:09:32.51,0:09:35.11,Main,,0,0,0,,يبدو أنّكما كنتما تجتهدان في التدريب
Dialogue: 0,0:09:35.51,0:09:36.69,Main,,0,0,0,,أتريد بعض التان؟
Dialogue: 0,0:09:36.85,0:09:38.22,Main,,0,0,0,,أجل، أعطني القليل
Dialogue: 0,0:09:38.53,0:09:40.73,Main,,0,0,0,,صنعه مودان لي
Dialogue: 0,0:09:41.25,0:09:42.61,Main,,0,0,0,,إنّه عصير طازج
Dialogue: 0,0:09:44.29,0:09:45.51,Main,,0,0,0,,تفضّل
Dialogue: 0,0:09:46.95,0:09:49.30,Main,,0,0,0,,نسيتُ وضع الشيء اللامع
Dialogue: 0,0:09:49.30,0:09:51.06,Main,,0,0,0,,الشيء الّذي يجعل المشروبات تتوهج
Dialogue: 0,0:09:51.14,0:09:53.32,Main,,0,0,0,,أين هو يا جوجين؟
Dialogue: 0,0:09:53.85,0:09:56.11,Main,,0,0,0,,لا أدري
Dialogue: 0,0:10:03.18,0:10:05.54,Main,,0,0,0,,نحن داخل قلعة تينسين-ساما
Dialogue: 0,0:10:06.16,0:10:08.19,Main,,0,0,0,,البقاء في مكان واحد خطر
Dialogue: 0,0:10:08.44,0:10:10.05,Main,,0,0,0,,لنخرج من البوابة
Dialogue: 0,0:10:10.39,0:10:11.49,Main,,0,0,0,,حاضر
Dialogue: 0,0:10:12.24,0:10:13.66,Main,,0,0,0,,...ملابسكم تلك
Dialogue: 0,0:10:13.95,0:10:16.43,Main,,0,0,0,,لم أعد أعرف أيّ نوع من الجماعات نحن
Dialogue: 0,0:10:16.60,0:10:18.82,Main,,0,0,0,,ما المشكلة؟ إنّها ظريفة
Dialogue: 0,0:10:19.04,0:10:21.40,Main,,0,0,0,,كنّا سنلفت الأنظار بملابسنا الملطخة بالدماء
Dialogue: 0,0:10:21.63,0:10:23.24,Main,,0,0,0,,آمل أن تتمكني من التغاضي عن الأمر
Dialogue: 0,0:10:23.24,0:10:24.56,Main,,0,0,0,,أنا أقلد معلمي فحسب
Dialogue: 0,0:10:25.69,0:10:26.75,Main,,0,0,0,,،على أيّ حال
Dialogue: 0,0:10:27.20,0:10:32.07,Main,,0,0,0,,هدفنا الحالي هو الاجتماع بغابيمارو وماي-سان
Dialogue: 0,0:10:32.69,0:10:34.90,Main,,0,0,0,,...ما دام هدف غابيمارو هو إكسير الحياة
Dialogue: 0,0:10:35.03,0:10:37.45,Main,,0,0,0,,فلا بدَّ أنّه سيقصد هذه القلعة
Dialogue: 0,0:10:37.73,0:10:41.37,Main,,0,0,0,,سيكون اللّقاء خارج البوابة هو الخيار الأنسب
Dialogue: 0,0:10:41.48,0:10:44.83,Main,,0,0,0,,مهلًا، هل نحتاج للالتقاء بهما؟
Dialogue: 0,0:10:44.93,0:10:48.42,Main,,0,0,0,,ألا يجدر بنا القلق بشأن مهمّتنا وإكسير الحياة؟
Dialogue: 0,0:10:48.65,0:10:51.19,Main,,0,0,0,,،فالجزيرة لا تكتظ بالوحوش فحسب
Dialogue: 0,0:10:51.27,0:10:54.55,Main,,0,0,0,,بل هناك أشخاص خطرون مثل تينسين-ساما يتربصون في المكان
Dialogue: 0,0:10:54.74,0:10:56.88,Main,,0,0,0,,يستحيل أن تكون للمهمّةِ أهميةٌ بعد الآن
Dialogue: 0,0:10:56.94,0:11:00.27,Main,,0,0,0,,أليس من الأفضل مغادرة الجزيرة فورًا؟
Dialogue: 0,0:11:01.77,0:11:03.68,Main,,0,0,0,,كلّا، سنلتقي بهما
Dialogue: 0,0:11:03.69,0:11:04.66,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:11:04.69,0:11:06.93,Main,,0,0,0,,أقول هذا لمصلحتكِ يا ساغيرين
Dialogue: 0,0:11:06.93,0:11:08.75,Main,,0,0,0,,هذه ليست نيتكِ الحقيقيّة، أليس كذلك؟
Dialogue: 0,0:11:09.75,0:11:13.96,Main,,0,0,0,,تغير موقفكِ حين علمتِ بعدم وجود الإكسير
Dialogue: 0,0:11:14.57,0:11:17.72,Main,,0,0,0,,...تريدين زيادة عدد الأسايمون الّذين سيقفون بصفكِ أمام الحكومة
Dialogue: 0,0:11:17.81,0:11:20.88,Main,,0,0,0,,كإجراء أمان حين تغادرين الجزيرة خالية الوفاض
Dialogue: 0,0:11:21.65,0:11:23.93,Main,,0,0,0,,ألا تتصرفين هكذا بدافع مصلحتكِ الشخصيّة؟
Dialogue: 0,0:11:24.90,0:11:26.06,Main,,0,0,0,,كشفتِني
Dialogue: 0,0:11:26.06,0:11:29.22,Main,,0,0,0,,مع ذلك، أريد أن نغادر الجزيرة معًا
Dialogue: 0,0:11:29.36,0:11:34.16,Main,,0,0,0,,شعوري هذا لم يتغير، أرى عقلانيتكِ مصدر قوّةٍ
Dialogue: 0,0:11:34.96,0:11:37.02,Main,,0,0,0,,إن غادرنا، فسنغادر جميعًا
Dialogue: 0,0:11:37.47,0:11:39.85,Main,,0,0,0,,وهذا يشملكِ أنتِ وغابيمارو
Dialogue: 0,0:11:41.86,0:11:46.00,Main,,0,0,0,,رغم أنّي لا أضمن وصول غابيمارو إلى هنا
Dialogue: 0,0:11:47.85,0:11:50.69,Main,,0,0,0,,أظن أنّه وصل، على الأرجح
Dialogue: 0,0:11:51.11,0:11:54.98,Main,,0,0,0,,كانت هناك آثار حريق واسعة وجدار محطم قرب البوابة
Dialogue: 0,0:11:54.98,0:11:57.53,Main,,0,0,0,,إنّه الوحيد القادر على ترك أثرٍ كهذا
Dialogue: 0,0:11:58.13,0:12:01.70,Main,,0,0,0,,الالتقاء خارج البوابة... هو الخيار المنطقي
Dialogue: 0,0:12:02.67,0:12:04.95,Main,,0,0,0,,شكرًا لكِ
Dialogue: 0,0:12:05.25,0:12:08.51,Main,,0,0,0,,ساغيرين، تصبحين عنيدةً حين تتخذين قرارًا
Dialogue: 0,0:12:09.55,0:12:16.17,Main,,0,0,0,,لكن إن التقينا، ماذا ستفعلين بخصوص زوجة غابيمارو؟
Dialogue: 0,0:12:22.51,0:12:27.35,Main,,0,0,0,,هل سنصل لقلعة تينسين إن تسلقنا هذا المنحدر حقًّا؟
Dialogue: 0,0:12:27.45,0:12:29.34,Main,,0,0,0,,لا أرى أثرًا لها
Dialogue: 0,0:12:29.53,0:12:31.13,Main,,0,0,0,,أنا لا أكذب
Dialogue: 0,0:12:31.19,0:12:34.36,Main,,0,0,0,,لا داعي لأن تُقلِّدي نبرتي أيّتها الآنسة
Dialogue: 0,0:12:34.73,0:12:37.02,Main,,0,0,0,,حسنٌ، ما الّذي عليَّ فعله الآن؟
Dialogue: 0,0:12:37.19,0:12:38.82,Main,,0,0,0,,لم تعد ذاكرتي بعد
Dialogue: 0,0:12:40.06,0:12:43.06,Main,,0,0,0,,بناءً على كلامهما، هذه مهمّةٌ سخيفة
Dialogue: 0,0:12:43.74,0:12:46.12,Main,,0,0,0,,لِمَ قبلتُ هذه المهمّة أصلًا؟
Dialogue: 0,0:12:46.41,0:12:47.56,Main,,0,0,0,,هل أنفذ الأوامر فحسب؟
Dialogue: 0,0:12:49.06,0:12:51.67,Main,,0,0,0,,أم ثمّة سبب آخر؟
Dialogue: 0,0:12:52.87,0:12:55.00,Main,,0,0,0,,لا جدوى، لا أستطيع التذكر
Dialogue: 0,0:12:56.69,0:12:58.01,Main,,0,0,0,,هل أنتَ بخير؟
Dialogue: 0,0:12:58.79,0:13:00.59,Main,,0,0,0,,تبدو متوعكًا
Dialogue: 0,0:13:02.19,0:13:03.27,Main,,0,0,0,,أنا بخير
Dialogue: 0,0:13:13.54,0:13:15.07,Main,,0,0,0,,بشر؟
Dialogue: 0,0:13:15.20,0:13:18.24,Main,,0,0,0,,إذن، هذا يعني أنّنا حلفاء، أليس كذلك؟
Dialogue: 0,0:13:27.65,0:13:29.08,Main,,0,0,0,,ليس سيئًا
Dialogue: 0,0:13:29.08,0:13:30.75,Main,,0,0,0,,يجدر بنا القتال معًا
Dialogue: 0,0:13:31.87,0:13:35.00,Main,,0,0,0,,لن نفعل، أليس كذلك؟
Dialogue: 0,0:13:46.40,0:13:48.81,Main,,0,0,0,,القتال معًا؟ سيكون ذلك بلا جدوى
Dialogue: 0,0:13:49.15,0:13:50.38,Main,,0,0,0,,كان ذلك مخيبًا للآمال
Dialogue: 0,0:13:50.77,0:13:51.69,Main,,0,0,0,,!غابيمارو
Dialogue: 0,0:13:51.69,0:13:54.06,Main,,0,0,0,,!تاو ذلك الشخص... كبير
Dialogue: 0,0:13:55.19,0:13:57.40,Main,,0,0,0,,!كبيرٌ للغاية
Dialogue: 0,0:14:02.28,0:14:04.78,Main,,0,0,0,,القتال معًا؟ لستُ مهتمًا
Dialogue: 0,0:14:05.10,0:14:07.43,Main,,0,0,0,,كُسرتْ رقبته للتو، أليس كذلك؟
Dialogue: 0,0:14:07.43,0:14:09.87,Main,,0,0,0,,أجل، لكنّها شُفيتْ
Dialogue: 0,0:14:10.72,0:14:13.50,Main,,0,0,0,,"وحوش خالدة تحكم الجزيرة"
Dialogue: 0,0:14:13.50,0:14:15.95,Main,,0,0,0,,هل كان نقاش الليلة الماضية عن هذا الرجل؟
Dialogue: 0,0:14:16.37,0:14:18.55,Main,,0,0,0,,سأقيده وأستخرج المعلومات منه
Dialogue: 0,0:14:24.69,0:14:26.70,Main,,0,0,0,,واحدة أخرى
Dialogue: 0,0:14:29.26,0:14:30.93,Main,,0,0,0,,هل ضحكتَ للتو؟
Dialogue: 0,0:14:30.93,0:14:33.23,Main,,0,0,0,,أنتَ واثقٌ من نفسك أيّها القزم اللعين
Dialogue: 0,0:14:33.50,0:14:36.44,Main,,0,0,0,,عليَّ تحطيمكَ كما أفعل دائمًا
Dialogue: 0,0:14:36.66,0:14:37.69,Main,,0,0,0,,سيكون هذا سهلًا
Dialogue: 0,0:14:37.69,0:14:40.00,Main,,0,0,0,,لا داعي للتفكير في أيّ شيء آخر
Dialogue: 0,0:14:40.00,0:14:41.36,Main,,0,0,0,,!نينبو: إبر الزهرة
Dialogue: 0,0:14:42.44,0:14:43.91,Main,,0,0,0,,سأستهدف الدماغ
Dialogue: 0,0:14:48.07,0:14:49.27,Main,,0,0,0,,والعينين
Dialogue: 0,0:14:50.27,0:14:53.25,Main,,0,0,0,,تجريد العدوّ من حواسه قد يكون مُجديًا حتّى ضدَّ الخالدين
Dialogue: 0,0:14:58.96,0:15:01.21,Main,,0,0,0,,قضمتَ الوتر؟
Dialogue: 0,0:15:01.49,0:15:03.97,Main,,0,0,0,,هذا ليس شيئًا يفعله البشر
Dialogue: 0,0:15:04.38,0:15:10.14,Main,,0,0,0,,الشرايين، الأعصاب، شاكوتاكو، هيتشو
Dialogue: 0,0:15:16.08,0:15:17.27,Main,,0,0,0,,الشريان السُّباتي
Dialogue: 0,0:15:17.65,0:15:21.66,Main,,0,0,0,,...من المنطقي تركيز هجماته على النقاط الحيويّة، ولكن
Dialogue: 0,0:15:21.71,0:15:23.65,Main,,0,0,0,,طريقة قتاله وحشيّة
Dialogue: 0,0:15:23.92,0:15:26.18,Main,,0,0,0,,الأمر أشبه بصراع وحوش
Dialogue: 0,0:15:27.26,0:15:29.64,Main,,0,0,0,,الأمر سيان مهما كان خصمي
Dialogue: 0,0:15:29.77,0:15:32.62,Main,,0,0,0,,أسلوب إيواغاكوري يقوم على التحطيم إلى أن يبلغ الخصم حدّ الانهيار
Dialogue: 0,0:15:39.76,0:15:41.53,Main,,0,0,0,,أهذا كلّ ما لديك؟
Dialogue: 0,0:15:41.77,0:15:43.80,Main,,0,0,0,,هذا ليس بالأمر الجلل
Dialogue: 0,0:15:46.80,0:15:48.01,Main,,0,0,0,,!موطئ قدمنا
Dialogue: 0,0:15:51.30,0:15:56.52,Main,,0,0,0,,بدوتَ قويًّا من ناحية الأوندو، لذا تلقيتُ بضع ضرباتٍ
Dialogue: 0,0:15:57.61,0:16:00.40,Main,,0,0,0,,أنتَ ضعيف
Dialogue: 0,0:16:16.71,0:16:19.24,Main,,0,0,0,,أسلوبكَ وحشيٌّ، هذا كلّ ما في الأمر
Dialogue: 0,0:16:20.03,0:16:22.71,Main,,0,0,0,,لا يعني أنّني أكره الابتذال
Dialogue: 0,0:16:22.96,0:16:25.56,Main,,0,0,0,,إنّه منطقي لكنّه بِلا حدّةٍ
Dialogue: 0,0:16:25.91,0:16:28.59,Main,,0,0,0,,كان أشد قوةً حينها
Dialogue: 0,0:16:28.95,0:16:30.66,Main,,0,0,0,,ما الّذي يحدث يا آنسة؟
Dialogue: 0,0:16:31.22,0:16:33.51,Main,,0,0,0,,هل ضَعُفَ بسبب فقدانه لوعيه؟
Dialogue: 0,0:16:33.65,0:16:37.10,Main,,0,0,0,,تاو غابيمارو فيه خطب ما
Dialogue: 0,0:16:38.88,0:16:41.35,Main,,0,0,0,,لا يختفي حتّى حين أركز
Dialogue: 0,0:16:42.87,0:16:46.11,Main,,0,0,0,,شعور عدم الارتياح لا يزول
Dialogue: 0,0:16:46.94,0:16:49.45,Main,,0,0,0,,قوي، قوي... لا
Dialogue: 0,0:16:49.54,0:16:52.52,Main,,0,0,0,,قوي، ضعيف... كلاهما مهم
Dialogue: 0,0:16:53.32,0:16:55.94,Main,,0,0,0,,الضعف هو بذرة القوّة
Dialogue: 0,0:16:56.35,0:16:59.37,Main,,0,0,0,,يفتقر غابيمارو... لبذرة القوّة
Dialogue: 0,0:16:59.53,0:17:01.49,Main,,0,0,0,,يفتقر لشيءٍ مهمٍّ
Dialogue: 0,0:17:02.05,0:17:04.99,Main,,0,0,0,,...هذا الشعور الغريب بالفقدان
Dialogue: 0,0:17:18.93,0:17:20.48,Main,,0,0,0,,!هذا يكفي يا توما
Dialogue: 0,0:17:20.48,0:17:23.46,Main,,0,0,0,,!اقتل الآخرين أيضًا
Dialogue: 0,0:17:23.66,0:17:25.01,Main,,0,0,0,,حاضر يا أخي
Dialogue: 0,0:17:25.49,0:17:26.36,Main,,0,0,0,,أخي؟
Dialogue: 0,0:17:28.63,0:17:30.43,Main,,0,0,0,,أولًا ذلك الرجل ذو الذراع الواحدة
Dialogue: 0,0:17:30.64,0:17:33.11,Main,,0,0,0,,...سيكون قطع عضلاته السميكة صعبًا، لذا
Dialogue: 0,0:17:33.38,0:17:34.28,Main,,0,0,0,,سأطعنه
Dialogue: 0,0:17:36.11,0:17:40.00,Main,,0,0,0,,مهلًا، لِمَ بدأتَ بي؟
Dialogue: 0,0:17:40.13,0:17:41.99,Main,,0,0,0,,هل لأنَّ لي ذراعًا واحدة؟
Dialogue: 0,0:17:42.44,0:17:46.25,Main,,0,0,0,,لأنّي بدوتُ فريسةً سهلةً، أليس كذلك؟
Dialogue: 0,0:17:49.22,0:17:51.30,Main,,0,0,0,,لا تستخف بي يا فتى
Dialogue: 0,0:17:55.94,0:17:56.93,Main,,0,0,0,,التقطه
Dialogue: 0,0:17:57.58,0:18:00.18,Main,,0,0,0,,سأواجه أمثالكَ دون سحب سيفي
Dialogue: 0,0:18:01.66,0:18:03.25,Main,,0,0,0,,تمهّل يا كينريو
Dialogue: 0,0:18:03.35,0:18:06.27,Main,,0,0,0,,يبدو أنَّ هناك سببًا خفيًّا، لكنّه لا يزال من عشيرة يامادا
Dialogue: 0,0:18:06.28,0:18:07.27,Main,,0,0,0,,اخرس
Dialogue: 0,0:18:07.54,0:18:11.57,Main,,0,0,0,,من يستهين بي لن يعود سليمًا كائنًا من كان
Dialogue: 0,0:18:11.94,0:18:15.07,Main,,0,0,0,,عيناه جيدتان، لكن هذا ليس كلّ شيء
Dialogue: 0,0:18:15.22,0:18:17.18,Main,,0,0,0,,غرائزه جيدة، وخبرته كذلك
Dialogue: 0,0:18:17.66,0:18:20.48,Main,,0,0,0,,إذن، سأستغل ردود فعله ضده
Dialogue: 0,0:18:27.28,0:18:31.26,Main,,0,0,0,,تتمتّع بالرشاقة وسرعة الضرب بالسيف، لديكَ موهبة
Dialogue: 0,0:18:31.34,0:18:34.63,Main,,0,0,0,,لكن هذا كلّ شيء، تفتقر للقوّة الحقيقيّة
Dialogue: 0,0:18:34.89,0:18:37.06,Main,,0,0,0,,حركاتكَ وأسلوبكَ غير متقنين
Dialogue: 0,0:18:37.18,0:18:39.22,Main,,0,0,0,,خلاصةُ القولِ، أنتَ مجرد متطاولٍ بغير قدرة
Dialogue: 0,0:18:39.62,0:18:41.67,Main,,0,0,0,,!لا تستهن بالكاتا
Dialogue: 0,0:18:42.10,0:18:46.25,Main,,0,0,0,,!قمتَ بتبسيطها بسبب طابعها العملي ولم تبقَ ككاتا
Dialogue: 0,0:18:46.76,0:18:49.35,Main,,0,0,0,,هل أصابكَ الغرور بسبب موهبتك؟
Dialogue: 0,0:18:49.51,0:18:51.69,Main,,0,0,0,,أراهن أنّك تركتَ أخاك يقوم بكلّ القتال الحقيقي
Dialogue: 0,0:18:51.81,0:18:53.99,Main,,0,0,0,,يمكنني معرفة ذلك بالنظر إلى وجهكَ الجميل
Dialogue: 0,0:18:56.16,0:19:00.33,Main,,0,0,0,,لو قبلتَ القتال معه لكان لكَ عذرٌ
Dialogue: 0,0:19:00.68,0:19:04.58,Main,,0,0,0,,إن لم يرغب أخي في ذلك فسأتبعه
Dialogue: 0,0:19:05.40,0:19:06.73,Main,,0,0,0,,...فضلًا عن ذلك
Dialogue: 0,0:19:14.36,0:19:17.68,Main,,0,0,0,,أكره الأشخاص الّذين يشكلون مجموعات كبيرة
Dialogue: 0,0:19:17.91,0:19:20.74,Main,,0,0,0,,كلّ قطاع الطرق الّذين قدناهم كانوا مجرد بيادق
Dialogue: 0,0:19:20.74,0:19:22.81,Main,,0,0,0,,لم أعتبرهم حلفاء قطّ
Dialogue: 0,0:19:22.81,0:19:26.08,Main,,0,0,0,,نحن بحاجة لبعضنا البعض فحسب
Dialogue: 0,0:19:26.66,0:19:28.99,Main,,0,0,0,,لا تتفلسف
Dialogue: 0,0:19:28.99,0:19:31.90,Main,,0,0,0,,إن كنتما تتسكّعان معًا، فلا فرق بينكما وبين قطيعٍ متجمّع
Dialogue: 0,0:19:32.26,0:19:34.70,Main,,0,0,0,,أنا جزء من أخي
Dialogue: 0,0:19:36.00,0:19:38.25,Main,,0,0,0,,تغيرت قبضته ومركز ثقله
Dialogue: 0,0:19:38.30,0:19:42.41,Main,,0,0,0,,!تحسّن في هذه الفترة القصيرة
Dialogue: 0,0:19:43.64,0:19:46.99,Main,,0,0,0,,ما أسخف طريقة تفكيرك يا نصف رجل
Dialogue: 0,0:19:47.14,0:19:51.57,Main,,0,0,0,,وحده أخي من يملك حقَّ الحكم على سخافة الأمر أيّها العجوز اللعين
Dialogue: 0,0:19:52.51,0:19:54.46,Main,,0,0,0,,!ابدأ العمل أيّها الدوشي
Dialogue: 0,0:19:54.61,0:19:56.42,Main,,0,0,0,,!اقتل القزم والفتاة
Dialogue: 0,0:19:56.42,0:19:57.58,Main,,0,0,0,,!حاضر
Dialogue: 0,0:20:02.60,0:20:05.93,Main,,0,0,0,,تراجعي حوالي اثنين كين حفاظًا على سلامتكِ
Dialogue: 0,0:20:12.10,0:20:15.11,Main,,0,0,0,,إنّه عنيد، لكن يمكنني قتله
Dialogue: 0,0:20:15.11,0:20:18.60,Main,,0,0,0,,،بفضل التاو، يمكنني قراءة حركات النينجا
Dialogue: 0,0:20:18.82,0:20:21.08,Main,,0,0,0,,ويسعني التجدّد حتّى لو أُصبتُ
Dialogue: 0,0:20:21.75,0:20:24.45,Main,,0,0,0,,التاو النابع منك قويّ بشكلٍ خاصّ
Dialogue: 0,0:20:25.03,0:20:27.54,Main,,0,0,0,,،كان ينبغي أن يبتلعكَ
Dialogue: 0,0:20:27.64,0:20:32.30,Main,,0,0,0,,لأنّك لم تكتسبه بالتدريب
Dialogue: 0,0:20:36.48,0:20:37.84,Main,,0,0,0,,إنّه قويّ
Dialogue: 0,0:20:38.07,0:20:40.09,Main,,0,0,0,,لن أنتصر عليه ما لم أركز
Dialogue: 0,0:20:40.75,0:20:43.82,Main,,0,0,0,,...سأنسى هذا الشعور الغريب الآن
Dialogue: 0,0:20:45.03,0:20:46.54,Main,,0,0,0,,وأجعل نفسي جوفاء
Dialogue: 0,0:20:47.64,0:20:49.89,Main,,0,0,0,,لا ينبغي أن يموت الشينوبي عبثًا
Dialogue: 0,0:20:50.05,0:20:51.48,Main,,0,0,0,,...إن كان موتكَ محتومًا
Dialogue: 0,0:20:51.61,0:20:55.95,Main,,0,0,0,,فلتمتْ بعد أن تُلحق ضررًا كبيرًا بالعدو
Dialogue: 0,0:21:00.48,0:21:02.37,Main,,0,0,0,,أهذه ورقتكَ الرابحة؟
Dialogue: 0,0:21:02.57,0:21:06.99,Main,,0,0,0,,لكن هيئتكَ توحي بأنّك مُرهق بشدة
Dialogue: 0,0:21:07.56,0:21:10.91,Main,,0,0,0,,...أنتَ تضحي بنفسك، إذن سأحقّق أمنيتك
Dialogue: 0,0:21:11.82,0:21:13.50,Main,,0,0,0,,!وأقتلك
Dialogue: 0,0:21:15.46,0:21:17.19,Main,,0,0,0,,نينبو: الجسر الناري
Dialogue: 0,0:21:19.13,0:21:20.63,Main,,0,0,0,,نينبو: عاصفة الحجارة
Dialogue: 0,0:21:28.74,0:21:30.94,Main,,0,0,0,,لا يسعني التجدد بالسرعة الكافية
Dialogue: 0,0:21:30.94,0:21:33.23,Main,,0,0,0,,هذا سيئ
Dialogue: 0,0:21:34.96,0:21:39.89,Main,,0,0,0,,أتنوي الانتحار معي؟
Dialogue: 0,0:21:39.89,0:21:40.72,Main,,0,0,0,,لا أبالي
Dialogue: 0,0:21:41.14,0:21:44.70,Main,,0,0,0,,لم أتذكر تفاصيل هذه المهمّة أساسًا
Dialogue: 0,0:21:45.61,0:21:48.49,Main,,0,0,0,,حتّى لو متُّ، فسيحلّ محلّي شخصٌ آخر من القرية
Dialogue: 0,0:21:49.05,0:21:50.74,Main,,0,0,0,,يعمل الشينوبي كمجموعة
Dialogue: 0,0:21:51.05,0:21:52.87,Main,,0,0,0,,حياة الفرد لا قيمة لها
Dialogue: 0,0:21:53.45,0:21:55.05,Main,,0,0,0,,ليس لديّ ما أخسره أيضًا
Dialogue: 0,0:21:55.69,0:21:57.44,Main,,0,0,0,,لكن أنتَ لديك، أليس كذلك؟
Dialogue: 0,0:21:58.60,0:22:01.59,Main,,0,0,0,,ألا يمكن لمن يريد الحياة هزيمة ميتٍ؟
Dialogue: 0,0:22:03.73,0:22:07.22,Main,,0,0,0,,أجل، أنتَ محقّ
Dialogue: 0,0:22:07.72,0:22:09.35,Main,,0,0,0,,شكرًا لك
Dialogue: 0,0:22:09.79,0:22:12.10,Main,,0,0,0,,كان ينبغي أن يبتلعكَ
Dialogue: 0,0:22:12.39,0:22:14.81,Main,,0,0,0,,حسمتُ أمري
Dialogue: 0,0:22:15.11,0:22:19.19,Main,,0,0,0,,سأطلق العنان لكلّ شيء
Dialogue: 0,0:22:20.01,0:22:22.57,Main,,0,0,0,,لديّ ما أخشى خسارته
Dialogue: 0,0:22:22.68,0:22:25.26,Main,,0,0,0,,لا أمانع فقدان أيّ شيء آخر سواه
Dialogue: 0,0:22:27.69,0:22:29.25,Main,,0,0,0,,هو كلّ ما أحتاجه
Dialogue: 0,0:22:29.78,0:22:32.84,Main,,0,0,0,,!لا أحتاج إلى أيّ شيء سواه
Dialogue: 0,0:22:34.61,0:22:35.69,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:22:37.68,0:22:38.69,Main,,0,0,0,,ما ذلك؟
Dialogue: 0,0:22:40.39,0:22:43.01,Main,,0,0,0,,!أ-أخي
Dialogue: 0,0:22:44.11,0:22:46.01,Main,,0,0,0,,...طم
Dialogue: 0,0:22:46.47,0:22:48.99,Main,,0,0,0,,...أتحـ... طم
Dialogue: 0,0:22:49.48,0:22:52.25,Main,,0,0,0,,أنا... أتحطم
Comment: 0,0:22:52.25,0:22:52.25,Note,,0,0,0,,
