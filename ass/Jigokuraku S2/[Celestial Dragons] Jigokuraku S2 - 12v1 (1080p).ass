Dialogue: 0,0:00:20.83,0:00:23.59,Main,,0,0,0,,رغم تسلّلنا وإحداثنا جلبة، لِمَ لا يوجد أيّ دوشي؟
Dialogue: 0,0:00:24.90,0:00:25.80,Main,,0,0,0,,أهو فخٌّ؟
Dialogue: 0,0:00:27.93,0:00:28.88,Main,,0,0,0,,...أم أنّه
Dialogue: 0,0:00:31.02,0:00:32.73,Main,,0,0,0,,وجهتنا النهائيّة هي البوّابة المائيّة
Dialogue: 0,0:00:33.43,0:00:35.00,Main,,0,0,0,,سنغادر الجزيرة بالسفينة من هناك
Dialogue: 0,0:00:35.75,0:00:37.73,Main,,0,0,0,,،تقع البوّابة المائيّة في أقصى الفناء الداخليّ
Dialogue: 0,0:00:38.13,0:00:39.55,Main,,0,0,0,,تحت القصر الرئيسيّ
Dialogue: 0,0:00:40.02,0:00:44.35,Main,,0,0,0,,سيلتقي فريق استعادة الإكسير وفريق تأمين طريق الهروب هنا
Dialogue: 0,0:00:44.81,0:00:46.90,Main,,0,0,0,,أسننتظر تجمّع الجميع؟
Dialogue: 0,0:00:46.93,0:00:50.81,Main,,0,0,0,,كلّا، كلّا، سنغادر فور حصولنا على الإكسير
Dialogue: 0,0:00:50.96,0:00:52.79,Main,,0,0,0,,من يتأخّر سيُترك خلفنا
Dialogue: 0,0:00:53.34,0:00:55.15,Main,,0,0,0,,ليس الأمر بهذه البساطة
Dialogue: 0,0:00:55.62,0:00:58.82,Main,,0,0,0,,سنحتاج إلى خمسة أشخاصٍ على الأقلّ لتحريك سفينةٍ متوسّطة الحجم
Dialogue: 0,0:00:59.21,0:01:03.09,Main,,0,0,0,,...قد يبدو كلامي قاسيًا، لكن إن لم يصل خمسة أشخاصٍ
Dialogue: 0,0:01:03.36,0:01:04.99,Main,,0,0,0,,فلن نتمكّن من الهروب
Dialogue: 0,0:01:08.06,0:01:09.76,Main,,0,0,0,,لا بُدَّ أن ينجو خمسةٌ منّا
Dialogue: 0,0:01:15.89,0:01:16.89,Main,,0,0,0,,...هذا
Dialogue: 0,0:01:17.17,0:01:20.95,Main,,0,0,0,,كلّما تجدّدتَ، زاد تحوّل جسدكَ إلى نباتٍ
Dialogue: 0,0:01:21.11,0:01:25.12,Main,,0,0,0,,إن استمرّ في التهامكَ فستموت، أو لعلَّ جحيمًا أسوأ بانتظارك
Dialogue: 0,0:01:30.58,0:01:35.03,Main,,0,0,0,,ستُصدم يوي حتمًا إن رأتْ جسدي هذا
Dialogue: 0,0:01:36.20,0:01:37.58,Main,,0,0,0,,...قد تُصدم
Dialogue: 0,0:01:37.83,0:01:38.85,Main,,0,0,0,,...هذا مؤلم
Dialogue: 0,0:03:21.27,0:03:22.52,Main,,0,0,0,,!هذه الزاوية
Dialogue: 0,0:03:23.03,0:03:26.16,Main,,0,0,0,,!كان نحت الواقي شاقًّا، لكنّه أفلح
Dialogue: 0,0:03:26.43,0:03:27.57,Main,,0,0,0,,!عصابة عينٍ
Dialogue: 0,0:03:27.91,0:03:29.10,Main,,0,0,0,,!انظر يا توما
Dialogue: 0,0:03:29.27,0:03:30.21,Main,,0,0,0,,!انظر
Dialogue: 0,0:03:32.79,0:03:36.44,Main,,0,0,0,,ألن يبدو أروع إن كان الجزء الأوسط مستقيمًا؟
Dialogue: 0,0:03:36.68,0:03:39.56,Main,,0,0,0,,!كلّا، كلّا، يبدو أروع مائلًا
Dialogue: 0,0:03:39.91,0:03:41.21,Main,,0,0,0,,أليس كذلك يا غانتيتسوساي؟
Dialogue: 0,0:03:41.51,0:03:43.37,Main,,0,0,0,,أريد أن أبدو كخبيرٍ
Dialogue: 0,0:03:43.67,0:03:46.04,Main,,0,0,0,,لا أريد شيئًا مبهرجًا ورائعًا
Dialogue: 0,0:03:46.37,0:03:47.97,Main,,0,0,0,,أريد أن أُشعّ بهالة الخبراء
Dialogue: 0,0:03:48.64,0:03:51.67,Main,,0,0,0,,كأن أبدو كعجوزٍ زاهدٍ للوهلة الأولى
Dialogue: 0,0:03:52.03,0:03:55.11,Main,,0,0,0,,وبما أنّه لا توجد مرآة، فلا فكرة لديَّ عن هذه الزاوية
Dialogue: 0,0:03:55.59,0:03:56.98,Main,,0,0,0,,ها هو يقولها بنفسه
Dialogue: 0,0:03:57.81,0:04:00.85,Main,,0,0,0,,أذواقكما مُثخنةٌ بالجراح كأجسادكما
Dialogue: 0,0:04:01.77,0:04:03.73,Main,,0,0,0,,لسانكَ سليطٌ حقًّا
Dialogue: 0,0:04:07.71,0:04:10.30,Main,,0,0,0,,ستُصاب بالزكام إن لم ترتدِ ثيابكَ قريبًا أيّها العجوز
Dialogue: 0,0:04:10.67,0:04:12.85,Main,,0,0,0,,لم تجفّ بعد
Dialogue: 0,0:04:13.16,0:04:14.42,Main,,0,0,0,,أيّها الحمقى
Dialogue: 0,0:04:14.72,0:04:16.68,Main,,0,0,0,,ألديكُم متّسعٌ من الوقت للراحة؟
Dialogue: 0,0:04:17.26,0:04:19.20,Main,,0,0,0,,نحن نستعدّ فحسب
Dialogue: 0,0:04:19.58,0:04:21.02,Main,,0,0,0,,لا تجادل أخي
Dialogue: 0,0:04:21.02,0:04:22.06,Main,,0,0,0,,!هذا سريعٌ على نحوٍ مفاجئٍ
Dialogue: 0,0:04:22.33,0:04:24.24,Main,,0,0,0,,...لا أعرف التفاصيل، ولكن
Dialogue: 0,0:04:24.54,0:04:27.63,Main,,0,0,0,,زعيم التينسين يخطّط لأمرٍ ما
Dialogue: 0,0:04:30.36,0:04:33.58,Main,,0,0,0,,يوجد وحشٌ يُدعى بانكو في عمق القصر الرئيسيّ
Dialogue: 0,0:04:34.23,0:04:38.14,Main,,0,0,0,,ينوون استخدامه لتحويل كلّ من في البرّ الرئيسيّ إلى تان
Dialogue: 0,0:04:38.60,0:04:40.41,Main,,0,0,0,,لا أدري ما الّذي سيحدث بعد ذلك
Dialogue: 0,0:04:41.29,0:04:42.72,Main,,0,0,0,,...هذه المعركة
Dialogue: 0,0:04:43.39,0:04:44.97,Main,,0,0,0,,مجرّد إلهاءٍ فحسب
Dialogue: 0,0:04:46.56,0:04:49.52,Main,,0,0,0,,تسمّونه طقس الهيكيجي فوكوشو، أليس كذلك؟
Dialogue: 0,0:04:50.16,0:04:53.27,Main,,0,0,0,,ماذا لو مات التينسين أثناء الطقس؟
Dialogue: 0,0:04:53.65,0:04:54.61,Main,,0,0,0,,أليسوا عائلتك؟
Dialogue: 0,0:04:58.49,0:04:59.42,Main,,0,0,0,,لن يموتوا
Dialogue: 0,0:05:00.17,0:05:02.55,Main,,0,0,0,,وحتّى إن ماتوا فلا مشكلة
Dialogue: 0,0:05:05.06,0:05:07.68,Main,,0,0,0,,!اخرس! لا تتحدّث في أمورٍ معقّدة
Dialogue: 0,0:05:07.79,0:05:09.56,Main,,0,0,0,,ليست معقّدةً
Dialogue: 0,0:05:09.57,0:05:13.74,Main,,0,0,0,,وبالمناسبة أيّها الأعور، الزاوية الّتي ذكرها القزم أروع
Dialogue: 0,0:05:16.72,0:05:19.53,Main,,0,0,0,,ما الّذي كنتَ تفعله مع التينسين يا أخي؟
Dialogue: 0,0:05:21.31,0:05:24.28,Main,,0,0,0,,كنتُ أمارس البوتشوجوتسو وأخضع للتشريح مرارًا وتكرارًا
Dialogue: 0,0:05:25.94,0:05:28.57,Main,,0,0,0,,على أيّ حال، هدفنا لم يتغيّر
Dialogue: 0,0:05:28.71,0:05:31.19,Main,,0,0,0,,سنتوجّه إلى البوّابة المائيّة ونؤمّن سفينةً
Dialogue: 0,0:05:31.59,0:05:35.19,Main,,0,0,0,,إن استولينا على سفينةٍ، فقد نتمكّن من إحباط خطّة ريين أيضًا
Dialogue: 0,0:05:35.74,0:05:38.70,Main,,0,0,0,,أستأتي معنا يا آزا تشوبي؟
Dialogue: 0,0:05:42.49,0:05:43.33,Main,,0,0,0,,...أنا
Dialogue: 0,0:05:50.47,0:05:51.27,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:05:53.25,0:05:55.76,Main,,0,0,0,,هل جسدكِ... بخير؟
Dialogue: 0,0:05:56.71,0:05:59.74,Main,,0,0,0,,ألديكِ أيّ إصاباتٍ؟ هل نمشي ببطءٍ قليلًا؟
Dialogue: 0,0:06:01.35,0:06:02.39,Main,,0,0,0,,أتشعرين بالدوار؟
Dialogue: 0,0:06:02.71,0:06:05.79,Main,,0,0,0,,لا، أنا من يفترض بها قول ذلك أيّها المعلّم
Dialogue: 0,0:06:08.17,0:06:09.94,Main,,0,0,0,,هكذا إذن، أنتِ محقّة
Dialogue: 0,0:06:10.40,0:06:11.94,Main,,0,0,0,,أنتَ دائم القلق
Dialogue: 0,0:06:12.11,0:06:14.54,Main,,0,0,0,,فأنا مجرّد مجرمةٍ مع جلّادٍ في النهاية
Dialogue: 0,0:06:21.14,0:06:24.74,Main,,0,0,0,,سننتظر تجمّع الآخرين أسفل ذلك القصر الرئيسيّ
Dialogue: 0,0:06:25.33,0:06:26.47,Main,,0,0,0,,،لكن في أسوأ الحالات
Dialogue: 0,0:06:26.96,0:06:30.26,Main,,0,0,0,,،حتّى لو لم نلتقِ بالآخرين أو لم نحصل على الإكسير
Dialogue: 0,0:06:31.20,0:06:33.63,Main,,0,0,0,,سأعيدكِ إلى البرّ الرئيسيّ
Dialogue: 0,0:06:34.39,0:06:36.51,Main,,0,0,0,,ماذا تقصد بذلك؟
Dialogue: 0,0:06:37.08,0:06:40.26,Main,,0,0,0,,لا تقلقي، سأبقى معكِ حتّى النهاية
Dialogue: 0,0:06:40.88,0:06:44.29,Main,,0,0,0,,بدلًا من العودة إلى إيدو، لنجُبْ جبال البلاد وسهولها معًا
Dialogue: 0,0:06:44.93,0:06:45.94,Main,,0,0,0,,...حتّى في ظلّ حكم توكوغاوا
Dialogue: 0,0:06:46.71,0:06:49.78,Main,,0,0,0,,لا بُدَّ أنَّ بعض المقاطعات لا تزال تضمّ أراضيَ يعيش فيها سكّان الجبال
Dialogue: 0,0:06:50.37,0:06:54.36,Main,,0,0,0,,قد تجدين أسلوب حياةٍ يناسبكِ أكثر من الاختباء في بلدةٍ ما
Dialogue: 0,0:06:58.29,0:07:00.00,Main,,0,0,0,,سأحميكِ حتّى ذلك الحين
Dialogue: 0,0:07:00.73,0:07:01.66,Main,,0,0,0,,حسمتُ أمري
Dialogue: 0,0:07:02.86,0:07:04.41,Main,,0,0,0,,ما دمتُ حيًّا أُرزق
Dialogue: 0,0:07:08.55,0:07:11.50,Main,,0,0,0,,أيعني هذا أنَّ لون عينيكَ يتغيّر؟
Dialogue: 0,0:07:11.86,0:07:13.67,Main,,0,0,0,,كلّا، ليس هذا ما قصدته
Dialogue: 0,0:07:14.17,0:07:16.59,Main,,0,0,0,,كانت عيناك مفتوحتين أثناء القتال
Dialogue: 0,0:07:17.21,0:07:18.33,Main,,0,0,0,,هل يتغيّر لونهما حقًّا؟
Dialogue: 0,0:07:18.46,0:07:19.63,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:07:19.99,0:07:21.41,Main,,0,0,0,,إنّه مجرّد تعبيرٍ مجازيٍّ
Dialogue: 0,0:07:21.67,0:07:22.40,Main,,0,0,0,,تاو؟
Dialogue: 0,0:07:22.59,0:07:23.89,Main,,0,0,0,,لا علاقة للأمر بالتاو
Dialogue: 0,0:07:27.31,0:07:28.75,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:07:29.16,0:07:29.96,Main,,0,0,0,,!هزّة أرضيّة
Dialogue: 0,0:07:38.32,0:07:39.90,Main,,0,0,0,,عمَّ الهدوء
Dialogue: 0,0:07:40.56,0:07:42.83,Main,,0,0,0,,كان هائلًا، لكنّه بعيدٌ
Dialogue: 0,0:07:43.86,0:07:44.85,Main,,0,0,0,,لا أستشعر أيّ وجودٍ أيضًا
Dialogue: 0,0:07:54.38,0:07:58.93,Main,,0,0,0,,سيُعدم المجرمون على الفور في مكانهم
Dialogue: 0,0:08:00.01,0:08:05.24,Main,,0,0,0,,مُنحنا حريّة التصرّف من قِبل يامادا أسايمون شوغين-سان
Dialogue: 0,0:08:06.06,0:08:08.12,Main,,0,0,0,,،وكذلك كلّ من يؤوي المجرمين
Dialogue: 0,0:08:08.47,0:08:10.47,Main,,0,0,0,,...وكلّ من يلطّخ اسم الأسايمون
Dialogue: 0,0:08:14.65,0:08:15.99,Main,,0,0,0,,سنسلب حياته
Dialogue: 0,0:08:26.16,0:08:28.06,Main,,0,0,0,,إنّهم شينوبي إيواغاكوري
Dialogue: 0,0:08:38.25,0:08:39.15,Main,,0,0,0,,...أتيتَ إذن
Dialogue: 0,0:08:41.52,0:08:42.42,Main,,0,0,0,,غابيمارو
Dialogue: 0,0:08:44.69,0:08:48.45,Main,,0,0,0,,!اقطعوا رأس أيّ شخصٍ تصادفونه باستثناء عشيرة يامادا أسايمون
Dialogue: 0,0:08:48.85,0:08:50.64,Main,,0,0,0,,أُصرّح لكم بتنفيذ الإعدام نيابةً عنّي
Dialogue: 0,0:08:51.04,0:08:52.10,Main,,0,0,0,,!لنتحرّك نحن أيضًا
Dialogue: 0,0:08:52.17,0:08:52.47,Main,,0,0,0,,!حاضر
Dialogue: 0,0:08:52.47,0:08:53.04,Main,,0,0,0,,!حاضر
Dialogue: 0,0:08:55.98,0:08:59.62,Main,,0,0,0,,إنّه شيءٌ مختلفٌ عن الشباب
Dialogue: 0,0:08:59.90,0:09:03.82,Main,,0,0,0,,حسنٌ، أظنّ أنّي سأتولّى حماية المؤخّرة هنا
Dialogue: 0,0:09:05.78,0:09:07.22,Main,,0,0,0,,نظراتُكَ يملؤها الشكّ
Dialogue: 0,0:09:07.57,0:09:09.66,Main,,0,0,0,,أتظنّ أنّي أكذب لرغبتي في التهرّب فحسب؟
Dialogue: 0,0:09:09.99,0:09:13.09,Main,,0,0,0,,أعلم أنّكم كاذبون أيضًا
Dialogue: 0,0:09:13.49,0:09:15.54,Main,,0,0,0,,تتظاهرون بإطاعة الشوغون
Dialogue: 0,0:09:15.64,0:09:17.83,Main,,0,0,0,,رغم أنّي أجهل ما تخطّطون له
Dialogue: 0,0:09:20.77,0:09:23.89,Main,,0,0,0,,اسم غابيمارو هو رمز إيواغاكوري
Dialogue: 0,0:09:24.05,0:09:29.23,Main,,0,0,0,,اقتل الخائن يا شيجا، لا، بل غابيمارو التالي
Dialogue: 0,0:09:29.45,0:09:32.76,Main,,0,0,0,,اقتل سلفكَ وكُنْ غابيمارو الجديد
Dialogue: 0,0:09:32.84,0:09:36.27,Main,,0,0,0,,أعدْ رمز الخوف إلى القرية
Dialogue: 0,0:09:36.85,0:09:40.01,Main,,0,0,0,,اطمئنّ يا سيّدي الساموراي الفطن
Dialogue: 0,0:09:40.34,0:09:43.44,Main,,0,0,0,,فهدفنا يتقاطع مع هدفكم إلى حدٍّ كبيرٍ
Dialogue: 0,0:09:43.75,0:09:45.69,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:09:45.96,0:09:49.70,Main,,0,0,0,,...وكما أمر شوغين-ساما، فإنَّ أفراد عشيرة يامادا
Dialogue: 0,0:09:49.95,0:09:52.37,Main,,0,0,0,,لن نمسّهم بسوءٍ باستثناء الخونة
Dialogue: 0,0:09:52.72,0:09:54.10,Main,,0,0,0,,بل سنحميهم
Dialogue: 0,0:09:54.58,0:09:56.25,Main,,0,0,0,,...هدفنا هو
Dialogue: 0,0:09:57.37,0:10:00.00,Main,,0,0,0,,قتل كلّ من سواهم
Dialogue: 0,0:10:00.58,0:10:03.90,Main,,0,0,0,,قتل... كلّ من يلطّخ اسم يامادا
Dialogue: 0,0:10:04.54,0:10:07.94,Main,,0,0,0,,قتل... كلّ من يعترض طريق شوغين-ساما
Dialogue: 0,0:10:08.60,0:10:11.91,Main,,0,0,0,,قتل... كلّ من لا يهاب القرية
Dialogue: 0,0:10:12.57,0:10:16.19,Main,,0,0,0,,قتل... كلّ من يعرف الحقيقة
Dialogue: 0,0:10:16.62,0:10:20.30,Main,,0,0,0,,قتلهم، قتلهم، قتلهم جميعًا
Dialogue: 0,0:10:24.78,0:10:27.83,Main,,0,0,0,,حسنٌ، أظنّ أنّنا لا نتوافق في النهاية
Dialogue: 0,0:10:28.03,0:10:30.50,Main,,0,0,0,,على كلٍّ، حظًّا موفّقًا في مساعيكم
Dialogue: 0,0:10:31.16,0:10:35.25,Main,,0,0,0,,لأصدقكَ القول، أشعر بالمثل يا سيّدي الساموراي الفطن
Dialogue: 0,0:10:35.58,0:10:38.16,Main,,0,0,0,,القتل أمرٌ ثانويٌّ بالنسبة لي
Dialogue: 0,0:10:38.96,0:10:43.16,Main,,0,0,0,,...جئتُ لإعادة ذلك الشخص فحسب، لأنّني
Dialogue: 0,0:10:48.76,0:10:50.14,Main,,0,0,0,,...منذ ذلك الحين
Dialogue: 0,0:10:51.51,0:10:53.56,Main,,0,0,0,,لا أرى سواكَ
Dialogue: 0,0:10:59.72,0:11:00.66,Main,,0,0,0,,...هذا
Dialogue: 0,0:11:01.25,0:11:02.10,Main,,0,0,0,,!أسرعوا
Dialogue: 0,0:11:03.45,0:11:06.40,Main,,0,0,0,,ريين، قُتل جميع التينسين
Dialogue: 0,0:11:07.19,0:11:09.41,Main,,0,0,0,,فشل طقس الهيكيجي فوكوشو
Dialogue: 0,0:11:09.66,0:11:10.81,Main,,0,0,0,,والبشر قادمون
Dialogue: 0,0:11:11.11,0:11:12.39,Main,,0,0,0,,علينا التصرّف
Dialogue: 0,0:11:12.78,0:11:14.74,Main,,0,0,0,,ثمّة من يجيد التسلّل بينهم
Dialogue: 0,0:11:15.03,0:11:17.90,Main,,0,0,0,,إنّهم سريعون للغاية، فاقوا التوقّعات
Dialogue: 0,0:11:20.27,0:11:21.30,Main,,0,0,0,,ما باليد حيلةٌ
Dialogue: 0,0:11:21.64,0:11:23.59,Main,,0,0,0,,ليبقى الحدّ الأدنى من الحرّاس هنا
Dialogue: 0,0:11:23.79,0:11:26.15,Main,,0,0,0,,وليستعدّ بقيّة الدوشي للتصدّي لهم
Dialogue: 0,0:11:26.75,0:11:29.11,Main,,0,0,0,,لن نلحق بتجهيز المدافع وأسلحة الحصن في الوقت المناسب
Dialogue: 0,0:11:29.17,0:11:33.22,Main,,0,0,0,,تسلّحوا للقتال راجلين وعلى ظهور الخيل
Dialogue: 0,0:11:34.93,0:11:36.29,Main,,0,0,0,,هذه حربٌ شاملةٌ
Dialogue: 0,0:11:36.85,0:11:38.97,Main,,0,0,0,,لا تكترثوا لمجريات المعركة أو الخسائر
Dialogue: 0,0:11:40.43,0:11:43.63,Main,,0,0,0,,يكفي أن نكسب بعض الوقت
Dialogue: 0,0:11:44.18,0:11:47.93,Main,,0,0,0,,سيعود كلّ شيءٍ إلى طبيعته قريبًا
Dialogue: 0,0:11:49.44,0:11:50.27,Main,,0,0,0,,لننطلق
Dialogue: 0,0:12:09.05,0:12:10.62,Main,,0,0,0,,!ابتعدوا عن طريقي
Dialogue: 0,0:12:18.40,0:12:19.02,Main,,0,0,0,,!نوروغاي
Dialogue: 0,0:12:30.90,0:12:33.19,Main,,0,0,0,,!نوروغاي، اخترقيهم وتوجّهي إلى البوّابة المائيّة
Dialogue: 0,0:12:35.00,0:12:38.05,Main,,0,0,0,,!من هنا أيّها المعلّم، يسعني الرؤية في الظلام
Dialogue: 0,0:12:38.61,0:12:39.35,Main,,0,0,0,,الرؤية في الظلام؟
Dialogue: 0,0:12:40.79,0:12:41.32,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:12:41.87,0:12:43.76,Main,,0,0,0,,!أنا لا أمزح
Dialogue: 0,0:12:44.71,0:12:47.13,Main,,0,0,0,,!لن أُهزم أمام هؤلاء الحثالة الآن
Dialogue: 0,0:12:48.06,0:12:49.97,Main,,0,0,0,,!لا تضيّع وقتكَ في قتالهم جميعًا
Dialogue: 0,0:12:50.21,0:12:52.20,Main,,0,0,0,,!غدا الأمر أشبه بحربٍ طاحنةٍ
Dialogue: 0,0:12:52.26,0:12:53.28,Main,,0,0,0,,!أعرف ذلك
Dialogue: 0,0:12:53.55,0:12:56.42,Main,,0,0,0,,!أيّها اللصّان الشقيقان، اهربا أنتما أيضًا
Dialogue: 0,0:12:56.64,0:12:57.97,Main,,0,0,0,,!لا تأمر أخي
Dialogue: 0,0:12:58.37,0:13:01.89,Main,,0,0,0,,سنستغلّ هذه الفوضى لمغادرة الجزيرة
Dialogue: 0,0:13:06.80,0:13:08.48,Main,,0,0,0,,أنا خبيرٌ في الحروب
Dialogue: 0,0:13:08.92,0:13:11.32,Main,,0,0,0,,الحرب تختلف عن القتال
Dialogue: 0,0:13:12.15,0:13:14.62,Main,,0,0,0,,إنّها تتجاوز مجرّد استعراض القوّة
Dialogue: 0,0:13:14.84,0:13:17.46,Main,,0,0,0,,وتغدو مسألة الحياة والموت رهنًا بالحظّ فحسب
Dialogue: 0,0:13:17.97,0:13:20.86,Main,,0,0,0,,لا متعة فيها، ولا تدعو للفخر
Dialogue: 0,0:13:21.10,0:13:23.00,Main,,0,0,0,,الحرب مجرّد هراءٍ
Dialogue: 0,0:13:23.37,0:13:26.37,Main,,0,0,0,,،من ينجو في الحرب هو من يهرب
Dialogue: 0,0:13:26.61,0:13:28.46,Main,,0,0,0,,،أو من يدفع أتباعه للقتال
Dialogue: 0,0:13:29.50,0:13:31.43,Main,,0,0,0,,أو شيطانٌ تجرّد من إنسانيّته
Dialogue: 0,0:13:34.98,0:13:37.27,Main,,0,0,0,,...شوغين-سان، الفرسان قادمون من هناك
Dialogue: 0,0:13:37.49,0:13:38.45,Main,,0,0,0,,!شوغين-سان
Dialogue: 0,0:13:39.34,0:13:40.39,Main,,0,0,0,,...إيزين-دونو
Dialogue: 0,0:13:41.51,0:13:42.41,Main,,0,0,0,,!رفاق
Dialogue: 0,0:14:22.03,0:14:24.00,Main,,0,0,0,,!لا تستهدفوا الرأس فحسب، بل السرّة أيضًا
Dialogue: 0,0:14:24.64,0:14:26.81,Main,,0,0,0,,!هذا مذهلٌ للغاية
Dialogue: 0,0:14:27.10,0:14:29.27,Main,,0,0,0,,ألديكَ خبرةٌ في الحروب؟
Dialogue: 0,0:14:30.28,0:14:32.95,Main,,0,0,0,,!هذه ليست حربًا، بل إعدامٌ
Dialogue: 0,0:14:33.52,0:14:36.79,Main,,0,0,0,,تطهيرٌ للمتمرّدين الّذين رفعوا أيديهم على جلّادي الشوغون
Dialogue: 0,0:14:37.13,0:14:39.65,Main,,0,0,0,,!سنسدّ منافذ الهرب ونبيدهم عن بكرة أبيهم
Dialogue: 0,0:14:43.65,0:14:45.87,Main,,0,0,0,,لم أستشعر وجودهم
Dialogue: 0,0:14:46.70,0:14:47.75,Main,,0,0,0,,من أنتم؟
Dialogue: 0,0:14:48.03,0:14:51.39,Main,,0,0,0,,يا له من أسطولٍ ضخمٍ، ما الّذي تخطّطون له؟
Dialogue: 0,0:14:52.32,0:14:54.55,Main,,0,0,0,,...لا نيّة لي في مجاراتكم، ولكن
Dialogue: 0,0:14:55.18,0:14:57.56,Main,,0,0,0,,إن انتظرتُ هنا، فسيأتي ذلك الشخص
Dialogue: 0,0:14:58.02,0:14:59.21,Main,,0,0,0,,...أأنتم
Dialogue: 0,0:14:59.57,0:15:01.15,Main,,0,0,0,,ما يُسمّونه بالنينجا في واكوكو؟
Dialogue: 0,0:15:01.42,0:15:03.19,Main,,0,0,0,,حسنٌ، لا يهمّ
Dialogue: 0,0:15:03.53,0:15:04.29,Main,,0,0,0,,اقتلوهم
Dialogue: 0,0:15:10.69,0:15:12.95,Main,,0,0,0,,أتريد رؤية النينجتسو؟
Dialogue: 0,0:15:20.86,0:15:23.32,Main,,0,0,0,,نينبو: اللّهب الزاهد
Dialogue: 0,0:15:26.16,0:15:28.56,Main,,0,0,0,,أبقوا على سفينةٍ واحدةٍ واحرقوا الباقي
Dialogue: 0,0:15:29.12,0:15:31.71,Main,,0,0,0,,سأتولّى أمر هذا
Dialogue: 0,0:15:53.89,0:15:55.95,Main,,0,0,0,,،يسعني رؤيته، تاو الخصم
Dialogue: 0,0:15:56.78,0:15:58.01,Main,,0,0,0,,وتدفّق حركاتهم
Dialogue: 0,0:15:58.69,0:16:00.99,Main,,0,0,0,,مقارنةً بالتينسين-ساما، لديّ فرصةٌ لهزيمتهم
Dialogue: 0,0:16:05.34,0:16:08.24,Main,,0,0,0,,...النينجا والدوشي، ونحن
Dialogue: 0,0:16:08.51,0:16:11.30,Main,,0,0,0,,تبدو كمعركةٍ ثلاثيّة الأطراف، لكنَّ الدوشي لا يهاجمون ماي-سان
Dialogue: 0,0:16:11.69,0:16:13.82,Main,,0,0,0,,والشينوبي لا يهاجمونني أيضًا
Dialogue: 0,0:16:14.50,0:16:16.86,Main,,0,0,0,,لا بُدَّ أنّهم يتصرّفون وفق أوامر سيّدهم
Dialogue: 0,0:16:17.71,0:16:19.75,Main,,0,0,0,,!سنستغلّ هذه الثغرة ونخترق صفوفهم
Dialogue: 0,0:16:24.81,0:16:25.53,Main,,0,0,0,,جياد؟
Dialogue: 0,0:16:47.37,0:16:48.07,Main,,0,0,0,,مرحبًا
Dialogue: 0,0:16:48.90,0:16:50.20,Main,,0,0,0,,!يوزوريها-سان
Dialogue: 0,0:16:50.40,0:16:52.83,Main,,0,0,0,,...حسنٌ، كنتُ سأغيّر ثيابي، ولكن
Dialogue: 0,0:16:52.95,0:16:55.46,Main,,0,0,0,,لم أجد سوى أزياء فنونٍ قتاليّةٍ في قصر ران
Dialogue: 0,0:16:55.58,0:16:57.62,Main,,0,0,0,,استغرقني الأمر بعض الوقت لأعثر على شيءٍ مناسبٍ
Dialogue: 0,0:16:59.13,0:17:02.29,Main,,0,0,0,,في الواقع، كنتُ أنتظر تعافي جراحي فحسب
Dialogue: 0,0:17:03.80,0:17:04.97,Main,,0,0,0,,هل اشتقتِ إليّ؟
Dialogue: 0,0:17:05.16,0:17:05.90,Main,,0,0,0,,!أجل
Dialogue: 0,0:17:10.85,0:17:12.26,Main,,0,0,0,,!يـ-يوزوريها-سان
Dialogue: 0,0:17:12.56,0:17:13.97,Main,,0,0,0,,عليكِ التأكّد من موتهم
Dialogue: 0,0:17:14.31,0:17:16.41,Main,,0,0,0,,!لكنّهم يعملون لصالح الشوغون
Dialogue: 0,0:17:16.68,0:17:18.23,Main,,0,0,0,,!يا لكِ من ساذجةٍ
Dialogue: 0,0:17:18.34,0:17:21.64,Main,,0,0,0,,على عكس غابي، أنتِ لطيفةٌ وساذجةٌ يا ساغيرين
Dialogue: 0,0:17:21.94,0:17:22.66,Main,,0,0,0,,رغم أنّه لا يجدر بكِ أن تكوني كذلك
Dialogue: 0,0:17:23.10,0:17:24.92,Main,,0,0,0,,...تفقّدتُ الأرجاء في طريقي، ولكن
Dialogue: 0,0:17:25.02,0:17:26.78,Main,,0,0,0,,الوضع في غاية السوء
Dialogue: 0,0:17:27.70,0:17:30.49,Main,,0,0,0,,...مقاتلو إيواغاكوري المسلّحون والدوشي الّذين رأيناهم للتوّ
Dialogue: 0,0:17:30.65,0:17:32.39,Main,,0,0,0,,جاؤوا من جهة البوّابة المائيّة
Dialogue: 0,0:17:32.74,0:17:34.65,Main,,0,0,0,,يسيطرون على المخرج على الأرجح
Dialogue: 0,0:17:35.00,0:17:38.23,Main,,0,0,0,,إنّها حربٌ طاحنةٌ في كلّ مكانٍ
Dialogue: 0,0:17:39.10,0:17:40.24,Main,,0,0,0,,...مستحيل
Dialogue: 0,0:17:40.67,0:17:43.93,Main,,0,0,0,,إن كانوا تعزيزاتٍ من الشوغون، فقد نتمكّن من إقناعهم
Dialogue: 0,0:17:44.26,0:17:47.06,Main,,0,0,0,,يا لكِ من ساذجةٍ، يستحيل ذلك في ظلّ نيّة القتل تلك
Dialogue: 0,0:17:47.34,0:17:49.65,Main,,0,0,0,,سيقتلون المجرمين على أقلّ تقديرٍ دون أيّ نقاشٍ
Dialogue: 0,0:17:50.32,0:17:53.69,Main,,0,0,0,,هذا لن يجدي نفعًا، علينا جميعًا العودة معًا
Dialogue: 0,0:17:53.81,0:17:55.86,Main,,0,0,0,,!يا لكِ من ساذجةٍ حقًّا
Dialogue: 0,0:17:56.72,0:17:58.27,Main,,0,0,0,,...هذا ما يعجبني فيكِ، ولكن
Dialogue: 0,0:17:58.48,0:18:00.89,Main,,0,0,0,,ما علينا فعله لم يتغيّر
Dialogue: 0,0:18:01.40,0:18:04.73,Main,,0,0,0,,سينفّذ الجميع هدفنا الأصليّ بأسرع وقتٍ ممكنٍ
Dialogue: 0,0:18:05.37,0:18:07.81,Main,,0,0,0,,هذا الخيار الأفضل، بل هو الخيار الوحيد
Dialogue: 0,0:18:08.23,0:18:10.19,Main,,0,0,0,,أيّ طريقٍ يؤدّي إلى القصر الرئيسيّ؟
Dialogue: 0,0:18:10.33,0:18:12.71,Main,,0,0,0,,سيكون من الأفضل أن نفترق للبحث عنه
Dialogue: 0,0:18:13.88,0:18:17.58,Main,,0,0,0,,أنتِ محقّة، يبدو أنَّ الإكسير في البوّابة المائيّة الآن
Dialogue: 0,0:18:18.82,0:18:21.70,Main,,0,0,0,,هذا يسهّل الأمر بما أنَّ أهدافنا في مكانٍ واحدٍ
Dialogue: 0,0:18:25.82,0:18:26.58,Main,,0,0,0,,...لكن
Dialogue: 0,0:18:27.47,0:18:31.00,Main,,0,0,0,,هل سترافقيننا لإقناع ريين يا ماي-سان؟
Dialogue: 0,0:18:34.08,0:18:34.97,Main,,0,0,0,,!ساغيري-تشان
Dialogue: 0,0:18:40.60,0:18:42.21,Main,,0,0,0,,!إيسوزو-سان
Dialogue: 0,0:18:42.67,0:18:43.90,Main,,0,0,0,,هذا مطمئن
Dialogue: 0,0:18:45.02,0:18:47.38,Main,,0,0,0,,...أنتِ حيّةٌ يا ساغيري-تشا
Dialogue: 0,0:18:50.43,0:18:53.21,Main,,0,0,0,,أهذه يوزوريها من كيشو؟
Dialogue: 0,0:18:54.33,0:18:56.99,Main,,0,0,0,,هل قتلتما النينجا معًا؟
Dialogue: 0,0:18:57.29,0:19:00.61,Main,,0,0,0,,...كـ-كلّا، في الواقع، هناك ظروفٌ
Dialogue: 0,0:19:01.04,0:19:03.97,Main,,0,0,0,,انتهى بنا المطاف بالعمل مع المجرمين نظرًا للوضع
Dialogue: 0,0:19:06.69,0:19:08.27,Main,,0,0,0,,يوزوريها من كيشو
Dialogue: 0,0:19:08.72,0:19:11.58,Main,,0,0,0,,،مُدانةٌ بالتسلّل إلى قلعة ساغيوا والقتل
Dialogue: 0,0:19:11.85,0:19:14.83,Main,,0,0,0,,وجرائم أخرى عديدة، وقد حُكم عليها بالإعدام
Dialogue: 0,0:19:15.41,0:19:18.21,Main,,0,0,0,,أزهقتْ أرواحًا كثيرةً
Dialogue: 0,0:19:19.43,0:19:22.05,Main,,0,0,0,,أرواح ضحاياها وعائلاتهم على حدٍّ سواءٍ
Dialogue: 0,0:19:24.23,0:19:26.69,Main,,0,0,0,,لا تنخدعي يا ساغيري-تشان
Dialogue: 0,0:19:27.08,0:19:28.25,Main,,0,0,0,,إنّها شرّيرةٌ
Dialogue: 0,0:19:29.16,0:19:31.11,Main,,0,0,0,,نوروغاي؟
Dialogue: 0,0:19:31.27,0:19:32.32,Main,,0,0,0,,!يا له من اسمٍ غريبٍ
Dialogue: 0,0:19:32.62,0:19:37.04,Main,,0,0,0,,،رفض الخضوع، وعرقلة المهامّ الرسميّة
Dialogue: 0,0:19:37.19,0:19:39.91,Main,,0,0,0,,...والإخلال بنظام عصرٍ يسوده السلام
Dialogue: 0,0:19:40.91,0:19:42.48,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:19:43.18,0:19:47.78,Main,,0,0,0,,على كلٍّ، أنتِ مجرمةٌ دنيئةٌ تمرّدتْ على الشوغون-ساما
Dialogue: 0,0:19:48.08,0:19:51.26,Main,,0,0,0,,شرّير إيو، آزا تشوبي
Dialogue: 0,0:19:51.51,0:19:55.83,Main,,0,0,0,,مذنبٌ بتهم القتل، والسرقة، والاعتداء، والابتزاز
Dialogue: 0,0:19:56.64,0:19:58.19,Main,,0,0,0,,يا له من أمرٍ مزعجٍ
Dialogue: 0,0:19:58.82,0:20:00.12,Main,,0,0,0,,هذا مذهلٌ أيّها الشابّ
Dialogue: 0,0:20:00.78,0:20:04.61,Main,,0,0,0,,تستحقّ الإعدام مئة مرّةٍ على هذا، أنتَ مجرمٌ دنيءٌ حقًّا
Dialogue: 0,0:20:05.56,0:20:07.67,Main,,0,0,0,,...بالمناسبة يا توما-كن
Dialogue: 0,0:20:08.16,0:20:10.87,Main,,0,0,0,,راودني الفضول منذ انضمامكَ إلينا
Dialogue: 0,0:20:11.45,0:20:15.74,Main,,0,0,0,,أيُعقل أنّكَ واحدٌ من أولئك؟ هل أنتَ كذلك؟
Dialogue: 0,0:20:16.00,0:20:19.30,Main,,0,0,0,,قرّرنا معاقبة غير المجرمين أيضًا
Dialogue: 0,0:20:19.49,0:20:21.03,Main,,0,0,0,,...ثأرًا للأسايمون الراحلين
Dialogue: 0,0:20:22.98,0:20:24.90,Main,,0,0,0,,ولأجل شرف أخي
Dialogue: 0,0:20:25.06,0:20:29.19,Main,,0,0,0,,،ووحوش الجزيرة وكلّ من ضلّ طريقه لحمايتهم على حدٍّ سواءٍ
Dialogue: 0,0:20:29.70,0:20:32.72,Main,,0,0,0,,حتّى لو كان ذلك الشخص من الأسايمون
Dialogue: 0,0:20:33.60,0:20:37.10,Main,,0,0,0,,لذا أرجوكِ يا ساغيري-تشان، ابتعدي عنها
Dialogue: 0,0:20:37.60,0:20:39.05,Main,,0,0,0,,تعالي إلى هنا رجاءً
Dialogue: 0,0:20:42.62,0:20:45.91,Main,,0,0,0,,بمجرّد أن نجد طريقًا سالكًا، سنعود لإحضار الأخوين
Dialogue: 0,0:20:46.44,0:20:48.20,Main,,0,0,0,,أنتَ شديد الضمير حقًّا
Dialogue: 0,0:20:48.26,0:20:49.87,Main,,0,0,0,,لنتخلّ عنهما فحسب
Dialogue: 0,0:20:50.33,0:20:52.98,Main,,0,0,0,,كلّا، سنعود لإحضارهما
Dialogue: 0,0:20:54.57,0:20:56.29,Main,,0,0,0,,أنتَ تاميا غانتيتسوساي، أليس كذلك؟
Dialogue: 0,0:20:59.43,0:21:01.41,Main,,0,0,0,,،مذنبٌ بتهمة الإساءة للدايميو
Dialogue: 0,0:21:02.03,0:21:03.86,Main,,0,0,0,,...والاعتداء في مناطق شتّى
Dialogue: 0,0:21:04.49,0:21:07.69,Main,,0,0,0,,مجرمٌ دنيءٌ اقترف جرائم لا تُحصى
Dialogue: 0,0:21:10.97,0:21:12.07,Main,,0,0,0,,!يا للقشعريرة
Dialogue: 0,0:21:16.97,0:21:17.91,Main,,0,0,0,,شو-كن
Dialogue: 0,0:22:05.56,0:22:09.08,Main,,0,0,0,,...مهما كانت الصعاب الّتي تنتظرني
Dialogue: 0,0:22:11.93,0:22:14.42,Main,,0,0,0,,...ومهما كان الطريق ملطّخًا بالدماء
Dialogue: 0,0:22:15.13,0:22:18.40,Main,,0,0,0,,سأعود حيًّا من أجلكِ حتمًا
Dialogue: 0,0:22:49.10,0:22:51.11,Main,,0,0,0,,مهما كان الجحيم الّذي سأواجهه
