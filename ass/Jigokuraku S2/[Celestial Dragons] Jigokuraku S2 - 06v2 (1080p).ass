Dialogue: 1,0:00:16.38,0:00:19.37,Main,,0,0,0,,واثق أنّكم دبّرتم مكيدةً ما
Dialogue: 1,0:00:19.77,0:00:21.34,Main,,0,0,0,,لكنّها ذهبت أدراج الرياح
Dialogue: 1,0:00:22.13,0:00:25.13,Main,,0,0,0,,تجنّبوا مواجهة التينسين-ساما مهما كلّف الأمر
Dialogue: 1,0:00:25.13,0:00:27.51,Main,,0,0,0,,ستفشل الخطّة إن واجهناهم
Dialogue: 1,0:00:27.51,0:00:28.88,Main,,0,0,0,,غابيمارو
Dialogue: 1,0:00:32.59,0:00:33.81,Main,,0,0,0,,انتهى الأمر
Dialogue: 1,0:00:34.39,0:00:36.30,Main,,0,0,0,,انتهى؟
Dialogue: 1,0:00:36.30,0:00:38.89,Main,,0,0,0,,ما العمل إن اضطررنا لمواجهتهم؟
Dialogue: 1,0:00:38.89,0:00:40.90,Main,,0,0,0,,أنهرب فحسب؟
Dialogue: 1,0:00:42.38,0:00:44.90,Main,,0,0,0,,في تلك اللحظة، تنتهي الخطّة
Dialogue: 1,0:00:46.82,0:00:48.53,Main,,0,0,0,,حان وقت الخطّة البديلة
Dialogue: 1,0:00:49.70,0:00:51.28,Main,,0,0,0,,استعدّوا
Dialogue: 1,0:00:51.28,0:00:53.28,Main,,0,0,0,,قاتلوا بكلّ ما أوتيتم من قوّة
Dialogue: 1,0:00:53.82,0:00:56.79,Main,,0,0,0,,لا مفرّ إن اضطررنا لمواجهتهم
Dialogue: 1,0:00:57.35,0:00:58.70,Main,,0,0,0,,لن نهرب
Dialogue: 1,0:00:58.70,0:01:00.21,Main,,0,0,0,,ولن نستسلم أيضًا
Dialogue: 1,0:01:01.29,0:01:03.79,Main,,0,0,0,,سنهزمك ونغادر الجزيرة
Dialogue: 1,0:02:39.56,0:02:43.64,Main,,0,0,0,,سأقولها بوضوح، الاشتباك معي سيكون عبثًا
Dialogue: 1,0:02:47.15,0:02:49.97,Main,,0,0,0,,الخطّة البديلة؟ أتعني استخدام القوّة الغاشمة؟
Dialogue: 1,0:02:49.97,0:02:52.99,Main,,0,0,0,,كلّا، لديّ خطّة
Dialogue: 1,0:02:57.35,0:02:58.91,Main,,0,0,0,,!يا أختي
Dialogue: 1,0:02:58.91,0:03:02.02,Main,,0,0,0,,عليكِ العودة إلى أخينا والمعلّم الأكبر
Dialogue: 1,0:03:02.02,0:03:06.04,Main,,0,0,0,,فقد نفاكِ أخونا بدافع الحبّ
Dialogue: 1,0:03:06.32,0:03:09.29,Main,,0,0,0,,يحزنني رؤية خلافكما
Dialogue: 1,0:03:09.79,0:03:14.59,Main,,0,0,0,,إن كنتِ ما تزالين تعارضين زهرة الوايتان، فلا طائل من ذلك
Dialogue: 1,0:03:14.59,0:03:18.91,Main,,0,0,0,,سيكتمل التان المثاليّ ويصبح إكسير حياةٍ قريبًا
Dialogue: 1,0:03:19.37,0:03:21.43,Main,,0,0,0,,تان لا يحوّل البشر إلى زهور
Dialogue: 1,0:03:21.64,0:03:23.56,Main,,0,0,0,,ماذا؟
Dialogue: 1,0:03:23.84,0:03:28.32,Main,,0,0,0,,تعلّمنا كيفيّة تنقيته بفضل تعاون البشر معنا
Dialogue: 1,0:03:28.81,0:03:31.80,Main,,0,0,0,,اكتملت أبحاثنا حول زهرة الوايتان بالفعل
Dialogue: 1,0:03:32.32,0:03:34.99,Main,,0,0,0,,لم يعد لدينا سبب للقتال
Dialogue: 1,0:03:35.32,0:03:37.68,Main,,0,0,0,,ما ينقصنا هو الكمية فحسب
Dialogue: 1,0:03:37.68,0:03:41.02,Main,,0,0,0,,المزيد من الموادّ ذات الجودة العالية
Dialogue: 1,0:03:41.02,0:03:43.62,Main,,0,0,0,,ولهذه الغاية، بدأ أخونا الطقس
Dialogue: 1,0:03:43.62,0:03:46.74,Main,,0,0,0,,طقس هيكيجي فوكوشو
Dialogue: 1,0:03:47.77,0:03:51.98,Main,,0,0,0,,،أنتِ لا تدركين معاناة أخينا بعد
Dialogue: 1,0:03:51.98,0:03:55.13,Main,,0,0,0,,لكنّكما ستتفاهمان الآن حتمًا
Dialogue: 1,0:03:55.13,0:03:59.89,Main,,0,0,0,,لكنّي أريد لقاء ريين والمعلّم مرّة أخيرة
Dialogue: 1,0:04:00.71,0:04:02.39,Main,,0,0,0,,...ماي-سان
Dialogue: 1,0:04:04.53,0:04:08.54,Main,,0,0,0,,اشتقتُ للجميع أيضًا
Dialogue: 1,0:04:08.54,0:04:11.38,Main,,0,0,0,,لكنّي فهمتُ الآن
Dialogue: 1,0:04:11.38,0:04:16.02,Main,,0,0,0,,أنا مختلفة عن الجميع
Dialogue: 1,0:04:26.49,0:04:30.12,Main,,0,0,0,,الحياة، والموت، والخلود... كلّه محزن
Dialogue: 1,0:04:31.50,0:04:33.38,Main,,0,0,0,,جئتُ لرؤية الجميع
Dialogue: 1,0:04:36.84,0:04:39.74,Main,,0,0,0,,جئتُ لأودّعكم
Dialogue: 1,0:04:40.49,0:04:42.54,Main,,0,0,0,,سأغادر الجزيرة
Dialogue: 1,0:04:51.42,0:04:52.73,Main,,0,0,0,,ما باليد حيلة إذن
Dialogue: 1,0:04:52.73,0:04:54.53,Main,,0,0,0,,لننهِ هذا أولًا
Dialogue: 1,0:04:54.91,0:04:57.33,Main,,0,0,0,,بدأ الطقس بالفعل
Dialogue: 1,0:04:57.88,0:05:00.03,Main,,0,0,0,,آخر ما نحتاجه هو القرابين
Dialogue: 1,0:05:00.56,0:05:04.00,Main,,0,0,0,,بعبارة أخرى، أنتم
Dialogue: 1,0:05:09.68,0:05:13.09,Main,,0,0,0,,شرط النصر واحد
Dialogue: 1,0:05:13.09,0:05:15.76,Main,,0,0,0,,تدمير التاندين بتاو مُضادّ له
Dialogue: 1,0:05:15.76,0:05:18.86,Main,,0,0,0,,بعبارة أخرى، التدمير بتاو ذو خاصيّة متفوّقة
Dialogue: 1,0:05:18.86,0:05:23.80,Main,,0,0,0,,تتغيّر المعركة وفقًا لخاصيّة تاو الخصم
Dialogue: 1,0:05:24.06,0:05:28.89,Main,,0,0,0,,على سبيل المثال يا غابيمارو، التاو الناريّ خاصّتك يتفوّق على معدن غويفا
Dialogue: 1,0:05:29.69,0:05:33.14,Main,,0,0,0,,لكن إن واجهتَ ران ذا خاصيّة الماء فستكون في مأزق
Dialogue: 1,0:05:33.14,0:05:36.04,Main,,0,0,0,,لمس خصمك سيضعف تاو نارك
Dialogue: 1,0:05:36.04,0:05:38.86,Main,,0,0,0,,حتّى لو دمّرت التاندين، فلن يكون ذلك قاتلًا
Dialogue: 1,0:05:38.86,0:05:42.07,Main,,0,0,0,,بعبارة أخرى، لا وسيلة لهزيمتهم
Dialogue: 1,0:05:42.47,0:05:45.39,Main,,0,0,0,,فضلًا عن أنّهم يملكون تاو أكثر منّا بكثير
Dialogue: 1,0:05:46.06,0:05:47.39,Main,,0,0,0,,ماذا تنوي أن تفعل؟
Dialogue: 1,0:05:48.92,0:05:50.29,Main,,0,0,0,,لديّ فكرة
Dialogue: 1,0:05:50.29,0:05:54.64,Main,,0,0,0,,يا لسوء الحظّ، اضطررنا لمواجهة أسوأ خصم لغابيمارو؟
Dialogue: 1,0:05:54.64,0:05:55.38,Main,,0,0,0,,ساغيري
Dialogue: 1,0:05:56.37,0:05:59.20,Main,,0,0,0,,خذي ماي واذهبي إلى الغرفة الّتي تحوي الإكسير
Dialogue: 1,0:05:59.20,0:06:01.09,Main,,0,0,0,,سأعيقه أنا ويوزوريها
Dialogue: 1,0:06:01.09,0:06:03.18,Main,,0,0,0,,ماذا؟ لِمَ أنا؟
Dialogue: 1,0:06:03.18,0:06:04.92,Main,,0,0,0,,تاو ران هو الماء
Dialogue: 1,0:06:05.21,0:06:08.45,Main,,0,0,0,,وأنتِ الوحيدة الّتي تملك تاو الأرض المضادّ له
Dialogue: 1,0:06:10.44,0:06:14.12,Main,,0,0,0,,...غابيمارو... هذا المكان... مختلف
Dialogue: 1,0:06:14.12,0:06:17.31,Main,,0,0,0,,ليس قصر الرينتان، لا يوجد إكسير
Dialogue: 1,0:06:17.31,0:06:18.44,Main,,0,0,0,,!ماذا؟
Dialogue: 1,0:06:25.05,0:06:25.78,Main,,0,0,0,,إنّه سريع
Dialogue: 1,0:06:31.97,0:06:33.61,Main,,0,0,0,,أختي محقّة
Dialogue: 1,0:06:33.61,0:06:36.31,Main,,0,0,0,,هذا ليس قصر الرينتان
Dialogue: 1,0:06:36.81,0:06:39.92,Main,,0,0,0,,إنّه قصري، قصر الدوين
Dialogue: 1,0:06:39.92,0:06:41.21,Main,,0,0,0,,كيف؟
Dialogue: 1,0:06:41.67,0:06:45.81,Main,,0,0,0,,لكنّنا تحقّقنا من مواقع قصر الرينتان والتاو والإكسير بدقّة
Dialogue: 1,0:06:45.81,0:06:50.40,Main,,0,0,0,,التلاعب بتاو الجمادات أسهل بكثير من تاو الكائنات الحيّة
Dialogue: 1,0:06:51.83,0:06:53.93,Main,,0,0,0,,نأمره بالتشكّل فحسب
Dialogue: 1,0:06:54.22,0:06:57.31,Main,,0,0,0,,بناء المباني والتماثيل الحجريّة على الجزيرة
Dialogue: 1,0:06:57.63,0:07:01.37,Main,,0,0,0,,الترميمات القائمة على الفينغ شوي هي مسؤوليّتي
Dialogue: 1,0:07:01.85,0:07:07.98,Main,,0,0,0,,كان تغيير تصميم القلعة لمواجهة تطفّلكم بسيطًا
Dialogue: 1,0:07:07.98,0:07:10.72,Main,,0,0,0,,تاو الجثث يماثل الجماد
Dialogue: 1,0:07:10.72,0:07:13.87,Main,,0,0,0,,موّهته ليبدو كالتان الإكسير لا أكثر
Dialogue: 1,0:07:14.69,0:07:15.37,Main,,0,0,0,,!ماي-سان
Dialogue: 1,0:07:16.50,0:07:19.00,Main,,0,0,0,,أرأيتم؟
Dialogue: 1,0:07:19.00,0:07:22.50,Main,,0,0,0,,والآن ابقي ساكنة يا أختي
Dialogue: 1,0:07:22.50,0:07:25.67,Main,,0,0,0,,علينا حسم الأمر هنا في نهاية المطاف
Dialogue: 1,0:07:25.67,0:07:26.56,Main,,0,0,0,,!غابيمارو
Dialogue: 1,0:07:26.56,0:07:27.30,Main,,0,0,0,,!يوزوريها
Dialogue: 1,0:07:27.30,0:07:29.06,Main,,0,0,0,,سننفّذ تلك الخطّة
Dialogue: 1,0:07:34.48,0:07:37.06,Main,,0,0,0,,!بديع، يا له من جسد مفعم بالحياة
Dialogue: 1,0:07:37.36,0:07:38.84,Main,,0,0,0,,لكن للأسف
Dialogue: 1,0:07:38.84,0:07:42.90,Main,,0,0,0,,لن تسبّب لي جرحًا مميتًا بتاو كهذا
Dialogue: 1,0:07:45.19,0:07:48.21,Main,,0,0,0,,هذا هو هدفكم الحقيقي إذن
Dialogue: 1,0:07:49.15,0:07:52.31,Main,,0,0,0,,يمكن شحن الأسلحة بالتاو، أليس كذلك؟
Dialogue: 1,0:07:52.31,0:07:53.48,Main,,0,0,0,,أجل
Dialogue: 1,0:07:53.48,0:07:57.51,Main,,0,0,0,,أليست الأسلحة بعيدة المدى أفضل من القريبة إذن؟
Dialogue: 1,0:07:57.51,0:08:00.61,Main,,0,0,0,,إنّها أكثر أمانًا ومباغتة الخصم بها أسهل
Dialogue: 1,0:08:00.61,0:08:04.88,Main,,0,0,0,,ربّما يترك التينسين-ساما دفاعاتهم مفتوحة نظرًا لكون أجسادهم خالدةً
Dialogue: 1,0:08:07.98,0:08:10.12,Main,,0,0,0,,!لماذا؟ يُفترض أن عنصري مضادّ
Dialogue: 1,0:08:14.47,0:08:17.85,Main,,0,0,0,,كما ظننت، صدّ هجماتهم وحده يتطلّب جهدًا كبيرًا
Dialogue: 1,0:08:18.04,0:08:20.33,Main,,0,0,0,,أهذا تأثير التضادّ أيضًا؟
Dialogue: 1,0:08:20.43,0:08:23.99,Main,,0,0,0,,لكنّ الأهم من ذلك أنّه يختلف عن قتال جوجين
Dialogue: 1,0:08:24.18,0:08:26.11,Main,,0,0,0,,ما سرّ هذه الصلابة؟
Dialogue: 1,0:08:29.39,0:08:32.99,Main,,0,0,0,,أمدّد التاو وأجمعه معًا
Dialogue: 1,0:08:33.33,0:08:37.24,Main,,0,0,0,,فيغدو صلبًا ومرنًا مثل ألياف العضلات
Dialogue: 1,0:08:37.24,0:08:39.62,Main,,0,0,0,,بمعنى آخر؟
Dialogue: 1,0:08:40.62,0:08:43.88,Main,,0,0,0,,كأنّه يرتدي درعًا صلبًا من التاو عالي الكثافة
Dialogue: 1,0:08:44.26,0:08:48.16,Main,,0,0,0,,إن كان ذلك الهجوم المنسّق خطّتكم، فهو بلا جدوى
Dialogue: 1,0:08:49.57,0:08:53.93,Main,,0,0,0,,لا يملك التاو أيّ نقاط ضعف أو ثغرات على عكس الدروع
Dialogue: 1,0:08:53.93,0:08:57.36,Main,,0,0,0,,هذا هو الانسجام بين العضلات والتاو
Dialogue: 1,0:08:57.36,0:08:59.43,Main,,0,0,0,,الجسد الحقيقيّ
Dialogue: 1,0:08:59.69,0:09:02.12,Main,,0,0,0,,هل جميع التينسين-ساما مجانين هكذا؟
Dialogue: 1,0:09:02.12,0:09:03.19,Main,,0,0,0,,لا تسأليني
Dialogue: 1,0:09:03.49,0:09:05.29,Main,,0,0,0,,لنُزِلْهُ ما دامت الفرصة سانحةً
Dialogue: 1,0:09:22.67,0:09:24.32,Main,,0,0,0,,نينبو: عاصفة الحجارة
Dialogue: 1,0:09:28.51,0:09:29.79,Main,,0,0,0,,!غابيمارو
Dialogue: 1,0:09:30.91,0:09:33.14,Main,,0,0,0,,ليس صلبًا فحسب
Dialogue: 1,0:09:33.54,0:09:36.87,Main,,0,0,0,,بل يتقن فنون القتال أكثر من مودان
Dialogue: 1,0:09:36.87,0:09:38.30,Main,,0,0,0,,...بهذا المعدّل
Dialogue: 1,0:09:39.64,0:09:41.44,Main,,0,0,0,,لا تقلقي
Dialogue: 1,0:09:42.90,0:09:44.65,Main,,0,0,0,,توقّعتُ هذا
Dialogue: 1,0:09:45.15,0:09:46.88,Main,,0,0,0,,فهمتُ الأمر الآن
Dialogue: 1,0:09:46.88,0:09:48.69,Main,,0,0,0,,لنبدأ يا يوزوريها
Dialogue: 1,0:09:49.54,0:09:51.51,Main,,0,0,0,,!حسنٌ، حسنٌ، أخيرًا
Dialogue: 1,0:09:51.51,0:09:53.28,Main,,0,0,0,,ظننتُ أنّنا سنموت
Dialogue: 1,0:09:53.93,0:09:55.28,Main,,0,0,0,,يبدآن؟
Dialogue: 1,0:09:55.93,0:09:58.37,Main,,0,0,0,,ألم ينفّذا خطّتهما بعد؟
Dialogue: 1,0:10:00.62,0:10:03.87,Main,,0,0,0,,لم تتغيّر كمية التاو ولا خصائصه
Dialogue: 1,0:10:03.87,0:10:07.63,Main,,0,0,0,,لا يُفترض أن يتمكّنوا من خدش عضلاتي حتّى
Dialogue: 1,0:10:07.63,0:10:10.21,Main,,0,0,0,,حاولا قدر ما تشاءان، ستكون النتيجة نفسها
Dialogue: 1,0:10:19.50,0:10:21.10,Main,,0,0,0,,يبدو أنَّ ذلك نجح
Dialogue: 1,0:10:26.02,0:10:28.27,Main,,0,0,0,,جرّبنا الطريقة الأولى
Dialogue: 1,0:10:28.27,0:10:30.54,Main,,0,0,0,,لنجرّب الثانية الآن
Dialogue: 1,0:10:43.78,0:10:46.16,Main,,0,0,0,,أسماء من نزلوا الجزيرة
Dialogue: 1,0:10:46.16,0:10:48.99,Main,,0,0,0,,تتطلّب الطقوس واللعنات أسماءً
Dialogue: 1,0:10:48.99,0:10:52.81,Main,,0,0,0,,سنستخدم أسماءهم لطقس هيكيجي فوكوشو
Dialogue: 1,0:10:52.81,0:10:55.09,Main,,0,0,0,,إذن، هل نقبض عليهم ونجبرهم على الكلام؟
Dialogue: 1,0:10:55.09,0:10:56.55,Main,,0,0,0,,غابيمارو
Dialogue: 1,0:10:56.55,0:11:00.49,Main,,0,0,0,,غابيمارو الأجوف، وتاميا غانتيتسوساي
Dialogue: 1,0:11:00.97,0:11:06.13,Main,,0,0,0,,حفظتُ جميع أسماء المجرمين والجلّادين من السجلّات
Dialogue: 1,0:11:06.13,0:11:09.17,Main,,0,0,0,,رغم أنّي لا أعرف من نجا منهم
Dialogue: 1,0:11:09.75,0:11:11.99,Main,,0,0,0,,أخي بينهم
Dialogue: 1,0:11:12.33,0:11:14.63,Main,,0,0,0,,قاتلناك مرّة بالفعل
Dialogue: 1,0:11:15.29,0:11:17.60,Main,,0,0,0,,لا طائل من إخفاء الأمر الآن
Dialogue: 1,0:11:17.60,0:11:20.27,Main,,0,0,0,,لديَّ شرط واحد لمساعدتكم
Dialogue: 1,0:11:20.66,0:11:22.51,Main,,0,0,0,,سلامة أخي
Dialogue: 1,0:11:22.51,0:11:25.84,Main,,0,0,0,,أنا مستعدّ للوقوف في صفّكم لضمان ذلك
Dialogue: 1,0:11:25.84,0:11:29.84,Main,,0,0,0,,خذوني إلى طقسكم ذاك
Dialogue: 1,0:11:30.27,0:11:33.27,Main,,0,0,0,,سأضمّ أخي إلى صفّنا بنفسي
Dialogue: 1,0:11:33.27,0:11:35.22,Main,,0,0,0,,لا تتدخّلوا في الأمر
Dialogue: 1,0:11:36.96,0:11:39.38,Main,,0,0,0,,أخبرنا بأسماء الجميع إذن
Dialogue: 1,0:11:40.05,0:11:42.43,Main,,0,0,0,,سأستخدم التعويذات لرؤية حالتهم الحالية
Dialogue: 1,0:11:43.98,0:11:45.83,Main,,0,0,0,,كييون الملتوي
Dialogue: 1,0:11:49.65,0:11:52.10,Main,,0,0,0,,يامادا أسايمون كيشو
Dialogue: 1,0:11:53.94,0:11:55.65,Main,,0,0,0,,روكوروتو
Dialogue: 1,0:11:56.76,0:11:59.04,Main,,0,0,0,,يامادا أسايمون إيزين
Dialogue: 1,0:12:00.54,0:12:01.99,Main,,0,0,0,,أكاغينو
Dialogue: 1,0:12:03.47,0:12:05.80,Main,,0,0,0,,يامادا أسايمون شيون
Dialogue: 1,0:12:16.21,0:12:19.29,Main,,0,0,0,,حيّ، عنصره الخشب
Dialogue: 1,0:12:19.42,0:12:22.19,Main,,0,0,0,,يُحسن استخدام التاو إلى حدٍّ كبير
Dialogue: 1,0:12:23.00,0:12:25.81,Main,,0,0,0,,واجه جوجين في قصر التايسوكو
Dialogue: 1,0:12:27.31,0:12:31.66,Main,,0,0,0,,لا يضادّ عنصر شيون عنصر الماء لدى جوجين
Dialogue: 1,0:12:31.66,0:12:34.40,Main,,0,0,0,,لذا لا يملك وسيلة لقتله
Dialogue: 1,0:12:34.40,0:12:36.99,Main,,0,0,0,,ترافقه نوروغاي وعنصرها الماء
Dialogue: 1,0:12:36.99,0:12:39.20,Main,,0,0,0,,،هجماتهما فعّالة ضدّ جوجين
Dialogue: 1,0:12:39.20,0:12:41.04,Main,,0,0,0,,لكنّ مهارتهما في التاو ضعيفة
Dialogue: 1,0:12:41.04,0:12:42.73,Main,,0,0,0,,لا فرصة لديهما
Dialogue: 1,0:12:50.29,0:12:52.75,Main,,0,0,0,,ومع ذلك، أستشعر غضبًا عارمًا
Dialogue: 1,0:12:53.58,0:12:56.74,Main,,0,0,0,,تؤثّر المشاعر في تاو البشر بشكل كبير
Dialogue: 1,0:12:56.74,0:12:58.46,Main,,0,0,0,,ينبغي ألّا نستهين بهما
Dialogue: 1,0:12:58.88,0:13:02.80,Main,,0,0,0,,يامادا أسايمون فوتشي، وتاميا غانتيتسوساي
Dialogue: 1,0:13:03.95,0:13:07.66,Main,,0,0,0,,واجها تاوفا وجوفا في قصر البوتشو
Dialogue: 1,0:13:07.66,0:13:11.29,Main,,0,0,0,,،يضادّ عنصر المعدن لدى فوتشي تاوفا
Dialogue: 1,0:13:11.29,0:13:14.43,Main,,0,0,0,,لكنّ تدريبهما على التاو غير كافٍ
Dialogue: 1,0:13:14.43,0:13:16.98,Main,,0,0,0,,وبالمقابل، يضادّ عنصر نار جوفا فوتشي
Dialogue: 1,0:13:16.98,0:13:19.49,Main,,0,0,0,,سيُقتَلان كلاهما
Dialogue: 1,0:13:19.86,0:13:21.03,Main,,0,0,0,,...و
Dialogue: 1,0:13:26.99,0:13:29.99,Main,,0,0,0,,سيضمّ تشوبي أخاه الأصغر إلينا
Dialogue: 1,0:13:29.99,0:13:31.59,Main,,0,0,0,,سيكون ذلك سهلًا
Dialogue: 1,0:13:33.21,0:13:35.34,Main,,0,0,0,,...ينبغي أن نصُبَّ جام تركيزنا
Dialogue: 1,0:13:35.34,0:13:37.02,Main,,0,0,0,,على هذا الرجل
Dialogue: 1,0:13:39.15,0:13:42.72,Main,,0,0,0,,أهذه هي الخطوة الأولى الّتي ذكرها غابيمارو؟
Dialogue: 1,0:13:44.84,0:13:48.06,Main,,0,0,0,,التاو أشبه بتيّار يحيط بالجسد
Dialogue: 1,0:13:48.06,0:13:50.19,Main,,0,0,0,,إنّه ظاهرة فيزيائيّة
Dialogue: 1,0:13:50.19,0:13:53.42,Main,,0,0,0,,سرعة التدفّق وحجمه يحدّدان القوّة
Dialogue: 1,0:13:56.19,0:13:59.37,Main,,0,0,0,,والخاصيّة هي اختلاف اتجاه التدفّق
Dialogue: 1,0:13:59.73,0:14:03.45,Main,,0,0,0,,التوليد تيّار يدعم تدفّقك
Dialogue: 1,0:14:03.86,0:14:06.16,Main,,0,0,0,,والتضادّ تيّار يوقفه
Dialogue: 1,0:14:07.31,0:14:12.56,Main,,0,0,0,,لكن تدفّق تاو التينسين-ساما هائل لدرجة أنَّ قوانين الطبيعة لا تسري عليه
Dialogue: 1,0:14:13.11,0:14:14.96,Main,,0,0,0,,ثمّة ثلاثة تدابير مضادّة
Dialogue: 1,0:14:15.51,0:14:18.75,Main,,0,0,0,,التفوّق في التاو لحظيًّا أو موضعيًّا
Dialogue: 1,0:14:19.13,0:14:24.83,Main,,0,0,0,,أو العكس، إضعاف التاو جزئيًّا وصدّ الهجوم
Dialogue: 1,0:14:25.44,0:14:29.47,Main,,0,0,0,,فلا يحدث تسارع بالتوليد ولا تنافر بالتضادّ
Dialogue: 1,0:14:29.47,0:14:34.10,Main,,0,0,0,,انضمّ لتيّار خصمك وردّه عليه
Dialogue: 1,0:14:39.88,0:14:43.36,Main,,0,0,0,,يشبه ما يُسمّى في "التاي تشي" بتحييد القوّة أو تحويلها
Dialogue: 1,0:14:43.89,0:14:46.97,Main,,0,0,0,,إنّها تقنية لردّ قوّة الخصم عليه
Dialogue: 1,0:14:46.97,0:14:48.96,Main,,0,0,0,,أهذا ممكنٌ أصلًا؟
Dialogue: 1,0:14:48.96,0:14:52.70,Main,,0,0,0,,ليس سهلًا، لكنّه تطبيق لما تعلّمناه
Dialogue: 1,0:14:52.97,0:14:56.28,Main,,0,0,0,,تعلّمتُ استغلال تاو الخصم عبر التدريب مع نوروغاي
Dialogue: 1,0:14:56.96,0:14:59.69,Main,,0,0,0,,وتعلّمتُ إخماده لأقصى حدٍّ من يوزوريها
Dialogue: 1,0:15:00.21,0:15:03.59,Main,,0,0,0,,وتعلّمتُ التحكّم به موضعيًّا من شيون
Dialogue: 1,0:15:03.59,0:15:04.72,Main,,0,0,0,,...و
Dialogue: 1,0:15:10.35,0:15:13.49,Main,,0,0,0,,...لمزامنة أنفاسي مع تاو الخصم
Dialogue: 1,0:15:16.10,0:15:19.06,Main,,0,0,0,,عليَّ الجمع بين الهدوء والحدّة
Dialogue: 1,0:15:19.49,0:15:23.15,Main,,0,0,0,,بضبط عقلي على مسارٍ أوسط، أصدّ هجمات الخصم
Dialogue: 1,0:15:23.15,0:15:28.53,Main,,0,0,0,,تعلّمتُ هذه التقنيّة منكِ سابقًا يا ساغيري
Dialogue: 1,0:15:28.85,0:15:30.76,Main,,0,0,0,,هذه خلاصة كلّ ما تعلّمته إذن
Dialogue: 1,0:15:30.76,0:15:34.29,Main,,0,0,0,,أجل، سأضربهم بكلّ ما أملك
Dialogue: 1,0:15:38.59,0:15:41.98,Main,,0,0,0,,إخماد التاو يضعف دفاعي أيضًا
Dialogue: 1,0:15:42.34,0:15:45.50,Main,,0,0,0,,،لا بأس إن تمكّنتُ من مواصلة صدّ الهجمات
Dialogue: 1,0:15:45.50,0:15:47.97,Main,,0,0,0,,لكنَّ مجرّد خدش واحد سيشكّل عبئًا كبيرًا عليّ
Dialogue: 1,0:15:48.35,0:15:50.27,Main,,0,0,0,,والإصابة المباشرة ستكون وخيمةً
Dialogue: 1,0:15:52.24,0:15:54.33,Main,,0,0,0,,هذا مثير للإعجاب
Dialogue: 1,0:15:54.33,0:15:55.85,Main,,0,0,0,,،إن أمعنتُ النظر
Dialogue: 1,0:15:55.85,0:15:59.98,Main,,0,0,0,,أرى أنّك بدأتَ تطوير التاو بعد وصولك للجزيرة
Dialogue: 1,0:15:59.98,0:16:02.98,Main,,0,0,0,,ومع ذلك، بلغتَ هذا المستوى
Dialogue: 1,0:16:06.59,0:16:11.46,Main,,0,0,0,,من تفتّحت بصيرتهم بتعرّضهم لتاو الجزيرة الكثيف
Dialogue: 1,0:16:11.58,0:16:14.66,Main,,0,0,0,,كثرٌ هم البشر الّذين يدركون وجود التاو
Dialogue: 1,0:16:14.66,0:16:19.40,Main,,0,0,0,,بل إنَّ ذلك أحد أهداف الجزيرة
Dialogue: 1,0:16:19.93,0:16:23.73,Main,,0,0,0,,لكنّ ذلك لا يفسّر قدرتك على التكيّف
Dialogue: 1,0:16:23.73,0:16:25.26,Main,,0,0,0,,لديك موهبة حقيقيّة
Dialogue: 1,0:16:25.26,0:16:27.63,Main,,0,0,0,,تكفي لإبهاري
Dialogue: 1,0:16:28.01,0:16:29.60,Main,,0,0,0,,موهبة؟
Dialogue: 1,0:16:30.23,0:16:31.98,Main,,0,0,0,,موهبة، أتقول؟
Dialogue: 1,0:16:32.86,0:16:34.97,Main,,0,0,0,,هذه ليست موهبة
Dialogue: 1,0:16:35.68,0:16:38.89,Main,,0,0,0,,بل الملاذ الأخير الّذي وُلد من رحم المعاناة
Dialogue: 1,0:16:41.55,0:16:46.69,Main,,0,0,0,,وخلاصة ما وجده البشر وسط التضحيات الكثيرة الّتي قدّموها
Dialogue: 1,0:16:46.97,0:16:49.83,Main,,0,0,0,,وكلّ ذلك لقتلكم
Dialogue: 1,0:16:49.83,0:16:52.75,Main,,0,0,0,,لكنّك تتجاهل ذلك وتسمّيه موهبة
Dialogue: 1,0:16:52.75,0:16:55.20,Main,,0,0,0,,يا له من قولٍ ينمّ عن استخفافٍ شديد
Dialogue: 1,0:16:56.58,0:16:57.63,Main,,0,0,0,,أنتِ حرّة الآن
Dialogue: 1,0:16:58.34,0:17:02.84,Main,,0,0,0,,غابيمارو، سنذهب إلى قصر الرينتان ونجلب الإكسير
Dialogue: 1,0:17:02.84,0:17:04.59,Main,,0,0,0,,!ابقي مكانكِ
Dialogue: 1,0:17:05.50,0:17:06.92,Main,,0,0,0,,الإكسير
Dialogue: 1,0:17:06.92,0:17:08.38,Main,,0,0,0,,هذه فرصتنا
Dialogue: 1,0:17:08.38,0:17:10.47,Main,,0,0,0,,السينين الآخرون منشغلون بالقتال
Dialogue: 1,0:17:10.47,0:17:11.96,Main,,0,0,0,,الطقوس
Dialogue: 1,0:17:11.96,0:17:13.47,Main,,0,0,0,,ما الخطر؟
Dialogue: 1,0:17:13.47,0:17:14.22,Main,,0,0,0,,!أعتمد عليكِ
Dialogue: 1,0:17:14.22,0:17:14.97,Main,,0,0,0,,!حسنٌ
Dialogue: 1,0:17:16.68,0:17:17.85,Main,,0,0,0,,...تمهّلي
Dialogue: 1,0:17:18.53,0:17:22.04,Main,,0,0,0,,أينوي استغلال التاو خاصّتي مجدّدًا؟
Dialogue: 1,0:17:22.04,0:17:24.48,Main,,0,0,0,,سأضعفه إذن
Dialogue: 1,0:17:28.69,0:17:30.49,Main,,0,0,0,,امرأة التضادّ
Dialogue: 1,0:17:30.49,0:17:32.99,Main,,0,0,0,,أكانت تنتظر حدوث هذا؟
Dialogue: 1,0:17:33.53,0:17:37.23,Main,,0,0,0,,يا لها من قدرات مذهلة وعمل جماعيّ مبهر
Dialogue: 1,0:17:37.23,0:17:41.24,Main,,0,0,0,,بإمكانهم بلوغ مراتب أعلى في التاو حتمًا
Dialogue: 1,0:17:41.34,0:17:43.03,Main,,0,0,0,,إنّهم الخصوم الأمثل
Dialogue: 1,0:17:43.03,0:17:44.75,Main,,0,0,0,,...ومع ذلك
Dialogue: 1,0:17:44.75,0:17:45.75,Main,,0,0,0,,!مجدّدًا
Dialogue: 1,0:17:45.75,0:17:46.93,Main,,0,0,0,,!تمهّلي
Dialogue: 1,0:18:00.39,0:18:03.72,Main,,0,0,0,,للأسف، هذه طقوس
Dialogue: 1,0:18:03.72,0:18:05.76,Main,,0,0,0,,لا وقت لديَّ للّعب
Dialogue: 1,0:18:09.36,0:18:10.50,Main,,0,0,0,,...أهذا
Dialogue: 1,0:18:10.50,0:18:11.51,Main,,0,0,0,,أجل
Dialogue: 1,0:18:14.93,0:18:16.19,Main,,0,0,0,,إنّه قادم
Dialogue: 1,0:18:16.19,0:18:17.91,Main,,0,0,0,,ستبدأ المعركة الحقيقيّة الآن
Dialogue: 1,0:18:38.53,0:18:40.43,Main,,0,0,0,,إنّه لأمر مؤسف حقًّا
Dialogue: 1,0:18:45.53,0:18:47.99,Main,,0,0,0,,تحوّل ران إذن
Dialogue: 1,0:18:51.11,0:18:53.44,Main,,0,0,0,,لم يحدث هذا منذ مئات السنين
Dialogue: 1,0:18:53.44,0:18:58.58,Main,,0,0,0,,إنّه رجل قويّ، ومكوّن استثنائيّ
Dialogue: 1,0:18:59.77,0:19:01.33,Main,,0,0,0,,أيّها المعلّم الأكبر
Dialogue: 1,0:19:01.61,0:19:05.07,Main,,0,0,0,,اكتملت بذرة الإكسير
Dialogue: 1,0:19:05.07,0:19:08.96,Main,,0,0,0,,سننمّيها أولًا باستخدام من نزلوا الجزيرة
Dialogue: 1,0:19:08.96,0:19:11.59,Main,,0,0,0,,ثمَّ نعبر البحر لجمع المزيد من المكوّنات
Dialogue: 1,0:19:12.92,0:19:16.75,Main,,0,0,0,,سينتهي كلّ شيء الليلة أخيرًا
Dialogue: 1,0:19:17.34,0:19:19.60,Main,,0,0,0,,يا للأسف
Dialogue: 1,0:19:20.60,0:19:23.95,Main,,0,0,0,,عليّ قراءة تدفّق التاو أولًا
Dialogue: 1,0:19:23.95,0:19:25.60,Main,,0,0,0,,ومعرفة خصائصه
Dialogue: 1,0:19:25.86,0:19:27.35,Main,,0,0,0,,هل سأتمكّن من مجاراته؟
Dialogue: 1,0:19:30.32,0:19:36.95,Main,,0,0,0,,!جسد مفعم بالحيوية
Dialogue: 1,0:19:49.98,0:19:52.97,Main,,0,0,0,,قوّته في مستوى آخر تمامًا
Dialogue: 1,0:20:03.06,0:20:04.58,Main,,0,0,0,,يمكننا الذهاب من هنا
Dialogue: 1,0:20:04.58,0:20:05.58,Main,,0,0,0,,حسنٌ
Dialogue: 1,0:20:11.24,0:20:15.07,Main,,0,0,0,,لا تقلقي، سيكون غابيمارو بخير
Dialogue: 1,0:20:29.32,0:20:33.37,Main,,0,0,0,,إنّه يقيس قدرتنا على التحمّل ويتجنّب الضربات القاتلة
Dialogue: 1,0:20:33.88,0:20:36.02,Main,,0,0,0,,لكي يحوّلنا إلى تان؟
Dialogue: 1,0:20:36.46,0:20:38.60,Main,,0,0,0,,ليس مثل جوجين أو مودان
Dialogue: 1,0:20:39.30,0:20:42.13,Main,,0,0,0,,يحتفظ ران برجاحة عقله حتّى عند التحوّل
Dialogue: 1,0:20:42.13,0:20:44.40,Main,,0,0,0,,يستخدم التقنيات والاستراتيجيات
Dialogue: 1,0:20:44.77,0:20:45.81,Main,,0,0,0,,هذا سيّئ
Dialogue: 1,0:20:46.39,0:20:47.61,Main,,0,0,0,,...وعيي
Dialogue: 1,0:20:48.52,0:20:50.02,Main,,0,0,0,,ثمّة مشكلة
Dialogue: 1,0:20:50.49,0:20:52.73,Main,,0,0,0,,التاو هو الحياة ذاتها أيضًا
Dialogue: 1,0:20:52.73,0:20:56.90,Main,,0,0,0,,استخدامه مع الإصابات البليغة قد يقصّر العمر
Dialogue: 1,0:20:56.90,0:20:59.37,Main,,0,0,0,,جسد مفعم بالحيوية
Dialogue: 1,0:21:06.19,0:21:10.27,Main,,0,0,0,,نينبو: عاصفة... الحجارة
Dialogue: 1,0:21:10.27,0:21:16.50,Main,,0,0,0,,لذا سأحميكِ استراتيجيًّا بناءً على توافق تاو خصمكِ
Dialogue: 1,0:21:17.25,0:21:21.75,Main,,0,0,0,,كلانا شينوبي، لكنّنا مختلفان تمامًا
Dialogue: 1,0:21:22.84,0:21:26.73,Main,,0,0,0,,أنا لا أحمي سوى نفسي وقت الشدّة
Dialogue: 1,0:21:38.66,0:21:39.99,Main,,0,0,0,,يجدر بنا التراجع في الوقت الراهن
Dialogue: 1,0:21:40.42,0:21:42.10,Main,,0,0,0,,ولنتحيّن فرصة أخرى
Dialogue: 1,0:21:42.10,0:21:44.99,Main,,0,0,0,,سنتدبّر الأمر ما دمنا أحياء
Dialogue: 1,0:21:44.99,0:21:48.08,Main,,0,0,0,,لا شيء أهمّ عندي من حياتي
Dialogue: 1,0:21:48.08,0:21:50.31,Main,,0,0,0,,لن أخاطر بها لأجل أيّ شيء
Dialogue: 1,0:22:06.85,0:22:09.60,Main,,0,0,0,,هذا يكفي
Dialogue: 1,0:22:13.90,0:22:22.28,Main,,0,0,0,,مكوّن التان هو حياتكم، لكنّكم عنيدون للغاية
Dialogue: 1,0:22:23.25,0:22:26.06,Main,,0,0,0,,طفح الكيل
Dialogue: 1,0:22:33.93,0:22:35.29,Main,,0,0,0,,وأنا كذلك
Dialogue: 1,0:22:39.67,0:22:41.94,Main,,0,0,0,,حياتي هي أولويتي القصوى
Dialogue: 1,0:22:41.94,0:22:43.30,Main,,0,0,0,,لا أنوي الموت
Dialogue: 1,0:22:45.13,0:22:47.67,Main,,0,0,0,,غايتي هي العودة إلى الديار حيًّا
Dialogue: 1,0:22:49.39,0:22:53.16,Main,,0,0,0,,لأحيا وألقى زوجتي
