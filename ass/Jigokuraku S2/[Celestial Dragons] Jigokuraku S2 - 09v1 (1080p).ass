Dialogue: 0,0:01:48.00,0:01:50.61,Main,,0,0,0,,ادعموا أخي جميعًا
Dialogue: 0,0:01:50.61,0:01:53.84,Main,,0,0,0,,!سحقًا لهذا، أنا من سيقطع رأس ذلك الوحش
Dialogue: 0,0:01:53.84,0:01:56.51,Main,,0,0,0,,لن يموت التينسين-ساما بقطع رأسه
Dialogue: 0,0:01:56.51,0:01:59.59,Main,,0,0,0,,!أعرف ذلك، إنّه مجرّد تعبير مجازيّ
Dialogue: 0,0:01:59.59,0:02:01.32,Main,,0,0,0,,!افعلوا ما يأمركم به أخي فحسب
Dialogue: 0,0:02:01.32,0:02:03.02,Top,,0,0,0,,!اخرس أيّها المتأنّث
Dialogue: 0,0:02:01.32,0:02:03.02,Main,,0,0,0,,يا لكم من حمقى
Dialogue: 0,0:02:11.18,0:02:13.03,Main,,0,0,0,,تراجعوا أيّها الحمقى
Dialogue: 0,0:02:20.32,0:02:21.91,Main,,0,0,0,,أنا عالقٌ في الدفاع
Dialogue: 0,0:02:22.16,0:02:23.01,Main,,0,0,0,,!أخي
Dialogue: 0,0:02:23.01,0:02:24.59,Main,,0,0,0,,!قلتُ تراجعوا
Dialogue: 0,0:02:25.03,0:02:28.48,Main,,0,0,0,,لا يسعني صدّ كلّ هذه المجسّات والأبواغ
Dialogue: 0,0:02:28.48,0:02:29.47,Main,,0,0,0,,تبًّا
Dialogue: 0,0:02:29.47,0:02:32.45,Main,,0,0,0,,تضاعفتْ هجماتهما بعد أن اندمجا
Dialogue: 0,0:02:32.92,0:02:36.18,Main,,0,0,0,,القزم والعجوز لا يجيدان استخدام التاو
Dialogue: 0,0:02:36.18,0:02:38.86,Main,,0,0,0,,وتاو توما لا يُضادّهما
Dialogue: 0,0:02:39.02,0:02:44.91,Main,,0,0,0,,لكنَّ تاوي يُضادّ تاوفا، وقد أعددتُ خطّة للقضاء على جوفا
Dialogue: 0,0:02:45.31,0:02:48.15,Main,,0,0,0,,أنا الوحيد القادر على قتل هذا الوحش
Dialogue: 0,0:02:50.31,0:02:52.15,Main,,0,0,0,,،في حالة تاو الماء
Dialogue: 0,0:02:52.15,0:02:58.03,Main,,0,0,0,,،تُجمع الأشياء الّتي تحتويه كالكستناء، وفول الصويا، والكلى، والمثانة
Dialogue: 0,0:02:58.47,0:03:02.79,Main,,0,0,0,,وتُخمّر لإنتاج أرواحٍ مشبّعةٍ بالتاو
Dialogue: 0,0:03:03.17,0:03:07.54,Main,,0,0,0,,يُكتب اسم الهدف على تعويذةٍ معطّرةٍ
Dialogue: 0,0:03:07.54,0:03:11.30,Main,,0,0,0,,،فتتجاوب المحفّزات الغنيّة بالتاو
Dialogue: 0,0:03:11.30,0:03:14.80,Main,,0,0,0,,ممّا يتيح رؤية طالع الهدف وحالته الراهنة
Dialogue: 0,0:03:15.63,0:03:16.71,Main,,0,0,0,,تشوبي
Dialogue: 0,0:03:19.96,0:03:22.81,Main,,0,0,0,,أرى نذير شؤمٍ في مستقبل أخيك
Dialogue: 0,0:03:29.53,0:03:31.85,Main,,0,0,0,,سأفعلها بمفردي
Dialogue: 0,0:03:32.32,0:03:35.08,Main,,0,0,0,,كما كنتُ أفعل دائمًا، لا مشكلة في ذلك
Dialogue: 0,0:03:37.12,0:03:39.32,Main,,0,0,0,,أيّتها الماشية
Dialogue: 0,0:03:39.76,0:03:40.95,Main,,0,0,0,,سأقتلك
Dialogue: 0,0:03:49.87,0:03:51.25,Main,,0,0,0,,هل أنتَ بخير يا أخي؟
Dialogue: 0,0:03:59.80,0:04:01.80,Main,,0,0,0,,آمل أن ينجح هذا
Dialogue: 0,0:04:02.10,0:04:03.31,Main,,0,0,0,,سينجح حتمًا
Dialogue: 0,0:04:13.22,0:04:14.11,Main,,0,0,0,,أرأيت؟
Dialogue: 0,0:04:14.68,0:04:19.75,Main,,0,0,0,,بتعزيز عنصري المعدنيّ بعنصركَ الأرضيّ، يسعنا إعاقة تاو تاوفا
Dialogue: 0,0:04:19.75,0:04:22.12,Main,,0,0,0,,التوليد فعّالٌ حتّى بين رجلين إذن
Dialogue: 0,0:04:23.62,0:04:25.91,Main,,0,0,0,,...يبدو الأمر كذلك، لنضيّق الخناق عليهـ
Dialogue: 0,0:04:25.91,0:04:30.00,Main,,0,0,0,,!أنا من سيقتل ذلك الوحش
Dialogue: 0,0:04:34.10,0:04:35.11,Main,,0,0,0,,!أيّها الحثالة
Dialogue: 0,0:04:35.11,0:04:36.44,Main,,0,0,0,,!أنتَ هو الحثالة
Dialogue: 0,0:04:36.44,0:04:38.77,Main,,0,0,0,,!قلتُ إنّي من سيقتل هذا الوحش
Dialogue: 0,0:04:38.77,0:04:40.10,Main,,0,0,0,,!لا تقف في طريقنا
Dialogue: 0,0:04:40.10,0:04:42.14,Main,,0,0,0,,!ستنفتح جراحكَ إن تبلّلتَ
Dialogue: 0,0:04:42.14,0:04:43.64,Main,,0,0,0,,أنا بخير أيّها الأحمق
Dialogue: 0,0:04:43.64,0:04:46.96,Top,,0,0,0,,!أمرنا أخي بالتراجع، لذا تراجع فحسب
Dialogue: 0,0:04:44.50,0:04:50.48,Main,,0,0,0,,لم أره يجادل أحدًا قطّ حين كنّا قطّاع طرق
Dialogue: 0,0:04:51.61,0:04:55.02,Main,,0,0,0,,كان يقلّدني في كلّ شيء فحسب
Dialogue: 0,0:05:09.54,0:05:11.74,Main,,0,0,0,,انظروا للأعلى أيّها الحمقى
Dialogue: 0,0:05:39.22,0:05:41.44,Main,,0,0,0,,هل انقلبا؟
Dialogue: 0,0:05:41.44,0:05:43.45,Main,,0,0,0,,انتقلا من الهجوم إلى الدفاع
Dialogue: 0,0:05:43.45,0:05:46.45,Main,,0,0,0,,لإراحة نصفهما المصاب على الأرجح
Dialogue: 0,0:05:46.45,0:05:48.55,Main,,0,0,0,,لن نصل لنتيجةٍ بقطعهما هكذا
Dialogue: 0,0:05:48.55,0:05:52.96,Main,,0,0,0,,لا خيار أمامنا سوى تدمير تاندين جوفا وتاوفا في آنٍ واحد
Dialogue: 0,0:05:53.32,0:05:55.14,Main,,0,0,0,,تعال معي أيّها العجوز
Dialogue: 0,0:05:56.33,0:06:00.99,Main,,0,0,0,,سنفترق ونقتل جوفا معًا
Dialogue: 0,0:06:00.99,0:06:02.43,Main,,0,0,0,,لديّ خطّة
Dialogue: 0,0:06:02.97,0:06:05.41,Main,,0,0,0,,تولّيا أنتما أمر تاوفا
Dialogue: 0,0:06:05.41,0:06:07.97,Main,,0,0,0,,ستُجدي طريقتكم السابقة نفعًا
Dialogue: 0,0:06:08.30,0:06:09.73,Main,,0,0,0,,حاضر يا أخي
Dialogue: 0,0:06:10.19,0:06:12.10,Main,,0,0,0,,...إذن، كيف نتحرّك بالتحديد
Dialogue: 0,0:06:12.49,0:06:16.10,Main,,0,0,0,,أنتَ تطرح الكثير من الأسئلة دائمًا
Dialogue: 0,0:06:16.16,0:06:17.68,Main,,0,0,0,,!مهلًا يا أخي
Dialogue: 0,0:06:22.23,0:06:25.39,Main,,0,0,0,,قلتُ إنّي سأترك الأمر برمّته لك
Dialogue: 0,0:06:25.71,0:06:27.12,Main,,0,0,0,,فكّر بنفسك
Dialogue: 0,0:06:28.62,0:06:30.82,Main,,0,0,0,,يسعكَ فعلها، أليس كذلك؟
Dialogue: 0,0:06:35.75,0:06:38.10,Main,,0,0,0,,لا أحتاج إلى أيّ توجيهات
Dialogue: 0,0:06:38.10,0:06:40.00,Main,,0,0,0,,أنا أعتمد عليك
Dialogue: 0,0:06:41.15,0:06:45.76,Main,,0,0,0,,لن تنجح خطّتي دون مهارات السيّاف الّذي لا يُشقّ له غبار في المقاطعات الثماني
Dialogue: 0,0:06:45.97,0:06:48.60,Main,,0,0,0,,...إ-إن كان الأمر هكذا
Dialogue: 0,0:06:49.14,0:06:52.66,Main,,0,0,0,,هذه هي ملامح أخي حين يتلاعب بأتباعه
Dialogue: 0,0:07:00.66,0:07:02.59,Main,,0,0,0,,أتستميتان في الدفاع عن نفسيكما؟
Dialogue: 0,0:07:02.59,0:07:04.40,Main,,0,0,0,,أتعاطف معكما قليلًا
Dialogue: 0,0:07:05.01,0:07:08.61,Main,,0,0,0,,لكنّهما تطوّرا أكثر ممّا تتصوّران
Dialogue: 0,0:07:08.83,0:07:11.30,Main,,0,0,0,,ستسحقان بعضكما حتّى الموت إن بقيتما هكذا
Dialogue: 0,0:07:11.66,0:07:13.91,Main,,0,0,0,,سأفصلكما عن بعضكما
Dialogue: 0,0:07:14.00,0:07:16.59,Main,,0,0,0,,أليس مُرادكما أن تموتا معًا؟
Dialogue: 0,0:07:35.27,0:07:36.39,Main,,0,0,0,,!أخي
Dialogue: 0,0:07:36.39,0:07:39.32,Main,,0,0,0,,يتفاعلان مع حركاتنا نحن الأربعة في آنٍ واحد
Dialogue: 0,0:07:39.32,0:07:41.90,Main,,0,0,0,,لا توجد أيّ ثغرةٍ لمهاجمة التاندين
Dialogue: 0,0:07:42.60,0:07:45.32,Main,,0,0,0,,!أيّها القزم والمتأنّث، ادعماني
Dialogue: 0,0:07:45.98,0:07:47.91,Main,,0,0,0,,!سأخلق لكما ثغرةً للهجوم
Dialogue: 0,0:07:47.91,0:07:49.32,Main,,0,0,0,,ما الّذي تنوي فعله؟
Dialogue: 0,0:07:49.32,0:07:51.91,Main,,0,0,0,,لا أدري، لكن لنثق به
Dialogue: 0,0:08:03.17,0:08:04.40,Main,,0,0,0,,!غانتيتسوساي
Dialogue: 0,0:08:04.75,0:08:07.08,Main,,0,0,0,,!أنا بخير، لنواصل
Dialogue: 0,0:08:09.67,0:08:11.51,Main,,0,0,0,,يستحيل أن يكون بخير
Dialogue: 0,0:08:11.51,0:08:14.04,Main,,0,0,0,,إنّه يتظاهر بالصلابة فحسب
Dialogue: 0,0:08:14.04,0:08:18.02,Main,,0,0,0,,تمزّقات وكدمات لا تُحصى، وتضرّرٌ في الأعضاء الداخليّة
Dialogue: 0,0:08:18.44,0:08:21.16,Main,,0,0,0,,أوشك على بلوغ حدّه بسبب المعارك المتتاليّة
Dialogue: 0,0:08:32.37,0:08:33.31,Main,,0,0,0,,!توما
Dialogue: 0,0:08:36.65,0:08:39.23,Main,,0,0,0,,تاوُك هو مفتاح خطّة أخي
Dialogue: 0,0:08:39.42,0:08:40.66,Main,,0,0,0,,تمالك نفسك
Dialogue: 0,0:08:40.80,0:08:42.04,Main,,0,0,0,,...أ-أعتذ
Dialogue: 0,0:08:42.04,0:08:43.02,Main,,0,0,0,,!لا عليك، لننطلق
Dialogue: 0,0:08:50.09,0:08:52.01,Main,,0,0,0,,جميعنا مثخنون بالجراح
Dialogue: 0,0:08:52.01,0:08:53.98,Main,,0,0,0,,...لكن إن فوّتنا هذه الفرصة
Dialogue: 0,0:08:53.98,0:08:55.63,Main,,0,0,0,,فلن ننتصر أبدًا
Dialogue: 0,0:08:59.93,0:09:02.28,Main,,0,0,0,,أنا مستعدّ أيّها الشقيّان
Dialogue: 0,0:09:11.10,0:09:12.78,Main,,0,0,0,,!ضربة شقّ البوّابة
Dialogue: 0,0:09:16.03,0:09:19.29,Main,,0,0,0,,!إنّهما يتجدّدان، لا تفوّت هذه الفرصة يا توما
Dialogue: 0,0:09:20.22,0:09:21.84,Main,,0,0,0,,أين تاندين تاوفا؟
Dialogue: 0,0:09:22.71,0:09:24.42,Main,,0,0,0,,!في الأسفل يمينًا، باتجاه الكلب
Dialogue: 0,0:09:55.28,0:09:56.60,Main,,0,0,0,,!جوفا
Dialogue: 0,0:10:08.27,0:10:10.84,Main,,0,0,0,,كفى الآن، هذا يكفي
Dialogue: 0,0:10:16.20,0:10:17.35,Main,,0,0,0,,!تاوفا
Dialogue: 0,0:10:20.06,0:10:21.81,Main,,0,0,0,,ألم يموتا بعد؟
Dialogue: 0,0:10:21.81,0:10:24.19,Main,,0,0,0,,هذا لأنّي لا أملك تاو مضادًّا
Dialogue: 0,0:10:24.19,0:10:28.80,Main,,0,0,0,,لقتلهما، علينا إيقاف تجدّدهما بعد تدمير التاندين
Dialogue: 0,0:10:38.53,0:10:39.37,Main,,0,0,0,,!أخي؟
Dialogue: 0,0:10:39.37,0:10:41.36,Main,,0,0,0,,سلاحي السرّي
Dialogue: 0,0:10:42.86,0:10:46.96,Main,,0,0,0,,كنتُ أنوي استخدامه لقتل ذلك الشينوبي؛ القزم الناريّ
Dialogue: 0,0:10:49.49,0:10:51.38,Main,,0,0,0,,لكنّي سأمنحه لك
Dialogue: 0,0:10:53.91,0:10:58.30,Main,,0,0,0,,إنّه الخمر المشبّع بالتاو الّذي يستخدمونه
Dialogue: 0,0:10:58.51,0:11:01.81,Main,,0,0,0,,ارتأيتُ سرقة تاو الماء
Dialogue: 0,0:11:03.31,0:11:06.07,Main,,0,0,0,,وحدسي لا يخطئ أبدًا
Dialogue: 0,0:11:08.81,0:11:10.70,Main,,0,0,0,,مفعوله فوريّ
Dialogue: 0,0:11:10.70,0:11:13.82,Main,,0,0,0,,تأثير التضادّ يمنعكَ من التجدّد، أليس كذلك؟
Dialogue: 0,0:11:13.82,0:11:17.32,Main,,0,0,0,,أفشيتَ كلّ ما تعرفه عن التضادّ والتاو
Dialogue: 0,0:11:17.32,0:11:20.82,Main,,0,0,0,,أظننتني غيّرتُ ولائي حقًّا؟
Dialogue: 0,0:11:22.94,0:11:24.77,Main,,0,0,0,,تستحقّ ذلك
Dialogue: 0,0:11:24.89,0:11:30.17,Main,,0,0,0,,ستموت نادمًا على استعدائكَ لي ولأخي
Dialogue: 0,0:11:31.10,0:11:32.57,Main,,0,0,0,,يا للدناءة
Dialogue: 0,0:11:32.57,0:11:34.09,Main,,0,0,0,,دناءة؟
Dialogue: 0,0:11:34.09,0:11:36.97,Main,,0,0,0,,أخي رجلٌ في غاية الخبث
Dialogue: 0,0:11:42.37,0:11:44.77,Main,,0,0,0,,لا تقتلهما
Dialogue: 0,0:11:44.95,0:11:47.24,Main,,0,0,0,,أتشفق عليهما أيّها العجوز؟
Dialogue: 0,0:11:49.14,0:11:52.87,Main,,0,0,0,,قلتُ إنّي من سيقضي على هذا الوحش
Dialogue: 0,0:12:00.54,0:12:03.23,Main,,0,0,0,,لا متعة في هذا إطلاقًا
Dialogue: 0,0:12:04.24,0:12:07.27,Main,,0,0,0,,أمّا أنا فقد استمتعت أيّتها الآنسة
Dialogue: 0,0:12:09.00,0:12:14.34,Main,,0,0,0,,...آسف يا تاوفا، أنا
Dialogue: 0,0:12:15.28,0:12:16.99,Main,,0,0,0,,لم أستطع حمايتكِ
Dialogue: 0,0:12:18.42,0:12:19.68,Main,,0,0,0,,آسف
Dialogue: 0,0:12:25.27,0:12:26.65,Main,,0,0,0,,...تاوفا
Dialogue: 0,0:12:30.34,0:12:33.70,Main,,0,0,0,,سعيدةٌ لأنّي كنتُ شريكتكَ يا جوفا
Dialogue: 0,0:12:43.59,0:12:46.32,Main,,0,0,0,,لا أصدّق أنّنا نجونا جميعًا
Dialogue: 0,0:12:49.30,0:12:51.19,Main,,0,0,0,,هل الآخرون بخير يا ترى؟
Dialogue: 0,0:12:57.07,0:13:01.05,Main,,0,0,0,,أودّ التوضيح أولًا أنّي لا أنوي قتالكما
Dialogue: 0,0:13:01.85,0:13:05.06,Main,,0,0,0,,أُمرتُ بالبقاء هنا فحسب
Dialogue: 0,0:13:06.43,0:13:11.48,Main,,0,0,0,,لذا... إن لم تزعجاني، فلن أزعجكما
Dialogue: 0,0:13:12.17,0:13:15.53,Main,,0,0,0,,لكن إن فعلتما، فسأسحقكما
Dialogue: 0,0:13:20.76,0:13:21.60,Main,,0,0,0,,من هذا؟
Dialogue: 0,0:13:21.89,0:13:23.23,Main,,0,0,0,,!إنّه يقرأ كتابًا
Dialogue: 0,0:13:23.80,0:13:27.42,Main,,0,0,0,,هذا قصر فنون الرينتان بلا ريب
Dialogue: 0,0:13:27.42,0:13:29.70,Main,,0,0,0,,لكنَّ ريين ليس هنا
Dialogue: 0,0:13:30.07,0:13:32.71,Main,,0,0,0,,أين ريين يا غويفا؟
Dialogue: 0,0:13:33.32,0:13:36.36,Main,,0,0,0,,غادر ريين للتوّ
Dialogue: 0,0:13:37.00,0:13:39.46,Main,,0,0,0,,أُمرتُ بحراسة هذا فحسب
Dialogue: 0,0:13:39.67,0:13:40.72,Main,,0,0,0,,هذا؟
Dialogue: 0,0:13:44.54,0:13:48.81,Main,,0,0,0,,غويفا خجولٌ للغاية، أكثر من ذي قبل حتّى
Dialogue: 0,0:13:50.10,0:13:51.88,Main,,0,0,0,,هذا طقس الجلاء
Dialogue: 0,0:13:51.88,0:13:57.36,Main,,0,0,0,,يُحوّل الأشياء الّتي تحتوي على التاو إلى محفّزاتٍ لرؤية القدر والطالع
Dialogue: 0,0:13:57.36,0:14:00.86,Main,,0,0,0,,وتُستخدم التعاويذ لرؤية الهدف
Dialogue: 0,0:14:01.23,0:14:03.41,Main,,0,0,0,,علِمنا بقدومكم مُسبقًا
Dialogue: 0,0:14:04.12,0:14:06.74,Main,,0,0,0,,انتظرتُ قدومكم إلى هنا
Dialogue: 0,0:14:07.77,0:14:12.02,Main,,0,0,0,,إذن، إن دمّرنا ذلك، فلن يتمكّنوا من قراءة تحرّكاتنا
Dialogue: 0,0:14:14.53,0:14:16.89,Main,,0,0,0,,هجوم تاو من الأعلى؟
Dialogue: 0,0:14:17.30,0:14:19.00,Main,,0,0,0,,أشعر وكأنّي أُسحق
Dialogue: 0,0:14:19.44,0:14:22.63,Main,,0,0,0,,أبعدي يدكِ عن سيفكِ
Dialogue: 0,0:14:22.63,0:14:23.88,Main,,0,0,0,,!ساغيري
Dialogue: 0,0:14:28.74,0:14:29.82,Main,,0,0,0,,ما زلتِ قادرةً على التحرّك؟
Dialogue: 0,0:14:30.18,0:14:31.10,Main,,0,0,0,,!هذا مذهل
Dialogue: 0,0:14:32.03,0:14:34.28,Main,,0,0,0,,لكنّي أتّبع أوامر ريين
Dialogue: 0,0:14:34.60,0:14:37.03,Main,,0,0,0,,إن أردتِ القتال، فسأسحقكِ
Dialogue: 0,0:14:39.73,0:14:41.74,Main,,0,0,0,,لا أنوي القتال
Dialogue: 0,0:14:42.28,0:14:45.78,Main,,0,0,0,,اسمح لي بالاعتذار أولًا
Dialogue: 0,0:14:46.78,0:14:50.74,Main,,0,0,0,,على اقتحام جزيرتكم، وكلّ ما فعلناه لاحقًا
Dialogue: 0,0:14:50.74,0:14:54.01,Main,,0,0,0,,قد نكون جاهلين، لكنّنا نتحمّل المسؤوليّة
Dialogue: 0,0:14:54.60,0:14:56.40,Main,,0,0,0,,أعتذر عن ذلك
Dialogue: 0,0:14:56.40,0:14:57.75,Main,,0,0,0,,...ساغيري
Dialogue: 0,0:14:58.35,0:14:59.75,Main,,0,0,0,,يا لكِ من نبيلة
Dialogue: 0,0:15:00.31,0:15:04.13,Main,,0,0,0,,ومع ذلك، رأيتُ أمورًا تُثير حنقي أيضًا
Dialogue: 0,0:15:05.66,0:15:09.68,Main,,0,0,0,,بلغني أنّكم من استدرجتم البشر إلى هذه الجزيرة
Dialogue: 0,0:15:09.68,0:15:13.48,Main,,0,0,0,,في هذه الحالة، أنتم من جلبتم هذا الصراع لأنفسكم
Dialogue: 0,0:15:14.41,0:15:20.11,Main,,0,0,0,,لكن ألا تظنّ أنَّ كِلا الطرفين قد خسر الكثير ليُعتبر الأمر مجرّد نتيجةٍ لأفعالكم؟
Dialogue: 0,0:15:20.52,0:15:23.93,Main,,0,0,0,,لهذا جئتُ لإيقاف هذا القتال
Dialogue: 0,0:15:24.39,0:15:26.60,Main,,0,0,0,,لا طائل من استمرارنا في قتل بعضنا البعض
Dialogue: 0,0:15:27.01,0:15:29.28,Main,,0,0,0,,سنغادر الجزيرة بهدوء
Dialogue: 0,0:15:30.12,0:15:32.18,Main,,0,0,0,,أرجو أن تدعنا نرحل
Dialogue: 0,0:15:32.76,0:15:36.30,Main,,0,0,0,,الإكسير والشوغون ليسا أولويّتنا الآن
Dialogue: 0,0:15:36.30,0:15:38.73,Main,,0,0,0,,بل العودة أحياءً هي الأهمّ
Dialogue: 0,0:15:39.17,0:15:42.23,Main,,0,0,0,,...ارتفع تاوها، هذه المرأة
Dialogue: 0,0:15:45.83,0:15:47.05,Main,,0,0,0,,تلاشى الضغط
Dialogue: 0,0:15:47.63,0:15:50.28,Main,,0,0,0,,حسنٌ، سأدعكما ترحلان
Dialogue: 0,0:15:50.28,0:15:52.78,Main,,0,0,0,,أُمرتُ بحماية هذا المكان فحسب
Dialogue: 0,0:15:52.78,0:15:54.81,Main,,0,0,0,,ولم أكن مهتمًّا بهذا أصلًا
Dialogue: 0,0:15:55.34,0:15:56.16,Main,,0,0,0,,...إذن
Dialogue: 0,0:15:56.30,0:16:01.44,Main,,0,0,0,,لكن لا أظنّ أنَّ لعودتكما أحياءً إلى واكوكو أيّ معنى بعد الآن
Dialogue: 0,0:16:02.33,0:16:03.94,Main,,0,0,0,,ماذا تقصد؟
Dialogue: 0,0:16:05.69,0:16:08.82,Main,,0,0,0,,سألتِ عن مكان ريين يا ماي
Dialogue: 0,0:16:11.07,0:16:15.58,Main,,0,0,0,,سأُريكِ وهمًا بالتاو، وليس الواقع
Dialogue: 0,0:16:19.90,0:16:22.27,Main,,0,0,0,,ريين تحت القصر الرئيسيّ
Dialogue: 0,0:16:22.71,0:16:24.59,Main,,0,0,0,,ذهب إلى البوّابة المائيّة
Dialogue: 0,0:16:26.26,0:16:29.09,Main,,0,0,0,,إنّه يجهّز سفينةً مع الدوشي
Dialogue: 0,0:16:29.42,0:16:30.51,Main,,0,0,0,,سفينة؟
Dialogue: 0,0:16:30.87,0:16:32.08,Main,,0,0,0,,لأيّ غرض؟
Dialogue: 0,0:16:36.85,0:16:40.23,Main,,0,0,0,,لتحويل كلّ بشر واكوكو إلى تان
Dialogue: 0,0:16:41.04,0:16:42.10,Main,,0,0,0,,كيف؟
Dialogue: 0,0:16:42.41,0:16:47.14,Main,,0,0,0,,،زُرعتْ خميرة التان المكتملة في فراشات الفردوس
Dialogue: 0,0:16:47.14,0:16:48.86,Main,,0,0,0,,وحُمّلتْ على متن سفينة
Dialogue: 0,0:16:50.60,0:16:52.50,Main,,0,0,0,,،ستفقس في واكوكو
Dialogue: 0,0:16:54.25,0:16:55.74,Main,,0,0,0,,وتنتشر
Dialogue: 0,0:17:32.41,0:17:35.90,Main,,0,0,0,,...آلاف الفراشات القادرة على الطيران لمسافاتٍ شاسعة
Dialogue: 0,0:17:36.39,0:17:39.41,Main,,0,0,0,,ستغطّي واكوكو في طرفة عين
Dialogue: 0,0:17:51.26,0:17:54.68,Main,,0,0,0,,،وبمجرّد تحوّل البشر إلى زهور الوايتان
Dialogue: 0,0:17:54.68,0:17:56.85,Main,,0,0,0,,سيندمجون معًا
Dialogue: 0,0:17:57.79,0:18:04.28,Main,,0,0,0,,ليصبحوا بانكو؛ الوحش الإلهيّ الّذي سيستخلص منه ريين التان المثاليّ الّذي ينشده
Dialogue: 0,0:18:09.73,0:18:11.01,Main,,0,0,0,,!ساغيري
Dialogue: 0,0:18:11.99,0:18:15.48,Main,,0,0,0,,لذا لا طائل من عودتكما، فستتحوّلان إلى زهورٍ في النهاية
Dialogue: 0,0:18:20.85,0:18:21.75,Main,,0,0,0,,لِمَ؟
Dialogue: 0,0:18:22.20,0:18:24.49,Main,,0,0,0,,لِمَ تفعلون كلّ هذا؟
Dialogue: 0,0:18:25.01,0:18:26.08,Main,,0,0,0,,لِمَ؟
Dialogue: 0,0:18:28.14,0:18:29.57,Main,,0,0,0,,صحيح
Dialogue: 0,0:18:30.00,0:18:36.51,Main,,0,0,0,,أتظنّين أنّنا سنتفاهم إن ناقشنا الأسباب؟
Dialogue: 0,0:18:37.19,0:18:41.01,Main,,0,0,0,,لا أدري ما الّذي تعرفينه عنّا، لكنّكِ مخطئةٌ تمامًا
Dialogue: 0,0:18:41.52,0:18:44.50,Main,,0,0,0,,البشر مجرّد مكوّنٍ للإكسير
Dialogue: 0,0:18:44.50,0:18:47.40,Main,,0,0,0,,لا نكنّ لكم أيّ مشاعر أكثر ممّا نكنّه للحشرات
Dialogue: 0,0:18:47.40,0:18:49.48,Main,,0,0,0,,هذا غير صحيح
Dialogue: 0,0:18:49.48,0:18:53.48,Main,,0,0,0,,أبحاث المعلّم الأكبر من أجل الإمبراطور والناس
Dialogue: 0,0:18:53.48,0:18:56.78,Main,,0,0,0,,أنتَ تعلم أنَّ استغلال حيوات البشر أمرٌ خاطئ
Dialogue: 0,0:18:57.00,0:18:59.21,Main,,0,0,0,,تغيّر الوضع يا ماي
Dialogue: 0,0:18:59.38,0:19:03.66,Main,,0,0,0,,منذ ذلك الحين، جرّبنا نثر الطُعم عدّة مرّاتٍ
Dialogue: 0,0:19:03.98,0:19:10.85,Main,,0,0,0,,قبل بضع مئاتٍ من السنين، وطئتْ أقدام أوّل الدخلاء هذه الجزيرة
Dialogue: 0,0:19:12.83,0:19:15.66,Main,,0,0,0,,...حينها أدركنا
Dialogue: 0,0:19:16.63,0:19:18.87,Main,,0,0,0,,مدى روعة البشر
Dialogue: 0,0:19:21.11,0:19:23.91,Main,,0,0,0,,...كانت هشاشتهم وجودة التاو
Dialogue: 0,0:19:24.11,0:19:26.94,Main,,0,0,0,,أعظم ممّا توقّعنا
Dialogue: 0,0:19:27.74,0:19:32.47,Main,,0,0,0,,كانوا مكوّنًا أفضل بكثيرٍ من الهوكو
Dialogue: 0,0:19:35.57,0:19:38.57,Main,,0,0,0,,افتُتن ران بجمالهم
Dialogue: 0,0:19:38.66,0:19:40.72,Main,,0,0,0,,وبدا أنَّ مودان استمتع بوقته أيضًا
Dialogue: 0,0:19:41.43,0:19:43.00,Main,,0,0,0,,...وأدرك جوفا وتاوفا أيضًا
Dialogue: 0,0:19:43.00,0:19:47.33,Main,,0,0,0,,أنَّ استخدام البشر هو أسرع طريقةٍ لإنهاء تدريبنا
Dialogue: 0,0:19:47.56,0:19:50.04,Main,,0,0,0,,البشر مليئون بالشكوك
Dialogue: 0,0:19:50.23,0:19:52.50,Main,,0,0,0,,والشكّ هو جوهر التاو
Dialogue: 0,0:19:52.60,0:19:54.84,Main,,0,0,0,,يتأرجحون بين نقيضين
Dialogue: 0,0:19:55.02,0:19:57.33,Main,,0,0,0,,وهذا ما يجعل البشر رائعين للغاية
Dialogue: 0,0:19:57.98,0:19:59.34,Main,,0,0,0,,الحبّ والكراهية
Dialogue: 0,0:19:59.68,0:20:01.09,Main,,0,0,0,,الحياة والموت
Dialogue: 0,0:20:01.35,0:20:04.47,Main,,0,0,0,,نحن التينسين لا نعرف الحبّ ولا الموت
Dialogue: 0,0:20:04.80,0:20:09.43,Main,,0,0,0,,البحث عن مكوّنٍ آخر الآن ضربٌ من المستحيل
Dialogue: 0,0:20:10.12,0:20:13.61,Main,,0,0,0,,خاصّةً بعد أن اكتمل الإكسير
Dialogue: 0,0:20:14.07,0:20:16.70,Main,,0,0,0,,يستحيل أن نصل إلى تفاهمٍ الآن
Dialogue: 0,0:20:17.33,0:20:23.24,Main,,0,0,0,,لا أمانع ترككما ترحلان، لكن الهدنة بلا طائل
Dialogue: 0,0:20:23.58,0:20:27.59,Main,,0,0,0,,كلّ ما يسعنا فعله الآن هو سلب بعضنا البعض
Dialogue: 0,0:20:32.00,0:20:34.02,Main,,0,0,0,,...وبينما نتحدّث
Dialogue: 0,0:20:36.09,0:20:37.77,Main,,0,0,0,,سيُسلب آخرٌ
Dialogue: 0,0:20:50.32,0:20:51.32,Main,,0,0,0,,نوروغاي
Dialogue: 0,0:20:52.30,0:20:53.52,Main,,0,0,0,,كم بلغ العدد؟
Dialogue: 0,0:20:57.92,0:20:59.01,Main,,0,0,0,,...مئتان
Dialogue: 0,0:20:59.91,0:21:01.41,Main,,0,0,0,,...مئتان وخمسة عشر
Dialogue: 0,0:21:01.82,0:21:04.04,Main,,0,0,0,,قطعته 215 مرّة
Dialogue: 0,0:21:06.27,0:21:08.91,Main,,0,0,0,,قتلته 215 مرّة
Dialogue: 0,0:21:12.96,0:21:14.59,Main,,0,0,0,,تباطأ تجدّده
Dialogue: 0,0:21:15.36,0:21:16.59,Main,,0,0,0,,كما تناقشنا
Dialogue: 0,0:21:17.63,0:21:21.30,Main,,0,0,0,,لا يمكنك قتل خصمك دون تاو مُضادّ
Dialogue: 0,0:21:21.62,0:21:26.43,Main,,0,0,0,,لكن، أهذه الطريقة الوحيدة للتغلّب على التينسين-ساما؟
Dialogue: 0,0:21:26.43,0:21:29.43,Main,,0,0,0,,ماذا عن استنزافهم عبر التجدّد؟
Dialogue: 0,0:21:29.64,0:21:32.58,Main,,0,0,0,,يبدو أنّه يتباطأ عند تكراره في وقت قصير
Dialogue: 0,0:21:33.13,0:21:36.69,Main,,0,0,0,,استنزاف التاو للتجدّد مستحيلٌ على الأرجح
Dialogue: 0,0:21:36.69,0:21:40.96,Main,,0,0,0,,يمكنهم التجدّد مئة أو ألف مرّة
Dialogue: 0,0:21:40.96,0:21:44.65,Main,,0,0,0,,قتل شخصٍ ألف مرّة؟ وبخدعةٍ سحريّة؟
Dialogue: 0,0:21:44.77,0:21:45.68,Main,,0,0,0,,إنّه التاو
Dialogue: 0,0:21:45.89,0:21:48.26,Main,,0,0,0,,هذا مستحيلٌ على شخصٍ عاديّ
Dialogue: 0,0:21:59.41,0:22:02.26,Main,,0,0,0,,!أيّها المعلّم، لا يمكنكَ الاستمرار
Dialogue: 0,0:22:02.47,0:22:05.01,Main,,0,0,0,,أقلنا ألف مرّة؟
Dialogue: 0,0:22:05.23,0:22:07.51,Main,,0,0,0,,يبدو أنَّ الأمر سيتطلّب أقلّ من ذلك
Dialogue: 0,0:22:21.78,0:22:22.81,Main,,0,0,0,,!تبًّا
Dialogue: 0,0:22:22.93,0:22:23.95,Main,,0,0,0,,!انتظري يا نوروغاي
Dialogue: 0,0:22:26.61,0:22:28.58,Main,,0,0,0,,لا تلاحقيه
Dialogue: 0,0:22:28.58,0:22:32.46,Main,,0,0,0,,إنّه منهك أيضًا، ولن يتعافى على الفور
Dialogue: 0,0:22:32.46,0:22:35.74,Main,,0,0,0,,سنقضي عليه بحذرٍ وحسمٍ
Dialogue: 0,0:22:39.55,0:22:43.84,Main,,0,0,0,,!ما خطبك؟ أنتَ مُختلّ
Dialogue: 0,0:22:47.01,0:22:49.21,Main,,0,0,0,,من يسلب لا يسعه أن يفهم
Dialogue: 0,0:22:49.97,0:22:53.98,Main,,0,0,0,,فمن سُلِبَ لن ينسى أبدًا
Comment: 0,0:22:52.25,0:22:52.25,Note,,0,0,0,,
