Dialogue: 0,0:00:17.47,0:00:19.17,Main,,0,0,0,,شكرًا لك
Dialogue: 0,0:00:19.42,0:00:21.88,Main,,0,0,0,,حسمتُ أمري
Dialogue: 0,0:00:23.63,0:00:25.30,Main,,0,0,0,,هو كلّ ما أحتاجه
Dialogue: 0,0:00:25.63,0:00:28.92,Main,,0,0,0,,!لا أحتاج إلى أيّ شيء سواه
Dialogue: 0,0:00:44.91,0:00:46.61,Main,,0,0,0,,!أ... أخي
Dialogue: 0,0:00:49.20,0:00:51.03,Main,,0,0,0,,...طم
Dialogue: 0,0:00:51.44,0:00:54.30,Main,,0,0,0,,...أتحـ... طم
Dialogue: 0,0:00:54.30,0:00:57.29,Main,,0,0,0,,أنا... أتحطم
Dialogue: 0,0:02:33.38,0:02:35.76,Main,,0,0,0,,...أتحـ... طم
Dialogue: 0,0:02:43.39,0:02:44.55,Main,,0,0,0,,أتحطم
Dialogue: 0,0:02:48.71,0:02:50.02,Main,,0,0,0,,!نينبو: جسر اللّهب
Dialogue: 0,0:03:04.39,0:03:06.73,Main,,0,0,0,,!نينبو: لهيب الزهد
Dialogue: 0,0:03:12.26,0:03:13.56,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:03:15.18,0:03:16.37,Main,,0,0,0,,!غابيمارو
Dialogue: 0,0:03:18.30,0:03:19.47,Main,,0,0,0,,!أخي
Dialogue: 0,0:03:29.71,0:03:31.61,Main,,0,0,0,,ما هذا المكان؟
Dialogue: 0,0:03:31.92,0:03:33.27,Main,,0,0,0,,ما هذه الدوامة؟
Dialogue: 0,0:03:33.28,0:03:34.87,Main,,0,0,0,,الظلام دامسٌ ولا أرى شيئًا
Dialogue: 0,0:03:35.37,0:03:37.05,Main,,0,0,0,,أين ذلك النينجا؟
Dialogue: 0,0:03:38.30,0:03:40.19,Main,,0,0,0,,إذن هو داخل الدوامة
Dialogue: 0,0:03:41.11,0:03:43.74,Main,,0,0,0,,ظننتُ أنّنا كنّا نتقاتل
Dialogue: 0,0:03:43.89,0:03:45.96,Main,,0,0,0,,لا أعلم ما يجري حقًّا
Dialogue: 0,0:03:46.22,0:03:50.46,Main,,0,0,0,,رؤية هذه الدوامة تثير حنقي بلا سبب
Dialogue: 0,0:03:51.48,0:03:52.96,Main,,0,0,0,,إنّها مؤذية للعين
Dialogue: 0,0:03:54.53,0:03:55.82,Main,,0,0,0,,!أنت مؤذٍ للعين
Dialogue: 0,0:03:55.82,0:03:57.17,Main,,0,0,0,,!أنتَ عائق
Dialogue: 0,0:03:57.17,0:03:58.54,Main,,0,0,0,,!سأقتلك
Dialogue: 0,0:03:59.76,0:04:01.26,Main,,0,0,0,,!سأقضي عليك
Dialogue: 0,0:04:01.26,0:04:04.39,Main,,0,0,0,,!لا أدري ما تكون، لكنّي سأقتلك
Dialogue: 0,0:04:04.74,0:04:06.78,Main,,0,0,0,,تفحّم جسده تقريبًا
Dialogue: 0,0:04:06.82,0:04:09.06,Main,,0,0,0,,لِمَ لا يستخدم ذاك الشيء المسمّى بالتاو؟
Dialogue: 0,0:04:09.68,0:04:12.31,Main,,0,0,0,,غابيمارو عاجز عن استخدام التاو
Dialogue: 0,0:04:12.92,0:04:14.19,Main,,0,0,0,,نسي الطريقة
Dialogue: 0,0:04:14.37,0:04:16.86,Main,,0,0,0,,تاو العدوّ ضخم
Dialogue: 0,0:04:17.01,0:04:19.25,Main,,0,0,0,,غابيمارو... لن ينتصر
Dialogue: 0,0:04:19.57,0:04:22.27,Main,,0,0,0,,لن أنتصر إن استمرّ الوضع هكذا إذن
Dialogue: 0,0:04:22.40,0:04:25.07,Main,,0,0,0,,...إن استخدمتُ لهيب الزهد مجدّدًا، فهذه المرّة حتمًا
Dialogue: 0,0:04:27.44,0:04:30.39,Main,,0,0,0,,حتّى لو متُّ، فسيحلّ محلّي شخصٌ آخر من القرية
Dialogue: 0,0:04:30.39,0:04:33.21,Main,,0,0,0,,عليّ إزالة أكبر قدر ممكن من العقبات
Dialogue: 0,0:04:33.49,0:04:37.79,Main,,0,0,0,,قتله هنا أولى من حياتي
Dialogue: 0,0:04:58.38,0:05:00.32,Main,,0,0,0,,مهلًا مهلًا، سيموتُ حقًّا
Dialogue: 0,0:05:00.43,0:05:02.07,Main,,0,0,0,,ما الّذي ينوي فعله؟
Dialogue: 0,0:05:02.30,0:05:06.62,Main,,0,0,0,,هدفه نيل العفو، لكن لا طائل من ذلك إن مات
Dialogue: 0,0:05:06.78,0:05:08.58,Main,,0,0,0,,والأمر سيّان بالنسبة لخصمه
Dialogue: 0,0:05:08.69,0:05:11.08,Main,,0,0,0,,كلاهما فقد السيطرة على نفسه
Dialogue: 0,0:05:11.57,0:05:16.42,Main,,0,0,0,,مُحال... لأجل ماذا تفعل كلّ هذا يا أخي؟
Dialogue: 0,0:05:16.42,0:05:17.92,Main,,0,0,0,,لأيّ غاية؟
Dialogue: 0,0:05:19.35,0:05:20.43,Main,,0,0,0,,...أيُعقل
Dialogue: 0,0:05:21.10,0:05:23.40,Main,,0,0,0,,أراهن أنّك تركتَ أخاك يقوم بكلّ القتال الحقيقي
Dialogue: 0,0:05:23.45,0:05:25.68,Main,,0,0,0,,يمكنني معرفة ذلك بالنظر إلى وجهكَ الجميل
Dialogue: 0,0:05:26.15,0:05:28.98,Main,,0,0,0,,أهو لأجلي؟
Dialogue: 0,0:05:29.72,0:05:31.51,Main,,0,0,0,,!مُحال أن يكون هذا صحيحًا يا أخي
Dialogue: 0,0:05:32.22,0:05:37.02,Main,,0,0,0,,...لأنّني... لأنّنا
Dialogue: 0,0:05:39.58,0:05:40.68,Main,,0,0,0,,!أخي
Dialogue: 0,0:05:44.03,0:05:46.03,Main,,0,0,0,,!سأقتلك، سأقتلك
Dialogue: 0,0:05:47.09,0:05:49.18,Main,,0,0,0,,!أنتَ عقبة في طريقي
Dialogue: 0,0:05:49.18,0:05:51.97,Main,,0,0,0,,!الجميع أعداءٌ سوانا
Dialogue: 0,0:05:52.54,0:05:54.11,Main,,0,0,0,,...سوانا
Dialogue: 0,0:05:54.63,0:05:56.54,Main,,0,0,0,,...أنا
Dialogue: 0,0:05:58.82,0:06:01.52,Main,,0,0,0,,من... أنا؟
Dialogue: 0,0:06:02.43,0:06:03.34,Main,,0,0,0,,أخي
Dialogue: 0,0:06:09.42,0:06:11.59,Main,,0,0,0,,...أخي
Dialogue: 0,0:06:15.95,0:06:18.58,Main,,0,0,0,,أخي، أنا آسف
Dialogue: 0,0:06:19.27,0:06:22.73,Main,,0,0,0,,،ظننتُ أنّنا نقاتل سويًّا
Dialogue: 0,0:06:23.66,0:06:28.78,Main,,0,0,0,,لكنّك كنتَ تقاتل وحدك طوال الوقت، لأنّني ضعيف
Dialogue: 0,0:06:28.78,0:06:32.66,Main,,0,0,0,,لأنّني لستُ أهلًا للثقة... حتّى وصل بكَ الحال إلى هذا
Dialogue: 0,0:06:33.13,0:06:35.11,Main,,0,0,0,,استفق يا أخي
Dialogue: 0,0:06:35.86,0:06:38.17,Main,,0,0,0,,،أنا مجرّد جزء منك
Dialogue: 0,0:06:38.17,0:06:40.62,Main,,0,0,0,,لكنّكَ كلّ شيءٍ بالنسبة إلي
Dialogue: 0,0:06:41.34,0:06:42.42,Main,,0,0,0,,فرصة
Dialogue: 0,0:06:43.59,0:06:45.33,Main,,0,0,0,,!سأحرقهما حتّى الموت
Dialogue: 0,0:06:45.46,0:06:46.93,Main,,0,0,0,,!غابيمارو، لا
Dialogue: 0,0:06:46.93,0:06:48.22,Main,,0,0,0,,!انتبهي أيّتها الآنسة
Dialogue: 0,0:06:48.22,0:06:50.85,Main,,0,0,0,,!نفد التاو، سيموت
Dialogue: 0,0:06:50.85,0:06:52.39,Main,,0,0,0,,...نينبو
Dialogue: 0,0:07:01.41,0:07:02.95,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:07:04.05,0:07:05.99,Main,,0,0,0,,أهذا من فعلِ تلك الفتاة؟
Dialogue: 0,0:07:15.25,0:07:16.29,Main,,0,0,0,,!أخي
Dialogue: 0,0:07:16.65,0:07:18.29,Main,,0,0,0,,انتظرني يا توما
Dialogue: 0,0:07:23.76,0:07:24.94,Main,,0,0,0,,انتظرني
Dialogue: 0,0:07:29.06,0:07:31.56,Main,,0,0,0,,!أيّتها الآنسة، لا أعلم ما يحدث، لكن توقفي
Dialogue: 0,0:07:33.93,0:07:34.93,Main,,0,0,0,,!أيّتها الآنسة
Dialogue: 0,0:07:40.76,0:07:42.74,Main,,0,0,0,,ما الّذي يجري بحقّ السماء؟
Dialogue: 0,0:07:42.74,0:07:44.88,Main,,0,0,0,,أهذا بسبب التاو أيضًا؟
Dialogue: 0,0:07:50.35,0:07:53.24,Main,,0,0,0,,!يـ-يبدو أنّها كبرتْ، ومن نواحٍ عدّة
Dialogue: 0,0:07:53.57,0:07:55.28,Main,,0,0,0,,ما معنى هذا أيّها الأحمق؟
Dialogue: 0,0:07:55.28,0:07:57.10,Main,,0,0,0,,!إنّها ظريفة أيّها الأحمق
Dialogue: 0,0:07:57.26,0:07:58.92,Main,,0,0,0,,اخرس
Dialogue: 0,0:07:58.92,0:08:01.18,Main,,0,0,0,,سنعرف بمجرد أن أُشرّحها
Dialogue: 0,0:08:01.18,0:08:03.55,Main,,0,0,0,,!أنتَ وغدٌ أحمق بحقّ
Dialogue: 0,0:08:04.25,0:08:05.47,Main,,0,0,0,,حسبك
Dialogue: 0,0:08:11.69,0:08:13.79,Main,,0,0,0,,هذا المكان مليء بالألغاز
Dialogue: 0,0:08:13.79,0:08:15.82,Main,,0,0,0,,!ليشرح لي أحدكم هذا
Dialogue: 0,0:08:28.22,0:08:30.70,Main,,0,0,0,,،حين أنظر للأمر برويّةٍ
Dialogue: 0,0:08:31.47,0:08:33.33,Main,,0,0,0,,يبدو لي الأمر غريبًا حقًّا
Dialogue: 0,0:08:35.29,0:08:37.65,Main,,0,0,0,,لم أسمع هذه الأصوات من قبل
Dialogue: 0,0:08:37.65,0:08:39.05,Main,,0,0,0,,إنّها هالة
Dialogue: 0,0:08:39.05,0:08:42.04,Main,,0,0,0,,!إمّا أنَّ الشياطين تتربّص أو أنَّ العفاريت ستظهر
Dialogue: 0,0:08:42.29,0:08:45.79,Main,,0,0,0,,،إن كان غموض هذه الجزيرة مجرد زيفٍ
Dialogue: 0,0:08:45.79,0:08:49.15,Main,,0,0,0,,فمن صنع هذا وكيف؟
Dialogue: 0,0:08:51.80,0:08:52.81,Main,,0,0,0,,لنذهب
Dialogue: 0,0:08:56.84,0:08:59.18,Main,,0,0,0,,حقل تجارب للحياة
Dialogue: 0,0:08:59.78,0:09:01.41,Main,,0,0,0,,جزيرة مصطنعة
Dialogue: 0,0:09:02.19,0:09:05.68,Main,,0,0,0,,سأكون كاذبًا إن قلت إنّي لا أملك أدنى فكرة
Dialogue: 0,0:09:06.18,0:09:09.44,Main,,0,0,0,,عن ماهيّة الشعور المريب الّذي يخيّم على هذه الجزيرة
Dialogue: 0,0:09:15.28,0:09:16.37,Main,,0,0,0,,...لكن
Dialogue: 0,0:09:17.28,0:09:20.16,Main,,0,0,0,,بشرٌ يقتلون تينسين-ساما
Dialogue: 0,0:09:21.22,0:09:24.79,Main,,0,0,0,,سيغيّرون الجزيرة حتمًا
Dialogue: 0,0:09:26.22,0:09:30.03,Main,,0,0,0,,هل سأبقى على ماهيتي حينها؟
Dialogue: 0,0:09:42.77,0:09:43.78,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:09:45.78,0:09:47.49,Main,,0,0,0,,ساغيري، وشيون-سان
Dialogue: 0,0:09:47.49,0:09:48.78,Main,,0,0,0,,فوتشي-دونو
Dialogue: 0,0:09:48.78,0:09:49.80,Main,,0,0,0,,...و
Dialogue: 0,0:09:50.39,0:09:52.53,Main,,0,0,0,,...غابيمارو، تلك الإصابة
Dialogue: 0,0:09:52.72,0:09:54.27,Main,,0,0,0,,...عجبًا، تومـ
Dialogue: 0,0:09:55.78,0:09:59.43,Main,,0,0,0,,أين البقيّة؟ تين-كن وسين-تشان؟
Dialogue: 0,0:10:00.34,0:10:02.41,Main,,0,0,0,,وما هذه الملابس الّتي ترتدونها؟
Dialogue: 0,0:10:02.81,0:10:04.67,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:10:04.67,0:10:06.46,Main,,0,0,0,,ما الّذي يجري؟
Dialogue: 0,0:10:06.93,0:10:09.46,Main,,0,0,0,,ماي، هل استخدمتِ قواكِ؟
Dialogue: 0,0:10:10.11,0:10:12.72,Main,,0,0,0,,تكلّم، ما هذا الكائن؟
Dialogue: 0,0:10:12.72,0:10:15.55,Main,,0,0,0,,عليَّ شكركم
Dialogue: 0,0:10:15.71,0:10:18.60,Main,,0,0,0,,لم أظنّ أنّني سأحيا لألتقي بها مجدّدًا
Dialogue: 0,0:10:18.67,0:10:20.27,Main,,0,0,0,,أجئتم من قاع الوادي؟
Dialogue: 0,0:10:20.27,0:10:22.30,Main,,0,0,0,,لا بدّ أنّه كان يعجّ بالسوشين
Dialogue: 0,0:10:22.53,0:10:24.08,Main,,0,0,0,,أتعني تلك الوحوش؟
Dialogue: 0,0:10:24.31,0:10:25.64,Main,,0,0,0,,قتلناها جميعًا
Dialogue: 0,0:10:25.98,0:10:27.65,Main,,0,0,0,,أهذا دوشي؟
Dialogue: 0,0:10:27.78,0:10:28.79,Main,,0,0,0,,هل هزمتموه؟
Dialogue: 0,0:10:28.87,0:10:32.28,Main,,0,0,0,,أجل، واثنين آخرين
Dialogue: 0,0:10:32.28,0:10:34.53,Main,,0,0,0,,كيف تتكلّم وأنتَ مجرّد رأس بلا جسد؟
Dialogue: 0,0:10:35.69,0:10:37.53,Main,,0,0,0,,،طوال ألف عام
Dialogue: 0,0:10:38.53,0:10:40.41,Main,,0,0,0,,لم ألتقِ بأمثالهم قطّ
Dialogue: 0,0:10:40.78,0:10:43.91,Main,,0,0,0,,...يقتلون السوشين والدوشي
Dialogue: 0,0:10:43.91,0:10:46.06,Main,,0,0,0,,ويقتلون الآلهة حتّى
Dialogue: 0,0:10:49.39,0:10:55.34,Main,,0,0,0,,ما سيجلبونه للجزيرة قد يفوق مجرّد التّغيير
Dialogue: 0,0:11:05.21,0:11:06.87,Main,,0,0,0,,القلب ظريف
Dialogue: 0,0:11:05.33,0:11:07.98,Top,,0,0,0,,...كرهت الفكرة في البداية
Dialogue: 0,0:11:06.35,0:11:08.66,Top-2,,0,0,0,,ظننتُه حديثًا غريبًا في بادئ الأمر
Dialogue: 0,0:11:07.94,0:11:09.98,Main,,0,0,0,,يبدو أنَّ الدماغ في حالة ذعر، لكنّه رائع
Dialogue: 0,0:11:08.58,0:11:09.68,Top,,0,0,0,,...لكنّني اقتنعتُ
Dialogue: 0,0:11:09.47,0:11:11.88,Top-2,,0,0,0,,لكنّني اقتنعتُ بعد الاستماع
Dialogue: 0,0:11:10.36,0:11:12.63,Main,,0,0,0,,لكن لا شيء يضاهي الكبد حقًّا
Dialogue: 0,0:11:10.83,0:11:12.82,Top,,0,0,0,,ساغيري-سان، أترغبين برؤية التشريح أيضًا؟
Dialogue: 0,0:11:12.82,0:11:14.29,Main,,0,0,0,,لا، كان الأمر غريبًا طوال الوقت
Dialogue: 0,0:11:14.29,0:11:15.58,Main,,0,0,0,,إنّه ظريف للغاية
Dialogue: 0,0:11:14.23,0:11:16.43,Top,,0,0,0,,لنأكل هذه الزلابية بسرعة
Dialogue: 0,0:11:19.07,0:11:20.08,Main,,0,0,0,,فهمت
Dialogue: 0,0:11:20.75,0:11:24.70,Main,,0,0,0,,الناجون ممّن نزلوا الجزيرة ثمانية، أيّ أقلّ من النصف
Dialogue: 0,0:11:25.26,0:11:27.60,Main,,0,0,0,,!يا صاحبة المؤخرة المثيرة، ما زلتِ حيّةً إذن
Dialogue: 0,0:11:27.78,0:11:29.96,Main,,0,0,0,,أجل، هذا رائع، أليس كذلك؟
Dialogue: 0,0:11:30.26,0:11:34.05,Main,,0,0,0,,...علينا الابتعاد عن القلعة واللجوء لمكان آمن بأقصى سرعة، لكن
Dialogue: 0,0:11:34.28,0:11:38.22,Main,,0,0,0,,...غابيمارو ليس في حالة تسمح له بالمشي، إضافةً إلى
Dialogue: 0,0:11:38.77,0:11:41.70,Main,,0,0,0,,وكذلك... ماي-سان
Dialogue: 0,0:11:50.72,0:11:54.77,Main,,0,0,0,,لكن، لم أظنّ أن يسقط هذا العدد من القتلى في ثلاثة أيّامٍ فحسب
Dialogue: 0,0:11:55.21,0:11:57.69,Main,,0,0,0,,يا للأسف، كانوا من النخبة
Dialogue: 0,0:11:59.24,0:12:01.17,Main,,0,0,0,,لا تكن عاطفيًّا هكذا
Dialogue: 0,0:12:01.33,0:12:04.49,Main,,0,0,0,,نحن نتقاتل منذ البداية حتّى لا يبقى منّا سوى شخصٍ واحد
Dialogue: 0,0:12:04.70,0:12:08.24,Main,,0,0,0,,هل ظننتم أنّكم ستعودون جميعًا بسلام؟
Dialogue: 0,0:12:09.85,0:12:12.13,Main,,0,0,0,,كنتُ أنوي ذلك بجدّية تامّة
Dialogue: 0,0:12:13.18,0:12:15.13,Main,,0,0,0,,أهذا صديقك أيضًا؟
Dialogue: 0,0:12:15.43,0:12:17.76,Main,,0,0,0,,إنّه كالأفعى المتربِّصة
Dialogue: 0,0:12:18.00,0:12:20.78,Main,,0,0,0,,أبقيتُه حيًّا لكنّه لا ينبس ببنتِ شفةٍ
Dialogue: 0,0:12:20.78,0:12:22.26,Main,,0,0,0,,وهو عبءٌ فحسب
Dialogue: 0,0:12:22.40,0:12:24.79,Main,,0,0,0,,شاقًّا
Dialogue: 0,0:12:25.64,0:12:26.56,Main,,0,0,0,,توقّف
Dialogue: 0,0:12:27.45,0:12:29.44,Main,,0,0,0,,ربّما لديه ظروفه الخاصّة
Dialogue: 0,0:12:29.90,0:12:33.40,Main,,0,0,0,,والأهمّ من ذلك، لن أدع أحدًا يموت أمام عينيّ بعد الآن
Dialogue: 0,0:12:34.78,0:12:36.92,Main,,0,0,0,,باستثناء من يستهدف حياتنا
Dialogue: 0,0:12:38.17,0:12:41.16,Main,,0,0,0,,يبدو أنَّ رجاحةَ عقلكِ تُنافسُ ضخامةَ صدركِ
Dialogue: 0,0:12:43.02,0:12:45.16,Main,,0,0,0,,...آسفة على المقاطعة، ولكن
Dialogue: 0,0:12:45.37,0:12:47.29,Main,,0,0,0,,أيجدر بنا تجاهل غابيمارو؟
Dialogue: 0,0:12:47.41,0:12:49.41,Main,,0,0,0,,إنّه على شفا الموت تقريبًا
Dialogue: 0,0:12:50.40,0:12:53.17,Main,,0,0,0,,صحيح، علينا علاجه في مكانٍ ما بسرعة
Dialogue: 0,0:12:53.64,0:12:56.14,Main,,0,0,0,,إصابته بليغة لدرجة فقدانه لوعيه
Dialogue: 0,0:12:56.29,0:12:58.63,Main,,0,0,0,,كلّا، ليس بسبب إصابته
Dialogue: 0,0:12:58.81,0:13:01.27,Main,,0,0,0,,أبرحته ضربًا لأنّه كان هائجًا
Dialogue: 0,0:13:02.88,0:13:04.55,Main,,0,0,0,,حالته سيئةٌ فعلًا
Dialogue: 0,0:13:04.79,0:13:06.91,Main,,0,0,0,,لا بُدَّ أنّه استهلكَ الكثير من التاو
Dialogue: 0,0:13:07.07,0:13:08.56,Main,,0,0,0,,وقد يموت في أيّ لحظة
Dialogue: 0,0:13:09.15,0:13:13.47,Main,,0,0,0,,فعلتُ ما بوسعي، لكنَّ جراحه لم تلتئم قطّ
Dialogue: 0,0:13:13.56,0:13:14.56,Main,,0,0,0,,فوتشي-دونو
Dialogue: 0,0:13:14.93,0:13:16.69,Main,,0,0,0,,...الأمر لا يقتصر على جسده فحسب
Dialogue: 0,0:13:16.86,0:13:21.32,Main,,0,0,0,,بل يبدو وكأنَّ جوهره ككائنٍ حيٍّ قد تضرّر
Dialogue: 0,0:13:21.81,0:13:23.07,Main,,0,0,0,,...مستحيل
Dialogue: 0,0:13:25.59,0:13:26.41,Main,,0,0,0,,!غابيمارو
Dialogue: 0,0:13:26.48,0:13:28.60,Main,,0,0,0,,مهلًا، لا تجهد نفسك، استرح
Dialogue: 0,0:13:29.21,0:13:31.16,Main,,0,0,0,,لم أستعد طاقتي بعد
Dialogue: 0,0:13:31.36,0:13:32.96,Main,,0,0,0,,وزادت الوجوه الّتي لا أعرفها
Dialogue: 0,0:13:33.10,0:13:34.88,Main,,0,0,0,,عليَّ استيعاب ما يحدث أولًا
Dialogue: 0,0:13:36.08,0:13:38.80,Main,,0,0,0,,معك حقّ، سأرتاح قليلًا
Dialogue: 0,0:13:38.80,0:13:41.04,Main,,0,0,0,,كيف حال جرحك؟
Dialogue: 0,0:13:41.99,0:13:44.14,Main,,0,0,0,,أنا بخير، لذا دعيني وشأني
Dialogue: 0,0:13:45.68,0:13:48.14,Main,,0,0,0,,ما زلتَ رجلًا باردًا كعادتك
Dialogue: 0,0:13:48.42,0:13:51.68,Main,,0,0,0,,لن تلتئم تلك الجراح وحدها إن أهملتها
Dialogue: 0,0:13:51.88,0:13:53.10,Main,,0,0,0,,قد تموت إن لم تتوخَّ الحذر
Dialogue: 0,0:13:54.57,0:13:56.11,Main,,0,0,0,,لا يهمّني
Dialogue: 0,0:13:58.43,0:14:00.86,Main,,0,0,0,,من أنت؟
Dialogue: 0,0:14:00.86,0:14:01.86,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:14:03.59,0:14:06.49,Main,,0,0,0,,أنتِ تعرفين، أنا غابيمارو من غاران
Dialogue: 0,0:14:08.11,0:14:09.49,Main,,0,0,0,,كما ظننتُ
Dialogue: 0,0:14:15.84,0:14:18.28,Main,,0,0,0,,ساغيري، ما معنى هذا؟
Dialogue: 0,0:14:18.44,0:14:22.72,Main,,0,0,0,,ذاكرته مشوّشة بسبب اضطراب التاو لديه على الأرجح
Dialogue: 0,0:14:23.29,0:14:26.26,Main,,0,0,0,,إنّه ليس الشخص الّذي أعرفه الآن
Dialogue: 0,0:14:29.09,0:14:32.77,Main,,0,0,0,,أجل، روحه متآكلةٌ للغاية
Dialogue: 0,0:14:33.24,0:14:37.77,Main,,0,0,0,,لا بُدَّ أنّكَ كنتَ تقاتل طوال فترة غيابنا، فهذا ما تفعله دائمًا
Dialogue: 0,0:14:38.10,0:14:39.98,Main,,0,0,0,,...قاتلتَ وقاتلتَ
Dialogue: 0,0:14:40.18,0:14:43.28,Main,,0,0,0,,ونهضت كلّما سقطتَ دون راحةٍ
Dialogue: 0,0:14:43.70,0:14:45.97,Main,,0,0,0,,...وكلّه لأجل غايةٍ واحدةٍ فحسب
Dialogue: 0,0:14:47.14,0:14:48.25,Main,,0,0,0,,...ساغيري
Dialogue: 0,0:14:48.25,0:14:50.29,Main,,0,0,0,,دعوا لي هذا الأمر رجاءً
Dialogue: 0,0:14:50.29,0:14:53.29,Main,,0,0,0,,...ماذا أفعل؟ أأقتلها؟ لكن
Dialogue: 0,0:14:53.71,0:14:57.67,Main,,0,0,0,,لِمَ يضطرب قلبي حين أنظر لهذه المرأة؟
Dialogue: 0,0:14:57.79,0:15:01.80,Main,,0,0,0,,حسنٌ يا غابيمارو، أتدرك سبب وجودك هنا؟
Dialogue: 0,0:15:03.16,0:15:05.41,Main,,0,0,0,,أنتَ فاقدٌ للذاكرة حاليًّا
Dialogue: 0,0:15:05.57,0:15:09.18,Main,,0,0,0,,لكن يبدو أنَّ بإمكانكَ التعافي عبر تبادل التاو مع شريكٍ متوافق
Dialogue: 0,0:15:09.53,0:15:11.32,Main,,0,0,0,,لنجرّب ذلك أولًا
Dialogue: 0,0:15:12.11,0:15:14.66,Main,,0,0,0,,لا تحذر منّي، لستُ عدوّةً
Dialogue: 0,0:15:15.25,0:15:16.25,Main,,0,0,0,,...أنا
Dialogue: 0,0:15:18.09,0:15:21.44,Main,,0,0,0,,أنا منفّذة حكم الإعدام، ولستُ حليفتكَ
Dialogue: 0,0:15:21.90,0:15:24.86,Main,,0,0,0,,ما الّذي يمثّله غابيمارو بالنسبة لكِ؟
Dialogue: 0,0:15:25.17,0:15:26.59,Main,,0,0,0,,...أنا
Dialogue: 0,0:15:30.12,0:15:34.03,Main,,0,0,0,,أنا رفيقتكَ الغالية
Dialogue: 0,0:15:34.03,0:15:36.69,Main,,0,0,0,,لذا ثق بي رجاءً
Dialogue: 0,0:15:37.37,0:15:39.25,Main,,0,0,0,,!هيّا، اقترب
Dialogue: 0,0:15:40.26,0:15:41.81,Main,,0,0,0,,لا تحذر منّي
Dialogue: 0,0:15:43.10,0:15:44.28,Main,,0,0,0,,كلّ شيءٍ بخير
Dialogue: 0,0:15:44.76,0:15:46.01,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:15:47.26,0:15:48.64,Main,,0,0,0,,!حسبك
Dialogue: 0,0:15:51.89,0:15:54.86,Main,,0,0,0,,يبدو أنّكَ استهلكتَ الكثير من التاو حقًّا
Dialogue: 0,0:15:54.86,0:15:56.89,Main,,0,0,0,,إنّها قويّة
Dialogue: 0,0:15:57.12,0:15:59.79,Main,,0,0,0,,...قلتُ إنّي رفيقتكَ الغالية، ولكن
Dialogue: 0,0:15:59.89,0:16:01.55,Main,,0,0,0,,لا أراه مناسبًا بأيّ حال
Dialogue: 0,0:16:02.12,0:16:04.79,Main,,0,0,0,,فعلاقتي بكَ ليست فاترةً هكذا
Dialogue: 0,0:16:05.72,0:16:08.19,Main,,0,0,0,,لندع المجاملات المخجلة جانبًا
Dialogue: 0,0:16:08.34,0:16:11.28,Main,,0,0,0,,نحن بحاجةٍ إلى قوّتكَ الآن
Dialogue: 0,0:16:11.51,0:16:13.50,Main,,0,0,0,,إن لم يعجبكَ الأمر، فحاول إبعادي بنفسك
Dialogue: 0,0:16:13.63,0:16:14.29,Main,,0,0,0,,...ما
Dialogue: 0,0:16:15.29,0:16:16.58,Main,,0,0,0,,ما بين السكون والحركة
Dialogue: 0,0:16:19.80,0:16:22.00,Main,,0,0,0,,حركاتكَ تفتقر للقوّة تمامًا
Dialogue: 0,0:16:22.62,0:16:25.32,Main,,0,0,0,,أشعر وكأنّي أنتقم لما حدث سابقًا
Dialogue: 0,0:16:25.45,0:16:27.76,Main,,0,0,0,,لنستمرّ قليلًا بعد
Dialogue: 0,0:16:28.38,0:16:29.99,Main,,0,0,0,,ماذا يفعلان؟
Dialogue: 0,0:16:30.00,0:16:31.60,Main,,0,0,0,,أهذا بوتشوجوتسو؟
Dialogue: 0,0:16:31.72,0:16:32.89,Main,,0,0,0,,كلّا بالطبع
Dialogue: 0,0:16:32.97,0:16:33.76,Main,,0,0,0,,كلّا
Dialogue: 0,0:16:34.00,0:16:36.27,Main,,0,0,0,,لكنّه يشبهه قليلًا
Dialogue: 0,0:16:36.54,0:16:39.30,Main,,0,0,0,,يتدفق التاو عبر التلامس
Dialogue: 0,0:16:39.47,0:16:41.27,Main,,0,0,0,,إنّه يتعافى
Dialogue: 0,0:16:41.43,0:16:43.74,Main,,0,0,0,,لم أكن أعلم أنَّ لساغيري جانبًا كهذا
Dialogue: 0,0:16:43.89,0:16:45.28,Main,,0,0,0,,أنا متفاجئ أيضًا
Dialogue: 0,0:16:45.70,0:16:47.12,Main,,0,0,0,,...لكن تلك الهالة
Dialogue: 0,0:16:47.90,0:16:49.90,Main,,0,0,0,,توافق التاو بينهما جيّد
Dialogue: 0,0:16:50.13,0:16:53.78,Main,,0,0,0,,لا بُدَّ أنَّ بينهما رابطًا أجهله
Dialogue: 0,0:16:54.60,0:16:56.70,Main,,0,0,0,,ما هذا الشعور؟
Dialogue: 0,0:16:56.90,0:16:59.04,Main,,0,0,0,,وكأنَّ طاقتي تعود إليّ
Dialogue: 0,0:16:59.46,0:17:02.42,Main,,0,0,0,,علينا التعاون لنعود جميعًا
Dialogue: 0,0:17:02.76,0:17:03.92,Main,,0,0,0,,...وأيضًا
Dialogue: 0,0:17:04.71,0:17:05.67,Main,,0,0,0,,...وأيضًا
Dialogue: 0,0:17:07.74,0:17:10.24,Main,,0,0,0,,لديكَ شخصٌ تودّ لقاءه، أليس كذلك؟
Dialogue: 0,0:17:29.58,0:17:31.77,Main,,0,0,0,,ابتلعني التاو
Dialogue: 0,0:17:31.90,0:17:33.81,Main,,0,0,0,,وفقدتُ نفسي
Dialogue: 0,0:17:33.99,0:17:36.81,Main,,0,0,0,,إنّها قوّة غامضة وخطيرة
Dialogue: 0,0:17:38.50,0:17:42.37,Main,,0,0,0,,خطيرة، لكنّ إتقانها يجعل المرء لا يُقهر
Dialogue: 0,0:17:46.10,0:17:47.31,Main,,0,0,0,,انتظرني
Dialogue: 0,0:17:51.21,0:17:53.61,Main,,0,0,0,,من أين خرجتم جميعًا؟
Dialogue: 0,0:17:53.76,0:17:56.76,Main,,0,0,0,,حسنٌ، ستكونون تدريبًا جيّدًا على التاو
Dialogue: 0,0:17:57.54,0:17:59.02,Main,,0,0,0,,أنتم هناك
Dialogue: 0,0:17:59.14,0:18:02.02,Main,,0,0,0,,آمل أن يكون لحمكم لذيذًا
Dialogue: 0,0:18:04.86,0:18:06.15,Main,,0,0,0,,...المكان ضيّق
Dialogue: 0,0:18:06.61,0:18:09.20,Main,,0,0,0,,لكن يمكننا الاختباء من الوحوش هنا
Dialogue: 0,0:18:09.36,0:18:12.48,Main,,0,0,0,,أنا من وجده، لذا اشكروني
Dialogue: 0,0:18:12.56,0:18:13.78,Main,,0,0,0,,لا ترخِ دفاعك
Dialogue: 0,0:18:14.58,0:18:17.28,Main,,0,0,0,,لدى التينسين-ساما إدراكٌ لما حولهم من غير أعينهم
Dialogue: 0,0:18:17.49,0:18:19.00,Main,,0,0,0,,يا لكَ من جبان
Dialogue: 0,0:18:19.03,0:18:21.29,Main,,0,0,0,,أتخافُ من التينسين إلى هذا الحدّ؟
Dialogue: 0,0:18:21.54,0:18:23.07,Main,,0,0,0,,السعادة للمغفّلين
Dialogue: 0,0:18:23.19,0:18:23.92,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:18:24.25,0:18:25.54,Main,,0,0,0,,إنّهم مرعبون
Dialogue: 0,0:18:25.76,0:18:28.04,Main,,0,0,0,,لا يموتون مهما قطّعتهم
Dialogue: 0,0:18:28.36,0:18:31.55,Main,,0,0,0,,إنّهم وحوشٌ تطلّب قتل واحدٍ منهم خمسة أشخاص
Dialogue: 0,0:18:32.00,0:18:34.22,Main,,0,0,0,,...وبما أنّنا أحدثنا كلّ تلك الجلبة في عقر دارهم
Dialogue: 0,0:18:34.39,0:18:36.44,Main,,0,0,0,,فسينتبه البقيّة عاجلًا أم آجلًا
Dialogue: 0,0:18:37.77,0:18:40.31,Main,,0,0,0,,واجهتهم أيضًا، أليس كذلك؟
Dialogue: 0,0:18:40.56,0:18:41.57,Main,,0,0,0,,يا غابيمارو
Dialogue: 0,0:18:42.26,0:18:45.19,Main,,0,0,0,,أجل، أمام البوّابة
Dialogue: 0,0:18:45.36,0:18:48.19,Main,,0,0,0,,عادتْ ذاكرتكَ إذن
Dialogue: 0,0:18:49.18,0:18:50.74,Main,,0,0,0,,شيئًا فشيئًا
Dialogue: 0,0:18:52.76,0:18:55.82,Main,,0,0,0,,آسف على المتاعب
Dialogue: 0,0:18:57.07,0:18:59.86,Main,,0,0,0,,لكنّني تعلّمتُ الدرس بفضل ذلك
Dialogue: 0,0:19:00.05,0:19:03.96,Main,,0,0,0,,...قوّة التاو، وشدّته، وردّ الفعل ذاك
Dialogue: 0,0:19:04.11,0:19:06.83,Main,,0,0,0,,ورعب التينسين-ساما الّذين يتحكّمون به
Dialogue: 0,0:19:07.02,0:19:09.53,Main,,0,0,0,,إذن، ألا يجدر بنا مغادرة الجزيرة بسرعة؟
Dialogue: 0,0:19:09.65,0:19:11.96,Main,,0,0,0,,...بدلًا من مواجهة هؤلاء الخطيرين
Dialogue: 0,0:19:12.14,0:19:16.09,Main,,0,0,0,,أظنّ أنَّ خداع جماعة الشوغون يحمل أملًا أكبر
Dialogue: 0,0:19:16.36,0:19:19.22,Main,,0,0,0,,لن أقابل زوجتي إن وقفتُ مكتوف اليدين
Dialogue: 0,0:19:19.37,0:19:22.58,Main,,0,0,0,,دون وثيقة العفو الّتي تضمن براءتي وحمايتي
Dialogue: 0,0:19:24.03,0:19:26.48,Main,,0,0,0,,...بخصوص ذلك
Dialogue: 0,0:19:33.01,0:19:35.36,Main,,0,0,0,,وهم إذن، فهمت
Dialogue: 0,0:19:35.61,0:19:38.73,Main,,0,0,0,,...عبر إظهار وهم زوجة لا وجود لها
Dialogue: 0,0:19:38.81,0:19:40.53,Main,,0,0,0,,يتحكّم بك كما يشاء
Dialogue: 0,0:19:40.70,0:19:43.22,Main,,0,0,0,,أليس هذا ما دبّره زعيم قرية إيواغاكوري؟
Dialogue: 0,0:19:44.11,0:19:46.81,Main,,0,0,0,,حسنٌ، سأعرف بمجرد عودتي للبرّ الرئيسي
Dialogue: 0,0:19:46.96,0:19:48.37,Main,,0,0,0,,هدفي لم يتغيّر
Dialogue: 0,0:19:48.67,0:19:50.00,Main,,0,0,0,,سأبحث عن إكسير الحياة
Dialogue: 0,0:19:50.11,0:19:50.77,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:19:50.90,0:19:52.50,Main,,0,0,0,,مـ-مهلًا لحظة
Dialogue: 0,0:19:52.76,0:19:55.52,Main,,0,0,0,,أقول إنّه يجدر بنا تجنّب الخطر
Dialogue: 0,0:19:55.62,0:19:59.26,Main,,0,0,0,,لا طائل من جلب الإكسير إن لم تكن زوجتك موجودة من الأساس
Dialogue: 0,0:19:59.55,0:20:01.27,Main,,0,0,0,,إنّها موجودة حتمًا
Dialogue: 0,0:20:01.32,0:20:02.76,Main,,0,0,0,,كيف تجزم بذلك؟
Dialogue: 0,0:20:02.98,0:20:04.30,Main,,0,0,0,,لأنّني أشعر بها
Dialogue: 0,0:20:04.49,0:20:05.12,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:20:05.16,0:20:05.98,Main,,0,0,0,,ما معنى هذا؟
Dialogue: 0,0:20:05.99,0:20:06.97,Main,,0,0,0,,يوزوريها-سان
Dialogue: 0,0:20:07.04,0:20:09.77,Main,,0,0,0,,ماذا؟ هل مراعاة المشاعر ستفيدنا بشيء؟
Dialogue: 0,0:20:10.01,0:20:12.66,Main,,0,0,0,,توضيح الأمر أفضل لغابي
Dialogue: 0,0:20:12.80,0:20:17.09,Main,,0,0,0,,غابيمارو منطقيٌّ في القتال، لكنّه غامض للغاية هنا
Dialogue: 0,0:20:17.23,0:20:18.66,Main,,0,0,0,,أليس لديكَ الجواب؟
Dialogue: 0,0:20:18.90,0:20:20.34,Main,,0,0,0,,أيمكنكَ إثبات ذلك؟
Dialogue: 0,0:20:24.10,0:20:25.16,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:20:25.55,0:20:30.67,Main,,0,0,0,,لستُ فصيحًا مثلكِ، لذا لا أجيد التعبير
Dialogue: 0,0:20:31.30,0:20:34.64,Main,,0,0,0,,لا أتذكّر سوى... التفاصيل الصغيرة
Dialogue: 0,0:20:36.35,0:20:38.30,Main,,0,0,0,,...مثل صوتها
Dialogue: 0,0:20:38.45,0:20:40.43,Main,,0,0,0,,عالٍ قليلًا وهادئ
Dialogue: 0,0:20:40.90,0:20:44.18,Main,,0,0,0,,ونبرتها... كيف أصفها؟
Dialogue: 0,0:20:45.14,0:20:47.18,Main,,0,0,0,,عيناها اللتان تنعقدانِ ضيقًا مع كلِّ ضحكةٍ
Dialogue: 0,0:20:47.67,0:20:49.66,Main,,0,0,0,,وأصابعها الطويلة الناعمة
Dialogue: 0,0:20:50.24,0:20:52.49,Main,,0,0,0,,والرائحة الزكيّة حين يتطاير شعرها
Dialogue: 0,0:20:53.62,0:20:58.95,Main,,0,0,0,,...حين نجلس على الشرفة في الأيّام المشمسة وسط رائحة الشمس والعشب
Dialogue: 0,0:20:59.26,0:21:01.00,Main,,0,0,0,,أشمّ رائحتها
Dialogue: 0,0:21:06.85,0:21:08.18,Main,,0,0,0,,أشمّها الآن أيضًا
Dialogue: 0,0:21:18.29,0:21:19.38,Main,,0,0,0,,عزيزي
Dialogue: 0,0:21:23.20,0:21:24.05,Main,,0,0,0,,يوي
Dialogue: 0,0:21:25.83,0:21:27.32,Main,,0,0,0,,هذا اسمها
Dialogue: 0,0:21:28.22,0:21:29.10,Main,,0,0,0,,يوي
Dialogue: 0,0:21:29.63,0:21:31.74,Main,,0,0,0,,إنّها ليست وهمًا
Dialogue: 0,0:21:31.89,0:21:33.15,Main,,0,0,0,,أشعر بها
Dialogue: 0,0:21:33.53,0:21:37.65,Main,,0,0,0,,...يصعب عليَّ إثبات ذلك، لذا
Dialogue: 0,0:21:38.67,0:21:41.15,Main,,0,0,0,,لا خيار أمامي سوى مغادرة الجزيرة ولقائها مجدّدًا
Dialogue: 0,0:21:42.13,0:21:43.66,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:21:44.57,0:21:46.16,Main,,0,0,0,,أنتَ محقّ
Dialogue: 0,0:21:46.67,0:21:50.29,Main,,0,0,0,,أتنوي توريط الآخرين لأجل نزواتك؟
Dialogue: 0,0:21:51.37,0:21:52.29,Main,,0,0,0,,إنّها زوجتي
Dialogue: 0,0:21:53.75,0:21:56.53,Main,,0,0,0,,يا لكَ من رجل، أعجبتني
Dialogue: 0,0:21:56.69,0:21:59.51,Main,,0,0,0,,سأرافقكَ ما دام الأمر لا يتعارض مع طموحاتي
Dialogue: 0,0:22:00.39,0:22:02.86,Main,,0,0,0,,فسأقضي على الوحوش في كلّ الأحوال
Dialogue: 0,0:22:04.29,0:22:07.26,Main,,0,0,0,,لا يتعارض... يا لكَ من داهية
Dialogue: 0,0:22:08.60,0:22:11.75,Main,,0,0,0,,تكشف نقاط ضعفك رغم أنّك شينوبي
Dialogue: 0,0:22:11.86,0:22:14.38,Main,,0,0,0,,...لكن، ربّما لهذا السبب
Dialogue: 0,0:22:14.48,0:22:15.16,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:22:15.23,0:22:18.48,Main,,0,0,0,,تموّج التاو بقوّة حين كان يتحدّث
Dialogue: 0,0:22:18.61,0:22:21.57,Main,,0,0,0,,ربّما يمثّل الين واليانغ الضعف والقوّة بالنسبة له
Dialogue: 0,0:22:22.51,0:22:26.28,Main,,0,0,0,,إنّها كميّةٌ هائلةٌ في ذلك الجسد الضئيل حقًّا
Dialogue: 0,0:22:26.55,0:22:30.17,Main,,0,0,0,,من يملك شيئًا يخاف فقدانه قويّ
Dialogue: 0,0:22:42.37,0:22:44.43,Main,,0,0,0,,طعم الحثالة مقرف
Dialogue: 0,0:22:44.49,0:22:46.16,Main,,0,0,0,,يا للغرابة
Dialogue: 0,0:22:47.76,0:22:50.17,Main,,0,0,0,,دخيل
Dialogue: 0,0:22:50.34,0:22:54.07,Main,,0,0,0,,أأنتَ من قتل مودان؟
Comment: 0,0:22:52.25,0:22:52.25,Note,,0,0,0,,
