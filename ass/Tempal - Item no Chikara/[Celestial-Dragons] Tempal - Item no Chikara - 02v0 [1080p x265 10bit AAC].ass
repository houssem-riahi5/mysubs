Dialogue: 0,0:00:05.48,0:00:06.57,Main,Irene,0,0,0,,!دوران
Dialogue: 0,0:00:07.53,0:00:12.49,Main,Doran,0,0,0,,أنقذتكِ يا سيّدتي بفضل مغامرٍ مجهول الهويّة
Dialogue: 0,0:00:12.89,0:00:16.81,Main,Doran,0,0,0,,...من يُميّز هذا الخاتم
Dialogue: 0,0:00:17.90,0:00:21.50,Main,Doran,0,0,0,,فلتتّخذيه سندًا لكِ
Dialogue: 0,0:00:26.24,0:00:27.88,Main,Hinako,0,0,0,,....بشأن حادثة انهيار معبد ياتان
Dialogue: 0,0:00:27.88,0:00:29.96,Main,Hinako,0,0,0,,في شمال مملكة إيتيرنال ليلة البارحة
Dialogue: 0,0:00:30.41,0:00:32.70,Main,Hinako,0,0,0,,،نشبت الكارثة إثر معركةٍ خاضها غريد ويورا
Dialogue: 0,0:00:32.70,0:00:34.43,Main,Hinako,0,0,0,,وتنافسا فيها على إتمام مهمّة
Dialogue: 0,0:00:34.69,0:00:36.68,Main,Hinako,0,0,0,,وانتهت المعركة بانتصار يورا
Dialogue: 0,0:00:37.91,0:00:41.96,Main,Sakaeda,0,0,0,,خاضت يورا مهمّة كنيسة ياتان؛ "خادم الإله ياتان" إذن
Dialogue: 0,0:00:42.18,0:00:47.26,Main,Sakaeda,0,0,0,,وفوق ذلك، مشاركة غريد في الأمر تثير الاهتمام حقًّا
Dialogue: 0,0:00:47.71,0:00:48.88,Main,Sakaeda,0,0,0,,أين يورا الآن؟
Dialogue: 0,0:00:48.88,0:00:52.06,Main,Hinako,0,0,0,,ترفع مستواها حاليًّا في أراضي شمال إيتيرنال القاحلة
Dialogue: 0,0:00:52.42,0:00:55.22,Main,Hinako,0,0,0,,،ظلّت متّصلةً باللعبة حتّى بعد إتمام المهمّة
Dialogue: 0,0:00:55.22,0:00:58.03,Main,Hinako,0,0,0,,لذا سيبلغ جسدها في العالم الواقعيّ أقصى طاقته قريبًا
Dialogue: 0,0:00:58.65,0:01:01.23,Main,Sakaeda,0,0,0,,يبدو أنَّ ما حدث أربكها كثيرًا إذن
Dialogue: 0,0:01:01.91,0:01:02.91,Main,Sakaeda,0,0,0,,لا عجب في ذلك
Dialogue: 0,0:01:03.37,0:01:06.31,Main,Sakaeda,0,0,0,,...أيّ مفاجآتٍ ستكشفُها لنا تاليًا، لا
Dialogue: 0,0:01:06.43,0:01:08.92,Main,Sakaeda,0,0,0,,بل لساتيسفاي يا ترى؟
Dialogue: 0,0:01:10.62,0:01:12.49,Main,Sakaeda,0,0,0,,أترقّب ذلك بشوقٍ يا غريد
Dialogue: 0,0:02:48.94,0:02:49.94,Main,AI,0,0,0,,نظام الإرشاد
Dialogue: 0,0:02:51.40,0:02:52.64,Main,Grid,0,0,0,,قرية بايران؟
Dialogue: 0,0:02:50.57,0:02:55.45,Top,AI,0,0,0,,نظرًا لمعاداتكَ لكنيسة ياتان، يتعذّر عليكَ البعث في معبد ياتان
Dialogue: 0,0:02:55.45,0:02:57.62,Main,Grid,0,0,0,,هكذا الأمر إذن
Dialogue: 0,0:02:57.62,0:03:00.70,Main,Grid,0,0,0,,...زرتُ هذه القرية من قبل، ولكن
Dialogue: 0,0:03:01.87,0:03:06.33,Main,User,0,0,0,,!مطلوب ساحر يتجاوز مستواه 130 للذهاب إلى أطلال مبايد
Dialogue: 0,0:03:06.33,0:03:10.13,Main,Toban,0,0,0,,!شاركوني لنحصل على أقوى المعادن؛ الأوريكالكوم الأزرق
Dialogue: 0,0:03:10.13,0:03:12.42,Main,Toban,0,0,0,,!المستويات المطلوبة فوق 100
Dialogue: 0,0:03:12.42,0:03:14.51,Main,Grid,0,0,0,,!المستويات عالية للغاية
Dialogue: 0,0:03:14.51,0:03:18.01,Main,Grid,0,0,0,,حسنٌ، فكلّ وحوش هذه المنطقة يتجاوز مستواها 100 على أيّ حال
Dialogue: 0,0:03:18.43,0:03:19.97,Main,Grid,0,0,0,,...المستوى 100
Dialogue: 0,0:03:20.93,0:03:22.43,Main,Grid,0,0,0,,!لا يسعني مغادرة القرية حتّى
Dialogue: 0,0:03:24.48,0:03:28.35,Main,Grid,0,0,0,,عفوًا، أودّ الذهاب إلى قريةٍ تناسب أدنى المستويات
Dialogue: 0,0:03:28.35,0:03:31.15,Main,Man,0,0,0,,إن كنتَ مبتدئًا فقرية وينستون هي وجهتكَ
Dialogue: 0,0:03:31.15,0:03:33.03,Main,Man,0,0,0,,الأجرة 10 قطع ذهبيّة
Dialogue: 0,0:03:33.03,0:03:34.36,Main,Grid,0,0,0,,...حسنٌ
Dialogue: 0,0:03:37.61,0:03:38.61,Main,Man,0,0,0,,!اغرب عن وجهي
Dialogue: 0,0:03:39.16,0:03:41.20,Main,Grid,0,0,0,,...في الواقع، أمّي مريضة
Dialogue: 0,0:03:41.20,0:03:42.08,Main,Man,0,0,0,,!اغرب عن وجهي
Dialogue: 0,0:03:44.29,0:03:46.58,Main,Grid,0,0,0,,!رأسماليّة بلا رحمة
Dialogue: 0,0:03:46.58,0:03:51.34,Main,Grid,0,0,0,,!مهلًا، فئتي أسطوريّة، أنا حدّادٌ أسطوريّ
Dialogue: 0,0:03:51.71,0:03:54.51,Main,Grid,0,0,0,,!من هنا تبدأ أسطورتي
Dialogue: 0,0:03:55.59,0:03:56.30,Main,Grid,0,0,0,,...على الأرجح
Dialogue: 0,0:03:57.26,0:03:58.80,Main,Grid,0,0,0,,!مُذهل
Dialogue: 0,0:03:58.80,0:04:01.09,Main,Grid,0,0,0,,...تمنحني المهارات الّتي أتقنتها وحدها
Dialogue: 0,0:04:01.13,0:04:05.10,Main,Grid,0,0,0,,!زيادةً قدرها 10% على خصائص الأغراض المصنوعة لجميع الفئات
Dialogue: 0,0:04:05.10,0:04:08.27,Main,Grid,0,0,0,,!علاوةً على مهارةٍ تتيح لي صنع أيّ غرضٍ بحرّيّة
Dialogue: 0,0:04:08.27,0:04:09.81,Main,AI,0,0,0,,نظام الإرشاد
Dialogue: 0,0:04:09.81,0:04:12.90,Main,AI,0,0,0,,تفعيل مهارة ابتكار الحدّاد الأسطوريّ
Dialogue: 0,0:04:12.90,0:04:14.90,Main,AI,0,0,0,,أيُّ غرضٍ تودُّ صنعه؟
Dialogue: 0,0:04:14.90,0:04:17.03,Main,Grid,0,0,0,,سيفٌ عظيمٌ بطبيعة الحال
Dialogue: 0,0:04:17.40,0:04:19.70,Main,AI,0,0,0,,ما الموادّ الّتي ستستخدمها؟
Dialogue: 0,0:04:19.70,0:04:22.07,Main,Grid,0,0,0,,الأفضل أن تكون مادّةً قويّةً بالطبع
Dialogue: 0,0:04:22.53,0:04:24.41,Main,Grid,0,0,0,,!وجدته، الأوريكالكوم الأزرق
Dialogue: 0,0:04:25.24,0:04:28.37,Main,AI,0,0,0,,يُرجى إدخال المخطّط وخصائص السلاح
Dialogue: 0,0:04:29.45,0:04:30.23,Main,Grid,0,0,0,,!حسنٌ
Dialogue: 0,0:04:30.25,0:04:34.46,Main,Grid,0,0,0,,!ضخمٌ وقويٌّ ويشبه القرش، وقوّة هجومه تتجاوز عشرة ملايين
Dialogue: 0,0:04:34.71,0:04:36.96,Main,Grid,0,0,0,,!ويُسقط نيزكًا مع كلّ هجوم
Dialogue: 0,0:04:36.96,0:04:40.30,Main,Grid,0,0,0,,!ويتجاهل دفاع الخصم ليقضي عليه بضربةٍ واحدة
Dialogue: 0,0:04:40.30,0:04:41.76,Main,Grid,0,0,0,,!اكتمل
Dialogue: 0,0:04:42.39,0:04:44.18,Main,Grid,0,0,0,,!يا لروعته
Dialogue: 0,0:04:44.72,0:04:46.81,Main,Grid,0,0,0,,!يشبه سمكة القرش حقًّا
Dialogue: 0,0:04:46.81,0:04:48.60,Main,Grid,0,0,0,,مع أنّه يبدو كالسردين أيضًا
Dialogue: 0,0:04:48.60,0:04:51.69,Main,Grid,0,0,0,,!أأنا عبقريّ؟ أأنا عبقريّ حقًّا؟
Dialogue: 0,0:04:51.69,0:04:53.44,Main,AI,0,0,0,,بدء الموازنة التلقائيّة
Dialogue: 0,0:04:53.73,0:04:55.15,Main,AI,0,0,0,,،ستُعدّل خصائص السلاح وميزاته تلقائيًّا
Dialogue: 0,0:04:55.15,0:04:58.99,Main,AI,0,0,0,,بالموازنة بين الموادّ وتفاصيل التصميم
Dialogue: 0,0:04:58.99,0:05:02.11,Main,Grid,0,0,0,,أظنّني بالغتُ في المعايير على الأرجح
Dialogue: 0,0:05:05.33,0:05:07.16,Main,Grid,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:05:07.54,0:05:10.62,Main,Grid,0,0,0,,!أستوعب طريقة صنع هذا الغرض
Dialogue: 0,0:05:11.17,0:05:13.63,Main,Grid,0,0,0,,!كأنّني حدّادٌ حقيقيّ
Dialogue: 0,0:05:24.55,0:05:28.31,Main,Grid,0,0,0,,!قوّة تحمّله 1،090، وقوّة هجومه 1،820
Dialogue: 0,0:05:28.31,0:05:30.23,Main,Grid,0,0,0,,!وميزاته مذهلةٌ أيضًا
Dialogue: 0,0:05:30.52,0:05:33.23,Main,Grid,0,0,0,,ولا تنطبق عليَّ أيُّ قيودٍ على استخدام العتاد
Dialogue: 0,0:05:33.23,0:05:36.19,Main,Grid,0,0,0,,...كلّ ما ينقصني الآن هو الأوريكالكوم الأزرق
Dialogue: 0,0:05:36.40,0:05:37.48,Main,Grid,0,0,0,,!ليس لديّ
Dialogue: 0,0:05:39.11,0:05:41.82,Main,Toban,0,0,0,,أرفض انضمامكَ إلى الفريق
Dialogue: 0,0:05:41.82,0:05:45.49,Main,Toban,0,0,0,,بالنظر إلى عتادك، مستواكَ في حدود الستّين، أليس كذلك؟
Dialogue: 0,0:05:45.97,0:05:49.04,Main,Grid,0,0,0,,كلّا، بل أنا في المستوى 100 خلافًا لما أبدو عليه
Dialogue: 0,0:05:49.04,0:05:52.54,Main,Grid,0,0,0,,...واثقٌ من مهارتي، لذا لا ألقي بالًا للعتاد
Dialogue: 0,0:05:52.71,0:05:53.83,Main,Toban,0,0,0,,!ماذا؟
Dialogue: 0,0:05:53.83,0:05:56.13,Main,Toban,0,0,0,,أتقصد أنّنا نعتمد على عتادنا؟
Dialogue: 0,0:05:56.13,0:05:59.25,Main,Toban,0,0,0,,وأنّنا حثالةٌ عاجزون من دون قوّة العتاد؟
Dialogue: 0,0:05:59.46,0:06:02.22,Top,Toban,0,0,0,,!ثمَّ إنّك تكذب بشأن مستواكَ غالبًا
Dialogue: 0,0:06:02.22,0:06:03.88,Main,Grid,0,0,0,,!لم أقل كلّ هذا
Dialogue: 0,0:06:02.22,0:06:05.09,Top,Toban,0,0,0,,!وفوق ذلك، طباعك سيّئةٌ للغاية
Dialogue: 0,0:06:03.88,0:06:06.22,Main,Grid,0,0,0,,!وطباعكَ ليست بأفضل حالًا
Dialogue: 0,0:06:06.22,0:06:08.93,Main,Regas,0,0,0,,حسنٌ، لا بأس في ذلك يا توبان-سان
Dialogue: 0,0:06:08.93,0:06:09.68,Main,Toban,0,0,0,,...ريغاس-سان
Dialogue: 0,0:06:10.14,0:06:14.94,Main,Grid,0,0,0,,!أليس هذا ريغاس، المصنّف الأوّل بين فناني القتال وصاحب القبضة المقدّسة؟
Dialogue: 0,0:06:14.94,0:06:19.11,Main,Regas,0,0,0,,نقابتنا؛ تزيداكا من ستتولّى أمر الوحش الزعيم على أيّ حال
Dialogue: 0,0:06:19.44,0:06:21.32,Main,Regas,0,0,0,,فلنوكل إليه مهمّاتٍ أخرى
Dialogue: 0,0:06:21.32,0:06:23.61,Main,Grid,0,0,0,,!أصبتَ يا ريغاس، أخبره بالمزيد
Dialogue: 0,0:06:23.61,0:06:27.12,Main,Toban,0,0,0,,...لكنّي لستُ واثقًا من إقناع بقيّة الأعضاء
Dialogue: 0,0:06:27.12,0:06:31.62,Main,Regas,0,0,0,,إذن، هلّا اختبرناه لنرى حقيقة مهارته؟
Dialogue: 0,0:06:32.41,0:06:34.08,Main,Grid,0,0,0,,!هذا سيّئ
Dialogue: 0,0:06:35.04,0:06:37.13,Main,Regas,0,0,0,,!هيّا، تقدّم من أيّ جهةٍ شئت
Dialogue: 0,0:06:37.13,0:06:39.96,Main,Grid,0,0,0,,!بل أظنّني سأقضي اليوم في رفع مستواي
Dialogue: 0,0:06:43.22,0:06:44.93,Main,Regas,0,0,0,,...يا للأسف
Dialogue: 0,0:06:44.93,0:06:46.14,Main,Grid,0,0,0,,!أيمزح معي؟
Dialogue: 0,0:06:46.14,0:06:49.05,Main,Grid,0,0,0,,!كيف لي أن أبارز لاعبًا شهيرًا كهذا؟
Dialogue: 0,0:06:50.06,0:06:51.10,Main,Grid,0,0,0,,!اخرس
Dialogue: 0,0:06:51.10,0:06:53.81,Main,Grid,0,0,0,,!مهما بلغت قوّة الغرض، فلا فائدة منه إن عجزتُ عن صنعه
Dialogue: 0,0:06:55.73,0:06:59.52,Main,Grid,0,0,0,,سحقًا، لم يبقَ أمامي سوى العمل الشاقّ خطوةً بخطوة
Dialogue: 0,0:07:00.27,0:07:03.69,Main,Smith,0,0,0,,تسأل عن طريقة صنع أغراضٍ تُباع بمبالغ طائلة؟
Dialogue: 0,0:07:03.69,0:07:05.53,Main,Grid,0,0,0,,أجل، أرجو أن تعلّمني
Dialogue: 0,0:07:08.12,0:07:09.28,Main,Smith,0,0,0,,!اغرب عن وجهي
Dialogue: 0,0:07:09.87,0:07:12.54,Main,Smith,0,0,0,,تودّ جني المال بالسبيل السهل
Dialogue: 0,0:07:12.54,0:07:14.58,Main,Smith,0,0,0,,!إيّاكَ والاستخفاف بمهنة الحدادة
Dialogue: 0,0:07:14.58,0:07:19.63,Main,Grid,0,0,0,,!أرجوك، فالأمر ليس بالطلب الصعب
Dialogue: 0,0:07:21.21,0:07:24.21,Main,Smith,0,0,0,,جميع المستخفّين بالعمل سواسية
Dialogue: 0,0:07:24.21,0:07:29.18,Main,Smith,0,0,0,,لم يُنجز أحدٌ منهم أيّ عملٍ حقيقيّ بيديه قطّ
Dialogue: 0,0:07:29.18,0:07:30.97,Main,Smith,0,0,0,,!اخرج من هنا فورًا
Dialogue: 0,0:07:36.19,0:07:38.81,Main,Grid,0,0,0,,!هل سأظلّ حبيس القرية هكذا؟
Dialogue: 0,0:07:41.06,0:07:43.03,Main,Smith,0,0,0,,ماذا؟ ما زلتَ هنا؟
Dialogue: 0,0:07:44.23,0:07:46.24,Main,Grid,0,0,0,,لا أملك أيّ مال
Dialogue: 0,0:07:49.41,0:07:51.78,Main,Smith,0,0,0,,لن أسمح بأن تموت جوعًا أمام ورشتي لأقع في ورطة
Dialogue: 0,0:07:52.03,0:07:54.41,Main,Smith,0,0,0,,اذهب واقطع لي بعض الخشب مبدئيًّا
Dialogue: 0,0:08:01.96,0:08:04.34,Main,Grid,0,0,0,,!مضت مدّة طويلة منذ خضتُ مهمّةً طبيعيّة
Dialogue: 0,0:08:04.34,0:08:07.30,Main,Grid,0,0,0,,!أوّلًا، عليَّ تقييم قوّة تحمّل هذا الفأس
Dialogue: 0,0:08:07.59,0:08:08.55,Main,Grid,0,0,0,,!تقييم
Dialogue: 0,0:08:10.22,0:08:12.05,Main,Grid,0,0,0,,نسبة استيعابي 100%؟
Dialogue: 0,0:08:12.43,0:08:14.52,Main,Grid,0,0,0,,أهذه ميزةٌ أخرى من مزايا الفئة؟
Dialogue: 0,0:08:16.10,0:08:17.64,Main,Grid,0,0,0,,عليَّ التصويب إلى هنا؟
Dialogue: 0,0:08:18.44,0:08:21.02,Main,Grid,0,0,0,,أهكذا تتجلّى الأمور حين يرتفع الاستيعاب؟
Dialogue: 0,0:08:26.19,0:08:29.32,Main,Grid,0,0,0,,!بهذه الوتيرة سأنهي الأمر في لمح البصر
Dialogue: 0,0:08:43.28,0:08:47.01,Main,Grid,0,0,0,,قوّة تحمّلي في المستوى 3 رديئةٌ للغاية
Dialogue: 0,0:08:47.01,0:08:50.55,Main,Grid,0,0,0,,لِمَ أمارس عملًا يدويًّا شاقًّا داخل لعبة أصلًا؟
Dialogue: 0,0:08:50.55,0:08:55.35,Main,Grid,0,0,0,,جسدي يئنّ من الألم، وإرهاقي يفوق الوصف
Dialogue: 0,0:09:00.14,0:09:03.11,Main,Grid,0,0,0,,...أكاد أخرّ صريعًا، ولكن
Dialogue: 0,0:09:11.61,0:09:14.20,Main,Grid,0,0,0,,ما هذا الشعور يا ترى؟
Dialogue: 0,0:09:14.78,0:09:19.25,Main,Grid,0,0,0,,تحريك الجسد بلا هوادة ليس بهذا السوء في واقع الأمر
Dialogue: 0,0:09:20.41,0:09:23.58,Main,Grid,0,0,0,,...إذن، سأتقن عملًا واحدًا
Dialogue: 0,0:09:24.50,0:09:26.30,Main,Grid,0,0,0,,!على الأقل
Dialogue: 0,0:09:29.59,0:09:30.80,Main,AI,0,0,0,,نظام الإرشاد
Dialogue: 0,0:09:31.22,0:09:33.51,Main,AI,0,0,0,,فتحتَ خاصيّةً جديدة
Dialogue: 0,0:09:34.05,0:09:37.35,Top,AI,0,0,0,,،كلّما ارتفعت خاصيّة العزم، قلّ شعوركَ بالإرهاق
Dialogue: 0,0:09:37.35,0:09:39.47,Top,AI,0,0,0,,كما يزداد الحدّ الأقصى للوزن المحمول
Dialogue: 0,0:09:37.60,0:09:39.89,Main,Grid,0,0,0,,أهي قدرةٌ حصريّةٌ بالفئة الأسطوريّة؟
Dialogue: 0,0:09:39.89,0:09:42.52,Main,Grid,0,0,0,,!أشعر بالقوّة تتدفّق في جسدي
Dialogue: 0,0:09:42.77,0:09:46.02,Main,Grid,0,0,0,,!حسنٌ، سأنهي هذا حتمًا
Dialogue: 0,0:09:54.43,0:09:56.70,Main,Smith,0,0,0,,!أ-ألف قطعة؟
Dialogue: 0,0:09:58.03,0:10:00.62,Main,Grid,0,0,0,,!هذا أمرٌ يسير
Dialogue: 0,0:10:00.62,0:10:04.12,Main,Grid,0,0,0,,!فأنا حدّادٌ خلافًا لما أبدو عليه
Dialogue: 0,0:10:05.58,0:10:06.88,Main,Smith,0,0,0,,!لا تضحكني
Dialogue: 0,0:10:07.54,0:10:12.47,Main,Smith,0,0,0,,لكن إن أنجزتَ عمل التعدين فربّما أصدّقك
Dialogue: 0,0:10:12.47,0:10:14.30,Main,Smith,0,0,0,,فهذا أساس عمل كلّ حدّاد
Dialogue: 0,0:10:15.22,0:10:16.35,Main,Grid,0,0,0,,!بكلّ سرور
Dialogue: 0,0:10:25.31,0:10:26.56,Main,Man,0,0,0,,من هذا الفتى؟
Dialogue: 0,0:10:26.56,0:10:29.02,Main,Man,0,0,0,,!تخرج كتل الخامات بين يديه بأحجامٍ هائلة
Dialogue: 0,0:10:29.02,0:10:31.53,Main,Man,0,0,0,,!كما أنّه يرتدي درعه
Dialogue: 0,0:10:35.07,0:10:37.49,Main,Grid,0,0,0,,،يكاد جسدي ينهار من الإعياء
Dialogue: 0,0:10:37.91,0:10:39.58,Main,Grid,0,0,0,,غير أنَّ ذهني في غاية الصفاء
Dialogue: 0,0:10:39.99,0:10:44.08,Main,Grid,0,0,0,,!حتّى خاصيّة رتيبة كالعزم ستكون سلاحي
Dialogue: 0,0:10:44.62,0:10:45.67,Main,AI,0,0,0,,نظام الإرشاد
Dialogue: 0,0:10:45.67,0:10:47.25,Main,AI,0,0,0,,ارتفع مستواك
Dialogue: 0,0:10:47.25,0:10:49.00,Main,AI,0,0,0,,مستواكَ الحاليّ 1
Dialogue: 0,0:10:49.25,0:10:51.88,Main,AI,0,0,0,,،أُزيلت عقوبات المستوى السلبيّ
Dialogue: 0,0:10:51.88,0:10:54.97,Main,AI,0,0,0,,وطُبِّقت مكافآت الخصائص الأساسيّة لخليفة باغما
Dialogue: 0,0:10:57.05,0:10:59.89,Main,Grid,0,0,0,,!بـ-بلغتُ المستوى 1 أخيرًا
Dialogue: 0,0:11:03.64,0:11:06.14,Main,AI,0,0,0,,بلغت مكانتكَ لدى سميث حدّها الأقصى
Dialogue: 0,0:11:07.48,0:11:10.52,Main,Smith,0,0,0,,!لم أخَلْكَ بارعًا إلى هذا الحدّ
Dialogue: 0,0:11:11.82,0:11:16.53,Main,Grid,0,0,0,,الأهم من هذا، علّمني طريقة صنع أغراضٍ يسعني بيعها لجني المال
Dialogue: 0,0:11:16.53,0:11:18.87,Main,Smith,0,0,0,,حسنٌ، أعددتُ كلّ شيء
Dialogue: 0,0:11:18.87,0:11:23.33,Main,Smith,0,0,0,,هذه سهام يافا مصنوعةٌ بمزج كميّةٍ يسيرة من اليافا بالفولاذ
Dialogue: 0,0:11:23.33,0:11:25.62,Main,Smith,0,0,0,,سأعلّمكَ طريقة صنعها فورًا
Dialogue: 0,0:11:26.33,0:11:27.96,Main,Smith,0,0,0,,ليست سهامًا عاديّة
Dialogue: 0,0:11:27.96,0:11:30.54,Main,Smith,0,0,0,,إذ تتميّز بتجاهل دفاع الخصم جزئيًّا
Dialogue: 0,0:11:30.54,0:11:34.76,Main,Smith,0,0,0,,وهي غرضٌ لا غنى عنه هنا لغارة حارس الغابة
Dialogue: 0,0:11:34.76,0:11:35.88,Main,Smith,0,0,0,,،وطريقة صنعه
Dialogue: 0,0:11:35.88,0:11:39.26,Main,Smith,0,0,0,,تقتضي صهر كميّةٍ يسيرة من اليافا وخلطها بالفولاذ ثمَّ تركه ليتصلّب
Dialogue: 0,0:11:39.85,0:11:44.52,Main,Smith,0,0,0,,،يحتوي خام اليافا على نسبة ضئيلة من الأكسجين، لذا يسهل تكريره
Dialogue: 0,0:11:44.52,0:11:47.23,Main,Smith,0,0,0,,وهو يتوافق تمامًا مع خام الحديد
Dialogue: 0,0:11:47.23,0:11:49.27,Main,Smith,0,0,0,,تعرف طريقة التكرير، أليس كذلك؟
Dialogue: 0,0:11:50.52,0:11:52.52,Main,Smith,0,0,0,,حسنٌ، جرّب الآن
Dialogue: 0,0:11:52.52,0:11:57.49,Main,Smith,0,0,0,,نسبة خام اليافا إلى فحم الكوك والحجر الجيريّ هي 12 إلى 2 إلى 4
Dialogue: 0,0:11:58.16,0:12:00.74,Main,Grid,0,0,0,,بحثتُ قليلًا قبل فتحي اللعبة
Dialogue: 0,0:12:01.20,0:12:03.70,Main,Grid,0,0,0,,لكنَّ المعرفة لا تعني بالضرورة القدرة على التنفيذ
Dialogue: 0,0:12:04.20,0:12:08.58,Main,Grid,0,0,0,,لهذا أفادتني مكافأة الفئة فائدةً جمّة
Dialogue: 0,0:12:09.37,0:12:13.30,Main,Grid,0,0,0,,...وبفضل ارتفاع خاصيّة براعة اليدين
Dialogue: 0,0:12:14.38,0:12:16.63,Main,Grid,0,0,0,,أنجزتُ كلّ خطوةٍ بلا أيّ خطأ
Dialogue: 0,0:12:18.01,0:12:19.01,Main,Grid,0,0,0,,...إذن
Dialogue: 0,0:12:23.51,0:12:24.64,Main,Smith,0,0,0,,ما الّذي تفعله؟
Dialogue: 0,0:12:24.64,0:12:27.02,Main,Smith,0,0,0,,!سيزيد ذلك من سهولة كسره
Dialogue: 0,0:12:27.02,0:12:28.64,Main,Grid,0,0,0,,لا تقلق
Dialogue: 0,0:12:28.64,0:12:31.27,Main,Grid,0,0,0,,سأطبّعه حراريًّا بعد هذا
Dialogue: 0,0:12:32.15,0:12:34.73,Main,Smith,0,0,0,,!هذا جهدٌ مفرطٌ لغرضٍ مستهلك
Dialogue: 0,0:12:34.73,0:12:36.65,Main,Smith,0,0,0,,ألم تكن راغبًا في جني المال؟
Dialogue: 0,0:12:43.24,0:12:46.95,Main,Grid,0,0,0,,صنع شيءٍ بجودةٍ أعلى كفيلٌ ببيعه بسعرٍ أغلى
Dialogue: 0,0:12:47.29,0:12:51.67,Main,Grid,0,0,0,,!لا أمتلك أيّ موهبة، وهذا سبيلي الوحيد للتطوّر
Dialogue: 0,0:12:58.17,0:12:59.30,Main,Grid,0,0,0,,!اكتمل
Dialogue: 0,0:13:02.68,0:13:03.93,Main,AI,0,0,0,,نظام الإرشاد
Dialogue: 0,0:13:03.93,0:13:06.22,Main,AI,0,0,0,,تفعيل مهارةٍ جديدة
Dialogue: 0,0:13:06.77,0:13:08.48,Main,Grid,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:13:13.23,0:13:16.02,Main,AI,0,0,0,,صُنع غرضٌ من الرتبة الملحميّة
Dialogue: 0,0:13:16.40,0:13:17.94,Main,Grid,0,0,0,,ملحميّة؟
Dialogue: 0,0:13:16.40,0:13:19.24,Top,AI,0,0,0,,ارتفعت جميع الخصائص بمقدار 4 نقاط
Dialogue: 0,0:13:17.94,0:13:20.86,Main,Smith,0,0,0,,!لم أرَ سهمًا بهذه الجودة من قبل
Dialogue: 0,0:13:19.24,0:13:21.24,Top,AI,0,0,0,,اكتسبتَ 300 نقطة خبرة
Dialogue: 0,0:13:21.24,0:13:22.82,Main,AI,0,0,0,,ارتفع مستواك
Dialogue: 0,0:13:22.82,0:13:24.83,Main,AI,0,0,0,,مستواكَ الحاليّ 3
Dialogue: 0,0:13:24.83,0:13:27.70,Top,Smith,0,0,0,,!كأنّكَ تجسيدٌ لباغما نفسه
Dialogue: 0,0:13:25.95,0:13:27.70,Main,Grid,0,0,0,,!فـ-فعلتُها
Dialogue: 0,0:13:28.33,0:13:30.58,Main,Grid,0,0,0,,حسنٌ، فأنا خليفته في النهاية
Dialogue: 0,0:13:31.37,0:13:32.79,Main,Grid,0,0,0,,...في هذه الحالة
Dialogue: 0,0:13:32.79,0:13:34.75,Main,Grid,0,0,0,,!ليتني صنعتُ سيفًا أو ما شابه
Dialogue: 0,0:13:35.00,0:13:38.46,Main,Grid,0,0,0,,!لا أصدّق أنّي حصلتُ على الرتبة الملحميّة رغم ضآلة الاحتمال
Dialogue: 0,0:13:38.80,0:13:40.34,Main,Smith,0,0,0,,ما خطب هذه الملامح على وجهك؟
Dialogue: 0,0:13:42.72,0:13:44.72,Main,Smith,0,0,0,,سترحل بهذه السرعة؟
Dialogue: 0,0:13:44.72,0:13:47.14,Main,Grid,0,0,0,,أجل، وشكرًا جزيلًا لكَ على كلّ شيء
Dialogue: 0,0:13:47.47,0:13:51.06,Main,Smith,0,0,0,,كنتُ أودّ حقًّا لو عشتَ معي
Dialogue: 0,0:13:51.06,0:13:53.48,Main,Grid,0,0,0,,كفاكَ حديثًا مقزّزًا رجاءً
Dialogue: 0,0:13:54.52,0:13:57.02,Main,Grid,0,0,0,,!ترقّبوا أيّها اللاعبون
Dialogue: 0,0:13:57.69,0:14:02.11,Main,Grid,0,0,0,,!سيبيعكم غريد-ساما سهامًا لم تروا مثلها قطّ
Dialogue: 0,0:14:14.96,0:14:17.71,Main,Jishuka,0,0,0,,!لننهِ الأمر سريعًا يا ريغاس
Dialogue: 0,0:14:20.17,0:14:21.13,Main,Jishuka,0,0,0,,!توبان
Dialogue: 0,0:14:22.13,0:14:23.26,Main,Jishuka,0,0,0,,!فانتنر
Dialogue: 0,0:14:26.55,0:14:27.80,Main,Jishuka,0,0,0,,...هذه
Dialogue: 0,0:14:28.72,0:14:30.31,Main,Jishuka,0,0,0,,!قوّة نقابة تزيداكا
Dialogue: 0,0:14:33.94,0:14:37.44,Main,Jishuka,0,0,0,,...حصلنا على الأوريكالكوم الأزرق بطريقةٍ ما، ولكن
Dialogue: 0,0:14:37.44,0:14:38.69,Main,Man,0,0,0,,شكرًا لكِ
Dialogue: 0,0:14:39.90,0:14:41.40,Main,Jishuka,0,0,0,,أرِني سهام اليافا الّتي لديك
Dialogue: 0,0:14:41.40,0:14:42.53,Main,Man,0,0,0,,تفضّلي
Dialogue: 0,0:14:42.53,0:14:44.70,Main,Vantner,0,0,0,,النتائج ليست مشجّعةً
Dialogue: 0,0:14:44.70,0:14:49.24,Main,Toban,0,0,0,,أجل، فتطوير عتادنا ضروريّ لتقليص الضرر الّذي نتلقّاه
Dialogue: 0,0:14:49.24,0:14:53.12,Main,Jishuka,0,0,0,,...أجل، ولكن لا خيار أمامنا حاليًّا سوى التدبّر بالمنتجات الجاهزة
Dialogue: 0,0:14:53.12,0:14:54.71,Main,Man,0,0,0,,هاكِ، هذا كلّ ما لديّ حاليًّا
Dialogue: 0,0:14:55.96,0:14:57.08,Main,Vantner,0,0,0,,جيشوكا-سان؟
Dialogue: 0,0:14:57.08,0:14:57.79,Main,Jishuka,0,0,0,,!انظر
Dialogue: 0,0:14:58.50,0:15:00.05,Main,Vantner,0,0,0,,!مـ-ملحميّ؟
Dialogue: 0,0:15:01.25,0:15:05.76,Main,Jishuka,0,0,0,,...طلبتُ صنع السهام من شتّى الحدّادين حتّى الآن، ولكن
Dialogue: 0,0:15:06.18,0:15:11.68,Main,Jishuka,0,0,0,,...حتّى بانمير أشهر الحدّادين عجز عن صنع سهمٍ ملحميّ
Dialogue: 0,0:15:13.08,0:15:15.06,Main,Vantner,0,0,0,,من باعكَ هذا السهم؟
Dialogue: 0,0:15:15.06,0:15:20.11,Main,Man,0,0,0,,لم يذكر اسمه، لذا لا علم لي بهويّته
Dialogue: 0,0:15:21.11,0:15:22.98,Main,Vantner,0,0,0,,!شخصيّة غير قابلة للعب عديمة الفائدة
Dialogue: 0,0:15:22.98,0:15:23.90,Main,Jishuka,0,0,0,,ابحثوا عنه
Dialogue: 0,0:15:24.99,0:15:27.36,Main,Jishuka,0,0,0,,تواصلوا مع جميع أفراد النقابة
Dialogue: 0,0:15:27.74,0:15:30.70,Main,Jishuka,0,0,0,,!اعثروا على صانعه مهما كلّف الأمر
Dialogue: 0,0:15:36.37,0:15:37.54,Main,Takumi,0,0,0,,عدتُ
Dialogue: 0,0:15:39.63,0:15:42.34,Main,Seira,0,0,0,,أخي، هل أنتَ بخير؟
Dialogue: 0,0:15:42.34,0:15:44.80,Main,Takumi,0,0,0,,بـ-بخيرٍ بطبيعة الحال
Dialogue: 0,0:15:45.34,0:15:50.18,Main,Takumi,0,0,0,,لكنّي أجهدتُ نفسي قليلًا فحسب
Dialogue: 0,0:15:50.18,0:15:51.85,Main,Dad,0,0,0,,...تاكومي
Dialogue: 0,0:15:51.99,0:15:54.85,Main,Dad,0,0,0,,خُذ إجازةً من العمل غدًا
Dialogue: 0,0:15:55.64,0:15:56.56,Main,Dad,0,0,0,,خُذ
Dialogue: 0,0:15:59.06,0:16:00.02,Main,Takumi,0,0,0,,...أبي
Dialogue: 0,0:16:00.69,0:16:02.52,Main,Mom,0,0,0,,لا تُجهد نفسك
Dialogue: 0,0:16:02.52,0:16:04.53,Main,Mom,0,0,0,,واحرص على تناول طعامك
Dialogue: 0,0:16:04.53,0:16:05.90,Main,Takumi,0,0,0,,!حتّى أنتِ يا أمّي
Dialogue: 0,0:16:06.86,0:16:09.49,Main,Seira,0,0,0,,كانا ينتظرانكَ لتتناول الطعام معهما
Dialogue: 0,0:16:09.49,0:16:11.12,Main,Mom,0,0,0,,!حسبك
Dialogue: 0,0:16:11.53,0:16:14.54,Main,Mom,0,0,0,,حتّى جدّكَ في الريف قلقٌ عليكَ أيضًا
Dialogue: 0,0:16:15.16,0:16:17.00,Main,Mom,0,0,0,,حسنٌ، فلنتناول العشاء
Dialogue: 0,0:16:17.56,0:16:18.72,Main,Dad,0,0,0,,اليوم كاري؟
Dialogue: 0,0:16:19.15,0:16:21.58,Top,Seira,0,0,0,,أهذا الكراث المخلّل الّذي أرسله لنا جدّي، أليس كذلك؟
Dialogue: 0,0:16:21.08,0:16:25.26,Main,Takumi,0,0,0,,أنا عاجزٌ حقًّا عن إيفاء عائلتي حقّها من الشكر
Dialogue: 0,0:16:21.58,0:16:24.92,Top,Mom,0,0,0,,أجل، إنّه لذيذ
Dialogue: 0,0:16:26.09,0:16:29.26,Main,Takumi,0,0,0,,...واحد، اثنان، ثلاثة، أربعة، خمسة، ستّة، سبعة
Dialogue: 0,0:16:32.80,0:16:33.56,Main,Takumi,0,0,0,,...أبي
Dialogue: 0,0:16:34.47,0:16:36.89,Main,Takumi,0,0,0,,الأجر المعتاد للعمل اليوميّ هو 9,000 ين تقريبًا
Dialogue: 0,0:16:36.99,0:16:39.35,Main,Takumi,0,0,0,,هلّا سدّدتَ ديوني كلّها إن أمكن؟
Dialogue: 0,0:16:45.32,0:16:48.14,Main,Grid,0,0,0,,!عُرضت السهام في المزاد بستّ قطع فضّيّة
Dialogue: 0,0:16:48.16,0:16:50.28,Main,Grid,0,0,0,,!لا أصدّق أنّها بيعت بـ 92 قطعة فضّيّة
Dialogue: 0,0:16:50.53,0:16:52.77,Main,Grid,0,0,0,,،مئة قطعة فضّيّة تعادل قطعة ذهبيّة واحدة
Dialogue: 0,0:16:52.81,0:16:55.87,Main,Grid,0,0,0,,!ما يعني أنّي جنيتُ أكثر من 10,000 ين في العالم الواقعيّ
Dialogue: 0,0:16:55.87,0:16:58.75,Main,Grid,0,0,0,,!هذا أجدى بكثير من العمل اليوميّ الشاقّ
Dialogue: 0,0:17:01.08,0:17:05.30,Main,Grid,0,0,0,,!ترقّبوا، سأجني ثروةً طائلةً بهذه الوتيرة
Dialogue: 0,0:17:05.30,0:17:08.38,Main,Grid,0,0,0,,!أيّها العمّ، أسرع بالعربة أكثر
Dialogue: 0,0:17:08.47,0:17:10.13,Main,Man,0,0,0,,!صوتكَ يزعجني منذ أن ركبتَ
Dialogue: 0,0:17:10.13,0:17:11.55,Main,Man,0,0,0,,!الصمت فحسب
Dialogue: 0,0:17:12.59,0:17:14.43,Main,Man,0,0,0,,!يا لكَ من فتًى مُزعج
Dialogue: 0,0:17:20.77,0:17:22.94,Main,Grid,0,0,0,,هذه هي قرية وينستون إذن
Dialogue: 0,0:17:23.19,0:17:25.94,Main,Grid,0,0,0,,...وهي تحت سيادة الكونت شتايم
Dialogue: 0,0:17:26.78,0:17:28.15,Main,Grid,0,0,0,,أين سمعتُ بهذا الاسم من قبل؟
