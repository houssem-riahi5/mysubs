Dialogue: 0,0:12:34.69,0:12:37.31,Main,Grid,0,0,0,,!دعكِ من هذا وساعديني أيّتها القزمة
Dialogue: 0,0:12:38.58,0:12:40.41,Main,Euphemina,0,0,0,,ألم أحذّركَ للتوّ؟
Dialogue: 0,0:12:40.72,0:12:43.32,Main,Euphemina,0,0,0,,!قلتُ لكَ لا تنادِني بالقزمة
Dialogue: 0,0:12:43.32,0:12:45.32,Main,Euphemina,0,0,0,,!رمح الإبادة
