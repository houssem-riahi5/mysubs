Dialogue: 0,0:15:52.88,0:15:56.17,Main,Huroi,0,0,0,,!أقسم على ذلك باسم رفيق رسول العدالة
Dialogue: 0,0:15:57.88,0:15:59.45,Main,Grid,0,0,0,,!حسنٌ
Dialogue: 0,0:16:04.57,0:16:07.87,Main,Hinako,0,0,0,,!لا أصدّق أنّهما أنجزاها
Dialogue: 0,0:16:08.64,0:16:12.15,Main,Sakaeda,0,0,0,,لم يبقَ الآن سوى كيفيّة إفلاتهم من هذا المأزق
Dialogue: 0,0:16:17.17,0:16:19.41,Main,Euphemina,0,0,0,,لم يبقَ لديَّ سوى مهارةٍ واحدة
Dialogue: 0,0:16:19.69,0:16:21.66,Main,Euphemina,0,0,0,,لكنَّ قوّتها التدميريّة مفرطة
Dialogue: 0,0:16:23.16,0:16:25.38,Main,Guard,0,0,0,,!سأثأر لرفاقي
Dialogue: 0,0:16:27.29,0:16:28.55,Main,Grid,0,0,0,,المعذرة
Dialogue: 0,0:16:30.16,0:16:31.90,Main,Grid,0,0,0,,!تأخّرتُ أكثر ممّا توقّعت
Dialogue: 0,0:16:32.26,0:16:33.68,Main,Euphemina,0,0,0,,!غريد
Dialogue: 0,0:16:33.68,0:16:34.64,Main,Grid,0,0,0,,أجل
Dialogue: 0,0:16:34.64,0:16:36.22,Main,Grid,0,0,0,,يبدو أنّكِ بخيرٍ أنتِ الأخرى
Dialogue: 0,0:16:36.22,0:16:40.19,Main,Euphemina,0,0,0,,!كان يجدر بكَ الإسراع لنجدتي أيّها الأحمق الحثالة المغفّل
Dialogue: 0,0:16:40.19,0:16:42.18,Main,Grid,0,0,0,,لعلّه لم يكن يجدر بي المجيء
Dialogue: 0,0:16:45.00,0:16:46.06,Main,Grid,0,0,0,,!سحقًا
