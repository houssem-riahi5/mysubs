Dialogue: 0,0:13:55.03,0:13:57.47,Main,System,0,0,0,,تفعيل مهارة غضب الحدّاد
Dialogue: 0,0:13:57.47,0:13:59.02,Main,Grid,0,0,0,,!خفّة الحركة الفائقة
Dialogue: 0,0:14:07.61,0:14:08.57,Main,Grid,0,0,0,,!عاصفة النصل
