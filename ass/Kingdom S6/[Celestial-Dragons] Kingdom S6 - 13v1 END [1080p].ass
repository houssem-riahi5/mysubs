Dialogue: 10,0:00:01.44,0:00:02.40,Main,,0,0,0,,!سيّدي الشاب
Dialogue: 10,0:00:02.72,0:00:04.07,Main,,0,0,0,,ما الّذي تفعله؟
Dialogue: 10,0:00:05.25,0:00:07.00,Main,,0,0,0,,أتدرك وضعنا؟
Dialogue: 10,0:00:07.22,0:00:09.14,Main,,0,0,0,,!اهرب أنتَ على الأقل
Dialogue: 10,0:00:09.35,0:00:12.75,Main,,0,0,0,,!إن استمرّ هذا، فستفنى وحدة غيوكوهو
Dialogue: 10,0:00:13.41,0:00:16.55,Main,,0,0,0,,هجومٌ كاسحٌ مثاليٌّ عدّةً وعتادًا
Dialogue: 10,0:00:16.55,0:00:20.40,Main,,0,0,0,,لا بُدَّ أنّك تدرك ذلك بحدسك الثاقب يا أوهون
Dialogue: 10,0:00:20.40,0:00:23.17,Main,,0,0,0,,لا سبيل لكم للنجاة مطلقًا
Dialogue: 10,0:00:23.60,0:00:26.34,Main,,0,0,0,,ولا حتّى سبيلٌ واحدٌ بلا شكٍّ
Dialogue: 10,0:00:27.46,0:00:29.51,Main,,0,0,0,,ما الخطب يا هون-ساما؟
Dialogue: 10,0:00:29.51,0:00:30.83,Main,,0,0,0,,!هون-ساما
Dialogue: 10,0:00:32.64,0:00:36.40,Main,,0,0,0,,ألا يراودك شعورٌ أحيانًا بأنّ "لحظتي قد حانت" مؤخرًا؟
Dialogue: 10,0:00:37.43,0:00:38.53,Main,,0,0,0,,ما الّذي تعنيه؟
Dialogue: 10,0:00:38.96,0:00:42.29,Main,,0,0,0,,أعني، يحدث ذلك أحيانًا، أليس كذلك؟
Dialogue: 10,0:00:42.29,0:00:45.77,Main,,0,0,0,,حين يتصادف أن ترى شيئًا مذهلًا
Dialogue: 10,0:00:45.77,0:00:47.32,Main,,0,0,0,,قلتُ لكَ، ما هو؟
Dialogue: 10,0:00:48.11,0:00:49.36,Main,,0,0,0,,...إنّه
Dialogue: 10,0:00:49.95,0:00:53.46,Main,,0,0,0,,"ما يُسمّى بـ "منظور الجنرال العظيم
Dialogue: 10,0:00:57.54,0:01:00.40,Main,,0,0,0,,يا كانجو، استدعِ بانيو
Dialogue: 10,0:01:00.40,0:01:01.57,Main,,0,0,0,,سنقلب الموازين
Dialogue: 10,0:01:01.57,0:01:03.38,Main,,0,0,0,,نـ-نقلب الموازين؟
Dialogue: 10,0:01:04.05,0:01:05.13,Main,,0,0,0,,ما الّذي تقوله؟
Dialogue: 10,0:01:05.24,0:01:07.27,Main,,0,0,0,,عليكَ الهروب وحدكَ على الأقل
Dialogue: 10,0:01:07.67,0:01:08.67,Main,,0,0,0,,!هون-ساما
Dialogue: 10,0:01:08.94,0:01:10.18,Main,,0,0,0,,هل أنتَ بخير؟
Dialogue: 10,0:01:10.39,0:01:11.62,Main,,0,0,0,,نائب القائد بانيو
Dialogue: 10,0:01:13.23,0:01:14.94,Main,,0,0,0,,أأنتَ بخير رغم جراحكَ تلك؟
Dialogue: 10,0:01:15.44,0:01:16.56,Main,,0,0,0,,أنا بخير
Dialogue: 10,0:01:16.96,0:01:19.94,Main,,0,0,0,,الأهم من ذلك، ما خطب هون-ساما؟
Dialogue: 10,0:01:20.35,0:01:23.52,Main,,0,0,0,,لا أدري، إنّه على هذا الحال منذ فترة
Dialogue: 10,0:01:23.52,0:01:24.57,Main,,0,0,0,,ماذا؟
Dialogue: 10,0:01:26.39,0:01:29.49,Main,,0,0,0,,!لا يهم، استدعِ بانيو بسرعة يا كانجو
Dialogue: 10,0:01:30.58,0:01:33.88,Main,,0,0,0,,...هون-ساما، أنا هنا بالفعل
Dialogue: 10,0:01:33.88,0:01:35.80,Main,,0,0,0,,سنقسّم الوحدة فورًا
Dialogue: 10,0:01:35.80,0:01:37.33,Main,,0,0,0,,!استعدوا
Dialogue: 10,0:03:15.72,0:03:18.18,Top,,0,0,0,,تحرّكت وحدة غيوكوهو نحو أقصى اليمين
Dialogue: 10,0:03:18.53,0:03:22.32,Main,,0,0,0,,بدؤوا بالهروب في الاتجاه الخالي من قوّاتنا وجيش غاكوي
Dialogue: 10,0:03:23.48,0:03:27.19,Main,,0,0,0,,هذا أحد الخيارين اللذين توقّعناهما
Dialogue: 10,0:03:27.49,0:03:34.00,Main,,0,0,0,,لم يختاروا اختراق صفوفنا واللجوء إلى تعزيزات جيش أكو إذن
Dialogue: 10,0:03:34.00,0:03:36.95,Main,,0,0,0,,ليس أوهون أحمقًا ليفعل ذلك
Dialogue: 10,0:03:37.27,0:03:40.74,Main,,0,0,0,,على أيّة حال، لا سبيل لنجاتهم
Dialogue: 10,0:03:41.57,0:03:43.21,Main,,0,0,0,,...إن هربوا
Dialogue: 10,0:03:43.44,0:03:46.84,Main,,0,0,0,,فستخترق رماح جوشو وجورين ظهورهم
Dialogue: 10,0:03:49.69,0:03:51.52,Main,,0,0,0,,!مـ-ما هذان الفارسان
Dialogue: 10,0:03:52.69,0:03:55.44,Main,,0,0,0,,إن كان لديكم وقتٌ للالتفات، فاركضوا أسرع ولو بخطوة
Dialogue: 10,0:03:55.44,0:03:57.35,Main,,0,0,0,,سنخرج مهما كلّف الأمر
Dialogue: 10,0:03:57.37,0:03:58.26,Main,,0,0,0,,!أمرك
Dialogue: 10,0:03:59.60,0:04:03.05,Main,,0,0,0,,تأكّدوا من وجود أوهون بينهم
Dialogue: 10,0:04:03.05,0:04:03.78,Main,,0,0,0,,!أمرك
Dialogue: 10,0:04:05.96,0:04:06.61,Main,,0,0,0,,!انطلقوا
Dialogue: 10,0:04:06.61,0:04:09.26,Main,,0,0,0,,!تقرير عاجل، أوهون يتّجه لليسار
Dialogue: 10,0:04:09.26,0:04:12.07,Main,,0,0,0,,!يقود أوهون فرقةً صغيرةً على اليسار
Dialogue: 10,0:04:12.50,0:04:14.44,Main,,0,0,0,,عكس اتجاه الوحدة الرئيسية
Dialogue: 10,0:04:14.44,0:04:18.74,Main,,0,0,0,,يحاول الهروب يسارًا عبر الثغرة بين جيشنا وجيش غاكوي
Dialogue: 10,0:04:19.47,0:04:21.20,Main,,0,0,0,,!إنّهم يسحقوننا
Dialogue: 10,0:04:21.20,0:04:23.92,Main,,0,0,0,,عددنا قليلٌ للغاية مهما نظرنا للأمر
Dialogue: 10,0:04:23.92,0:04:27.88,Main,,0,0,0,,لا تبالوا بالسرعة، ليعبر أكبر عددٍ ممكن من الخيّالة
Dialogue: 10,0:04:28.26,0:04:32.09,Main,,0,0,0,,أيستخدم نفسه طُعمًا لإنقاذ الوحدة الرئيسيّة؟
Dialogue: 10,0:04:32.54,0:04:36.84,Main,,0,0,0,,كلّا، هدفهم الوحيد هو تهريب أوهون
Dialogue: 10,0:04:37.21,0:04:40.81,Main,,0,0,0,,ينوون اللجوء إلى التعزيزات فور اختراق الحصار
Dialogue: 10,0:04:41.31,0:04:44.94,Main,,0,0,0,,!شكّلوا جدارًا لمنعهم من الالتفاف يسارًا، بسرعة
Dialogue: 10,0:04:45.04,0:04:46.01,Main,,0,0,0,,!أمرك
Dialogue: 10,0:04:47.74,0:04:48.99,Main,,0,0,0,,!اجتزناهم
Dialogue: 10,0:04:51.20,0:04:51.90,Main,,0,0,0,,!إنّهم سريعون
Dialogue: 10,0:04:52.74,0:04:55.15,Main,,0,0,0,,!لن نتمكّن من تشكيل الجدار في الوقت المناسب يا تشوغاريو-ساما
Dialogue: 10,0:04:55.43,0:05:00.09,Main,,0,0,0,,لا بأس، سنضربهم من الجانب لحظة استدارتهم نحونا
Dialogue: 10,0:05:00.09,0:05:01.66,Main,,0,0,0,,فعددهم لا يتجاوز الست مئة
Dialogue: 10,0:05:12.84,0:05:13.77,Main,,0,0,0,,ماذا؟
Dialogue: 10,0:05:13.84,0:05:16.22,Main,,0,0,0,,!إنّهم يكملون طريقهم بخطٍّ مستقيم
Dialogue: 10,0:05:16.24,0:05:18.19,Main,,0,0,0,,...أيّها الجنرال، هذا
Dialogue: 10,0:05:18.50,0:05:21.72,Main,,0,0,0,,مستحيل، هل جُننتَ يا أوهون؟
Dialogue: 10,0:05:21.72,0:05:26.73,Main,,0,0,0,,الذهاب في ذلك الاتجاه يعني العزلة والوقوع في الفخّ
Dialogue: 10,0:05:26.73,0:05:28.95,Main,,0,0,0,,خيّالتهم يطاردوننا بإصرار
Dialogue: 10,0:05:28.95,0:05:31.19,Main,,0,0,0,,تجاهلوهم، سنسبقهم بخيولنا
Dialogue: 10,0:05:31.19,0:05:32.52,Main,,0,0,0,,!إنّها غارة
Dialogue: 10,0:05:32.52,0:05:33.44,Main,,0,0,0,,!اقتلوهم
Dialogue: 10,0:05:34.09,0:05:36.36,Main,,0,0,0,,بدأت قواتهم المتمركزة في الوسط بالتجمع
Dialogue: 10,0:05:36.36,0:05:40.12,Main,,0,0,0,,بالطبع، فنحن في قلب أراضي العدوّ
Dialogue: 10,0:05:40.40,0:05:41.33,Main,,0,0,0,,!إلى اليسار
Dialogue: 10,0:05:42.33,0:05:44.08,Main,,0,0,0,,!انعطفوا يسارًا
Dialogue: 10,0:05:44.08,0:05:46.83,Main,,0,0,0,,!انعطفوا يسارًا، إلى اليسار
Dialogue: 10,0:05:47.33,0:05:53.84,Main,,0,0,0,,لم أتوقع أنّنا سنعبر أراضي العدوّ إلى منطقةٍ آمنة، لكنَّ الأمر انقلب علينا تمامًا
Dialogue: 10,0:05:53.84,0:05:56.17,Main,,0,0,0,,لم يعد لدينا مهربٌ الآن
Dialogue: 10,0:05:56.17,0:05:59.92,Main,,0,0,0,,لا حاجة لنا بمهرب، فنحن في وضع الهجوم
Dialogue: 10,0:06:00.73,0:06:01.93,Main,,0,0,0,,!سهام
Dialogue: 10,0:06:01.93,0:06:03.14,Main,,0,0,0,,!سهامٌ قادمة
Dialogue: 10,0:06:07.20,0:06:07.85,Main,,0,0,0,,!سيّدي الشاب
Dialogue: 10,0:06:08.49,0:06:11.18,Main,,0,0,0,,إلى أين نتّجه بحقّ السماء؟
Dialogue: 10,0:06:11.94,0:06:14.11,Main,,0,0,0,,إلى نقطة ضعف تشكيلتهم
Dialogue: 10,0:06:14.81,0:06:17.28,Main,,0,0,0,,نقطة ضعف تشكيلتهم؟
Dialogue: 10,0:06:19.08,0:06:20.80,Narrator,,0,0,0,,...ما استهدفه أوهون
Dialogue: 10,0:06:21.23,0:06:24.02,Narrator,,0,0,0,,،يقع في الجهة المقابلة لموقعهم الأوليّ
Dialogue: 10,0:06:24.11,0:06:26.38,Narrator,,0,0,0,,نقطة ضعف تشكيلة جيش بانانجي
Dialogue: 10,0:06:27.34,0:06:29.37,Narrator,,0,0,0,,في أقصى اليسار
Dialogue: 10,0:06:36.82,0:06:41.36,Main,,0,0,0,,مستحيل، أكان يستهدف تلك النقطة البعيدة؟
Dialogue: 10,0:06:41.48,0:06:46.24,Main,,0,0,0,,حتّى لو كانت نقطة ضعف، كيف سيخترقها بعدد قليل من الجنود؟
Dialogue: 10,0:06:46.32,0:06:50.14,Main,,0,0,0,,كلّا، لا ينوي أوهون اسقاطها بمفرده
Dialogue: 10,0:06:51.11,0:06:55.58,Main,,0,0,0,,إن كان أكو بارعًا، فسيستجيب لتحرّكات أوهون
Dialogue: 10,0:06:56.53,0:07:01.32,Main,,0,0,0,,لتترك الوحدات اليسرى مواقعها وتشنّ هجومًا كاسحًا مع السيّد الشاب
Dialogue: 10,0:07:01.32,0:07:03.91,Main,,0,0,0,,!التهموا جيش بانانجي من اليسار
Dialogue: 10,0:07:04.49,0:07:07.83,Main,,0,0,0,,!سأعيق الجيش الرئيسيّ هنا، انطلقوا
Dialogue: 10,0:07:08.87,0:07:09.61,Main,,0,0,0,,!تبًا
Dialogue: 10,0:07:10.47,0:07:14.59,Main,,0,0,0,,سحقًا له، نسف استراتيجيّتنا الّتي أعددناها
Dialogue: 10,0:07:15.09,0:07:16.16,Main,,0,0,0,,...مع ذلك
Dialogue: 10,0:07:16.16,0:07:18.59,Main,,0,0,0,,!استجاب أكو، لنتحرّك
Dialogue: 10,0:07:19.04,0:07:24.87,Main,,0,0,0,,إن نجح الأمر، فقد نوجّه لجيش بانانجي ضربةً لا يمكنه التعافي منها في يومنا الثاني
Dialogue: 10,0:07:27.50,0:07:30.25,Main,,0,0,0,,الردّ على الهجوم الكاسح بهجومٍ كاسح
Dialogue: 10,0:07:30.76,0:07:37.36,Main,,0,0,0,,لا يُصدّق، أرسم هذه الخطّة وهو في ذلك المأزق اليائس؟
Dialogue: 10,0:07:38.75,0:07:39.74,Main,,0,0,0,,...أوهون
Dialogue: 10,0:07:40.27,0:07:42.95,Main,,0,0,0,,الجنرالات العظام كالستة العظام
Dialogue: 10,0:07:42.95,0:07:44.07,Main,,0,0,0,,!أوقفوهم
Dialogue: 10,0:07:44.07,0:07:44.87,Main,,0,0,0,,!اقتلواهم
Dialogue: 10,0:07:45.14,0:07:47.83,Main,,0,0,0,,...مهما كان وضع المعركة
Dialogue: 10,0:07:49.85,0:07:50.91,Main,,0,0,0,,!عشّ التنين
Dialogue: 10,0:07:50.92,0:07:52.96,Main,,0,0,0,,فهم يعتبرون أنفسهم الأبطال
Dialogue: 10,0:07:53.27,0:07:55.48,Main,,0,0,0,,ويفترضون أنّهم في قلب المعركة
Dialogue: 10,0:07:56.01,0:07:58.46,Main,,0,0,0,,جاعلين بقيّة العالم يدور حولهم
Dialogue: 10,0:07:58.61,0:08:01.72,Main,,0,0,0,,أظنّهم كانوا يرون مشهدًا أنانيًّا خاصًا بهم
Dialogue: 10,0:08:05.37,0:08:06.25,Main,,0,0,0,,لماذا؟
Dialogue: 10,0:08:06.70,0:08:07.57,Main,,0,0,0,,لِمَ الآن؟
Dialogue: 10,0:08:07.93,0:08:11.59,Main,,0,0,0,,إنّني أتذكّر ذلك الشخص
Dialogue: 10,0:08:12.00,0:08:13.31,Main,,0,0,0,,أأنتَ واثق؟
Dialogue: 10,0:08:14.16,0:08:16.94,Main,,0,0,0,,هذا يعاكس تمامًا الخطّة الّتي وضعناها البارحة
Dialogue: 10,0:08:17.60,0:08:20.14,Main,,0,0,0,,سيسبّب هذا متاعب للجيوش الأخرى
Dialogue: 10,0:08:21.03,0:08:24.74,Main,,0,0,0,,لا حيلة لي، فقد خطرت لي فكرةٌ جيّدةٌ للتوّ
Dialogue: 10,0:08:25.38,0:08:28.50,Main,,0,0,0,,التلاعب بالعدوّ والصديق كالدُّمى لتحقيق النصر
Dialogue: 10,0:08:28.50,0:08:31.02,Main,,0,0,0,,هذا هو جوهر الجنرال العظيم
Dialogue: 10,0:08:31.75,0:08:34.75,Main,,0,0,0,,لنفترض أنَّ رينبا من قال ذلك
Dialogue: 10,0:08:36.96,0:08:39.50,Main,,0,0,0,,أنتَ رجلٌ مثيرٌ للمتاعب يا سيّدي
Dialogue: 10,0:08:39.70,0:08:42.51,Main,,0,0,0,,لا أبالي، فهذا لن يضعني في مشكلة
Dialogue: 10,0:08:43.50,0:08:48.10,Main,,0,0,0,,سيّدي، وصل رسولٌ غاضبٌ من كايشيبو المجاور
Dialogue: 10,0:08:48.20,0:08:51.26,Main,,0,0,0,,لا أبالي، اطرده
Dialogue: 10,0:08:55.05,0:08:56.06,Main,,0,0,0,,أوهون
Dialogue: 10,0:08:56.73,0:08:57.98,Main,,0,0,0,,...أنتَ
Dialogue: 10,0:08:58.58,0:09:00.90,Main,,0,0,0,,!هذه ساحة صيدنا، اسحقوهم
Dialogue: 10,0:09:07.62,0:09:11.62,Main,,0,0,0,,!من الأطراف، شقّوا طريقكم واقتلوهم جميعًا
Dialogue: 10,0:09:11.62,0:09:13.22,Main,,0,0,0,,!إنّه أكاكين
Dialogue: 10,0:09:13.22,0:09:16.62,Main,,0,0,0,,!قنبلة جيش أكو موقوتة، سيكون عونًا حقيقيًّا
Dialogue: 10,0:09:16.62,0:09:19.13,Main,,0,0,0,,أكره ذلك الرجل
Dialogue: 10,0:09:19.43,0:09:21.41,Main,,0,0,0,,...بانانجي-ساما، الجيش الخلفي
Dialogue: 10,0:09:22.77,0:09:25.64,Main,,0,0,0,,هل نفكّ الاشتباك ونذهب للمساعدة؟
Dialogue: 10,0:09:28.84,0:09:30.05,Main,,0,0,0,,!بانانجي-ساما
Dialogue: 10,0:09:30.05,0:09:32.32,Main,,0,0,0,,العدوّ يحتشد حولنا
Dialogue: 10,0:09:32.82,0:09:37.31,Main,,0,0,0,,غيّرتَ أسلوب قتالكَ لكي لا نتمكّن من مغادرة هذه المعمقة إذن
Dialogue: 10,0:09:37.38,0:09:38.81,Main,,0,0,0,,يا جنرال تشين
Dialogue: 10,0:09:38.81,0:09:42.07,Main,,0,0,0,,لا توقفوا الهجوم ولا تمنحوا العدوّ أيّ ثغرة
Dialogue: 10,0:09:42.07,0:09:43.69,Main,,0,0,0,,مثيرٌ للاهتمام
Dialogue: 10,0:09:43.69,0:09:47.32,Main,,0,0,0,,إذن، سأخذ رأسكَ دون تردّد
Dialogue: 10,0:09:47.32,0:09:50.57,Main,,0,0,0,,!يا رجال! شتّتوا العدوّ الأمامي
Dialogue: 10,0:09:54.20,0:09:56.01,Main,,0,0,0,,ما الأمر يا هون-ساما؟
Dialogue: 10,0:09:56.52,0:09:59.96,Main,,0,0,0,,كفّة المعركة تميل لصالحنا بوضوح
Dialogue: 10,0:10:00.42,0:10:03.56,Main,,0,0,0,,علينا مراقبة تحرّكات ذلك الرجل
Dialogue: 10,0:10:03.56,0:10:04.83,Main,,0,0,0,,ذلك الرجل؟
Dialogue: 10,0:10:05.31,0:10:06.13,Main,,0,0,0,,أجل
Dialogue: 10,0:10:06.49,0:10:10.57,Main,,0,0,0,,...القادر على إيقاف تيّار هذه المعركة
Dialogue: 10,0:10:10.57,0:10:12.64,Main,,0,0,0,,هو ذلك الجنرال الثالث
Dialogue: 10,0:10:15.32,0:10:18.08,Main,,0,0,0,,أيّها الجنرال، الوحدات تنتظر الأوامر
Dialogue: 10,0:10:18.08,0:10:22.03,Main,,0,0,0,,وصلت رسالةٌ من جيش غاكوي المجاور يسأل عن الهدف
Dialogue: 10,0:10:23.09,0:10:24.11,Main,,0,0,0,,!أيّها الجنرال
Dialogue: 10,0:10:24.11,0:10:25.00,Main,,0,0,0,,!أيّها الجنرال
Dialogue: 10,0:10:25.00,0:10:26.11,Main,,0,0,0,,التزموا الصمت
Dialogue: 10,0:10:33.08,0:10:35.80,Main,,0,0,0,,استغلّوا فارق القوّة واسحقوهم كلًّا على حدة
Dialogue: 10,0:10:36.51,0:10:39.70,Main,,0,0,0,,ليطارد جيش غاكوي وحدة غيوكوهو الرئيسيّة
Dialogue: 10,0:10:39.70,0:10:41.17,Main,,0,0,0,,!أمرك
Dialogue: 10,0:10:41.17,0:10:45.12,Main,,0,0,0,,سنضرب نحن تعزيزات جيش أكو الثمانية آلاف المقتربة
Dialogue: 10,0:10:45.12,0:10:46.10,Main,,0,0,0,,!أمرك
Dialogue: 10,0:10:46.10,0:10:47.20,Main,,0,0,0,,...ولكن
Dialogue: 10,0:10:49.10,0:10:52.86,Main,,0,0,0,,...أرسلوا ألف خيّالٍ من جيشنا كوحدةٍ منفصلة
Dialogue: 10,0:10:52.86,0:10:56.43,Main,,0,0,0,,ولتهاجم ساحة الصيد الّتي أنشأها أوهون
Dialogue: 10,0:10:56.43,0:11:00.44,Main,,0,0,0,,تلك هي الخطوة الّتي يكرهها أوهون أكثر من غيرها الآن
Dialogue: 10,0:11:00.77,0:11:01.96,Main,,0,0,0,,!أمرك
Dialogue: 10,0:11:04.80,0:11:05.65,Main,,0,0,0,,!هون-ساما
Dialogue: 10,0:11:05.65,0:11:08.60,Main,,0,0,0,,خيّالةٌ قادمون من ذلك الجيش الثالث
Dialogue: 10,0:11:08.60,0:11:11.07,Main,,0,0,0,,!عددهم يتراوح بين الـ500 والألف
Dialogue: 10,0:11:11.07,0:11:12.91,Main,,0,0,0,,!أ-ألف؟
Dialogue: 10,0:11:13.50,0:11:17.44,Main,,0,0,0,,...إن اقتحم ألف خيّالٍ ساحتنا من الجانب
Dialogue: 10,0:11:17.44,0:11:20.06,Main,,0,0,0,,فسنصبح نحن الطرف الّذي يُضرب
Dialogue: 10,0:11:21.04,0:11:24.62,Main,,0,0,0,,...علينا اعتراضهم قبل وصولهم إلى هنا، ولكن
Dialogue: 10,0:11:25.40,0:11:27.50,Main,,0,0,0,,...إن غادرنا هذا المكان
Dialogue: 10,0:11:27.50,0:11:30.31,Main,,0,0,0,,فسنفقد تشكيلة الهجوم الكاسح
Dialogue: 10,0:11:31.17,0:11:32.08,Main,,0,0,0,,ما العمل؟
Dialogue: 10,0:11:32.74,0:11:34.71,Main,,0,0,0,,هل أقسّم هؤلاء الـ700 أكثر؟
Dialogue: 10,0:11:34.93,0:11:35.94,Main,,0,0,0,,...مع ذلك
Dialogue: 10,0:11:38.61,0:11:39.75,Main,,0,0,0,,!أكاكين
Dialogue: 10,0:11:39.85,0:11:42.77,Main,,0,0,0,,ثلاثمئة... لا، مئتان فحسب
Dialogue: 10,0:11:43.02,0:11:45.00,Main,,0,0,0,,أينوي إيقاف ألفٍ بذلك العدد؟
Dialogue: 10,0:11:47.49,0:11:51.20,Main,,0,0,0,,أيّها السيّد الشاب، يعود الفضل لكَ في ساحة الصيد هذه
Dialogue: 10,0:11:51.30,0:11:55.19,Main,,0,0,0,,سأتولّى أنا أكاكين أمر الخيّالة المتطفّلين
Dialogue: 10,0:11:55.31,0:11:58.26,Main,,0,0,0,,لذا ضخّم إنجازاتكَ كما يحلو لك
Dialogue: 10,0:11:58.26,0:12:02.30,Main,,0,0,0,,حينها سيبتسم والدكَ تحت قناعه ذاك
Dialogue: 10,0:12:04.23,0:12:06.45,Main,,0,0,0,,لا تنسَ هذا الدين
Dialogue: 10,0:12:06.45,0:12:10.88,Main,,0,0,0,,رُدّه لي أو لولدي عشرة أضعافٍ في عهدك
Dialogue: 10,0:12:10.88,0:12:11.81,Main,,0,0,0,,!وداعًا
Dialogue: 10,0:12:12.79,0:12:15.08,Main,,0,0,0,,أهذا هو الوغد ذائع الصيت؟
Dialogue: 10,0:12:15.08,0:12:16.64,Main,,0,0,0,,أكاكين
Dialogue: 10,0:12:16.98,0:12:18.14,Main,,0,0,0,,...لولا
Dialogue: 10,0:12:18.14,0:12:21.88,Main,,0,0,0,,...لولا شخصيّته تلك لما بقي قائد ألف رجل، ولكن
Dialogue: 10,0:12:21.95,0:12:26.11,Main,,0,0,0,,بصراحة، إنّه أكثر رجلٍ ضائعٍ حقه في جيش أكو
Dialogue: 10,0:12:26.61,0:12:30.01,Main,,0,0,0,,!كوهو، خذ ثلاثين خيّالًا والحق بأكاكين
Dialogue: 10,0:12:30.01,0:12:30.53,Main,,0,0,0,,!أمرك
Dialogue: 10,0:12:30.80,0:12:33.96,Main,,0,0,0,,!أخرجه من هناك قبل أن يُباد هو وجيشه
Dialogue: 10,0:12:33.96,0:12:34.78,Main,,0,0,0,,!أمرك
Dialogue: 10,0:12:47.48,0:12:48.89,Main,,0,0,0,,!أكو-ساما
Dialogue: 10,0:12:48.89,0:12:49.71,Main,,0,0,0,,...أجل
Dialogue: 10,0:12:49.71,0:12:52.05,Main,,0,0,0,,...يبدو أنّهم
Dialogue: 10,0:12:56.64,0:12:59.02,Main,,0,0,0,,عاجزون عن إيقاف هذا التيّار
Dialogue: 10,0:13:15.82,0:13:18.88,Narrator,,0,0,0,,نهاية اليوم الثاني في سهل شوكاي
Dialogue: 10,0:13:28.63,0:13:30.38,Main,,0,0,0,,إلى أين أنتَ ذاهب يا ريبوكو-ساما؟
Dialogue: 10,0:13:32.12,0:13:33.96,Main,,0,0,0,,إلى معسكر غيون
Dialogue: 10,0:13:33.96,0:13:35.26,Main,,0,0,0,,غيون؟
Dialogue: 10,0:13:38.43,0:13:40.70,Main,,0,0,0,,سـ-سأرافقك
Dialogue: 10,0:13:42.31,0:13:44.30,Main,,0,0,0,,!تبًّا
Dialogue: 10,0:13:44.30,0:13:46.06,Main,,0,0,0,,ما خطب ذلك العدوّ؟
Dialogue: 10,0:13:46.39,0:13:49.61,Main,,0,0,0,,!ظلّ يراوغنا طوال اليوم فحسب
Dialogue: 10,0:13:50.11,0:13:51.90,Main,,0,0,0,,!اهدأ يا باتيه-ساما
Dialogue: 10,0:13:51.90,0:13:53.28,Main,,0,0,0,,!اخرس
Dialogue: 10,0:13:53.28,0:13:54.15,Narrator,,0,0,0,,اليوم الثاني
Dialogue: 10,0:13:54.95,0:13:57.14,Narrator,,0,0,0,,...في ساحة معركة ميسرة تشين
Dialogue: 10,0:13:57.20,0:14:02.12,Narrator,,0,0,0,,انتهى اليوم بحالة جمودٍ تامّ خلافًا لليوم الأول
Dialogue: 10,0:14:03.23,0:14:07.76,Narrator,,0,0,0,,ضدّ جيش كيسوي الّذي اعتمد أسلوب القوّة بقيادة باتيه
Dialogue: 10,0:14:07.81,0:14:12.09,Narrator,,0,0,0,,كانت الغلبة لموتين الّذي واجههم بالمرونة
Dialogue: 10,0:14:13.09,0:14:15.03,Top,,0,0,0,,!يحيا السيّد الشاب
Dialogue: 10,0:14:15.03,0:14:17.50,Top,,0,0,0,,!يحيا القائد أكو
Dialogue: 10,0:14:13.09,0:14:15.80,Narrator,,0,0,0,,...أمّا في ميمنة جيش تشين
Dialogue: 10,0:14:15.80,0:14:20.55,Narrator,,0,0,0,,فقد استُقبل أوهون بهتافات جيش أكو عند عودته
Dialogue: 10,0:14:20.56,0:14:22.53,Top,,0,0,0,,!يحيا السيّد الشاب
Dialogue: 10,0:14:23.17,0:14:25.39,Main,,0,0,0,,ما هذا؟
Dialogue: 10,0:14:23.17,0:14:25.39,Top,,0,0,0,,ما هذا؟
Dialogue: 10,0:14:25.53,0:14:26.81,Main,,0,0,0,,...جنود أكو
Dialogue: 10,0:14:26.81,0:14:29.17,Main,,0,0,0,,يملكون خبرةً كبيرةً في الحروب
Dialogue: 10,0:14:29.63,0:14:33.32,Main,,0,0,0,,يدركون عظمة ما فعله السيّد الشاب اليوم
Dialogue: 10,0:14:34.31,0:14:39.57,Main,,0,0,0,,تلقّى جيش بانانجي في هذا اليوم ضربةً قاصمة
Dialogue: 10,0:14:40.21,0:14:43.04,Main,,0,0,0,,وبالطبع سنكون جميعًا سعداء
Dialogue: 10,0:14:44.16,0:14:50.12,Main,,0,0,0,,...فالوريث سيّئ الحظ الّذي لم يُمنح فرصةً للتألق
Dialogue: 10,0:14:50.32,0:14:54.82,Main,,0,0,0,,ابتكر تكتيكاتٍ ماكرةً تضاهي تكتيكات أوسين-ساما في هذه المعركة الحاسمة
Dialogue: 10,0:14:54.82,0:14:56.87,Main,,0,0,0,,وحقّق نصرًا
Dialogue: 10,0:15:06.87,0:15:08.10,Main,,0,0,0,,أحسنت
Dialogue: 10,0:15:08.29,0:15:12.30,Main,,0,0,0,,ولكن، لا وقت للابتهاج أيّها السيّد الشاب
Dialogue: 10,0:15:12.77,0:15:14.31,Main,,0,0,0,,أتراني مُبتهجًا؟
Dialogue: 10,0:15:14.52,0:15:18.27,Main,,0,0,0,,سيردّ ريبوكو غدًا بقدر ما خسر حتمًا
Dialogue: 10,0:15:18.61,0:15:20.38,Main,,0,0,0,,هذا صحيح
Dialogue: 10,0:15:20.38,0:15:23.07,Main,,0,0,0,,تعال إلى مقرّ قيادتي بعد تضميد جراحك
Dialogue: 10,0:15:23.38,0:15:25.58,Main,,0,0,0,,سنعقد اجتماعنا الاستراتيجيّ فورًا
Dialogue: 10,0:15:25.90,0:15:27.08,Main,,0,0,0,,مفهوم
Dialogue: 10,0:15:31.33,0:15:34.16,Main,,0,0,0,,!ما هذا الشعور بالتهميش
Dialogue: 10,0:15:34.16,0:15:37.35,Main,,0,0,0,,،وحدة غيوكوهو وغاكوكا تقاتلان بضراوةٍ يمينًا ويسارًا
Dialogue: 10,0:15:37.35,0:15:39.12,Main,,0,0,0,,!ونحن لم نتحرّك ولو لمرّةٍ واحدة
Dialogue: 10,0:15:39.12,0:15:41.30,Main,,0,0,0,,!لم نفعل شيئًا بعد
Dialogue: 10,0:15:41.49,0:15:43.05,Main,,0,0,0,,!تبًّا
Dialogue: 10,0:15:42.84,0:15:44.97,Top,,0,0,0,,تمالك نفسك يا بيهي-سان
Dialogue: 10,0:15:45.25,0:15:48.00,Main,,0,0,0,,لِمَ تتصنّع الشجاعة فجأةً يا بيهي-سان؟
Dialogue: 10,0:15:48.00,0:15:52.59,Main,,0,0,0,,"رغم أنّك قلتَ عشرين مرّةً: "أتمنّى أن ننتصر قبل أن نُشارك
Dialogue: 10,0:15:53.61,0:15:56.73,Main,,0,0,0,,!متى قلتُ ذلك أيّها الوغد
Dialogue: 10,0:15:56.73,0:15:59.52,Main,,0,0,0,,!حتّى لو قلتها، لم أقلها عشرين مرّة
Dialogue: 10,0:15:59.52,0:16:00.33,Main,,0,0,0,,!مؤلم
Dialogue: 10,0:16:00.38,0:16:02.26,Main,,0,0,0,,ثلاثًا وعشرين مرّةً بالتحديد
Dialogue: 10,0:16:02.27,0:16:02.93,Main,,0,0,0,,!مؤلم
Dialogue: 10,0:16:03.76,0:16:05.74,Main,,0,0,0,,لم نكن مكتوفي الأيدي
Dialogue: 10,0:16:06.19,0:16:12.35,Main,,0,0,0,,خلافًا لكم أيّها السلاحف، خرجت نخبة خيّالتنا وحاصرنا ريبوكو
Comment: 10,0:16:13.77,0:16:14.25,Main,,0,0,0,,
Dialogue: 10,0:16:14.71,0:16:16.26,Main,,0,0,0,,مهلًا يا غارو
Comment: 10,0:16:16.32,0:16:16.86,Main,,0,0,0,,
Dialogue: 10,0:16:16.86,0:16:19.69,Main,,0,0,0,,أوصفتَ المشاة بـ "السلاحف" للتوّ؟
Dialogue: 10,0:16:23.21,0:16:25.83,Main,,0,0,0,,إنّه مجرّد تعبيرٍ مجازي، لا تهتم
Dialogue: 10,0:16:25.83,0:16:28.76,Main,,0,0,0,,بل أهتم، ما الّذي تعنيه؟
Comment: 10,0:16:28.97,0:16:30.01,Main,,0,0,0,,
Dialogue: 10,0:16:30.01,0:16:31.52,Main,,0,0,0,,تكلّم
Dialogue: 10,0:16:32.23,0:16:33.34,Main,,0,0,0,,...مهلًا
Dialogue: 10,0:16:33.77,0:16:36.27,Main,,0,0,0,,!مـ-مهلًا مهلًا مهلًا
Dialogue: 10,0:16:36.27,0:16:38.13,Main,,0,0,0,,اهدأ يا سوغين
Dialogue: 10,0:16:38.13,0:16:41.74,Main,,0,0,0,,لسان غارو السليط ليس بجديد
Dialogue: 10,0:16:41.74,0:16:43.38,Main,,0,0,0,,أنا مهتمٌّ أيضًا
Dialogue: 10,0:16:43.38,0:16:44.63,Main,,0,0,0,,!أيّها القائد شوسا
Dialogue: 10,0:16:44.68,0:16:49.03,Main,,0,0,0,,فيمَ قد يفكّر نخبة الخيّالة الّذين انطلقوا بزمجرةٍ وعادوا خالي الوفاض
Dialogue: 10,0:16:49.12,0:16:52.12,Main,,0,0,0,,بأيّ حقٍّ يصفوننا بـ "السلاحف"؟
Dialogue: 10,0:16:53.10,0:16:54.35,Main,,0,0,0,,!يا شوسا
Dialogue: 10,0:16:54.57,0:16:58.50,Main,,0,0,0,,أتدرك كم قاتلنا بضراوةٍ وحقّقنا من إنجازاتٍ البارحة؟
Dialogue: 10,0:16:59.11,0:17:00.40,Main,,0,0,0,,!أتسخر منّا أيّها الوغد
Dialogue: 10,0:17:01.62,0:17:06.51,Main,,0,0,0,,حتّى دينيو-سان الّذي كان سلحفاةً معنا أصبح خيّالًا ويتكبّر علينا؟
Dialogue: 10,0:17:06.68,0:17:07.97,Main,,0,0,0,,!كم تغيّرت
Dialogue: 10,0:17:08.44,0:17:09.95,Main,,0,0,0,,!سأقتلك أيّها الوغد
Dialogue: 10,0:17:09.95,0:17:11.18,Main,,0,0,0,,!اخرس
Dialogue: 10,0:17:11.24,0:17:13.36,Main,,0,0,0,,...أعلم أنّكم مستاؤون لعدم القتال
Dialogue: 10,0:17:13.42,0:17:17.50,Main,,0,0,0,,!ولكن لا تظهروا بمظهرٍ مخزٍ أمام المستجدّين
Dialogue: 10,0:17:17.91,0:17:20.33,Main,,0,0,0,,لِمَ أنا فحسب؟
Dialogue: 10,0:17:21.17,0:17:22.57,Main,,0,0,0,,!هذا ظلمٌ يا شوسا
Dialogue: 10,0:17:23.46,0:17:24.83,Main,,0,0,0,,لا شأن لي
Dialogue: 10,0:17:25.20,0:17:27.66,Main,,0,0,0,,كم معركةً خضنا؟
Dialogue: 10,0:17:27.73,0:17:29.87,Main,,0,0,0,,!تحدث أمورٌ كهذه في الحروب
Dialogue: 10,0:17:30.06,0:17:33.14,Main,,0,0,0,,ستأتي لحظتنا الكبرى حتمًا
Dialogue: 10,0:17:33.24,0:17:36.21,Main,,0,0,0,,لذا تصرّفوا بنضجٍ حتّى ذلك الحين
Dialogue: 10,0:17:36.23,0:17:38.46,Main,,0,0,0,,!سحقًا لكم أيّها الحمقى
Dialogue: 10,0:17:39.28,0:17:41.55,Main,,0,0,0,,إنّه غاضبٌ حقًّا
Dialogue: 10,0:17:41.64,0:17:46.47,Main,,0,0,0,,!أجل، وسماع مآثر أوهون اليوم زاد من غضبه أكثر
Dialogue: 10,0:17:46.96,0:17:50.49,Top,,0,0,0,,أوسين أيّها الأحمق
Dialogue: 10,0:17:49.04,0:17:50.97,Main,,0,0,0,,أهذا ما يسمّيه نضجًا؟
Dialogue: 10,0:17:52.40,0:17:56.48,Main,,0,0,0,,عذرًا، أكان قادة المشاة يمزحون للتوّ؟
Dialogue: 10,0:17:57.94,0:17:59.23,Main,,0,0,0,,نوعًا ما
Dialogue: 10,0:17:59.49,0:18:01.66,Main,,0,0,0,,إنّهم متفرّغون لا أكثر
Dialogue: 10,0:18:01.98,0:18:03.98,Main,,0,0,0,,هكذا إذن
Dialogue: 10,0:18:04.64,0:18:08.70,Main,,0,0,0,,...مع ذلك، أن نُترك معلّقين في حربٍ ضخمةٍ كهذه
Dialogue: 10,0:18:08.99,0:18:12.09,Main,,0,0,0,,أنتم المستجدّون تتقبّلون الأمر بشكلٍ جيّد
Dialogue: 10,0:18:12.20,0:18:17.12,Main,,0,0,0,,أجل، نحن متحمّسون للقتال في المرّة القادمة
Dialogue: 10,0:18:17.54,0:18:21.00,Main,,0,0,0,,...لكنَّ الانتظار في مكانٍ لا نرى فيه ساحة المعركة حتّى
Dialogue: 10,0:18:21.92,0:18:25.96,Main,,0,0,0,,لا حرج في الاسترخاء، ولكن ليبقَ عزمكم مشدودًا ومعنوياتكم سامقة
Dialogue: 10,0:18:26.23,0:18:30.59,Main,,0,0,0,,فكلمةٌ واحدةٌ من الجنرال أوسين ستلقي بنا في خضمّ المعركة
Dialogue: 10,0:18:31.80,0:18:33.06,Main,,0,0,0,,!حاضر
Dialogue: 10,0:18:33.34,0:18:34.72,Main,,0,0,0,,!حسنٌ يا رفاق
Dialogue: 10,0:18:34.72,0:18:36.16,Main,,0,0,0,,!لنشعل حماسنا
Dialogue: 10,0:18:38.52,0:18:39.60,Main,,0,0,0,,!يا رفاق
Dialogue: 10,0:18:39.60,0:18:41.23,Main,,0,0,0,,!وقت العشاء
Dialogue: 10,0:18:43.32,0:18:44.73,Main,,0,0,0,,!طال انتظارنا
Dialogue: 10,0:18:44.73,0:18:45.69,Main,,0,0,0,,!أخيرًا
Dialogue: 10,0:18:45.69,0:18:46.66,Main,,0,0,0,,!ساخن
Dialogue: 10,0:18:47.68,0:18:48.96,Main,,0,0,0,,!لذيذ
Dialogue: 10,0:18:51.18,0:18:52.16,Main,,0,0,0,,!عجبًا
Dialogue: 10,0:18:52.27,0:18:53.02,Main,,0,0,0,,ما الأمر؟
Dialogue: 10,0:18:53.81,0:18:58.18,Main,,0,0,0,,أليست الكمية أقلّ من المعتاد اليوم؟
Dialogue: 10,0:18:58.18,0:18:59.46,Main,,0,0,0,,هذا صحيح
Dialogue: 10,0:19:00.78,0:19:02.14,Main,,0,0,0,,لاحظوا الأمر
Dialogue: 10,0:19:03.36,0:19:04.70,Main,,0,0,0,,أهذا صحيحٌ يا تين؟
Dialogue: 10,0:19:05.20,0:19:06.21,Main,,0,0,0,,المزيد
Dialogue: 10,0:19:07.46,0:19:08.72,Main,,0,0,0,,...في الواقع
Dialogue: 10,0:19:09.42,0:19:11.17,Main,,0,0,0,,لا، لا يوجد المزيد
Dialogue: 10,0:19:12.82,0:19:15.47,Main,,0,0,0,,قلّص أوسين حصص الطعام؟
Dialogue: 10,0:19:16.00,0:19:18.75,Main,,0,0,0,,!اخفض صوتك يا شين
Dialogue: 10,0:19:18.86,0:19:23.56,Main,,0,0,0,,شين-دونو، من الأفضل ألّا يعلم الجنود بهذا بعد
Dialogue: 10,0:19:23.69,0:19:28.74,Main,,0,0,0,,لا تخبريني إنَّ الطعام قد نفد بعد يومين فحسب
Dialogue: 10,0:19:29.01,0:19:30.72,Main,,0,0,0,,...ليس كذلك، ولكن
Dialogue: 10,0:19:31.02,0:19:34.79,Main,,0,0,0,,أظنّ الأمر متعلّقٌ بموت ماكو على الميسرة
Dialogue: 10,0:19:35.45,0:19:37.12,Main,,0,0,0,,موت ماكو؟
Dialogue: 10,0:19:37.37,0:19:39.86,Main,,0,0,0,,...صمدت الميسرة بفضل موتين
Dialogue: 10,0:19:40.45,0:19:45.34,Main,,0,0,0,,لكنَّ خطّة الجنرال أوسين تعثّرت في البداية بلا شكّ
Dialogue: 10,0:19:45.97,0:19:50.55,Main,,0,0,0,,ستطول هذه المعركة أكثر ممّا توقّعنا لتحقيق النصر
Dialogue: 10,0:19:50.55,0:19:52.13,Main,,0,0,0,,بالضبط
Dialogue: 10,0:19:52.24,0:19:57.68,Main,,0,0,0,,وبهذا إن طالت الأيّام، فلا خيار أمامنا سوى تقليل كمية الطعام
Dialogue: 10,0:19:58.06,0:19:59.70,Main,,0,0,0,,هكذا إذن
Dialogue: 10,0:20:00.93,0:20:05.94,Main,,0,0,0,,نسيتُ الأمر تمامًا بسبب تحرّكات ريبوكو الصاخبة منذ اليوم الأول
Dialogue: 10,0:20:05.94,0:20:07.48,Main,,0,0,0,,...هذه المعركة
Dialogue: 10,0:20:07.94,0:20:11.29,Main,,0,0,0,,هي معركة مؤنٍ أيضًا
Dialogue: 10,0:20:18.62,0:20:20.86,Main,,0,0,0,,لِمَ هذا التحديق المستمرّ؟
Dialogue: 10,0:20:20.86,0:20:25.25,Main,,0,0,0,,كان الأجدر بنا البدء فورًا بزخم الأمس
Dialogue: 10,0:20:25.51,0:20:29.88,Main,,0,0,0,,تحرّك ريبوكو مع الفجر، لذا لا يمكننا التهوّر
Dialogue: 10,0:20:31.01,0:20:32.05,Main,,0,0,0,,ريبوكو؟
Dialogue: 10,0:20:32.52,0:20:33.90,Main,,0,0,0,,ماذا فعل؟
Dialogue: 10,0:20:34.45,0:20:36.73,Main,,0,0,0,,ليس أمرًا مفاجئًا
Dialogue: 10,0:20:36.73,0:20:39.66,Main,,0,0,0,,سيصلون قريبًا وفقًا لتقرير الكشّافة
Dialogue: 10,0:20:39.75,0:20:40.64,Main,,0,0,0,,يصلون؟
Dialogue: 10,0:20:45.56,0:20:47.06,Main,,0,0,0,,!ها هم ذا
Dialogue: 10,0:20:47.56,0:20:50.69,Main,,0,0,0,,عشرة آلاف كتعزيزاتٍ جديدة من الجيش المركزي
Dialogue: 10,0:20:51.12,0:20:54.47,Main,,0,0,0,,أيرسل عشرة آلاف بهذه السرعة ونحن في اليوم الثالث فحسب؟
Dialogue: 10,0:20:54.47,0:20:57.87,Main,,0,0,0,,من الجيّد أنّنا لم نتهوّر
Dialogue: 10,0:20:58.33,0:21:03.45,Main,,0,0,0,,وبسبب هذا تدهورت معنوياتنا بعد أن ارتفعت
Dialogue: 10,0:21:04.11,0:21:06.61,Main,,0,0,0,,لا، هذا جيّدٌ يا كانجو
Dialogue: 10,0:21:08.00,0:21:10.75,Main,,0,0,0,,!اسمعوا يا جنود غيوكوهو
Dialogue: 10,0:21:14.26,0:21:19.26,Main,,0,0,0,,المنتصر في هذه المعركة هو من يسحق جيش خصمه المركزي
Dialogue: 10,0:21:19.63,0:21:22.88,Main,,0,0,0,,...القائد العام أوسين والعدوّ ريبوكو
Dialogue: 10,0:21:22.88,0:21:25.28,Main,,0,0,0,,...يتنافسان في استراتيجيّةٍ تهدف للتفوّق في الجناحين
Dialogue: 10,0:21:25.28,0:21:28.09,Main,,0,0,0,,...لإجبار الخصم على إرسال تعزيزاتٍ من المركز
Dialogue: 10,0:21:28.09,0:21:32.03,Main,,0,0,0,,وبالتالي إضعاف الجيش المركزي
Dialogue: 10,0:21:32.45,0:21:37.26,Main,,0,0,0,,...وصول عشرة آلافٍ من مركز العدوّ يعني
Dialogue: 10,0:21:37.26,0:21:40.03,Main,,0,0,0,,أنّنا قلّصنا جيشهم المركزي بمقدار عشرة آلاف
Dialogue: 10,0:21:41.95,0:21:44.21,Main,,0,0,0,,...سنستمرّ في الاستنزافهم بهذا الشكل
Dialogue: 10,0:21:44.21,0:21:47.20,Main,,0,0,0,,...وحين يتّسع فارق القوّة بين الجيشين المركزيّين
Dialogue: 10,0:21:47.20,0:21:50.17,Main,,0,0,0,,سيتحرّك جيش أوسين المركزي لحسم المعركة
Dialogue: 10,0:21:50.68,0:21:53.81,Main,,0,0,0,,وحتّى ذلك الحين، سنواصل الانتصار في الميمنة
Dialogue: 10,0:21:54.61,0:21:57.97,Main,,0,0,0,,فلتأتِ التعزيزات بالآلاف، هذا ما نبتغيه
Dialogue: 10,0:21:58.62,0:22:00.60,Main,,0,0,0,,هذا هو دورنا
Dialogue: 10,0:22:01.19,0:22:02.72,Main,,0,0,0,,!هون-ساما
Dialogue: 10,0:22:02.72,0:22:04.25,Main,,0,0,0,,...من أجل الجيش المركزي
Dialogue: 10,0:22:04.25,0:22:07.29,Main,,0,0,0,,...من أجل معركة القائد العام أوسين الحاسمة
Dialogue: 10,0:22:07.29,0:22:10.98,Main,,0,0,0,,!سنريق الدماء ونمزّق العدوّ بلا هوادة
Dialogue: 10,0:22:11.51,0:22:13.93,Main,,0,0,0,,!استعدّوا يا جيش غيوكوهو
Dialogue: 10,0:22:23.24,0:22:28.07,Main,,0,0,0,,لم أعهد السيّد الشاب يصرخ هكذا لتحفيز الجنود
Dialogue: 10,0:22:28.55,0:22:32.50,Main,,0,0,0,,كشف كلّ شيء، لم يبقَ لي ما أقوله
Dialogue: 10,0:22:32.50,0:22:34.50,Main,,0,0,0,,!لنتحرّك يا جيش أكو
Dialogue: 10,0:22:34.86,0:22:37.76,Main,,0,0,0,,!سنجعل هذا المكان ساحة صيدنا اليوم أيضًا
Dialogue: 10,0:22:40.20,0:22:41.49,Main,,0,0,0,,!أهؤلاء جيس تشين؟
Dialogue: 10,0:22:41.63,0:22:43.44,Main,,0,0,0,,!يا لها من هتافات صاخبة
Dialogue: 10,0:22:44.00,0:22:46.47,Main,,0,0,0,,سيعمّ الصمت قريبًا
Dialogue: 10,0:22:47.42,0:22:51.57,Main,,0,0,0,,أحد العظماء الثلاثة؛ رينشوجو الّذي شكّل ثنائيًا عظيمًا مع رينبا
Dialogue: 10,0:22:51.64,0:22:55.74,Main,,0,0,0,,كان جنرالًا عظيمًا وتكتيكيًّا فذًّا يجمع بين الحكمة والشجاعة
Dialogue: 10,0:22:56.61,0:23:02.27,Main,,0,0,0,,كما أنَّ لديه جنرالاتٌ أكفّاء تولّوا الجانب القتالي الّذي افتقر إليه
Dialogue: 10,0:23:02.32,0:23:05.23,Main,,0,0,0,,وكان غيون هو من يقودهم
Dialogue: 10,0:23:05.44,0:23:08.62,Main,,0,0,0,,...قوّة جيش رينشوجو؛ أحد العظماء الثلاثة سابقًا
Dialogue: 10,0:23:08.62,0:23:10.99,Main,,0,0,0,,تتمثّل في غيون نفسه
Dialogue: 0,0:09:13.22,0:09:16.62,Note,,0,0,0,,يقصد أنّه شخص خطير، إن تحرّك سبّب فوضى عارمة
Dialogue: 0,0:03:14.22,0:03:18.17,Signs,,0,0,0,,منظور الجنرال العظيم
