Dialogue: 10,0:00:08.54,0:00:12.17,Main,,0,0,0,,!ر-ريبوكو-ساما! شكرًا لمجيئك بهذه السرعة
Dialogue: 10,0:00:12.17,0:00:14.73,Main,,0,0,0,,سأغادر مجدّدًا بعد أخذ استراحة قصيرة
Dialogue: 10,0:00:14.81,0:00:17.62,Main,,0,0,0,,عذرًا، ولكن هل يمكن لرجالي الحصول على ماءٍ وشيءٍ يأكلونه؟
Dialogue: 10,0:00:17.64,0:00:19.63,Main,,0,0,0,,!أجل، على الفور
Dialogue: 10,0:00:19.63,0:00:23.19,Main,,0,0,0,,ر-يبوكو-ساما، لديّ بعض الأخبار الجيّدة
Dialogue: 10,0:00:24.35,0:00:28.11,Main,,0,0,0,,،غزا تشوهاكو-ساما مدينتي ري ويو في إين
Dialogue: 10,0:00:28.11,0:00:31.69,Main,,0,0,0,,!وانسحب جيش أورودو من الشمال الشرقي
Dialogue: 10,0:00:32.77,0:00:35.53,Main,,0,0,0,,،عرفتُ اسمكَ الآن وسأعود مجدّدًا
Dialogue: 10,0:00:35.53,0:00:37.25,Main,,0,0,0,,‫يا شيباشو!
Dialogue: 10,0:00:37.33,0:00:38.86,Main,,0,0,0,,!العدو ينسحب
Dialogue: 10,0:00:39.01,0:00:40.29,Main,,0,0,0,,!إلى كلّ القوات، انسحبوا
Dialogue: 10,0:00:40.85,0:00:42.17,Main,,0,0,0,,هل نطاردهم؟
Dialogue: 10,0:00:43.50,0:00:45.28,Main,,0,0,0,,سنعود إلى سيكا
Dialogue: 10,0:00:45.28,0:00:46.12,Main,,0,0,0,,!عُلم
Dialogue: 10,0:00:46.58,0:00:48.32,Main,,0,0,0,,أهذا صحيح، يا كينهو-دونو؟
Dialogue: 10,0:00:48.32,0:00:49.13,Main,,0,0,0,,!أجل
Dialogue: 10,0:00:49.99,0:00:53.09,Main,,0,0,0,,أحسنت صنعًا يا شيباشو
Dialogue: 10,0:00:53.61,0:00:56.78,Main,,0,0,0,,يمكننا أخيرًا التركيز على جيش تشين فحسب
Dialogue: 10,0:00:56.78,0:01:02.31,Main,,0,0,0,,على ذكر ذلك، ما مدى قربهم من غيو الآن؟
Dialogue: 10,0:01:02.61,0:01:08.56,Main,,0,0,0,,...حـ-حسنٌ، وفقًا لرسائل الّتي تلقيناها عبر الطيور
Dialogue: 10,0:01:08.87,0:01:13.32,Main,,0,0,0,,!إنّهم لا يتجهون مباشرةً إلى غيو، بل يهاجمون جوتا على طول الطريق
Dialogue: 10,0:01:14.57,0:01:16.71,Main,,0,0,0,,مـ-ماذا قلت؟
Dialogue: 10,0:01:17.86,0:01:19.03,Main,,0,0,0,,!مُحال
Dialogue: 10,0:01:19.40,0:01:20.74,Main,,0,0,0,,لمَ مغادرة ريتسوبي؟
Dialogue: 10,0:01:20.74,0:01:24.25,Main,,0,0,0,,لِمَ نتخلى عن خطّتنا ونمضيّ قدمًا؟
Dialogue: 10,0:01:24.58,0:01:29.75,Main,,0,0,0,,بمعنى أنّ قوات التحالف تتحرك حاليًّا وفق استراتيجية أوسين
Dialogue: 10,0:01:30.59,0:01:32.21,Main,,0,0,0,,!استراتيجية أوسين
Dialogue: 10,0:03:04.01,0:03:10.48,Top,,0,0,0,,لدينا مهلة ضيّقة، لكنّنا ننعطف لغزو هذا المكان التافه؟
Dialogue: 10,0:03:10.48,0:03:14.01,Main,,0,0,0,,!ما الّذي يحاول جنرالنا تحقيقه؟
Dialogue: 10,0:03:14.93,0:03:17.35,Main,,0,0,0,,لندخل فحسب يا شين
Dialogue: 10,0:03:27.83,0:03:31.67,Main,,0,0,0,,!وجدتها! وجدتها! مخبأةً في السقف
Dialogue: 10,0:03:31.67,0:03:33.30,Main,,0,0,0,,!حصلتُ على غنيمة بدوري
Dialogue: 10,0:03:33.31,0:03:35.43,Main,,0,0,0,,!رغم أنَّ هذه القلعة صغيرة إلا أنّها مليئة بالغنائم
Dialogue: 10,0:03:35.52,0:03:38.75,Main,,0,0,0,,!تبًّا، إنّهم ينهبون حتّى ونحن في هذا الوضع
Dialogue: 10,0:03:38.75,0:03:39.72,Main,,0,0,0,,‫تمهّل يا شين!
Dialogue: 10,0:03:40.30,0:03:41.60,Main,,0,0,0,,!موتين
Dialogue: 10,0:03:42.33,0:03:45.80,Main,,0,0,0,,حاستهم للكنوز مفيدةٌ لنا هذه المرّة
Dialogue: 10,0:03:46.06,0:03:46.82,Main,,0,0,0,,ماذا؟
Dialogue: 10,0:03:47.05,0:03:50.64,Main,,0,0,0,,وجدنا مخزن طعامٍ أسفل مقرّ حاكم القلعة
Dialogue: 10,0:03:50.64,0:03:55.28,Main,,0,0,0,,أخذنا كلّ ما تبقّى من مؤن السكان المخبّأة بالطبع
Dialogue: 10,0:03:55.28,0:03:56.31,Main,,0,0,0,,بوركتم
Dialogue: 10,0:03:56.31,0:03:59.07,Main,,0,0,0,,لا أتصور أنّنا تركنا شيئًا
Dialogue: 10,0:03:59.60,0:04:02.28,Main,,0,0,0,,سمعته أيّها الجنرال
Dialogue: 10,0:04:02.57,0:04:05.45,Main,,0,0,0,,،حتّى دون بحث شامل
Dialogue: 10,0:04:05.53,0:04:09.74,Main,,0,0,0,,القليل من تعذيب عصابة ساكي كان ليكشف كلّ شيءٍ على الفور
Dialogue: 10,0:04:10.17,0:04:15.80,Main,,0,0,0,,لكن أمرك الصارم بقطع رأس كلّ من يؤذي المدنيين
Dialogue: 10,0:04:15.80,0:04:19.25,Main,,0,0,0,,وكان ذلك عسيرًا على رجالنا‫!
Dialogue: 10,0:04:19.69,0:04:22.69,Main,,0,0,0,,!يأخذون المؤونة دون قتل المدنيين؟
Dialogue: 10,0:04:22.69,0:04:23.51,Main,,0,0,0,,أجل
Dialogue: 10,0:04:24.41,0:04:28.27,Main,,0,0,0,,!لـ-لكنّهم ينهبون الأشياء الثمينة
Dialogue: 10,0:04:29.51,0:04:33.44,Main,,0,0,0,,كانت تلك مقايضةً لكي تطيع قوات كانكي الأمر
Dialogue: 10,0:04:34.09,0:04:36.48,Main,,0,0,0,,المؤن هي ما نسعى إليه
Dialogue: 10,0:04:37.17,0:04:38.41,Main,,0,0,0,,المؤن؟
Dialogue: 10,0:04:38.41,0:04:40.23,Main,,0,0,0,,!تمهّل لحظة
Dialogue: 10,0:04:41.10,0:04:46.74,Main,,0,0,0,,صـ-صحيح أن الكمية ستزيد من مخزوننا، لكنها ليست بشيءٍ يُذكر
Dialogue: 10,0:04:46.74,0:04:51.19,Main,,0,0,0,,،استهلكنا مؤونة نصف يومٍ للقدوم إلى هنا لغزو هذه القلعة
Dialogue: 10,0:04:51.19,0:04:55.93,Main,,0,0,0,,!ومنحنا جيوش تشاو الّتي تدافع عن منطقة العاصمة نصف يوم من الوقت
Dialogue: 10,0:04:56.75,0:05:00.72,Main,,0,0,0,,،إن أتينا إلى هنا لتعزيز مؤننا فحسب
Dialogue: 10,0:05:00.72,0:05:03.71,Main,,0,0,0,,!فلا بدَّ أنَّ هذه أسوأ وأحمق خطّةٍ على الإطلاق
Dialogue: 10,0:05:04.01,0:05:04.92,Main,,0,0,0,,...تين
Dialogue: 10,0:05:05.95,0:05:11.93,Main,,0,0,0,,كاريوتين على حقّة تمامًا، ولكن ثمّة شيء مريبٌ هنا
Dialogue: 10,0:05:12.44,0:05:17.63,Main,,0,0,0,,ما الدافع الّذي جعل الجنرال أوسين يسنّ قرارًا بالحفاظ على سلامة المدنيين؟
Dialogue: 10,0:05:19.02,0:05:21.82,Main,,0,0,0,,لمَ قاموا بحشدنا هنا؟
Dialogue: 10,0:05:22.24,0:05:25.19,Main,,0,0,0,,هل سيقتلوننا دفعةً واحدةً؟
Dialogue: 10,0:05:25.66,0:05:27.87,Main,,0,0,0,,لا تخشوا شيئًا
Dialogue: 10,0:05:27.87,0:05:31.16,Main,,0,0,0,,،أنا أوسين القائد العام لهذا الجيش
Dialogue: 10,0:05:31.16,0:05:35.51,Main,,0,0,0,,!لن أسمح بلمس شعرةٍ منكم أيّها المدنيون
Dialogue: 10,0:05:43.97,0:05:48.71,Main,,0,0,0,,يا تين، هل كان الجنرال أوسين رجلًا ذا مبادئ وذو حسٍّ للعدالة؟
Dialogue: 10,0:05:50.32,0:05:53.28,Main,,0,0,0,,لا علاقة للأمر بالعدالة
Dialogue: 10,0:05:53.28,0:05:57.46,Main,,0,0,0,,قائد عام يخاطب المدنيين المهزومين شخصيًا هكذا
Dialogue: 10,0:05:57.46,0:05:58.71,Main,,0,0,0,,أمرٌ غير عادي على الإطلاق
Dialogue: 10,0:05:59.74,0:06:02.62,Main,,0,0,0,,هون-ساما، ما الّذي يفعله القائد؟
Dialogue: 10,0:06:04.02,0:06:06.20,Main,,0,0,0,,ما هذه المهزلة؟
Dialogue: 10,0:06:06.20,0:06:07.99,Main,,0,0,0,,اصمت وشاهد
Dialogue: 10,0:06:08.41,0:06:10.74,Main,,0,0,0,,ولكن هذه حرب
Dialogue: 10,0:06:12.70,0:06:20.14,Main,,0,0,0,,كم يعتصرني الألم، ولكن لا مفر من أخذ زادكم والاستيلاء على القلعة عينها
Dialogue: 10,0:06:20.81,0:06:24.75,Main,,0,0,0,,ومن دون زادٍ، عليكم أن تشقوا طريقكم نحو القلعة المجاورة
Dialogue: 10,0:06:24.75,0:06:28.19,Main,,0,0,0,,قبل أن تخورَ قواكم
Dialogue: 10,0:06:29.56,0:06:30.69,Main,,0,0,0,,سامحوني
Dialogue: 10,0:06:31.99,0:06:34.17,Main,,0,0,0,,!لـ-لا على الإطلاق
Dialogue: 10,0:06:34.17,0:06:37.35,Main,,0,0,0,,!نحن ممتنون لأنّك أبقيتَ على حياتنا
Dialogue: 10,0:06:37.85,0:06:39.87,Main,,0,0,0,,إذن، غادروا فورًا
Dialogue: 10,0:06:40.47,0:06:42.93,Main,,0,0,0,,وأبتهلُ أن يكون طريقكم آمنًا
Dialogue: 10,0:06:43.61,0:06:46.61,Main,,0,0,0,,!حسنٌ، شكرًا جزيلًا لك
Dialogue: 10,0:06:46.61,0:06:48.81,Main,,0,0,0,,!نـ-نجونا
Dialogue: 10,0:06:48.81,0:06:52.79,Main,,0,0,0,,!حتّى أنّه أطلق سراح قواتنا لكي ينضموا إلينا
Dialogue: 10,0:06:52.79,0:06:54.89,Main,,0,0,0,,يا له من جنرال طيب
Dialogue: 10,0:06:54.90,0:06:58.60,Main,,0,0,0,,سيكون من الصعب علينا نحن المسنين المشي إلى القلعة المجاورة
Dialogue: 10,0:06:58.60,0:07:01.79,Main,,0,0,0,,ولكن إن لم نفعل، فسنموت فحسب
Dialogue: 10,0:07:02.04,0:07:05.04,Main,,0,0,0,,!مـ-ما الّذي يجري يا تين؟
Dialogue: 10,0:07:05.04,0:07:07.80,Main,,0,0,0,,!تمهّل، أنا أفكر
Dialogue: 10,0:07:08.05,0:07:10.35,Main,,0,0,0,,!إ-إنّه مختلف على أقل تقدير
Dialogue: 10,0:07:10.58,0:07:13.55,Main,,0,0,0,,شيءٌ ما مختلف حتمًا... في الجنرال
Dialogue: 10,0:07:13.99,0:07:17.64,Main,,0,0,0,,!لم يكن الجنرال أوسين يسعى وراء المؤن
Dialogue: 10,0:07:17.98,0:07:22.06,Main,,0,0,0,,...هدفنا الحقيقيُّ من المجيء إلى هنا بلا شكٍّ
Dialogue: 10,0:07:24.01,0:07:26.99,Main,,0,0,0,,!يتعلق بالمدنيين الّذين طردهم للتو
Dialogue: 10,0:07:27.92,0:07:32.71,Main,,0,0,0,,!ولكنّي... ولكنّي عاجزة عن معرفة مُبتغانا
Dialogue: 10,0:07:34.85,0:07:37.24,Main,,0,0,0,,هل حفظتم الطريقة؟
Dialogue: 10,0:07:37.24,0:07:39.25,Main,,0,0,0,,لنمضي نحو القلعة التالية
Dialogue: 10,0:07:43.40,0:07:47.46,Main,,0,0,0,,أيّها الجنرال أوسين، هل لدينا وقت لهذا حقًّا؟
Dialogue: 10,0:07:48.08,0:07:51.17,Main,,0,0,0,,ألا يجب أن نصل إلى غيو بأسرع ما يمكن؟
Dialogue: 10,0:07:51.17,0:07:52.51,Main,,0,0,0,,!شـ-شين
Dialogue: 10,0:07:52.51,0:07:56.64,Main,,0,0,0,,أليس هذا ما يدفعُ أهل الجبال للذودِ هناك ليقفوا درعًا لنا؟
Dialogue: 10,0:07:57.24,0:07:58.82,Main,,0,0,0,,‫ميزة الأغبياء!
Dialogue: 10,0:07:58.82,0:08:01.64,Main,,0,0,0,,يتفوه بما لا يجرؤ أحد على قوله
Dialogue: 10,0:08:14.88,0:08:16.78,Main,,0,0,0,,...رمح الجنرال أوكي
Dialogue: 10,0:08:18.60,0:08:24.54,Main,,0,0,0,,مهما سلك ريبوكو من طريق مختصر، سيحتاج إلى يوم إضافي حتّى يعود إلى كانتان
Dialogue: 10,0:08:26.21,0:08:31.44,Main,,0,0,0,,ومن موقعه ذاك سيحتاج إلى يومٍ لتنسيق جيش إقليم العاصمة والشروع في التحرك
Dialogue: 10,0:08:31.44,0:08:35.30,Main,,0,0,0,,ويوم آخر للوصول إلى غيو للدفاع عنها
Dialogue: 10,0:08:35.86,0:08:40.01,Main,,0,0,0,,ينبغي أن تكون استراتيجيتنا جاهزة بالكامل بحلول ذلك الوقت
Dialogue: 10,0:08:42.23,0:08:46.16,Main,,0,0,0,,توجد ثماني قلاعٍ أخرى بيننا وبين غيو
Dialogue: 10,0:08:46.77,0:08:48.73,Main,,0,0,0,,‫سنقسم الجيش إلى ثلاثة أقسام،
Dialogue: 10,0:08:48.73,0:08:52.23,Main,,0,0,0,,وسنغزو كلّ واحدةٍ على حدة بينما نتحرك شرقًا بالتزامن مع بعضنا
Dialogue: 10,0:08:53.77,0:08:57.45,Main,,0,0,0,,،ونكرّر العملية بنهب كلّ مؤونتهم
Dialogue: 10,0:08:57.84,0:09:00.58,Main,,0,0,0,,ثمَّ ونُجبر المواطنين على النزوح شرقًا
Dialogue: 10,0:09:00.97,0:09:02.02,Main,,0,0,0,,!شرقًا
Dialogue: 10,0:09:02.02,0:09:03.54,Main,,0,0,0,,!رسالة عاجلة
Dialogue: 10,0:09:05.38,0:09:07.71,Main,,0,0,0,,!سقطت ريتسوبي في أيدي جيش تشاو
Dialogue: 10,0:09:08.51,0:09:12.77,Main,,0,0,0,,،تحرك حوالي 50 ألف جندي جنوبًا على طول جبال تايكو لغزوها
Dialogue: 10,0:09:12.77,0:09:16.09,Main,,0,0,0,,!ويبدو أنّهم بدأوا بنشر القوات في الخارج أيضًا
Dialogue: 10,0:09:17.15,0:09:18.30,Main,,0,0,0,,...ريتسوبي
Dialogue: 10,0:09:18.56,0:09:21.43,Main,,0,0,0,,أ-أصبح طريق خروجنا مسدودًا الآن
Dialogue: 10,0:09:21.80,0:09:24.43,Main,,0,0,0,,بات الشرق هو طريق خلاصنا الوحيد
Dialogue: 10,0:09:24.91,0:09:27.13,Main,,0,0,0,,أرسل رسالة إلى يوتانوا
Dialogue: 10,0:09:27.13,0:09:29.85,Main,,0,0,0,,عليها أن تتحرك بالتزامن مع الجيش الرئيسي
Dialogue: 10,0:09:29.85,0:09:30.65,Main,,0,0,0,,!عُلم
Dialogue: 10,0:09:31.60,0:09:33.40,Main,,0,0,0,,سنزيد من وتيرتنا الآن
Dialogue: 10,0:09:33.76,0:09:34.43,Main,,0,0,0,,!عُلم
Dialogue: 10,0:09:34.91,0:09:36.56,Main,,0,0,0,,!إلى كلّ القوات، تحركوا
Dialogue: 10,0:09:40.73,0:09:43.17,Narrator,,0,0,0,,،باتباع أوامر أوسين الدقيقة
Dialogue: 10,0:09:43.17,0:09:48.08,Narrator,,0,0,0,,،انتشرت الجيوش الثلاثة لغزو القلاع الصغيرة والمتوسطة
Dialogue: 10,0:09:48.37,0:09:52.91,Narrator,,0,0,0,,ممّا جعل حشد اللاجئين أكبر من أيّ وقت مضى
Dialogue: 10,0:09:54.18,0:09:59.39,Main,,0,0,0,,...تهجير كلّ هؤلاء المدنيين والمضي قدمًا دون احتلال القلاع حتّى
Dialogue: 10,0:09:59.72,0:10:03.10,Main,,0,0,0,,ما الّذي يجعلنا نفعله هنا؟
Dialogue: 10,0:10:08.44,0:10:09.35,Main,,0,0,0,,فهمت
Dialogue: 10,0:10:10.60,0:10:14.57,Main,,0,0,0,,ما الّذي فهمتِه يا كيوكاي-تشان؟
Dialogue: 10,0:10:15.03,0:10:16.04,Main,,0,0,0,,إنّهم جراد
Dialogue: 10,0:10:17.52,0:10:18.70,Main,,0,0,0,,جراد؟
Dialogue: 10,0:10:26.47,0:10:32.54,Narrator,,0,0,0,,،وبينما ظهر الموكب الضخم للاجئين في جنوب منطقة العاصمة
Dialogue: 10,0:10:32.94,0:10:37.03,Narrator,,0,0,0,,وصل ريبوكو أخيرًا إلى العاصمة كانتان
Dialogue: 10,0:10:46.46,0:10:48.00,Main,,0,0,0,,!ريبوكو-ساما
Dialogue: 10,0:10:48.00,0:10:50.27,Main,,0,0,0,,!القائد الأعلى ريبوكو
Dialogue: 10,0:10:50.27,0:10:51.82,Main,,0,0,0,,!ريبوكو-ساما
Dialogue: 10,0:10:51.82,0:10:53.23,Main,,0,0,0,,كنّا في انتظارك
Dialogue: 10,0:10:54.13,0:10:55.69,Main,,0,0,0,,...هذان
Dialogue: 10,0:10:55.85,0:10:59.45,Main,,0,0,0,,حسبما أتذكر، أليس رينشوجو-ساما أحد العظماء الثلاثة سابقًا؟
Dialogue: 10,0:11:00.16,0:11:03.39,Main,,0,0,0,,،بينما كنّا عاجزين عن نشر جيش كانتان
Dialogue: 10,0:11:03.39,0:11:05.95,Main,,0,0,0,,تلقينا إذنًا بقيادة قواتنا الشخصية
Dialogue: 10,0:11:06.31,0:11:07.45,Main,,0,0,0,,ممتاز
Dialogue: 10,0:11:07.94,0:11:12.28,Main,,0,0,0,,ترسل كلّ من إين وبون في الشمال 10 آلاف جندي
Dialogue: 10,0:11:12.28,0:11:14.47,Main,,0,0,0,,ينبغي أن يصلوا هنا قريبًا
Dialogue: 10,0:11:14.52,0:11:17.69,Main,,0,0,0,,هل نرسل الـ20 ألفًا مباشرةً إلى غيو؟
Dialogue: 10,0:11:17.69,0:11:20.22,Main,,0,0,0,,لا، لن يكون ذلك ضروريًا
Dialogue: 10,0:11:20.74,0:11:24.77,Main,,0,0,0,,غيو من أكثر القلاع تحصينًا في الممالك الوسطى
Dialogue: 10,0:11:24.87,0:11:27.11,Main,,0,0,0,,لا يمكن لجيش تشين غزوها
Dialogue: 10,0:11:28.45,0:11:31.41,Main,,0,0,0,,،إن تمكنوا من الوصول إلى هذا الحدّ
Dialogue: 10,0:11:31.41,0:11:33.46,Main,,0,0,0,,،سندفعهم أكثر نحو غيو
Dialogue: 10,0:11:33.46,0:11:35.91,Main,,0,0,0,,،ثمَّ نحاصرهم بجيش تشاو
Dialogue: 10,0:11:36.07,0:11:38.32,Main,,0,0,0,,ونجوّعهم
Dialogue: 10,0:11:38.95,0:11:42.82,Main,,0,0,0,,يمكنني تخيل قوات تشين المتألمة الآن
Dialogue: 10,0:11:43.69,0:11:47.12,Main,,0,0,0,,على كلٍّ، لديّ لقاء مع الملك
Dialogue: 10,0:11:47.12,0:11:50.29,Main,,0,0,0,,...بعد ذلك، سأتولى السيطرة على كلّ قوات منطقة العاصمة
Dialogue: 10,0:11:50.29,0:11:52.54,Main,,0,0,0,,!ريبوكو-ساما
Dialogue: 10,0:11:52.54,0:11:56.54,Main,,0,0,0,,!أهلًا بعودتك، كنت أنتظرك بفارغ الصبر
Dialogue: 10,0:11:56.54,0:11:57.68,Main,,0,0,0,,!كوشو-دونو
Dialogue: 10,0:11:58.41,0:12:02.93,Main,,0,0,0,,كوشو، أرى أنّك اتبعت التعليمات الّتي أرسلتها بالطائر
Dialogue: 10,0:12:03.21,0:12:04.66,Main,,0,0,0,,لـ-لا شكر على واجب
Dialogue: 10,0:12:04.73,0:12:08.60,Main,,0,0,0,,الأهم من ذلك، ثمّة الكثير من الطيور القادمة من هذه المنطقة أيضًا
Dialogue: 10,0:12:09.19,0:12:11.10,Main,,0,0,0,,ما الّذي يفعله جيش تشين الآن؟
Dialogue: 10,0:12:11.22,0:12:14.86,Main,,0,0,0,,‫حسنٌ، انقسمت قوات تشين الرئيسية إلى ثلاثة أقسام،
Dialogue: 10,0:12:14.86,0:12:18.33,Main,,0,0,0,,وتغزو البلدات على طول الطريق بينما تقترب من غيو
Dialogue: 10,0:12:18.33,0:12:20.82,Main,,0,0,0,,غزوا تسعًا بالفعل
Dialogue: 10,0:12:23.55,0:12:25.32,Main,,0,0,0,,وماذا عن الـ90 ألف جنديٍّ التابعين لكوسونريو؟
Dialogue: 10,0:12:25.32,0:12:29.10,Main,,0,0,0,,لا يزالون في مواجهة مع جيش أهل الجبال
Dialogue: 10,0:12:29.10,0:12:33.94,Main,,0,0,0,,غير أنّ وجود خطّ الجبهة يمنع اللاجئين من الهرب شمالًا
Dialogue: 10,0:12:35.05,0:12:36.33,Main,,0,0,0,,لاجئين؟
Dialogue: 10,0:12:37.47,0:12:43.80,Main,,0,0,0,,أجل، يبدو أنَّ جيش تشين طرد السكان من كلّ مدينة غزوها
Dialogue: 10,0:12:47.34,0:12:52.85,Main,,0,0,0,,إذن، يوجد حشد ضخم من اللاجئين يتجولون في منطقة العاصمة الجنوبية؟
Dialogue: 10,0:12:53.81,0:12:56.28,Main,,0,0,0,,لا، لا يتجولون
Dialogue: 10,0:12:57.66,0:13:02.53,Main,,0,0,0,,انقسم جيش تشين ويغزو البلدات بالترتيب من الغرب إلى الشرق
Dialogue: 10,0:13:02.53,0:13:04.61,Main,,0,0,0,,إلى الشمال حيث جدار جبهة المعركة
Dialogue: 10,0:13:05.36,0:13:09.99,Main,,0,0,0,,ستتجه جحافل اللاجئين كلّها شرقًا بلا شكٍّ
Dialogue: 10,0:13:10.39,0:13:14.00,Main,,0,0,0,,...لكن حينها سينتهي بهم المطاف في
Dialogue: 10,0:13:14.50,0:13:15.46,Main,,0,0,0,,كوشو
Dialogue: 10,0:13:17.34,0:13:18.46,Main,,0,0,0,,...منذ متى
Dialogue: 10,0:13:18.89,0:13:23.50,Main,,0,0,0,,منذ متى بدأت غيو في استقبال اللاجئين تحديدًا ؟
Dialogue: 10,0:13:24.55,0:13:27.56,Main,,0,0,0,,!لا دخول إن لم يكن اسمك في السجل
Dialogue: 10,0:13:27.56,0:13:29.01,Main,,0,0,0,,سنتعامل معكم في الخارج
Dialogue: 10,0:13:29.23,0:13:30.67,Main,,0,0,0,,!واصلوا التحرك
Dialogue: 10,0:13:30.87,0:13:33.97,Main,,0,0,0,,!ليتجه سكان سيكي إلى المنطقة الجنوبية
Dialogue: 10,0:13:34.97,0:13:38.82,Main,,0,0,0,,!ما زالوا يتوافدون؟ سيفيضون في ربعنا الثاني أيضًا
Dialogue: 10,0:13:39.27,0:13:43.61,Main,,0,0,0,,سيّدي، يقترح الجنرال شينريكان إغلاق البوابة
Dialogue: 10,0:13:43.61,0:13:47.07,Main,,0,0,0,,!لإيقاف تدفق اللاجئين مؤقتًا
Dialogue: 10,0:13:47.32,0:13:48.94,Main,,0,0,0,,ما الّذي تقوله؟
Dialogue: 10,0:13:49.24,0:13:51.02,Main,,0,0,0,,الأمّة تُبنى على شعبها
Dialogue: 10,0:13:51.02,0:13:53.08,Main,,0,0,0,,لم يصلنا جيش تشين بعد
Dialogue: 10,0:13:53.08,0:13:56.68,Main,,0,0,0,,اتركوا البوابة مفتوحة حتّى اللحظة الأخيرة وأنقذوا هؤلاء اللاجئين
Dialogue: 10,0:13:56.68,0:13:58.96,Main,,0,0,0,,...و-ولكن إن زاد العدد
Dialogue: 10,0:14:00.05,0:14:03.13,Main,,0,0,0,,!سيّدي، مخزن الحبوب صار مجرد هيكل فارغٍ بلا مؤنٍ!
Dialogue: 10,0:14:04.32,0:14:07.22,Main,,0,0,0,,!يتضاءل طعامنا بسرعة مع وجود الكثير من اللاجئين
Dialogue: 10,0:14:08.68,0:14:12.65,Main,,0,0,0,,لا يهم، افتحوا مخازن الحبوب رقم 4 و5
Dialogue: 10,0:14:12.65,0:14:14.55,Main,,0,0,0,,!لدينا مخازن لا حصر لها
Dialogue: 10,0:14:15.29,0:14:18.13,Main,,0,0,0,,يجب أن نرسل طائرًا إلى غيو فورًا
Dialogue: 10,0:14:18.13,0:14:20.81,Main,,0,0,0,,لا، فات الأوان على الأرجح
Dialogue: 10,0:14:20.81,0:14:23.48,Main,,0,0,0,,مـ-ماذا تقصد يا ريبوكو-ساما؟
Dialogue: 10,0:14:24.17,0:14:29.24,Main,,0,0,0,,أظن أنَّ أوسين ذهب لرؤية غيو بعد غزو ريتسوبي
Dialogue: 10,0:14:29.55,0:14:34.31,Main,,0,0,0,,...رآها شخصيًّا، وأدرك أنّه لا يمكن غزوها بالقوة الغاشمة
Dialogue: 10,0:14:34.82,0:14:36.10,Main,,0,0,0,,...وهكذا
Dialogue: 10,0:14:36.68,0:14:39.45,Main,,0,0,0,,،لم ينطلق أوسين مباشرةً إلى غيو
Dialogue: 10,0:14:39.45,0:14:42.78,Main,,0,0,0,,بل تعمد غزو تسع قلاعٍ على طول الطريق
Dialogue: 10,0:14:44.03,0:14:46.64,Main,,0,0,0,,‫لم يخطر ببالي أنَّ الغاية من هذه الاستراتيجية...
Dialogue: 10,0:14:47.31,0:14:50.26,Main,,0,0,0,,‫هي صنعُ سلاحٍ سيدمّر غيو!
Dialogue: 10,0:14:50.80,0:14:54.18,Main,,0,0,0,,!اللاجئون المطرودون هم سلاح؟
Dialogue: 10,0:14:54.63,0:14:57.53,Main,,0,0,0,,يأمر الحاكم بأن ندع كلّ اللاجئين يدخلون
Dialogue: 10,0:14:57.53,0:14:58.64,Main,,0,0,0,,!ماذا؟
Dialogue: 10,0:14:59.82,0:15:01.87,Main,,0,0,0,,!الجنرال شينريكان، انظر
Dialogue: 10,0:15:02.24,0:15:04.56,Main,,0,0,0,,!أخيرًا بلغ سيل اللاجئين نهايته
Dialogue: 10,0:15:05.23,0:15:06.94,Main,,0,0,0,,‫لا بد أنّهم آخرُ القادمين!
Dialogue: 10,0:15:08.79,0:15:09.83,Main,,0,0,0,,!إشارة دخانية
Dialogue: 10,0:15:10.56,0:15:12.73,Main,,0,0,0,,!إشارة دخانية من الداخل
Dialogue: 10,0:15:12.73,0:15:15.04,Main,,0,0,0,,!جيش تشين يقترب
Dialogue: 10,0:15:15.14,0:15:16.79,Main,,0,0,0,,!اقرعوا جرس هجوم العدو
Dialogue: 10,0:15:16.79,0:15:17.74,Main,,0,0,0,,!حسنٌ
Dialogue: 10,0:15:19.69,0:15:21.55,Main,,0,0,0,,!ثمّة ثلاثة إشاراتٍ دخانية
Dialogue: 10,0:15:22.41,0:15:24.96,Main,,0,0,0,,‫وصلوا إلى منطقة العاصمة الملكية إذن!
Dialogue: 10,0:15:25.32,0:15:26.94,Main,,0,0,0,,!جيش تشين اللعين
Dialogue: 10,0:15:27.60,0:15:28.76,Main,,0,0,0,,...لا بدَّ أنَّ تلك
Dialogue: 10,0:15:28.76,0:15:29.98,Main,,0,0,0,,!غيو
Dialogue: 10,0:15:30.85,0:15:35.14,Main,,0,0,0,,‫يبدو أنّنا أول الواصلين!
Dialogue: 10,0:15:35.14,0:15:36.58,Main,,0,0,0,,!إنّهم هنا
Dialogue: 10,0:15:36.58,0:15:39.13,Main,,0,0,0,,!تبًّا، صفهم طويل وكثيف
Dialogue: 10,0:15:39.13,0:15:42.23,Main,,0,0,0,,!لا داعي للذعر، مهما كان عددهم بالآلاف فهذا لا يغيّر شيئًا
Dialogue: 10,0:15:42.50,0:15:44.27,Main,,0,0,0,,!ادخلوا بسرعة
Dialogue: 10,0:15:44.84,0:15:48.90,Main,,0,0,0,,ستكون غيو الآن تحت الحصار كما توقعت
Dialogue: 10,0:15:49.36,0:15:51.15,Main,,0,0,0,,...ما لم أتوقعه
Dialogue: 10,0:15:51.62,0:15:55.59,Main,,0,0,0,,هو أنّها ستأوي لاجئين من تسع قلاع
Dialogue: 10,0:15:56.51,0:15:59.79,Main,,0,0,0,,...إ-إذن... هذه المعركة
Dialogue: 10,0:16:02.00,0:16:04.84,Main,,0,0,0,,،هل ستنفد مؤن جيش تشين أولًا
Dialogue: 10,0:16:05.40,0:16:08.60,Main,,0,0,0,,أم أنَّ اللاجئين سيأكلون الأخضر واليابس في غيو؟
Dialogue: 10,0:16:08.60,0:16:11.03,Main,,0,0,0,,‫إنّه سباقٌ أيُّنا ستفتكُ به المجاعةُ أولًا!
Dialogue: 10,0:16:14.33,0:16:16.67,Main,,0,0,0,,،إذن بينما يحاولون تجويعنا
Dialogue: 10,0:16:16.67,0:16:20.61,Main,,0,0,0,,سنستخدم شعبهم لتجويعهم
Dialogue: 10,0:16:20.73,0:16:23.72,Main,,0,0,0,,‫يا لكَ من مجنون يا أوسين!
Dialogue: 10,0:16:25.28,0:16:28.90,Main,,0,0,0,,تولَّ أمر غيو يا كانكي
Dialogue: 10,0:16:29.43,0:16:34.26,Main,,0,0,0,,الشيء الوحيد الّذي تجيده هو اختلاق الأعذار كالعادة يا ريبوكو
Dialogue: 10,0:16:34.26,0:16:36.24,Main,,0,0,0,,سأقبل أيّ عقاب
Dialogue: 10,0:16:36.49,0:16:39.50,Main,,0,0,0,,ولكن، الوضع الحالي يتطلب السرعة
Dialogue: 10,0:16:40.19,0:16:42.96,Main,,0,0,0,,…أريد تخصيص المائة ألف جندي من نخبة كانتان
Dialogue: 10,0:16:42.96,0:16:44.40,Main,,0,0,0,,لا
Dialogue: 10,0:16:44.46,0:16:47.69,Main,,0,0,0,,‫لن يبرحَ جيش كانتان هذه العاصمة...
Dialogue: 10,0:16:47.75,0:16:49.71,Main,,0,0,0,,ولا حتّى جندي واحد
Dialogue: 10,0:16:50.33,0:16:56.78,Main,,0,0,0,,ولكن إن سقطت غيو، فسيصل نصل تشين إلى كانتان في السنوات القليلة القادمة
Dialogue: 10,0:16:56.78,0:16:57.84,Main,,0,0,0,,!لا أهتم
Dialogue: 10,0:16:59.68,0:17:02.20,Main,,0,0,0,,لن تسقط كانتان
Dialogue: 10,0:17:02.20,0:17:07.06,Main,,0,0,0,,يمكنها الصمود في حصار لمدة عشر سنوات أو عشرين
Dialogue: 10,0:17:07.53,0:17:09.65,Main,,0,0,0,,لكنّها ستسقط في النهاية
Dialogue: 10,0:17:09.71,0:17:16.66,Main,,0,0,0,,أغلبُ الظنِّ ذلك، ولكن سيوافيني الأجلُ بسبب دائي هذا قبل ذلك الحين
Dialogue: 10,0:17:19.93,0:17:24.87,Main,,0,0,0,,ولا أهتم بما سيحدث للأمّةٍ أو شعبٍ بعد ذلك
Dialogue: 10,0:17:27.13,0:17:30.00,Main,,0,0,0,,!مظلم... بشكل لا يصدق
Dialogue: 10,0:17:30.26,0:17:32.50,Main,,0,0,0,,هل قلت شيئًا يا ريبوكو؟
Dialogue: 10,0:17:33.18,0:17:34.18,Main,,0,0,0,,لا
Dialogue: 10,0:17:34.18,0:17:39.59,Main,,0,0,0,,!إذن، اغرب عن وجهي وقم بعملك يا أيّها الموقر من العظماء الثلاثة
Dialogue: 10,0:17:45.39,0:17:49.31,Main,,0,0,0,,!إن خسرت غيو سأجعلك لحمًا مفرومًا يا ريبوكو
Dialogue: 10,0:17:49.31,0:17:54.07,Main,,0,0,0,,!أنتَ وكلّ فصيلك المتملق موتى
Dialogue: 10,0:17:54.07,0:17:55.32,Main,,0,0,0,,هل كلامي مفهوم؟
Dialogue: 10,0:17:55.32,0:17:57.17,Main,,0,0,0,,لنذهب يا كايني
Dialogue: 10,0:18:05.32,0:18:08.33,Main,,0,0,0,,ريبوكو-ساما... ملكنا
Dialogue: 10,0:18:10.80,0:18:14.88,Main,,0,0,0,,قيل إنَّ أعداء المملكة ليسوا سبب خرابها أبدًا
Dialogue: 10,0:18:16.26,0:18:18.80,Main,,0,0,0,,!حاكم أحمق سيدمر أمّته
Dialogue: 10,0:18:23.61,0:18:24.65,Main,,0,0,0,,!ولي العهد
Dialogue: 10,0:18:28.32,0:18:32.56,Main,,0,0,0,,ريبوكو، يا لسرعة عودتك من الغرب
Dialogue: 10,0:18:32.82,0:18:37.40,Main,,0,0,0,,لا على الإطلاق، سأبذل قصارى جهدي للقضاء على جيش تشين
Dialogue: 10,0:18:37.96,0:18:43.12,Main,,0,0,0,,أعلم أنَّ جيش كانتان لا يزال خاملًا رغم حالة الحرب
Dialogue: 10,0:18:43.12,0:18:47.96,Main,,0,0,0,,اسمح لي بالاعتذار نيابةً عن والدي لتسببه في مثل هذه الصعوبات لك يا ريبوكو
Dialogue: 10,0:18:48.07,0:18:49.93,Main,,0,0,0,,...يا صاحب الجلالة، كلامكَ هذا
Dialogue: 10,0:18:50.61,0:18:53.50,Main,,0,0,0,,إنّي مستعد لحمل السلاح في الخطوط الأمامية
Dialogue: 10,0:18:53.50,0:18:56.80,Main,,0,0,0,,لِأُلهِبَ حماس الجندِ إن تطلَّب الأمرُ ذلك
Dialogue: 10,0:18:56.80,0:18:59.82,Main,,0,0,0,,،لا أتوقع أن ينجح الأمر كما نجح مع ملك تشين في ساي
Dialogue: 10,0:18:59.82,0:19:02.06,Main,,0,0,0,,ولكن إن حان الوقت فلا تتردد في الطلب
Dialogue: 10,0:19:03.35,0:19:07.52,Main,,0,0,0,,مفهوم، لكن سأفعل كلّ ما بوسعي كي لا تكون هناك حاجة لذلك
Dialogue: 10,0:19:08.92,0:19:11.14,Main,,0,0,0,,هذه لحظة الحقيقة
Dialogue: 10,0:19:12.17,0:19:13.61,Main,,0,0,0,,أعلم
Dialogue: 10,0:19:15.02,0:19:17.76,Main,,0,0,0,,!أترك غيو بين يديك يا ريبوكو
Dialogue: 10,0:19:17.76,0:19:18.78,Main,,0,0,0,,!عُلم
Dialogue: 10,0:19:19.64,0:19:23.28,Main,,0,0,0,,...سأخرجنا من هذا، ما إن نخرج من هذا الظلام
Dialogue: 10,0:19:24.03,0:19:26.58,Main,,0,0,0,,،ما إن يحين وقت ولي العهد كا
Dialogue: 10,0:19:26.58,0:19:29.16,Main,,0,0,0,,سيشرق نور حقيقي على تشاو
Dialogue: 10,0:19:30.25,0:19:32.41,Main,,0,0,0,,هل اكتمل العدد؟
Dialogue: 10,0:19:32.41,0:19:33.09,Main,,0,0,0,,!أجل
Dialogue: 10,0:19:33.90,0:19:39.09,Main,,0,0,0,,سأشرح الحرب الوشيكة بأكملها في منطقة العاصمة الملكية
Dialogue: 10,0:19:40.09,0:19:42.30,Main,,0,0,0,,...الحرب الوشيكة
Dialogue: 10,0:19:42.66,0:19:43.80,Main,,0,0,0,,بأكملها؟
Dialogue: 10,0:19:44.29,0:19:48.81,Main,,0,0,0,,،قبل أن تنفد مؤن غيو وتُغزى
Dialogue: 10,0:19:48.81,0:19:53.76,Main,,0,0,0,,ستستدعي تشاو على الأرجح جيوشًا من جميع أنحاء منطقة العاصمة
Dialogue: 10,0:19:53.76,0:19:55.56,Main,,0,0,0,,للتجمع حول غيو وإنقاذها
Dialogue: 10,0:19:56.01,0:19:59.85,Main,,0,0,0,,،ولكن، قد تظنون أنّه لا يمكن الدفاع ضدّ ذلك
Dialogue: 10,0:19:59.85,0:20:04.70,Main,,0,0,0,,غير أنَّ قلّةً من الجيوش تملك القوّة لتحرير غيو بضربةٍ واحدة
Dialogue: 10,0:20:05.27,0:20:06.66,Main,,0,0,0,,اثنان فحسب في الواقع
Dialogue: 10,0:20:07.18,0:20:08.45,Main,,0,0,0,,اثنان؟
Dialogue: 10,0:20:08.89,0:20:13.13,Main,,0,0,0,,،جيش قلعة أتسويو الكبرى شمال غربي إقليم العاصمة
Dialogue: 10,0:20:13.79,0:20:19.46,Main,,0,0,0,,وجيش ريويو بالقوّة المشتركة لمنطقة جبال تايكو
Dialogue: 10,0:20:19.46,0:20:24.85,Main,,0,0,0,,إن أُرسلت هذه الجيوش إلى غيو فسينهار حصارنا بلا شك
Dialogue: 10,0:20:26.24,0:20:31.52,Main,,0,0,0,,إذن، علينا أن ننقسم ونعترض جيوش أتسويو وريويو
Dialogue: 10,0:20:32.45,0:20:33.89,Main,,0,0,0,,بالضبط
Dialogue: 10,0:20:34.16,0:20:39.48,Main,,0,0,0,,سيواصل جيش كانكي محاصرة غيو
Dialogue: 10,0:20:40.50,0:20:44.77,Main,,0,0,0,,وأيّ هجوم من الجيوش الأخرى باستثناء أتسويو وريويو
Dialogue: 10,0:20:44.77,0:20:48.24,Main,,0,0,0,,فستُواجهها بجيشكَ البالغ 60 ألفًا
Dialogue: 10,0:20:49.79,0:20:51.68,Main,,0,0,0,,سمعته يا مارون
Dialogue: 10,0:20:51.68,0:20:53.66,Main,,0,0,0,,ماذا تتوقع منّي أن أفعل؟
Dialogue: 10,0:20:54.19,0:20:58.43,Main,,0,0,0,,جيش يوتانوا يتعامل مع جيش ريويو بينما نتحدث
Dialogue: 10,0:20:58.93,0:21:03.33,Main,,0,0,0,,،إنّها مواجهة في الوقت الحالي، ولكن ما إن تصل تعزيزات ريويو
Dialogue: 10,0:21:03.33,0:21:05.63,Main,,0,0,0,,سيصبحون أكثر من 100 ألف جندي
Dialogue: 10,0:21:05.97,0:21:11.60,Main,,0,0,0,,لـ-لحظة، أليس جيش يوتانوا 50 ألفًا فقط؟
Dialogue: 10,0:21:11.60,0:21:14.53,Main,,0,0,0,,ولذلك سنرسل لها تعزيزاتنا الخاصة
Dialogue: 10,0:21:15.48,0:21:18.36,Main,,0,0,0,,أيّها الجنرال هيكي، خذ جنودك الثمانية آلاف
Dialogue: 10,0:21:18.76,0:21:22.37,Main,,0,0,0,,إضافة إلى ألفين من كانكي ليصبحوا عشرة آلاف
Dialogue: 10,0:21:22.37,0:21:24.68,Main,,0,0,0,,واذهب لدعم جيش يوتانوا
Dialogue: 10,0:21:25.74,0:21:29.95,Main,,0,0,0,,!أنا... أساعد يوتانوا-دونو؟
Dialogue: 10,0:21:32.09,0:21:35.29,Main,,0,0,0,,أقال للتوّ أنّه سيأخذ ألفي رجلٍ بكلّ بساطة؟
Dialogue: 10,0:21:35.59,0:21:38.42,Main,,0,0,0,,،أمّا بالنسبة لأتسويو
Dialogue: 10,0:21:38.89,0:21:41.01,Main,,0,0,0,,،سنرسل الـ70 ألفًا من جنودي
Dialogue: 10,0:21:41.01,0:21:43.75,Main,,0,0,0,,،إضافة إلى خمسة آلاف من وحدة غيوكوهو
Dialogue: 10,0:21:44.51,0:21:46.13,Main,,0,0,0,,،خمسة آلاف من وحدة غاكوكا
Dialogue: 10,0:21:46.68,0:21:48.73,Main,,0,0,0,,وثمانية آلاف من وحدة هي شين
Dialogue: 10,0:21:49.30,0:21:51.49,Main,,0,0,0,,إجمالي الوحدات الثلاث
Dialogue: 10,0:21:51.49,0:21:55.06,Main,,0,0,0,,!ستتقدم شمالًا لاعتراضهم بـ88 ألف جندي
Dialogue: 10,0:21:57.73,0:22:02.83,Main,,0,0,0,,ولكن إرسال 60 ألفًا لريويو و88 ألفًا لأتسويو
Dialogue: 10,0:22:02.83,0:22:04.94,Main,,0,0,0,,ألا ترى أن هناك خللًا في التوازن؟
Dialogue: 10,0:22:04.94,0:22:07.59,Main,,0,0,0,,أتسويو هي هدفنا الرئيسي
Dialogue: 10,0:22:08.62,0:22:09.70,Main,,0,0,0,,هدفنا الرئيسي؟
Dialogue: 10,0:22:10.00,0:22:14.92,Main,,0,0,0,,أجل، إنّه الجيش الّذي سينضم إليه ريبوكو لمهاجمتنا حتمًا
Dialogue: 10,0:22:16.25,0:22:20.83,Main,,0,0,0,,جيش تشين ينقسم إلى قسمين لاعتراض ريويو وأتسويو؟
Dialogue: 10,0:22:21.40,0:22:23.96,Main,,0,0,0,,إنّهم يتوقعون تحركاتنا التالية
Dialogue: 10,0:22:24.38,0:22:25.61,Main,,0,0,0,,شونسويجو؟
Dialogue: 10,0:22:25.61,0:22:26.24,Main,,0,0,0,,نعم
Dialogue: 10,0:22:27.53,0:22:31.05,Main,,0,0,0,,انضم إلى جيش ريويو كجنرال لهم وتولَّ القيادة
Dialogue: 10,0:22:31.43,0:22:32.44,Main,,0,0,0,,عُلم
Dialogue: 10,0:22:32.44,0:22:35.85,Main,,0,0,0,,سيكون كوسونريو ملازمًا كفؤًا
Dialogue: 10,0:22:35.85,0:22:40.61,Main,,0,0,0,,نسّق مع حاكم ريويو غريب الطباع بينما توجه قواتهم
Dialogue: 10,0:22:40.61,0:22:41.31,Main,,0,0,0,,عُلم
Dialogue: 10,0:22:41.71,0:22:43.82,Main,,0,0,0,,سيقود 100 ألف جندي؟
Dialogue: 10,0:22:44.40,0:22:49.95,Main,,0,0,0,,‫بالرغم من أنّه شبهُ مغمورٍ إلّا أنَّ ريبوكو-ساما يوليه ثقةً عمياء!
Dialogue: 10,0:22:49.95,0:22:54.55,Main,,0,0,0,,،ما البقية سيرافقونني إليّ في جيش أتسويو المتجه جنوبًا
Dialogue: 10,0:22:54.55,0:22:56.87,Main,,0,0,0,,حيث ستقاتلون بينهم كضباط
Dialogue: 10,0:22:57.98,0:23:01.63,Main,,0,0,0,,مهلًا، ألسنا نكدّس الأقوياء في جانبنا أكثر من اللازم؟
Dialogue: 10,0:23:02.21,0:23:06.25,Main,,0,0,0,,سيعزّز أوسين قوّته العسكريّة ضدّ أتسويو حتمًا
Dialogue: 10,0:23:07.46,0:23:08.67,Main,,0,0,0,,،ابتداءً من هذه اللحظة
Dialogue: 10,0:23:08.67,0:23:12.62,Main,,0,0,0,,مآلُ هذه معركة هو صدامٌ سيُحسمُ بالبطشِ والقوّة
Dialogue: 10,0:24:49.24,0:24:52.72,Narrator,,0,0,0,,"في الحلقة القادمة من المملكة: "بدء المعركة
