Dialogue: 0,0:00:01.28,0:00:02.21,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:03.02,0:02:04.09,Main,,0,0,0,,ماذا قلت؟
Dialogue: 0,0:02:05.32,0:02:09.15,Main,,0,0,0,,أتعني أنَّ قوّات حدود بورتميري قد هُزمتْ؟
Dialogue: 0,0:02:09.32,0:02:13.26,Main,,0,0,0,,أجل، بلغني أنّها أُبيدتْ بالكامل تقريبًا
Dialogue: 0,0:02:13.71,0:02:15.26,Main,,0,0,0,,أقُتل تاناس أيضًا؟
Dialogue: 0,0:02:15.33,0:02:18.36,Main,,0,0,0,,كلّا، يبدو أنَّ تاناس-ساما قد نجا
Dialogue: 0,0:02:18.73,0:02:20.20,Main,,0,0,0,,سحقًا لكَ يا تاناس
Dialogue: 0,0:02:20.54,0:02:24.37,Main,,0,0,0,,!كيف يجرؤ على العودة حيًّا بعد أن عجز عن قتل فتاةٍ صغيرةٍ حتّى
Dialogue: 0,0:02:25.05,0:02:28.48,Main,,0,0,0,,!علينا استدعاء هذا الحثالة إلى العاصمة وإعدامه
Dialogue: 0,0:02:28.74,0:02:30.25,Main,,0,0,0,,!أرسلوا الجنود لإحضاره في الحال
Dialogue: 0,0:02:30.81,0:02:32.30,Main,,0,0,0,,ما الّذي تفعله الكنيسة؟
Dialogue: 0,0:02:32.98,0:02:35.64,Main,,0,0,0,,،ما دامتْ ابنة الإمبراطور السابق على قيد الحياة
Dialogue: 0,0:02:35.64,0:02:37.88,Main,,0,0,0,,فستبقى مكانتي متزعزعةً
Dialogue: 0,0:02:38.22,0:02:40.43,Main,,0,0,0,,هل تلاعبوا بي طوال هذا الوقت عبثًا؟
Dialogue: 0,0:02:40.56,0:02:43.18,Main,,0,0,0,,لن أتساهل معهم إن أفلتتْ ميل
Dialogue: 0,0:02:43.66,0:02:44.48,Main,,0,0,0,,!أيّها الإمبراطور
Dialogue: 0,0:02:44.58,0:02:46.06,Main,,0,0,0,,!اهدأ رجاءً
Dialogue: 0,0:02:46.40,0:02:48.97,Main,,0,0,0,,!هذا يُخالف ما اتّفقنا عليه
Dialogue: 0,0:02:49.39,0:02:50.58,Main,,0,0,0,,!جاينا
Dialogue: 0,0:02:51.16,0:02:52.02,Main,,0,0,0,,الإمبراطور
Dialogue: 0,0:03:02.01,0:03:07.54,Main,,0,0,0,,يا له من أحمق، يبدو خائفًا للغاية
Dialogue: 0,0:03:09.25,0:03:11.55,Main,,0,0,0,,لا داعي للعجلة
Dialogue: 0,0:03:12.03,0:03:14.65,Main,,0,0,0,,شرع غوجاس في خطوته التالية بالفعل
Dialogue: 0,0:03:16.03,0:03:20.46,Main,,0,0,0,,هل استدعى درع الشيطان أخيرًا؟
Dialogue: 0,0:03:20.53,0:03:23.89,Main,,0,0,0,,غدتْ حياة ميز في مهبّ الريح
Dialogue: 0,0:03:37.03,0:03:39.34,Main,,0,0,0,,!الانفجار النهائيّ للغضب
Dialogue: 0,0:03:48.89,0:03:51.89,Main,,0,0,0,,!احترقي، احترقي وتحوّلي إلى رمادٍ
Dialogue: 0,0:03:56.47,0:03:57.38,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:03:57.73,0:04:00.50,Main,,0,0,0,,!توقّف، انتهتْ المعركة بالفعل
Dialogue: 0,0:04:00.90,0:04:02.64,Main,,0,0,0,,!لم تنتهِ بعد
Dialogue: 0,0:04:02.88,0:04:06.92,Main,,0,0,0,,لن تنتهي حتّى أُحيل كلّ من يُؤذي ميل إلى رمادٍ
Dialogue: 0,0:04:07.63,0:04:10.26,Main,,0,0,0,,!كما عهدتك يا أونيه-ني-ساما، أحبّك
Dialogue: 0,0:04:10.40,0:04:14.72,Main,,0,0,0,,!كلّا... ذلك ليس أنا يا ميل-تشان
Dialogue: 0,0:04:15.48,0:04:16.61,Main,,0,0,0,,...حقيقتي هي
Dialogue: 0,0:04:17.06,0:04:18.34,Main,,0,0,0,,...حقيقتي هي
Dialogue: 0,0:04:20.78,0:04:21.98,Main,,0,0,0,,...حقيقتي هي
Dialogue: 0,0:04:22.81,0:04:23.64,Main,,0,0,0,,من؟
Dialogue: 0,0:04:26.73,0:04:28.53,Main,,0,0,0,,من أنت؟
Dialogue: 0,0:04:40.28,0:04:41.10,Main,,0,0,0,,أين أنا؟
Dialogue: 0,0:04:44.85,0:04:45.78,Main,,0,0,0,,حلمٌ؟
Dialogue: 0,0:04:48.72,0:04:51.31,Main,,0,0,0,,فهمت، غفوتُ إذن
Dialogue: 0,0:04:53.46,0:04:56.43,Main,,0,0,0,,ويحي، ما كان يجدر بي النوم في هذا الوقت
Dialogue: 0,0:04:56.54,0:04:58.64,Main,,0,0,0,,...عليَّ أن أبقى نشيطةً في النهار
Dialogue: 0,0:04:58.74,0:05:00.96,Main,,0,0,0,,كي لا أغطَّ في نوم ليلًا
Dialogue: 0,0:05:03.52,0:05:06.33,Main,,0,0,0,,سيظهر ذلك الوغد ليلًا على هذا الحال
Dialogue: 0,0:05:09.14,0:05:12.84,Main,,0,0,0,,يبدو أنَّ أستر-سان وسوليود-سان لم يعودا من البحث عن الطعام بعد
Dialogue: 0,0:05:13.34,0:05:16.09,Main,,0,0,0,,ينتابني شعورٌ بالخطر في حضرتهما
Dialogue: 0,0:05:23.07,0:05:25.78,Main,,0,0,0,,،مُنذ أن انضمّ إلينا أستر-سان وسوليود-سان
Dialogue: 0,0:05:26.11,0:05:29.24,Main,,0,0,0,,غدتْ رحلتنا أشبه بنزهةٍ مُملّة
Dialogue: 0,0:05:30.19,0:05:34.41,Main,,0,0,0,,أردتُ الاقتراب من بيستال قدر الإمكان قبل مغيب الشمس
Dialogue: 0,0:05:34.51,0:05:39.25,Main,,0,0,0,,إذن، لِمَ لا تتّجهين جنوبًا عبر الدرب الجبليّ المحاذي للهاوية؟
Dialogue: 0,0:05:39.58,0:05:43.19,Main,,0,0,0,,عبور جبال روديوناري هو الطريق الأقصر حتمًا
Dialogue: 0,0:05:43.57,0:05:45.10,Main,,0,0,0,,فهمت، شكرًا
Dialogue: 0,0:05:48.01,0:05:49.34,Main,,0,0,0,,من هناك؟ أين أنتِ؟
Dialogue: 0,0:05:49.54,0:05:50.64,Main,,0,0,0,,هنا
Dialogue: 0,0:05:51.70,0:05:53.94,Main,,0,0,0,,أُدعى راندي
Dialogue: 0,0:05:54.11,0:05:56.54,Main,,0,0,0,,!تغمرني السعادة بلقائكِ يا ميز-سان
Dialogue: 0,0:05:58.85,0:06:01.64,Main,,0,0,0,,ألا زلتُ أحلم يا ترى؟
Dialogue: 0,0:06:01.74,0:06:03.76,Main,,0,0,0,,ليس حلمًا
Dialogue: 0,0:06:03.96,0:06:06.27,Main,,0,0,0,,أيعقل أنّكِ جنيّة؟
Dialogue: 0,0:06:06.59,0:06:07.52,Main,,0,0,0,,أجل
Dialogue: 0,0:06:08.89,0:06:14.01,Main,,0,0,0,,بالنظر إلى كلّ ما رأيته حتّى الآن، فلا عجب في وجود جنيّة
Dialogue: 0,0:06:14.12,0:06:17.74,Main,,0,0,0,,مرافقتكِ في هذه الرحلة أشبه بحلمٍ جميلٍ
Dialogue: 0,0:06:17.97,0:06:21.78,Main,,0,0,0,,سأتولّى إرشادكِ ورفاقكِ بدءًا من الآن
Dialogue: 0,0:06:21.98,0:06:23.17,Main,,0,0,0,,إرشادنا؟
Dialogue: 0,0:06:23.66,0:06:26.96,Main,,0,0,0,,فهمت، أنتِ في طريقكِ إلى بيستال أيضًا إذن
Dialogue: 0,0:06:28.28,0:06:30.34,Main,,0,0,0,,ليس كذلك تحديدًا
Dialogue: 0,0:06:30.42,0:06:33.33,Main,,0,0,0,,!جئتُ لرؤيتكِ خصّيصًا يا ميز-سان
Dialogue: 0,0:06:33.33,0:06:35.16,Main,,0,0,0,,لرؤيتي؟ لماذا؟
Dialogue: 0,0:06:35.22,0:06:36.85,Main,,0,0,0,,لديَّ أسبابي الخاصة
Dialogue: 0,0:06:40.54,0:06:42.99,Main,,0,0,0,,!احذري يا ميل-تشان، استيقظي
Dialogue: 0,0:06:43.17,0:06:46.03,Main,,0,0,0,,!كلّا! أعِدْ ذلك
Dialogue: 0,0:06:55.80,0:06:59.64,Main,,0,0,0,,تخلو غابة بانون من أيّ طريدةٍ تُذكر
Dialogue: 0,0:07:03.42,0:07:05.28,Main,,0,0,0,,أشعر ببرودةٍ تعصف بي
Dialogue: 0,0:07:05.47,0:07:08.17,Main,,0,0,0,,ما هذا يا ميز؟
Dialogue: 0,0:07:08.42,0:07:10.25,Main,,0,0,0,,لا بُدَّ أنّكما تابعاها
Dialogue: 0,0:07:10.41,0:07:12.75,Main,,0,0,0,,أُدعى راندي، سررتُ بلقائكما
Dialogue: 0,0:07:13.06,0:07:14.53,Main,,0,0,0,,تابعاها؟
Dialogue: 0,0:07:14.78,0:07:17.36,Main,,0,0,0,,!إيّاكِ والتقرّب من أونيه-ساما
Dialogue: 0,0:07:18.05,0:07:20.03,Main,,0,0,0,,...هذا
Dialogue: 0,0:07:20.51,0:07:23.03,Main,,0,0,0,,ماذا؟ كانت هذه تخصّكِ إذن يا ميز
Dialogue: 0,0:07:23.11,0:07:27.44,Main,,0,0,0,,إنّها ليّنةٌ جدًّا لتكون دروعًا، أليستْ بلا طائلٍ؟
Dialogue: 0,0:07:30.11,0:07:31.77,Main,,0,0,0,,إنّه الطقم الوحيد الّذي أملكه
Dialogue: 0,0:07:43.36,0:07:47.65,Main,,0,0,0,,بدءًا من الآن، سأتبع ميز-سان أينما ذهبتْ
Dialogue: 0,0:07:48.46,0:07:51.83,Main,,0,0,0,,على أيّ حالٍ، ستكونين عونًا كبيرًا لنا يا راندي
Dialogue: 0,0:07:52.02,0:07:55.73,Main,,0,0,0,,سئمتُ من خوض المعارك ضدّ مطاردينا طوال الرحلة
Dialogue: 0,0:07:56.57,0:08:01.12,Main,,0,0,0,,لكنَّ المطاردين لن يقفوا عائقًا أمام شخصٍ بقوّتكِ
Dialogue: 0,0:08:02.21,0:08:04.38,Main,,0,0,0,,رأيتُ قتالكِ ضدّ قوّات الحدود
Dialogue: 0,0:08:04.43,0:08:07.81,Main,,0,0,0,,!كنتِ مذهلةً، مذهلةً للغاية يا ميز-سان
Dialogue: 0,0:08:07.88,0:08:08.73,Main,,0,0,0,,لا على الإطلاق
Dialogue: 0,0:08:09.15,0:08:13.09,Main,,0,0,0,,لم أتوقّع أن يكون درع الروم الأسطوريّ بهذه القوّة قطّ
Dialogue: 0,0:08:13.28,0:08:17.60,Main,,0,0,0,,هذا يُثبت أنّكِ مُستخدمة أطوارٍ من الطراز الرفيع حقًّا
Dialogue: 0,0:08:17.76,0:08:20.26,Main,,0,0,0,,توقّفي عن هذا رجاءً يا راندي
Dialogue: 0,0:08:20.42,0:08:24.89,Main,,0,0,0,,!يسعكِ سحق أيّ درع ديمي بضربةٍ واحدةٍ
Dialogue: 0,0:08:24.97,0:08:27.23,Main,,0,0,0,,!أنتِ الأقوى على الإطلاق بلا ريب
Dialogue: 0,0:08:27.30,0:08:28.18,Main,,0,0,0,,!قلتُ توقّفي
Dialogue: 0,0:08:30.61,0:08:32.61,Main,,0,0,0,,وما النفعُ من كوني قويّةً؟
Dialogue: 0,0:08:33.02,0:08:36.37,Main,,0,0,0,,!لا أطيق رؤية البشر يقتلون بعضهم بعضًا بعد الآن
Dialogue: 0,0:08:36.61,0:08:37.74,Main,,0,0,0,,...ميز-سان
Dialogue: 0,0:08:38.12,0:08:42.33,Main,,0,0,0,,!أريد إيصال ميل-تشان إلى بيستال بسلامٍ دون أيّ مشاكلٍ أخرى
Dialogue: 0,0:08:42.62,0:08:44.11,Main,,0,0,0,,!أرجو أن تتفهّمي ذلك
Dialogue: 0,0:08:44.72,0:08:46.38,Main,,0,0,0,,آسفة
Dialogue: 0,0:08:46.54,0:08:48.91,Main,,0,0,0,,يا إلهي، ها قد بدأتْ مجدّدًا
Dialogue: 0,0:08:48.99,0:08:51.33,Main,,0,0,0,,إلى أيّ حدٍّ يمكنها أن تكون طيّبةً؟
Dialogue: 0,0:08:51.53,0:08:54.22,Main,,0,0,0,,أظنّ أنَّ هذا جزءٌ من سحرها
Dialogue: 0,0:08:54.45,0:08:55.10,Main,,0,0,0,,أتّفق معكِ
Dialogue: 0,0:09:02.30,0:09:05.10,Main,,0,0,0,,لكنّي أتحوّل إلى شخصٍ آخر ليلًا
Dialogue: 0,0:09:05.47,0:09:09.74,Main,,0,0,0,,نصفي الآخر الّذي يستمتع بالقتال
Dialogue: 0,0:09:13.18,0:09:16.28,Main,,0,0,0,,لا أريد القتال
Dialogue: 0,0:09:20.33,0:09:23.79,Main,,0,0,0,,!لِمَ تفعلون هذا بي؟
Dialogue: 0,0:09:24.29,0:09:26.21,Main,,0,0,0,,تبًّا، هل تُصغون إليّ؟
Dialogue: 0,0:09:26.70,0:09:29.33,Main,,0,0,0,,ألا أستحقُّ استقبالًا أليق من هذا؟
Dialogue: 0,0:09:29.53,0:09:31.25,Main,,0,0,0,,!فُكّوا هذه الحبال اللعينة عنّي
Dialogue: 0,0:09:31.47,0:09:33.55,Main,,0,0,0,,!أطلقوا سراحي في الحال
Dialogue: 0,0:09:33.62,0:09:37.92,Main,,0,0,0,,توقّعتُ حدوث هذا، يا له من ثرثارٍ مُزعج
Dialogue: 0,0:09:38.04,0:09:41.10,Main,,0,0,0,,نحن نراقبكَ كي لا تفتعل أيّ مشاكل
Dialogue: 0,0:09:41.38,0:09:43.66,Main,,0,0,0,,فقد طلبتْ منّا ميز الفتاة ذلك
Dialogue: 0,0:09:43.88,0:09:45.98,Main,,0,0,0,,لا تأخذ الأمر بمحملٍ شخصيٍّ
Dialogue: 0,0:09:46.56,0:09:48.37,Main,,0,0,0,,!سحقًا لكم
Dialogue: 0,0:09:48.81,0:09:50.44,Main,,0,0,0,,!يا لها من قوّةٍ هائلة
Dialogue: 0,0:09:51.16,0:09:52.90,Main,,0,0,0,,يا لها من إرادةٍ صلبة
Dialogue: 0,0:09:53.69,0:09:54.89,Main,,0,0,0,,فهمت
Dialogue: 0,0:09:54.99,0:10:00.02,Main,,0,0,0,,يتشاركان الطور ذاته، لكنَّ ميز الفتاة تجهل كيفيّة استخدامه بالشكل الصحيح
Dialogue: 0,0:10:01.48,0:10:03.26,Main,,0,0,0,,!أنتَ مقزّزٌ
Dialogue: 0,0:10:03.26,0:10:04.69,Main,,0,0,0,,!امسحي تلك الابتسامة عن وجهكِ
Dialogue: 0,0:10:04.94,0:10:07.33,Main,,0,0,0,,!لستُ راضيًا إطلاقًا
Dialogue: 0,0:10:08.54,0:10:10.60,Main,,0,0,0,,مسكينٌ يا أونيه-ني-ساما
Dialogue: 0,0:10:11.01,0:10:12.99,Main,,0,0,0,,!أجل، مسكين
Dialogue: 0,0:10:13.41,0:10:20.40,Main,,0,0,0,,ميل، أنتِ وحدكِ تدركين كيف سلبوني حريّتي بلا سببٍ وجيه
Dialogue: 0,0:10:22.98,0:10:25.39,Main,,0,0,0,,...بعد أن التقيتكِ مجدّدًا، نويتُ أن
Dialogue: 0,0:10:26.39,0:10:27.36,Main,,0,0,0,,نويتَ ماذا؟
Dialogue: 0,0:10:27.56,0:10:33.80,Main,,0,0,0,,نويتُ معانقتكِ، وضمّكِ إلى صدري بحرارة
Dialogue: 0,0:10:34.13,0:10:36.02,Main,,0,0,0,,تـ-تعانقني؟
Dialogue: 0,0:10:38.40,0:10:41.12,Main,,0,0,0,,لكن بات هذا مستحيلًا الآن
Dialogue: 0,0:10:41.55,0:10:47.01,Main,,0,0,0,,متى سأحظى بليلةٍ شاعريّةٍ برفقتكِ يا ميل؟
Dialogue: 0,0:10:47.44,0:10:50.64,Main,,0,0,0,,ليلة شاعريّة؟
Dialogue: 0,0:10:54.35,0:10:55.38,Main,,0,0,0,,...ميل
Dialogue: 0,0:10:55.93,0:10:57.34,Main,,0,0,0,,...أونيه-ني-ساما
Dialogue: 0,0:10:58.09,0:11:00.11,Main,,0,0,0,,!عانقني
Dialogue: 0,0:11:01.36,0:11:05.74,Main,,0,0,0,,تريّث يا أونيه-ني-ساما، ستطلق ميلي سراحكَ في الحال
Dialogue: 0,0:11:07.69,0:11:11.06,Main,,0,0,0,,يا إلهي، علينا تقييد الأميرة الآن أيضًا
Dialogue: 0,0:11:12.91,0:11:15.10,Main,,0,0,0,,!ما الّذي تفعلانه بها؟
Dialogue: 0,0:11:15.31,0:11:18.05,Main,,0,0,0,,أتستمتعان بإفساد علاقات الآخرين العاطفيّة؟
Dialogue: 0,0:11:18.35,0:11:19.52,Main,,0,0,0,,!على النقيض تمامًا
Dialogue: 0,0:11:19.94,0:11:24.04,Main,,0,0,0,,إن أطلقنا سراحكَ، فستمقتنا ميز الفتاة
Dialogue: 0,0:11:24.28,0:11:27.08,Main,,0,0,0,,لذا كُنْ مطيعًا والزم الهدوء
Dialogue: 0,0:11:27.94,0:11:30.03,Main,,0,0,0,,علاقات البشر معقّدةٌ بحقّ
Dialogue: 0,0:11:30.88,0:11:32.03,Main,,0,0,0,,افعلوا ما يحلو لكم
Dialogue: 0,0:11:32.14,0:11:35.89,Main,,0,0,0,,إن تعرّضنا لهجومٍ الآن، فلا تتوقّعوا منّي إنقاذكم
Dialogue: 0,0:11:36.70,0:11:40.42,Main,,0,0,0,,لسوء حظّكَ، نحن صائدا ديمي ماهران للغاية
Dialogue: 0,0:11:40.50,0:11:42.57,Main,,0,0,0,,لا نضاهي دولغر قوّةً بالطبع
Dialogue: 0,0:11:42.78,0:11:45.82,Main,,0,0,0,,لكن يسعنا الإطاحة بأيِّ درع اصطناعيّ عاديّ
Dialogue: 0,0:11:47.20,0:11:48.90,Main,,0,0,0,,لنرَ إن كنتما محقّين إذن
Dialogue: 0,0:11:49.20,0:11:50.81,Main,,0,0,0,,حان الوقت لتُثبتوا جدارتكم
Dialogue: 0,0:11:50.91,0:11:51.53,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:12:00.48,0:12:02.35,Main,,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:12:07.14,0:12:09.10,Main,,0,0,0,,عثرتُ عليكَ يا ميز
Dialogue: 0,0:12:09.46,0:12:12.19,Main,,0,0,0,,سأُرسلكَ إلى ظلمات الموت الجميلة
Dialogue: 0,0:12:14.13,0:12:15.84,Main,,0,0,0,,!كلّا
Dialogue: 0,0:12:23.34,0:12:24.00,Main,,0,0,0,,...ما هذا
Dialogue: 0,0:12:24.31,0:12:25.70,Main,,0,0,0,,!إنّه أنديدر
Dialogue: 0,0:12:26.06,0:12:27.17,Main,,0,0,0,,أنديدر؟
Dialogue: 0,0:12:46.34,0:12:47.79,Main,,0,0,0,,!إنّه أنديدر
Dialogue: 0,0:12:48.06,0:12:49.31,Main,,0,0,0,,أنديدر؟
Dialogue: 0,0:12:49.47,0:12:50.73,Main,,0,0,0,,ما هذا الشيء؟
Dialogue: 0,0:12:50.80,0:12:54.02,Main,,0,0,0,,...عادةً ما يستخدم درع الديمي رابطًا ديميًّا
Dialogue: 0,0:12:54.02,0:12:58.38,Main,,0,0,0,,لدمج روحه بروح الفارس الّذي يقوده
Dialogue: 0,0:13:01.38,0:13:07.60,Main,,0,0,0,,لكن في حالاتٍ نادرةٍ، تكون روح درع الديمي قويّةً لدرجةٍ تمكّنها من ابتلاع روح مُستخدمها
Dialogue: 0,0:13:07.60,0:13:11.41,Main,,0,0,0,,وحينها يتحوّل إلى كائنٍ مختلفٍ تمامًا
Dialogue: 0,0:13:11.61,0:13:13.17,Main,,0,0,0,,وهذا الأنديدر
Dialogue: 0,0:13:15.62,0:13:16.82,Main,,0,0,0,,!هذا صحيح
Dialogue: 0,0:13:16.89,0:13:21.12,Main,,0,0,0,,وبصفته كائنًا كهذا، فالأنديدر خالدٌ لا يموت
Dialogue: 0,0:13:21.26,0:13:25.41,Main,,0,0,0,,أباد غورد هذا الحرس الملكيّ بمفرده
Dialogue: 0,0:13:25.84,0:13:29.47,Main,,0,0,0,,لن تحظى حشراتٌ أمثالكم بأيّ فرصةٍ ضدّه
Dialogue: 0,0:13:29.91,0:13:32.00,Main,,0,0,0,,...هذا الصوت
Dialogue: 0,0:13:32.45,0:13:33.37,Main,,0,0,0,,ما الخطب يا راندي؟
Dialogue: 0,0:13:33.44,0:13:37.88,Main,,0,0,0,,يحتاج الأنديدر إلى نوعٍ خاصٍّ من الأطوار للتحكّم به
Dialogue: 0,0:13:37.95,0:13:44.10,Main,,0,0,0,,على الأرجح أنَّ من يتحكّم به هو القائد الأعلى لجاينا؛ غوجاس
Dialogue: 0,0:13:46.92,0:13:49.06,Main,,0,0,0,,!غوجاس أو أيًّا كان
Dialogue: 0,0:13:49.17,0:13:51.20,Main,,0,0,0,,!لن أسمح لأحدٍ بالسخرية منّي
Dialogue: 0,0:13:51.32,0:13:52.81,Main,,0,0,0,,!ميل، استدعي دولغر
Dialogue: 0,0:13:52.93,0:13:54.10,Main,,0,0,0,,!حـ-حاضر
Dialogue: 0,0:13:56.00,0:14:00.51,Main,,0,0,0,,!رورو، فارنا، هاي، فامون، را، فو
Dialogue: 0,0:14:08.71,0:14:11.53,Main,,0,0,0,,!سأسحقكَ بضربةٍ واحدةٍ
Dialogue: 0,0:14:20.96,0:14:22.95,Main,,0,0,0,,لن يكون الأمر بهذه السهولة
Dialogue: 0,0:14:23.02,0:14:24.42,Main,,0,0,0,,قاوموا ببشاعة
Dialogue: 0,0:14:24.54,0:14:29.26,Main,,0,0,0,,!أمتعني حتّى أكتفي يا دولغر، فأنا خصمكَ الفاتن
Dialogue: 0,0:14:38.32,0:14:39.03,Main,,0,0,0,,!تبًّا
Dialogue: 0,0:14:39.08,0:14:42.71,Main,,0,0,0,,هذا مثيرٌ للشفقة، تبجّحنا بقوّتنا والآن نفرُّ هاربين
Dialogue: 0,0:14:43.13,0:14:45.95,Main,,0,0,0,,لا نملك أيّ فرصةٍ ضدّ الأنديدر
Dialogue: 0,0:14:46.14,0:14:48.73,Main,,0,0,0,,!ابذل قصارى جهدكَ يا ميز-سان
Dialogue: 0,0:14:55.92,0:14:58.72,Main,,0,0,0,,سحقًا، ألا يسعكِ فعل شيءٍ يا ميل؟
Dialogue: 0,0:14:58.80,0:15:02.86,Main,,0,0,0,,يبدو أنَّ هجمات دولغر لا تُجدي نفعًا ضدّ غورد
Dialogue: 0,0:15:02.93,0:15:03.83,Main,,0,0,0,,!ماذا؟
Dialogue: 0,0:15:04.18,0:15:06.79,Main,,0,0,0,,،ليس لامتلاكه القدرة على التحكّم بالأنديدر فحسب
Dialogue: 0,0:15:06.84,0:15:09.16,Main,,0,0,0,,بل لأنَّ هذا الفولنار يملك طورًا قويًّا أيضًا
Dialogue: 0,0:15:09.19,0:15:11.63,Main,,0,0,0,,!إيّاكِ ومدح رجلٍ آخر
Dialogue: 0,0:15:12.73,0:15:14.59,Main,,0,0,0,,آسفةٌ يا أونيه-ني-ساما
Dialogue: 0,0:15:14.84,0:15:16.09,Main,,0,0,0,,!مثيرٌ للشفقة
Dialogue: 0,0:15:16.41,0:15:20.03,Main,,0,0,0,,في النهاية، لستم ندًّا لجمالي
Dialogue: 0,0:15:20.35,0:15:23.35,Main,,0,0,0,,ستلقون حتفكم ببشاعةٍ أمام جمالي الآسر
Dialogue: 0,0:15:25.08,0:15:28.21,Main,,0,0,0,,!سحقًا، بدأ الغضب يتملّكني
Dialogue: 0,0:15:28.49,0:15:30.41,Main,,0,0,0,,!سحقًا لكَ أيّها الوغد
Dialogue: 0,0:15:30.82,0:15:32.75,Main,,0,0,0,,أونيه-ني-ساما، لا تغضب
Dialogue: 0,0:15:33.03,0:15:35.39,Main,,0,0,0,,آسفة، كلّ هذا خطأي
Dialogue: 0,0:15:35.46,0:15:36.61,Main,,0,0,0,,!هذا يكفي
Dialogue: 0,0:15:36.62,0:15:38.60,Main,,0,0,0,,!كلّ هذا بسبب ذلك الوغد الماكر
Dialogue: 0,0:15:38.67,0:15:41.31,Main,,0,0,0,,!ذلك الأبله والمغفّل والمنحرف
Dialogue: 0,0:15:41.37,0:15:44.80,Main,,0,0,0,,!آسفة، لا تمقتني رجاءً
Dialogue: 0,0:15:44.91,0:15:47.34,Main,,0,0,0,,!لا يسعني العيش بدونكَ يا أونيه-ني-ساما
Dialogue: 0,0:15:47.34,0:15:49.22,Main,,0,0,0,,!أيّها الوغد الحقير
Dialogue: 0,0:15:49.22,0:15:50.05,Main,,0,0,0,,!سحقًا لكَ
Dialogue: 0,0:15:50.32,0:15:52.77,Main,,0,0,0,,!سأفعل أيّ شيءٍ من أجلكَ
Dialogue: 0,0:15:52.90,0:15:55.17,Main,,0,0,0,,!إن أخطأتُ، يسعكَ معاقبتي
Dialogue: 0,0:15:55.88,0:15:56.94,Main,,0,0,0,,!تبًّا
Dialogue: 0,0:15:57.12,0:15:59.96,Main,,0,0,0,,!مُتْ، مُتْ، مُتْ، مُتْ، مُتْ
Dialogue: 0,0:16:00.14,0:16:02.44,Main,,0,0,0,,!سأُبرحكَ ضربًا
Dialogue: 0,0:16:03.49,0:16:04.59,Main,,0,0,0,,!سأموت، سأموت، سأموت
Dialogue: 0,0:16:04.59,0:16:07.30,Main,,0,0,0,,!سأموت، سأموت
Dialogue: 0,0:16:07.46,0:16:09.05,Main,,0,0,0,,!كلّا
Dialogue: 0,0:16:09.69,0:16:10.82,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:16:12.06,0:16:13.18,Main,,0,0,0,,ماها فايغر؟
Dialogue: 0,0:16:13.55,0:16:14.24,Main,,0,0,0,,!مُحال
Dialogue: 0,0:16:14.51,0:16:16.11,Main,,0,0,0,,!اذهب إلى الجحيم
Dialogue: 0,0:16:17.14,0:16:21.27,Main,,0,0,0,,هـ-هذا سيئ، أأشعر بالخوف؟
Dialogue: 0,0:16:21.66,0:16:23.34,Main,,0,0,0,,!لن أقرَّ بذلك
Dialogue: 0,0:16:24.38,0:16:25.40,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:16:25.48,0:16:26.70,Main,,0,0,0,,!نلتُ منك
Dialogue: 0,0:16:28.98,0:16:29.56,Main,,0,0,0,,أنجح؟
Dialogue: 0,0:16:30.85,0:16:31.55,Main,,0,0,0,,!هذا سيئ
Dialogue: 0,0:16:37.58,0:16:39.32,Main,,0,0,0,,!سحقًا
Dialogue: 0,0:16:44.50,0:16:45.73,Main,,0,0,0,,أونيه-ني-ساما؟
Dialogue: 0,0:16:47.82,0:16:48.51,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:16:51.01,0:16:52.63,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:16:55.38,0:16:56.53,Main,,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:16:58.49,0:17:00.70,Main,,0,0,0,,ما الّذي حدث للتوّ؟
Dialogue: 0,0:17:01.44,0:17:05.12,Main,,0,0,0,,يتشارك ميز الفتى والفتاة جسدًا واحدًا وروحًا واحدةً
Dialogue: 0,0:17:05.19,0:17:10.50,Main,,0,0,0,,ميز الفتى هو الوحيد القادر على تحمّل قتالٍ شرسٍ كهذا
Dialogue: 0,0:17:10.76,0:17:16.65,Main,,0,0,0,,أمّا ميز الفتاة فلا تقوى حتّى على الوقوف بعد تلقّي كلّ هذا الضرر
Dialogue: 0,0:17:20.90,0:17:24.26,Main,,0,0,0,,يبدو أنَّ السماء تنحاز للأشخاص الفاتنين
Dialogue: 0,0:17:31.23,0:17:33.07,Main,,0,0,0,,!يا له من مشهدٍ بديع
Dialogue: 0,0:17:33.35,0:17:37.41,Main,,0,0,0,,،درع الروم، أقدس وأمنع درعٍ في الوجود
Dialogue: 0,0:17:37.41,0:17:42.16,Main,,0,0,0,,يُداس من قِبل الأنديدر؛ أخبث وأمقت الكيانات
Dialogue: 0,0:17:42.81,0:17:46.52,Main,,0,0,0,,إنّه يتوافق مع حسّي الجماليّ الآسر تمامًا
Dialogue: 0,0:17:47.13,0:17:50.67,Main,,0,0,0,,ستُختتم الأسطورة بهذه الكلمات
Dialogue: 0,0:17:50.90,0:17:57.21,Main,,0,0,0,,وهكذا سقط درع الروم على أيدي الأنديدر الملعونة والدنيئة
Dialogue: 0,0:17:59.01,0:18:00.48,Main,,0,0,0,,!مُحال
Dialogue: 0,0:18:00.80,0:18:05.62,Main,,0,0,0,,!سأذهب إلى بيستال برفقة أونيه-ني-ساما
Dialogue: 0,0:18:06.27,0:18:09.76,Main,,0,0,0,,!حان دوري لحماية أونيه-ني-ساما الآن
Dialogue: 0,0:18:11.02,0:18:13.15,Main,,0,0,0,,ألا زلتِ تقاومين؟
Dialogue: 0,0:18:13.22,0:18:17.22,Main,,0,0,0,,!إذن، سأُذيقكِ يأسًا لا نهاية له
Dialogue: 0,0:18:18.53,0:18:22.83,Main,,0,0,0,,!تأمّلي الهويّة الحقيقيّة للأنديدر الملعون
Dialogue: 0,0:18:41.35,0:18:42.75,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:18:44.05,0:18:45.18,Main,,0,0,0,,ما رأيكِ؟
Dialogue: 0,0:18:45.25,0:18:49.19,Main,,0,0,0,,يلتهم الأنديدر أرواح الموتى
Dialogue: 0,0:18:49.26,0:18:50.75,Main,,0,0,0,,يجدر بكِ معرفة ذلك
Dialogue: 0,0:18:51.11,0:18:54.20,Main,,0,0,0,,طاقة البشر العقليّة هي الأقرب للطور
Dialogue: 0,0:18:54.62,0:19:00.44,Main,,0,0,0,,ولا توجد طاقةٌ أنسب للقتل من تلك النابعة من الانتقام
Dialogue: 0,0:19:01.46,0:19:05.60,Main,,0,0,0,,...استياء الّذين لاقوا حتفهم بلا حولٍ ولا قوّةٍ في الحرب الضروس
Dialogue: 0,0:19:05.67,0:19:10.77,Main,,0,0,0,,ضغينة الجنود الّذين أُعدموا لإخفاقهم في القبض عليكِ
Dialogue: 0,0:19:11.41,0:19:16.09,Main,,0,0,0,,تلك مصادر الطور المذهل للأنديدر
Dialogue: 0,0:19:16.52,0:19:21.42,Main,,0,0,0,,وأيضًا يا ميل، ثمة أشخاصٌ هنا كانوا بانتظاركِ
Dialogue: 0,0:19:21.49,0:19:23.05,Main,,0,0,0,,...مـ-ميل
Dialogue: 0,0:19:23.12,0:19:25.18,Main,,0,0,0,,...مؤلم... أنقذيني
Dialogue: 0,0:19:25.70,0:19:29.08,Main,,0,0,0,,!أبي؟ أمي؟ مُحال
Dialogue: 0,0:19:35.05,0:19:36.43,Main,,0,0,0,,...ميل
Dialogue: 0,0:19:38.44,0:19:41.47,Main,,0,0,0,,!كلّا، توقّف رجاءً
Dialogue: 0,0:19:43.20,0:19:44.61,Main,,0,0,0,,!مروّع
Dialogue: 0,0:19:45.23,0:19:47.08,Main,,0,0,0,,...كيف... كيف
Dialogue: 0,0:19:47.15,0:19:48.41,Main,,0,0,0,,!كيف تجرؤ؟
Dialogue: 0,0:19:50.82,0:19:54.25,Main,,0,0,0,,يا له من شعورٍ يبعثُ على الحنين، لا بُدَّ أنّكِ في غاية السعادة
Dialogue: 0,0:19:54.32,0:19:57.31,Main,,0,0,0,,!سأسمح لكِ بالانضمام إليهم الآن
Dialogue: 0,0:19:58.02,0:19:58.65,Main,,0,0,0,,!هذا يكفي
Dialogue: 0,0:19:58.83,0:19:59.72,Main,,0,0,0,,!سأتدخّل
Dialogue: 0,0:19:59.81,0:20:00.34,Main,,0,0,0,,!تمهّل
Dialogue: 0,0:20:00.51,0:20:01.26,Main,,0,0,0,,لماذا؟
Dialogue: 0,0:20:01.66,0:20:02.68,Main,,0,0,0,,ستموت ميز إن استمرّ الوضع هكذا
Dialogue: 0,0:20:02.98,0:20:05.12,Main,,0,0,0,,ألا تشعر بتلك الهالة؟
Dialogue: 0,0:20:05.44,0:20:07.58,Main,,0,0,0,,إنّه الغضب
Dialogue: 0,0:20:08.17,0:20:12.16,Main,,0,0,0,,!استسلمي لليأس، ومُدّي غورد بقوّتكِ يا ميل
Dialogue: 0,0:20:16.30,0:20:17.04,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:20:25.12,0:20:26.10,Main,,0,0,0,,!لن أغفر لك
Dialogue: 0,0:20:35.65,0:20:37.30,Main,,0,0,0,,أزهقتَ أرواحًا لا تُحصى
Dialogue: 0,0:20:37.74,0:20:39.57,Main,,0,0,0,,وعذّبتَ أرواحهم
Dialogue: 0,0:20:39.78,0:20:41.20,Main,,0,0,0,,لن أغفر لأمثالك
Dialogue: 0,0:20:56.62,0:20:57.97,Main,,0,0,0,,!ستدفع الثمن غاليًا
Dialogue: 0,0:20:58.30,0:21:01.24,Main,,0,0,0,,!لأوّل مرّةٍ في حياتي، أمقتُ شخصًا ما
Dialogue: 0,0:21:08.05,0:21:08.92,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:21:09.07,0:21:10.75,Main,,0,0,0,,!هذا... مُحال
Dialogue: 0,0:21:23.10,0:21:25.75,Main,,0,0,0,,خذلنا
Dialogue: 0,0:21:26.98,0:21:31.76,Main,,0,0,0,,ما أخفق فيه غوجاس، عليكَ تعويضه
Dialogue: 0,0:21:31.89,0:21:34.76,Main,,0,0,0,,خطأ أخي هو خطأي أيضًا
Dialogue: 0,0:21:35.41,0:21:36.79,Main,,0,0,0,,سأتولّى الأمر
Dialogue: 0,0:21:37.39,0:21:39.83,Main,,0,0,0,,أعوّل عليكَ يا شيك
Dialogue: 0,0:21:47.40,0:21:49.60,Main,,0,0,0,,تبدو مُنهكةً كما هو متوقع
Dialogue: 0,0:21:49.67,0:21:52.21,Main,,0,0,0,,لا عجب في ذلك، بعد استنزاف كلّ تلك القوّة
Dialogue: 0,0:21:52.21,0:21:54.69,Main,,0,0,0,,!كنتُ موقنةً أنَّ ميز-سان مذهلةٌ حقًّا
Dialogue: 0,0:21:55.31,0:21:59.01,Main,,0,0,0,,أنقذتني مجدّدًا يا أونيه-ني-ساما
Dialogue: 0,0:21:59.08,0:22:03.54,Main,,0,0,0,,وحرّرتِ والديّ من معاناتهما
Dialogue: 0,0:22:03.98,0:22:09.20,Main,,0,0,0,,أونيه-ني-ساما، سأفعل أيّ شيءٍ من أجلكِ بدوري أيضًا
Dialogue: 0,0:22:10.14,0:22:12.52,Main,,0,0,0,,شكرًا لكِ يا أونيه-ني-ساما
Dialogue: 0,0:24:09.30,0:24:11.01,Main,,0,0,0,,!أيّها السيّدات والسادة
Dialogue: 0,0:24:11.71,0:24:14.65,Main,,0,0,0,,ميز الفتاة تُنقذ فتاةً مسكينةً من براثن الأوغاد
Dialogue: 0,0:24:14.73,0:24:17.70,Main,,0,0,0,,وبعد أن شهدوا مهارتها، طلب منها القرويّون أن تغدو حارستهم الشخصيّة
Dialogue: 0,0:24:18.43,0:24:20.50,Main,,0,0,0,,...وهناك تلتقي برجلٍ غامضٍ
Dialogue: 0,0:24:21.16,0:24:24.37,Main,,0,0,0,,وما اسم هذا السيّاف يا ترى؟
Dialogue: 0,0:24:25.56,0:24:27.99,Main,,0,0,0,,ستعرفون ذلك في المرّة القادمة
Dialogue: 0,0:24:28.50,0:24:30.57,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:30.80,0:24:33.56,Main,,0,0,0,,ذئبٌ أزرقٌ عتيقٌ لا مثيل له
Comment: 0,0:03:34.48,0:03:36.48,Main,,0,0,0,,
Dialogue: 0,0:03:51.71,0:04:03.56,Note,,0,0,0,,الفول رانا: قدرة تكتيكيّة تسمح للدرع أو للمستخدم بالانتقال السريع أو التواري لحظيًا عن الأنظار وذلك عبر الانزلاق والنفاذ من خلال تيار الأطوار الممتد في البعد القتالي
Dialogue: 0,0:15:10.89,0:15:12.21,Note,,0,0,0,,دروع الروم: دروع مٌقدسة وآثار أسطوريّة موروثة من العصور الغابرة وتتمتع بوعي خاص وقوّة سحريّة هائلة
Dialogue: 0,0:16:47.47,0:16:54.04,Note,,0,0,0,,الطور الزمرديّ: أحد التحولات القتاليّة الّتي تمنح الدرع الاصطناعيّ سرعةً عاليةً وتكيفًا خاصًّا مع الطاقة السحريّة الزمرديّة
Dialogue: 0,0:11:36.70,0:11:40.42,Note,,0,0,0,,صائدو الديمي: مرتزقة ومقاتلون محترفون يختصّون بتعقب وتدمير دروع "الديمي" الاصطناعيّة أو تحييد خطرها في المعارك أو لمصلحة الجهات المتعاقدة معهم
Dialogue: 0,0:12:24.31,0:12:27.17,Note,,0,0,0,,الأنديدر: طرازٌ قتاليٌّ من دروع "الديمي" الاصطناعيّة، يُعدُّ من الفئات الثقيلة المخصّصة للمعارك المباشرة واختراق التحصينات، ويتميّز بقوّة هجوميّة عالية ونواة سحريّة متطوّرة
Dialogue: 0,0:13:51.32,0:13:52.81,Note,,0,0,0,,دولغر: طرازٌ من الدروع القتاليّة الاصطناعيّة التي تُستدعى بواسطة السحر، ويتميّز بقدراتٍ هجوميّةٍ وسرعة استجابةٍ عاليةٍ في أرض المعركة
Dialogue: 0,0:15:06.84,0:15:09.16,Note,,0,0,0,,فولنار: أشخاص لديهم قدرات خاصّة تمكنهم من استخدام السّحر والتحكّم في القوى الطبيعيّة أو إطلاق طاقة مُشعة
Dialogue: 0,0:16:12.06,0:16:13.18,Note,,0,0,0,,ماها فايغر: تقنيّة هجوميّة كاسحة يُطلقها درع الروم الأسطوريّ "دولغر"، تعتمد على ضغط الطاقة السحريّة وتفريغها على شكل شعاع حراريّ عالي الكثافة
Comment: 0,0:03:34.48,0:03:36.48,Signs,,0,0,0,,
Dialogue: 0,0:03:36.48,0:03:42.45,Signs,,0,0,0,,!الانفجار النهائيّ للغضب
Dialogue: 0,0:24:33.95,0:24:37.95,Signs,,0,0,0,,!ذئبٌ أزرقٌ عتيقٌ لا مثيل له
