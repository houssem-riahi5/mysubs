Dialogue: 0,0:00:01.23,0:00:02.51,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:48.27,0:02:51.10,Main,,0,0,0,,الإبرة الأخيرة إذن
Dialogue: 0,0:02:54.07,0:02:57.12,Main,,0,0,0,,عاصفةٌ وبرقٌ خاطف، نِزالٌ في وضح النهار
Dialogue: 0,0:03:21.88,0:03:24.39,Main,,0,0,0,,أتمكّنت ميز ورفاقها من الفرار بأمانٍ يا ترى؟
Dialogue: 0,0:03:24.72,0:03:28.39,Main,,0,0,0,,وإلّا، فسيذهب تطوّعنا لنكون طُعمًا سُدًى
Dialogue: 0,0:03:28.68,0:03:33.23,Main,,0,0,0,,بئس الأمر، فالفرار المستمرّ لا يُلائم طبعي أبدًا
Dialogue: 0,0:03:33.56,0:03:36.58,Main,,0,0,0,,!تتحدّثين وكأنّكِ لم تفعلي كلّ ذلك
Dialogue: 0,0:03:36.62,0:03:37.69,Main,,0,0,0,,!بل أنتَ
Dialogue: 0,0:03:38.15,0:03:42.01,Main,,0,0,0,,حسنٌ، فلنُسرع بالانضمام إلى ميز ورفاقها
Dialogue: 0,0:03:42.14,0:03:42.76,Main,,0,0,0,,أجل
Dialogue: 0,0:03:50.08,0:03:51.25,Main,,0,0,0,,!أهم مطاردون آخرون؟
Dialogue: 0,0:03:53.50,0:03:54.44,Main,,0,0,0,,...ميديوسا
Dialogue: 0,0:03:55.05,0:03:56.18,Main,,0,0,0,,!هيا بنا يا سوليود
Dialogue: 0,0:03:56.58,0:03:57.33,Main,,0,0,0,,أجل
Dialogue: 0,0:04:05.58,0:04:07.36,Main,,0,0,0,,إنّها ماهرةٌ للغاية
Dialogue: 0,0:04:07.69,0:04:09.76,Main,,0,0,0,,يجدر بنا الفرار من هنا سريعًا
Dialogue: 0,0:04:09.86,0:04:12.09,Main,,0,0,0,,معذرةً، لكنّي أرفض ذلك
Dialogue: 0,0:04:12.78,0:04:14.04,Main,,0,0,0,,...سوليود
Dialogue: 0,0:04:14.64,0:04:18.10,Main,,0,0,0,,فأنا من تستهدفه تلك المرأة
Dialogue: 0,0:04:20.33,0:04:21.90,Main,,0,0,0,,ما الّذي يجري بحقّ؟
Dialogue: 0,0:04:50.70,0:04:55.08,Main,,0,0,0,,أكان محتومًا على لقائنا مجدّدًا أن يكون هكذا فحسب؟
Dialogue: 0,0:04:57.50,0:05:00.50,Main,,0,0,0,,!مضى وقتٌ طويل يا سوليود الزوبعة
Dialogue: 0,0:05:01.42,0:05:04.50,Main,,0,0,0,,لم يُنادِني أحدٌ بهذا اللقب طوال عشر سنوات
Dialogue: 0,0:05:04.92,0:05:06.51,Main,,0,0,0,,...مُنذ ذلك اليوم
Dialogue: 0,0:05:07.48,0:05:10.22,Main,,0,0,0,,ما زلتِ تذكرين ما جرى في ذلك اليوم إذن
Dialogue: 0,0:05:10.26,0:05:13.51,Main,,0,0,0,,وددتُ نسيانه حقًّا، لكنّكِ تمنعينني من ذلك
Dialogue: 0,0:05:13.93,0:05:15.89,Main,,0,0,0,,!يا ميديوسا مانعة الصواعق
Dialogue: 0,0:05:18.23,0:05:20.65,Main,,0,0,0,,أرى أنّكِ لم تنسي لقبي أنتِ الأخرى
Dialogue: 0,0:05:21.81,0:05:24.65,Main,,0,0,0,,...المحاربة عديمة الرحمة الّتي تُسكت بكاء الأطفال بطغيانها
Dialogue: 0,0:05:24.65,0:05:26.40,Main,,0,0,0,,مانعة الصواعق ميديوسا
Dialogue: 0,0:05:27.11,0:05:29.60,Main,,0,0,0,,أصرتِ الآن مجرد مأجورةٍ لدى جماعة جاينا؟
Dialogue: 0,0:05:29.74,0:05:31.29,Main,,0,0,0,,!يا لسقوطكِ المخزي
Dialogue: 0,0:05:32.41,0:05:34.41,Main,,0,0,0,,لا شأن لجاينا بهذا
Dialogue: 0,0:05:34.61,0:05:37.97,Main,,0,0,0,,فأنا الوحيدة القادرة على الإجهاز عليكِ بصفتكِ رفيقة دربي القديمة
Dialogue: 0,0:05:38.58,0:05:40.04,Main,,0,0,0,,هذا كلّ ما في الأمر
Dialogue: 0,0:05:40.12,0:05:40.94,Main,,0,0,0,,أهكذا إذن؟
Dialogue: 0,0:05:43.42,0:05:44.59,Main,,0,0,0,,!نلتُ منكِ
Dialogue: 0,0:05:47.42,0:05:50.59,Main,,0,0,0,,ألم تزعمي أنّكِ تذكرين ما جرى في ذلك اليوم؟
Dialogue: 0,0:05:52.09,0:05:53.54,Main,,0,0,0,,ألم أعلّمكِ ذلك؟
Dialogue: 0,0:05:53.74,0:05:57.81,Main,,0,0,0,,!احتفظي بالإبرة الأخيرة دومًا إن أردتِ النجاة
Dialogue: 0,0:06:08.48,0:06:11.78,Main,,0,0,0,,...قلتُ لكِ في ذلك اليوم أيضًا
Dialogue: 0,0:06:12.11,0:06:16.08,Main,,0,0,0,,إنّني سأرديكِ قتيلةً حتمًا حين نلتقي مجدّدًا
Dialogue: 0,0:06:16.16,0:06:18.68,Main,,0,0,0,,خيّبتِ أملي فيكِ حقًّا
Dialogue: 0,0:06:18.73,0:06:21.58,Main,,0,0,0,,حسبتُ أنّكِ ستمنحينني متعةً أكبر في النزال
Dialogue: 0,0:06:22.50,0:06:25.29,Main,,0,0,0,,ألم تكوني تطمحين للتفوّق عليّ في القوّة؟
Dialogue: 0,0:06:25.60,0:06:28.24,Main,,0,0,0,,ولهذا بلغتُ هذه الذروة من القوّة
Dialogue: 0,0:06:29.80,0:06:33.22,Main,,0,0,0,,لا شأن لي بضعيفةٍ مثلكِ يا سوليود
Dialogue: 0,0:06:33.80,0:06:34.76,Main,,0,0,0,,وداعًا
Dialogue: 0,0:06:50.03,0:06:53.32,Main,,0,0,0,,لن تُفلتي في المرّة القادمة يا سوليود
Dialogue: 0,0:07:25.81,0:07:26.94,Main,,0,0,0,,...ميديوسا
Dialogue: 0,0:07:27.02,0:07:27.98,Main,,0,0,0,,!أيّها المعلّم
Dialogue: 0,0:07:34.20,0:07:35.70,Main,,0,0,0,,!ميديوسا
Dialogue: 0,0:07:46.04,0:07:47.50,Main,,0,0,0,,!المعلّم
Dialogue: 0,0:07:55.63,0:07:58.09,Main,,0,0,0,,أكان حلمًا؟
Dialogue: 0,0:08:00.93,0:08:02.77,Main,,0,0,0,,...مـ-مهلًا يا أستار
Dialogue: 0,0:08:04.43,0:08:05.98,Main,,0,0,0,,أاستعدتِ وعيكِ؟
Dialogue: 0,0:08:06.31,0:08:08.27,Main,,0,0,0,,مهلًا، ما هذا بحقّ؟
Dialogue: 0,0:08:08.35,0:08:11.98,Main,,0,0,0,,ماذا؟ كان لا بُدَّ من تضميدكِ بالضمادات بما أنّكِ مصابة
Dialogue: 0,0:08:12.53,0:08:15.51,Main,,0,0,0,,!أهذه هيئة مصابة برأيك؟
Dialogue: 0,0:08:18.61,0:08:21.00,Main,,0,0,0,,!أنقذتُكِ، فلا تتذمّري
Dialogue: 0,0:08:21.28,0:08:24.87,Main,,0,0,0,,سننضمّ غدًا إلى ميز ورفاقها مباشرةً
Dialogue: 0,0:08:24.95,0:08:27.62,Main,,0,0,0,,فلا تسبّبي بمزيدٍ من المتاعب
Dialogue: 0,0:08:28.25,0:08:31.13,Main,,0,0,0,,لن أدع الأمر يمرّ هكذا
Dialogue: 0,0:08:33.00,0:08:34.67,Main,,0,0,0,,ثَمّة سرٌّ وراء هذا؟
Dialogue: 0,0:08:38.13,0:08:40.47,Main,,0,0,0,,ميديوسا هي عدوّتي اللدودة الّتي يتحتّم عليّ الانتقام منها
Dialogue: 0,0:08:41.30,0:08:44.85,Main,,0,0,0,,انتقام؟ انتقام إذن
Dialogue: 0,0:08:48.19,0:08:52.31,Main,,0,0,0,,لا أعلم من قتلتْ، لكن أليس ذلك أمرًا من الماضي الغابر؟
Dialogue: 0,0:08:52.44,0:08:55.82,Main,,0,0,0,,لا يُلائمكِ طلب الثأر أبدًا
Dialogue: 0,0:08:56.65,0:08:58.82,Main,,0,0,0,,أمرٌ من الماضي الغابر؟
Dialogue: 0,0:09:03.24,0:09:05.49,Main,,0,0,0,,أمضتْ عشر سنواتٍ بالفعل؟
Dialogue: 0,0:09:06.33,0:09:10.33,Main,,0,0,0,,...تلك الأيام الّتي قضيناها في الدوجو القابع في أعماق الجبال
Dialogue: 0,0:09:10.42,0:09:12.84,Main,,0,0,0,,حين كنتُ أنا وميديوسا غارقتين في التدريب ليلًا نهارًا
Dialogue: 0,0:09:24.18,0:09:25.83,Main,,0,0,0,,ما رأيكِ يا ميديوسا؟
Dialogue: 0,0:09:35.02,0:09:36.19,Main,,0,0,0,,...ميديوسا
Dialogue: 0,0:09:38.19,0:09:40.74,Main,,0,0,0,,،مهما بلغ تطوّري
Dialogue: 0,0:09:40.82,0:09:43.37,Main,,0,0,0,,ظلّت ميديوسا متفوّقةً عليّ دائمًا
Dialogue: 0,0:09:43.70,0:09:47.62,Main,,0,0,0,,لم أتمكّن من تجاوزها قطّ، بل كنتُ أتأمّل ظهرها فحسب
Dialogue: 0,0:09:48.16,0:09:52.93,Main,,0,0,0,,ومع ذلك، كان الأمر أشبه بمطاردةٍ لا نهاية لها
Dialogue: 0,0:09:53.34,0:09:55.17,Main,,0,0,0,,كانت ممتعةً للغاية
Dialogue: 0,0:10:05.39,0:10:08.22,Main,,0,0,0,,!تبًا، فازت ميديوسا مجدّدًا
Dialogue: 0,0:10:08.39,0:10:11.19,Main,,0,0,0,,هجومكِ ساذجٌ يا سوليود
Dialogue: 0,0:10:12.39,0:10:15.86,Main,,0,0,0,,كلّما ازددتُ براعةً، ازدادت ميديوسا قوّةً بالمثل
Dialogue: 0,0:10:15.94,0:10:18.32,Main,,0,0,0,,لن أنتصر عليكِ مهما مرّ الوقت
Dialogue: 0,0:10:18.40,0:10:21.47,Main,,0,0,0,,إذن، فلتظلي تطاردينني إلى الأبد
Dialogue: 0,0:10:23.57,0:10:26.41,Main,,0,0,0,,سأزداد قوّةً وبراعةً أكثر فأكثر
Dialogue: 0,0:10:26.58,0:10:31.58,Main,,0,0,0,,وإن لاحقتِني يا سوليود، فستغدين أقوى بكثير
Dialogue: 0,0:10:32.29,0:10:36.54,Main,,0,0,0,,لذا طارديني إلى الأبد وإلى أقاصي الأرض
Dialogue: 0,0:10:37.25,0:10:40.92,Main,,0,0,0,,فأنا وحدي القادرة على جعلكِ أقوى
Dialogue: 0,0:10:41.59,0:10:43.93,Main,,0,0,0,,...هيّا يا سوليود
Dialogue: 0,0:10:51.77,0:10:57.02,Main,,0,0,0,,الحقي بي إلى الأبد وإلى أبعد الحدود
Dialogue: 0,0:10:59.86,0:11:02.07,Main,,0,0,0,,،حين أسترجع ذكريات ذلك اليوم
Dialogue: 0,0:11:02.15,0:11:05.61,Main,,0,0,0,,...مُنذ تلك اللحظة الّتي عانقتني فيها ميديوسا
Dialogue: 0,0:11:05.66,0:11:10.08,Main,,0,0,0,,...لعلّ مسار عقلها قد بدأ ينحرف آنذاك
Dialogue: 0,0:11:13.12,0:11:14.12,Main,,0,0,0,,!هذا يكفي
Dialogue: 0,0:11:49.83,0:11:54.62,Main,,0,0,0,,،لم تتوانَ ميديوسا عن استخدام أيّ وسيلةٍ لتزداد قوّةً
Dialogue: 0,0:11:54.71,0:11:58.25,Main,,0,0,0,,فقد مقتها رفاقنا وغادروا الدوجو واحدًا تلو الآخر
Dialogue: 0,0:11:58.58,0:12:02.50,Main,,0,0,0,,حتّى لم يتبقَّ سواي أنا وميديوسا في النهاية
Dialogue: 0,0:12:22.27,0:12:26.03,Main,,0,0,0,,،ولم يعرف جشع ميديوسا للقوّة أيّ حدود
Dialogue: 0,0:12:26.36,0:12:27.91,Main,,0,0,0,,...حتّى آل بها المطاف
Dialogue: 0,0:12:29.49,0:12:33.69,Main,,0,0,0,,إلى قتل معلّمها الّذي أشرف على تدريبها ورعايتها
Dialogue: 0,0:12:34.50,0:12:37.75,Main,,0,0,0,,لِمَ؟ لِمَ يا ميديوسا؟
Dialogue: 0,0:12:38.75,0:12:40.17,Main,,0,0,0,,لِمَ قتلتِ المعلّم؟
Dialogue: 0,0:12:40.21,0:12:41.75,Main,,0,0,0,,لأغدو أقوى
Dialogue: 0,0:12:46.51,0:12:48.05,Main,,0,0,0,,...ميديوسا
Dialogue: 0,0:12:48.25,0:12:49.24,Main,,0,0,0,,!ميديوسا
Dialogue: 0,0:12:59.02,0:13:02.98,Main,,0,0,0,,وجّهتِ نصلكِ نحوي يا سوليود
Dialogue: 0,0:13:04.11,0:13:07.40,Main,,0,0,0,,!وأصبحتِ عدوّتي مُنذ هذه اللحظة
Dialogue: 0,0:13:13.95,0:13:16.87,Main,,0,0,0,,ميديوسا، لِمَ ظهرتِ الآن بالذات؟
Dialogue: 0,0:13:34.72,0:13:36.52,Main,,0,0,0,,أحلَّ الصباح بالفعل؟
Dialogue: 0,0:13:41.27,0:13:43.19,Main,,0,0,0,,!كنتُ أعلم أنَّ هذا ما سيحدث
Dialogue: 0,0:13:43.40,0:13:46.61,Main,,0,0,0,,!تبًا لكِ يا سوليود، سأجعلكِ تدفعين الثمن
Dialogue: 0,0:13:59.58,0:14:03.46,Main,,0,0,0,,يا لكَ من طبيبٍ فاشلٍ يا أستار
Dialogue: 0,0:14:03.96,0:14:08.17,Main,,0,0,0,,لا أعلم من قتلتْ، لكن أليس ذلك أمرًا من الماضي الغابر؟
Dialogue: 0,0:14:08.26,0:14:11.43,Main,,0,0,0,,لا يُلائمكِ طلب الثأر أبدًا
Dialogue: 0,0:14:12.47,0:14:14.93,Main,,0,0,0,,لا يمكنني ترك الأمر هكذا فحسب
Dialogue: 0,0:14:16.26,0:14:20.31,Main,,0,0,0,,وجّهتِ نصلكِ نحوي يا سوليود
Dialogue: 0,0:14:20.56,0:14:24.48,Main,,0,0,0,,!وأصبحتِ عدوّتي مُنذ هذه اللحظة
Dialogue: 0,0:14:26.48,0:14:31.49,Main,,0,0,0,,لن أصفح أبدًا عمّن يُوجّه نصله نحوي
Dialogue: 0,0:14:38.95,0:14:40.95,Main,,0,0,0,,سأعلّمكِ أمرًا واحدًا
Dialogue: 0,0:14:42.29,0:14:47.42,Main,,0,0,0,,عليكِ الاحتفاظ بالإبرة الأخيرة دومًا إن أردتِ النجاة
Dialogue: 0,0:14:49.30,0:14:50.42,Main,,0,0,0,,ميديوسا
Dialogue: 0,0:14:51.47,0:14:55.72,Main,,0,0,0,,لكن لا تنسي؛ أنتِ عدوّتي ابتداءً من اليوم
Dialogue: 0,0:14:56.68,0:15:01.18,Main,,0,0,0,,سأرديكِ قتيلةً حتمًا حين نلتقي مجدّدًا
Dialogue: 0,0:15:04.98,0:15:11.32,Main,,0,0,0,,لو ضغطت ميديوسا على الزناد آنذاك لمتُّ دون أدنى شكّ
Dialogue: 0,0:15:12.32,0:15:15.28,Main,,0,0,0,,،لستُ ممّن يغضّ الطرف عن غريمه
Dialogue: 0,0:15:15.36,0:15:17.07,Main,,0,0,0,,ولستُ بهذه السذاجة أبدًا
Dialogue: 0,0:15:24.96,0:15:26.04,Main,,0,0,0,,...ميديوسا
Dialogue: 0,0:15:34.17,0:15:37.47,Main,,0,0,0,,بالغتِ في فعلكِ كثيرًا هذه المرّة يا ميديوسا
Dialogue: 0,0:15:37.93,0:15:41.35,Main,,0,0,0,,ما كان يجدر بكِ الإجهاز عليه
Dialogue: 0,0:15:41.39,0:15:44.27,Main,,0,0,0,,كان أمرًا لا بُدَّ منه لأغدو أقوى
Dialogue: 0,0:15:44.69,0:15:45.69,Main,,0,0,0,,...مستحيل
Dialogue: 0,0:15:47.90,0:15:51.78,Main,,0,0,0,,أيسعكِ قتل المعلّم يا سوليود؟
Dialogue: 0,0:15:53.28,0:15:58.12,Main,,0,0,0,,يسعني ذلك إن كان سيمنحني قوّةً تتجاوز قوّة معلّمي
Dialogue: 0,0:15:58.53,0:16:02.33,Main,,0,0,0,,وعليكِ اتّباعي أنا الّتي تجاوزت معلّمها
Dialogue: 0,0:16:02.54,0:16:06.23,Main,,0,0,0,,فستزدادين قوّةً ما دمتِ بجواري
Dialogue: 0,0:16:06.75,0:16:11.59,Main,,0,0,0,,لذا إيّاكِ ومفارقتي، إيّاكِ أبدًا
Dialogue: 0,0:16:12.09,0:16:14.72,Main,,0,0,0,,أتفهمين هذا يا سوليود؟
Dialogue: 0,0:16:22.89,0:16:24.06,Main,,0,0,0,,سوليود
Dialogue: 0,0:16:28.65,0:16:33.98,Main,,0,0,0,,بلغتُ قوّةً لا يضاهيها أحد يا سوليود
Dialogue: 0,0:16:34.40,0:16:37.90,Main,,0,0,0,,غير أنّكِ لستِ بجواري الآن
Dialogue: 0,0:16:40.24,0:16:45.25,Main,,0,0,0,,فهل أهزمكِ وأمضي في درب الشورا السرمديّ؟
Dialogue: 0,0:16:46.29,0:16:47.58,Main,,0,0,0,,...أم
Dialogue: 0,0:17:33.14,0:17:35.42,Main,,0,0,0,,لم تجلبي رفيقكِ معكِ إذن
Dialogue: 0,0:17:36.00,0:17:38.09,Main,,0,0,0,,لا شأن له بهذا النزال
Dialogue: 0,0:17:38.47,0:17:41.51,Main,,0,0,0,,كان الأجدر بكِ الفرار معه
Dialogue: 0,0:17:41.80,0:17:44.26,Main,,0,0,0,,جئتُ لأحسم هذا الخلاف حسمًا قاطعًا
Dialogue: 0,0:17:44.93,0:17:46.54,Main,,0,0,0,,أترى بمقدوركِ ذلك؟
Dialogue: 0,0:17:46.68,0:17:49.75,Main,,0,0,0,,من يعلم، سأبذل قصارى جهدي على أيّ حال
Dialogue: 0,0:18:10.87,0:18:13.38,Main,,0,0,0,,!ما زلتِ رديئة التصويب كعادتكِ يا سوليود
Dialogue: 0,0:18:14.33,0:18:16.99,Main,,0,0,0,,لم تتغيّري قيد أنملة عمّا كنتِ عليه في ذلك الحين
Dialogue: 0,0:18:17.21,0:18:18.70,Main,,0,0,0,,!لم تري شيئًا بعد
Dialogue: 0,0:18:38.02,0:18:41.61,Main,,0,0,0,,!هذا رائع، هاجميني بكلّ ما أوتيتِ من قوّةٍ يا سوليود
Dialogue: 0,0:18:46.53,0:18:51.16,Main,,0,0,0,,!أنتِ الوحيدة القادرة على إرواء ظمئي يا سوليود
Dialogue: 0,0:18:59.21,0:19:01.21,Main,,0,0,0,,تبقّت إبرتان إذن
Dialogue: 0,0:19:14.94,0:19:16.00,Main,,0,0,0,,!سحقًا
Dialogue: 0,0:19:22.15,0:19:24.91,Main,,0,0,0,,انتهى وقت اللعب يا سوليود
Dialogue: 0,0:19:27.16,0:19:29.08,Main,,0,0,0,,تمامًا كما حدث في ذلك اليوم
Dialogue: 0,0:19:29.12,0:19:33.79,Main,,0,0,0,,استنفدتِ كافّة إبركِ، ولم يتبقَّ لديكِ أيّ وسيلةٍ للهجوم
Dialogue: 0,0:19:34.12,0:19:37.33,Main,,0,0,0,,حياتكِ باتت في قبضتي
Dialogue: 0,0:19:40.42,0:19:41.51,Main,,0,0,0,,!بئس الأمر
Dialogue: 0,0:19:42.96,0:19:46.13,Main,,0,0,0,,لكنّي لم أُهزم بعد
Dialogue: 0,0:19:50.10,0:19:51.26,Main,,0,0,0,,!ميديوسا
Dialogue: 0,0:19:52.14,0:19:56.31,Main,,0,0,0,,ليت تلك الأيام دامت إلى الأبد
Dialogue: 0,0:20:04.19,0:20:05.61,Main,,0,0,0,,!ميديوسا
Dialogue: 0,0:20:39.48,0:20:42.57,Main,,0,0,0,,ألم تكن في طريقك للانضمام إلى ميز ورفاقها؟
Dialogue: 0,0:20:42.65,0:20:45.44,Main,,0,0,0,,ضللتُ طريقي قليلًا لا أكثر
Dialogue: 0,0:20:46.12,0:20:46.78,Main,,0,0,0,,هكذا إذن
Dialogue: 0,0:20:47.15,0:20:49.68,Main,,0,0,0,,لكنَّ الحظ حالفكِ حقًّا
Dialogue: 0,0:20:50.02,0:20:52.73,Main,,0,0,0,,إذ نفدت سهام نشاب تلك المرأة
Dialogue: 0,0:20:53.66,0:20:55.08,Main,,0,0,0,,!مستحيل
Dialogue: 0,0:20:55.16,0:20:59.46,Main,,0,0,0,,هذه هي الحقيقة، ضغطتْ على الزناد لكن لم ينطلق أيّ سهم
Dialogue: 0,0:20:59.50,0:21:01.46,Main,,0,0,0,,مُحال، أيعقل هذا؟
Dialogue: 0,0:21:07.76,0:21:10.13,Main,,0,0,0,,لِمَ فعلتِ هذا يا ميديوسا؟
Dialogue: 0,0:21:10.29,0:21:12.75,Main,,0,0,0,,لِمَ لم تحتفظي بالسهم الأخير؟
Dialogue: 0,0:21:13.18,0:21:14.93,Main,,0,0,0,,ألستِ من علّمني ذلك؟
Dialogue: 0,0:21:15.16,0:21:16.71,Main,,0,0,0,,بأن أحتفظ به إن أردتُ النجاة
Dialogue: 0,0:21:17.68,0:21:19.14,Main,,0,0,0,,...أيعقل أنّكِ
Dialogue: 0,0:21:19.58,0:21:21.22,Main,,0,0,0,,كنتِ عازمةً على الموت مُنذ البداية؟
Dialogue: 0,0:21:21.69,0:21:24.57,Main,,0,0,0,,!لِمَ أقدمتِ على فِعلٍ كهذا يا ميديوسا؟
Dialogue: 0,0:21:24.74,0:21:25.97,Main,,0,0,0,,!ميديوسا
Dialogue: 0,0:21:29.04,0:21:30.08,Main,,0,0,0,,!ميديوسا
Dialogue: 0,0:21:32.07,0:21:36.37,Main,,0,0,0,,سأعلّمكِ أمرًا أخيرًا
Dialogue: 0,0:21:38.08,0:21:43.21,Main,,0,0,0,,إيّاكِ أن تبلغي ما بلغتُه من القوّة
Dialogue: 0,0:21:43.50,0:21:46.53,Main,,0,0,0,,!ما الّذي تعنينه بهذا يا ميديوسا؟
Dialogue: 0,0:21:48.34,0:21:49.70,Main,,0,0,0,,!ميديوسا
Dialogue: 0,0:21:51.26,0:21:52.68,Main,,0,0,0,,...سوليود
Dialogue: 0,0:21:53.97,0:21:58.68,Main,,0,0,0,,كأنّنا عدنا إلى تلك الأيام الخوالي
Dialogue: 0,0:24:11.17,0:24:13.80,Main,,0,0,0,,!هيّا يا ميل-تشان، حان وقت إعلان الحلقة القادمة
Dialogue: 0,0:24:13.93,0:24:15.39,Main,,0,0,0,,!فلنبذل وسعنا هذا الأسبوع أيضًا
Dialogue: 0,0:24:15.55,0:24:19.40,Main,,0,0,0,,ما خطبكِ يا أونيه-ني-ساما؟ تبدين فتاةً رقيقةً على غير عادتكِ
Dialogue: 0,0:24:19.40,0:24:23.10,Main,,0,0,0,,حسنٌ، سنلتقي في بالانيا بذلك اللعوب الغامض؛ غولد-سان
Dialogue: 0,0:24:23.10,0:24:25.23,Main,,0,0,0,,أهو صديقٌ أم عدو يا ترى؟
Dialogue: 0,0:24:25.31,0:24:27.15,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:27.27,0:24:29.21,Main,,0,0,0,,!احذروا من ذلك اللعوب الوسيم
Dialogue: 0,0:24:29.37,0:24:30.23,Main,,0,0,0,,!إيّاكم أن تفوّتوها
Dialogue: 0,0:24:31.04,0:24:33.11,Main,,0,0,0,,!فقدت أونيه-ني-ساما صوابها
Comment: 0,0:24:33.11,0:24:33.11,Signs,,0,0,0,,
Dialogue: 0,0:02:54.19,0:03:00.15,Signs,,0,0,0,,عاصفةٌ وبرقٌ خاطف، نِزالٌ في وضح النهار
Dialogue: 0,0:24:33.11,0:24:37.12,Signs,,0,0,0,,احذروا من اللعوب الوسيم
