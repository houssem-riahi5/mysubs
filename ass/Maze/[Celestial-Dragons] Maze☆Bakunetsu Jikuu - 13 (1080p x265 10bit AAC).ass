Dialogue: 0,0:00:01.21,0:00:02.21,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:06.41,0:02:08.68,Main,,0,0,0,,!حان وقت المعركة الحاسمة أخيرًا
Dialogue: 0,0:02:09.39,0:02:14.11,Main,,0,0,0,,!حان الوقت لنُظهر قوّة فرسان بالانيا الحقيقية
Dialogue: 0,0:02:23.68,0:02:25.55,Main,,0,0,0,,...أونيه-ني-ساما
Dialogue: 0,0:02:40.94,0:02:42.30,Main,,0,0,0,,يعمّ السلام هذا المكان
Dialogue: 0,0:02:48.91,0:02:51.20,Main,,0,0,0,,حان وقت المعركة الحاسمة إذن
Dialogue: 0,0:02:51.90,0:02:54.20,Main,,0,0,0,,،ما إن نهزم طائفة جاينا
Dialogue: 0,0:02:54.40,0:02:57.08,Main,,0,0,0,,،وتعتلي ميل-تشان العرش كملكة
Dialogue: 0,0:02:57.59,0:03:01.63,Main,,0,0,0,,فما الّذي سأفعله حينئذ يا ترى؟
Dialogue: 0,0:03:02.99,0:03:05.95,Main,,0,0,0,,تحوّلٌ مفاجئ في الأحداث! ميز عبر الزمان
Dialogue: 0,0:03:12.25,0:03:16.04,Main,,0,0,0,,!إنّه درع اصطناعيّ! لينجدني أحدكم
Dialogue: 0,0:03:16.08,0:03:16.86,Main,,0,0,0,,!اهدئي
Dialogue: 0,0:03:17.34,0:03:18.44,Main,,0,0,0,,!جلالة الملك
Dialogue: 0,0:03:19.77,0:03:21.44,Main,,0,0,0,,هل تأذنين لي بمرافقتكِ؟
Dialogue: 0,0:03:21.61,0:03:22.72,Main,,0,0,0,,أجل
Dialogue: 0,0:03:29.33,0:03:30.52,Main,,0,0,0,,...عذرًا
Dialogue: 0,0:03:31.62,0:03:33.54,Main,,0,0,0,,أراكِ تنعمين بالهدوء
Dialogue: 0,0:03:43.17,0:03:45.77,Main,,0,0,0,,أيصحّ بقاؤك هنا هكذا؟
Dialogue: 0,0:03:45.84,0:03:47.80,Main,,0,0,0,,ألستَ في خضمّ أوقات عصيبة؟
Dialogue: 0,0:03:47.90,0:03:51.21,Main,,0,0,0,,لا تقلقي، فالتفكير من شأن دوشين ورفاقه
Dialogue: 0,0:03:51.77,0:03:54.11,Main,,0,0,0,,أمّا مكاني الحقيقي ففي ساحة المعركة
Dialogue: 0,0:03:54.28,0:03:57.04,Main,,0,0,0,,مكانك الحقيقي؟
Dialogue: 0,0:03:57.44,0:03:58.48,Main,,0,0,0,,ألا يروقكِ هذا؟
Dialogue: 0,0:03:59.02,0:04:01.77,Main,,0,0,0,,ملامحكِ تنمّ عن عدم اقتناعكِ
Dialogue: 0,0:04:02.82,0:04:06.20,Main,,0,0,0,,ألستِ قائدة درع الروم دولغار؟
Dialogue: 0,0:04:08.49,0:04:14.88,Main,,0,0,0,,،أريد مدّ يد العون لميل-تشان والجميع
Dialogue: 0,0:04:15.37,0:04:18.33,Main,,0,0,0,,لكنّني خائفة
Dialogue: 0,0:04:18.75,0:04:21.63,Main,,0,0,0,,،أخشى القتال ورائحة الدماء
Dialogue: 0,0:04:22.04,0:04:25.55,Main,,0,0,0,,،وأخشى نفسي أثناء خوض المعارك
Dialogue: 0,0:04:25.71,0:04:28.20,Main,,0,0,0,,أخشى ما أصير عليه حين أقود دولغار
Dialogue: 0,0:04:30.40,0:04:32.09,Main,,0,0,0,,أعلم أنّ حديثي هذا أنانيّ للغاية
Dialogue: 0,0:04:32.51,0:04:34.00,Main,,0,0,0,,لديّ حلّ لذلك
Dialogue: 0,0:04:38.14,0:04:40.96,Main,,0,0,0,,لن أدعكِ تشعرين بهذا البتة
Dialogue: 0,0:04:41.87,0:04:43.92,Main,,0,0,0,,سأمنحكِ مستقبلًا يخلو من الحروب
Dialogue: 0,0:04:50.81,0:04:54.46,Main,,0,0,0,,إن كانت هذه رغبتكِ، فسأملأ هذا العالم بالسلام
Dialogue: 0,0:04:55.00,0:05:01.04,Main,,0,0,0,,حتّى لو فُني جسدي، أو واجهتُ جحافل الأعداء، فسأغيّر هذا العالم حتمًا
Dialogue: 0,0:05:02.68,0:05:04.46,Main,,0,0,0,,من أجلكِ وحدكِ
Dialogue: 0,0:05:04.51,0:05:05.60,Main,,0,0,0,,...جلالة الملك
Dialogue: 0,0:05:05.93,0:05:08.62,Main,,0,0,0,,كلّا، لسنا الآن سوى رجل وامرأة
Dialogue: 0,0:05:12.89,0:05:14.83,Main,,0,0,0,,!يا له من موقف مُباغت
Dialogue: 0,0:05:14.89,0:05:18.44,Main,,0,0,0,,كيف يُفترض بي التصرّف الآن؟
Dialogue: 0,0:05:25.18,0:05:26.99,Main,,0,0,0,,!ما الّذي تفعلانه هنا؟
Dialogue: 0,0:05:32.07,0:05:35.16,Main,,0,0,0,,!ما الّذي تفعلانه بمفردكما في مكان كهذا؟
Dialogue: 0,0:05:35.24,0:05:37.79,Main,,0,0,0,,الجوّ بديع، أليس كذلك يا ميز؟
Dialogue: 0,0:05:37.87,0:05:39.64,Main,,0,0,0,,!وهل يعانق المرء لمجرّد أنّ الجوّ بديع؟
Dialogue: 0,0:05:39.71,0:05:43.39,Main,,0,0,0,,كنّا نضع خطّة معًا فحسب
Dialogue: 0,0:05:43.50,0:05:46.49,Main,,0,0,0,,!أيّ خطّة؟! أخطة لليلة غرامية؟
Dialogue: 0,0:05:48.12,0:05:51.34,Main,,0,0,0,,ألا ينتابكِ شعور مفاجئ بالرغبة في الرقص أحيانًا؟
Dialogue: 0,0:05:53.09,0:05:54.94,Main,,0,0,0,,!ابتعدا عن بعضكما حالًا
Dialogue: 0,0:05:57.45,0:05:58.93,Main,,0,0,0,,!أيّتها القطّة السارقة
Dialogue: 0,0:05:58.97,0:06:02.67,Main,,0,0,0,,!كيف تجرئين على استغفالي والتقرّب من جلالته؟
Dialogue: 0,0:06:03.20,0:06:04.44,Main,,0,0,0,,!لستُ سارقة
Dialogue: 0,0:06:04.52,0:06:05.16,Main,,0,0,0,,!مُحال
Dialogue: 0,0:06:05.98,0:06:06.94,Main,,0,0,0,,!سأقضي عليكِ
Dialogue: 0,0:06:08.22,0:06:11.40,Main,,0,0,0,,!توقّفي واهدئي يا ران تشيكي
Dialogue: 0,0:06:12.36,0:06:16.81,Main,,0,0,0,,!لا تمنعني! أغوتك هذه المرأة اللعوبة يا جلالة الملك
Dialogue: 0,0:06:16.83,0:06:20.08,Main,,0,0,0,,!وإلّا فمستحيل أن تخون حبّنا
Dialogue: 0,0:06:20.16,0:06:22.75,Main,,0,0,0,,،في ذلك الحقل عند الغروب، حيث كانت اليعاسيب الحمراء تتمايل
Dialogue: 0,0:06:22.83,0:06:27.09,Main,,0,0,0,,!تبادلتُ وجلالته عهود الحبّ الأبديّ الّذي لا ينكسر
Dialogue: 0,0:06:27.17,0:06:31.80,Main,,0,0,0,,!حبٌّ حقيقيّ لا يُضاهى، حبٌّ يتجاوز حدود العشق
Dialogue: 0,0:06:31.90,0:06:36.93,Main,,0,0,0,,!كان حبًّا يفوق الوصف
Dialogue: 0,0:06:42.31,0:06:46.65,Main,,0,0,0,,كلّا، لم يكن سوى طيش طفولة عابر
Dialogue: 0,0:06:46.80,0:06:48.55,Main,,0,0,0,,!مهلًا، ولِمَ تختلق الأعذار أمامها؟
Dialogue: 0,0:06:48.86,0:06:53.44,Main,,0,0,0,,!دنّستِ الحبّ الّذي يجمع بيني وبين جلالته
Dialogue: 0,0:06:53.65,0:06:55.57,Main,,0,0,0,,!تجرّعي غضب الحبّ
Dialogue: 0,0:07:05.24,0:07:06.07,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:07:06.63,0:07:08.03,Main,,0,0,0,,!ما الّذي تفعلينه أيّتها الخرقاء؟
Dialogue: 0,0:07:12.84,0:07:17.31,Main,,0,0,0,,!أنتَ فتايَ المثاليّ، لا بدّ أنّ هذا حبٌّ
Dialogue: 0,0:07:18.68,0:07:21.72,Main,,0,0,0,,!لا شأن لي بحبّكِ هذا
Dialogue: 0,0:07:21.72,0:07:24.94,Main,,0,0,0,,!انتظرني يا ميز الفتى
Dialogue: 0,0:07:25.10,0:07:26.73,Main,,0,0,0,,!مستحيل أن أنتظركِ
Dialogue: 0,0:07:26.73,0:07:28.02,Main,,0,0,0,,!انتظر
Dialogue: 0,0:07:30.19,0:07:31.53,Main,,0,0,0,,تجاهلاني مجدّدًا
Dialogue: 0,0:07:36.82,0:07:43.34,Main,,0,0,0,,أودّ تقديم تقرير؛ عُثر فجر اليوم على جسم مريب في موقع التنقيب السابع للدروع الاصطناعيّة
Dialogue: 0,0:07:43.54,0:07:44.50,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:07:54.22,0:07:55.37,Main,,0,0,0,,أين نحن؟
Dialogue: 0,0:07:55.38,0:07:58.72,Main,,0,0,0,,هنا موقع تنقيب بالانيا عن الدروع الاصطناعيّة
Dialogue: 0,0:07:58.76,0:08:00.01,Main,,0,0,0,,تنقيب؟
Dialogue: 0,0:08:00.10,0:08:02.25,Main,,0,0,0,,ألم تكن على دراية بهذا يا ميز-سان؟
Dialogue: 0,0:08:02.78,0:08:04.23,Main,,0,0,0,,ليس هذا الموقع الوحيد؛
Dialogue: 0,0:08:04.27,0:08:06.89,Main,,0,0,0,,...فجميع الدروع الاصطناعيّة على هذه القارّة
Dialogue: 0,0:08:06.94,0:08:09.24,Main,,0,0,0,,هي آثار استُخرجت من باطن الأرض
Dialogue: 0,0:08:09.48,0:08:13.48,Main,,0,0,0,,ظننتُ أنّكم تصنعونها بالسحر أو ما شابه
Dialogue: 0,0:08:13.57,0:08:15.15,Main,,0,0,0,,،بوسعنا العثور عليها
Dialogue: 0,0:08:15.39,0:08:18.91,Main,,0,0,0,,لكنّ هيكلها وطريقة تصنيعها وموادّها تظلّ لغزًا غامضًا
Dialogue: 0,0:08:19.66,0:08:23.20,Main,,0,0,0,,وكلّ ما نعرفه هو كيفية تشغيلها بشكل تقريبيّ فقط
Dialogue: 0,0:08:24.94,0:08:26.96,Main,,0,0,0,,هنا إذن
Dialogue: 0,0:08:27.50,0:08:28.42,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:08:32.29,0:08:35.34,Main,,0,0,0,,،لا يطابق هذا الكيان أيّ طراز من الدروع الاصطناعيّة المكتشفة سابقًا
Dialogue: 0,0:08:35.42,0:08:39.47,Main,,0,0,0,,ويوشك باحثو القصر على بدء فحصه بدقّة
Dialogue: 0,0:08:40.40,0:08:42.35,Main,,0,0,0,,ما هذا الشعور؟
Dialogue: 0,0:08:42.43,0:08:46.21,Main,,0,0,0,,تفوح منه رائحة كريهة للغاية للدماء والحروب
Dialogue: 0,0:08:47.77,0:08:49.60,Main,,0,0,0,,ما بكِ يا أونيه-ني-ساما؟
Dialogue: 0,0:08:58.19,0:08:59.11,Main,,0,0,0,,!ابتعدوا
Dialogue: 0,0:09:12.73,0:09:13.34,Main,,0,0,0,,!أعتمد عليك
Dialogue: 0,0:09:19.68,0:09:21.26,Main,,0,0,0,,!مـ-ما هذا؟
Dialogue: 0,0:09:34.61,0:09:36.60,Main,,0,0,0,,!يا لها من هيئة شريرة تقشعرّ لها الأبدان
Dialogue: 0,0:09:37.47,0:09:38.14,Main,,0,0,0,,!أهو وحش؟
Dialogue: 0,0:09:50.71,0:09:51.65,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:09:54.71,0:09:55.90,Main,,0,0,0,,!انسحبوا جميعًا
Dialogue: 0,0:09:56.38,0:09:58.65,Main,,0,0,0,,!لِتنطلق فرقة الدروع الاصطناعيّة فورًا
Dialogue: 0,0:10:01.93,0:10:03.83,Main,,0,0,0,,!استدعي دولغار يا ميل-تشان
Dialogue: 0,0:10:04.60,0:10:05.51,Main,,0,0,0,,!حاضر
Dialogue: 0,0:10:25.74,0:10:27.24,Main,,0,0,0,,!غيّر شكله؟
Dialogue: 0,0:10:27.70,0:10:29.37,Main,,0,0,0,,!إنّه قادم يا أونيه-ني-ساما
Dialogue: 0,0:10:36.13,0:10:37.67,Main,,0,0,0,,!يا لها من قوّة هائلة
Dialogue: 0,0:10:37.75,0:10:41.55,Main,,0,0,0,,!لولا دولغار لتمزّقنا إربًا في طرفة عين
Dialogue: 0,0:10:45.97,0:10:49.89,Main,,0,0,0,,!عليّ القتال لحماية الجميع بنفسي
Dialogue: 0,0:11:03.61,0:11:04.64,Main,,0,0,0,,!ميز
Dialogue: 0,0:11:39.44,0:11:40.11,Main,,0,0,0,,...أهذا
Dialogue: 0,0:11:45.15,0:11:46.16,Main,,0,0,0,,أنا؟
Dialogue: 0,0:11:58.29,0:12:01.21,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:12:03.59,0:12:04.76,Main,,0,0,0,,!مؤلم
Dialogue: 0,0:12:05.30,0:12:08.60,Main,,0,0,0,,!قلقتُ عليكِ كثيرًا حين لم تستيقظِ
Dialogue: 0,0:12:09.00,0:12:10.96,Main,,0,0,0,,أأنتِ بخير يا أونيه-ني-ساما؟
Dialogue: 0,0:12:12.51,0:12:14.98,Main,,0,0,0,,أجل، على ما أظن
Dialogue: 0,0:12:15.64,0:12:19.02,Main,,0,0,0,,صحيح، أين جلالة الملك فارماونت والآخرون؟
Dialogue: 0,0:12:19.73,0:12:20.94,Main,,0,0,0,,...في الواقع
Dialogue: 0,0:12:30.70,0:12:31.98,Main,,0,0,0,,ما هذا المكان؟
Dialogue: 0,0:12:32.27,0:12:34.29,Main,,0,0,0,,أين ذهب الجميع يا ترى؟
Dialogue: 0,0:12:40.17,0:12:42.54,Main,,0,0,0,,ما هذا الشيء يا أونيه-ني-ساما؟
Dialogue: 0,0:12:53.68,0:12:55.35,Main,,0,0,0,,...هذا
Dialogue: 0,0:12:56.18,0:12:59.52,Main,,0,0,0,,ماذا؟ كيف أعرف طريقة فتحه؟
Dialogue: 0,0:12:59.69,0:13:01.02,Main,,0,0,0,,لِمَ يا ترى؟
Dialogue: 0,0:13:09.60,0:13:11.34,Main,,0,0,0,,!استدعي دولغار يا ميل-تشان
Dialogue: 0,0:13:11.70,0:13:12.59,Main,,0,0,0,,!لا يستجيب
Dialogue: 0,0:13:13.91,0:13:16.87,Main,,0,0,0,,!أستدعيه مرارًا وتكرارًا دون أيّ جدوى
Dialogue: 0,0:13:16.95,0:13:18.21,Main,,0,0,0,,أنظري؟
Dialogue: 0,0:13:18.25,0:13:20.07,Main,,0,0,0,,...مُحال، إذن
Dialogue: 0,0:13:22.30,0:13:23.68,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:13:27.82,0:13:31.01,Main,,0,0,0,,أستكون نهايتي هنا... في مكان كهذا؟
Dialogue: 0,0:13:53.16,0:13:56.38,Main,,0,0,0,,ما الّذي يفعله مدنيّان في مكان كهذا؟
Dialogue: 0,0:13:56.86,0:13:58.01,Main,,0,0,0,,مدنيّان؟
Dialogue: 0,0:13:59.12,0:14:01.29,Main,,0,0,0,,اتبعاني إن أردتما النجاة بحياتكما
Dialogue: 0,0:14:10.59,0:14:11.55,Main,,0,0,0,,اصعدا
Dialogue: 0,0:14:21.39,0:14:23.48,Main,,0,0,0,,أين أنا بالضبط يا ترى؟
Dialogue: 0,0:14:45.08,0:14:48.59,Main,,0,0,0,,بدء عمليّة الضبط، بدء عمليّة الضبط
Dialogue: 0,0:14:56.89,0:14:59.61,Main,,0,0,0,,المستوى الأول: تمّ بنجاح
Dialogue: 0,0:15:00.02,0:15:02.60,Main,,0,0,0,,المستوى الثاني: تمّ بنجاح
Dialogue: 0,0:15:03.10,0:15:04.96,Main,,0,0,0,,...المستوى الثالث
Dialogue: 0,0:15:19.66,0:15:22.44,Main,,0,0,0,,!رُصِد خلل طارئ! رُصِد خلل طارئ
Dialogue: 0,0:15:22.73,0:15:25.83,Main,,0,0,0,,إلغاء التجربة، إلغاء التجربة
Dialogue: 0,0:15:37.18,0:15:40.68,Main,,0,0,0,,تلك كانت نتيجة التجربة السابقة
Dialogue: 0,0:15:40.89,0:15:44.38,Main,,0,0,0,,تكمن المشكلة في مستوى طاقة الأطوار لدى الخاضعين للتجربة كما توقعت
Dialogue: 0,0:15:46.23,0:15:47.65,Main,,0,0,0,,عاد كايل جوزيس
Dialogue: 0,0:15:47.73,0:15:52.57,Main,,0,0,0,,يبدو أنّه أنقذ مدنيّين اثنين عند النقطة D118
Dialogue: 0,0:15:52.90,0:15:55.49,Main,,0,0,0,,عُلِم، انقلوهما إلى غرفة الفحص
Dialogue: 0,0:16:08.17,0:16:12.55,Main,,0,0,0,,نعتذر بشدّة، لكن يتعيّن علينا إخضاعكما للفحص
Dialogue: 0,0:16:12.71,0:16:13.67,Main,,0,0,0,,فحص؟
Dialogue: 0,0:16:13.76,0:16:16.72,Main,,0,0,0,,لا يوجد أيّ خطر، نرجو منكما التعاون معنا
Dialogue: 0,0:16:27.27,0:16:29.10,Main,,0,0,0,,أيتعذّر قياس طاقتهما؟
Dialogue: 0,0:16:29.34,0:16:31.44,Main,,0,0,0,,يتعذّر حساب قيمة طاقة الأطوار لديهما
Dialogue: 0,0:16:31.44,0:16:33.24,Main,,0,0,0,,لا سبيل لمعرفة إن كانت مرتفعة أم منخفضة
Dialogue: 0,0:16:35.40,0:16:38.95,Main,,0,0,0,,لم أرَ أمرًا كهذا من قبل، لعلّ ثمّة أملًا
Dialogue: 0,0:16:40.12,0:16:42.62,Main,,0,0,0,,حسنٌ، سنعيد فحصهما في وقت لاحق
Dialogue: 0,0:16:44.79,0:16:47.08,Main,,0,0,0,,شكرًا لتعاونكما، تفضّلا من هنا
Dialogue: 0,0:16:51.17,0:16:52.34,Main,,0,0,0,,تشرّفتُ بلقائكما
Dialogue: 0,0:16:52.72,0:16:56.73,Main,,0,0,0,,أنا مايفيلد روجنبارنر، مديرة معهد أبحاث الأطوار
Dialogue: 0,0:16:58.26,0:16:59.69,Main,,0,0,0,,!تشبهين ميل-تشان تمامًا
Dialogue: 0,0:17:01.77,0:17:03.64,Main,,0,0,0,,!إنّها تشبهني تمامًا
Dialogue: 0,0:17:04.43,0:17:05.85,Main,,0,0,0,,مرحبًا، أنا ميز
Dialogue: 0,0:17:06.10,0:17:07.68,Main,,0,0,0,,!مُذهل! أأنتِ شخص حقيقيّ؟
Dialogue: 0,0:17:07.71,0:17:11.65,Main,,0,0,0,,أودّ أن أسمع منكما بالتفصيل كيف وصلتما إلى هنا
Dialogue: 0,0:17:11.77,0:17:12.97,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:17:13.71,0:17:15.95,Main,,0,0,0,,فهمتُ، هذا ما حدث إذن
Dialogue: 0,0:17:16.28,0:17:18.32,Main,,0,0,0,,أنتِ قادمةٌ من عالم آخر
Dialogue: 0,0:17:18.45,0:17:20.88,Main,,0,0,0,,أتصدّقين روايتي هذه؟
Dialogue: 0,0:17:21.20,0:17:25.37,Main,,0,0,0,,أجل، فقد رُصدت طاقة الأطوار مريبة عند تلك النقطة
Dialogue: 0,0:17:25.45,0:17:27.29,Main,,0,0,0,,لذا فالأمر ليس مستحيلًا
Dialogue: 0,0:17:27.29,0:17:28.62,Main,,0,0,0,,أين نحن بالضبط؟
Dialogue: 0,0:17:28.76,0:17:30.29,Main,,0,0,0,,ولِمَ تملكون دروع الاصطناعيّة؟
Dialogue: 0,0:17:30.46,0:17:32.60,Main,,0,0,0,,،بناءً على ما رويتِه لي
Dialogue: 0,0:17:32.81,0:17:35.96,Main,,0,0,0,,يبدو أنّ هذا العالم هو ماضي عالمكما على الأرجح
Dialogue: 0,0:17:36.92,0:17:37.88,Main,,0,0,0,,تفضّلا من هنا
Dialogue: 0,0:17:39.97,0:17:43.85,Main,,0,0,0,,حصلت البشريّة على مصدر طاقة جديد كليًا
Dialogue: 0,0:17:44.28,0:17:50.00,Main,,0,0,0,,وهي طاقة جزيئات كامنة في جميع مكوّنات هذا الكوكب، الحية وغير الحية
Dialogue: 0,0:17:50.67,0:17:54.30,Main,,0,0,0,,طاقة لامتناهية، لا تنضب وخالية من أيّ تلوّث
Dialogue: 0,0:17:54.82,0:17:58.94,Main,,0,0,0,,"وقد أطلق الناس على طاقة الجزيئات هذه اسم "الأطوار
Dialogue: 0,0:17:59.24,0:18:01.03,Main,,0,0,0,,هذه هي طاقة الأطوار إذن
Dialogue: 0,0:18:01.45,0:18:02.66,Main,,0,0,0,,تفضّلي من هنا
Dialogue: 0,0:18:10.21,0:18:13.98,Main,,0,0,0,,واكتشفنا أيضًا كائنًا حيًا جديدًا يتغذّى على تلك الجزيئات
Dialogue: 0,0:18:14.70,0:18:18.57,Main,,0,0,0,,،وبدأنا تجارب لإنماء ذلك الكائن وجعله يتكيّف مع كافّة البيئات
Dialogue: 0,0:18:18.57,0:18:22.35,Main,,0,0,0,,وتحويله إلى كائنات آلية شبيهة بالبشر متعدّدة الاستخدامات
Dialogue: 0,0:18:25.79,0:18:28.00,Main,,0,0,0,,!إيّاكِ والعبث يا ميل-تشان
Dialogue: 0,0:18:31.69,0:18:38.73,Main,,0,0,0,,وبضبط طاقة الأطوار وأداء الهيكل، تحوّل الكائن الجديد إلى دروع يقودها البشر
Dialogue: 0,0:18:38.99,0:18:40.62,Main,,0,0,0,,"وهذا ما يُعرف بدروع "الفيل
Dialogue: 0,0:18:40.74,0:18:41.55,Main,,0,0,0,,دروع الفيل؟
Dialogue: 0,0:18:42.40,0:18:45.78,Main,,0,0,0,,تطلقون عليها في عالمكم اسم الدروع الاصطناعيّة على ما أظن
Dialogue: 0,0:18:45.91,0:18:52.96,Main,,0,0,0,,!خطأ! خطأ! ثمّة خطر بتلف البيانات
Dialogue: 0,0:18:53.54,0:18:55.58,Main,,0,0,0,,!إيّاكِ ولمس الأجهزة بمفردكِ يا ميل-تشان
Dialogue: 0,0:19:03.38,0:19:05.39,Main,,0,0,0,,...أعتذر منكم بشدّة
Dialogue: 0,0:19:11.40,0:19:16.00,Main,,0,0,0,,علاوةً على ذلك، حاولنا دمج جزيئات الألوان الخمسة؛ الأحمر، والأزرق، والأبيض، والأخضر، والأصفر
Dialogue: 0,0:19:16.00,0:19:21.64,Main,,0,0,0,,لصناعة الدرع الأقوى الّذي يجمع قوّة الجزيئات الخمس بأكملها
Dialogue: 0,0:19:21.92,0:19:23.53,Main,,0,0,0,,الدرع الأقوى؟
Dialogue: 0,0:19:23.61,0:19:25.88,Main,,0,0,0,,"أجل، درع "الهاي-فيل
Dialogue: 0,0:19:36.29,0:19:38.71,Main,,0,0,0,,،سارت عمليّة التطوير على أكمل وجه
Dialogue: 0,0:19:38.92,0:19:39.78,Main,,0,0,0,,...لكن
Dialogue: 0,0:19:42.86,0:19:45.40,Main,,0,0,0,,انتهى الأمر بأسوأ نتيجة ممكنة
Dialogue: 0,0:19:45.96,0:19:53.04,Main,,0,0,0,,فقد اكتسب درع الهاي-فيل إدراكًا ذاتيًا، وتحوّل إلى الوحش "يومير" الّذي ينشر الدمار والموت
Dialogue: 0,0:19:54.77,0:19:58.44,Main,,0,0,0,,،هيكلها وطريقة تصنيعها وموادّها تظلّ لغزًا غامضًا
Dialogue: 0,0:19:58.83,0:20:02.57,Main,,0,0,0,,وكلّ ما نعرفه هو كيفية تشغيلها بشكل تقريبيّ فقط
Dialogue: 0,0:20:02.78,0:20:06.08,Main,,0,0,0,,امتلاكهم لتقنية صنع الدروع الاصطناعيّة يؤكّد أنّنا في الماضي حتمًا
Dialogue: 0,0:20:07.28,0:20:09.20,Main,,0,0,0,,...ما واجهتموه في عالمكم يا ميز-سان
Dialogue: 0,0:20:09.66,0:20:14.28,Main,,0,0,0,,أعني في مستقبلنا، هو يومير على الأرجح
Dialogue: 0,0:20:14.50,0:20:15.31,Main,,0,0,0,,ذاك الشيء؟
Dialogue: 0,0:20:16.89,0:20:19.76,Main,,0,0,0,,،يعني هذا أنّ يومير لم يُهلك آنذاك على الأرجح
Dialogue: 0,0:20:20.28,0:20:26.00,Main,,0,0,0,,بل ركِب طاقة دولغار وتسبّب في تشويه الزمكان
Dialogue: 0,0:20:26.01,0:20:27.80,Main,,0,0,0,,ولهذا انتُقل بنا إلى الماضي؟
Dialogue: 0,0:20:28.68,0:20:29.72,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:20:32.00,0:20:33.60,Main,,0,0,0,,!كاد ينقطع نَفَسي
Dialogue: 0,0:20:36.48,0:20:41.48,Main,,0,0,0,,وما إن يستعيد يومير كامل قواه، فسيدمّر عالم المستقبل حتمًا
Dialogue: 0,0:20:41.57,0:20:43.15,Main,,0,0,0,,ولن يُبقي منه أثرًا
Dialogue: 0,0:20:43.19,0:20:44.32,Main,,0,0,0,,!مُحال
Dialogue: 0,0:20:45.20,0:20:52.30,Main,,0,0,0,,للأسف، لا تستطيع دروع الفيل العادية أو أسلحة الأطوار مجاراة يومير
Dialogue: 0,0:20:52.40,0:20:57.39,Main,,0,0,0,,إذن، ألا توجد أيّ طريقة لعودتنا إلى عالمنا؟
Dialogue: 0,0:20:57.83,0:20:58.96,Main,,0,0,0,,لا أعلم
Dialogue: 0,0:20:59.00,0:21:02.68,Main,,0,0,0,,،لكن إن دمّرنا يومير المتسبّب بنقلكما إلى هذا العصر تدميرًا كاملًا
Dialogue: 0,0:21:02.78,0:21:06.72,Main,,0,0,0,,فقد تتمكّنان من العودة إلى زمنكما
Dialogue: 0,0:21:08.80,0:21:11.43,Main,,0,0,0,,يسعى يومير إلى محو كلّ شيء وإعادته إلى العدم
Dialogue: 0,0:21:11.85,0:21:12.85,Main,,0,0,0,,...لكن
Dialogue: 0,0:21:13.05,0:21:15.35,Main,,0,0,0,,،الكارثة الّتي جلبناها بأيدينا
Dialogue: 0,0:21:15.60,0:21:18.17,Main,,0,0,0,,يجب أن نضع حدًا لها بأنفسنا
Dialogue: 0,0:21:37.91,0:21:39.04,Main,,0,0,0,,!دولغار
Dialogue: 0,0:24:08.69,0:24:13.64,Main,,0,0,0,,السؤال رقم 1267: لِمَ تستطيع ميل ورفاقها قيادة دولغار يا ترى؟
Dialogue: 0,0:24:14.57,0:24:15.53,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:24:15.92,0:24:19.58,Main,,0,0,0,,!لأنّني البطل المغوار الّذي لا يُقهر بطبيعة الحال
Dialogue: 0,0:24:19.60,0:24:22.85,Main,,0,0,0,,إجابة خاطئة! في الواقع، يبدو أنّ ثمّة سرًّا خطيرًا خلف هذا الأمر
Dialogue: 0,0:24:22.89,0:24:23.66,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:24:24.02,0:24:26.00,Main,,0,0,0,,وما هذا السرّ؟
Dialogue: 0,0:24:26.51,0:24:28.21,Main,,0,0,0,,!ستعرفون ذلك بمشاهدة الحلقة القادمة
Dialogue: 0,0:24:28.65,0:24:29.64,Main,,0,0,0,,!ستعيدينَ الكرّة مجدّدًا؟
Dialogue: 0,0:24:30.17,0:24:32.09,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:32.44,0:24:35.28,Main,,0,0,0,,نزول القدّيس، انطلق يا درع الروم
Dialogue: 0,0:24:35.30,0:24:36.84,Main,,0,0,0,,!لا تفوّتوها
Comment: 0,0:24:36.84,0:24:38.84,Signs,,0,0,0,,
Dialogue: 0,0:03:02.99,0:03:09.00,Signs,,0,0,0,,تحوّلٌ مفاجئ في الأحداث! ميز عبر الزمان
Dialogue: 0,0:24:33.66,0:24:37.62,Signs,,0,0,0,,نزول القدّيس، نهوض درع الروم
