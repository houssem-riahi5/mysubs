Dialogue: 0,0:00:01.31,0:00:02.25,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:19.09,0:02:21.94,Main,,0,0,0,,جئنا لاصطحابكَ يا تاناس-ساما
Dialogue: 0,0:02:28.24,0:02:32.06,Main,,0,0,0,,لكن هل أنتم واثقون من هذا؟ ستُتّهمون بالخيانة العظمى
Dialogue: 0,0:02:32.42,0:02:32.96,Main,,0,0,0,,سحقًا
Dialogue: 0,0:02:33.67,0:02:36.28,Main,,0,0,0,,قرّروا إلقاء لائمة الهزيمة عليكَ وحدكَ
Dialogue: 0,0:02:36.31,0:02:41.02,Main,,0,0,0,,لم يعدْ في قلوبنا ذرة ولاءٍ لذلك الإمبراطور المتعطش للدماء
Dialogue: 0,0:02:41.53,0:02:42.53,Main,,0,0,0,,أليس كذلك يا رفاق؟
Dialogue: 0,0:02:42.53,0:02:43.85,Main,,0,0,0,,!أجل
Dialogue: 0,0:02:44.20,0:02:45.28,Main,,0,0,0,,فهمت
Dialogue: 0,0:02:46.13,0:02:47.83,Main,,0,0,0,,وثمّة أمرٌ آخر
Dialogue: 0,0:02:47.92,0:02:51.68,Main,,0,0,0,,ثمّة تحرّكاتٌ مريبةٌ من طائفة جاينا لاستهداف الأميرة ميل
Dialogue: 0,0:02:54.15,0:02:54.93,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:02:54.95,0:02:57.00,Main,,0,0,0,,!رهبان كاتالينا؟
Dialogue: 0,0:02:57.08,0:02:57.53,Main,,0,0,0,,أجل
Dialogue: 0,0:02:58.80,0:03:00.68,Main,,0,0,0,,بدأ هؤلاء الأوغاد بالتحرّك إذن
Dialogue: 0,0:03:01.42,0:03:04.62,Main,,0,0,0,,لن تفلتي بفعلتكِ هذه المرّة أيّتها الأميرة ميل
Dialogue: 0,0:03:05.82,0:03:07.53,Main,,0,0,0,,وكذلك أنتَ يا ميز
Dialogue: 0,0:03:20.04,0:03:21.66,Main,,0,0,0,,!بارد
Dialogue: 0,0:03:21.94,0:03:24.86,Main,,0,0,0,,!أسرعي إلى هنا يا أونيه-ني-ساما
Dialogue: 0,0:03:24.91,0:03:27.07,Main,,0,0,0,,!الماء منعشٌ للغاية
Dialogue: 0,0:03:28.88,0:03:31.49,Main,,0,0,0,,يا لها من أميرةٍ خالية البال
Dialogue: 0,0:03:31.53,0:03:34.91,Main,,0,0,0,,أتلهو بالماء بينما يطاردها الأعداء؟
Dialogue: 0,0:03:34.99,0:03:36.37,Main,,0,0,0,,لا تقولي ذلك
Dialogue: 0,0:03:36.41,0:03:40.54,Main,,0,0,0,,بمجرد اجتياز سلسلة جبال روديوراني، ستغدو مملكة بيستال قاب قوسين أو أدنى
Dialogue: 0,0:03:40.79,0:03:44.92,Main,,0,0,0,,!أجل، فملكة بيستال هي عمّة ميل-سان
Dialogue: 0,0:03:45.00,0:03:48.00,Main,,0,0,0,,واثقةٌ من أنّها ستمدُّ يد العون لميل-سان
Dialogue: 0,0:03:48.63,0:03:52.47,Main,,0,0,0,,أجل، عليَّ حماية ميل-تشان حتّى ذلك الحين
Dialogue: 0,0:03:58.30,0:04:03.86,Main,,0,0,0,,أدركُ تمامًا أنَّ عليَّ قتال طائفة جاينا لحماية ميل-تشان
Dialogue: 0,0:04:04.28,0:04:05.35,Main,,0,0,0,,...لكنّي
Dialogue: 0,0:04:05.86,0:04:09.42,Main,,0,0,0,,لكنّي أأبى ركوب تلك الآلة المُرعبة مجدّدًا
Dialogue: 0,0:04:10.13,0:04:11.56,Main,,0,0,0,,...أونيه-ني-ساما
Dialogue: 0,0:04:12.60,0:04:13.48,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:04:14.04,0:04:19.02,Main,,0,0,0,,إن رأيتكِ حزينةً هكذا فسيصيبني الحزن أنا الأخرى
Dialogue: 0,0:04:20.58,0:04:21.80,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:04:22.22,0:04:24.37,Main,,0,0,0,,لا تقلقي يا ميل-تشان
Dialogue: 0,0:04:24.42,0:04:27.17,Main,,0,0,0,,لن أسمح للحزن بأن يتسلّل إلى قلبكِ أبدًا
Dialogue: 0,0:04:27.25,0:04:28.46,Main,,0,0,0,,!هذا مطمئن
Dialogue: 0,0:04:28.55,0:04:31.97,Main,,0,0,0,,!إذن، لنتجرّد من ملابسنا ونستحمّ معًا
Dialogue: 0,0:04:32.17,0:04:33.92,Main,,0,0,0,,!مهلًا يا ميل-تشان
Dialogue: 0,0:04:34.42,0:04:37.08,Main,,0,0,0,,لا يسعكِ الرفض إن طلبتْ الأميرة ذلك
Dialogue: 0,0:04:37.11,0:04:40.05,Main,,0,0,0,,هل أساعدكِ في خلع ملابسكِ؟
Dialogue: 0,0:04:40.13,0:04:41.88,Main,,0,0,0,,!مـ-مهلًا
Dialogue: 0,0:04:48.28,0:04:49.33,Main,,0,0,0,,ما الأمر؟
Dialogue: 0,0:04:50.19,0:04:51.75,Main,,0,0,0,,!ا-النجدة
Dialogue: 0,0:04:51.91,0:04:53.75,Main,,0,0,0,,!وجدتها! من هنا
Dialogue: 0,0:04:55.44,0:04:56.75,Main,,0,0,0,,!لا
Dialogue: 0,0:04:57.08,0:04:58.51,Main,,0,0,0,,من أنتم؟
Dialogue: 0,0:04:58.86,0:05:00.53,Main,,0,0,0,,بل من أنتم؟
Dialogue: 0,0:05:00.55,0:05:03.02,Main,,0,0,0,,يتعقّب رجالٌ بالغون فتاةً بمفردها؟
Dialogue: 0,0:05:03.11,0:05:03.73,Main,,0,0,0,,!اخرسي
Dialogue: 0,0:05:04.06,0:05:06.16,Main,,0,0,0,,أتنوون التمرّد علينا نحن قبيلة الزوكو؟
Dialogue: 0,0:05:06.53,0:05:08.12,Main,,0,0,0,,قبيلة الزوكو؟
Dialogue: 0,0:05:08.35,0:05:09.57,Main,,0,0,0,,!لا يهمّ
Dialogue: 0,0:05:09.68,0:05:11.44,Main,,0,0,0,,!سنقضي عليكم جميعًا دفعةً واحدة
Dialogue: 0,0:05:11.62,0:05:14.11,Main,,0,0,0,,من سيقضي على من؟
Dialogue: 0,0:05:14.20,0:05:16.17,Main,,0,0,0,,لم أسمعكَ جيّدًا
Dialogue: 0,0:05:16.20,0:05:18.57,Main,,0,0,0,,!كيف تجرؤون على التطاول علينا؟
Dialogue: 0,0:05:18.71,0:05:20.06,Main,,0,0,0,,!اقضوا عليهم
Dialogue: 0,0:05:26.81,0:05:28.19,Main,,0,0,0,,...أيّها الـ
Dialogue: 0,0:05:28.95,0:05:29.97,Main,,0,0,0,,!مهلًا
Dialogue: 0,0:05:31.84,0:05:33.57,Main,,0,0,0,,!لا تقترب
Dialogue: 0,0:05:39.88,0:05:41.23,Main,,0,0,0,,!آ-آسفة
Dialogue: 0,0:05:41.62,0:05:42.73,Main,,0,0,0,,!إنّها فولنار
Dialogue: 0,0:05:43.03,0:05:44.75,Main,,0,0,0,,!النجدة
Dialogue: 0,0:05:46.58,0:05:49.06,Main,,0,0,0,,لا داعي لكلّ هذا الذعر
Dialogue: 0,0:05:50.20,0:05:52.24,Main,,0,0,0,,!تبدين رائعةً يا أونيه-ني-ساما
Dialogue: 0,0:05:52.66,0:05:54.42,Main,,0,0,0,,!أنا في غاية الانبهار
Dialogue: 0,0:05:54.42,0:05:55.40,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:05:55.53,0:05:56.80,Main,,0,0,0,,!أنتِ تسحقينني
Dialogue: 0,0:06:34.35,0:06:37.04,Main,,0,0,0,,ما الأمر يا داي؟ هل أنتَ جائع؟
Dialogue: 0,0:06:37.55,0:06:39.33,Main,,0,0,0,,حسنٌ، حسنٌ، لا تبكِ يا داي
Dialogue: 0,0:06:47.22,0:06:49.62,Main,,0,0,0,,أنتِ فولنار يا ميز-سان؟
Dialogue: 0,0:06:50.14,0:06:52.73,Main,,0,0,0,,...أن تكون منقذة حياة ابنتي فولنار
Dialogue: 0,0:06:52.77,0:06:56.10,Main,,0,0,0,,فقد زادنا ذلك حلفاء نعتمد عليهم حقًّا
Dialogue: 0,0:06:58.20,0:07:05.57,Main,,0,0,0,,!وفضلًا عن ذلك، سبق لأونيه-ني-ساما أن سحقتْ درعًا اصطناعيًّا بالغ القوّة لإنقاذي
Dialogue: 0,0:07:07.23,0:07:08.69,Main,,0,0,0,,...ناهيكَ عن أنّها
Dialogue: 0,0:07:08.75,0:07:10.04,Main,,0,0,0,,...مـ-ميل-تشان
Dialogue: 0,0:07:10.68,0:07:13.64,Main,,0,0,0,,في الواقع أيّها الزعيم، لستُ بتلك القوّة
Dialogue: 0,0:07:14.66,0:07:16.57,Main,,0,0,0,,!أنا متأثرٌ حقًّا
Dialogue: 0,0:07:16.88,0:07:19.87,Main,,0,0,0,,!أخيرًا، يسعنا إعلان الحرب على قبيلة الزوكو البغيضة
Dialogue: 0,0:07:21.08,0:07:25.37,Main,,0,0,0,,طوال السنوات الماضية، عاثت قبيلة الزوكو فسادًا في القرى المجاورة
Dialogue: 0,0:07:25.37,0:07:28.60,Main,,0,0,0,,وسيطروا على هذه الأنحاء بلا منازع
Dialogue: 0,0:07:28.85,0:07:32.85,Main,,0,0,0,,ولم نعلم متى سيهاجمون قريتنا لورس هذه
Dialogue: 0,0:07:33.37,0:07:37.10,Main,,0,0,0,,!لكنَّ أيام العيش في رعبٍ من هؤلاء الأوغاد في لورس قد ولّت
Dialogue: 0,0:07:37.65,0:07:39.80,Top,,0,0,0,,!المعذرة أيّها الزعيم
Dialogue: 0,0:07:37.26,0:07:41.48,Main,,0,0,0,,!لم أكن أطمع أن يظهر منقذونا بهذه السرعة
Dialogue: 0,0:07:40.82,0:07:42.51,Top,,0,0,0,,...مهلًا
Dialogue: 0,0:07:41.57,0:07:43.66,Main,,0,0,0,,!حان وقت الانتفاض
Dialogue: 0,0:07:43.71,0:07:45.82,Main,,0,0,0,,!النصر حليفنا
Dialogue: 0,0:07:44.48,0:07:45.80,Top,,0,0,0,,إنّه لا يُصغي أبدًا
Dialogue: 0,0:07:46.20,0:07:47.44,Main,,0,0,0,,يا إلهي
Dialogue: 0,0:07:47.44,0:07:50.46,Main,,0,0,0,,خلاصة القول، يريدنا أن نغدو حرّاسهم الشخصيّين
Dialogue: 0,0:07:50.80,0:07:55.26,Main,,0,0,0,,لكنّي ظننتُ أنَّ قبيلة الزوكو أناسٌ مسالمون
Dialogue: 0,0:07:55.37,0:07:59.30,Main,,0,0,0,,هذا يثبت مدى انحطاط الزمن الّذي نعيشه فحسب
Dialogue: 0,0:08:00.67,0:08:03.01,Main,,0,0,0,,،ما دمتُ مع أونيه-ني-ساما
Dialogue: 0,0:08:03.01,0:08:06.11,Main,,0,0,0,,!فلا أمانع أن أغدو حارسةً شخصيّةً أو حتّى حمقاء
Dialogue: 0,0:08:06.28,0:08:08.08,Main,,0,0,0,,أليس كذلك يا أونيه-ني-ساما؟
Dialogue: 0,0:08:09.93,0:08:11.10,Main,,0,0,0,,أونيه-ني-ساما؟
Dialogue: 0,0:08:16.69,0:08:21.28,Main,,0,0,0,,!ها قد أُقحمنا في معركةٍ أخرى
Dialogue: 0,0:08:23.99,0:08:25.56,Main,,0,0,0,,تفضّل هذه تاليًا
Dialogue: 0,0:08:27.91,0:08:30.83,Main,,0,0,0,,لِمَ أنا هنا يا ترى؟
Dialogue: 0,0:08:31.97,0:08:33.55,Main,,0,0,0,,ما الأمر؟ ما الأمر؟ ما الأمر؟
Dialogue: 0,0:08:35.66,0:08:36.88,Main,,0,0,0,,!طفلٌ رضيع؟
Dialogue: 0,0:08:36.88,0:08:38.46,Main,,0,0,0,,ما الّذي تفعله هنا؟
Dialogue: 0,0:08:39.20,0:08:40.97,Main,,0,0,0,,حسنٌ، حسنٌ
Dialogue: 0,0:08:41.92,0:08:44.02,Main,,0,0,0,,لا تبكِ أيّها الصغير
Dialogue: 0,0:08:44.31,0:08:45.76,Main,,0,0,0,,أين والدتكَ يا تُرى؟
Dialogue: 0,0:08:48.51,0:08:51.64,Main,,0,0,0,,كفّ عن البكاء، لا بأس
Dialogue: 0,0:08:56.35,0:08:57.77,Main,,0,0,0,,يا للراحة
Dialogue: 0,0:09:00.55,0:09:01.75,Main,,0,0,0,,من أنتِ؟
Dialogue: 0,0:09:09.40,0:09:10.83,Main,,0,0,0,,...ساسانا
Dialogue: 0,0:09:12.24,0:09:16.26,Main,,0,0,0,,...آسفة، بدأ بالبكاء، لذا قمتُ
Dialogue: 0,0:09:16.44,0:09:17.84,Main,,0,0,0,,بالمناسبة، من أنتَ؟
Dialogue: 0,0:09:19.11,0:09:20.60,Main,,0,0,0,,اسمي سابر
Dialogue: 0,0:09:21.08,0:09:22.55,Main,,0,0,0,,أنا والده
Dialogue: 0,0:09:23.46,0:09:26.24,Main,,0,0,0,,أأنتِ الحارسة الشخصيّة الجديدة؟
Dialogue: 0,0:09:26.55,0:09:28.62,Main,,0,0,0,,...كلّا، أنا
Dialogue: 0,0:09:31.62,0:09:33.48,Main,,0,0,0,,جلبتُ له بعض الماء الدافئ
Dialogue: 0,0:09:33.48,0:09:34.97,Main,,0,0,0,,يمكنكَ الشرب الآن
Dialogue: 0,0:09:35.64,0:09:37.64,Main,,0,0,0,,!لا، لا
Dialogue: 0,0:09:37.64,0:09:38.31,Main,,0,0,0,,داي
Dialogue: 0,0:09:38.64,0:09:41.26,Main,,0,0,0,,يُسعدني تولّي الأمر إن لم تمانع
Dialogue: 0,0:09:41.35,0:09:42.32,Main,,0,0,0,,شكرًا
Dialogue: 0,0:09:46.06,0:09:47.74,Main,,0,0,0,,أنتَ تشربُ بسرعة
Dialogue: 0,0:09:48.57,0:09:52.73,Main,,0,0,0,,كيف يلوّحون بالسيوف ويتقاتلون أمام طفلٍ ظريفٍ كهذا؟
Dialogue: 0,0:09:53.55,0:09:59.66,Main,,0,0,0,,لا بُدَّ من وجود طريقةٍ أخرى لتسوية النزاع بين قبيلتي اللورس والزوكو
Dialogue: 0,0:09:59.75,0:10:01.45,Main,,0,0,0,,طريقةٌ سلميّةٌ بلا قتالٍ
Dialogue: 0,0:10:02.21,0:10:05.67,Main,,0,0,0,,أمقتُ القتال حقًّا
Dialogue: 0,0:10:05.80,0:10:07.26,Main,,0,0,0,,أنتِ طيّبة القلب
Dialogue: 0,0:10:07.48,0:10:08.37,Main,,0,0,0,,...لكن
Dialogue: 0,0:10:08.48,0:10:08.91,Main,,0,0,0,,عفوًا؟
Dialogue: 0,0:10:09.55,0:10:13.00,Main,,0,0,0,,ثمّة أمورٌ لا يسعكِ حلّها باللّطف وحده
Dialogue: 0,0:10:15.26,0:10:16.85,Main,,0,0,0,,...هذا
Dialogue: 0,0:10:17.68,0:10:20.82,Main,,0,0,0,,وهل من نزاعٍ يُحلُّ بالعنف متجردًا من اللطف؟
Dialogue: 0,0:10:21.06,0:10:23.48,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:10:27.13,0:10:28.44,Main,,0,0,0,,أليس هذا رائعًا؟
Dialogue: 0,0:10:28.53,0:10:32.20,Main,,0,0,0,,!نبدو كزوجين شابين سعيدين مع طفلهما
Dialogue: 0,0:10:32.74,0:10:34.95,Main,,0,0,0,,...مُـ-مُحال
Dialogue: 0,0:10:35.13,0:10:37.15,Main,,0,0,0,,!كلّا، لن أسمح بهذا أبدًا
Dialogue: 0,0:10:37.31,0:10:39.35,Main,,0,0,0,,!أونيه-ني-ساما ملكي وحدي
Dialogue: 0,0:10:39.51,0:10:42.55,Main,,0,0,0,,!أريدها أن تحملني أنا أيضًا
Dialogue: 0,0:10:42.12,0:10:43.08,Top,,0,0,0,,!مهلًا
Dialogue: 0,0:10:45.28,0:10:47.17,Main,,0,0,0,,!سأجهش بالبكاء أنا الأخرى
Dialogue: 0,0:10:48.93,0:10:50.44,Main,,0,0,0,,أتدرين؟
Dialogue: 0,0:10:50.62,0:10:52.29,Main,,0,0,0,,أنا من يجدر بها البكاء
Dialogue: 0,0:10:56.47,0:10:59.06,Main,,0,0,0,,...إنّها تشبهها كثيرًا
Dialogue: 0,0:11:10.95,0:11:12.53,Main,,0,0,0,,!أصغوا إليَّ يا رجال
Dialogue: 0,0:11:12.61,0:11:19.28,Main,,0,0,0,,يظنّ أوغاد لورس أنّهم قادرون على مقاومتنا نحن قبيلة الزوكو باستئجار حرّاسٍ جدد
Dialogue: 0,0:11:19.33,0:11:20.54,Main,,0,0,0,,!مثيرون للشفقة
Dialogue: 0,0:11:20.62,0:11:23.21,Main,,0,0,0,,!سنُحرق قريتهم عن بكرة أبيها
Dialogue: 0,0:11:26.06,0:11:30.31,Main,,0,0,0,,لطالما استمتعتُ بإلقاء هذه الخطابات كزعيمٍ للقبيلة
Dialogue: 0,0:11:30.46,0:11:32.13,Main,,0,0,0,,!معذرةً يا بوسمان-ساما
Dialogue: 0,0:11:33.77,0:11:35.46,Main,,0,0,0,,...بشأن رسوم المعلومات
Dialogue: 0,0:11:35.82,0:11:39.84,Main,,0,0,0,,تجنّشمنا الكثير من العناء لنجلب لك هذه المعلومات
Dialogue: 0,0:11:40.51,0:11:41.91,Main,,0,0,0,,!هذا صحيح
Dialogue: 0,0:11:42.12,0:11:42.92,Main,,0,0,0,,تسوروغي
Dialogue: 0,0:11:43.88,0:11:46.73,Main,,0,0,0,,سأمنحكم مكافأةً خاصّةً
Dialogue: 0,0:12:01.75,0:12:05.58,Main,,0,0,0,,كم شخصًا سأُرديه قتيلًا هذه المرّة يا تُرى؟
Dialogue: 0,0:12:06.04,0:12:08.67,Main,,0,0,0,,أنا في غاية الشوق لذلك حقًّا
Dialogue: 0,0:12:49.75,0:12:51.25,Main,,0,0,0,,!نتعرّض لهجوم
Dialogue: 0,0:12:55.34,0:12:57.09,Main,,0,0,0,,!ما الّذي يحدث؟
Dialogue: 0,0:12:57.51,0:13:00.88,Main,,0,0,0,,!نحن في ورطةٍ، قبيلة الزوكو تهاجمنا
Dialogue: 0,0:13:01.31,0:13:03.11,Main,,0,0,0,,!أتوا حقًّا؟
Dialogue: 0,0:13:03.20,0:13:04.63,Main,,0,0,0,,!أنقذونا
Dialogue: 0,0:13:09.06,0:13:12.31,Main,,0,0,0,,إحراق هذه القرية أمرٌ في غاية السهولة
Dialogue: 0,0:13:24.54,0:13:26.96,Main,,0,0,0,,انتهى وقت لعبكم
Dialogue: 0,0:13:30.46,0:13:32.45,Main,,0,0,0,,عودوا إلى دياركم واخلدوا للنوم
Dialogue: 0,0:13:38.33,0:13:40.66,Main,,0,0,0,,!أغلقوا أفواهكم
Dialogue: 0,0:13:40.86,0:13:43.46,Main,,0,0,0,,أفسدتم وقتي الخاصّ
Dialogue: 0,0:13:43.50,0:13:45.34,Main,,0,0,0,,ماذا قلتَ أيّها الوغد؟
Dialogue: 0,0:13:46.04,0:13:47.18,Main,,0,0,0,,اسمعيني يا ميل
Dialogue: 0,0:13:47.27,0:13:50.98,Main,,0,0,0,,كوني فتاةً مطيعةً وانتظري حتّى أقضي عليهم
Dialogue: 0,0:13:51.11,0:13:53.06,Main,,0,0,0,,!حاضر يا أونيه-ني-ساما
Dialogue: 0,0:13:53.22,0:13:54.51,Main,,0,0,0,,!كم أنتَ رائعٌ
Dialogue: 0,0:13:54.61,0:13:57.55,Main,,0,0,0,,مزاجي متعكّرٌ لتأخّر ظهوري اليوم
Dialogue: 0,0:13:57.68,0:13:59.68,Main,,0,0,0,,!لذا سأنهي الأمر سريعًا
Dialogue: 0,0:14:02.83,0:14:04.26,Main,,0,0,0,,!خذوا هذا
Dialogue: 0,0:14:03.17,0:14:04.41,Top,,0,0,0,,!توقّفوا
Dialogue: 0,0:14:04.34,0:14:05.45,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:14:08.25,0:14:09.33,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:14:11.00,0:14:12.88,Main,,0,0,0,,!ما الّذي تفعلينه يا ميز؟
Dialogue: 0,0:14:13.02,0:14:14.75,Main,,0,0,0,,!لِمَ تقفين في طريقي أنتِ الأخرى؟
Dialogue: 0,0:14:15.00,0:14:16.66,Main,,0,0,0,,!يُمنع القتل
Dialogue: 0,0:14:16.73,0:14:18.82,Main,,0,0,0,,اهدؤوا وناقشوا الأمور بتروٍّ
Dialogue: 0,0:14:18.88,0:14:20.50,Main,,0,0,0,,!عليكَ تقديم بعض التنازلات
Dialogue: 0,0:14:21.60,0:14:24.08,Main,,0,0,0,,نناقش؟ وتنازلات؟
Dialogue: 0,0:14:24.17,0:14:26.47,Main,,0,0,0,,!ليس هذا وقتها أيّتها الحمقاء
Dialogue: 0,0:14:26.88,0:14:28.77,Main,,0,0,0,,!حـ-حمقاء؟ كيف تجرؤ
Dialogue: 0,0:14:28.81,0:14:32.98,Main,,0,0,0,,!عمومًا، أمقتُ القتال والقتل، وأمقتكَ أنتَ أكثر من أيّ شيءٍ آخر
Dialogue: 0,0:14:33.48,0:14:35.15,Main,,0,0,0,,!ما الّذي تتفوهين به؟
Dialogue: 0,0:14:35.55,0:14:37.11,Main,,0,0,0,,!اصمتِ فحسب
Dialogue: 0,0:14:37.13,0:14:39.40,Main,,0,0,0,,!لا تملي عليَّ ما يجب فعله
Dialogue: 0,0:14:39.61,0:14:41.35,Main,,0,0,0,,!من تظنّ نفسك أيّتها الطفل
Dialogue: 0,0:14:48.00,0:14:49.06,Main,,0,0,0,,!سابر-سان
Dialogue: 0,0:14:50.42,0:14:52.26,Main,,0,0,0,,!إيّاكَ وتشتيت انتباهكَ أثناء المعركة
Dialogue: 0,0:14:52.50,0:14:53.20,Main,,0,0,0,,!اصمت
Dialogue: 0,0:14:53.24,0:14:54.66,Main,,0,0,0,,!أعلم ذلك جيّدًا
Dialogue: 0,0:14:54.92,0:14:58.62,Main,,0,0,0,,!أجل، أجل! لم يطلب أحدٌ مساعدتكَ
Dialogue: 0,0:14:59.21,0:15:00.58,Main,,0,0,0,,لا تموتي
Dialogue: 0,0:15:05.18,0:15:06.47,Main,,0,0,0,,...سابر-سان
Dialogue: 0,0:15:12.15,0:15:14.80,Main,,0,0,0,,!إنّه درع اصطناعيّ متوسّط
Dialogue: 0,0:15:14.93,0:15:16.90,Main,,0,0,0,,لديهم واحدٌ إذن
Dialogue: 0,0:15:18.28,0:15:19.27,Main,,0,0,0,,!ها أنا ذا
Dialogue: 0,0:15:24.82,0:15:26.65,Main,,0,0,0,,!إنّه الطور الزمرديّ
Dialogue: 0,0:15:34.04,0:15:36.68,Main,,0,0,0,,لهذا لا يسعني التوقف عن خوض الحروب
Dialogue: 0,0:15:38.37,0:15:40.34,Main,,0,0,0,,!سوليود-سان، أستر-سان
Dialogue: 0,0:15:41.82,0:15:43.31,Main,,0,0,0,,!احترقوا جميعًا
Dialogue: 0,0:15:43.48,0:15:44.91,Main,,0,0,0,,!ذلك الوغد
Dialogue: 0,0:15:45.24,0:15:47.75,Main,,0,0,0,,كيف يجرؤ على إثارة الفوضى أمامي؟
Dialogue: 0,0:15:53.24,0:15:54.55,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:15:54.60,0:15:55.85,Main,,0,0,0,,!استدعي دولغر يا ميل
Dialogue: 0,0:15:56.23,0:15:58.06,Main,,0,0,0,,!سأسحق ذلك الوغد
Dialogue: 0,0:15:58.65,0:15:59.73,Main,,0,0,0,,!حاضر
Dialogue: 0,0:16:01.68,0:16:06.41,Main,,0,0,0,,!رورو، فارنا، هاي، فامون، را، فو
Dialogue: 0,0:16:17.15,0:16:18.04,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:16:18.17,0:16:19.48,Main,,0,0,0,,!حاولي مجدّدًا يا ميل
Dialogue: 0,0:16:21.44,0:16:26.02,Main,,0,0,0,,!رورو، فارنا، هاي، فامون، را، فو
Dialogue: 0,0:16:35.73,0:16:36.71,Main,,0,0,0,,!مُحال
Dialogue: 0,0:16:37.78,0:16:39.90,Main,,0,0,0,,!لِمَ لا يظهر دولغر؟
Dialogue: 0,0:16:40.11,0:16:41.53,Main,,0,0,0,,لا أعلم
Dialogue: 0,0:16:41.60,0:16:42.82,Main,,0,0,0,,لم يحدث هذا من قبل
Dialogue: 0,0:16:43.34,0:16:44.35,Main,,0,0,0,,...لعلّ
Dialogue: 0,0:16:44.61,0:16:45.24,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:16:45.44,0:16:47.31,Main,,0,0,0,,أهو معطّلٌ أم ماذا؟
Dialogue: 0,0:16:47.57,0:16:51.62,Main,,0,0,0,,لعلّ دولغر لم يتزامن مع أفكارك
Dialogue: 0,0:16:51.93,0:16:53.35,Main,,0,0,0,,ماذا تعنين بذلك؟
Dialogue: 0,0:16:53.51,0:16:56.88,Main,,0,0,0,,يستجيب دولغر لأفكاركَ ويتزامن معها
Dialogue: 0,0:16:56.88,0:16:57.44,Main,,0,0,0,,...لذا
Dialogue: 0,0:16:57.48,0:16:59.17,Main,,0,0,0,,لذا ماذا؟
Dialogue: 0,0:16:59.25,0:17:03.97,Main,,0,0,0,,،لذا، إن كانت أقصى أمانيكَ هي مغادرة هذا العالم
Dialogue: 0,0:17:04.34,0:17:07.18,Main,,0,0,0,,فلن يتمكّن دولغر من التزامن معك
Dialogue: 0,0:17:07.26,0:17:08.71,Main,,0,0,0,,أمانيّ هي مغادرة هذا العالم؟
Dialogue: 0,0:17:08.82,0:17:11.42,Main,,0,0,0,,أهذا بسببي؟
Dialogue: 0,0:17:14.97,0:17:16.17,Main,,0,0,0,,...أونيه-ني-ساما
Dialogue: 0,0:17:16.26,0:17:19.86,Main,,0,0,0,,!ألم تعودي تكترثين لهذا العالم؟ أو لي أنا؟
Dialogue: 0,0:17:20.44,0:17:21.44,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:17:21.65,0:17:23.44,Main,,0,0,0,,انظري يا ميز
Dialogue: 0,0:17:24.53,0:17:28.02,Main,,0,0,0,,!انظري إلى ما تسبّب به تدخّلكِ
Dialogue: 0,0:17:30.44,0:17:31.73,Main,,0,0,0,,...لـ-لكن
Dialogue: 0,0:17:31.73,0:17:32.46,Main,,0,0,0,,!اصمتِ
Dialogue: 0,0:17:32.46,0:17:33.24,Main,,0,0,0,,!ابقِ بعيدةً عن هذا
Dialogue: 0,0:17:33.44,0:17:37.16,Main,,0,0,0,,!لطفكِ المزيّف هذا لن يحلّ شيئًا
Dialogue: 0,0:17:39.00,0:17:42.67,Main,,0,0,0,,ثمّة أمورٌ لا يسعكِ حلّها باللّطف وحده
Dialogue: 0,0:17:44.06,0:17:45.84,Main,,0,0,0,,...سابر-سان
Dialogue: 0,0:17:53.01,0:17:54.92,Main,,0,0,0,,!أونيه-ني-ساما، طوركَ
Dialogue: 0,0:17:55.13,0:17:57.80,Main,,0,0,0,,!حسنٌ، حان وقت التنفيس عن غضبي
Dialogue: 0,0:18:07.00,0:18:08.31,Main,,0,0,0,,ثابر
Dialogue: 0,0:18:11.51,0:18:13.12,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:18:13.24,0:18:15.03,Main,,0,0,0,,!اصمتِ، وكفّي عن الذعر
Dialogue: 0,0:18:16.26,0:18:19.25,Main,,0,0,0,,إلى متى يسعكَ الصمود يا تُرى؟
Dialogue: 0,0:18:24.02,0:18:28.21,Main,,0,0,0,,آمل ألّا تكون قد نسيتني
Dialogue: 0,0:18:31.01,0:18:32.64,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:18:32.64,0:18:35.22,Main,,0,0,0,,!حان وقت ردّ الدّين
Dialogue: 0,0:18:35.81,0:18:39.35,Main,,0,0,0,,!رورو، لاجو، باجورا، ماها، أجوني
Dialogue: 0,0:18:41.03,0:18:43.91,Main,,0,0,0,,!فايغر
Dialogue: 0,0:18:58.33,0:18:59.37,Main,,0,0,0,,!فعلتها
Dialogue: 0,0:18:59.40,0:19:01.03,Main,,0,0,0,,!كما هو متوقع من أونيه-ني-ساما
Dialogue: 0,0:19:04.97,0:19:06.75,Main,,0,0,0,,!هذا غير منطقيّ
Dialogue: 0,0:19:07.08,0:19:09.76,Main,,0,0,0,,لم أكن أعلم أنّ لورس بهذه القوّة
Dialogue: 0,0:19:10.13,0:19:11.91,Main,,0,0,0,,!تـ-تراجعوا
Dialogue: 0,0:19:12.76,0:19:14.05,Main,,0,0,0,,!بوسمان
Dialogue: 0,0:19:15.40,0:19:16.76,Main,,0,0,0,,تشاكرام؟
Dialogue: 0,0:19:19.91,0:19:23.31,Main,,0,0,0,,!حسنٌ، لنزِل بقيّة هذه الحثالة
Dialogue: 0,0:19:34.24,0:19:35.74,Main,,0,0,0,,من هؤلاء؟
Dialogue: 0,0:19:36.06,0:19:38.66,Main,,0,0,0,,!إنّهم رهبان كاتالينا
Dialogue: 0,0:19:38.70,0:19:39.86,Main,,0,0,0,,من هؤلاء؟
Dialogue: 0,0:19:40.15,0:19:43.79,Main,,0,0,0,,!إنّهم قتلةٌ مُرعبون يتبعون طائفة جاينا
Dialogue: 0,0:19:44.37,0:19:45.51,Main,,0,0,0,,!جاينا؟
Dialogue: 0,0:19:45.80,0:19:49.29,Main,,0,0,0,,أتقصدين أنَّ جاينا تقف خلف هذا الهجوم برمّته؟
Dialogue: 0,0:19:59.28,0:20:00.88,Main,,0,0,0,,!أيها الوغد
Dialogue: 0,0:20:05.77,0:20:07.47,Main,,0,0,0,,!هرب
Dialogue: 0,0:20:15.99,0:20:17.66,Main,,0,0,0,,!تبًّا لكَ يا بوسمان
Dialogue: 0,0:20:18.13,0:20:20.17,Main,,0,0,0,,!سأثأر حتمًا
Dialogue: 0,0:20:22.62,0:20:27.21,Main,,0,0,0,,!سوليود-سان، سوليود-سان
Dialogue: 0,0:20:27.75,0:20:31.93,Main,,0,0,0,,أغلب الظنّ أنَّ قبيلة الزوكو قد أسرتها
Dialogue: 0,0:20:32.00,0:20:34.46,Main,,0,0,0,,!تبًّا، تبًّا، تبًّا، تبًّا
Dialogue: 0,0:20:34.55,0:20:36.17,Main,,0,0,0,,!أنا في قمّة الغضب
Dialogue: 0,0:20:37.31,0:20:40.60,Main,,0,0,0,,لا تغضب هكذا يا أونيه-ني-ساما
Dialogue: 0,0:20:43.98,0:20:45.82,Main,,0,0,0,,إنّه خطأي
Dialogue: 0,0:20:46.31,0:20:49.53,Main,,0,0,0,,بسبب تردّدي، أُسرتْ سوليود-سان
Dialogue: 0,0:21:01.31,0:21:03.55,Main,,0,0,0,,هُزمتُ؟
Dialogue: 0,0:21:05.11,0:21:07.55,Main,,0,0,0,,أهُزمتُ أمام هؤلاء الحثالة؟
Dialogue: 0,0:21:07.87,0:21:10.71,Main,,0,0,0,,أترغب في هزيمة ذلك الفولنار؟
Dialogue: 0,0:21:10.71,0:21:11.29,Main,,0,0,0,,من هناك؟
Dialogue: 0,0:21:12.11,0:21:16.00,Main,,0,0,0,,إن كنتَ ترغب في هزيمته، فيسعني منحكَ القوّة
Dialogue: 0,0:21:16.88,0:21:18.22,Main,,0,0,0,,ما قولك؟
Dialogue: 0,0:21:24.82,0:21:27.93,Main,,0,0,0,,امنحني القوّة لأذبحهم جميعًا
Dialogue: 0,0:21:28.53,0:21:31.86,Main,,0,0,0,,!سأبيع روحي للشيطان مقابل ذلك
Dialogue: 0,0:21:32.26,0:21:35.93,Main,,0,0,0,,سآخذكَ بكلمتكَ إذن
Dialogue: 0,0:21:37.24,0:21:38.15,Main,,0,0,0,,...أنتَ
Dialogue: 0,0:22:02.10,0:22:03.68,Main,,0,0,0,,!أنا مثيرةٌ للشفقة
Dialogue: 0,0:24:09.46,0:24:11.48,Main,,0,0,0,,!سيّداتي وسادتي
Dialogue: 0,0:24:12.29,0:24:17.42,Main,,0,0,0,,يكشف سابر عن سرٍّ صادمٍ، ما الماضي الّذي يخفيه يا تُرى؟
Dialogue: 0,0:24:17.96,0:24:21.34,Main,,0,0,0,,وفجأةً، يُهاجم درع اصطناعيّ غامضٌ
Dialogue: 0,0:24:21.47,0:24:24.93,Main,,0,0,0,,ما الّذي سيحلّ بميز الّتي عجزتْ عن التحكّم بدولغر؟
Dialogue: 0,0:24:25.85,0:24:27.68,Main,,0,0,0,,اكتشفوا بقيّة القصّة في الحلقة القادمة
Dialogue: 0,0:24:27.77,0:24:29.85,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:29.87,0:24:32.27,Main,,0,0,0,,!درع الروم العاشق الّذي لا يُقهر
Dialogue: 0,0:24:33.19,0:24:35.27,Main,,0,0,0,,!أريد أن أقول شيئًا أنا الأخرى
Comment: 0,0:24:35.27,0:24:37.27,Main,,0,0,0,,
Dialogue: 0,0:03:11.87,0:03:17.88,Signs,,0,0,0,,!ذئبٌ أزرقٌ عتيقٌ لا نظير له
Dialogue: 0,0:24:32.74,0:25:05.73,Signs,,0,0,0,,!درع الروم العاشق الّذي لا يُقهر
