Dialogue: 0,0:00:01.21,0:00:02.27,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:03.29,0:02:05.26,Main,,0,0,0,,قضاء العدالة المُطلقة
Dialogue: 0,0:02:17.86,0:02:22.49,Main,,0,0,0,,!شهد هذا الهلال على مؤامرتكم الخبيثة بأمّ عينيه
Dialogue: 0,0:02:22.58,0:02:26.04,Main,,0,0,0,,مـ-ما الّذي يحدث يا غولد-سان؟
Dialogue: 0,0:02:27.75,0:02:29.44,Main,,0,0,0,,ثمّة ظروفٌ وملابساتٌ شتّى
Dialogue: 0,0:02:29.98,0:02:30.87,Main,,0,0,0,,!أيّها الوغد
Dialogue: 0,0:02:30.91,0:02:31.82,Main,,0,0,0,,!ثمّة دخيل
Dialogue: 0,0:02:32.00,0:02:33.95,Main,,0,0,0,,!هلمّوا إليّ
Dialogue: 0,0:02:37.36,0:02:38.96,Main,,0,0,0,,!ظهرتم أخيرًا إذن
Dialogue: 0,0:02:39.45,0:02:41.79,Main,,0,0,0,,!تذوّقوا طور العدالة
Dialogue: 0,0:02:47.61,0:02:49.87,Main,,0,0,0,,من تكون يا غولد-سان؟
Dialogue: 0,0:02:50.86,0:02:52.33,Main,,0,0,0,,...بدأ بمفرده مجدّدًا
Dialogue: 0,0:02:55.40,0:02:57.10,Main,,0,0,0,,يا له من مزعج
Dialogue: 0,0:02:57.11,0:02:57.98,Main,,0,0,0,,من أنتِ؟
Dialogue: 0,0:02:58.19,0:03:01.13,Main,,0,0,0,,،أنا؟ أنا رفيقة غولد-سان
Dialogue: 0,0:03:01.23,0:03:02.66,Main,,0,0,0,,ويدعونني رانتشيكي
Dialogue: 0,0:03:03.42,0:03:04.56,Main,,0,0,0,,رفيقة غولد-سان؟
Dialogue: 0,0:03:04.58,0:03:05.16,Main,,0,0,0,,هذا صحيح
Dialogue: 0,0:03:05.79,0:03:08.41,Main,,0,0,0,,طلب منّي تسليمكِ هذا
Dialogue: 0,0:03:09.46,0:03:11.75,Main,,0,0,0,,إنّه ترياقٌ لمُبطل الأطوار
Dialogue: 0,0:03:11.83,0:03:15.47,Main,,0,0,0,,إن تجرّعتِه فستستعيدين قدرتكِ على استخدام الأطوار كالسابق
Dialogue: 0,0:03:17.28,0:03:19.09,Main,,0,0,0,,لا حاجة لي به
Dialogue: 0,0:03:19.59,0:03:21.72,Main,,0,0,0,,ماذا؟ لِمَ ترفضين؟
Dialogue: 0,0:03:21.92,0:03:24.52,Main,,0,0,0,,!لا أثق بأيّ رفيقٍ لذاك الرجل
Dialogue: 0,0:03:24.68,0:03:26.83,Main,,0,0,0,,كـ-كيف تقولين هذا؟
Dialogue: 0,0:03:27.15,0:03:30.17,Main,,0,0,0,,إن لم تتجرّعيه فستظلّ أطواركِ محظورةً
Dialogue: 0,0:03:30.99,0:03:31.85,Main,,0,0,0,,...ولكن
Dialogue: 0,0:03:31.87,0:03:34.65,Main,,0,0,0,,!قالت أونيه-ني-ساما إنّها لا تريده
Dialogue: 0,0:03:34.70,0:03:37.42,Main,,0,0,0,,!فلتأخذي هذا الشيء وتغادري فورًا
Dialogue: 0,0:03:37.71,0:03:41.78,Main,,0,0,0,,!هذا صحيح، ربّما يبتغي دسّ السمّ لها مجدّدًا بكلامه المعسول
Dialogue: 0,0:03:42.16,0:03:44.19,Main,,0,0,0,,!ما الّذي قلته للتو؟
Dialogue: 0,0:03:44.62,0:03:46.74,Main,,0,0,0,,!ثِقوا بالآخرين قليلًا
Dialogue: 0,0:03:46.74,0:03:48.20,Main,,0,0,0,,!لا يمكننا ذلك
Dialogue: 0,0:03:50.12,0:03:51.76,Main,,0,0,0,,!اصمتي وتجرّعيه فحسب
Dialogue: 0,0:03:52.33,0:03:53.83,Main,,0,0,0,,!ماذا تفعلين؟
Dialogue: 0,0:03:55.10,0:03:57.02,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:03:57.59,0:03:59.56,Main,,0,0,0,,!ابتعدي عنها
Dialogue: 0,0:04:04.39,0:04:06.51,Main,,0,0,0,,!توقّفي رجاءً
Dialogue: 0,0:04:06.68,0:04:08.51,Main,,0,0,0,,!أبعِدي يديكِ عنها
Dialogue: 0,0:04:08.60,0:04:10.67,Main,,0,0,0,,!هذا خطير
Dialogue: 0,0:04:21.36,0:04:22.65,Main,,0,0,0,,أونيه-ني-ساما؟
Dialogue: 0,0:04:22.70,0:04:23.96,Main,,0,0,0,,!مُوتوا
Dialogue: 0,0:04:31.54,0:04:34.25,Main,,0,0,0,,أخبرتُكَ أنّي لن أُخطئ الهدف في المرّة القادمة
Dialogue: 0,0:04:35.33,0:04:36.65,Main,,0,0,0,,!رايبير-سان
Dialogue: 0,0:04:36.91,0:04:38.54,Main,,0,0,0,,هل أنتِ بخير يا ميل-ساما؟
Dialogue: 0,0:04:38.63,0:04:41.00,Main,,0,0,0,,...ميز-سان
Dialogue: 0,0:04:42.84,0:04:43.84,Main,,0,0,0,,!غولد
Dialogue: 0,0:04:45.22,0:04:47.84,Main,,0,0,0,,ما الّذي تنوي فعله بميز؟
Dialogue: 0,0:04:48.24,0:04:50.24,Main,,0,0,0,,لا وقت للشرح الآن
Dialogue: 0,0:04:50.62,0:04:53.82,Main,,0,0,0,,لكن ثقي بي، فلن أُلحق بها أيَّ سوءٍ
Dialogue: 0,0:05:00.82,0:05:03.93,Main,,0,0,0,,سأستجوبكَ عن كافّة التفاصيل لاحقًا
Dialogue: 0,0:05:04.16,0:05:06.43,Main,,0,0,0,,حسنٌ، رفقًا بي رجاءً
Dialogue: 0,0:05:07.76,0:05:10.54,Main,,0,0,0,,أيعجزون عن سحق شرذمةٍ قليلةٍ كهذه؟
Dialogue: 0,0:05:12.65,0:05:14.43,Main,,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:05:14.60,0:05:16.42,Main,,0,0,0,,!يا لكثرة أعدادهم
Dialogue: 0,0:05:23.05,0:05:24.62,Main,,0,0,0,,مظهرهم قبيحٌ للغاية
Dialogue: 0,0:05:26.70,0:05:28.99,Main,,0,0,0,,!انطلقوا يا رجالي المتوارين
Dialogue: 0,0:05:28.99,0:05:30.93,Main,,0,0,0,,!اسفِكوا دماءهم جميعًا
Dialogue: 0,0:05:32.35,0:05:33.58,Main,,0,0,0,,!تراجعي يا ميل-ساما
Dialogue: 0,0:05:43.23,0:05:45.74,Main,,0,0,0,,أنا خصمك
Dialogue: 0,0:05:46.11,0:05:47.87,Main,,0,0,0,,هذا شرفٌ لي
Dialogue: 0,0:05:56.94,0:05:57.75,Main,,0,0,0,,!فايغر
Dialogue: 0,0:06:15.14,0:06:16.10,Main,,0,0,0,,!سحقًا
Dialogue: 0,0:06:19.77,0:06:21.02,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:06:21.04,0:06:24.62,Main,,0,0,0,,!لن نغفر لكم إن أصاب ميز-سان أيُّ مكروه
Dialogue: 0,0:06:38.75,0:06:40.43,Main,,0,0,0,,أهذا حلمٌ؟
Dialogue: 0,0:06:41.13,0:06:42.17,Main,,0,0,0,,...كلّا
Dialogue: 0,0:06:42.72,0:06:45.71,Main,,0,0,0,,هذه أعماق قلبي
Dialogue: 0,0:06:47.76,0:06:48.72,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:07:02.11,0:07:04.51,Top,,0,0,0,,ما خطبكنّ، أفرغ وسعكنَّ من الشراب؟
Dialogue: 0,0:07:02.73,0:07:04.54,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:07:04.76,0:07:07.56,Main,,0,0,0,,!لا تكترثنَ واشربنَ، اشربنَ المزيد
Dialogue: 0,0:07:09.18,0:07:10.78,Main,,0,0,0,,!حاضر يا سيّدنا
Dialogue: 0,0:07:11.90,0:07:13.12,Main,,0,0,0,,ميز الفتى؟
Dialogue: 0,0:07:13.63,0:07:15.37,Main,,0,0,0,,!أنتِ هناك
Dialogue: 0,0:07:15.66,0:07:19.21,Main,,0,0,0,,اقتربي، أذنتُ لكِ بذلك
Dialogue: 0,0:07:19.69,0:07:21.67,Main,,0,0,0,,ما هذا الصخب كلّه؟
Dialogue: 0,0:07:22.17,0:07:28.06,Main,,0,0,0,,حين استنشقتِ ذاك الدخان المريب، عجزتُ عن الخروج من هنا
Dialogue: 0,0:07:28.33,0:07:31.76,Main,,0,0,0,,فشعرتُ بالملل ودعوتُ هؤلاء الفتيات لنلهو معًا
Dialogue: 0,0:07:31.76,0:07:32.72,Main,,0,0,0,,أليس كذلك يا فتيات؟
Dialogue: 0,0:07:33.47,0:07:35.69,Main,,0,0,0,,!أجل يا سيّدنا
Dialogue: 0,0:07:36.75,0:07:38.70,Main,,0,0,0,,!اسكبي لي المزيد
Dialogue: 0,0:07:38.99,0:07:40.97,Top,,0,0,0,,!هيّا، اشربنَ المزيد
Dialogue: 0,0:07:40.28,0:07:41.95,Main,,0,0,0,,يا لكَ من رجل سيئ
Dialogue: 0,0:07:43.76,0:07:44.64,Main,,0,0,0,,ما الخطب؟
Dialogue: 0,0:07:48.25,0:07:51.82,Main,,0,0,0,,!أتدرك كم قلقتُ عليك
Dialogue: 0,0:07:54.74,0:07:58.20,Main,,0,0,0,,،ظللتُ أُناديكَ مرارًا دون أن تجيب
Dialogue: 0,0:07:58.24,0:08:00.25,Main,,0,0,0,,،ولم تنبس ببنت شفة
Dialogue: 0,0:08:00.70,0:08:02.32,Main,,0,0,0,,،وعجزتُ عن استخدام طوري
Dialogue: 0,0:08:02.73,0:08:05.72,Main,,0,0,0,,...أنا... أنا
Dialogue: 0,0:08:07.55,0:08:09.67,Main,,0,0,0,,...ميز الفتاة
Dialogue: 0,0:08:09.76,0:08:11.26,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:08:11.51,0:08:12.56,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:08:23.81,0:08:24.77,Main,,0,0,0,,!ميز
Dialogue: 0,0:08:26.90,0:08:28.76,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:08:30.53,0:08:33.37,Main,,0,0,0,,!بلغتِ نهايتكِ، فلتَموتي
Dialogue: 0,0:08:33.48,0:08:35.68,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:08:42.20,0:08:43.33,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:08:53.13,0:08:56.80,Main,,0,0,0,,!طال انتظاركم، ها قد حضر ميز العظيم
Dialogue: 0,0:08:57.55,0:08:59.02,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:08:59.05,0:09:02.88,Main,,0,0,0,,لا داعي للقلق بعد الآن يا ميل، دعي الأمر برمّته لميز العظيم
Dialogue: 0,0:09:03.61,0:09:06.52,Main,,0,0,0,,...تبدو في غاية الشراسة اليوم يا أونيه-ني-ساما
Dialogue: 0,0:09:07.27,0:09:11.23,Main,,0,0,0,,!بالتأكيد، فميز الفتى العظيم في مهمّةٍ طارئةٍ اليوم
Dialogue: 0,0:09:13.96,0:09:16.51,Main,,0,0,0,,!فعلتم ما يحلو لكم كفاية
Dialogue: 0,0:09:20.08,0:09:22.44,Main,,0,0,0,,!سأردّ لكم الصاع صاعين بالنيابة عن كِلَينا
Dialogue: 0,0:09:30.04,0:09:32.70,Main,,0,0,0,,!سأخصّك بعنايةٍ فائقة
Dialogue: 0,0:09:32.79,0:09:33.80,Main,,0,0,0,,!فايغر
Dialogue: 0,0:09:36.26,0:09:39.61,Main,,0,0,0,,!فايغر! فايغر! فايغر
Dialogue: 0,0:09:49.61,0:09:51.40,Main,,0,0,0,,!احترقوا جميعًا
Dialogue: 0,0:09:51.80,0:09:54.40,Main,,0,0,0,,!احترقوا وتفحّموا
Dialogue: 0,0:09:54.94,0:09:57.28,Main,,0,0,0,,!تذوّقوا هذا، وذاك
Dialogue: 0,0:10:01.66,0:10:03.68,Main,,0,0,0,,إلى أين أنتَ ذاهبٌ يا دين مارش؟
Dialogue: 0,0:10:03.99,0:10:04.95,Main,,0,0,0,,!أنت
Dialogue: 0,0:10:05.37,0:10:07.29,Main,,0,0,0,,،وزير الخزانة دين مارش
Dialogue: 0,0:10:07.33,0:10:09.63,Main,,0,0,0,,أنتَ قيد الاعتقال بتهمة الخيانة العظمى للدولة
Dialogue: 0,0:10:09.71,0:10:11.63,Main,,0,0,0,,!سـ-سحقًا لك
Dialogue: 0,0:10:28.64,0:10:31.93,Main,,0,0,0,,!لم تروا القوّة الحقيقيّة لأونيه-ني-ساما بعد
Dialogue: 0,0:10:32.00,0:10:33.31,Main,,0,0,0,,!هذا صحيح
Dialogue: 0,0:10:34.65,0:10:36.86,Main,,0,0,0,,...تبًّا، كانت الإثارة على وشك أن تبدأ
Dialogue: 0,0:10:42.03,0:10:45.92,Main,,0,0,0,,مهلًا، وما شأني أنا؟
Dialogue: 0,0:11:15.36,0:11:18.11,Main,,0,0,0,,ما الّذي سيحدث الآن يا ترى؟
Dialogue: 0,0:11:18.19,0:11:20.24,Main,,0,0,0,,لا بُدَّ أنّها محاكمة
Dialogue: 0,0:11:20.49,0:11:21.36,Main,,0,0,0,,محاكمة؟
Dialogue: 0,0:11:22.53,0:11:27.95,Main,,0,0,0,,!جلالة الملك فارماونت يعتلي المنصّة
Dialogue: 0,0:11:38.71,0:11:43.14,Main,,0,0,0,,أذاك... الملك المقنّع؟
Dialogue: 0,0:11:46.10,0:11:48.64,Main,,0,0,0,,،تنعقد الجلسة الآن لمحاكمة
Dialogue: 0,0:11:48.72,0:11:51.89,Main,,0,0,0,,،وزير الخزانة دين مارش، والكونت بوتشومكين
Dialogue: 0,0:11:51.94,0:11:54.86,Main,,0,0,0,,من طائفة جاينا المقدّسة بتهمة الخيانة العظمى للدولة
Dialogue: 0,0:11:54.94,0:11:57.48,Main,,0,0,0,,!ليرفع الجميع رؤوسهم
Dialogue: 0,0:11:57.73,0:12:01.15,Main,,0,0,0,,جلالتك، ما خطب هذا كلّه؟
Dialogue: 0,0:12:01.24,0:12:03.91,Main,,0,0,0,,لِمَ أُعامل بهذه الطريقة؟
Dialogue: 0,0:12:05.57,0:12:10.45,Main,,0,0,0,,خدمتُ هذه البلاد مُنذ عهد الملك الراحل
Dialogue: 0,0:12:10.54,0:12:14.08,Main,,0,0,0,,وأُحبّ هذه البلاد أكثر من سائر رعايا البلاط
Dialogue: 0,0:12:14.42,0:12:18.55,Main,,0,0,0,,فكيف لي أن أُدبّر انقلابًا ضدّكم؟
Dialogue: 0,0:12:18.55,0:12:21.22,Main,,0,0,0,,هذه مؤامرةٌ جليّة
Dialogue: 0,0:12:21.30,0:12:25.51,Main,,0,0,0,,أظنّ أنَّ أولئك الفتيات جواسيس أرسلتهم دولةٌ معادية
Dialogue: 0,0:12:25.93,0:12:30.06,Main,,0,0,0,,،هنَّ المجرمات اللّواتي أضرمَن نيران الحرب في بالانيا الآمنة
Dialogue: 0,0:12:30.14,0:12:31.98,Main,,0,0,0,,ولا شكّ في ذلك مطلقًا
Dialogue: 0,0:12:32.14,0:12:35.31,Main,,0,0,0,,!يا لوقاحتك، أتنوي إلقاء اللوم علينا؟
Dialogue: 0,0:12:35.60,0:12:37.73,Main,,0,0,0,,اهدئي يا رايبير-سان
Dialogue: 0,0:12:38.98,0:12:40.23,Main,,0,0,0,,إذن، أجبني يا بوتشومكين
Dialogue: 0,0:12:40.86,0:12:43.25,Main,,0,0,0,,لِمَ وطئت قدماك أرض بلادنا؟
Dialogue: 0,0:12:43.61,0:12:49.66,Main,,0,0,0,,تُدرك أنَّ طائفة جاينا المقدّسة محظورةٌ تمامًا في بلادنا، أليس كذلك؟
Dialogue: 0,0:12:52.12,0:12:57.50,Main,,0,0,0,,!جلالتك، الحقيقة واحدةٌ دائمًا، فلا تخطئنّ الحكم عليها
Dialogue: 0,0:12:57.58,0:12:59.63,Main,,0,0,0,,!أصدِر حُكمكَ العادل الآن
Dialogue: 0,0:13:01.13,0:13:03.13,Main,,0,0,0,,جلالتك، نرجو حكمك
Dialogue: 0,0:13:05.01,0:13:10.10,Main,,0,0,0,,يا دين مارش، لديّ شاهدٌ يزعم أنّه عاين آثامك
Dialogue: 0,0:13:12.57,0:13:15.56,Main,,0,0,0,,شاهد؟ من عساه يكون؟
Dialogue: 0,0:13:16.48,0:13:19.15,Main,,0,0,0,,رجلٌ عابثٌ يُدعى غولد-سان
Dialogue: 0,0:13:21.53,0:13:22.65,Main,,0,0,0,,غولد؟
Dialogue: 0,0:13:25.61,0:13:27.24,Main,,0,0,0,,حسبتُه شخصًا ذا شأن
Dialogue: 0,0:13:27.32,0:13:29.28,Main,,0,0,0,,...جلالتك، لا يُعقل أنّك
Dialogue: 0,0:13:29.32,0:13:32.87,Main,,0,0,0,,صدّقتَ أقاويل رجلٍ عابثٍ مثله
Dialogue: 0,0:13:33.66,0:13:37.04,Main,,0,0,0,,،أقاويل متشردٍ مجهول الأصل والنسب
Dialogue: 0,0:13:37.08,0:13:39.63,Main,,0,0,0,,واعتقالي بناءً على مزاعمه ظلمٌ بيّن
Dialogue: 0,0:13:39.71,0:13:41.92,Main,,0,0,0,,!أطلِق سراحي على الفور رجاءً
Dialogue: 0,0:13:42.30,0:13:46.55,Main,,0,0,0,,أفهمُ من كلامكَ أنّكَ لا تعرف غولد-سان إذن
Dialogue: 0,0:13:46.84,0:13:48.09,Main,,0,0,0,,!بالتأكيد
Dialogue: 0,0:13:48.18,0:13:51.97,Main,,0,0,0,,!لم أسمع باسمه قطّ، ولم ألتقِ به في حياتي
Dialogue: 0,0:13:57.19,0:14:01.02,Main,,0,0,0,,!إلى متى تنوي مواصلة هذا الإنكار أيّها الوغد؟
Dialogue: 0,0:14:02.36,0:14:05.94,Main,,0,0,0,,!تزعم أنّكَ تجهل غولد-سان؟ لا تجعلني أضحك
Dialogue: 0,0:14:06.90,0:14:09.03,Main,,0,0,0,,،فوق ساحة الإعدام في غبش الفجر
Dialogue: 0,0:14:09.07,0:14:11.70,Main,,0,0,0,,،سطع الهلال ببريقه الوضّاح
Dialogue: 0,0:14:15.04,0:14:17.50,Main,,0,0,0,,فإيّاك أن تزعم أنّك نسيته
Dialogue: 0,0:14:21.67,0:14:23.21,Main,,0,0,0,,...أنتَ
Dialogue: 0,0:14:23.67,0:14:28.22,Main,,0,0,0,,شهد هذا الهلال على جرائمكم بأمّ عينيه
Dialogue: 0,0:14:28.55,0:14:30.22,Main,,0,0,0,,!فلتُقرّوا بذنبكم الآن
Dialogue: 0,0:14:30.59,0:14:33.01,Main,,0,0,0,,...مُـ-مُحال
Dialogue: 0,0:14:34.89,0:14:38.39,Main,,0,0,0,,حقيقة الملك فارماونت هي غولد-سان نفسه؟
Dialogue: 0,0:14:39.56,0:14:41.36,Main,,0,0,0,,:إليكم الحُكم النهائي
Dialogue: 0,0:14:41.44,0:14:45.19,Main,,0,0,0,,،وزير الخزانة دين مارش؛ ثبتت إدانتك بالخيانة العظمى
Dialogue: 0,0:14:45.23,0:14:49.32,Main,,0,0,0,,واختطاف النساء واحتجازهنّ، وجرائم أخرى شتّى
Dialogue: 0,0:14:49.40,0:14:52.20,Main,,0,0,0,,وحكمتُ عليكَ بالطواف في شوارع المدينة قبل إعدامك
Dialogue: 0,0:14:52.28,0:14:53.58,Main,,0,0,0,,!خذوه
Dialogue: 0,0:14:54.74,0:14:56.95,Main,,0,0,0,,انتهى كلّ شيء
Dialogue: 0,0:15:03.59,0:15:06.42,Main,,0,0,0,,!أتظنّ أنّكَ انتصرت؟ واهمٌ أنتَ
Dialogue: 0,0:15:07.92,0:15:09.93,Main,,0,0,0,,استخففتَ بنا يا فارماونت
Dialogue: 0,0:15:14.72,0:15:16.22,Main,,0,0,0,,!ها قد أتى
Dialogue: 0,0:15:18.56,0:15:21.31,Main,,0,0,0,,!بل أنتَ من سينال العقاب
Dialogue: 0,0:15:23.56,0:15:25.57,Main,,0,0,0,,...قفز؟ لا يُعقل
Dialogue: 0,0:15:34.66,0:15:37.70,Main,,0,0,0,,يا ميز، ويا فارماونت
Dialogue: 0,0:15:38.29,0:15:42.25,Main,,0,0,0,,!تذوّقوا قوّة درع الميغا الاصطناعيّ؛ كالهورن
Dialogue: 0,0:15:45.29,0:15:46.71,Main,,0,0,0,,!استدعي دولغر يا ميل-تشان
Dialogue: 0,0:15:46.80,0:15:47.75,Main,,0,0,0,,!حاضر
Dialogue: 0,0:15:49.97,0:15:53.76,Main,,0,0,0,,!رورو، فارنا، هاي، فامون، را، فو
Dialogue: 0,0:16:36.93,0:16:39.35,Main,,0,0,0,,درع الروم؛ دولغر إذن
Dialogue: 0,0:16:40.68,0:16:42.85,Main,,0,0,0,,!خصمٌ جديرٌ بالمنازلة
Dialogue: 0,0:16:43.48,0:16:44.31,Main,,0,0,0,,!ها أنا ذا
Dialogue: 0,0:16:49.23,0:16:50.36,Main,,0,0,0,,!يا لضخامته
Dialogue: 0,0:16:51.19,0:16:56.20,Main,,0,0,0,,!ليس ضخمًا فحسب، بل تفوقنا قوّته بمراحل
Dialogue: 0,0:16:59.03,0:17:02.45,Main,,0,0,0,,!عليّ إيقافه، وإلّا سيسحق الجميع
Dialogue: 0,0:17:18.85,0:17:20.35,Main,,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:17:51.30,0:17:52.63,Main,,0,0,0,,!اختفى
Dialogue: 0,0:17:52.75,0:17:54.42,Main,,0,0,0,,...ذاك الجسد الضخم
Dialogue: 0,0:17:55.47,0:17:56.38,Main,,0,0,0,,...أيُعقل
Dialogue: 0,0:18:03.27,0:18:07.60,Main,,0,0,0,,!لتكن أرض بالانيا مرقدك الأخير يا درع الروم؛ دولغر
Dialogue: 0,0:18:12.77,0:18:15.78,Main,,0,0,0,,...رورو، راجو، باجورا، ماها، أغوني
Dialogue: 0,0:18:16.70,0:18:18.45,Main,,0,0,0,,!ماها فايغر
Dialogue: 0,0:18:31.29,0:18:33.80,Main,,0,0,0,,يبدو أنّه توارى تحت الأرض مجدّدًا
Dialogue: 0,0:18:35.09,0:18:37.01,Main,,0,0,0,,من أين سيخرج يا تُرى؟
Dialogue: 0,0:18:37.67,0:18:38.68,Main,,0,0,0,,!فايغر
Dialogue: 0,0:18:40.40,0:18:41.26,Main,,0,0,0,,!فايغر
Dialogue: 0,0:18:42.32,0:18:43.10,Main,,0,0,0,,!فايغر
Dialogue: 0,0:18:43.79,0:18:44.75,Main,,0,0,0,,!فايغر
Dialogue: 0,0:19:09.62,0:19:10.75,Main,,0,0,0,,!مُوتا
Dialogue: 0,0:19:21.79,0:19:23.64,Main,,0,0,0,,!أونيه-ني-ساما، نحن في مأزق
Dialogue: 0,0:19:23.82,0:19:26.35,Main,,0,0,0,,!لن نصمد أكثر من هذا
Dialogue: 0,0:19:32.56,0:19:34.52,Main,,0,0,0,,ما العمل؟
Dialogue: 0,0:19:34.86,0:19:36.82,Main,,0,0,0,,!ما الّذي تفعلينه؟
Dialogue: 0,0:19:36.90,0:19:37.90,Main,,0,0,0,,ميز الفتى؟
Dialogue: 0,0:19:37.94,0:19:40.82,Main,,0,0,0,,!إلى متى ستتعثرين أمام نكرةٍ بائسٍ كهذا؟
Dialogue: 0,0:19:40.90,0:19:43.66,Main,,0,0,0,,!إن واصلتِ التلكؤ فسأضطر للخروج وتولّي الأمر مجدّدًا
Dialogue: 0,0:19:47.74,0:19:51.21,Main,,0,0,0,,!تنحَّ جانبًا، سأتولّى الأمر بنفسي
Dialogue: 0,0:19:56.46,0:19:59.84,Main,,0,0,0,,!ما هذا الطور الجبّار؟
Dialogue: 0,0:20:17.94,0:20:19.94,Main,,0,0,0,,!خذ هذا
Dialogue: 0,0:20:45.80,0:20:47.13,Main,,0,0,0,,يا له من أحمق
Dialogue: 0,0:20:47.47,0:20:49.23,Main,,0,0,0,,عليّ إبلاغ الأسمى بالأمر
Dialogue: 0,0:20:51.27,0:20:52.60,Main,,0,0,0,,!شكرًا جزيلًا لكم
Dialogue: 0,0:20:53.61,0:20:56.52,Main,,0,0,0,,وهكذا سُوّيَت القضية برُمّتها
Dialogue: 0,0:20:56.72,0:20:58.02,Main,,0,0,0,,الوليمة على حسابي اليوم
Dialogue: 0,0:20:58.11,0:21:00.19,Main,,0,0,0,,فتناولوا ما طاب لكم من طعامٍ وشراب
Dialogue: 0,0:21:01.11,0:21:02.15,Main,,0,0,0,,!بدأتُ بالفعل
Dialogue: 0,0:21:03.07,0:21:05.61,Main,,0,0,0,,...جلالة الملك فارماونت، بخصوص ميل-ساما
Dialogue: 0,0:21:05.80,0:21:07.00,Main,,0,0,0,,دعي الأمر لي
Dialogue: 0,0:21:07.36,0:21:13.47,Main,,0,0,0,,ستعترف بلادنا رسميًّا بالأميرة ميل وريثةً شرعيّةً لعرش إمبراطوريّة بارتونيا
Dialogue: 0,0:21:13.80,0:21:21.20,Main,,0,0,0,,،كما أوكل إليها الملك الراحل ناوكليف خلافة عرش بيستال أيضًا
Dialogue: 0,0:21:21.44,0:21:22.62,Main,,0,0,0,,أرجو أن تأخذ ذلك في الحسبان
Dialogue: 0,0:21:22.67,0:21:24.30,Main,,0,0,0,,أعلم ذلك
Dialogue: 0,0:21:26.76,0:21:29.51,Main,,0,0,0,,دعونا من هذه الأحاديث الرسمية الآن
Dialogue: 0,0:21:29.55,0:21:30.56,Main,,0,0,0,,أليس كذلك يا ميز؟
Dialogue: 0,0:21:32.31,0:21:34.64,Main,,0,0,0,,ميز، ما الّذي تفعلينه؟
Dialogue: 0,0:21:36.19,0:21:40.02,Main,,0,0,0,,بدا الجميع منشغلين، فلم أقوَ على الجلوس مكتوفة الأيدي
Dialogue: 0,0:21:42.86,0:21:43.94,Main,,0,0,0,,غولد-سان؟
Dialogue: 0,0:21:44.03,0:21:47.74,Main,,0,0,0,,شامخةٌ، قويّةٌ، وفوق كلّ هذا فاتنة
Dialogue: 0,0:21:48.32,0:21:50.91,Main,,0,0,0,,أكاد أقع في غرامكِ يا ميز
Dialogue: 0,0:21:53.66,0:21:55.33,Main,,0,0,0,,!يا لكَ من رجلٍ لعوب
Dialogue: 0,0:24:08.22,0:24:12.38,Main,,0,0,0,,!لدينا سؤال: كيف نشأت الدروع الاصطناعيّة يا ترى؟
Dialogue: 0,0:24:13.42,0:24:16.22,Main,,0,0,0,,في الواقع، لم يسبق لي أن سألتكِ عن هذا
Dialogue: 0,0:24:16.30,0:24:18.35,Main,,0,0,0,,هلّا أخبرتِني يا ميل-تشان؟
Dialogue: 0,0:24:19.18,0:24:20.59,Main,,0,0,0,,...في الواقع
Dialogue: 0,0:24:20.59,0:24:21.08,Main,,0,0,0,,أجل؟
Dialogue: 0,0:24:21.35,0:24:22.65,Main,,0,0,0,,...يُقال إنّها
Dialogue: 0,0:24:22.65,0:24:23.20,Main,,0,0,0,,أجل، أجل
Dialogue: 0,0:24:24.10,0:24:27.52,Main,,0,0,0,,!سنكشف الإجابة في مثل هذا الوقت من الأسبوع القادم
Dialogue: 0,0:24:28.53,0:24:30.82,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:30.94,0:24:33.57,Main,,0,0,0,,تحوّلٌ مفاجئ في الأحداث! ميز عبر الزمان
Dialogue: 0,0:24:34.75,0:24:36.41,Main,,0,0,0,,!لا تُفوّتوا حلقة الأسبوع القادم
Comment: 0,0:24:36.12,0:24:38.12,Signs,,0,0,0,,
Dialogue: 0,0:02:02.47,0:02:08.44,Signs,,0,0,0,,قضاء العدالة المُطلقة
Dialogue: 0,0:24:32.78,0:24:36.78,Signs,,0,0,0,,تحوّلٌ مفاجئ في الأحداث! ميز عبر الزمان
