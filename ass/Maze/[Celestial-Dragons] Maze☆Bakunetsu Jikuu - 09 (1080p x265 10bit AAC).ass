Dialogue: 0,0:00:00.14,0:00:02.14,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:41.92,0:02:44.45,Main,,0,0,0,,الانهيار المحزن لإمبراطوريّة مزدهرة
Dialogue: 0,0:02:54.74,0:02:56.36,Main,,0,0,0,,!ما هذا؟! ما الّذي يجري بالضبط؟
Dialogue: 0,0:02:56.48,0:02:57.28,Main,,0,0,0,,!أهو هجوم؟
Dialogue: 0,0:02:57.36,0:03:00.45,Main,,0,0,0,,!مُحال! فنحن نحتمي بحاجز إبطال الأطوار المنيع
Dialogue: 0,0:03:00.66,0:03:02.20,Main,,0,0,0,,أهو تمرّد؟
Dialogue: 0,0:03:02.28,0:03:04.45,Main,,0,0,0,,!لا، مُحال
Dialogue: 0,0:03:09.37,0:03:11.00,Main,,0,0,0,,!انظروا إلى برج إبطال الأطوار
Dialogue: 0,0:03:30.69,0:03:32.81,Main,,0,0,0,,!لا تفرّوا! عليكم بالقتال
Dialogue: 0,0:03:32.85,0:03:36.15,Main,,0,0,0,,ألستم فرسان البلاط الملكيّ الأباة النبلاء؟
Dialogue: 0,0:03:36.48,0:03:37.57,Main,,0,0,0,,!تنحّوا
Dialogue: 0,0:03:41.15,0:03:42.49,Main,,0,0,0,,!يا للهول
Dialogue: 0,0:03:42.53,0:03:46.49,Main,,0,0,0,,!أهذه... أهذه هي حقيقة فرسان بيستال الأباة؟
Dialogue: 0,0:03:46.58,0:03:47.66,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:04:18.40,0:04:19.78,Main,,0,0,0,,...ليريك
Dialogue: 0,0:04:43.01,0:04:43.88,Main,,0,0,0,,!إيّاكَ والاقتراب منّي
Dialogue: 0,0:04:43.97,0:04:47.55,Main,,0,0,0,,!أونيه-ني-ساما وحدها من يحقّ لها لمس ميل
Dialogue: 0,0:04:48.05,0:04:50.77,Main,,0,0,0,,...مقدّسٌ، مقدّسٌ
Dialogue: 0,0:04:50.85,0:04:53.43,Main,,0,0,0,,،يفتح الإله أبواب السماء العُلى
Dialogue: 0,0:04:53.52,0:04:57.19,Main,,0,0,0,,ويهدي أرواحنا نحن الصغار التائهين
Dialogue: 0,0:04:58.61,0:05:01.61,Main,,0,0,0,,!لا، لا، لا أريد! ابتعد عنّي
Dialogue: 0,0:05:05.03,0:05:07.99,Main,,0,0,0,,...باسم الإله والابن والروح القدس
Dialogue: 0,0:05:19.21,0:05:21.55,Main,,0,0,0,,...الأصل والأساس، صاحب العرض الرئيسيّ
Dialogue: 0,0:05:21.63,0:05:24.30,Main,,0,0,0,,!ميز-ساما يطلّ عليكم بظهوره المُهيب
Dialogue: 0,0:05:24.30,0:05:25.63,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:05:26.63,0:05:27.97,Main,,0,0,0,,...لا بُدَّ أنّكِ خفتِ كثيرًا
Dialogue: 0,0:05:28.05,0:05:31.01,Main,,0,0,0,,!تمهّلي، سأسحق هذا الوغد في الحال
Dialogue: 0,0:05:31.26,0:05:35.43,Main,,0,0,0,,!ولهذا، أرني ما لديكَ من أيّ جانبٍ شئتَ أيّها الجنديّ التافه
Dialogue: 0,0:05:40.82,0:05:44.36,Main,,0,0,0,,،وتعبيرًا عن غضبه الجارف
Dialogue: 0,0:05:44.44,0:05:46.61,Main,,0,0,0,,!أرسل الإله وحشًا إلى الأرض بيننا
Dialogue: 0,0:05:51.66,0:05:52.99,Main,,0,0,0,,!يا للهول
Dialogue: 0,0:06:15.79,0:06:19.10,Main,,0,0,0,,!يبدو أنّكَ وغدٌ يملك بعض البأس على غير العادة
Dialogue: 0,0:06:19.19,0:06:20.14,Main,,0,0,0,,!هيّا بنا يا ميل
Dialogue: 0,0:06:20.26,0:06:20.92,Main,,0,0,0,,!حاضر
Dialogue: 0,0:06:34.99,0:06:36.54,Main,,0,0,0,,!ينتابني القلق على جلالته
Dialogue: 0,0:06:37.18,0:06:38.75,Main,,0,0,0,,!علينا الإسراع
Dialogue: 0,0:06:50.13,0:06:51.97,Main,,0,0,0,,!ها أنا ذا
Dialogue: 0,0:06:57.14,0:06:58.18,Main,,0,0,0,,...أيّها الـ
Dialogue: 0,0:07:25.26,0:07:26.75,Main,,0,0,0,,ليريك
Dialogue: 0,0:07:27.34,0:07:30.93,Main,,0,0,0,,!انظر، يا له من بريقٍ ساحر
Dialogue: 0,0:07:31.97,0:07:34.10,Main,,0,0,0,,!إنّها ألعابٌ ناريّةٌ احتفاءً بك
Dialogue: 0,0:07:34.64,0:07:37.10,Main,,0,0,0,,!الجميع يُشيد بك
Dialogue: 0,0:07:37.26,0:07:42.44,Main,,0,0,0,,!عاشت بيستال! عاشت بارتونيا
Dialogue: 0,0:07:55.83,0:07:57.12,Main,,0,0,0,,...ليريك
Dialogue: 0,0:08:08.48,0:08:10.93,Main,,0,0,0,,!جلالتك! جلالة الملك ناوكليف
Dialogue: 0,0:08:11.09,0:08:13.61,Main,,0,0,0,,أين أنتَ يا صاحب الجلالة؟ أين أنتَ؟
Dialogue: 0,0:08:14.39,0:08:15.59,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:08:17.72,0:08:18.64,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:08:18.96,0:08:19.69,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:08:21.14,0:08:25.94,Main,,0,0,0,,جئتِ في الوقت المناسب يا رايبير
Dialogue: 0,0:08:26.23,0:08:28.65,Main,,0,0,0,,جلالتك، ألم يُصبكَ أيّ مكروه؟
Dialogue: 0,0:08:30.40,0:08:33.64,Main,,0,0,0,,ثمّة ما أريد أن أستودعكِ إيّاه
Dialogue: 0,0:08:36.53,0:08:40.04,Main,,0,0,0,,أهذا... سيف أستيناس الثمين؟
Dialogue: 0,0:08:40.37,0:08:44.87,Main,,0,0,0,,،أخبري الأميرة ميل بأنّني أورثتها الحقّ الشرعيّ
Dialogue: 0,0:08:45.04,0:08:48.67,Main,,0,0,0,,في اعتلاء عرش إمبراطوريّة بيستال
Dialogue: 0,0:08:48.75,0:08:49.46,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:08:49.92,0:08:56.97,Main,,0,0,0,,عليكِ مساندة الأميرة ميل، لكي تُعيدي إلى هذه الأرض السلام مجدّدًا
Dialogue: 0,0:08:57.01,0:08:59.85,Main,,0,0,0,,،ابنوا وطنًا قويًّا شامخًا
Dialogue: 0,0:08:59.93,0:09:02.39,Main,,0,0,0,,يعيش فيه الجميع بابتسامةٍ ورخاء
Dialogue: 0,0:09:02.48,0:09:04.56,Main,,0,0,0,,ما الّذي تقوله يا صاحب الجلالة؟
Dialogue: 0,0:09:04.64,0:09:07.77,Main,,0,0,0,,!فما دمتَ على قيد الحياة، فلن تسقط بيستال
Dialogue: 0,0:09:07.86,0:09:10.98,Main,,0,0,0,,!ما دمتَ حيًّا، فسننهض من جديدٍ حتمًا
Dialogue: 0,0:09:14.07,0:09:15.86,Main,,0,0,0,,!هيّا يا صاحب الجلالة
Dialogue: 0,0:09:21.12,0:09:22.54,Main,,0,0,0,,!أيّها الوغد
Dialogue: 0,0:09:36.43,0:09:37.80,Main,,0,0,0,,!ماذا
Dialogue: 0,0:09:37.89,0:09:41.14,Main,,0,0,0,,!ابتعد يا أونيه-ني-ساما، الحرارة خانقةٌ للغاية
Dialogue: 0,0:09:42.35,0:09:44.64,Main,,0,0,0,,!قلتُ أطلقني
Dialogue: 0,0:09:45.49,0:09:47.97,Main,,0,0,0,,!يقود الخصم درعًا اصطناعيًّا ياقوتيًّا
Dialogue: 0,0:09:48.24,0:09:49.90,Main,,0,0,0,,!هاجمه بالطور الياقوتيّ
Dialogue: 0,0:10:18.51,0:10:20.88,Main,,0,0,0,,لا تحزني ولا تلومي نفسكِ
Dialogue: 0,0:10:21.38,0:10:22.97,Main,,0,0,0,,هذا عقابٌ من السماء
Dialogue: 0,0:10:23.47,0:10:29.28,Main,,0,0,0,,،عقابٌ نزل بنا لغفلتنا واستغراقنا في أوهام الأمان داخل هذه المملكة الحصينة
Dialogue: 0,0:10:29.86,0:10:31.86,Main,,0,0,0,,...عقابٌ مستحقٌّ بلا ريب
Dialogue: 0,0:10:32.73,0:10:35.61,Main,,0,0,0,,كلُّ هذا ناجمٌ عن قصر نظري وقلّة حيلتي
Dialogue: 0,0:10:35.65,0:10:38.15,Main,,0,0,0,,!ما اقترفتَ أيّ خطأٍ يا صاحب الجلالة
Dialogue: 0,0:10:41.37,0:10:42.50,Main,,0,0,0,,وول
Dialogue: 0,0:10:43.05,0:10:45.29,Main,,0,0,0,,أُوكِلُ إليكَ مهمّةً أنتَ الآخر
Dialogue: 0,0:10:45.29,0:10:48.62,Main,,0,0,0,,،سخّر حكمتكَ وخبرتكَ
Dialogue: 0,0:10:48.71,0:10:51.67,Main,,0,0,0,,في عون الجيل الشاب
Dialogue: 0,0:10:53.88,0:10:55.59,Main,,0,0,0,,أمرُكَ مُطاع
Dialogue: 0,0:10:56.71,0:10:57.45,Main,,0,0,0,,اذهبا
Dialogue: 0,0:10:57.81,0:11:01.26,Main,,0,0,0,,ما زال بإمكانكما النجاة عبر المتاهة الجوفيّة الآن
Dialogue: 0,0:11:02.14,0:11:03.76,Main,,0,0,0,,!لن أفعل
Dialogue: 0,0:11:04.05,0:11:05.47,Main,,0,0,0,,!عليكِ بالذهاب
Dialogue: 0,0:11:05.56,0:11:06.72,Main,,0,0,0,,!لن أذهب
Dialogue: 0,0:11:09.23,0:11:10.39,Main,,0,0,0,,رايبير
Dialogue: 0,0:11:10.52,0:11:14.73,Main,,0,0,0,,!سأبقى بجواركَ حتّى الرمق الأخير يا صاحب الجلالة
Dialogue: 0,0:11:14.77,0:11:17.94,Main,,0,0,0,,...سأقاتل وأقاتل وأقاتل
Dialogue: 0,0:11:18.11,0:11:20.95,Main,,0,0,0,,!ولن أندم إن هلكتُ في ساحة المعركة
Dialogue: 0,0:11:21.03,0:11:24.99,Main,,0,0,0,,!يستحيل أن أترككَ خلفي وأمضي يا صاحب الجلالة
Dialogue: 0,0:11:25.45,0:11:26.74,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:11:28.83,0:11:30.54,Main,,0,0,0,,!أيّتها الحمقاء
Dialogue: 0,0:11:31.96,0:11:36.30,Main,,0,0,0,,!حتّى وإن بادت الأسرة الحاكمة، فشعب بيستال باقٍ
Dialogue: 0,0:11:36.38,0:11:42.34,Main,,0,0,0,,أيرضيكِ أن يُعاني هذا الشعب من طغيان طائفة جاينا المقدّسة؟
Dialogue: 0,0:11:42.43,0:11:46.85,Main,,0,0,0,,من سينقذهم ومن سيقودهم سواكم؟
Dialogue: 0,0:11:51.27,0:11:57.44,Main,,0,0,0,,!يتحتّم على من كُتِبَتْ له النجاة أن يواصل العيش ليؤدّي واجبه ويحمل مسؤوليّته
Dialogue: 0,0:11:57.52,0:12:01.03,Main,,0,0,0,,!أتجهلين هذا وأنتِ ترتدين رداء الفرسان؟
Dialogue: 0,0:12:01.65,0:12:03.20,Main,,0,0,0,,!كُفّي عن الدلال السخيف أيّتها الحمقاء
Dialogue: 0,0:12:06.12,0:12:10.04,Main,,0,0,0,,حقّقي ما عجزتُ عن تحقيقه يا رايبير
Dialogue: 0,0:12:13.25,0:12:17.88,Main,,0,0,0,,وعلاوةً على ذلك، لا يسعني التخلّي عنها
Dialogue: 0,0:12:38.98,0:12:42.40,Main,,0,0,0,,لا تزيدي من معاناة جلالته يا رايبير
Dialogue: 0,0:12:42.82,0:12:43.90,Main,,0,0,0,,رجاءً
Dialogue: 0,0:12:53.83,0:12:55.00,Main,,0,0,0,,!كلّا
Dialogue: 0,0:12:55.25,0:12:56.00,Main,,0,0,0,,!رايبير
Dialogue: 0,0:12:56.08,0:12:58.59,Main,,0,0,0,,!كلّا! سأبقى هنا
Dialogue: 0,0:12:58.67,0:13:01.59,Main,,0,0,0,,!لا أريد العيش في عالمٍ يخلو من جلالته
Dialogue: 0,0:13:07.93,0:13:10.76,Main,,0,0,0,,وداعًا يا صاحب الجلالة
Dialogue: 0,0:13:11.18,0:13:17.19,Main,,0,0,0,,يُسعدني أن حظيتُ بأتباعٍ مخلصين مثلكم في ختام حياتي
Dialogue: 0,0:13:31.12,0:13:32.49,Main,,0,0,0,,...كاساندرا
Dialogue: 0,0:13:33.37,0:13:36.67,Main,,0,0,0,,كفى، لا بأس الآن
Dialogue: 0,0:13:39.46,0:13:45.84,Main,,0,0,0,,لم أكن ملكًا صالحًا، ولا أبًا صالحًا، ولا زوجًا صالحًا
Dialogue: 0,0:13:46.18,0:13:47.13,Main,,0,0,0,,سامحيني
Dialogue: 0,0:13:49.30,0:13:51.76,Main,,0,0,0,,أعتذر منكَ يا زوجي العزيز
Dialogue: 0,0:13:54.64,0:13:57.35,Main,,0,0,0,,هلّا أسمعتِني تلك المعزوفة مجدّدًا؟
Dialogue: 0,0:13:57.44,0:13:59.61,Main,,0,0,0,,ذلك اللّحن الّذي يبعث على الحنين؟
Dialogue: 0,0:14:04.23,0:14:05.69,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:14:06.80,0:14:13.69,Main,,0,0,0,,!انظروا إلى وابل النيران، يُحرق مدينة الزور ويبيد الخاطئين
Dialogue: 0,0:14:13.80,0:14:15.12,Main,,0,0,0,,!إنّه غضب الإله
Dialogue: 0,0:14:30.43,0:14:31.93,Main,,0,0,0,,...القلعة
Dialogue: 0,0:14:59.12,0:15:01.63,Main,,0,0,0,,!مؤلم! أيّها الوغد
Dialogue: 0,0:15:37.24,0:15:38.45,Main,,0,0,0,,...جلالتك
Dialogue: 0,0:15:39.83,0:15:42.96,Main,,0,0,0,,الرجلُ رجلٌ، والمرأةُ امرأةٌ
Dialogue: 0,0:15:43.04,0:15:48.30,Main,,0,0,0,,يجدر بالمرء أن يعيش على سجيّته كما خلقه الباري فحسب
Dialogue: 0,0:15:49.21,0:15:52.59,Main,,0,0,0,,:باسم الملك ناوكليف، آمر بالآتي
Dialogue: 0,0:15:52.68,0:15:56.85,Main,,0,0,0,,السماح للطالبة ساريس رايبير بالبقاء في الأكاديميّة
Dialogue: 0,0:15:58.60,0:16:01.35,Main,,0,0,0,,هلّا جرّبتِ ارتداء فستانٍ بين الحين والآخر؟
Dialogue: 0,0:16:06.69,0:16:07.82,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:16:08.36,0:16:11.49,Main,,0,0,0,,!توقّفي! أتريدين إهدار وصيّة جلالته سُدًى؟
Dialogue: 0,0:16:31.13,0:16:32.97,Main,,0,0,0,,!تماديتَ في غيّكَ أيّها الوغد
Dialogue: 0,0:16:38.22,0:16:39.39,Main,,0,0,0,,!تبًّا
Dialogue: 0,0:16:44.14,0:16:45.56,Main,,0,0,0,,!لا جدوى
Dialogue: 0,0:16:45.61,0:16:47.15,Main,,0,0,0,,!لا تؤثّر فيه ضرباتنا البتّة
Dialogue: 0,0:16:52.74,0:16:57.07,Main,,0,0,0,,!اجمعي كلّ ما تستطيعين من طاقة طور الياقوتيّ في يدكِ اليمنى يا ميل
Dialogue: 0,0:16:59.58,0:17:00.21,Main,,0,0,0,,لماذا؟
Dialogue: 0,0:17:00.28,0:17:01.29,Main,,0,0,0,,!أسرعي
Dialogue: 0,0:17:01.33,0:17:02.58,Main,,0,0,0,,!حاضر
Dialogue: 0,0:17:16.64,0:17:18.05,Main,,0,0,0,,!تنحَّ عن طريقي
Dialogue: 0,0:17:20.14,0:17:22.72,Main,,0,0,0,,...جلالتك
Dialogue: 0,0:17:26.06,0:17:28.61,Main,,0,0,0,,!فرصتنا الوحيدة تكمن في مباغتته حين يشنّ هجومه
Dialogue: 0,0:17:28.94,0:17:30.77,Main,,0,0,0,,!إنّه يقترب منّا
Dialogue: 0,0:18:03.02,0:18:04.77,Main,,0,0,0,,...جلالتك
Dialogue: 0,0:18:20.95,0:18:22.65,Main,,0,0,0,,!أسرعي يا ميل
Dialogue: 0,0:18:22.72,0:18:23.83,Main,,0,0,0,,!كدتُ أنتهي
Dialogue: 0,0:18:26.91,0:18:28.00,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:18:28.08,0:18:29.75,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:19:02.74,0:19:04.79,Main,,0,0,0,,...ليس بعد، ليقترب أكثر
Dialogue: 0,0:19:07.00,0:19:08.37,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:19:20.01,0:19:21.01,Main,,0,0,0,,...جلالتك
Dialogue: 0,0:19:26.56,0:19:28.93,Main,,0,0,0,,هيّا، لِمَ لا تهاجم؟
Dialogue: 0,0:19:29.27,0:19:31.81,Main,,0,0,0,,!سنكون في خطرٍ داهمٍ إن اقترب أكثر
Dialogue: 0,0:19:31.98,0:19:34.32,Main,,0,0,0,,!قولي هذا له
Dialogue: 0,0:19:34.48,0:19:37.48,Main,,0,0,0,,!عسى أن يهدأ غضب الإله
Dialogue: 0,0:19:37.90,0:19:38.53,Main,,0,0,0,,!الآن
Dialogue: 0,0:20:24.32,0:20:27.24,Main,,0,0,0,,لن تضلي الطريق ما دام هذا بحوزتكِ
Dialogue: 0,0:20:27.53,0:20:28.62,Main,,0,0,0,,...جلالتك
Dialogue: 0,0:20:30.66,0:20:31.96,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:20:56.68,0:21:01.08,Main,,0,0,0,,،مع انهيار حاجز إبطال الأطوار، سقطت مملكة بيستال في غياهب الهلاك
Dialogue: 0,0:21:01.24,0:21:06.21,Main,,0,0,0,,وبسطتْ طائفة جاينا المقدّسة هيمنتها تحت راية إمبراطوريّة بارتونيا
Dialogue: 0,0:21:10.16,0:21:12.91,Main,,0,0,0,,رغم مرارة هذا، لا حيلة بأيدينا في الوقت الراهن
Dialogue: 0,0:21:13.66,0:21:18.38,Main,,0,0,0,,ولم يبقَ أمامنا سوى التوجّه إلى مملكة بالانيا لنستجمع قوانا من جديد
Dialogue: 0,0:21:18.46,0:21:22.17,Main,,0,0,0,,لا تقلق يا وول-دونو، فلن يساورني أيّ تردّدٍ بعد الآن
Dialogue: 0,0:21:22.92,0:21:26.30,Main,,0,0,0,,سأمضي في الدرب المرسوم لي دون أيّ ارتياب
Dialogue: 0,0:21:31.10,0:21:32.36,Main,,0,0,0,,!أيّتها الأميرة ميل
Dialogue: 0,0:21:32.92,0:21:37.69,Main,,0,0,0,,،أنا ساريس رايبير، بدءًا من هذا اليوم وهذه اللحظة بالذات
Dialogue: 0,0:21:37.69,0:21:41.38,Main,,0,0,0,,سأحميكِ ولو بذلتُ روحي في سبيل ذلك
Dialogue: 0,0:24:09.14,0:24:11.14,Main,,0,0,0,,!انظر إلى هذا يا أستر
Dialogue: 0,0:24:11.18,0:24:14.31,Main,,0,0,0,,سيناريو الحلقة العاشرة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:14.39,0:24:18.23,Main,,0,0,0,,..."ماذا؟ ماذا؟ "تدور هذه الحلقة حول السوليود وأستر
Dialogue: 0,0:24:18.31,0:24:21.98,Main,,0,0,0,,وتتمحور حول معركةٍ ضاريةٍ حاسمة ضدّ صديقتهما القديمة ميدوسا
Dialogue: 0,0:24:23.01,0:24:23.99,Main,,0,0,0,,...أهذا يعني
Dialogue: 0,0:24:24.07,0:24:26.15,Main,,0,0,0,,...أجل، نحن أخيرًا
Dialogue: 0,0:24:26.24,0:24:28.20,Main,,0,0,0,,!البطلان
Dialogue: 0,0:24:28.82,0:24:30.58,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:30.66,0:24:33.45,Main,,0,0,0,,عاصفةٌ وبرقٌ خاطف، نِزالٌ في وضح النهار
Dialogue: 0,0:24:33.50,0:24:34.68,Main,,0,0,0,,!احرصوا على مشاهدتها
Dialogue: 0,0:24:35.00,0:24:36.46,Main,,0,0,0,,!لن أسمح لكما بذلك
Comment: 0,0:24:36.46,0:24:38.46,Signs,,0,0,0,,
Dialogue: 0,0:02:41.51,0:02:47.52,Signs,,0,0,0,,الانهيار المحزن لإمبراطوريّة مزدهرة
Dialogue: 0,0:24:33.74,0:24:37.74,Signs,,0,0,0,,عاصفةٌ وبرقٌ خاطف، نِزالٌ في وضح النهار
