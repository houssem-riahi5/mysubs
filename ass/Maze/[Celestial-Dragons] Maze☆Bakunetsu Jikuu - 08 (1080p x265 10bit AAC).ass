Dialogue: 0,0:00:01.35,0:00:02.38,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:07.14,0:02:08.60,Main,,0,0,0,,كفاكِ صراخًا
Dialogue: 0,0:02:08.75,0:02:10.51,Main,,0,0,0,,سيهربُ طعامي هكذا
Dialogue: 0,0:02:25.16,0:02:28.62,Main,,0,0,0,,سقطتْ عليَّ فتاةٌ حسناء
Dialogue: 0,0:02:29.87,0:02:33.73,Main,,0,0,0,,بالنظر إلى هذا الطوق الّذي ترتدينه، فلا بدَّ أنّكِ فولنار
Dialogue: 0,0:02:38.84,0:02:41.01,Main,,0,0,0,,وعلاوةً على ذلك، مِعكِ جنيّة
Dialogue: 0,0:02:41.24,0:02:42.86,Main,,0,0,0,,مـ-ما الّذي تنظرُ إليه؟
Dialogue: 0,0:02:42.93,0:02:44.35,Main,,0,0,0,,من أنتَ؟
Dialogue: 0,0:02:44.68,0:02:46.68,Main,,0,0,0,,ماذا؟ لا تبدينَ ودودةً إطلاقًا
Dialogue: 0,0:02:46.97,0:02:49.02,Main,,0,0,0,,لا بأس بنظرةٍ خاطفةٍ إضافيّة
Dialogue: 0,0:02:49.10,0:02:50.40,Main,,0,0,0,,!ما الّذي تقوله؟
Dialogue: 0,0:02:50.44,0:02:52.80,Main,,0,0,0,,أُدعى دولنارد وول
Dialogue: 0,0:02:52.93,0:02:56.07,Main,,0,0,0,,كنتُ رئيس وزراء إمبراطوريّة بيستال في ما مضى
Dialogue: 0,0:02:56.44,0:02:57.66,Main,,0,0,0,,رئيس الوزراء؟
Dialogue: 0,0:02:58.51,0:02:59.46,Main,,0,0,0,,أجل
Dialogue: 0,0:02:59.60,0:03:03.33,Main,,0,0,0,,واعتذارًا عن إخافتكِ، أودُّ دعوتكِ إلى منزلي، فما رأيكِ؟
Dialogue: 0,0:03:09.89,0:03:12.05,Main,,0,0,0,,متاهةُ المؤامرة الخبيثة
Dialogue: 0,0:03:24.15,0:03:28.31,Main,,0,0,0,,بالمناسبة أيّها الأمير، إلى أين سنذهب الليلة؟
Dialogue: 0,0:03:28.80,0:03:29.71,Main,,0,0,0,,!قُد بأقصى سرعة
Dialogue: 0,0:03:29.80,0:03:30.60,Main,,0,0,0,,!حاضر
Dialogue: 0,0:03:30.84,0:03:33.17,Main,,0,0,0,,!قلتُ لكَ لا يهمّني أين نذهب
Dialogue: 0,0:03:33.22,0:03:33.82,Main,,0,0,0,,!حاضر
Dialogue: 0,0:03:47.87,0:03:53.17,Main,,0,0,0,,الفتاةُ الّتي تبحثون عنها محتجزةٌ في المتاهة السُّفليّة
Dialogue: 0,0:03:53.25,0:03:55.59,Main,,0,0,0,,وهذه مشكلةٌ حقيقيّة
Dialogue: 0,0:03:55.67,0:04:00.80,Main,,0,0,0,,فللوصول إليها، لا بدَّ من استخدام ممرٍّ سرّيٍّ يؤدّي إلى المتاهة
Dialogue: 0,0:04:05.76,0:04:07.35,Main,,0,0,0,,شكرًا
Dialogue: 0,0:04:08.31,0:04:11.62,Main,,0,0,0,,،أيّها الأمير، يُؤسفني قول هذا
Dialogue: 0,0:04:11.97,0:04:14.31,Main,,0,0,0,,لكنَّ العثور على أيِّ وصيفةٍ في مثل هذه الساعة المتأخرة أمرٌ محال
Dialogue: 0,0:04:14.40,0:04:16.36,Main,,0,0,0,,علاوةً على ذلك، أُنهِك الحصانُ تمامًا
Dialogue: 0,0:04:16.73,0:04:17.95,Main,,0,0,0,,لِمَ؟
Dialogue: 0,0:04:18.20,0:04:20.80,Main,,0,0,0,,لِمَ لا تطيعُ أوامري؟
Dialogue: 0,0:04:23.61,0:04:27.26,Main,,0,0,0,,الجميع يأتمرون بأمري باستثنائها
Dialogue: 0,0:04:32.77,0:04:33.66,Main,,0,0,0,,تفضّل
Dialogue: 0,0:04:37.82,0:04:39.20,Main,,0,0,0,,؟!من أنتَ أيّها الوغد
Dialogue: 0,0:04:39.55,0:04:41.88,Main,,0,0,0,,أنا مجرّد بائع حلوى
Dialogue: 0,0:04:42.80,0:04:45.11,Main,,0,0,0,,تفضّل بتذوّق هذه الهديّة البسيطة
Dialogue: 0,0:04:45.33,0:04:47.62,Main,,0,0,0,,!كيف تجرؤ على الاقتراب من سموّ الأمير دون إذن؟
Dialogue: 0,0:04:47.66,0:04:49.68,Main,,0,0,0,,أعجبتني، أصبحتَ خادمي بدءًا من الآن
Dialogue: 0,0:04:49.68,0:04:50.86,Main,,0,0,0,,!أيّها الأمير
Dialogue: 0,0:04:50.93,0:04:52.35,Main,,0,0,0,,هذا أمر، أفهمت؟
Dialogue: 0,0:04:52.85,0:04:55.02,Main,,0,0,0,,سمعًا وطاعة
Dialogue: 0,0:04:55.56,0:04:58.51,Main,,0,0,0,,أتعيش في مكانٍ كهذا مُنذ عامين؟
Dialogue: 0,0:04:58.66,0:05:02.15,Main,,0,0,0,,،هذه عاقبةُ إخفاقي في كبح استبداد الملكة
Dialogue: 0,0:05:02.24,0:05:04.11,Main,,0,0,0,,فلستُ فخورًا بهذا البتّة
Dialogue: 0,0:05:04.91,0:05:09.31,Main,,0,0,0,,تلك المرأة مهووسةٌ بتنصيب ابنها ملكًا على القارّة بأكملها
Dialogue: 0,0:05:09.40,0:05:11.99,Main,,0,0,0,,...دكتاتوريّةٌ في الداخل، ومتحالفةٌ مع جاينا في الخارج
Dialogue: 0,0:05:12.08,0:05:14.40,Main,,0,0,0,,وبهذا المعدّل، ستنهار إمبراطوريّتنا بيستال حتمًا
Dialogue: 0,0:05:14.75,0:05:17.20,Main,,0,0,0,,لا يسعني الاستسلام للموتِ الآن
Dialogue: 0,0:05:17.20,0:05:18.35,Main,,0,0,0,,تفضّلا
Dialogue: 0,0:05:18.80,0:05:21.88,Main,,0,0,0,,مذاقُهُ سيّئ، لكنّه قابلٌ للأكل
Dialogue: 0,0:05:22.71,0:05:24.88,Main,,0,0,0,,لا أظنُّ أنّنا قادرون على تناول هذا
Dialogue: 0,0:05:25.08,0:05:26.40,Main,,0,0,0,,أليس كذلك يا ميز-سان؟
Dialogue: 0,0:05:54.66,0:05:58.71,Main,,0,0,0,,آسفة، لكنَّ قلبي لا يتَّسعُ إلّا لحبِّ أونيه-ني-ساما
Dialogue: 0,0:06:00.91,0:06:02.46,Main,,0,0,0,,حفلُ زفاف؟
Dialogue: 0,0:06:02.57,0:06:05.15,Main,,0,0,0,,!يا له من تصرّفٍ قاسٍ للغاية
Dialogue: 0,0:06:05.40,0:06:09.89,Main,,0,0,0,,...من المفترض أن تكون ميزة تعطيل قدرات الأطوار وسيلةً لحفظ السلام والحدّ من النزاعات
Dialogue: 0,0:06:10.14,0:06:12.18,Main,,0,0,0,,!لا أداةً للسيطرة على القارّة
Dialogue: 0,0:06:12.43,0:06:13.39,Main,,0,0,0,,أجل
Dialogue: 0,0:06:13.47,0:06:15.93,Main,,0,0,0,,لِمَ الركضُ وراء الأطماع؟
Dialogue: 0,0:06:16.04,0:06:18.93,Main,,0,0,0,,لِمَ لا يعيشُ المرءُ سجيتَهُ كما خُلِق دون زيف؟
Dialogue: 0,0:06:19.80,0:06:21.48,Main,,0,0,0,,...على سجيّته
Dialogue: 0,0:06:41.88,0:06:44.88,Main,,0,0,0,,!اصمتي! لا مكانَ للنساء في عائلة ساريس
Dialogue: 0,0:06:44.96,0:06:46.86,Main,,0,0,0,,!أنجبتِ ولدًا
Dialogue: 0,0:06:46.95,0:06:50.48,Main,,0,0,0,,!سيكون رايبير ساريس الوريثَ السابع والثلاثين لسلالتنا
Dialogue: 0,0:06:55.14,0:07:11.13,Main,,0,0,0,,!أنتَ رجل! أنتَ رجل! أنتَ رجل
Dialogue: 0,0:07:12.62,0:07:15.15,Main,,0,0,0,,أجل، أنا رجل
Dialogue: 0,0:07:15.84,0:07:18.04,Main,,0,0,0,,ويجب أن أكون أقوى من أيِّ شخصٍ آخر
Dialogue: 0,0:07:18.12,0:07:19.37,Main,,0,0,0,,...ظللتُ آمنُ بهذا
Dialogue: 0,0:07:19.62,0:07:22.67,Main,,0,0,0,,إلى أن جاء ذلك اليوم الّذي التقيتُ فيه بجلالة الملك
Dialogue: 0,0:07:26.50,0:07:29.38,Main,,0,0,0,,لِمَ تتواجدُ فتاةٌ في الأكاديميّة العسكريّة؟
Dialogue: 0,0:07:36.51,0:07:40.69,Main,,0,0,0,,إنَّ خديعة جلالتك والتنكّر بهويّةٍ مزيّفةٍ جريمةٌ تستوجبُ الإعدام
Dialogue: 0,0:07:43.35,0:07:47.36,Main,,0,0,0,,،انتهكتُ قانون البلاد وشرف العهد
Dialogue: 0,0:07:47.44,0:07:49.49,Main,,0,0,0,,سأتقبّلُ أيّ عقابٍ ترونه مناسبًا
Dialogue: 0,0:07:50.44,0:07:54.82,Main,,0,0,0,,...انتهى أمري، وانتهى معه إرث عائلتي
Dialogue: 0,0:07:57.87,0:07:58.87,Main,,0,0,0,,جلالة الملك؟
Dialogue: 0,0:07:59.71,0:08:04.68,Main,,0,0,0,,لم أتوقّع حدوث أمرٍ كهذا في هذه الأكاديميّة المخصّصة للرجال
Dialogue: 0,0:08:04.88,0:08:06.53,Main,,0,0,0,,بل أنا من يتوجّب عليه الاعتذار
Dialogue: 0,0:08:06.53,0:08:07.77,Main,,0,0,0,,اعذريني
Dialogue: 0,0:08:07.95,0:08:12.13,Main,,0,0,0,,كلّا، أنا المخطئة بالكامل، فكيف تعتذرُ أنت؟
Dialogue: 0,0:08:12.43,0:08:16.51,Main,,0,0,0,,أنتِ امرأةٌ، أليس كذلك؟
Dialogue: 0,0:08:17.02,0:08:17.75,Main,,0,0,0,,أجل
Dialogue: 0,0:08:18.31,0:08:21.71,Main,,0,0,0,,هذا صحيح، الرجلُ رجلٌ، والمرأةُ امرأةٌ
Dialogue: 0,0:08:21.84,0:08:25.82,Main,,0,0,0,,يجدر بالمرء أن يعيش على سجيّته كما خلقه الباري فحسب
Dialogue: 0,0:08:26.23,0:08:30.11,Main,,0,0,0,,تمتلكين كلَّ المؤهلات لتغدي فارسًا ملكيًّا
Dialogue: 0,0:08:30.15,0:08:32.11,Main,,0,0,0,,ولا داعي لتشعري بالخجل من ذلك
Dialogue: 0,0:08:32.65,0:08:34.88,Main,,0,0,0,,...لكن يا جلالة الملك، أنا
Dialogue: 0,0:08:40.02,0:08:44.79,Main,,0,0,0,,:باسم الملك ناوكليف، آمر بالآتي
Dialogue: 0,0:08:45.28,0:08:48.71,Main,,0,0,0,,السماح للطالبة ساريس رايبير بالبقاء في الأكاديميّة
Dialogue: 0,0:08:49.15,0:08:50.02,Main,,0,0,0,,!حاضر
Dialogue: 0,0:08:50.25,0:08:54.72,Main,,0,0,0,,،لأوّل مرّةٍ في حياتي، شعرتُ وكأنَّ نورًا أضاء عتمة أيّامي
Dialogue: 0,0:08:54.72,0:08:57.51,Main,,0,0,0,,نورٌ صادقٌ ودافئٌ للغاية
Dialogue: 0,0:08:57.76,0:09:02.27,Main,,0,0,0,,حينها قطعتُ عهدًا على نفسي بأن أهبَ حياتي خدمةً لجلالة الملك
Dialogue: 0,0:09:02.31,0:09:06.10,Main,,0,0,0,,أكرّسُ قوّتي ومهاراتي، وحتّى روحي
Dialogue: 0,0:09:07.10,0:09:11.48,Main,,0,0,0,,عقدتُ العزم على أن أكون أخلص أتباعه
Dialogue: 0,0:09:13.11,0:09:15.62,Main,,0,0,0,,كان هذا الهدف الّذي عشتُ لأجله فحسب
Dialogue: 0,0:09:22.79,0:09:26.21,Main,,0,0,0,,لكنَّ ذلك اقتضى التضحية بأُنُوثتي
Dialogue: 0,0:09:26.64,0:09:29.00,Main,,0,0,0,,ولن أكون تلك الزهرة الرقيقة الّتي يُعجبُ بها الآخرون
Dialogue: 0,0:09:29.75,0:09:34.20,Main,,0,0,0,,...لو تصرّفتُ كأنثى وسعيتُ لأكون الأقرب إلى قلبه
Dialogue: 0,0:09:37.05,0:09:38.84,Main,,0,0,0,,...فإن تلك المرأة حتمًا
Dialogue: 0,0:09:41.44,0:09:42.51,Main,,0,0,0,,...أنا
Dialogue: 0,0:09:45.02,0:09:45.77,Main,,0,0,0,,!من هناك؟
Dialogue: 0,0:09:47.65,0:09:48.94,Main,,0,0,0,,الأميرةُ ميل
Dialogue: 0,0:09:51.40,0:09:52.51,Main,,0,0,0,,انتظري رجاءً
Dialogue: 0,0:09:52.53,0:09:54.75,Main,,0,0,0,,إلى أين تذهبين بمفردكِ؟
Dialogue: 0,0:09:54.95,0:09:56.15,Main,,0,0,0,,!اتركيني
Dialogue: 0,0:09:56.17,0:09:57.78,Main,,0,0,0,,!سأذهبُ إلى المتاهة السُّفليّة
Dialogue: 0,0:09:59.57,0:10:02.71,Main,,0,0,0,,!سأذهبُ لإنقاذ أونيه-ني-ساما
Dialogue: 0,0:10:03.62,0:10:05.91,Main,,0,0,0,,!لا بُدَّ أن أذهب
Dialogue: 0,0:10:07.83,0:10:11.92,Main,,0,0,0,,أيّتها الأميرة ميل، اهدئي أوّلًا واشرحي لنا الأمر
Dialogue: 0,0:10:12.00,0:10:14.84,Main,,0,0,0,,لربما يسعُنا تقديمُ المساعدة
Dialogue: 0,0:10:33.19,0:10:35.61,Main,,0,0,0,,...ها أنا مجدّدًا
Dialogue: 0,0:10:37.61,0:10:38.82,Main,,0,0,0,,...أنا
Dialogue: 0,0:10:40.70,0:10:42.87,Main,,0,0,0,,هل من أحدٍ هنا يا ترى؟
Dialogue: 0,0:10:45.70,0:10:47.37,Main,,0,0,0,,!ميز الفتى؟
Dialogue: 0,0:10:52.80,0:10:53.44,Main,,0,0,0,,ما الأمر؟
Dialogue: 0,0:10:55.05,0:10:56.59,Main,,0,0,0,,ما الّذي يحدث؟
Dialogue: 0,0:11:00.01,0:11:01.64,Main,,0,0,0,,من هؤلاء الأشخاص؟
Dialogue: 0,0:11:01.72,0:11:05.75,Main,,0,0,0,,إنّهم قتلةٌ مأجورون، وتحديدًا من نخبة كاساندرا الخاصّة
Dialogue: 0,0:11:05.91,0:11:09.35,Main,,0,0,0,,يبدو أنّكم تُشكّلون خطرًا كبيرًا عليها
Dialogue: 0,0:11:09.98,0:11:15.37,Main,,0,0,0,,!أزمةٌ ومصيدةٌ وزواجٌ قسريٌّ ومتاهةٌ سُفليّة، إنّنا في خطرٍ مُحدِق
Dialogue: 0,0:11:16.57,0:11:19.40,Main,,0,0,0,,ماذا؟ المتاهة السُّفليّة؟
Dialogue: 0,0:11:20.07,0:11:21.74,Main,,0,0,0,,!ساعدوني رجاءً
Dialogue: 0,0:11:22.24,0:11:23.35,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:11:23.44,0:11:26.35,Main,,0,0,0,,خذي رايبير معكِ كمرافِقة إذن
Dialogue: 0,0:11:26.46,0:11:27.12,Main,,0,0,0,,!جلالة الملك
Dialogue: 0,0:11:29.71,0:11:31.68,Main,,0,0,0,,خذي هذا معكِ
Dialogue: 0,0:11:35.20,0:11:38.08,Main,,0,0,0,,...أليس هذا خاتمُ العائلة الملكيّة
Dialogue: 0,0:11:38.88,0:11:40.01,Main,,0,0,0,,أجل
Dialogue: 0,0:11:40.09,0:11:44.57,Main,,0,0,0,,في الأصل، كانت تلك المتاهةُ ممرًّا لهروب العائلة الملكيّة في حالات الطوارئ
Dialogue: 0,0:11:45.05,0:11:47.68,Main,,0,0,0,,وهذا الخاتمُ سيرشدُكِ إلى الطريق الصحيح دائمًا
Dialogue: 0,0:11:51.94,0:11:53.60,Main,,0,0,0,,احرصي على هذا يا رايبير
Dialogue: 0,0:11:53.65,0:11:57.02,Main,,0,0,0,,عليكِ بحماية الأميرة ميل أثناء عبور المتاهة السُّفليّة
Dialogue: 0,0:11:57.78,0:12:00.53,Main,,0,0,0,,!حاضر، سأحميها حتّى لو كلفني ذلك حياتي
Dialogue: 0,0:12:02.84,0:12:04.62,Main,,0,0,0,,أيّتها الأميرة ميل، سأرافقكِ
Dialogue: 0,0:12:04.62,0:12:05.17,Main,,0,0,0,,من هنا
Dialogue: 0,0:12:05.26,0:12:06.24,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:12:41.07,0:12:43.53,Main,,0,0,0,,يبدو أنّه لا خيار أمامنا
Dialogue: 0,0:12:44.03,0:12:46.24,Main,,0,0,0,,حسنٌ، نحنُ نستسلم
Dialogue: 0,0:13:00.34,0:13:04.76,Main,,0,0,0,,!تذوّقوا هذه القنابل المحليّة الصنع الّتي استغرق تطويرُها عامين
Dialogue: 0,0:13:04.84,0:13:06.18,Main,,0,0,0,,قـ-قنابل؟
Dialogue: 0,0:13:07.64,0:13:08.85,Main,,0,0,0,,!لنهرب
Dialogue: 0,0:13:13.89,0:13:15.57,Main,,0,0,0,,!أنتَ مذهلٌ بحقّ
Dialogue: 0,0:13:17.63,0:13:19.11,Main,,0,0,0,,لديَّ المزيدُ
Dialogue: 0,0:13:27.78,0:13:32.41,Main,,0,0,0,,...رورو لاجو... باجيرا ما
Dialogue: 0,0:13:32.54,0:13:36.92,Main,,0,0,0,,!توقّفي! سينهار جسدكِ إن استمرّيتِ
Dialogue: 0,0:13:36.96,0:13:38.93,Main,,0,0,0,,!وول-سان، ألقِ المزيد من القنابل
Dialogue: 0,0:13:39.00,0:13:40.66,Main,,0,0,0,,معذرةً، نفدت منّي
Dialogue: 0,0:13:40.75,0:13:43.05,Main,,0,0,0,,!أسترجعُ مدحي لك إذن
Dialogue: 0,0:13:44.42,0:13:46.97,Main,,0,0,0,,!ماها فايغر
Dialogue: 0,0:13:51.72,0:13:52.68,Main,,0,0,0,,!ميز-سان
Dialogue: 0,0:14:07.24,0:14:08.78,Main,,0,0,0,,إنّها قويّةٌ للغاية
Dialogue: 0,0:14:10.03,0:14:13.62,Main,,0,0,0,,تطوّرت مهاراتكِ كثيرًا مُنذ آخر مرّةٍ رأيتكِ فيها يا رايبير
Dialogue: 0,0:14:14.16,0:14:17.96,Main,,0,0,0,,!لم أتوقّع أنّك على قيد الحياة يا وول-دونو، يا لها من بُشرى سارّة
Dialogue: 0,0:14:18.79,0:14:20.75,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:14:21.59,0:14:24.09,Main,,0,0,0,,أونيه-ني-ساما، هل أنتِ بخير؟
Dialogue: 0,0:14:24.17,0:14:25.76,Main,,0,0,0,,ماذا عنكِ يا ميل-تشان؟
Dialogue: 0,0:14:25.84,0:14:27.30,Main,,0,0,0,,!ميل بخير
Dialogue: 0,0:14:27.34,0:14:31.72,Main,,0,0,0,,عذرًا، لكن لا وقت لدينا لإضاعته، علينا الهروب في الحال
Dialogue: 0,0:14:34.47,0:14:35.60,Main,,0,0,0,,فرقة فولنار؟
Dialogue: 0,0:14:35.64,0:14:37.06,Main,,0,0,0,,!سحقًا لكِ يا كاساندرا
Dialogue: 0,0:14:37.13,0:14:38.52,Main,,0,0,0,,!أتصلُ دناءتكِ إلى هذا الحدّ؟
Dialogue: 0,0:14:43.86,0:14:45.24,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:14:45.37,0:14:47.86,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:15:26.32,0:15:28.65,Main,,0,0,0,,كيف انتهى بنا المطاف في هذا المكان؟
Dialogue: 0,0:15:29.15,0:15:33.12,Main,,0,0,0,,...أيعقل أنَّ البلورات تفاعلت مع طاقة الأطوار
Dialogue: 0,0:15:33.12,0:15:36.03,Main,,0,0,0,,وتسبّبت في ظاهرةٍ شبيهةٍ بتقنيّة الفول رانا؟
Dialogue: 0,0:15:37.12,0:15:38.70,Main,,0,0,0,,استيقظتِ إذن؟
Dialogue: 0,0:15:42.12,0:15:45.75,Main,,0,0,0,,أحلَّ الليل بالفعل؟ لكنَّ الطوق ما زال في عنقك
Dialogue: 0,0:15:46.49,0:15:48.67,Main,,0,0,0,,أكان هذا بسبب البلورات أيضًا؟
Dialogue: 0,0:15:48.84,0:15:50.34,Main,,0,0,0,,!ميل
Dialogue: 0,0:15:50.59,0:15:53.80,Main,,0,0,0,,!ما هذا؟ عُدتُ أخيرًا بعد طول انتظار، هذا رائع
Dialogue: 0,0:15:53.89,0:15:56.01,Main,,0,0,0,,ميل، أين هي؟
Dialogue: 0,0:15:56.45,0:15:58.34,Main,,0,0,0,,...في الواقع يا ميز-سان
Dialogue: 0,0:15:58.41,0:16:02.19,Main,,0,0,0,,ميل؟ أين ذهبتْ ميل؟
Dialogue: 0,0:16:05.65,0:16:07.82,Main,,0,0,0,,!يا هذه، ليس هذا وقت القيلولة
Dialogue: 0,0:16:11.86,0:16:13.41,Main,,0,0,0,,!ما باليد حيلة
Dialogue: 0,0:16:15.03,0:16:17.99,Main,,0,0,0,,من أنتَ؟ وأين ذهبتْ ميز؟
Dialogue: 0,0:16:18.16,0:16:21.62,Main,,0,0,0,,عما تتحدّثين؟ أنا هو ميز، فمن قد أكون غير ذلك؟
Dialogue: 0,0:16:21.71,0:16:24.50,Main,,0,0,0,,...ترتدي الملابس والطوق ذاتهما حقًّا
Dialogue: 0,0:16:24.58,0:16:28.04,Main,,0,0,0,,لكنَّ هذا أمرٌ لا يُصدّق، أأنتَ رجلٌ حقًّا؟
Dialogue: 0,0:16:28.20,0:16:31.04,Main,,0,0,0,,!دعكِ من هذه التفاصيل الصغيرة
Dialogue: 0,0:16:31.15,0:16:33.53,Main,,0,0,0,,هذه طبيعة جسدي، ألديكِ مشكلةٌ في ذلك؟
Dialogue: 0,0:16:35.76,0:16:38.72,Main,,0,0,0,,لا وقت لديَّ للشرح الآن، أين أولئك الأوغاد؟
Dialogue: 0,0:16:39.20,0:16:40.20,Main,,0,0,0,,لا أعلم
Dialogue: 0,0:16:40.42,0:16:43.68,Main,,0,0,0,,حين استعدتُ وعيي، لم يكن أحد غيرنا هنا
Dialogue: 0,0:16:44.22,0:16:45.69,Main,,0,0,0,,ولا أدري أين البقية
Dialogue: 0,0:16:46.00,0:16:48.93,Main,,0,0,0,,!لا يسعني الوقوفُ مكتوفَ اليدين! عليَّ استعادة ميل
Dialogue: 0,0:16:48.94,0:16:50.93,Main,,0,0,0,,!لن أسمحَ لهم بمساسِ ميل أبدًا
Dialogue: 0,0:16:51.68,0:16:53.40,Main,,0,0,0,,ماذا هناك مجدّدًا؟
Dialogue: 0,0:16:53.91,0:16:57.42,Main,,0,0,0,,أتريدُ الهلاك وقدرةُ أطوارك مختومة؟
Dialogue: 0,0:16:57.42,0:16:59.33,Main,,0,0,0,,!ليس الأمرُ متعلّقًا بالحياة أو الموت
Dialogue: 0,0:16:59.82,0:17:03.11,Main,,0,0,0,,!إنَّ إنقاذ امرأةٍ رقيقة واجبٌ سرمديٌّ لكلِّ رجل
Dialogue: 0,0:17:06.75,0:17:08.57,Main,,0,0,0,,...امرأة
Dialogue: 0,0:17:09.63,0:17:12.84,Main,,0,0,0,,ما هذه النظرة؟ أنتِ امرأةٌ أيضًا
Dialogue: 0,0:17:13.17,0:17:13.82,Main,,0,0,0,,!لستُ كذلك
Dialogue: 0,0:17:13.91,0:17:16.60,Main,,0,0,0,,أنا سيّافٌ وفارسٌ قبل أن أكون امرأة
Dialogue: 0,0:17:16.76,0:17:19.93,Main,,0,0,0,,!ما هذه السُّخافة الّتي تتفوّهين بها؟! أنتِ امرأة
Dialogue: 0,0:17:21.40,0:17:22.15,Main,,0,0,0,,لستُ كذلك
Dialogue: 0,0:17:22.22,0:17:25.62,Main,,0,0,0,,!بل أنتِ كذلك، بل أنتِ امرأةٌ فاتنةٌ للغاية
Dialogue: 0,0:17:25.77,0:17:26.80,Main,,0,0,0,,!لستُ كذلك
Dialogue: 0,0:17:27.03,0:17:28.32,Main,,0,0,0,,!بل أنتِ كذلك
Dialogue: 0,0:17:28.41,0:17:29.53,Main,,0,0,0,,!لستُ كذلك
Dialogue: 0,0:17:31.35,0:17:33.08,Main,,0,0,0,,!كفاك هراءً
Dialogue: 0,0:17:34.42,0:17:36.91,Main,,0,0,0,,!توقّفي عن خداع نفسك والعيش في هوان
Dialogue: 0,0:17:36.91,0:17:39.87,Main,,0,0,0,,الرجلُ رجلٌ والمرأةُ امرأة
Dialogue: 0,0:17:40.04,0:17:43.09,Main,,0,0,0,,!هكذا ينبغي للبشر أن يعيشوا على سجيّتهم دون زيفٍ
Dialogue: 0,0:17:45.42,0:17:47.09,Main,,0,0,0,,!ا-اصمت
Dialogue: 0,0:17:47.63,0:17:50.30,Main,,0,0,0,,وما أدراكَ بألمي وحسرتي؟
Dialogue: 0,0:17:51.05,0:17:55.39,Main,,0,0,0,,،سيفي لا يحملُ سوى الموت، وعيناي لا تريان سوى الأعداء
Dialogue: 0,0:17:55.47,0:17:57.73,Main,,0,0,0,,!ولا يشتعلُ في صدري سوى لظى المعارك
Dialogue: 0,0:17:57.81,0:18:02.52,Main,,0,0,0,,!لولا هذا، ما كان لي أن أقف إلى جوار جلالته
Dialogue: 0,0:18:03.27,0:18:05.69,Main,,0,0,0,,أتستوعبُ مغزى هذا القول؟
Dialogue: 0,0:18:08.11,0:18:09.32,Main,,0,0,0,,مـ-ما الّذي تفعله؟
Dialogue: 0,0:18:28.26,0:18:32.34,Main,,0,0,0,,!لا أريدُ هذا يا أونيه-ني-ساما
Dialogue: 0,0:18:34.80,0:18:36.84,Main,,0,0,0,,!كلّا
Dialogue: 0,0:18:37.64,0:18:41.56,Main,,0,0,0,,،غدًا في هذه القاعة، سيعتلي رايريك العرش الشرعيّ لإمبراطوريّتي بارتونيا وبيستال
Dialogue: 0,0:18:41.56,0:18:43.11,Main,,0,0,0,,،ليحكم كِلا البلدين العظيمين
Dialogue: 0,0:18:44.66,0:18:48.44,Main,,0,0,0,,ويبسط سيطرته في نهاية المطاف على القارّة بأكملها
Dialogue: 0,0:18:48.53,0:18:50.53,Main,,0,0,0,,...ابنُ كاساندرا
Dialogue: 0,0:18:52.20,0:18:54.45,Main,,0,0,0,,ألم تعثروا على رايريك بعد؟
Dialogue: 0,0:18:54.57,0:18:57.24,Main,,0,0,0,,...بذلنا كلَّ ما في وسعنا، لكن
Dialogue: 0,0:18:57.83,0:19:01.41,Main,,0,0,0,,يا له من فتى يتركُ عروسهُ هكذا
Dialogue: 0,0:19:23.52,0:19:25.11,Main,,0,0,0,,!خرجنا أخيرًا
Dialogue: 0,0:19:25.77,0:19:30.93,Main,,0,0,0,,جلالة الملك، لا يسعني الموتُ الآن، بل يجبُ أن أعيش من أجلك
Dialogue: 0,0:19:31.36,0:19:34.91,Main,,0,0,0,,ما الخطب؟ وجُهكِ البديعُ سيفقد رونقه بهذا العبوس
Dialogue: 0,0:19:37.42,0:19:37.97,Main,,0,0,0,,!اصمت
Dialogue: 0,0:19:38.40,0:19:41.79,Main,,0,0,0,,!هيّا، لننقذ ميل، استدعي درعكِ الاصطناعيّ
Dialogue: 0,0:19:41.87,0:19:42.45,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:19:43.00,0:19:45.41,Main,,0,0,0,,!ألستِ فارسًا؟ أسرعي
Dialogue: 0,0:19:51.09,0:19:53.29,Main,,0,0,0,,!أسرعي يا رايبير الفاتنة
Dialogue: 0,0:19:53.51,0:19:54.50,Main,,0,0,0,,!اصمت
Dialogue: 0,0:19:55.97,0:19:59.62,Main,,0,0,0,,...يا سموّ الأمير رايريك، اقترب موعد حفل الزفاف
Dialogue: 0,0:19:59.77,0:20:03.93,Main,,0,0,0,,...كما أنَّ هذا المكان يُعدُّ سرًّا من أسرار الدولة العليا
Dialogue: 0,0:20:03.94,0:20:04.47,Main,,0,0,0,,!اخرس
Dialogue: 0,0:20:09.57,0:20:10.76,Main,,0,0,0,,أكان هذا ما أردتَ رؤيته؟
Dialogue: 0,0:20:10.85,0:20:12.17,Main,,0,0,0,,يا لغرابة أطوارك
Dialogue: 0,0:20:12.90,0:20:14.36,Main,,0,0,0,,!مذهل، مذهل
Dialogue: 0,0:20:14.42,0:20:18.61,Main,,0,0,0,,ما دام هذا الخاتمُ السحريّ قائمًا، فإمبراطوريّة بيستال الّتي نحكمها لا تُقهر
Dialogue: 0,0:20:18.78,0:20:21.70,Main,,0,0,0,,!أنا قويّ، وتُطاعُ كلّ رغباتي
Dialogue: 0,0:20:22.16,0:20:24.71,Main,,0,0,0,,!تمنّى أيّ شيءٍ وستحصل عليه في الحال
Dialogue: 0,0:20:24.79,0:20:25.57,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:20:26.08,0:20:27.33,Main,,0,0,0,,أُقسمُ لك
Dialogue: 0,0:20:28.46,0:20:29.92,Main,,0,0,0,,!يا لسعادتي
Dialogue: 0,0:20:31.92,0:20:35.72,Main,,0,0,0,,إذن، أودُّ الحصول على إمبراطوريّة بيستال
Dialogue: 0,0:20:40.14,0:20:41.60,Main,,0,0,0,,!أيّها الحمقى
Dialogue: 0,0:20:43.60,0:20:47.94,Main,,0,0,0,,!توقّفي يا رايبير-ساما، لا يليقُ بفارسٍ في مكانتكِ القيامُ بمثل هذا التصرّف
Dialogue: 0,0:20:48.02,0:20:50.06,Main,,0,0,0,,!بل استفيقوا أنتم من غفلتكم
Dialogue: 0,0:20:50.15,0:20:53.02,Main,,0,0,0,,!إنَّ استبداد الملكة كاساندرا هو ما يقود بلادنا إلى الهلاك المحتوم
Dialogue: 0,0:20:53.49,0:20:55.48,Main,,0,0,0,,!لِمَ لا تُدركون خطورة ذلك؟
Dialogue: 0,0:20:58.44,0:21:00.45,Main,,0,0,0,,!مؤلم، مؤلم، مؤلم
Dialogue: 0,0:21:04.20,0:21:06.12,Main,,0,0,0,,!عادتْ إليَّ قوّتي أخيرًا
Dialogue: 0,0:21:11.96,0:21:13.37,Main,,0,0,0,,!انتظريني يا ميل
Dialogue: 0,0:21:18.48,0:21:20.75,Main,,0,0,0,,ما الّذي حدث للتوّ؟
Dialogue: 0,0:21:23.04,0:21:24.31,Main,,0,0,0,,رايريك؟
Dialogue: 0,0:21:26.43,0:21:27.48,Main,,0,0,0,,من أنت؟
Dialogue: 0,0:21:28.65,0:21:32.35,Main,,0,0,0,,...إنَّ الخاويين والمغفّلين والّذين يعصون الأوامر
Dialogue: 0,0:21:33.25,0:21:35.55,Main,,0,0,0,,!سينزلُ بهم عذابُ الباري الأليم
Dialogue: 0,0:21:39.70,0:21:41.07,Main,,0,0,0,,،فرقة كنيسة جاينا المقدّسة
Dialogue: 0,0:21:42.16,0:21:44.83,Main,,0,0,0,,القائدُ الأعلى لجيش غزو بيستال؛ جيفا
Dialogue: 0,0:21:45.84,0:21:48.83,Main,,0,0,0,,!زالَ الحاجزُ الّذي يحمي هذه الإمبراطوريّة من طاقة الأطوار
Dialogue: 0,0:21:53.50,0:21:54.63,Main,,0,0,0,,!كلّا
Dialogue: 0,0:24:10.45,0:24:11.38,Main,,0,0,0,,!معكُم ميل
Dialogue: 0,0:24:11.38,0:24:14.01,Main,,0,0,0,,...حسنٌ، لنرَ ما يخبّئه لي طالعي
Dialogue: 0,0:24:14.31,0:24:16.60,Main,,0,0,0,,‫"الفراقُ بات وشيكًا؟"
Dialogue: 0,0:24:16.68,0:24:22.89,Main,,0,0,0,,"وستجرفكِ أمواجُ القدر العاتية"
Dialogue: 0,0:24:22.94,0:24:25.90,Main,,0,0,0,,"تميمة حظّكِ؛ سيف"
Dialogue: 0,0:24:25.94,0:24:28.73,Main,,0,0,0,,!تبيّن أنّي كنتُ أقرأ طالع رايبير-سان
Dialogue: 0,0:24:28.98,0:24:31.28,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:31.36,0:24:33.41,Main,,0,0,0,,الانهيار المحزن لإمبراطوريّة مزدهرة
Dialogue: 0,0:24:33.49,0:24:35.87,Main,,0,0,0,,!حظُّ ميل لا ينفدُ أبدًا
Comment: 0,0:24:35.87,0:24:37.87,Signs,,0,0,0,,
Dialogue: 0,0:03:09.04,0:03:15.04,Signs,,0,0,0,,متاهةُ المؤامرة الخبيثة
Dialogue: 0,0:24:32.78,0:24:36.78,Signs,,0,0,0,,الانهيار المحزن لإمبراطوريّة مزدهرة
