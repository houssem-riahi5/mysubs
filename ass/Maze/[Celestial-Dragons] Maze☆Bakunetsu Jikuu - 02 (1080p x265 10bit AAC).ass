Dialogue: 0,0:00:01.02,0:00:02.02,Main,,0,0,0,,لنبدأ
Dialogue: 0,0:02:08.50,0:02:11.66,Main,,0,0,0,,!ثنائيٌّ خارقٌ وسريعٌ كالبرق
Dialogue: 0,0:02:16.03,0:02:19.53,Main,,0,0,0,,غدتْ ماهافارنا مدينةً مُملّة
Dialogue: 0,0:02:20.07,0:02:25.16,Main,,0,0,0,,سحقًا، تغيير اسم العاصمة لن يُضفي عليها هيبةً
Dialogue: 0,0:02:25.24,0:02:27.66,Main,,0,0,0,,وعلاوةً على ذلك، فهي تابعةٌ لكنيسة جاينا المقدّسة
Dialogue: 0,0:02:27.89,0:02:29.82,Main,,0,0,0,,لا بُدَّ أنَّ الملك الجديد يُقاسي الأمَرّين
Dialogue: 0,0:02:29.95,0:02:31.07,Main,,0,0,0,,أصبتِ القول
Dialogue: 0,0:02:31.21,0:02:32.22,Main,,0,0,0,,!أيّها العمّ
Dialogue: 0,0:02:32.75,0:02:35.88,Main,,0,0,0,,يجدر بكما التوقّف عند هذا الحدّ أيّها الزبونان
Dialogue: 0,0:02:35.90,0:02:37.54,Main,,0,0,0,,لماذا أيّها البخيل؟
Dialogue: 0,0:02:37.92,0:02:40.05,Main,,0,0,0,,كلّا، لا أقصد الشراب
Dialogue: 0,0:02:40.09,0:02:44.06,Main,,0,0,0,,ففرسان المعبد يسترقون السمع في كلّ حدبٍ وصوبٍ هذه الأيّام
Dialogue: 0,0:02:44.08,0:02:46.28,Main,,0,0,0,,أنغدو متمرّدين بزلّة لسانٍ واحدةٍ؟
Dialogue: 0,0:02:46.32,0:02:48.24,Main,,0,0,0,,!اخفضا صوتيكما
Dialogue: 0,0:02:48.24,0:02:49.64,Main,,0,0,0,,!يا لهُ من أمرٍ
Dialogue: 0,0:02:54.52,0:02:56.19,Main,,0,0,0,,!أنتَ هناك
Dialogue: 0,0:02:57.57,0:02:58.19,Main,,0,0,0,,أتقصدني؟
Dialogue: 0,0:02:58.44,0:03:00.78,Main,,0,0,0,,!أجل، عثرتُ عليكَ أخيرًا
Dialogue: 0,0:03:00.86,0:03:04.91,Main,,0,0,0,,لا تظنّنَّ أنّكَ ستنجو بفعلتكَ بعد إهانتكَ لفرسان المعبد
Dialogue: 0,0:03:05.18,0:03:06.24,Main,,0,0,0,,أهنت؟
Dialogue: 0,0:03:06.45,0:03:10.12,Main,,0,0,0,,عجبًا، أليس هذا الشابّ المنبوذ من ظهيرة اليوم؟
Dialogue: 0,0:03:10.37,0:03:13.04,Main,,0,0,0,,كيف حالكَ؟ أوجدتَ فتاةً أخرى؟
Dialogue: 0,0:03:13.21,0:03:14.13,Main,,0,0,0,,!سحقًا لكَ
Dialogue: 0,0:03:14.73,0:03:18.30,Main,,0,0,0,,مُخيف، ما الّذي ارتكبتَه بحقّه؟
Dialogue: 0,0:03:18.38,0:03:23.64,Main,,0,0,0,,حسنٌ، كان ذلك المُدرّع يتحرّش بفتاةٍ في البلدة
Dialogue: 0,0:03:28.64,0:03:32.06,Main,,0,0,0,,فلقّنته درسًا ليس إلّا
Dialogue: 0,0:03:32.19,0:03:35.44,Main,,0,0,0,,إذن، لِمَ كنتَ هناك أساسًا؟
Dialogue: 0,0:03:35.48,0:03:37.57,Main,,0,0,0,,ماذا تعنين بـ "لِمَ"؟
Dialogue: 0,0:03:37.98,0:03:40.19,Main,,0,0,0,,شكرًا جزيلًا لكَ
Dialogue: 0,0:03:43.61,0:03:45.58,Main,,0,0,0,,لا تسألي عن أمورٍ خطرةٍ
Dialogue: 0,0:03:45.62,0:03:48.12,Main,,0,0,0,,حسبك، ديدنُ الرجال هكذا دومًا
Dialogue: 0,0:03:48.58,0:03:50.50,Main,,0,0,0,,!فيمَ تتهامسان؟
Dialogue: 0,0:03:50.58,0:03:54.21,Main,,0,0,0,,اسمعا، فرسان المعبد هم العدالة والنظام في هذه البلدة
Dialogue: 0,0:03:54.29,0:03:57.30,Main,,0,0,0,,وكلُّ مَن يعيقُ مساعينا المقدّسة يُعدُّ شرًّا
Dialogue: 0,0:03:57.96,0:03:59.63,Main,,0,0,0,,هذا هراءٌ
Dialogue: 0,0:03:59.67,0:04:04.14,Main,,0,0,0,,!اصمت، سنذيقك وبال إهانتك لفرسان المعبد
Dialogue: 0,0:04:10.98,0:04:13.77,Main,,0,0,0,,ويحي، تماديتُ مجدّدًا
Dialogue: 0,0:04:13.85,0:04:15.48,Main,,0,0,0,,ما الّذي اقترفتُماه؟
Dialogue: 0,0:04:15.56,0:04:18.27,Main,,0,0,0,,لن تخرجا من هذه البلدة أحياءً
Dialogue: 0,0:04:18.86,0:04:20.99,Main,,0,0,0,,لا داعي للقلق
Dialogue: 0,0:04:21.07,0:04:24.91,Main,,0,0,0,,اسمع أيّها العمّ، اسمي أستروت ريغي
Dialogue: 0,0:04:25.28,0:04:27.20,Main,,0,0,0,,وأنا سوليود سفولتز
Dialogue: 0,0:04:27.74,0:04:31.00,Main,,0,0,0,,وإن لزم الأمر، سأدمّرُ البلدة وأغادرها
Dialogue: 0,0:04:31.08,0:04:32.88,Main,,0,0,0,,!أستار وسوليود؟
Dialogue: 0,0:04:33.11,0:04:35.14,Main,,0,0,0,,...إذن أنتما
Dialogue: 0,0:04:35.54,0:04:37.29,Main,,0,0,0,,اعتنِ بنفسكَ أيّها العمّ
Dialogue: 0,0:04:38.34,0:04:40.46,Main,,0,0,0,,...صائدا الديمي
Dialogue: 0,0:05:03.57,0:05:05.36,Main,,0,0,0,,...ستحلُّ كارثةٌ
Dialogue: 0,0:05:05.70,0:05:11.20,Main,,0,0,0,,ستحلُّ كارثةٌ عظمى بكنيسة جاينا المقدّسة
Dialogue: 0,0:05:11.54,0:05:15.46,Main,,0,0,0,,يجب درءُ هذه الكارثة
Dialogue: 0,0:05:15.54,0:05:18.04,Main,,0,0,0,,...توجّه إلى غابة بانون
Dialogue: 0,0:05:18.13,0:05:21.92,Main,,0,0,0,,وامحي ذينكَ الشريرين من الوجود
Dialogue: 0,0:05:23.09,0:05:25.42,Main,,0,0,0,,أمركَ مُطاعٌ أيّها المؤسس
Dialogue: 0,0:05:25.76,0:05:32.01,Main,,0,0,0,,أحدهما ميل فارنا، والآخر هو ميز
Dialogue: 0,0:05:32.10,0:05:35.56,Main,,0,0,0,,يملك ذلك الأخير قوّةً تضاهي قوّتي
Dialogue: 0,0:05:35.64,0:05:38.15,Main,,0,0,0,,أيّ أنّه فولنار سيّد
Dialogue: 0,0:05:38.65,0:05:40.15,Main,,0,0,0,,فولنار سيّد؟
Dialogue: 0,0:05:40.40,0:05:41.58,Main,,0,0,0,,...غير أنّي
Dialogue: 0,0:05:41.76,0:05:44.24,Main,,0,0,0,,موقنةٌ بقدرتكَ على تدبّر الأمر
Dialogue: 0,0:05:44.32,0:05:47.20,Main,,0,0,0,,أليس كذلك يا غوجاس الآسر؟
Dialogue: 0,0:05:48.95,0:05:51.58,Main,,0,0,0,,أجل، أنا آسرٌ
Dialogue: 0,0:05:51.78,0:05:54.95,Main,,0,0,0,,وهذا الجمال كلّه مُكرّسٌ لخدمتكِ أيّتها المؤسسة
Dialogue: 0,0:05:55.00,0:05:59.21,Main,,0,0,0,,!أُقسمُ بجمالي أنّي سأرديهما قتيلين
Dialogue: 0,0:05:59.50,0:06:00.92,Main,,0,0,0,,...سأُثبت لكِ
Dialogue: 0,0:06:01.00,0:06:04.01,Main,,0,0,0,,!أنْ لا قوّة في هذا العالم تعلو على الجمال
Dialogue: 0,0:06:17.10,0:06:21.52,Main,,0,0,0,,بمعنى آخر، كلّ ما عليَّ فعله هو سحق أتباع جاينا أولئك، أليس كذلك؟
Dialogue: 0,0:06:21.56,0:06:26.74,Main,,0,0,0,,أجل، لكن هذا لا ينفي حقيقة أنَّ الانقلاب كان بقيادة عمّي؛ الدوق غودرن ماغنا
Dialogue: 0,0:06:27.11,0:06:30.49,Main,,0,0,0,,ولا دليل يُثبت أنَّ جاينا يتلاعبون في الخفاء
Dialogue: 0,0:06:30.87,0:06:32.20,Main,,0,0,0,,ما الّذي تقصدينه؟
Dialogue: 0,0:06:32.58,0:06:37.25,Main,,0,0,0,,أعني أنَّ هذا ليس سوى صراعٍ داخليٍّ في عائلة فارنا المالكة
Dialogue: 0,0:06:37.37,0:06:40.67,Main,,0,0,0,,...وكنيسة جاينا الّتي اعتُمدتْ كديانةٍ للدولة عقب الانقلاب
Dialogue: 0,0:06:40.92,0:06:43.42,Main,,0,0,0,,ليستْ سوى طائفةٍ دينيّةٍ فحسب
Dialogue: 0,0:06:43.83,0:06:46.05,Main,,0,0,0,,!تبًّا، يا لهم من أوغادٍ ماكرين
Dialogue: 0,0:06:46.21,0:06:50.18,Main,,0,0,0,,...لذا لن تتدخّل الدّول المجاورةُ في النزاعاتِ الداخليّة
Dialogue: 0,0:06:50.18,0:06:52.22,Main,,0,0,0,,لإمبراطوريّة بارتونيا
Dialogue: 0,0:06:52.28,0:06:53.86,Main,,0,0,0,,...حسنٌ، حسنٌ
Dialogue: 0,0:06:54.49,0:06:56.10,Main,,0,0,0,,...هذا يعني
Dialogue: 0,0:06:59.77,0:07:05.23,Main,,0,0,0,,وفي خضمِّ ذلك، تزداد قوّة جاينا في بلادكِ
Dialogue: 0,0:07:05.52,0:07:08.65,Main,,0,0,0,,...لهذا قرّرتُ اللجوء لعمّتي كاساندرا الّتي تزوّجتْ
Dialogue: 0,0:07:08.74,0:07:11.70,Main,,0,0,0,,من العائلة المالكة في بيستال المجاورة
Dialogue: 0,0:07:12.07,0:07:14.91,Main,,0,0,0,,تمكّنتُ من التسلّل من القلعة خفيةً عن أعين جاينا
Dialogue: 0,0:07:15.16,0:07:19.66,Main,,0,0,0,,لكنّهم أدركوني في غابة بانون الحدوديّة
Dialogue: 0,0:07:23.33,0:07:24.50,Main,,0,0,0,,يا لكِ من مسكينةٍ
Dialogue: 0,0:07:25.42,0:07:28.26,Main,,0,0,0,,قاسيتِ الصّعاب بمفردكِ
Dialogue: 0,0:07:28.88,0:07:34.51,Main,,0,0,0,,أنا أيضًا مسكينٌ فقد ذاكرتَه وتاهَ في هذا العالم غريبًا
Dialogue: 0,0:07:35.05,0:07:37.26,Main,,0,0,0,,أعي شعوركِ تمامًا
Dialogue: 0,0:07:38.39,0:07:39.56,Main,,0,0,0,,...أخي الكبير
Dialogue: 0,0:07:40.06,0:07:42.35,Main,,0,0,0,,!لكن لا داعي للخوف بعد الآن
Dialogue: 0,0:07:42.73,0:07:46.69,Main,,0,0,0,,فحماية النساء واجبٌ على الرجال في كلّ زمانٍ ومكانٍ
Dialogue: 0,0:07:47.36,0:07:49.74,Main,,0,0,0,,لا سيّما فتاةٌ فاتنةٌ مثلكِ
Dialogue: 0,0:07:51.90,0:07:53.32,Main,,0,0,0,,...فاتنة
Dialogue: 0,0:07:53.41,0:07:56.78,Main,,0,0,0,,!يا للطفكَ يا أخي الكبير
Dialogue: 0,0:07:56.95,0:07:58.12,Main,,0,0,0,,...ميل
Dialogue: 0,0:07:59.37,0:08:01.16,Main,,0,0,0,,!إنّها مذهلةٌ حقًّا
Dialogue: 0,0:08:02.83,0:08:06.17,Main,,0,0,0,,...بمجرّد أن أُوصلها إلى بيستال بسلامٍ
Dialogue: 0,0:08:06.88,0:08:10.97,Main,,0,0,0,,!أنتَ فارس أحلامي يا أخي الكبير
Dialogue: 0,0:08:12.76,0:08:13.76,Main,,0,0,0,,!هكذا بالضبط
Dialogue: 0,0:08:14.89,0:08:16.93,Main,,0,0,0,,!ثمَّ نعيش في سعادةٍ وهناءٍ
Dialogue: 0,0:08:19.10,0:08:19.56,Main,,0,0,0,,...ميل
Dialogue: 0,0:08:19.89,0:08:21.31,Main,,0,0,0,,...أخي الكبير
Dialogue: 0,0:08:23.89,0:08:26.86,Main,,0,0,0,,!أين النهاية السّعيدة في هذا؟
Dialogue: 0,0:08:27.06,0:08:29.40,Main,,0,0,0,,!أنتِ ميز الفتاة
Dialogue: 0,0:08:29.61,0:08:31.69,Main,,0,0,0,,لم أعد أحتملُ هذا
Dialogue: 0,0:08:32.11,0:08:33.70,Main,,0,0,0,,نواياكَ دنيئةٌ للغاية
Dialogue: 0,0:08:33.99,0:08:38.08,Main,,0,0,0,,ألهذا السبب تُساعد ميل-تشان؟
Dialogue: 0,0:08:38.16,0:08:39.37,Main,,0,0,0,,!بكلِّ تأكيدٍ
Dialogue: 0,0:08:39.45,0:08:42.91,Main,,0,0,0,,أيّ أبلهٍ قد يُفوّت فرصةً ذهبيّةً كهذه؟
Dialogue: 0,0:08:44.08,0:08:45.17,Main,,0,0,0,,...اسمع
Dialogue: 0,0:08:45.33,0:08:48.29,Main,,0,0,0,,...لا شيء أحطُّ من التّلاعب بمشاعر فتاةٍ
Dialogue: 0,0:08:48.29,0:08:50.46,Main,,0,0,0,,!مسكينةٍ مُشرّدةٍ من بلادها
Dialogue: 0,0:08:50.63,0:08:53.01,Main,,0,0,0,,!يا لكَ من حثالةٍ وعارٍ على الرجال
Dialogue: 0,0:08:53.01,0:08:54.38,Main,,0,0,0,,!لا شأنَ لكِ بي
Dialogue: 0,0:08:54.47,0:08:56.59,Main,,0,0,0,,!اصمتي وابقي بعيدةً عن هذا الأمر
Dialogue: 0,0:08:56.97,0:08:59.85,Main,,0,0,0,,!لن أفعل، لا تنسَ أنّنا شخصٌ واحدٌ
Dialogue: 0,0:09:00.01,0:09:01.81,Main,,0,0,0,,!لا يسعكَ فعلُ ما يحلو لكَ
Dialogue: 0,0:09:01.81,0:09:05.10,Main,,0,0,0,,!انظري، أنا ميز الآن
Dialogue: 0,0:09:05.10,0:09:07.71,Main,,0,0,0,,!لا يحقُّ لكِ إملاءُ الأوامرِ عليَّ
Dialogue: 0,0:09:07.71,0:09:11.15,Main,,0,0,0,,مهلًا، ما الّذي تفعله؟
Dialogue: 0,0:09:13.24,0:09:16.91,Main,,0,0,0,,هذا كلُّ شيءٍ، كوني فتاةً مطيعةً واصمتي
Dialogue: 0,0:09:17.07,0:09:20.12,Main,,0,0,0,,،وها نحنُ ذا، ميز وميل، نشرع في رحلتنا
Dialogue: 0,0:09:20.20,0:09:22.95,Main,,0,0,0,,لنسطر قصّة حبٍّ نقيّةٍ وشغفٍ عارمٍ
Dialogue: 0,0:09:23.04,0:09:24.58,Main,,0,0,0,,!مُحال
Dialogue: 0,0:09:24.83,0:09:31.17,Main,,0,0,0,,!هيّا يا ميل، انسي أحزانكِ وارتمي في أحضاني
Dialogue: 0,0:09:31.51,0:09:32.54,Main,,0,0,0,,!أخي الكبير
Dialogue: 0,0:09:32.80,0:09:35.27,Main,,0,0,0,,!أنتَ تتألّقُ يا أخي الكبير
Dialogue: 0,0:09:35.39,0:09:36.97,Main,,0,0,0,,!ميل
Dialogue: 0,0:09:37.05,0:09:38.93,Main,,0,0,0,,!أخي الكبير
Dialogue: 0,0:09:41.93,0:09:43.02,Main,,0,0,0,,!هذا ملمسٌ ناعمٌ
Dialogue: 0,0:09:44.48,0:09:46.44,Main,,0,0,0,,أهذه أنا؟ أعدتُ لطبيعتي؟
Dialogue: 0,0:09:46.94,0:09:50.53,Main,,0,0,0,,!انظري يا ميل-تشان، عدتُ إلى هيئتي كفتاةٍ
Dialogue: 0,0:09:50.65,0:09:55.11,Main,,0,0,0,,أونيه-ساما هي أوني-ساما، وأوني-ساما هو أونيه-ساما؟
Dialogue: 0,0:09:55.78,0:09:57.24,Main,,0,0,0,,...ممّا يعني
Dialogue: 0,0:09:59.04,0:10:00.29,Main,,0,0,0,,!أنّكِ أونيه-ني-ساما
Dialogue: 0,0:10:00.54,0:10:01.70,Main,,0,0,0,,...أونيه-ني-ساما
Dialogue: 0,0:10:03.12,0:10:05.08,Main,,0,0,0,,توقّفي يا ميل-تشان
Dialogue: 0,0:10:06.13,0:10:08.54,Main,,0,0,0,,!أحبّكِ يا أونيه-ني-ساما
Dialogue: 0,0:10:09.13,0:10:13.05,Main,,0,0,0,,أحبُّ أوني-ساما وأحبُّ أونيه-ساما
Dialogue: 0,0:10:15.34,0:10:18.72,Main,,0,0,0,,!لذا أحبُّ أونيه-ني-ساما كثيرًا
Dialogue: 0,0:10:18.76,0:10:20.39,Main,,0,0,0,,!مـ-ميل-تشان
Dialogue: 0,0:10:30.94,0:10:33.32,Main,,0,0,0,,تتّجه الأميرةُ ميل فارنا جنوبًا
Dialogue: 0,0:10:33.40,0:10:35.82,Main,,0,0,0,,أغلب الظنّ أنّها تنوي الهرب إلى بيستال
Dialogue: 0,0:10:36.16,0:10:37.49,Main,,0,0,0,,علينا القبضُ عليها قبل ذلك
Dialogue: 0,0:10:37.78,0:10:41.29,Main,,0,0,0,,سمعتُ أنّها برفقة فولنار قويٍّ أيّها القائد
Dialogue: 0,0:10:41.33,0:10:44.96,Main,,0,0,0,,سواءً كان فولنار أم لا، لن يصمدا أمامنا
Dialogue: 0,0:10:46.04,0:10:49.09,Main,,0,0,0,,سننتشل جثثهم إن لزم الأمر
Dialogue: 0,0:11:10.48,0:11:12.78,Main,,0,0,0,,يبدو أنّنا في حالة ركودٍ حاليًّا
Dialogue: 0,0:11:12.86,0:11:16.61,Main,,0,0,0,,،أجل، حتّى لو صحّت التقارير بوجود فولنار قويٍّ معها أيّها القائد
Dialogue: 0,0:11:16.70,0:11:19.57,Main,,0,0,0,,فخصومنا شخصان لا غير
Dialogue: 0,0:11:19.66,0:11:23.24,Main,,0,0,0,,القبضُ على الأميرة ميل مسألةُ وقتٍ لا أكثر
Dialogue: 0,0:11:23.33,0:11:25.33,Main,,0,0,0,,خصوم؟
Dialogue: 0,0:11:28.29,0:11:29.75,Main,,0,0,0,,أشاطرُكَ الشعور
Dialogue: 0,0:11:30.21,0:11:32.50,Main,,0,0,0,,،فرغمَ تغيّر أوضاع البلاد جذريًّا
Dialogue: 0,0:11:32.84,0:11:35.63,Main,,0,0,0,,كنّا نخدمُها حتّى أيامٍ خلتْ
Dialogue: 0,0:11:36.01,0:11:38.18,Main,,0,0,0,,هذا هو الواقع
Dialogue: 0,0:11:39.18,0:11:41.30,Main,,0,0,0,,فالشفقة حماقةٌ لا طائل منها
Dialogue: 0,0:11:41.39,0:11:42.85,Main,,0,0,0,,من أنت؟
Dialogue: 0,0:11:47.81,0:11:51.06,Main,,0,0,0,,لا بُدَّ أنّكَ تاناس، قائد قوّات حدود بورتميري
Dialogue: 0,0:11:51.81,0:11:54.07,Main,,0,0,0,,مبعوثٌ من جاينا
Dialogue: 0,0:12:10.25,0:12:15.09,Main,,0,0,0,,!ماذا؟ أتريدُ تجريد تاناس-ساما من منصبه؟
Dialogue: 0,0:12:15.17,0:12:19.13,Main,,0,0,0,,هذه عاقبة إخفاقكم في تحقيق أيّ نتائج
Dialogue: 0,0:12:19.72,0:12:21.84,Main,,0,0,0,,وهذا قرارٌ بالإجماع من الكنيسة
Dialogue: 0,0:12:21.93,0:12:23.14,Main,,0,0,0,,!مُحال
Dialogue: 0,0:12:23.22,0:12:28.07,Main,,0,0,0,,أهكذا يُعاملُ البطل الّذي ذادَ عن الإمبراطوريّة ضدّ الهجمات الخارجيّة؟
Dialogue: 0,0:12:28.23,0:12:30.69,Main,,0,0,0,,...أنا على درايةٍ تامّةٍ ببطولاته المزعومة
Dialogue: 0,0:12:30.73,0:12:34.06,Main,,0,0,0,,بإبادة جيشٍ قوامه ثمانية آلافٍ لثلاثين ألفًا من جيش بالانيان
Dialogue: 0,0:12:34.27,0:12:36.28,Main,,0,0,0,,غير أنَّ الزمن قد تغيّر
Dialogue: 0,0:12:36.98,0:12:39.57,Main,,0,0,0,,ما النّفعُ الّذي ستُسديه أمجادُ الماضي الآن؟
Dialogue: 0,0:12:39.90,0:12:41.07,Main,,0,0,0,,!هذا جنونٌ
Dialogue: 0,0:12:41.20,0:12:44.28,Main,,0,0,0,,بوسعنا القبضُ على الأميرة ميل بسهولةٍ إن عقدنا العزم على ذلك
Dialogue: 0,0:12:44.28,0:12:46.66,Main,,0,0,0,,!إنّها ليست أميرةً، بل متمرّدةً
Dialogue: 0,0:12:47.37,0:12:49.54,Main,,0,0,0,,!أخبرتُكَ أنَّ الزمن قد تغيّر
Dialogue: 0,0:12:50.41,0:12:54.71,Main,,0,0,0,,أُسِّست قوّات حدود بورتميري في الأصل للتصدّي لهجمات بالانيان
Dialogue: 0,0:12:55.34,0:12:59.84,Main,,0,0,0,,لكنّها الآن مجرّد بيدقٍ في خطّة القبض على ميل فارنا
Dialogue: 0,0:12:59.86,0:13:00.88,Main,,0,0,0,,!أيّها الوغد
Dialogue: 0,0:13:01.18,0:13:02.22,Main,,0,0,0,,...ولكن
Dialogue: 0,0:13:05.68,0:13:10.18,Main,,0,0,0,,نشرنا صبيحة اليوم في الغابة وحدة حرب عصاباتٍ مجهزةٍ بدروعٍ اصطناعيّةٍ متوسّطةٍ بقيادة موتا
Dialogue: 0,0:13:10.31,0:13:11.85,Main,,0,0,0,,ستتبيّن النتائج عمّا قريبٍ
Dialogue: 0,0:13:12.56,0:13:14.63,Main,,0,0,0,,وحدة حرب العصابات الشّهيرة إذن
Dialogue: 0,0:13:15.17,0:13:16.19,Main,,0,0,0,,يا للبشاعة
Dialogue: 0,0:13:17.98,0:13:19.57,Main,,0,0,0,,سأنتظر حتّى حلول الظلام
Dialogue: 0,0:13:19.81,0:13:23.88,Main,,0,0,0,,...إن أخفقتم، فاعلموا أنَّ كافة قوات جيش بورتوماري
Dialogue: 0,0:13:25.58,0:13:28.21,Main,,0,0,0,,سيغدو تحتَ قيادتي
Dialogue: 0,0:13:30.58,0:13:31.91,Main,,0,0,0,,!يا لهُ من وغدٍ مُتغطرس
Dialogue: 0,0:13:32.41,0:13:34.46,Main,,0,0,0,,!شابٌّ طائشٌ مُتبجّح
Dialogue: 0,0:13:35.49,0:13:36.42,Main,,0,0,0,,تاناس-ساما
Dialogue: 0,0:13:37.92,0:13:38.59,Main,,0,0,0,,تحمّلوا الأمر
Dialogue: 0,0:13:39.63,0:13:42.05,Main,,0,0,0,,أخشى أنّه مُحقٌّ بشأن تغيّر الزمن
Dialogue: 0,0:13:42.13,0:13:44.55,Main,,0,0,0,,...فضلًا عن ذلك، إن عصينا أوامرَ الكنيسة
Dialogue: 0,0:13:44.64,0:13:46.60,Main,,0,0,0,,فقد تُسرّح القوّات بأكملها
Dialogue: 0,0:13:48.39,0:13:51.98,Main,,0,0,0,,ليس بوسعنا الآن سوى انتظار أخبار المغاوير
Dialogue: 0,0:13:53.02,0:13:54.02,Main,,0,0,0,,...أعوّل عليكم
Dialogue: 0,0:13:55.44,0:13:59.48,Main,,0,0,0,,لا أظنُّ أنَّ هذا آمنٌ يا ميل-تشان
Dialogue: 0,0:14:00.38,0:14:04.20,Main,,0,0,0,,!لا أريد، أودُّ الإمساك بيدكِ أثناء سيرنا
Dialogue: 0,0:14:04.28,0:14:05.66,Main,,0,0,0,,...أعلمُ ذلك، ولكن
Dialogue: 0,0:14:06.07,0:14:08.07,Main,,0,0,0,,لِمَ لا يمكنني؟
Dialogue: 0,0:14:08.22,0:14:11.75,Main,,0,0,0,,!الإمساك بيدِ مَن تُحبّين ليس أمرًا مُخجلًا
Dialogue: 0,0:14:12.48,0:14:17.89,Main,,0,0,0,,ليس الأمر كذلك، ما أعنيه أنَّ السير متقارباتٍ هكذا في الغابة ليس آمنًا
Dialogue: 0,0:14:18.10,0:14:20.23,Main,,0,0,0,,...فقد يتعثّر أحدنا
Dialogue: 0,0:14:22.21,0:14:23.80,Main,,0,0,0,,!هذا ما كنتُ أعنيه
Dialogue: 0,0:14:24.06,0:14:25.58,Main,,0,0,0,,أأنتِ بخيرٍ يا ميل-تشان؟
Dialogue: 0,0:14:25.79,0:14:30.22,Main,,0,0,0,,الحقيقة هي أنّكِ تمقتينني يا أونيه-ني-ساما، أليس كذلك؟
Dialogue: 0,0:14:30.31,0:14:32.10,Main,,0,0,0,,...لهذا... لهذا
Dialogue: 0,0:14:33.35,0:14:34.86,Main,,0,0,0,,...لا، ما أقصده
Dialogue: 0,0:14:40.78,0:14:42.18,Main,,0,0,0,,مـ-ما هذا؟
Dialogue: 0,0:14:42.32,0:14:44.40,Main,,0,0,0,,مَن هذا الّذي يبكي؟
Dialogue: 0,0:14:45.95,0:14:50.96,Main,,0,0,0,,كُفّي عن البكاءِ رجاءً، كيف لي أن أمقتكِ يا ميل-تشان؟
Dialogue: 0,0:14:51.95,0:14:53.45,Main,,0,0,0,,أتعنينَ ذلك؟
Dialogue: 0,0:14:54.54,0:14:58.20,Main,,0,0,0,,إذن، أتحبّينني يا أونيه-ني-ساما؟
Dialogue: 0,0:14:58.80,0:15:00.40,Main,,0,0,0,,أجل، أجل
Dialogue: 0,0:15:02.00,0:15:05.47,Main,,0,0,0,,!وأنا أيضًا أحبّكِ كثيرًا يا أونيه-ني-ساما
Dialogue: 0,0:15:08.07,0:15:11.00,Main,,0,0,0,,...بئس الأمر، لم أعد أدري ما الّذي أفعله
Dialogue: 0,0:15:11.58,0:15:15.32,Main,,0,0,0,,أليس غريبًا أن تسافر فتاتان بمفردهما في غابة بانون؟
Dialogue: 0,0:15:16.61,0:15:18.66,Main,,0,0,0,,وتبدوان ظريفتان أيضًا
Dialogue: 0,0:15:19.97,0:15:21.05,Main,,0,0,0,,ماذا سنفعل؟
Dialogue: 0,0:15:21.07,0:15:22.82,Main,,0,0,0,,أتسألني؟
Dialogue: 0,0:15:22.86,0:15:26.82,Main,,0,0,0,,سئمتُ السفر معكَ طوال الوقت
Dialogue: 0,0:15:26.99,0:15:29.99,Main,,0,0,0,,لن يضرّنا التعرّف عليهما، أليس كذلك؟
Dialogue: 0,0:15:30.66,0:15:32.33,Main,,0,0,0,,سآخذ ذات الشعر الأسود
Dialogue: 0,0:15:33.14,0:15:36.66,Main,,0,0,0,,مُحال، لنكن مُنصفين
Dialogue: 0,0:15:37.44,0:15:41.26,Main,,0,0,0,,بسبب من انتهى بنا المطاف فارّين هكذا؟
Dialogue: 0,0:15:41.44,0:15:44.88,Main,,0,0,0,,إمّا أن تترك لي ذات الشعر الأسود، أو ابقَ هنا وراقبني
Dialogue: 0,0:15:46.51,0:15:48.39,Main,,0,0,0,,!مهلًا، هذا ليس منصفًا
Dialogue: 0,0:15:49.72,0:15:51.97,Main,,0,0,0,,حسنٌ، يجدر بنا التحرّك الآن
Dialogue: 0,0:15:58.91,0:15:59.88,Main,,0,0,0,,أأنتِ بخيرٍ؟
Dialogue: 0,0:15:59.96,0:16:03.48,Main,,0,0,0,,!لستُ بخيرٍ، ابتعد عنّي أيّها الأحمق
Dialogue: 0,0:16:03.99,0:16:08.27,Main,,0,0,0,,عجبًا، لعلّي أستطيعُ البقاء هكذا لبعضِ الوقت
Dialogue: 0,0:16:16.37,0:16:18.10,Main,,0,0,0,,ما الّذي يحدث؟
Dialogue: 0,0:16:18.19,0:16:20.30,Main,,0,0,0,,لم أرَ هذا النوع من الملابس في هذه الأرجاء قطّ
Dialogue: 0,0:16:21.46,0:16:24.00,Main,,0,0,0,,خصرها ليس ممتلئًا
Dialogue: 0,0:16:24.21,0:16:25.62,Main,,0,0,0,,ما الّذي تفعله؟
Dialogue: 0,0:16:25.81,0:16:27.46,Main,,0,0,0,,عليكَ أن تكون أكثر رفقًا
Dialogue: 0,0:16:37.22,0:16:38.17,Main,,0,0,0,,أأمسكوا بهما؟
Dialogue: 0,0:16:38.85,0:16:40.31,Main,,0,0,0,,حاصروهما خفيةً
Dialogue: 0,0:16:44.48,0:16:48.36,Main,,0,0,0,,أكان عليها الصراخ هكذا حقًّا؟
Dialogue: 0,0:16:48.69,0:16:50.86,Main,,0,0,0,,أأنتِ من هذه الأرجاء؟
Dialogue: 0,0:16:50.95,0:16:52.32,Main,,0,0,0,,!لا أدري
Dialogue: 0,0:16:52.41,0:16:54.53,Main,,0,0,0,,إذن، إلى أين وجهتكِ؟
Dialogue: 0,0:16:54.62,0:16:56.45,Main,,0,0,0,,!لا شأن لكما بهذا
Dialogue: 0,0:16:57.09,0:17:01.08,Main,,0,0,0,,نعتذر إن أخفناكِ، لكن لا داعي لتكوني عدائيّةً هكذا
Dialogue: 0,0:17:01.17,0:17:05.71,Main,,0,0,0,,لن نأكلكِ، فنحن لا نُضمر شرًّا
Dialogue: 0,0:17:06.75,0:17:08.71,Main,,0,0,0,,لا تُضمران شرًّا؟
Dialogue: 0,0:17:08.80,0:17:11.07,Main,,0,0,0,,!طرحتمانا أرضًا فجأةً أيّها الغرباء
Dialogue: 0,0:17:11.29,0:17:13.89,Main,,0,0,0,,!أفزعتموني حتّى الموت
Dialogue: 0,0:17:17.26,0:17:20.48,Main,,0,0,0,,!اكتفينا ممّا قاسيناه من رعبٍ
Dialogue: 0,0:17:20.56,0:17:24.44,Main,,0,0,0,,أتتوقّع منّي تبادل أطراف الحديث مع غرباء؟
Dialogue: 0,0:17:24.56,0:17:25.98,Main,,0,0,0,,أونيه-ني-ساما
Dialogue: 0,0:17:26.06,0:17:27.86,Main,,0,0,0,,أنا بخيرٍ يا ميل-تشان
Dialogue: 0,0:17:28.38,0:17:31.94,Main,,0,0,0,,لنتجاهلهما ونمضِ في طريقنا
Dialogue: 0,0:17:32.32,0:17:33.36,Main,,0,0,0,,ميل؟
Dialogue: 0,0:17:33.53,0:17:36.49,Main,,0,0,0,,بما أنّه لا شأن لكما بنا، فليمضِ كلٌّ منّا في سبيله
Dialogue: 0,0:17:36.58,0:17:38.54,Main,,0,0,0,,طاب يومكما، وداعًا
Dialogue: 0,0:17:39.16,0:17:41.87,Main,,0,0,0,,يا إلهي، تركنا أسوأ انطباعٍ ممكنٍ
Dialogue: 0,0:17:41.96,0:17:45.42,Main,,0,0,0,,لكنّها تبدو فاتنةً حين تغضب
Dialogue: 0,0:17:45.76,0:17:47.67,Main,,0,0,0,,أصبتِ القول
Dialogue: 0,0:17:49.92,0:17:52.34,Main,,0,0,0,,ما خطبُ هذين الاثنين؟
Dialogue: 0,0:17:58.26,0:18:00.60,Main,,0,0,0,,ما الخطبُ يا أونيه-ني-ساما؟
Dialogue: 0,0:18:00.68,0:18:02.64,Main,,0,0,0,,!خُيّل لي أنَّ الغابة تحرّكتْ
Dialogue: 0,0:18:03.10,0:18:05.81,Main,,0,0,0,,لا بُدَّ أنّي أتوهّم ذلك، لا عليكِ يا ميل-تشان
Dialogue: 0,0:18:06.19,0:18:08.40,Main,,0,0,0,,تبدو الغابة مضطربةً
Dialogue: 0,0:18:08.48,0:18:10.86,Main,,0,0,0,,أيبتغي أحدهم إقامة حفلٍ؟
Dialogue: 0,0:18:13.03,0:18:14.40,Main,,0,0,0,,!احترسا
Dialogue: 0,0:18:23.00,0:18:23.50,Main,,0,0,0,,!تبًّا
Dialogue: 0,0:18:23.87,0:18:25.79,Main,,0,0,0,,أأدركونا بهذه السرعة؟
Dialogue: 0,0:18:26.09,0:18:27.29,Main,,0,0,0,,كان هذا سريعًا
Dialogue: 0,0:18:27.71,0:18:29.35,Main,,0,0,0,,أأنتِ بخيرٍ يا ميل-تشان؟
Dialogue: 0,0:18:40.22,0:18:41.31,Main,,0,0,0,,!تبًّا
Dialogue: 0,0:18:41.57,0:18:44.98,Main,,0,0,0,,كلّ ما فعلناه هو تلقين بعض فرسان المعبد درسًا قاسيًا
Dialogue: 0,0:18:45.01,0:18:45.83,Main,,0,0,0,,بل خمسة
Dialogue: 0,0:18:48.48,0:18:50.94,Main,,0,0,0,,أيًّا كان، أليستْ هذه مبالغةً؟
Dialogue: 0,0:18:58.82,0:19:01.16,Main,,0,0,0,,من هؤلاء؟
Dialogue: 0,0:19:01.24,0:19:03.45,Main,,0,0,0,,لا بُدَّ أنّهم صائدو الديمي
Dialogue: 0,0:19:03.54,0:19:04.79,Main,,0,0,0,,صائدو الديمي؟
Dialogue: 0,0:19:05.96,0:19:07.54,Main,,0,0,0,,!افعليها يا سوليود
Dialogue: 0,0:19:07.87,0:19:08.75,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:19:16.43,0:19:18.34,Main,,0,0,0,,،بوسعهم تدمير الدروع الاصطناعيّة بمفردهما
Dialogue: 0,0:19:18.68,0:19:21.43,Main,,0,0,0,,إذ يقتصر صيدهم عليها
Dialogue: 0,0:19:22.72,0:19:23.52,Main,,0,0,0,,!أرى ذلك
Dialogue: 0,0:19:23.90,0:19:25.10,Main,,0,0,0,,!ما الّذي تنتظرانه؟
Dialogue: 0,0:19:25.40,0:19:27.04,Main,,0,0,0,,!غادرا المكان فورًا
Dialogue: 0,0:19:27.60,0:19:31.27,Main,,0,0,0,,!اعتادوا القتال في الغابات، لذا توخّيا الحذر
Dialogue: 0,0:19:31.30,0:19:34.08,Main,,0,0,0,,شـ-شكرًا، وأنتما أيضًا
Dialogue: 0,0:19:35.63,0:19:37.36,Main,,0,0,0,,حسنٌ يا ميل-تشان، هذه فرصتنا
Dialogue: 0,0:19:38.74,0:19:40.81,Main,,0,0,0,,ماذا؟ درع اصطناعيّ متوسّط؟
Dialogue: 0,0:19:43.29,0:19:45.37,Main,,0,0,0,,كان يختبئ تحت الأرض إذن
Dialogue: 0,0:19:47.59,0:19:51.46,Main,,0,0,0,,!كلّا كلّا كلّا، أفلِتْ أونيه-ني-ساما
Dialogue: 0,0:19:53.34,0:19:54.21,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:19:54.67,0:19:55.24,Main,,0,0,0,,ميل؟
Dialogue: 0,0:19:55.81,0:19:57.40,Main,,0,0,0,,!ميل... مُحال
Dialogue: 0,0:19:57.51,0:20:00.89,Main,,0,0,0,,صحيح، تناهى إلى مسامعي أنَّ الأميرة فارنا قد هربتْ
Dialogue: 0,0:20:01.76,0:20:04.75,Main,,0,0,0,,...ممّا يعني أنَّ هدفهم المنشود
Dialogue: 0,0:20:04.77,0:20:06.60,Main,,0,0,0,,هو تلك الفتاة
Dialogue: 0,0:20:06.77,0:20:08.60,Main,,0,0,0,,!أخبرتكَ أن تُفلتها
Dialogue: 0,0:20:08.65,0:20:10.06,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:20:10.15,0:20:14.07,Main,,0,0,0,,الأميرة ميل فارنا، يجدر بكِ التزام الهدوء إن أردتِ البقاء على قيد الحياة
Dialogue: 0,0:20:16.07,0:20:18.30,Main,,0,0,0,,!ميل-تشان، إيّاكِ
Dialogue: 0,0:20:18.72,0:20:20.36,Main,,0,0,0,,!اهربي يا ميل-تشان
Dialogue: 0,0:20:22.41,0:20:23.87,Main,,0,0,0,,ماذا سنفعل؟
Dialogue: 0,0:20:23.95,0:20:27.00,Main,,0,0,0,,وما أدراني، فهو درع اصطناعيّ متوسّط
Dialogue: 0,0:20:27.08,0:20:28.79,Main,,0,0,0,,كما أنّه ليس من اختصاصنا
Dialogue: 0,0:20:32.50,0:20:34.13,Main,,0,0,0,,...حتّى نحن
Dialogue: 0,0:20:34.17,0:20:35.83,Main,,0,0,0,,!مُتمرّدان
Dialogue: 0,0:20:36.05,0:20:36.64,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:20:41.43,0:20:45.43,Main,,0,0,0,,!كيف تجرؤ على فِعل ذلك بميل-تشان، ستدفع الثمن
Dialogue: 0,0:20:46.64,0:20:47.77,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:20:54.61,0:20:57.12,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:20:58.11,0:20:59.24,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:20:59.27,0:21:00.39,Main,,0,0,0,,...يا إلهي
Dialogue: 0,0:21:00.42,0:21:04.70,Main,,0,0,0,,من كان ليتوقّع أنّهما الأميرة الهاربة وحاميها الفولنار
Dialogue: 0,0:21:04.97,0:21:08.41,Main,,0,0,0,,بئس الأمر، لا أدري إن كان يجدر بي نعتها بالعنيدة أم الرقيقة
Dialogue: 0,0:21:09.00,0:21:12.04,Main,,0,0,0,,ليست فاتنةً فحسب، بل قويّةٌ أيضًا
Dialogue: 0,0:21:12.87,0:21:14.63,Main,,0,0,0,,أظنّني وقعتُ في حُبّها
Dialogue: 0,0:21:14.88,0:21:16.36,Main,,0,0,0,,...على أيّ حالٍ
Dialogue: 0,0:21:16.55,0:21:19.96,Main,,0,0,0,,نلنا لقب المتمرّدين عن جدارةٍ
Dialogue: 0,0:21:20.51,0:21:24.34,Main,,0,0,0,,لا علينا، فهذه لن تكون رحلةً مُملّةً حتمًا
Dialogue: 0,0:21:24.59,0:21:25.35,Main,,0,0,0,,أجل
Dialogue: 0,0:21:35.02,0:21:36.27,Main,,0,0,0,,!سقط موتا
Dialogue: 0,0:21:37.02,0:21:41.24,Main,,0,0,0,,من الآن فصاعدًا، ستخضع قوّات حدود بورتميري لقيادتي
Dialogue: 0,0:21:41.78,0:21:45.78,Main,,0,0,0,,!أيّها الجنود، كونوا مخلصين، وآسرين أيضًا
Dialogue: 0,0:21:46.32,0:21:47.78,Main,,0,0,0,,...كلّ ذلك من أجلي
Dialogue: 0,0:22:04.30,0:22:05.59,Main,,0,0,0,,!هذه مصيبةٌ
Dialogue: 0,0:22:05.97,0:22:10.10,Main,,0,0,0,,!عليَّ إخبار ميز-سان بهذا فورًا
Dialogue: 0,0:24:06.16,0:24:06.98,Main,,0,0,0,,!أنا ميل
Dialogue: 0,0:24:07.13,0:24:10.05,Main,,0,0,0,,!كسبنا رفاق سفرٍ جددًا، وكلّما زاد العدد زاد الأمان
Dialogue: 0,0:24:10.07,0:24:11.01,Main,,0,0,0,,أو هكذا ظننتُ
Dialogue: 0,0:24:11.03,0:24:15.43,Main,,0,0,0,,!لكن يبدو أنَّ أستار-سان وسوليود-سان وقعا في حبّ أونيه-ني-ساما
Dialogue: 0,0:24:15.52,0:24:19.81,Main,,0,0,0,,يساورني القلق الشديد إزاء تطفّلهما
Dialogue: 0,0:24:19.85,0:24:24.15,Main,,0,0,0,,!وفي خضمّ ذلك، حاصرنا الأعداء
Dialogue: 0,0:24:24.23,0:24:26.94,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:26.97,0:24:29.24,Main,,0,0,0,,!مُحاصران بِلا أملٍ: المأزق الكبير
Dialogue: 0,0:24:29.32,0:24:32.78,Main,,0,0,0,,عِدني بألّا تحبّ أحدًا سواي أونيه-ني-ساما
Comment: 0,0:16:26.21,0:16:27.75,Signs,,0,0,0,,
Dialogue: 0,0:05:35.64,0:05:38.15,Note,,0,0,0,,فولنار سيّد: مستخدم أطوار لا يحتاج إلى وسيط للتحكم بها، ويمتاز بقدرته على قيادة الدروع دون الحاجة لإبرام عقد سحريّ؛
Dialogue: 0,0:05:35.64,0:05:38.15,Note,,0,0,0,,ممّا يجنبه مخاطر فقدان روحه أو تقييده بدروع محدّدة، فضلًا عن قدرته على تعزيز أداء الدرع الّذي يقوده
Dialogue: 0,0:10:37.78,0:10:41.29,Note,,0,0,0,,فولنار: أشخاص لديهم قدرات خاصّة تمكنهم من استخدام السّحر والتحكّم في القوى الطبيعيّة أو إطلاق طاقة مُشعة
Dialogue: 0,0:13:05.68,0:13:10.18,Note,,0,0,0,,الدروع الاصطناعيّة: فئةٌ من دروع الديمي صُمّمت لتكون أخفّ وزنًا وأكثر مرونةً إذ تستهلك قدرًا أقلّ من الطاقة وتُناط بها مهام الاستطلاع والدعم التكتيكي
Dialogue: 0,0:19:01.24,0:19:03.45,Note,,0,0,0,,صائدو الديمي: مرتزقة ومقاتلون محترفون يختصّون بتعقب وتدمير دروع "الديمي" الاصطناعيّة أو تحييد خطرها في المعارك أو لمصلحة الجهات المتعاقدة معهم
Dialogue: 0,0:19:38.74,0:19:40.81,Note,,0,0,0,,الدروع الاصطناعيّة المتوسّطة: فئة من دروع الديمي صُمّمت لمهام عسكريّة تتطلب توازنًا بين السرعة والقوّة التدميريّة، وعادةً ما يقودها ضباط أو مرتزقة محترفون
Comment: 0,0:16:26.21,0:16:27.75,Signs,,0,0,0,,
Dialogue: 0,0:02:08.31,0:02:14.32,Signs,,0,0,0,,!ثنائيٌّ خارقٌ وسريعٌ كالبرق
Dialogue: 0,0:24:30.19,0:24:34.70,Signs,,0,0,0,,!مُحاصران بِلا أملٍ: المأزق الكبير
