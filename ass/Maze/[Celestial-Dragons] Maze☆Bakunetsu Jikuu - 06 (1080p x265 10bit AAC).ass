Dialogue: 0,0:00:01.31,0:00:02.32,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:22.44,0:02:23.71,Main,,0,0,0,,!سأحصل عليها حتمًا
Dialogue: 0,0:02:24.28,0:02:28.17,Main,,0,0,0,,!سأحصل على تلك القوّة حتمًا
Dialogue: 0,0:02:34.15,0:02:36.53,Main,,0,0,0,,!درع الروم العاشق الّذي لا يُقهر
Dialogue: 0,0:02:48.60,0:02:50.07,Main,,0,0,0,,الذنب ذنبي
Dialogue: 0,0:02:50.13,0:02:52.83,Main,,0,0,0,,،أُحرِقتْ القرية لتردّدي
Dialogue: 0,0:02:52.90,0:02:54.84,Main,,0,0,0,,واختُطفتْ سوليود-سان
Dialogue: 0,0:02:54.90,0:02:56.39,Main,,0,0,0,,حتّى أنّي عجزتُ عن استدعاء دولغر
Dialogue: 0,0:02:56.87,0:02:58.27,Main,,0,0,0,,...أونيه-ني-ساما
Dialogue: 0,0:02:58.34,0:03:02.55,Main,,0,0,0,,!ألم تعودي تكترثين لهذا العالم؟ أو لي أنا؟
Dialogue: 0,0:03:03.38,0:03:06.21,Main,,0,0,0,,انتظريني يا ميل-تشان، سأعود قريبًا
Dialogue: 0,0:03:13.96,0:03:14.85,Main,,0,0,0,,...أنتَ
Dialogue: 0,0:03:14.92,0:03:17.69,Main,,0,0,0,,أذاهبةٌ لإنقاذ رفاقكِ؟
Dialogue: 0,0:03:18.53,0:03:21.26,Main,,0,0,0,,لا شأن لكَ بهذا
Dialogue: 0,0:03:22.90,0:03:23.89,Main,,0,0,0,,سأرشدكِ
Dialogue: 0,0:03:25.40,0:03:28.22,Main,,0,0,0,,لديَّ شأنٌ لأقضيه مع قبيلة زوكو
Dialogue: 0,0:03:33.18,0:03:37.61,Main,,0,0,0,,!إلى أين ذهبتَ أثناء نومي يا أونيه-ني-ساما؟
Dialogue: 0,0:03:39.48,0:03:43.25,Main,,0,0,0,,!لا بُدَّ أنَّ أونيه-ني-ساما تكره ميل
Dialogue: 0,0:03:43.59,0:03:45.32,Main,,0,0,0,,!أريد الموت
Dialogue: 0,0:03:45.76,0:03:47.55,Main,,0,0,0,,أكاد أهلك
Dialogue: 0,0:03:51.93,0:03:54.26,Main,,0,0,0,,!كفى إزعاجًا
Dialogue: 0,0:03:58.87,0:04:02.13,Main,,0,0,0,,!انظري ما اقترفته يداكِ يا ميل-سان
Dialogue: 0,0:04:02.27,0:04:04.20,Main,,0,0,0,,!يا له من موقف
Dialogue: 0,0:04:09.58,0:04:14.41,Main,,0,0,0,,هذا صحيح، نسيتُ أنَّ سابر-سان أوكل إلينا رعايته
Dialogue: 0,0:04:15.26,0:04:17.22,Main,,0,0,0,,!ها قد حملتك
Dialogue: 0,0:04:17.55,0:04:20.33,Main,,0,0,0,,إيّاكَ والبكاء، كُنْ مطيعًا
Dialogue: 0,0:04:20.35,0:04:21.58,Main,,0,0,0,,حسنٌ، حسنٌ
Dialogue: 0,0:04:21.61,0:04:24.03,Main,,0,0,0,,إن بكيتَ فستوقظ أستر-سان
Dialogue: 0,0:04:24.96,0:04:26.68,Main,,0,0,0,,داي-تشان
Dialogue: 0,0:04:27.22,0:04:29.37,Main,,0,0,0,,!أريد البكاء أنا الأخرى
Dialogue: 0,0:04:29.57,0:04:31.13,Main,,0,0,0,,!الحفاض يا ميل-سان
Dialogue: 0,0:04:31.20,0:04:33.15,Main,,0,0,0,,حفاضه مبلّل
Dialogue: 0,0:04:33.97,0:04:35.20,Main,,0,0,0,,!يا للمصيبة
Dialogue: 0,0:04:36.14,0:04:39.63,Main,,0,0,0,,حسنٌ، سأغيّره لكَ في الحال
Dialogue: 0,0:04:41.48,0:04:42.64,Main,,0,0,0,,إنّه براز
Dialogue: 0,0:04:44.82,0:04:47.61,Main,,0,0,0,,،سأنجب يومًا ما أطفالًا من أونيه-ني-ساما
Dialogue: 0,0:04:47.68,0:04:51.43,Main,,0,0,0,,وأُرضعهم، وأُغيّر حفاضاتهم هكذا
Dialogue: 0,0:04:51.79,0:04:53.31,Main,,0,0,0,,أنا في غاية السّعادة
Dialogue: 0,0:04:53.35,0:04:55.73,Main,,0,0,0,,!سأُنجب المزيد من الأطفال
Dialogue: 0,0:04:57.46,0:04:58.62,Main,,0,0,0,,يعتريني الخجل
Dialogue: 0,0:05:03.33,0:05:04.77,Main,,0,0,0,,...ميل-سان
Dialogue: 0,0:05:05.47,0:05:07.66,Main,,0,0,0,,كفى إزعاجًا
Dialogue: 0,0:05:08.17,0:05:10.64,Main,,0,0,0,,إيّاكِ والتهوّر يا ميز
Dialogue: 0,0:05:12.51,0:05:16.67,Main,,0,0,0,,لِمَ تخاطرين بحياتكِ لإنقاذ شخصٍ غريبٍ؟
Dialogue: 0,0:05:16.75,0:05:20.68,Main,,0,0,0,,لأنَّ سوليود-سان انتهى بها المطاف هكذا بسببي
Dialogue: 0,0:05:20.75,0:05:23.18,Main,,0,0,0,,وعلاوةً على ذلك، إنّها رفيقةٌ عزيزة
Dialogue: 0,0:05:23.25,0:05:24.72,Main,,0,0,0,,أنتِ فتاةٌ غريبة
Dialogue: 0,0:05:24.86,0:05:26.24,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:05:26.54,0:05:28.95,Main,,0,0,0,,لا بأس إن مقتّ فتاةً غريبةً مثلي
Dialogue: 0,0:05:29.02,0:05:30.85,Main,,0,0,0,,كلّا، لن أفعل
Dialogue: 0,0:05:39.54,0:05:40.61,Main,,0,0,0,,أأنتِ بخير؟
Dialogue: 0,0:05:40.77,0:05:42.11,Main,,0,0,0,,المعذرة
Dialogue: 0,0:05:42.29,0:05:43.67,Main,,0,0,0,,أجل، أنا بخير
Dialogue: 0,0:05:43.87,0:05:44.64,Main,,0,0,0,,فهمت
Dialogue: 0,0:05:46.81,0:05:49.44,Main,,0,0,0,,لِمَ يخفق قلبي بشدّة يا ترى؟
Dialogue: 0,0:06:01.66,0:06:05.75,Main,,0,0,0,,انزلي عبر الدرج الّذي بجوار المدخل وستجدين الزنزانة أمامكِ
Dialogue: 0,0:06:06.40,0:06:08.34,Main,,0,0,0,,كيف ألممتَ بكلّ هذه التفاصيل؟
Dialogue: 0,0:06:08.73,0:06:10.39,Main,,0,0,0,,من تكون يا سابر-سان؟
Dialogue: 0,0:06:10.47,0:06:12.56,Main,,0,0,0,,لنلتفّ من ذلك الجانب
Dialogue: 0,0:06:12.59,0:06:13.57,Main,,0,0,0,,حـ-حسنٌ
Dialogue: 0,0:06:21.54,0:06:22.24,Main,,0,0,0,,!ما هذا؟
Dialogue: 0,0:06:40.10,0:06:42.73,Main,,0,0,0,,أهذا أنتَ؟
Dialogue: 0,0:06:42.80,0:06:44.86,Main,,0,0,0,,كُفّ عن إصدار تلك الأصوات المريبة
Dialogue: 0,0:06:50.31,0:06:54.30,Main,,0,0,0,,أعتذر، لكنّي أمقت الضفادع
Dialogue: 0,0:06:54.38,0:06:56.40,Main,,0,0,0,,أنتِ فتاةٌ تثير العجب
Dialogue: 0,0:06:56.48,0:07:00.06,Main,,0,0,0,,رغم أنّكِ تغدينَ شابًّا يعوّل عليه
Dialogue: 0,0:07:00.78,0:07:04.74,Main,,0,0,0,,!لا تمزح معي، ذلك الوغد لا يُعوّل عليه أبدًا
Dialogue: 0,0:07:04.82,0:07:07.91,Main,,0,0,0,,إنّه أسوأ وأحقر حثالةٍ على الإطلاق
Dialogue: 0,0:07:07.99,0:07:09.98,Main,,0,0,0,,!خُذ العلم منّي بما أنّي هو
Dialogue: 0,0:07:13.30,0:07:18.26,Main,,0,0,0,,آسفة، كفى بي حرجًا، ماذا أهذي؟
Dialogue: 0,0:07:20.14,0:07:23.30,Main,,0,0,0,,جدّيتكِ هذه تُشبهها كثيرًا
Dialogue: 0,0:07:23.54,0:07:25.13,Main,,0,0,0,,تُشبه من؟
Dialogue: 0,0:07:28.24,0:07:31.65,Main,,0,0,0,,!مصيبة، هُوجِمَ حارس البوابة الخلفيّة من قِبل دخلاء
Dialogue: 0,0:07:32.98,0:07:35.11,Main,,0,0,0,,!أهُم من لورس؟ ابحثوا عنهم
Dialogue: 0,0:07:35.42,0:07:39.68,Main,,0,0,0,,لا وقت لنُضيّعه، أسرعي لإنقاذ رفيقتكِ
Dialogue: 0,0:07:39.76,0:07:40.60,Main,,0,0,0,,...لـ-لكن
Dialogue: 0,0:07:40.79,0:07:44.99,Main,,0,0,0,,أخبرتكِ أنَّ لديَّ شأنًا لأقضيه هنا
Dialogue: 0,0:07:45.06,0:07:49.05,Main,,0,0,0,,وعلاوةً على ذلك، لا أريدكِ أن تموتي
Dialogue: 0,0:07:50.27,0:07:51.28,Main,,0,0,0,,سابر-سان
Dialogue: 0,0:07:53.44,0:07:56.50,Main,,0,0,0,,!وجدته، إنّه هنا، إيّاكم أن يفلت
Dialogue: 0,0:08:05.55,0:08:09.38,Main,,0,0,0,,لا طائل من اتّخاذي رهينةً
Dialogue: 0,0:08:10.65,0:08:14.18,Main,,0,0,0,,فلن يأبه أحدٌ لحياتي البائسة
Dialogue: 0,0:08:15.86,0:08:17.29,Main,,0,0,0,,...لكن
Dialogue: 0,0:08:17.36,0:08:21.32,Main,,0,0,0,,وددتُ رؤيتكِ مرّةً أخرى يا ميز
Dialogue: 0,0:08:21.40,0:08:22.36,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:08:22.53,0:08:24.59,Main,,0,0,0,,أتشاطرينني الرأي؟
Dialogue: 0,0:08:26.87,0:08:28.00,Main,,0,0,0,,...في الواقع
Dialogue: 0,0:08:29.20,0:08:31.23,Main,,0,0,0,,انتظري لحظةً رجاءً
Dialogue: 0,0:08:32.21,0:08:34.87,Main,,0,0,0,,مـ-ميز؟ ما الّذي تفعلينه هنا؟
Dialogue: 0,0:08:35.04,0:08:36.88,Main,,0,0,0,,يسعكِ الاطمئنان الآن يا سوليود-سان
Dialogue: 0,0:08:36.95,0:08:39.97,Main,,0,0,0,,أجئتِ لإنقاذي؟
Dialogue: 0,0:08:41.45,0:08:44.89,Main,,0,0,0,,ما العمل؟ ستُصابين بحروقٍ إن أذبته باستخدام الطور
Dialogue: 0,0:08:44.95,0:08:46.15,Main,,0,0,0,,...ميز
Dialogue: 0,0:08:47.22,0:08:51.25,Main,,0,0,0,,انزعي هذا الطوق، فقد عطّل قوّة طوري
Dialogue: 0,0:08:52.63,0:08:53.86,Main,,0,0,0,,لا تتحرّكي
Dialogue: 0,0:08:54.53,0:08:55.77,Main,,0,0,0,,!هذا يذغدغ
Dialogue: 0,0:08:55.78,0:08:58.18,Main,,0,0,0,,!مهلًا، مؤلم، هذا مؤلم
Dialogue: 0,0:08:58.18,0:08:59.02,Main,,0,0,0,,!نَزَعْتُه
Dialogue: 0,0:08:59.90,0:09:00.89,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:09:04.04,0:09:06.06,Main,,0,0,0,,سوليود-سان؟
Dialogue: 0,0:09:06.41,0:09:08.24,Main,,0,0,0,,شكرًا لكِ يا ميز
Dialogue: 0,0:09:08.91,0:09:09.88,Main,,0,0,0,,لا عليكِ
Dialogue: 0,0:09:09.98,0:09:12.64,Main,,0,0,0,,لا داعي للمكوث أطول، لنلوذ بالفرار
Dialogue: 0,0:09:12.72,0:09:13.61,Main,,0,0,0,,!مهلًا
Dialogue: 0,0:09:13.75,0:09:15.84,Main,,0,0,0,,كم تستغرقون من الوقت للإمساك بجرذٍ واحد؟
Dialogue: 0,0:09:15.86,0:09:17.19,Main,,0,0,0,,!اقضوا عليه في الحال
Dialogue: 0,0:09:17.25,0:09:17.95,Main,,0,0,0,,!عُلم
Dialogue: 0,0:09:19.22,0:09:22.26,Main,,0,0,0,,سحقًا، أين اختفى تسوروغي؟
Dialogue: 0,0:09:22.33,0:09:24.12,Main,,0,0,0,,يا له من حارسٍ شخصيٍّ عديم النفع
Dialogue: 0,0:09:24.49,0:09:27.45,Main,,0,0,0,,...ليتجرّأ على العودة الآن وحينها
Dialogue: 0,0:09:27.53,0:09:31.09,Main,,0,0,0,,ستقتله بيديك كما فعلتَ مع الزعيم السابق؟
Dialogue: 0,0:09:31.17,0:09:32.60,Main,,0,0,0,,مـ-من أنتَ؟
Dialogue: 0,0:09:33.30,0:09:35.04,Main,,0,0,0,,أنسيتني يا بوسمان؟
Dialogue: 0,0:09:35.24,0:09:37.34,Main,,0,0,0,,أنا ابن الرّجل الّذي قتلته
Dialogue: 0,0:09:37.34,0:09:40.78,Main,,0,0,0,,...أأنتَ نجل رويدال
Dialogue: 0,0:09:41.01,0:09:45.64,Main,,0,0,0,,!أنا سابر؛ نجل رويدال، وجئتُ للثأر لموت والدي
Dialogue: 0,0:09:47.68,0:09:48.81,Main,,0,0,0,,!استعدّ لملاقاة حتفكَ
Dialogue: 0,0:09:55.96,0:09:58.29,Main,,0,0,0,,سابر، ألا تزال حيًّا؟
Dialogue: 0,0:10:01.30,0:10:05.03,Main,,0,0,0,,لن أسمح لكَ بقتله بعد
Dialogue: 0,0:10:06.30,0:10:07.46,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:10:07.97,0:10:12.20,Main,,0,0,0,,!أودُّ رؤية قوّة فولنار سيّد
Dialogue: 0,0:10:14.59,0:10:15.83,Main,,0,0,0,,!توقّف
Dialogue: 0,0:10:19.98,0:10:21.38,Main,,0,0,0,,...ميز، أنتِ
Dialogue: 0,0:10:21.98,0:10:24.04,Main,,0,0,0,,أأنتَ بخير يا سابر-سان؟
Dialogue: 0,0:10:24.25,0:10:25.38,Main,,0,0,0,,أ-أجل
Dialogue: 0,0:10:27.02,0:10:31.08,Main,,0,0,0,,حسنٌ، لنهرب، سأطير بنا لأبعد مسافةٍ ممكنة
Dialogue: 0,0:10:36.50,0:10:38.66,Main,,0,0,0,,تلك ميز إذن
Dialogue: 0,0:11:09.53,0:11:10.76,Main,,0,0,0,,تفضّل يا سابر
Dialogue: 0,0:11:23.88,0:11:24.94,Main,,0,0,0,,!ابحثوا عنه
Dialogue: 0,0:11:25.01,0:11:26.79,Main,,0,0,0,,إنّه يرافق طفلًا، ولن يبتعد كثيرًا
Dialogue: 0,0:11:27.18,0:11:28.65,Main,,0,0,0,,!ابحثوا عنهم
Dialogue: 0,0:11:28.72,0:11:31.65,Main,,0,0,0,,...سأكون الطّعم، خذي داي و
Dialogue: 0,0:11:36.73,0:11:37.82,Main,,0,0,0,,!سـ-ساسانا
Dialogue: 0,0:11:39.46,0:11:41.55,Main,,0,0,0,,اعتني بداي جيّدًا
Dialogue: 0,0:11:41.90,0:11:44.92,Main,,0,0,0,,ألم يتبقَّ لكَ أمرٌ بالغ الأهميّة لتنجزه؟
Dialogue: 0,0:11:45.00,0:11:50.56,Main,,0,0,0,,لن أدعكَ تموت حتّى تثأر لموت والدكَ
Dialogue: 0,0:11:51.64,0:11:53.34,Main,,0,0,0,,!ساسانا
Dialogue: 0,0:12:02.75,0:12:06.38,Main,,0,0,0,,،قتل بوسمان والدي طمعًا في منصب الزعيم
Dialogue: 0,0:12:06.46,0:12:09.42,Main,,0,0,0,,ونفاني من القرية، حتّى أنّه قتل ساسانا
Dialogue: 0,0:12:09.69,0:12:12.22,Main,,0,0,0,,سأقضي على بوسمان بيديّ هاتين حتمًا
Dialogue: 0,0:12:12.29,0:12:15.82,Main,,0,0,0,,من أجل والدي، ومن أجل ساسانا أيضًا
Dialogue: 0,0:12:16.10,0:12:20.16,Main,,0,0,0,,أنا أُشبه ساسانا إذن
Dialogue: 0,0:12:21.60,0:12:23.30,Main,,0,0,0,,!يا للمصيبة، إنّها سفينة
Dialogue: 0,0:12:27.94,0:12:30.10,Main,,0,0,0,,قريتي، انتهى أمرها
Dialogue: 0,0:12:30.95,0:12:33.59,Main,,0,0,0,,!اقتلوهم، أحرقوهم، اسحقوهم
Dialogue: 0,0:12:33.72,0:12:36.74,Main,,0,0,0,,!الموتُ حليفُ كلّ من يجرؤ على معارضة بوسمان-ساما
Dialogue: 0,0:12:56.17,0:12:58.47,Main,,0,0,0,,!سحقًا، أنا مُصابٌ هنا
Dialogue: 0,0:12:58.54,0:13:00.01,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:13:00.08,0:13:02.81,Main,,0,0,0,,!لن أموت إلّا برفقتك
Dialogue: 0,0:13:06.65,0:13:09.48,Main,,0,0,0,,!احذر يا داي-تشان
Dialogue: 0,0:13:09.69,0:13:10.06,Main,,0,0,0,,!ميل
Dialogue: 0,0:13:13.42,0:13:14.94,Main,,0,0,0,,كان ذلك وشيكًا
Dialogue: 0,0:13:15.79,0:13:17.14,Main,,0,0,0,,!ميز
Dialogue: 0,0:13:15.79,0:13:17.14,Top,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:13:17.39,0:13:17.90,Main,,0,0,0,,أجل
Dialogue: 0,0:13:19.02,0:13:21.19,Main,,0,0,0,,!أونيه-ني-ساما، كنتُ خائفةً
Dialogue: 0,0:13:21.28,0:13:22.78,Main,,0,0,0,,أعتذر يا ميل-تشان
Dialogue: 0,0:13:22.86,0:13:25.20,Main,,0,0,0,,شكرًا لحمايتكِ لداي
Dialogue: 0,0:13:25.28,0:13:27.61,Main,,0,0,0,,كنتُ خائفةً حقًّا
Dialogue: 0,0:13:28.20,0:13:30.28,Main,,0,0,0,,أأنتِ بخير يا سوليود؟
Dialogue: 0,0:13:30.33,0:13:31.20,Main,,0,0,0,,نوعًا ما
Dialogue: 0,0:13:35.79,0:13:37.75,Main,,0,0,0,,مـ-ما هذا بحقّ؟
Dialogue: 0,0:13:38.38,0:13:40.59,Main,,0,0,0,,ماذا؟ درعٌ اصطناعيّ؟
Dialogue: 0,0:13:47.38,0:13:51.14,Main,,0,0,0,,إنّه درع الألماس الاصطناعيّ، أُولفا
Dialogue: 0,0:13:51.18,0:13:54.81,Main,,0,0,0,,إنّه درع ديمي جبّار يتلاعب بالطور الألماسيّ
Dialogue: 0,0:13:56.73,0:13:58.73,Main,,0,0,0,,ها أنتم هنا أيّتها الحشرات الصّغيرة
Dialogue: 0,0:14:03.48,0:14:04.94,Main,,0,0,0,,لِمَ يقتل حلفاءه؟
Dialogue: 0,0:14:05.03,0:14:08.95,Main,,0,0,0,,ابتلع درع الديمي وعي مُستخدمه
Dialogue: 0,0:14:08.99,0:14:11.66,Main,,0,0,0,,ولم يتبقَّ له سوى مشاعر الحقد
Dialogue: 0,0:14:14.45,0:14:18.17,Main,,0,0,0,,!تلاشى الجميع، تلاشوا تلاشوا
Dialogue: 0,0:14:22.67,0:14:26.30,Main,,0,0,0,,!هذا جيّد، لا أكتفي من هذا
Dialogue: 0,0:14:27.42,0:14:29.34,Main,,0,0,0,,لِمَ يهاجم الرئيس حلفائه؟
Dialogue: 0,0:14:29.38,0:14:30.97,Main,,0,0,0,,وكيف لي أن أعرف؟
Dialogue: 0,0:14:34.42,0:14:36.44,Main,,0,0,0,,وجدتكم
Dialogue: 0,0:14:37.23,0:14:41.19,Main,,0,0,0,,سأستمتع بتعذيبكم حتّى الموت
Dialogue: 0,0:14:41.73,0:14:45.11,Main,,0,0,0,,سحقًا، ألا يُمكن لمُصابٍ أن يرتاح قليلًا؟
Dialogue: 0,0:14:45.44,0:14:49.57,Main,,0,0,0,,لكن يا أستر، ألن تمقت الفرار الآن؟
Dialogue: 0,0:14:58.08,0:14:59.87,Main,,0,0,0,,ما رأيك بهذا؟
Dialogue: 0,0:15:00.37,0:15:01.88,Main,,0,0,0,,لن يجدي ذلك
Dialogue: 0,0:15:05.38,0:15:07.67,Main,,0,0,0,,!أستر-سان، سوليود-سان
Dialogue: 0,0:15:14.51,0:15:15.72,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:15:22.94,0:15:24.40,Main,,0,0,0,,!سـ-سابر-سان؟
Dialogue: 0,0:15:25.86,0:15:27.36,Main,,0,0,0,,أأنتِ بخير يا ميز؟
Dialogue: 0,0:15:28.28,0:15:29.36,Main,,0,0,0,,لِمَ؟
Dialogue: 0,0:15:29.44,0:15:34.20,Main,,0,0,0,,لا أريد أن أفقدكِ كما فقدتُ ساسانا
Dialogue: 0,0:15:35.16,0:15:36.49,Main,,0,0,0,,!سابر-سان
Dialogue: 0,0:15:39.08,0:15:42.50,Main,,0,0,0,,إن متِّ يا أونيه-ني-ساما، فسأموت بدوري
Dialogue: 0,0:15:42.58,0:15:44.59,Main,,0,0,0,,لا أريد البقاء وحيدةً
Dialogue: 0,0:15:44.63,0:15:47.38,Main,,0,0,0,,!سأبقى معكِ للأبد
Dialogue: 0,0:15:48.42,0:15:49.38,Main,,0,0,0,,ميل-تشان
Dialogue: 0,0:15:51.01,0:15:54.43,Main,,0,0,0,,لِمَ يا ميز؟ لِمَ لا تستخدمين دولغر؟
Dialogue: 0,0:15:56.43,0:15:58.14,Main,,0,0,0,,أأرعبكِ الخوف حتّى تجمّدتِ؟
Dialogue: 0,0:15:58.85,0:16:02.02,Main,,0,0,0,,اندمي في الجحيم على استخفافكِ بي
Dialogue: 0,0:16:02.27,0:16:04.77,Main,,0,0,0,,أتمنّى أن تتعفّنوا جميعًا في الجحيم
Dialogue: 0,0:16:07.07,0:16:10.86,Main,,0,0,0,,!ليتني كنتُ قادرةً على التحكّم بدولغر
Dialogue: 0,0:16:12.70,0:16:15.20,Main,,0,0,0,,لا أريد أن أرى شخصًا آخر يموت
Dialogue: 0,0:16:15.28,0:16:16.62,Main,,0,0,0,,!أريد حمايتهم
Dialogue: 0,0:16:17.49,0:16:18.62,Main,,0,0,0,,!أستر-سان
Dialogue: 0,0:16:20.50,0:16:22.00,Main,,0,0,0,,!سوليود-سان
Dialogue: 0,0:16:23.83,0:16:26.46,Main,,0,0,0,,!سابر-سان، داي-تشان، وراندي
Dialogue: 0,0:16:27.84,0:16:28.71,Main,,0,0,0,,!وميل-تشان
Dialogue: 0,0:16:29.88,0:16:31.59,Main,,0,0,0,,!أريد حمايتهم جميعًا
Dialogue: 0,0:16:31.80,0:16:33.13,Main,,0,0,0,,!مُوتي
Dialogue: 0,0:16:34.26,0:16:35.55,Main,,0,0,0,,يا للحماقة
Dialogue: 0,0:16:36.85,0:16:38.06,Main,,0,0,0,,...وإن لزم الأمر
Dialogue: 0,0:16:38.93,0:16:40.77,Main,,0,0,0,,!فسأضحي بحياتي من أجل ذلك
Dialogue: 0,0:16:40.85,0:16:43.52,Main,,0,0,0,,!حتّى لو عنى ذلك موتي في هذا العالم
Dialogue: 0,0:16:54.76,0:16:56.30,Main,,0,0,0,,...هـ-هذا
Dialogue: 0,0:16:56.38,0:16:58.22,Main,,0,0,0,,!إنّه درع الروم؛ دولغر
Dialogue: 0,0:16:58.38,0:17:01.08,Main,,0,0,0,,!أونيه-ني-ساما، استدعيتِ دولغر
Dialogue: 0,0:17:12.23,0:17:14.63,Main,,0,0,0,,!أتيت، حان وقت البالغين الآن
Dialogue: 0,0:17:14.78,0:17:17.65,Main,,0,0,0,,!أونيه-ني-ساما، تبدو رائعًا
Dialogue: 0,0:17:17.74,0:17:20.60,Main,,0,0,0,,!بالتأكيد، فأنا البطل من الآن فصاعدًا
Dialogue: 0,0:17:22.70,0:17:26.08,Main,,0,0,0,,أتظنّ أنَّ درعًا ديميًّا بائسًا سيهزمني؟
Dialogue: 0,0:17:26.12,0:17:27.91,Main,,0,0,0,,!لا تستخفّ بي
Dialogue: 0,0:17:28.50,0:17:32.46,Main,,0,0,0,,اخرس، لا يجدر بمهزومٍ أن يتشدّق بالكلمات
Dialogue: 0,0:17:33.34,0:17:34.92,Main,,0,0,0,,!خذ هذا أيّها الحثالة
Dialogue: 0,0:17:35.71,0:17:37.09,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:17:37.13,0:17:41.09,Main,,0,0,0,,!إنّه انكسار للضوء، والجسد الحقيقيّ في مكانٍ آخر
Dialogue: 0,0:17:41.64,0:17:42.93,Main,,0,0,0,,!ماذا؟
Dialogue: 0,0:17:44.55,0:17:45.93,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:17:45.97,0:17:49.43,Main,,0,0,0,,إنّه يستخدم الانكسار العشوائيّ للضوء لمضاعفة جسده
Dialogue: 0,0:17:50.45,0:17:53.86,Main,,0,0,0,,!لا يسعني التمييز بين الحقيقيّ والمزيّف حتّى
Dialogue: 0,0:17:54.06,0:17:57.94,Main,,0,0,0,,!ها هو الهجوم المتزامن قادم، أرني إن كنتَ قادرًا على تفاديه
Dialogue: 0,0:17:58.74,0:18:03.32,Main,,0,0,0,,أيّها المعتوه، حيلةٌ رخيصةٌ كهذه لن تُجدي نفعًا ضدّ دولغر
Dialogue: 0,0:18:04.26,0:18:05.84,Main,,0,0,0,,!آسفة
Dialogue: 0,0:18:06.41,0:18:09.04,Main,,0,0,0,,...راجو، باجورا، ماها، أغوني
Dialogue: 0,0:18:09.83,0:18:12.56,Main,,0,0,0,,!ماها فايغر
Dialogue: 0,0:18:18.17,0:18:22.26,Main,,0,0,0,,!لا يهمّني أيّكم الحقيقيّ والمزيّف، لتحترقوا جميعًا
Dialogue: 0,0:18:27.18,0:18:28.60,Main,,0,0,0,,!النّصر لي
Dialogue: 0,0:18:33.65,0:18:35.23,Main,,0,0,0,,هذا الثاني
Dialogue: 0,0:18:35.94,0:18:38.61,Main,,0,0,0,,!حسنٌ، حان دوركِ الآن يا ميل
Dialogue: 0,0:18:38.69,0:18:41.53,Main,,0,0,0,,!حسنٌ، كنتُ في انتظار هذه اللّحظة للتلاعب بكِ
Dialogue: 0,0:18:40.49,0:18:41.53,Top,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:18:43.57,0:18:46.58,Main,,0,0,0,,سأثأر لوالدي أخيرًا
Dialogue: 0,0:18:46.66,0:18:51.79,Main,,0,0,0,,تـ-تستخفّ بي، مـ-من تظنّني؟
Dialogue: 0,0:18:53.54,0:18:55.58,Main,,0,0,0,,سئمتُ من تبجّحكَ هذا
Dialogue: 0,0:18:55.67,0:18:59.30,Main,,0,0,0,,!إن كنتَ تعتبر نفسكَ من الزوكو، فاستعدّ لملاقاة حتفك
Dialogue: 0,0:19:07.39,0:19:09.14,Main,,0,0,0,,!مُتْ يا سابر
Dialogue: 0,0:19:24.74,0:19:26.72,Main,,0,0,0,,انتهى أمرك يا بوسمان
Dialogue: 0,0:19:26.84,0:19:27.66,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:19:44.22,0:19:48.22,Main,,0,0,0,,ثأرتُ لكما، يا أبي، وساسانا
Dialogue: 0,0:19:50.39,0:19:53.63,Main,,0,0,0,,كانت هذه مجرّد مهمّةٍ تجريبيّةٍ لشيك
Dialogue: 0,0:19:54.00,0:19:56.16,Main,,0,0,0,,بدأ غورجيس بالتحرّك أيضًا
Dialogue: 0,0:19:56.68,0:20:02.28,Main,,0,0,0,,علينا التخلّص من الماحي؛ فلا بُدَّ من إبادة ميز
Dialogue: 0,0:20:10.41,0:20:13.54,Main,,0,0,0,,احصل على أنديدر جبّار
Dialogue: 0,0:20:14.12,0:20:18.33,Main,,0,0,0,,أنديدر لا يُقهر، آسر
Dialogue: 0,0:20:22.88,0:20:23.95,Main,,0,0,0,,أسترحل؟
Dialogue: 0,0:20:24.24,0:20:29.41,Main,,0,0,0,,أجل، عليَّ إيصال ميل-تشان إلى إمبراطوريّة بيستال في أقرب وقت
Dialogue: 0,0:20:29.87,0:20:30.53,Main,,0,0,0,,فهمت
Dialogue: 0,0:20:30.93,0:20:33.01,Main,,0,0,0,,أدركُ مدى حاجة ميل إليكِ
Dialogue: 0,0:20:33.10,0:20:36.94,Main,,0,0,0,,لا، بل العالم بأسره بحاجةٍ إليكِ
Dialogue: 0,0:20:37.49,0:20:38.64,Main,,0,0,0,,ليس كذلك
Dialogue: 0,0:20:40.40,0:20:42.09,Main,,0,0,0,,...أنا مجرّد
Dialogue: 0,0:20:46.70,0:20:48.74,Main,,0,0,0,,اعتنِ بنفسكِ إذن
Dialogue: 0,0:21:02.46,0:21:03.80,Main,,0,0,0,,!مـ-ميل-تشان
Dialogue: 0,0:21:03.88,0:21:07.97,Main,,0,0,0,,!أونيه-ني-ساما، وجدتكِ، يروق لي مظهركِ الجادّ حقًّا
Dialogue: 0,0:21:08.91,0:21:10.05,Main,,0,0,0,,!ميز-سان
Dialogue: 0,0:21:15.26,0:21:18.94,Main,,0,0,0,,أحظيتما بوداعٍ دافئٍ وحميميٍّ مع سابر؟
Dialogue: 0,0:21:19.71,0:21:21.63,Main,,0,0,0,,لم أحسبه تهديدًا
Dialogue: 0,0:21:21.86,0:21:25.36,Main,,0,0,0,,!كفّا عن هذا، فأونيه-ني-ساما مِلكٌ لي وحدي
Dialogue: 0,0:21:25.44,0:21:30.03,Main,,0,0,0,,!يسعني أن أُنجب لكِ طفلًا ألطف بكثير من داي-تشان، والمزيد منهم أيضًا
Dialogue: 0,0:21:30.20,0:21:32.03,Main,,0,0,0,,...ا-اسمعي
Dialogue: 0,0:21:32.20,0:21:35.49,Main,,0,0,0,,ومن ثمَّ سنغيّر الحفاضات معًا
Dialogue: 0,0:21:36.37,0:21:39.37,Main,,0,0,0,,!هيّا لنُنجب الأطفال، في هذه اللّحظة بالذات
Dialogue: 0,0:21:39.46,0:21:41.00,Main,,0,0,0,,ما رأيكِ يا أونيه-ني-ساما؟
Dialogue: 0,0:21:50.55,0:21:53.35,Main,,0,0,0,,اللّطف لا يحلُّ أيّ خطبٍ
Dialogue: 0,0:21:53.39,0:21:57.18,Main,,0,0,0,,كلّا، اللّطف الحقيقيّ قد يكون مصدر قوّةٍ أحيانًا
Dialogue: 0,0:21:58.22,0:22:00.27,Main,,0,0,0,,أليس كذلك يا ميز؟
Dialogue: 0,0:24:07.78,0:24:11.54,Main,,0,0,0,,...حسنٌ، لنرَ ما يخبّئه لي طالعي
Dialogue: 0,0:24:12.68,0:24:13.91,Main,,0,0,0,,‫عاصفةٌ تلوح في الأفق
Dialogue: 0,0:24:13.98,0:24:18.15,Main,,0,0,0,,‫لقاءٌ بامرأةٍ غامضةٍ سيقودكِ إلى دربٍ مُظلم
Dialogue: 0,0:24:18.22,0:24:19.80,Main,,0,0,0,,تجنّبي المباني الشاهقة
Dialogue: 0,0:24:19.84,0:24:21.62,Main,,0,0,0,,تميمتكِ المشؤومة؛ طوقٌ
Dialogue: 0,0:24:21.77,0:24:24.19,Main,,0,0,0,,!مهلًا، مـ-ما هذا؟
Dialogue: 0,0:24:24.26,0:24:26.82,Main,,0,0,0,,!من هذه المرأة الغامضة؟ من هي؟
Dialogue: 0,0:24:26.90,0:24:29.52,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:29.60,0:24:31.59,Main,,0,0,0,,فارسةٌ شُجاعةٌ وفاتنة
Dialogue: 0,0:24:32.66,0:24:35.56,Main,,0,0,0,,قد تصدقُ النبوءة أو تَخيب
Comment: 0,0:24:35.56,0:24:37.56,Main,,0,0,0,,
Comment: 0,0:24:35.56,0:24:37.56,Main,,0,0,0,,
Dialogue: 0,0:10:46.71,0:10:48.60,Note,,0,0,0,,الدروع الاصطناعيّة: فئةٌ من دروع الديمي صُمّمت لتكون أخفّ وزنًا وأكثر مرونةً إذ تستهلك قدرًا أقلّ من الطاقة وتُناط بها مهام الاستطلاع والدعم التكتيكي
Dialogue: 0,0:16:20.20,0:16:22.79,Note,,0,0,0,,الأطوار: هي تحولات قتاليّة لتعزيز القوّة أو التكيف مع ظروف القتال، ويُعد "الطور الألماسي" أحد أرقى هذه الأطوار حيث يمنح صلابةً هائلة وقوةً تدميريّة تفوق حدود الأطوار العاديّة
Dialogue: 0,0:16:23.87,0:16:26.21,Note,,0,0,0,,فولنار: أشخاص لديهم قدرات خاصّة تمكنهم من استخدام السّحر والتحكّم في القوى الطبيعيّة أو إطلاق طاقة مُشعة
Dialogue: 0,0:16:37.35,0:16:39.18,Note,,0,0,0,,الدروع الاصطناعيّة: فئةٌ من دروع الديمي صُمّمت لتكون أخفّ وزنًا وأكثر مرونةً إذ تستهلك قدرًا أقلّ من الطاقة وتُناط بها مهام الاستطلاع والدعم التكتيكي
Dialogue: 0,0:18:14.61,0:18:18.24,Note,,0,0,0,,دروع الروم: دروع مٌقدسة وآثار أسطوريّة موروثة من العصور الغابرة وتتمتع بوعي خاص وقوّة سحريّة هائلة
Dialogue: 0,0:18:14.61,0:18:18.24,Note,,0,0,0,,دولغر: طرازٌ من الدروع القتاليّة الاصطناعيّة التي تُستدعى بواسطة السحر، ويتميّز بقدراتٍ هجوميّةٍ وسرعة استجابةٍ عاليةٍ في أرض المعركة
Dialogue: 0,0:10:07.97,0:10:12.20,Note,,0,0,0,,فولنار سيّد: مستخدم أطوار لا يحتاج إلى وسيط للتحكم بها، ويمتاز بقدرته على قيادة الدروع دون الحاجة لإبرام عقد سحريّ؛ ممّا يجنبه مخاطر فقدان روحه أو تقييده بدروع محدّدة، فضلًا عن قدرته على تعزيز أداء الدرع الّذي يقوده
Dialogue: 0,0:13:47.38,0:13:51.14,Note,,0,0,0,,أُولفا: درع قتاليّ اصطناعيّ يُفعّل عبر الطور الألماسي، يجمع بين تقنية النواة السحريّة البديلة والخصائص الراقية للطور ليمنح مستخدمه صلابةً استثنائيّة وقوّةً ضاربة في المعارك المباشرة
Comment: 0,0:24:35.56,0:24:37.56,Main,,0,0,0,,
Dialogue: 0,0:02:33.50,0:02:39.47,Signs,,0,0,0,,!درع الروم العاشق الّذي لا يُقهر
Dialogue: 0,0:24:32.49,0:24:36.45,Signs,,0,0,0,,!فارسةٌ شُجاعةٌ وفاتنة
