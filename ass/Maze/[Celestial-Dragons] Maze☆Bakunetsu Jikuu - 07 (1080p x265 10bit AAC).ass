Dialogue: 0,0:00:01.17,0:00:02.35,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:17.68,0:02:19.04,Main,,0,0,0,,...أنا
Dialogue: 0,0:02:24.83,0:02:26.06,Main,,0,0,0,,...أنا أكنّ لكَ
Dialogue: 0,0:03:08.04,0:03:10.58,Main,,0,0,0,,!لا
Dialogue: 0,0:03:21.46,0:03:22.60,Main,,0,0,0,,جلالتك
Dialogue: 0,0:03:25.37,0:03:27.46,Main,,0,0,0,,!فارسةٌ شجاعةٌ وفاتنة
Dialogue: 0,0:03:38.86,0:03:40.24,Main,,0,0,0,,بلغناها أخيرًا إذن
Dialogue: 0,0:03:40.55,0:03:43.73,Main,,0,0,0,,هذه عاصمة مملكة بيستال؛ ريغليتز
Dialogue: 0,0:03:43.95,0:03:47.24,Main,,0,0,0,,حصنٌ طبيعيّ تحيط به سلاسل جبليّة من ثلاث جهات
Dialogue: 0,0:03:47.40,0:03:50.51,Main,,0,0,0,,،فضلًا عن كونها محميّةً بحاجز إبطال الأطوار
Dialogue: 0,0:03:50.55,0:03:52.44,Main,,0,0,0,,ممّا يجعلها مدينةً عصيّةً على الاختراق
Dialogue: 0,0:03:52.92,0:03:54.29,Main,,0,0,0,,إبطال الأطوار؟
Dialogue: 0,0:03:54.82,0:03:55.97,Main,,0,0,0,,...في الواقع
Dialogue: 0,0:03:56.25,0:03:59.28,Main,,0,0,0,,،ينبعث من تلك الأبراج المشيّدة في جهات المملكة الأربعة
Dialogue: 0,0:03:59.40,0:04:02.28,Main,,0,0,0,,حاجزٌ يُبطل الأطوار تمامًا
Dialogue: 0,0:04:02.59,0:04:07.08,Main,,0,0,0,,لذا، يستحيل إرسال جيوشٍ جرارةٍ عبر فول رانا
Dialogue: 0,0:04:07.68,0:04:08.64,Main,,0,0,0,,فهمت
Dialogue: 0,0:04:08.84,0:04:13.42,Main,,0,0,0,,حتّى طائفة جاينا المقدّسة لن يسعها شنّ هجومٍ بسهولةٍ، أليس كذلك يا ميل-تشان؟
Dialogue: 0,0:04:14.77,0:04:16.81,Main,,0,0,0,,ما الخطب يا ميل-تشان؟
Dialogue: 0,0:04:17.86,0:04:20.86,Main,,0,0,0,,لا أستسيغ خالتي
Dialogue: 0,0:04:22.32,0:04:23.91,Main,,0,0,0,,الملكة كاساندرا
Dialogue: 0,0:04:24.26,0:04:29.48,Main,,0,0,0,,يقال إنّها امرأةٌ حازمةٌ تدير شؤون المملكة نيابةً عن الملك ناوكليف
Dialogue: 0,0:04:29.54,0:04:31.93,Main,,0,0,0,,يشاعُ أنّها ذاتُ شخصيّةٍ صارمةٍ للغاية
Dialogue: 0,0:04:32.79,0:04:36.66,Main,,0,0,0,,ستبقى بجواري دائمًا يا أونيه-ني-ساما، أليس كذلك؟
Dialogue: 0,0:04:36.71,0:04:37.75,Main,,0,0,0,,بالطبع
Dialogue: 0,0:04:38.13,0:04:43.34,Main,,0,0,0,,ستبقى بجواري إلى الأبد، أليس كذلك؟
Dialogue: 0,0:04:44.12,0:04:44.97,Main,,0,0,0,,...حـ-حسنٌ
Dialogue: 0,0:04:45.72,0:04:47.40,Main,,0,0,0,,لا تريدين؟
Dialogue: 0,0:04:48.22,0:04:50.43,Main,,0,0,0,,...ليس كذلك، ولكن
Dialogue: 0,0:04:51.80,0:04:55.53,Main,,0,0,0,,!لا تتركني وحدي يا أونيه-ني-ساما
Dialogue: 0,0:04:55.55,0:04:56.18,Main,,0,0,0,,لن أفعل
Dialogue: 0,0:04:56.20,0:04:57.04,Main,,0,0,0,,لن أهجركِ
Dialogue: 0,0:04:57.08,0:04:58.48,Main,,0,0,0,,حسنٌ، أقسم لكِ
Dialogue: 0,0:04:58.48,0:04:59.65,Main,,0,0,0,,لذا كفّي عن البكاء
Dialogue: 0,0:05:02.30,0:05:05.28,Main,,0,0,0,,لا يسعنا التخلّي عنها ببساطة
Dialogue: 0,0:05:14.04,0:05:17.38,Main,,0,0,0,,تفتقر هذه المدينة للحيويّة
Dialogue: 0,0:05:17.92,0:05:21.00,Main,,0,0,0,,الحال سواءٌ أينما ارتحلنا
Dialogue: 0,0:05:25.84,0:05:28.28,Main,,0,0,0,,!قلتُ لكِ أن تأتي
Dialogue: 0,0:05:29.15,0:05:31.31,Main,,0,0,0,,!أرجوك، أطلق سراحي
Dialogue: 0,0:05:31.42,0:05:34.37,Main,,0,0,0,,!سأجعلكِ خادمةً للأمير ليريك
Dialogue: 0,0:05:34.46,0:05:35.85,Main,,0,0,0,,!كوني ممتنةً
Dialogue: 0,0:05:37.02,0:05:39.33,Main,,0,0,0,,ما الّذي تفعلونه؟
Dialogue: 0,0:05:40.36,0:05:41.75,Main,,0,0,0,,ألا ترون أنّها ترفض ذلك؟
Dialogue: 0,0:05:41.82,0:05:43.32,Main,,0,0,0,,!أطلقوا سراحها
Dialogue: 0,0:05:47.49,0:05:49.82,Main,,0,0,0,,ألا تدركينَ من نكون؟
Dialogue: 0,0:05:49.82,0:05:52.53,Main,,0,0,0,,لستِ من أهل هذه المملكة على الأرجح
Dialogue: 0,0:05:53.87,0:05:56.97,Main,,0,0,0,,تبدين امرأةً فاتنةً عن كثب
Dialogue: 0,0:05:57.21,0:06:00.50,Main,,0,0,0,,يسعني تجنيدكِ بدلًا منها، ما رأيكِ؟
Dialogue: 0,0:06:05.55,0:06:06.77,Main,,0,0,0,,!لكمتني
Dialogue: 0,0:06:06.93,0:06:09.88,Main,,0,0,0,,كيف تجرئين! أنا المقرّب الأوّل للأمير ليريك
Dialogue: 0,0:06:11.66,0:06:12.43,Main,,0,0,0,,...أيّتها الـ
Dialogue: 0,0:06:15.73,0:06:17.33,Main,,0,0,0,,الأميرة تراقبنا
Dialogue: 0,0:06:17.44,0:06:19.52,Main,,0,0,0,,سنكتفي بضربكَ حتّى تشرف على الموت
Dialogue: 0,0:06:19.84,0:06:21.91,Main,,0,0,0,,!تصرّفكم هذا يُعدُّ خيانةً
Dialogue: 0,0:06:22.11,0:06:24.20,Main,,0,0,0,,!خيانةٌ في حقّ الأمير ليريك
Dialogue: 0,0:06:50.42,0:06:51.48,Main,,0,0,0,,!تراجعوا
Dialogue: 0,0:06:51.48,0:06:55.68,Main,,0,0,0,,هؤلاء ضيوفٌ من إمبراطوريّة بارتونيا ويحظون برعاية البلاط الملكيّ
Dialogue: 0,0:06:56.02,0:06:57.17,Main,,0,0,0,,!أغمدوا سيوفكم
Dialogue: 0,0:06:57.57,0:06:58.42,Main,,0,0,0,,!اخرسي
Dialogue: 0,0:06:58.42,0:07:01.44,Main,,0,0,0,,!إهانتنا تُعدُّ إهانةً للأمير شخصيًّا
Dialogue: 0,0:07:01.52,0:07:02.19,Main,,0,0,0,,!انصرفي
Dialogue: 0,0:07:02.46,0:07:04.17,Main,,0,0,0,,...وإن لم تفعلي
Dialogue: 0,0:07:04.64,0:07:06.94,Main,,0,0,0,,وماذا ستفعل إن رفضتْ؟
Dialogue: 0,0:07:08.37,0:07:11.80,Main,,0,0,0,,...نحن مُرافقوا الأمير ليريك
Dialogue: 0,0:07:11.80,0:07:14.31,Main,,0,0,0,,لذا، يحقُّ لي تأديبكم بلا هوادةٍ
Dialogue: 0,0:07:14.46,0:07:16.11,Main,,0,0,0,,!تقدّموا بلا تردّد
Dialogue: 0,0:07:17.08,0:07:18.28,Main,,0,0,0,,أعتذرُ بالنيابة عنهم
Dialogue: 0,0:07:18.75,0:07:19.87,Main,,0,0,0,,يسعكِ الانصراف
Dialogue: 0,0:07:20.21,0:07:21.17,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:07:24.42,0:07:25.93,Main,,0,0,0,,!لـ-لنذهب
Dialogue: 0,0:07:26.06,0:07:28.11,Main,,0,0,0,,!أُلغيت دوريّة اليوم
Dialogue: 0,0:07:33.14,0:07:34.85,Main,,0,0,0,,يا لروعتها
Dialogue: 0,0:07:41.56,0:07:43.90,Main,,0,0,0,,أرجو المعذرة على هذا الموقف المُزعج
Dialogue: 0,0:07:44.20,0:07:48.62,Main,,0,0,0,,أنا قائدة الحرس الملكيّ في بيستال؛ ساريس رايبير
Dialogue: 0,0:07:48.97,0:07:53.20,Main,,0,0,0,,جئتُ لمرافقة الأميرة ميل بناءً على أوامر الملك ناوكليف
Dialogue: 0,0:08:10.62,0:08:11.76,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:08:14.34,0:08:15.93,Main,,0,0,0,,!هذا مُذهل
Dialogue: 0,0:08:26.51,0:08:30.58,Main,,0,0,0,,مرحبًا بقدومكِ من تلك الديار البعيدة يا أميرة ميل فارنا
Dialogue: 0,0:08:31.40,0:08:33.90,Main,,0,0,0,,أرجو أن تكوني بأتمّ صحّةٍ وعافيةٍ يا خالتي
Dialogue: 0,0:08:34.41,0:08:36.62,Main,,0,0,0,,لِمَ يُراودني شعورٌ مُريبٌ يا ترى؟
Dialogue: 0,0:08:36.96,0:08:40.86,Main,,0,0,0,,أأنتم من رافقتم ميل إلى هنا؟
Dialogue: 0,0:08:41.37,0:08:42.37,Main,,0,0,0,,!أ-أجل
Dialogue: 0,0:08:45.13,0:08:45.97,Main,,0,0,0,,هكذا إذن
Dialogue: 0,0:08:46.08,0:08:47.93,Main,,0,0,0,,ابتسامتها مُزيّفة
Dialogue: 0,0:08:48.11,0:08:49.51,Main,,0,0,0,,لا بُدَّ أنّها كانت رحلةً شاقّةً
Dialogue: 0,0:08:49.71,0:08:51.01,Main,,0,0,0,,لـ-ليس كذلك
Dialogue: 0,0:08:51.80,0:08:53.80,Main,,0,0,0,,،أيّتها الفولنار الشجاعة
Dialogue: 0,0:08:53.84,0:08:55.73,Main,,0,0,0,,سأُكافئكِ بنفسي
Dialogue: 0,0:08:56.46,0:08:57.47,Main,,0,0,0,,اقتربي منّي
Dialogue: 0,0:08:58.67,0:08:59.37,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:08:59.62,0:09:00.64,Main,,0,0,0,,...عفوًا
Dialogue: 0,0:09:00.84,0:09:02.98,Main,,0,0,0,,اقتربي، لا بأس بذلك
Dialogue: 0,0:09:03.06,0:09:04.44,Main,,0,0,0,,حـ-حاضر
Dialogue: 0,0:09:14.66,0:09:17.22,Main,,0,0,0,,!فهّمتُ رغبة الأميرة ميل
Dialogue: 0,0:09:17.53,0:09:20.86,Main,,0,0,0,,...نحن مملكة بيستال؛ سنُعلن الحرب على الخونة الّذين تمرّدوا على عائلة فارنا
Dialogue: 0,0:09:21.06,0:09:23.45,Main,,0,0,0,,وسنُجرّد حملةً عسكريّةً للقضاء على طائفة جاينا الأولى
Dialogue: 0,0:09:23.84,0:09:27.28,Main,,0,0,0,,...وتوثيقًا لهذا العهد، أُعلن هنا خطوبة
Dialogue: 0,0:09:27.33,0:09:30.04,Main,,0,0,0,,!الأميرة ميل فارنا والأمير ليريك
Dialogue: 0,0:09:30.64,0:09:33.46,Main,,0,0,0,,،مُباركة هي ولادة المملكة المتّحدة الجديدة لبارتونيا وبيستال
Dialogue: 0,0:09:33.60,0:09:35.68,Main,,0,0,0,,!ولتُكلّل بالانتصار والمجد
Dialogue: 0,0:09:35.97,0:09:38.48,Main,,0,0,0,,!تحيا بيستال، تحيا بارتونيا
Dialogue: 0,0:09:38.80,0:09:41.31,Main,,0,0,0,,!ليُحالفهما الانتصار والمجد
Dialogue: 0,0:09:41.62,0:09:44.86,Main,,0,0,0,,!تحيا بيستال، تحيا بارتونيا
Dialogue: 0,0:09:45.22,0:09:48.24,Main,,0,0,0,,!تحيا بيستال، تحيا بارتونيا
Dialogue: 0,0:09:48.26,0:09:49.73,Main,,0,0,0,,!مهلًا يا خالتي
Dialogue: 0,0:09:50.11,0:09:54.48,Main,,0,0,0,,هذا ما كان والدكِ الراحل ليتمنّاه يا ميل
Dialogue: 0,0:09:54.84,0:09:57.51,Main,,0,0,0,,كما أنّه سيُعزّز الروابط بين مملكتينا
Dialogue: 0,0:09:57.86,0:09:59.64,Main,,0,0,0,,!أرفض هذا الزواج
Dialogue: 0,0:09:59.86,0:10:02.44,Main,,0,0,0,,لا أُريد سوى أونيه-ني-ساما
Dialogue: 0,0:10:02.68,0:10:04.02,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:10:04.40,0:10:05.53,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:10:11.60,0:10:14.51,Main,,0,0,0,,ما الّذي تفعلينه أيّتها الملكة كاساندرا؟
Dialogue: 0,0:10:14.84,0:10:18.88,Main,,0,0,0,,أهان هؤلاء مُراقفي ولدي ليريك
Dialogue: 0,0:10:19.28,0:10:20.89,Main,,0,0,0,,أليس كذلك يا ليريك؟
Dialogue: 0,0:10:24.35,0:10:27.56,Main,,0,0,0,,!لكنَّ رجاله هم من استغلّوا اسم الأمير لتحقيق مآربهم
Dialogue: 0,0:10:27.64,0:10:28.88,Main,,0,0,0,,!اخرسي يا رايبير
Dialogue: 0,0:10:29.31,0:10:32.86,Main,,0,0,0,,الإساءة إلى ليريك تُعدُّ إهانةً جسيمةً لا تُغتفر لمملكتنا
Dialogue: 0,0:10:32.94,0:10:35.04,Main,,0,0,0,,!لذا، ألقوا القبض عليهم
Dialogue: 0,0:10:35.07,0:10:35.94,Main,,0,0,0,,...لكن
Dialogue: 0,0:10:36.03,0:10:39.91,Main,,0,0,0,,ألا تُدركينَ أنَّ أوامري هي أوامر الملك ناوكليف شخصيًّا؟
Dialogue: 0,0:10:42.28,0:10:43.24,Main,,0,0,0,,أتفهمين ذلك؟
Dialogue: 0,0:10:45.91,0:10:46.91,Main,,0,0,0,,حاضر
Dialogue: 0,0:10:46.95,0:10:47.73,Main,,0,0,0,,!اقبضوا عليهم
Dialogue: 0,0:10:47.77,0:10:48.44,Main,,0,0,0,,!حاضر
Dialogue: 0,0:10:48.68,0:10:50.37,Main,,0,0,0,,...توقّعنا
Dialogue: 0,0:10:50.40,0:10:51.51,Main,,0,0,0,,حدوث هذا سلفًا
Dialogue: 0,0:11:05.08,0:11:06.35,Main,,0,0,0,,!آسفة
Dialogue: 0,0:11:10.93,0:11:12.28,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:11:15.44,0:11:16.61,Main,,0,0,0,,!ميز
Dialogue: 0,0:11:20.45,0:11:21.71,Main,,0,0,0,,!لا يسعني استخدام الطور
Dialogue: 0,0:11:21.84,0:11:23.22,Main,,0,0,0,,!إنّه حاجز إبطال الأطوار
Dialogue: 0,0:11:23.40,0:11:25.82,Main,,0,0,0,,!سنتدبّر أمرنا، لكنَّ ميز في خطر
Dialogue: 0,0:11:34.75,0:11:36.13,Main,,0,0,0,,لا نهاية لهم
Dialogue: 0,0:11:36.37,0:11:38.51,Main,,0,0,0,,لا خيار أمامنا، لنتراجع الآن
Dialogue: 0,0:11:38.60,0:11:39.22,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:11:42.84,0:11:45.02,Main,,0,0,0,,!سحقًا، اتبعوهم
Dialogue: 0,0:12:26.85,0:12:29.64,Main,,0,0,0,,هكذا إذن، هذا ما فعلتْه كاساندرا
Dialogue: 0,0:12:30.52,0:12:33.11,Main,,0,0,0,,،نفت الملكة ضيوفكَ المُهمّين
Dialogue: 0,0:12:33.28,0:12:36.27,Main,,0,0,0,,وارتكبت فظائع شتّى متجاهلةً رغباتك
Dialogue: 0,0:12:36.53,0:12:39.46,Main,,0,0,0,,!لم أعد أطيق هذا
Dialogue: 0,0:12:40.32,0:12:42.88,Main,,0,0,0,,لا تقولي ذلك يا رايبير
Dialogue: 0,0:12:43.03,0:12:44.03,Main,,0,0,0,,جلالتك
Dialogue: 0,0:12:44.44,0:12:47.80,Main,,0,0,0,,لم أعد أملك القوّة لردعها
Dialogue: 0,0:12:52.00,0:12:53.04,Main,,0,0,0,,فهمت
Dialogue: 0,0:12:53.95,0:12:55.87,Main,,0,0,0,,لا أبتغي الكثير
Dialogue: 0,0:12:55.96,0:13:00.30,Main,,0,0,0,,كلُّ ما أرجوه هو قضاء ما تبقّى من أيّامي بسلام
Dialogue: 0,0:13:04.22,0:13:04.97,Main,,0,0,0,,!جلالتك
Dialogue: 0,0:13:06.05,0:13:10.64,Main,,0,0,0,,لا تشغلي بالكِ، فهذا أمرٌ معتاد
Dialogue: 0,0:13:11.97,0:13:12.93,Main,,0,0,0,,...رغم ذلك
Dialogue: 0,0:13:14.52,0:13:17.35,Main,,0,0,0,,على أيّ حالٍ، لا يجدر بكِ التردّد على هذا المكان كثيرًا
Dialogue: 0,0:13:17.40,0:13:19.27,Main,,0,0,0,,فلن يعود عليكِ بنفعٍ
Dialogue: 0,0:13:19.52,0:13:21.95,Main,,0,0,0,,...جلالتك، أنا
Dialogue: 0,0:13:23.22,0:13:26.60,Main,,0,0,0,,أؤدّي واجبي كخادمةٍ مطيعةٍ ليس إلّا
Dialogue: 0,0:13:28.41,0:13:30.64,Main,,0,0,0,,لا تكوني رسميّةً هكذا
Dialogue: 0,0:13:34.75,0:13:39.25,Main,,0,0,0,,أنتِ كالوردة، شامخةٌ وفاتنة
Dialogue: 0,0:13:39.92,0:13:41.97,Main,,0,0,0,,هالتكِ تمنعُ أيًّا كان من الاقتراب
Dialogue: 0,0:13:45.75,0:13:48.64,Main,,0,0,0,,لِمَ لا ترتدينَ فستانًا بين الحين والآخر؟
Dialogue: 0,0:13:55.08,0:13:57.37,Main,,0,0,0,,أودُّ رؤيتكِ بواحدٍ ولو مرّةً
Dialogue: 0,0:13:59.81,0:14:03.31,Main,,0,0,0,,يـ-يتحتّم عليَّ تأدية واجبي
Dialogue: 0,0:14:04.65,0:14:06.45,Main,,0,0,0,,أستأذنك
Dialogue: 0,0:14:18.46,0:14:21.91,Main,,0,0,0,,!كلّا، كلّا، كلّا، لستُ بامرأةٍ
Dialogue: 0,0:14:22.13,0:14:24.55,Main,,0,0,0,,!هذا أمرٌ لا يجوز
Dialogue: 0,0:14:24.75,0:14:28.55,Main,,0,0,0,,...إن تجرّأتُ وتصرّفتُ كامرأةٍ أمام جلالته ولو مرّةً، فسوف
Dialogue: 0,0:14:29.11,0:14:30.14,Main,,0,0,0,,...فسوف
Dialogue: 0,0:14:40.48,0:14:42.37,Main,,0,0,0,,...فسوف
Dialogue: 0,0:14:47.49,0:14:50.62,Main,,0,0,0,,!ميز-سان، ميز-سان
Dialogue: 0,0:14:51.77,0:14:53.62,Main,,0,0,0,,!ميز-سان
Dialogue: 0,0:14:55.97,0:14:57.66,Main,,0,0,0,,أأنتِ بخير؟
Dialogue: 0,0:14:57.75,0:14:59.02,Main,,0,0,0,,أين نحن؟
Dialogue: 0,0:14:59.55,0:15:03.55,Main,,0,0,0,,سقطنا في متاهةٍ جوفيّةٍ سحيقة
Dialogue: 0,0:15:05.67,0:15:07.67,Main,,0,0,0,,...أيُعقل أنَّ هذا
Dialogue: 0,0:15:08.02,0:15:10.13,Main,,0,0,0,,طوقٌ يُبطل الأطوار
Dialogue: 0,0:15:10.64,0:15:14.93,Main,,0,0,0,,يبدو أنّه طوقٌ صُنع لمعاقبة الفولنار الّذين ارتكبوا الجرائم
Dialogue: 0,0:15:17.66,0:15:18.68,Main,,0,0,0,,!ميز-سان
Dialogue: 0,0:15:19.02,0:15:21.22,Main,,0,0,0,,أنا بخير يا راندي
Dialogue: 0,0:15:21.40,0:15:24.08,Main,,0,0,0,,سأتحوّل إلى ميز الفتى حين يحلُّ الليل حتمًا
Dialogue: 0,0:15:24.24,0:15:25.44,Main,,0,0,0,,...حينها سيسعنا
Dialogue: 0,0:15:25.82,0:15:28.17,Main,,0,0,0,,لكنَّ الليل قد حلَّ بالفعل
Dialogue: 0,0:15:29.17,0:15:32.45,Main,,0,0,0,,بناءً على الوقت الّذي مضى مُنذ سقوطنا، أظنُّ أنَّ الظلام قد خيّم
Dialogue: 0,0:15:33.13,0:15:35.64,Main,,0,0,0,,!لا يسعني استخدام الأطوار، ولا التحوّل حتّى
Dialogue: 0,0:15:36.99,0:15:38.54,Main,,0,0,0,,ما العمل الآن؟
Dialogue: 0,0:15:51.22,0:15:52.55,Main,,0,0,0,,!تماسك
Dialogue: 0,0:15:54.51,0:16:00.39,Main,,0,0,0,,أأُسقطتِ أنتِ الأخرى في هذه المتاهة الجوفيّة الملعونة؟
Dialogue: 0,0:16:01.23,0:16:02.56,Main,,0,0,0,,!لا تتحدّث
Dialogue: 0,0:16:02.69,0:16:04.94,Main,,0,0,0,,سحقًا لكِ يا كاساندرا
Dialogue: 0,0:16:06.08,0:16:11.40,Main,,0,0,0,,لو كان الملك بكامل صحّته لما سُمِحَ بمثل هذه المظالم المروّعة
Dialogue: 0,0:16:11.80,0:16:13.31,Main,,0,0,0,,لا تتحدّث
Dialogue: 0,0:16:14.20,0:16:16.20,Main,,0,0,0,,ابقي حيّة رجاءً
Dialogue: 0,0:16:16.28,0:16:20.37,Main,,0,0,0,,احمي بيستال؛ هذه الأرض البديعة رجاءً
Dialogue: 0,0:16:20.91,0:16:24.53,Main,,0,0,0,,لا تدعي تضحيات رفاقي الفرسان تذهب سُدًى
Dialogue: 0,0:16:24.88,0:16:25.95,Main,,0,0,0,,رجاءً
Dialogue: 0,0:16:34.43,0:16:35.75,Main,,0,0,0,,...أمّي
Dialogue: 0,0:16:48.44,0:16:51.97,Main,,0,0,0,,!يا له من أمرٍ مروّع
Dialogue: 0,0:17:11.92,0:17:13.51,Main,,0,0,0,,أونيه-ني-ساما
Dialogue: 0,0:17:15.51,0:17:18.60,Main,,0,0,0,,تجشمّ الأمير ليريك عناء المجيء لرؤيتكِ
Dialogue: 0,0:17:18.75,0:17:20.47,Main,,0,0,0,,أهذه طريقةٌ لاستقبال الأمير؟
Dialogue: 0,0:17:20.51,0:17:21.64,Main,,0,0,0,,!رحّبي به كما يليق
Dialogue: 0,0:17:23.06,0:17:25.53,Main,,0,0,0,,أتعنين التمرّد على أوامر الأمير ليريك؟
Dialogue: 0,0:17:25.86,0:17:26.80,Main,,0,0,0,,...طفح الكيل من
Dialogue: 0,0:17:27.64,0:17:31.94,Main,,0,0,0,,!أحمق، أحمق، أحمق، أحمق، أحمق
Dialogue: 0,0:17:32.11,0:17:33.71,Main,,0,0,0,,!إيّاكَ والاقتراب من ميل
Dialogue: 0,0:17:34.32,0:17:36.71,Main,,0,0,0,,!ميل مُلكٌ لأونيه-ني-ساما وحدها
Dialogue: 0,0:17:37.13,0:17:40.24,Main,,0,0,0,,!ولن أكون مُلكًا لأيّ شخصٍ آخر أبدًا
Dialogue: 0,0:17:42.24,0:17:43.17,Main,,0,0,0,,هذا يكفي
Dialogue: 0,0:17:44.97,0:17:46.37,Main,,0,0,0,,!انتظر رجاءً
Dialogue: 0,0:17:47.08,0:17:48.91,Main,,0,0,0,,!ليريك-ساما
Dialogue: 0,0:18:20.20,0:18:24.75,Main,,0,0,0,,فهمت، ترفض ميل الانصياع لأوامركَ إذن
Dialogue: 0,0:18:25.04,0:18:27.64,Main,,0,0,0,,تُفضّل تلك المرأة عليّ
Dialogue: 0,0:18:27.86,0:18:30.06,Main,,0,0,0,,رغم أنّي تجشّمت عناء الذهاب لرؤيتها
Dialogue: 0,0:18:31.54,0:18:34.53,Main,,0,0,0,,!تُفضّل تلك المتشرّدة الوقحة عليّ
Dialogue: 0,0:18:35.08,0:18:37.17,Main,,0,0,0,,لِمَ ترفض الانصياع لأوامري؟
Dialogue: 0,0:18:37.48,0:18:39.42,Main,,0,0,0,,رغم أنَّ الجميع ينصاعون لي
Dialogue: 0,0:18:39.55,0:18:41.93,Main,,0,0,0,,!هذا أمرٌ غريبٌ
Dialogue: 0,0:18:44.39,0:18:46.55,Main,,0,0,0,,لا تقلق يا ليريك
Dialogue: 0,0:18:46.75,0:18:48.39,Main,,0,0,0,,ستتولّى والدتكَ تسوية الأمر
Dialogue: 0,0:18:48.88,0:18:49.93,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:18:50.40,0:18:52.77,Main,,0,0,0,,لن يعصي لكَ أحدٌ أمرًا
Dialogue: 0,0:18:53.06,0:18:55.36,Main,,0,0,0,,ولن يمسّكَ أحدٌ بسوءٍ
Dialogue: 0,0:18:55.40,0:18:57.90,Main,,0,0,0,,وستُلبّى كافّة رغباتك
Dialogue: 0,0:18:58.40,0:19:00.74,Main,,0,0,0,,سأحرص على تحقيق ذلك كلّه
Dialogue: 0,0:19:01.41,0:19:04.28,Main,,0,0,0,,!هذا رائعٌ، أنتِ مذهلةٌ يا أمّي
Dialogue: 0,0:19:04.37,0:19:07.70,Main,,0,0,0,,كلّا، بل أنتَ أروع بكثير
Dialogue: 0,0:19:08.87,0:19:10.91,Main,,0,0,0,,ستغدو رجلًا عظيمًا الشأن
Dialogue: 0,0:19:12.08,0:19:14.80,Main,,0,0,0,,فأنتَ نجلُ بيستال ميديشي كاساندرا
Dialogue: 0,0:19:15.62,0:19:18.05,Main,,0,0,0,,وستغدو ملك هذه القارة
Dialogue: 0,0:19:40.53,0:19:42.64,Main,,0,0,0,,هذا أثر حاجز بيستال إذن
Dialogue: 0,0:19:43.20,0:19:46.95,Main,,0,0,0,,ممّا ينفي فعليًّا إمكانيّة شنّ هجومٍ واسع النطاق
Dialogue: 0,0:19:48.20,0:19:51.00,Main,,0,0,0,,الهجوم من الخارج ليس الخيار الأوحد
Dialogue: 0,0:19:54.79,0:19:55.92,Main,,0,0,0,,!جيفا
Dialogue: 0,0:20:01.57,0:20:02.73,Main,,0,0,0,,انطلق
Dialogue: 0,0:20:03.15,0:20:05.17,Main,,0,0,0,,أُوكِلُ إليكَ الأمر برمّته
Dialogue: 0,0:20:05.66,0:20:06.68,Main,,0,0,0,,سمعًا وطاعة
Dialogue: 0,0:20:15.06,0:20:17.06,Main,,0,0,0,,!توقّفي يا ميز-سان
Dialogue: 0,0:20:17.06,0:20:19.32,Main,,0,0,0,,!لن يُجدي التجوّل على غير هُدًى نفعًا
Dialogue: 0,0:20:19.36,0:20:22.08,Main,,0,0,0,,لعلّكِ أُصبتِ بجروحٍ جرّاء السقوط
Dialogue: 0,0:20:22.26,0:20:23.86,Main,,0,0,0,,ما قولكِ؟
Dialogue: 0,0:20:24.55,0:20:26.20,Main,,0,0,0,,!ميز-سان
Dialogue: 0,0:20:26.84,0:20:29.08,Main,,0,0,0,,يتحتّم عليَّ فِعل ذلك
Dialogue: 0,0:20:29.51,0:20:30.28,Main,,0,0,0,,...ولكن
Dialogue: 0,0:20:30.58,0:20:32.48,Main,,0,0,0,,قطعتُ وعدًا
Dialogue: 0,0:20:32.48,0:20:35.13,Main,,0,0,0,,لا يسعني الانتظار مكتوفة الأيدي
Dialogue: 0,0:20:35.22,0:20:36.24,Main,,0,0,0,,...عليَّ
Dialogue: 0,0:20:36.33,0:20:39.06,Main,,0,0,0,,!ميز-سان، تماسكي
Dialogue: 0,0:20:39.75,0:20:42.93,Main,,0,0,0,,...عليَّ مُساعدة
Dialogue: 0,0:20:44.80,0:20:46.17,Main,,0,0,0,,...ميز-سان
Dialogue: 0,0:20:46.57,0:20:48.73,Main,,0,0,0,,!ميز-سان
Dialogue: 0,0:21:11.31,0:21:13.33,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:21:15.22,0:21:16.22,Main,,0,0,0,,لماذا؟
Dialogue: 0,0:21:16.63,0:21:18.35,Main,,0,0,0,,يُفترض ألّا أعرف هذا
Dialogue: 0,0:21:19.86,0:21:21.51,Main,,0,0,0,,ومع ذلك، أعرفه تمامًا
Dialogue: 0,0:21:25.51,0:21:27.09,Main,,0,0,0,,من تلك؟
Dialogue: 0,0:21:29.22,0:21:30.89,Main,,0,0,0,,إنّها شديدة الشبه بي
Dialogue: 0,0:21:31.82,0:21:32.76,Main,,0,0,0,,كلّا
Dialogue: 0,0:21:33.30,0:21:34.51,Main,,0,0,0,,إنّها أنا
Dialogue: 0,0:21:35.09,0:21:36.08,Main,,0,0,0,,!أنا
Dialogue: 0,0:24:09.37,0:24:13.24,Main,,0,0,0,,...حسنٌ، لنرَ ما يخبّئه لي طالعي
Dialogue: 0,0:24:13.59,0:24:14.55,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:24:14.73,0:24:18.26,Main,,0,0,0,,ستلتقي بامرأةٍ حادّة الطباع تنتظر منكَ أن تقودها
Dialogue: 0,0:24:18.35,0:24:20.00,Main,,0,0,0,,اصطحبها في موعدٍ إلى متاهةٍ جوفيّة
Dialogue: 0,0:24:20.04,0:24:21.80,Main,,0,0,0,,تميمة حظّك؛ الخاتم
Dialogue: 0,0:24:22.19,0:24:24.35,Main,,0,0,0,,أتعلمون ما يعنيه هذا؟
Dialogue: 0,0:24:24.44,0:24:28.61,Main,,0,0,0,,!سأستأثر بالشاشة لنفسي، تنحّي جانبًا يا ميز الفتاة
Dialogue: 0,0:24:28.69,0:24:32.28,Main,,0,0,0,,في الحلقة القادمة من ميز الفتى: الفضاء المتفجّر
Dialogue: 0,0:24:32.36,0:24:35.53,Main,,0,0,0,,!متاهة مؤامرات الأشرار
Comment: 0,0:24:35.53,0:24:37.53,Main,,0,0,0,,
Dialogue: 0,0:04:02.59,0:04:07.08,Note,,0,0,0,,الفول رانا: قدرة تكتيكيّة تسمح للدرع أو للمستخدم بالانتقال السريع أو التواري لحظيًا عن الأنظار وذلك عبر الانزلاق والنفاذ من خلال تيار الأطوار الممتد في البعد القتالي
Dialogue: 0,0:08:51.80,0:08:53.80,Note,,0,0,0,,فولنار: أشخاص لديهم قدرات خاصّة تمكنهم من استخدام السّحر والتحكّم في القوى الطبيعيّة أو إطلاق طاقة مُشعة
Comment: 0,0:24:35.53,0:24:37.53,Main,,0,0,0,,
Dialogue: 0,0:03:24.64,0:03:30.64,Signs,,0,0,0,,!فارسةٌ شجاعةٌ وفاتنة
Dialogue: 0,0:24:32.70,0:24:36.70,Signs,,0,0,0,,متاهة مؤامرات الأشرار
