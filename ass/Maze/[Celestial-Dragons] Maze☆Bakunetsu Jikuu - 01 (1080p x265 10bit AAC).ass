Dialogue: 0,0:00:06.10,0:00:08.44,Main,,0,0,0,,!مُصيبة، مُصيبة، مُصيبة يا أونيه-ني-ساما
Dialogue: 0,0:00:08.61,0:00:11.56,Main,,0,0,0,,‫بدءًا من الأسبوع القادم، ستبدأ الدراما التاريخيّة النقيّة المفعمة بالحبّ...
Dialogue: 0,0:00:11.57,0:00:14.78,Main,,0,0,0,,‫والمغامرات والأحلام الحارقة لميل وأونيه-ني-ساما!
Dialogue: 0,0:00:14.85,0:00:16.68,Main,,0,0,0,,سأشاهدها يوم عرضها
Dialogue: 0,0:00:16.68,0:00:18.96,Main,,0,0,0,,هذا يكفي يا ميل-تشان، اقرئي عنوان الحلقة
Dialogue: 0,0:00:19.45,0:00:21.34,Main,,0,0,0,,!حلم ميل-تشان يتفتّح ليلًا
Dialogue: 0,0:00:21.34,0:00:22.18,Main,,0,0,0,,!خطأ
Dialogue: 0,0:00:22.61,0:00:24.22,Main,,0,0,0,,...ميز: الفضاء المتفجّر
Dialogue: 0,0:00:24.22,0:00:25.72,Main,,0,0,0,,المكانُ الّذي استيقظتُ فيه كان عالمًا آخر
Dialogue: 0,0:00:25.98,0:00:27.46,Main,,0,0,0,,غريبةٌ في فضاء الوهم
Dialogue: 0,0:00:27.50,0:00:29.00,Main,,0,0,0,,!سأشاهدها حتمًا
Dialogue: 0,0:00:32.49,0:00:33.59,Main,,0,0,0,,!ستبدأ الآن
Dialogue: 0,0:02:38.51,0:02:39.63,Main,,0,0,0,,عُودي أدراجكِ
Dialogue: 0,0:02:41.18,0:02:43.14,Main,,0,0,0,,من أنتَ؟ وأين أنتَ؟
Dialogue: 0,0:02:43.57,0:02:44.89,Main,,0,0,0,,اختفي
Dialogue: 0,0:02:47.56,0:02:50.23,Main,,0,0,0,,أنتِ خطيرة، إيّاكِ والاقتراب
Dialogue: 0,0:02:50.73,0:02:53.02,Main,,0,0,0,,من أنتَ؟
Dialogue: 0,0:02:53.82,0:02:55.86,Main,,0,0,0,,!أنتِ عقبةٌ في طريقنا، موتي
Dialogue: 0,0:02:56.40,0:02:57.90,Main,,0,0,0,,يا لقسوتكَ
Dialogue: 0,0:02:58.01,0:02:59.24,Main,,0,0,0,,...لم أقترف شيئًا
Dialogue: 0,0:02:59.99,0:03:00.86,Main,,0,0,0,,!موتي
Dialogue: 0,0:03:02.41,0:03:04.12,Main,,0,0,0,,!موتي
Dialogue: 0,0:03:04.12,0:03:05.54,Main,,0,0,0,,!لم أقترف شيئًا
Dialogue: 0,0:03:06.16,0:03:07.54,Main,,0,0,0,,!لماذا؟
Dialogue: 0,0:03:04.12,0:03:07.95,Top,,0,0,0,,!موتي
Dialogue: 0,0:03:12.88,0:03:14.63,Main,,0,0,0,,!موتي
Dialogue: 0,0:03:15.34,0:03:16.42,Main,,0,0,0,,!هذا يكفي
Dialogue: 0,0:03:17.34,0:03:19.59,Main,,0,0,0,,!كلّا
Dialogue: 0,0:03:35.11,0:03:36.94,Main,,0,0,0,,!مؤلم
Dialogue: 0,0:03:39.44,0:03:41.03,Main,,0,0,0,,يا للقذارة
Dialogue: 0,0:03:41.15,0:03:42.41,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:03:42.53,0:03:43.91,Main,,0,0,0,,أهذه غرفتي؟
Dialogue: 0,0:03:43.99,0:03:45.62,Main,,0,0,0,,ما الّذي يعنيه هذا؟
Dialogue: 0,0:03:46.20,0:03:48.08,Main,,0,0,0,,ما الّذي حدث بحقّ؟
Dialogue: 0,0:03:50.33,0:03:53.50,Main,,0,0,0,,ويحي، ما العمل إن تركتْ بقعةً؟
Dialogue: 0,0:03:53.58,0:03:56.21,Main,,0,0,0,,!سحقًا، يا له من يومٍ عصيبٍ
Dialogue: 0,0:04:01.97,0:04:06.18,Main,,0,0,0,,لم تكن تلك غربانًا للتوّ، أليس كذلك؟
Dialogue: 0,0:04:19.11,0:04:20.94,Main,,0,0,0,,ما هذا المكان؟ وأين أنا؟
Dialogue: 0,0:04:25.15,0:04:28.08,Main,,0,0,0,,!ما الّذي يجري هنا بحقّ؟
Dialogue: 0,0:04:28.47,0:04:35.92,Main,,0,0,0,,!هذا مُحال
Dialogue: 0,0:04:56.62,0:04:57.98,Main,,0,0,0,,مـ-ما الّذي يحدث؟
Dialogue: 0,0:04:58.14,0:05:00.41,Main,,0,0,0,,لِمَ أتواجد في مكانٍ كهذا؟
Dialogue: 0,0:05:01.19,0:05:04.11,Main,,0,0,0,,!لم أعد أفقه شيئًا ممّا يحدث
Dialogue: 0,0:05:04.20,0:05:06.86,Main,,0,0,0,,كلّا، لا طائل من الذعر الآن
Dialogue: 0,0:05:07.53,0:05:10.70,Main,,0,0,0,,في مواقف كهذه، عليكِ التحلّي بالهدوء أولًا يا ميز
Dialogue: 0,0:05:11.08,0:05:13.25,Main,,0,0,0,,أجل، اسمي هو ميز
Dialogue: 0,0:05:14.21,0:05:16.21,Main,,0,0,0,,وهذه غرفتي
Dialogue: 0,0:05:16.71,0:05:20.00,Main,,0,0,0,,...ذهبتُ إلى المدرسة كعادتي، وبعدها
Dialogue: 0,0:05:20.59,0:05:21.80,Main,,0,0,0,,...وبعدها
Dialogue: 0,0:05:25.26,0:05:26.68,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:05:28.55,0:05:31.51,Main,,0,0,0,,...أذكر أنّي ذهبتُ إلى المدرسة
Dialogue: 0,0:05:31.72,0:05:35.31,Main,,0,0,0,,ما هي المدرسة؟
Dialogue: 0,0:05:36.01,0:05:37.19,Main,,0,0,0,,...مُحال
Dialogue: 0,0:05:37.73,0:05:40.11,Main,,0,0,0,,ماذا عن عائلتي؟ وأصدقائي؟
Dialogue: 0,0:05:40.90,0:05:42.94,Main,,0,0,0,,!ومتى موعد عيد ميلادي؟
Dialogue: 0,0:05:44.19,0:05:44.94,Main,,0,0,0,,...لا يُعقل
Dialogue: 0,0:05:45.36,0:05:47.41,Main,,0,0,0,,!لا يسعني تذكّر أيِّ شيءٍ
Dialogue: 0,0:05:48.11,0:05:50.03,Main,,0,0,0,,هذا مُحال، هذا مُحال
Dialogue: 0,0:05:50.91,0:05:54.04,Main,,0,0,0,,من... أكون؟
Dialogue: 0,0:06:33.45,0:06:35.54,Main,,0,0,0,,!شكرًا جزيلًا لكِ
Dialogue: 0,0:06:35.65,0:06:37.66,Main,,0,0,0,,!جئتِ في الوقت المناسب تمامًا
Dialogue: 0,0:06:37.76,0:06:40.21,Main,,0,0,0,,!أنتِ منقذتي يا أونيه-ساما
Dialogue: 0,0:06:40.29,0:06:43.96,Main,,0,0,0,,حين أسرني الأعداء، أيقنتُ بهلاكي المحتوم
Dialogue: 0,0:06:44.00,0:06:46.80,Main,,0,0,0,,لكن لا يجدر بالمرء أن ييأس
Dialogue: 0,0:06:46.88,0:06:49.84,Main,,0,0,0,,فمن كان ليتوقّع ظهور مُنقذةٍ مثلكِ يا أونيه-ساما
Dialogue: 0,0:06:49.84,0:06:51.18,Main,,0,0,0,,!تأثرتُ بحقّ
Dialogue: 0,0:06:53.14,0:06:55.43,Main,,0,0,0,,أدين لكِ بخالص الشّكر والامتنان
Dialogue: 0,0:06:57.18,0:06:58.64,Main,,0,0,0,,...فتاة
Dialogue: 0,0:07:03.90,0:07:06.94,Main,,0,0,0,,أُدعى ميل، واسمي الكامل هو ميل فارنا
Dialogue: 0,0:07:08.86,0:07:10.28,Main,,0,0,0,,ميل-تشان؟
Dialogue: 0,0:07:10.57,0:07:11.53,Main,,0,0,0,,!أجل
Dialogue: 0,0:07:12.74,0:07:15.99,Main,,0,0,0,,من أين قدمتِ يا أونيه-ساما؟
Dialogue: 0,0:07:15.99,0:07:17.29,Main,,0,0,0,,!هذا مربط الفرس
Dialogue: 0,0:07:17.37,0:07:20.65,Main,,0,0,0,,أخبريني يا ميل-تشان، أين نحن الآن؟
Dialogue: 0,0:07:20.68,0:07:22.64,Main,,0,0,0,,وكيف انتهى بي المطاف هنا؟
Dialogue: 0,0:07:22.64,0:07:25.04,Main,,0,0,0,,!نحن في غابة بانون بالطبع
Dialogue: 0,0:07:25.45,0:07:31.38,Main,,0,0,0,,سقط منزلكِ من السماء فسحق مُطارديّ
Dialogue: 0,0:07:31.76,0:07:32.97,Main,,0,0,0,,غابة بانون؟
Dialogue: 0,0:07:33.72,0:07:34.80,Main,,0,0,0,,من السماء؟
Dialogue: 0,0:07:35.09,0:07:36.93,Main,,0,0,0,,...حدث الأمر هكذا
Dialogue: 0,0:07:39.92,0:07:41.73,Main,,0,0,0,,!كلّا
Dialogue: 0,0:07:50.08,0:07:50.72,Main,,0,0,0,,هكذا
Dialogue: 0,0:07:56.28,0:07:58.45,Main,,0,0,0,,!من هنا يا أونيه-ساما
Dialogue: 0,0:07:58.58,0:08:00.71,Main,,0,0,0,,!مهلًا يا ميل-تشان، تريّثي قليلًا
Dialogue: 0,0:08:00.75,0:08:01.91,Main,,0,0,0,,!أكره الخروج
Dialogue: 0,0:08:03.92,0:08:06.29,Main,,0,0,0,,هذا منزلكِ، أليس كذلك؟
Dialogue: 0,0:08:09.30,0:08:10.46,Main,,0,0,0,,!كيف آل الأمر إلى هذا؟
Dialogue: 0,0:08:10.55,0:08:13.13,Main,,0,0,0,,هوى هذا المنزل من السماء
Dialogue: 0,0:08:13.51,0:08:14.80,Main,,0,0,0,,فحدث ما ترينه الآن
Dialogue: 0,0:08:23.06,0:08:27.19,Main,,0,0,0,,مُـ-مُحال، أحدث هذا بسببي؟
Dialogue: 0,0:08:27.48,0:08:31.40,Main,,0,0,0,,!ما العمل؟ أرديتُ إنسانًا قتيلًا
Dialogue: 0,0:08:32.36,0:08:35.16,Main,,0,0,0,,ليس إنسانًا، إنّه شبه آدميّ
Dialogue: 0,0:08:35.24,0:08:36.87,Main,,0,0,0,,!لا فرق بينهما
Dialogue: 0,0:08:38.78,0:08:41.79,Main,,0,0,0,,ما هذا؟ ما هذا؟ ما هذا؟
Dialogue: 0,0:08:42.37,0:08:45.04,Main,,0,0,0,,!لِمَ عليَّ أن أُقاسي مِحنةً كهذه؟
Dialogue: 0,0:08:45.29,0:08:46.33,Main,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:08:46.75,0:08:50.46,Main,,0,0,0,,،فقدتُ ذاكرتي، وزُجَّ بي فجأةً في هذا المكان
Dialogue: 0,0:08:50.55,0:08:52.80,Main,,0,0,0,,أكان يتحتّم عليَّ أن أغدو قاتلةً فوق كلّ هذا؟
Dialogue: 0,0:08:52.88,0:08:56.93,Main,,0,0,0,,أخبرتكِ أنَّ شبه الآدميّين ليسوا بشرًا
Dialogue: 0,0:08:57.39,0:09:00.18,Main,,0,0,0,,فهمتُ، هذا مجرد حلمٍ، أليس كذلك؟
Dialogue: 0,0:09:00.39,0:09:04.39,Main,,0,0,0,,أجل، لا بدَّ أنّه كذلك، أو أنّه مقلبٌ مُدبّر
Dialogue: 0,0:09:04.94,0:09:06.81,Main,,0,0,0,,أليس كذلك يا ميل-تشان؟
Dialogue: 0,0:09:11.07,0:09:14.11,Main,,0,0,0,,!لم أعد أفقهُ شيئًا ممّا يحدث
Dialogue: 0,0:09:14.24,0:09:17.16,Main,,0,0,0,,ما الّذي يجدر بي فعله؟
Dialogue: 0,0:09:18.78,0:09:20.49,Main,,0,0,0,,!احذري يا أونيه-ساما
Dialogue: 0,0:09:31.59,0:09:34.17,Main,,0,0,0,,!لِنلوذ بالفرار
Dialogue: 0,0:10:15.01,0:10:16.88,Main,,0,0,0,,!أسرعي يا أونيه-ساما
Dialogue: 0,0:10:26.14,0:10:27.60,Main,,0,0,0,,!يا لعنادهم
Dialogue: 0,0:10:30.27,0:10:33.82,Main,,0,0,0,,!ما هذا؟ سألقى حتفي حتمًا
Dialogue: 0,0:10:37.49,0:10:39.66,Main,,0,0,0,,بلغنا طريقًا مسدودًا
Dialogue: 0,0:10:46.71,0:10:48.60,Main,,0,0,0,,!إنّه درع اصطناعيّ هذه المرّة
Dialogue: 0,0:10:48.71,0:10:50.46,Main,,0,0,0,,درع اصطناعيّ؟
Dialogue: 0,0:10:56.55,0:10:58.72,Main,,0,0,0,,!أنهكني التّعب
Dialogue: 0,0:10:58.76,0:11:00.51,Main,,0,0,0,,!لن يُفيدنا التذمّر الآن
Dialogue: 0,0:11:09.10,0:11:11.90,Main,,0,0,0,,أأنتِ بخيرٍ يا ميل-تشان؟ ميل-تشان؟
Dialogue: 0,0:11:15.44,0:11:17.53,Main,,0,0,0,,يبدو أنّنا سقطنا من هناك
Dialogue: 0,0:11:18.69,0:11:20.61,Main,,0,0,0,,كُشف أمرنا، ما العمل الآن؟
Dialogue: 0,0:11:22.87,0:11:23.87,Main,,0,0,0,,!أونيه-ساما
Dialogue: 0,0:11:25.08,0:11:27.37,Main,,0,0,0,,!إيّاكَ والاقتراب! ابتعد من هنا
Dialogue: 0,0:11:36.80,0:11:38.26,Main,,0,0,0,,!أونيه-ساما
Dialogue: 0,0:11:38.27,0:11:39.31,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:11:51.35,0:11:53.35,Main,,0,0,0,,يبدو أنّنا تمكّنا من الهرب على أيّ حالٍ
Dialogue: 0,0:11:53.52,0:11:54.69,Main,,0,0,0,,هذا مُطمئن
Dialogue: 0,0:11:54.73,0:11:56.77,Main,,0,0,0,,يا له من عالمٍ عجيبٍ بحقّ
Dialogue: 0,0:11:57.07,0:11:58.48,Main,,0,0,0,,ما العمل الآن؟
Dialogue: 0,0:12:04.28,0:12:04.87,Main,,0,0,0,,بشر؟
Dialogue: 0,0:12:05.53,0:12:08.25,Main,,0,0,0,,!أجل، لا ريب في ذلك، إنّهم بشر
Dialogue: 0,0:12:08.29,0:12:10.66,Main,,0,0,0,,!هذا مُطمئن
Dialogue: 0,0:12:14.77,0:12:16.38,Main,,0,0,0,,!إيّاكِ يا أونيه-ساما
Dialogue: 0,0:12:17.84,0:12:19.80,Main,,0,0,0,,!إنّهم مُطاردون من جاينا
Dialogue: 0,0:12:24.22,0:12:25.97,Main,,0,0,0,,!مُـ-مُحال
Dialogue: 0,0:12:41.28,0:12:45.36,Main,,0,0,0,,آسفةٌ يا ميل-تشان، خلتهم أناسًا طيّبين
Dialogue: 0,0:12:49.91,0:12:51.29,Main,,0,0,0,,عثرتُ عليكِ
Dialogue: 0,0:12:51.29,0:12:52.62,Main,,0,0,0,,!الأميرة ميل فارنا
Dialogue: 0,0:12:54.12,0:12:54.89,Main,,0,0,0,,أميرة؟
Dialogue: 0,0:12:55.25,0:12:58.88,Main,,0,0,0,,أأنتِ أميرةٌ يا ميل-تشان؟
Dialogue: 0,0:12:59.46,0:13:00.96,Main,,0,0,0,,!استعدي أيّتها الأميرة
Dialogue: 0,0:13:04.76,0:13:07.64,Main,,0,0,0,,تفاديتِ نَصلي إذن، لا بأس بكِ
Dialogue: 0,0:13:08.35,0:13:10.10,Main,,0,0,0,,أأنتِ بخيرٍ يا أونيه-ساما؟
Dialogue: 0,0:13:10.82,0:13:15.35,Main,,0,0,0,,أيّتها المرأة، إن نويتِ التستّر على الأميرة فلن أرحمكِ
Dialogue: 0,0:13:15.64,0:13:16.90,Main,,0,0,0,,أونيه-ساما
Dialogue: 0,0:13:17.31,0:13:18.15,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:13:19.36,0:13:24.57,Main,,0,0,0,,!ما هذا؟ رجالٌ أشداء يستلّون سيوفهم في وجه فتاتين ضعيفتين؟
Dialogue: 0,0:13:24.57,0:13:25.53,Main,,0,0,0,,!يا لدناءتكم
Dialogue: 0,0:13:27.28,0:13:32.12,Main,,0,0,0,,!أجهل مجريات الأمور، لكنّي لن أسلّمكم ميل-تشان أبدًا
Dialogue: 0,0:13:32.16,0:13:33.70,Main,,0,0,0,,!أونيه-ساما
Dialogue: 0,0:13:33.75,0:13:35.04,Main,,0,0,0,,وزنكِ ثقيلٌ يا ميل-تشان
Dialogue: 0,0:13:35.58,0:13:37.67,Main,,0,0,0,,يا لافتقاركنّ لروح الجديّة
Dialogue: 0,0:13:38.46,0:13:39.92,Main,,0,0,0,,!إذن، فلتلقي حتفكِ أنتِ الأخرى
Dialogue: 0,0:13:42.67,0:13:44.97,Main,,0,0,0,,أنا... سأموت
Dialogue: 0,0:13:48.93,0:13:49.95,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:13:53.83,0:13:55.63,Main,,0,0,0,,!أنتِ مذهلةٌ يا أونيه-ساما
Dialogue: 0,0:13:55.85,0:13:59.40,Main,,0,0,0,,أشعر بخفّةٍ عجيبةٍ، ما الّذي يحلُّ بي؟
Dialogue: 0,0:13:59.61,0:14:01.69,Main,,0,0,0,,...مرّةً تلو الأخرى
Dialogue: 0,0:14:02.19,0:14:04.61,Main,,0,0,0,,أترفضين تسليمنا الأميرة مهما كلّف الأمر؟
Dialogue: 0,0:14:05.07,0:14:06.32,Main,,0,0,0,,أونيه-ساما
Dialogue: 0,0:14:06.53,0:14:07.65,Main,,0,0,0,,لا بأس
Dialogue: 0,0:14:07.70,0:14:12.03,Main,,0,0,0,,لا بأس يا ميل-تشان، واثقةٌ من أنّنا سنتمكّن من الهرب
Dialogue: 0,0:14:13.36,0:14:14.37,Main,,0,0,0,,...أونيه-ساما
Dialogue: 0,0:14:15.83,0:14:17.58,Main,,0,0,0,,يا من تتحدّين جاينا
Dialogue: 0,0:14:17.66,0:14:19.67,Main,,0,0,0,,أنتم تجسيدٌ للشرّ المطلق
Dialogue: 0,0:14:19.71,0:14:22.50,Main,,0,0,0,,لن نسمح لمتمرّدٍ واحدٍ بالفرار
Dialogue: 0,0:14:25.40,0:14:26.88,Main,,0,0,0,,!تمهّلوا
Dialogue: 0,0:14:28.80,0:14:31.39,Main,,0,0,0,,غايتكم المنشودة هي أنا
Dialogue: 0,0:14:31.47,0:14:33.93,Main,,0,0,0,,!كفّوا عن إقحام الأبرياء في هذا الشأن
Dialogue: 0,0:14:36.27,0:14:37.73,Main,,0,0,0,,ميل-تشان؟
Dialogue: 0,0:14:37.94,0:14:38.91,Main,,0,0,0,,لا بأس
Dialogue: 0,0:14:40.23,0:14:43.07,Main,,0,0,0,,،مُنذ أن سقطتْ بارتونيان في قبضة جاينا
Dialogue: 0,0:14:43.77,0:14:45.94,Main,,0,0,0,,أيقنتُ بأنَّ هذا المصير سيُدركني يومًا ما
Dialogue: 0,0:14:46.44,0:14:48.61,Main,,0,0,0,,...أيعقل أنّكِ حقًّا
Dialogue: 0,0:14:49.45,0:14:53.41,Main,,0,0,0,,كنتُ أميرةً... قبل بضعة أيّام خلت
Dialogue: 0,0:14:55.70,0:14:58.66,Main,,0,0,0,,...حينها، دبّرتْ كنيسة جاينا المقدّسة انقلابًا
Dialogue: 0,0:14:58.75,0:15:01.63,Main,,0,0,0,,...وقُتل والدي ووالدتي
Dialogue: 0,0:15:10.47,0:15:13.18,Main,,0,0,0,,لا يسعني أن أُثقل كاهلكِ بمزيدٍ من المتاعب يا أونيه-ساما
Dialogue: 0,0:15:13.80,0:15:17.93,Main,,0,0,0,,يسعكِ النجاة بنفسكِ إن مضيتِ بمفردكِ
Dialogue: 0,0:15:18.98,0:15:19.69,Main,,0,0,0,,...لذا
Dialogue: 0,0:15:21.27,0:15:23.90,Main,,0,0,0,,شكرًا لكِ على كلِّ شيءٍ يا أونيه-ساما
Dialogue: 0,0:15:24.02,0:15:25.44,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:15:30.14,0:15:32.82,Main,,0,0,0,,مُحال، ما الّذي يجدر بي فعله؟
Dialogue: 0,0:15:33.49,0:15:37.91,Main,,0,0,0,,لا أفقَهُ الخيرَ من الشرِّ في هذا العالمِ
Dialogue: 0,0:15:38.33,0:15:41.29,Main,,0,0,0,,مُحالٌ أن أتمكّن من هزيمة أمثالهم
Dialogue: 0,0:15:41.42,0:15:43.33,Main,,0,0,0,,...ومع ذلك
Dialogue: 0,0:15:46.46,0:15:48.13,Main,,0,0,0,,يا لها من عزيمةٍ نبيلةٍ
Dialogue: 0,0:15:48.17,0:15:51.88,Main,,0,0,0,,لكن لا ضمانة تمنعُ فرارَها منّا مجدّدًا
Dialogue: 0,0:15:52.18,0:15:54.61,Main,,0,0,0,,،إن لم تخني الذاكرة
Dialogue: 0,0:15:54.74,0:15:57.81,Main,,0,0,0,,لا يهمُّ أسرُ المتمرّدين أحياءً كانوا أم أمواتًا
Dialogue: 0,0:15:59.68,0:16:02.73,Main,,0,0,0,,!سأريحكِ من عذابكِ في الحال أيّتها الأميرة
Dialogue: 0,0:16:03.52,0:16:09.69,Main,,0,0,0,,!لا يسعني السماح بهذا، أريدُ إنقاذ ميل-تشان
Dialogue: 0,0:16:12.53,0:16:13.45,Main,,0,0,0,,!موتي
Dialogue: 0,0:16:14.28,0:16:15.49,Main,,0,0,0,,!كلّا
Dialogue: 0,0:16:16.62,0:16:17.28,Main,,0,0,0,,!ما هذا؟
Dialogue: 0,0:16:20.20,0:16:22.79,Main,,0,0,0,,!محالٌ، إنّه الطور الألماسيّ
Dialogue: 0,0:16:23.87,0:16:26.21,Main,,0,0,0,,أتلك المرأة فولنار؟
Dialogue: 0,0:16:27.75,0:16:29.17,Main,,0,0,0,,ما الّذي فعلته للتوّ؟
Dialogue: 0,0:16:29.25,0:16:30.67,Main,,0,0,0,,...فولنار
Dialogue: 0,0:16:31.84,0:16:35.51,Main,,0,0,0,,!مذهلٌ، يسعكِ التلاعب بالأطوار يا أونيه-ساما
Dialogue: 0,0:16:35.52,0:16:37.10,Main,,0,0,0,,!سحقًا، يا له من عائقٍ مزعجٍ
Dialogue: 0,0:16:37.35,0:16:39.18,Main,,0,0,0,,!لنستدعِ الدرع الاصطناعيّ
Dialogue: 0,0:16:42.08,0:16:43.27,Main,,0,0,0,,!أونيه-ساما
Dialogue: 0,0:16:43.48,0:16:44.52,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:16:49.94,0:16:52.57,Main,,0,0,0,,أنتِ مُنقذتي حقًّا يا أونيه-ساما
Dialogue: 0,0:16:52.74,0:16:55.28,Main,,0,0,0,,سأتبعكِ أينما ذهبتِ يا أونيه-ساما
Dialogue: 0,0:16:55.53,0:16:56.41,Main,,0,0,0,,ميل-تشان
Dialogue: 0,0:17:00.54,0:17:02.29,Main,,0,0,0,,!ظهروا مجدّدًا
Dialogue: 0,0:17:02.58,0:17:05.83,Main,,0,0,0,,!لا بأس، دعي الأمر لي
Dialogue: 0,0:17:08.17,0:17:12.46,Main,,0,0,0,,رورو، فارنا، هاي، فامون، را، فو
Dialogue: 0,0:17:54.30,0:17:57.13,Main,,0,0,0,,استدعيا درعًا غريبًا لم أره من قبل
Dialogue: 0,0:18:07.77,0:18:09.73,Main,,0,0,0,,ما هذا يا ميل-تشان؟
Dialogue: 0,0:18:12.67,0:18:14.18,Main,,0,0,0,,ما هذا بحقّ؟
Dialogue: 0,0:18:14.61,0:18:18.24,Main,,0,0,0,,إنّه إرث عائلة فارنا؛ درع الروم الأسطوريّ دولغر
Dialogue: 0,0:18:18.45,0:18:22.08,Main,,0,0,0,,استخدمي قوّتكِ بحريّةٍ وأبرحيهم ضربًا رجاءً
Dialogue: 0,0:18:22.78,0:18:25.29,Main,,0,0,0,,أُبرحهم ضربًا؟
Dialogue: 0,0:18:29.18,0:18:31.25,Main,,0,0,0,,إنّه أصلب ممّا يبدو عليه
Dialogue: 0,0:18:31.92,0:18:33.30,Main,,0,0,0,,!دع الأمر لي
Dialogue: 0,0:18:33.80,0:18:36.09,Main,,0,0,0,,!كلّا، إيّاكم والاقتراب
Dialogue: 0,0:18:42.68,0:18:45.64,Main,,0,0,0,,!فعلتِها، أنتِ قويّة يا أونيه-ساما
Dialogue: 0,0:18:46.81,0:18:50.90,Main,,0,0,0,,ما هذا؟ ما الّذي أفعله بحقّ؟
Dialogue: 0,0:18:52.52,0:18:53.65,Main,,0,0,0,,أونيه-ساما؟
Dialogue: 0,0:18:57.49,0:19:00.32,Main,,0,0,0,,...يمتلك ذلك الدرع الاصطناعيّ قوّةً هائلةً، ولكن
Dialogue: 0,0:19:00.49,0:19:04.33,Main,,0,0,0,,!يبدو أنَّ قائدته مجرّد هاويةٍ
Dialogue: 0,0:19:11.29,0:19:12.71,Main,,0,0,0,,!تماسكي يا أونيه-ساما
Dialogue: 0,0:19:13.29,0:19:16.63,Main,,0,0,0,,أخطأتِ باللّجوء إلى قتال الدروع الاصطناعيّة
Dialogue: 0,0:19:16.96,0:19:18.84,Main,,0,0,0,,!يؤسفني القول إنَّ هذه نهايتكما
Dialogue: 0,0:19:19.77,0:19:21.89,Main,,0,0,0,,!استخدمي طوركِ يا أونيه-ساما
Dialogue: 0,0:19:21.97,0:19:26.14,Main,,0,0,0,,!واثقةٌ من أنَّ قوّتكِ قادرةٌ على التحكّم بدولغر كما تشائين
Dialogue: 0,0:19:26.56,0:19:29.35,Main,,0,0,0,,...قول ذلك يسيرٌ، لكنّي
Dialogue: 0,0:19:30.60,0:19:31.65,Main,,0,0,0,,...لكنّي
Dialogue: 0,0:19:38.44,0:19:41.28,Main,,0,0,0,,!لا أفقه شيئًا في القتال
Dialogue: 0,0:19:41.66,0:19:45.28,Main,,0,0,0,,ما هو الطور؟
Dialogue: 0,0:19:49.47,0:19:51.92,Main,,0,0,0,,سأبيّن لكَ ماهيّة الطور
Dialogue: 0,0:19:52.25,0:19:53.38,Main,,0,0,0,,!متْ
Dialogue: 0,0:19:54.00,0:19:55.71,Main,,0,0,0,,!هكذا يُستخدم
Dialogue: 0,0:20:00.97,0:20:05.72,Main,,0,0,0,,أتظنّ أنَّ حيلكَ الرخيصة هذه قادرةٌ على هزيمتي أيّها الحثالة؟
Dialogue: 0,0:20:06.85,0:20:09.47,Main,,0,0,0,,تـ-تحوّلتْ أونيه-ساما إلى أوني-ساما؟
Dialogue: 0,0:20:10.18,0:20:11.23,Main,,0,0,0,,!يا لها من قوّةٍ
Dialogue: 0,0:20:11.27,0:20:15.11,Main,,0,0,0,,!ليس الطور الألماسيّ فحسب، بل لديهم الطور الياقوتيّ أيضًا
Dialogue: 0,0:20:15.44,0:20:19.23,Main,,0,0,0,,!رورو لاجو باجورا ماها أغوني
Dialogue: 0,0:20:20.57,0:20:22.20,Main,,0,0,0,,...مستحيلٌ، هذه التعويذة
Dialogue: 0,0:20:22.61,0:20:24.66,Main,,0,0,0,,!ماها فايغر
Dialogue: 0,0:21:04.53,0:21:07.41,Main,,0,0,0,,أرأيتَ عاقبة التحدّي أمامي؟
Dialogue: 0,0:21:07.57,0:21:10.70,Main,,0,0,0,,!أنتَ مذهلٌ، وهمجيٌّ، ورائعٌ للغاية
Dialogue: 0,0:21:10.79,0:21:14.08,Main,,0,0,0,,!بدءًا من الآن، سأتولّى أنا؛ ميز-ساما حمايتكِ دائمًا
Dialogue: 0,0:21:18.28,0:21:19.84,Main,,0,0,0,,!أوني-ساما
Dialogue: 0,0:21:22.72,0:21:24.92,Main,,0,0,0,,مـ-ماذا؟! ما الّذي يجري هنا؟
Dialogue: 0,0:21:24.94,0:21:27.97,Main,,0,0,0,,أين اختفيتُ يا ترى؟
Dialogue: 0,0:21:28.18,0:21:31.06,Main,,0,0,0,,كيف يُعقل أن يكون هو أيضًا ميز؟
Dialogue: 0,0:21:32.56,0:21:35.56,Main,,0,0,0,,!لا أعلم ما الّذي يجري
Dialogue: 0,0:24:36.99,0:24:38.79,Main,,0,0,0,,أهلًا، معكم ميل
Dialogue: 0,0:24:38.91,0:24:42.16,Main,,0,0,0,,أكنُّ حبًّا جمًّا لأونيه-ساما في النهار، وأوني-ساما في الليل
Dialogue: 0,0:24:42.21,0:24:45.88,Main,,0,0,0,,!أكنُّ لكما حبًّا جمًّا يا أونيه-ني-ساما
Dialogue: 0,0:24:45.88,0:24:47.34,Main,,0,0,0,,...إذن، لعلّنا نستطيع أنا وأنتِ
Dialogue: 0,0:24:47.34,0:24:51.56,Main,,0,0,0,,!مهلًا، لا وقت للعبث الآن، فمطاردو جاينا يتعقّبوننا
Dialogue: 0,0:24:51.76,0:24:55.89,Main,,0,0,0,,!لا تقلقي، فسيُعيننا أستر-سان وسولود-سان
Dialogue: 0,0:24:56.20,0:24:57.04,Main,,0,0,0,,ومن يكونان؟
Dialogue: 0,0:24:57.06,0:24:58.24,Main,,0,0,0,,!شاهدونا لتعرفوا
Dialogue: 0,0:24:58.27,0:25:00.08,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:25:00.24,0:25:02.23,Main,,0,0,0,,!ثنائيٌّ خارقٌ وسريعٌ كالبرق
Dialogue: 0,0:25:02.26,0:25:03.95,Main,,0,0,0,,!تغمرني الحماسة
Comment: 0,0:16:26.21,0:16:27.75,Note,,0,0,0,,
Dialogue: 0,0:10:46.71,0:10:48.60,Note,,0,0,0,,الدروع الاصطناعيّة: فئةٌ من دروع الديمي صُمّمت لتكون أخفّ وزنًا وأكثر مرونةً إذ تستهلك قدرًا أقلّ من الطاقة وتُناط بها مهام الاستطلاع والدعم التكتيكي
Dialogue: 0,0:16:20.20,0:16:22.79,Note,,0,0,0,,الأطوار: هي تحولات قتاليّة لتعزيز القوّة أو التكيف مع ظروف القتال، ويُعد "الطور الألماسي" أحد أرقى هذه الأطوار حيث يمنح صلابةً هائلة وقوةً تدميريّة تفوق حدود الأطوار العاديّة
Dialogue: 0,0:16:23.87,0:16:26.21,Note,,0,0,0,,فولنار: أشخاص لديهم قدرات خاصّة تمكنهم من استخدام السّحر والتحكّم في القوى الطبيعيّة أو إطلاق طاقة مُشعة
Dialogue: 0,0:16:37.35,0:16:39.18,Note,,0,0,0,,الدروع الاصطناعيّة: فئةٌ من دروع الديمي صُمّمت لتكون أخفّ وزنًا وأكثر مرونةً إذ تستهلك قدرًا أقلّ من الطاقة وتُناط بها مهام الاستطلاع والدعم التكتيكي
Dialogue: 0,0:18:14.61,0:18:18.24,Note,,0,0,0,,دروع الروم: دروع مٌقدسة وآثار أسطوريّة موروثة من العصور الغابرة وتتمتع بوعي خاص وقوّة سحريّة هائلة
Dialogue: 0,0:18:14.61,0:18:18.24,Note,,0,0,0,,دولغر: طرازٌ من الدروع القتاليّة الاصطناعيّة التي تُستدعى بواسطة السحر، ويتميّز بقدراتٍ هجوميّةٍ وسرعة استجابةٍ عاليةٍ في أرض المعركة
Comment: 0,0:16:26.21,0:16:27.75,Signs,,0,0,0,,
Dialogue: 0,0:00:27.46,0:00:31.46,Signs,,0,0,0,,!غريبةٌ في فضاء الوهم
Dialogue: 0,0:04:38.00,0:04:44.01,Signs,,0,0,0,,!غريبةٌ في فضاء الوهم
Dialogue: 0,0:25:01.52,0:25:05.73,Signs,,0,0,0,,!ثنائيٌّ خارقٌ وسريعٌ كالبرق
