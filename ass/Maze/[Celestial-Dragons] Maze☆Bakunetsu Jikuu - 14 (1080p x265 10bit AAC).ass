Dialogue: 0,0:00:01.22,0:00:02.35,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:12.61,0:02:14.54,Main,,0,0,0,,!يا له من طورٍ مذهل
Dialogue: 0,0:02:14.72,0:02:17.24,Main,,0,0,0,,!لم يبالِ بحاجزنا السباعيّ حتّى
Dialogue: 0,0:02:17.49,0:02:20.16,Main,,0,0,0,,يتحوّل من الأحمر إلى الأزرق، ومن الأبيض إلى الأصفر
Dialogue: 0,0:02:20.38,0:02:22.80,Main,,0,0,0,,!تغيّره عاصفٌ للغاية ولا قِبَل لنا بمجاراته
Dialogue: 0,0:02:22.91,0:02:26.44,Main,,0,0,0,,إن استمرّ هذا، فستفنى بلادنا باروانيا أيضًا
Dialogue: 0,0:02:29.71,0:02:30.75,Main,,0,0,0,,!ميز
Dialogue: 0,0:02:30.80,0:02:31.84,Main,,0,0,0,,ميز-سان
Dialogue: 0,0:02:38.84,0:02:41.91,Main,,0,0,0,,نزول القدّيس، نهوض درع الروم
Dialogue: 0,0:03:05.15,0:03:07.52,Main,,0,0,0,,أوشك الدرع على الاكتمال تقريبًا
Dialogue: 0,0:03:08.25,0:03:09.66,Main,,0,0,0,,لكنَّ المعضلة تكمن في الطيّار
Dialogue: 0,0:03:11.00,0:03:12.08,Main,,0,0,0,,الطيّار؟
Dialogue: 0,0:03:12.51,0:03:16.76,Main,,0,0,0,,لن يُجدي الطور الاعتياديّ نفعًا لتحريك دولغر
Dialogue: 0,0:03:17.15,0:03:20.09,Main,,0,0,0,,بل لا بُدَّ أن يكون بشريًّا ذا طورٍ فائق
Dialogue: 0,0:03:20.13,0:03:21.72,Main,,0,0,0,,من سيقود دولغر إذن؟
Dialogue: 0,0:03:22.28,0:03:24.72,Main,,0,0,0,,وفق الخطّة، سأتولّى ذلك
Dialogue: 0,0:03:24.80,0:03:26.92,Main,,0,0,0,,والطيّار الّذي أنقذكم
Dialogue: 0,0:03:29.58,0:03:30.98,Main,,0,0,0,,!كايل
Dialogue: 0,0:03:33.16,0:03:36.73,Main,,0,0,0,,ما شأنكِ تجلب مدنيّين إلى موضعٍ كهذا؟
Dialogue: 0,0:03:37.12,0:03:41.42,Main,,0,0,0,,نحتاج إلى طيّارٍ يقود دولغر يا كايل
Dialogue: 0,0:03:41.72,0:03:45.64,Main,,0,0,0,,ولا خيار أمامنا سوى المراهنة على أيّ أملٍ مهما ضؤل
Dialogue: 0,0:03:45.95,0:03:49.12,Main,,0,0,0,,!ومع ذلك، أنعهد به إلى هؤلاء الغرباء المجهولين؟
Dialogue: 0,0:03:49.26,0:03:50.84,Main,,0,0,0,,!هذا أمرٌ بسيط
Dialogue: 0,0:03:51.00,0:03:53.17,Main,,0,0,0,,!فلتقُده أونيه-ني-ساما فحسب
Dialogue: 0,0:03:56.25,0:03:59.98,Main,,0,0,0,,إيّاكِ والمزاح بشأن أمرٍ كهذا أيّتها الآنسة
Dialogue: 0,0:04:00.42,0:04:01.92,Main,,0,0,0,,!لستُ أمزح
Dialogue: 0,0:04:02.06,0:04:04.47,Main,,0,0,0,,!فأونيه-ني-ساما قويّةٌ للغاية
Dialogue: 0,0:04:04.55,0:04:07.95,Main,,0,0,0,,!وأنقذتْ حياة ميل مرارًا وتكرارًا
Dialogue: 0,0:04:08.56,0:04:09.71,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:04:10.68,0:04:13.87,Main,,0,0,0,,!ستسحق أونيه-ني-ساما ذلك الـ "يو" في طرفة عين
Dialogue: 0,0:04:14.32,0:04:15.16,Main,,0,0,0,,!كفاكِ هراءً
Dialogue: 0,0:04:15.81,0:04:17.23,Main,,0,0,0,,!مهلًا، ما الّذي تفعله؟
Dialogue: 0,0:04:17.77,0:04:18.38,Main,,0,0,0,,!تنحي جانبًا
Dialogue: 0,0:04:20.70,0:04:21.96,Main,,0,0,0,,!كفّ عن هذا يا كايل
Dialogue: 0,0:04:27.78,0:04:29.10,Main,,0,0,0,,!ما الّذي تفقهونه أنتم؟
Dialogue: 0,0:04:29.68,0:04:31.88,Main,,0,0,0,,!إيّاكم والتفوّه بمثل هذا الهراء أمامي مجدّدًا
Dialogue: 0,0:04:32.00,0:04:33.08,Main,,0,0,0,,!ما كان يجدر بكَ التحدّث هكذا
Dialogue: 0,0:04:33.47,0:04:35.00,Main,,0,0,0,,!اخرج يا كايل
Dialogue: 0,0:04:38.80,0:04:41.01,Main,,0,0,0,,أعتذرُ عن فظاظته
Dialogue: 0,0:04:41.04,0:04:41.64,Main,,0,0,0,,لا عليكِ
Dialogue: 0,0:04:42.81,0:04:45.15,Main,,0,0,0,,لم يعد بيدنا حيلة
Dialogue: 0,0:04:45.51,0:04:49.26,Main,,0,0,0,,ولا ملجأ لنا لإنقاذ العالم سوى التعويل على قوّة دولغر
Dialogue: 0,0:04:51.35,0:04:53.98,Main,,0,0,0,,أرجوكما، مدّا يد العون لنا
Dialogue: 0,0:05:01.36,0:05:02.78,Main,,0,0,0,,!في وقتٍ كهذا تحديدًا
Dialogue: 0,0:05:06.82,0:05:08.99,Main,,0,0,0,,!إنّه أونيه-ني-ساما الليليّ
Dialogue: 0,0:05:13.33,0:05:15.29,Main,,0,0,0,,تحوّلٌ من امرأةٍ إلى رجل؟
Dialogue: 0,0:05:15.55,0:05:17.54,Main,,0,0,0,,أهذه قوّة الطور أيضًا؟
Dialogue: 0,0:05:18.08,0:05:21.63,Main,,0,0,0,,!حسنٌ، سأمدّكم بقوّتي وبكلّ ما تبتغون
Dialogue: 0,0:05:22.91,0:05:28.30,Main,,0,0,0,,!لكن، بالمقابل؛ طرأت في بالي أمورٌ جمّة أودّ أن تسديها لي
Dialogue: 0,0:05:28.52,0:05:31.01,Main,,0,0,0,,كأمورٍ كهذه وتلك
Dialogue: 0,0:05:31.60,0:05:33.22,Main,,0,0,0,,هلّا رافقتني؟
Dialogue: 0,0:05:33.43,0:05:35.77,Main,,0,0,0,,!بالتأكيد، سأتبعكِ إلى أيّ مكان
Dialogue: 0,0:05:46.36,0:05:49.08,Main,,0,0,0,,!ابتهج يا أونيه-ني-ساما
Dialogue: 0,0:05:49.15,0:05:51.77,Main,,0,0,0,,أشعر بالوحدة في غيابكَ يا أونيه-ني-ساما
Dialogue: 0,0:05:52.19,0:05:56.17,Main,,0,0,0,,!سحقًا، عاينوا جسدي من رأسي حتّى أخمص قدميّ
Dialogue: 0,0:05:56.20,0:05:57.72,Main,,0,0,0,,!عجزتُ عن ذرف دمعةٍ حتّى
Dialogue: 0,0:05:58.12,0:06:00.21,Main,,0,0,0,,!ابذل ما بوسعك يا أونيه-ني-ساما
Dialogue: 0,0:06:01.13,0:06:03.30,Main,,0,0,0,,معذرة، لستُ أهلًا لذلك الليلة
Dialogue: 0,0:06:27.29,0:06:30.22,Main,,0,0,0,,سامحيني يا ميل رغم قولي ذلك
Dialogue: 0,0:06:30.32,0:06:32.99,Main,,0,0,0,,فالكذب من شيم الرجال أحيانًا
Dialogue: 0,0:06:53.44,0:06:55.92,Main,,0,0,0,,!كيف تجرؤ على قتل رفاقي
Dialogue: 0,0:06:56.31,0:06:57.56,Main,,0,0,0,,!سحقًا لك
Dialogue: 0,0:07:23.71,0:07:28.63,Main,,0,0,0,,أعلم هذا، لن أستسلم لمثل هذا يا أبي
Dialogue: 0,0:07:31.96,0:07:34.25,Main,,0,0,0,,حسنٌ، ذلك أمرٌ وهذا أمرٌ آخر
Dialogue: 0,0:07:34.59,0:07:38.56,Main,,0,0,0,,...ها أنا ذا، هذه فرصتي، يتحتّم عليّ
Dialogue: 0,0:08:09.12,0:08:10.40,Main,,0,0,0,,لا بُدَّ لي من خوض هذا
Dialogue: 0,0:08:10.64,0:08:13.69,Main,,0,0,0,,من أجل الجميع... عليّ ذلك
Dialogue: 0,0:08:34.07,0:08:37.16,Main,,0,0,0,,ما الّذي أفعله؟
Dialogue: 0,0:08:38.88,0:08:42.33,Main,,0,0,0,,اخترق درع فيلٍ معادٍ القطاع E-11
Dialogue: 0,0:08:42.37,0:08:44.28,Main,,0,0,0,,تشغيل المنظومة الدفاعيّة
Dialogue: 0,0:08:44.70,0:08:47.66,Main,,0,0,0,,لتتوجّه فرقة الإغاثة فورًا إلى الموقع
Dialogue: 0,0:08:52.80,0:08:56.72,Main,,0,0,0,,!ليس هذا درع فيلٍ عاديًّا، بل أرسله يومير
Dialogue: 0,0:09:03.18,0:09:03.90,Main,,0,0,0,,!ميل-سان
Dialogue: 0,0:09:13.26,0:09:14.49,Main,,0,0,0,,!اهربا
Dialogue: 0,0:09:25.16,0:09:26.12,Main,,0,0,0,,!كايل
Dialogue: 0,0:09:29.84,0:09:31.75,Main,,0,0,0,,!ما الّذي تفعلونه؟ اهربا بسرعة
Dialogue: 0,0:09:41.14,0:09:43.29,Main,,0,0,0,,!توقّف
Dialogue: 0,0:09:50.28,0:09:53.85,Main,,0,0,0,,!طورٌ... ينبعث من جسدٍ بشريّة؟
Dialogue: 0,0:09:59.95,0:10:01.45,Main,,0,0,0,,!أفسحوا الطريق
Dialogue: 0,0:10:03.12,0:10:04.45,Main,,0,0,0,,!ليأتِ أحدٌ إلى هنا لمساعدتي
Dialogue: 0,0:10:05.69,0:10:07.67,Main,,0,0,0,,هل كايل-سان بخير؟
Dialogue: 0,0:10:08.00,0:10:10.56,Main,,0,0,0,,إنّه نائمٌ الآن، وتجاوز مرحلة الخطر
Dialogue: 0,0:10:11.38,0:10:12.81,Main,,0,0,0,,هكذا إذن
Dialogue: 0,0:10:13.23,0:10:17.71,Main,,0,0,0,,ميز-سان، ميل-سان، قودا دولغر رجاءً
Dialogue: 0,0:10:18.84,0:10:19.85,Main,,0,0,0,,...دولغر
Dialogue: 0,0:10:20.48,0:10:24.84,Main,,0,0,0,,ما دامت يد العدوّ قد بلغت هذا الموضع، فلم يعد لدينا متّسعٌ من الوقت لنضيعه
Dialogue: 0,0:10:25.20,0:10:28.17,Main,,0,0,0,,...بفضّل تلك القدرة الكامنة على إطلاق الطور بجسدكِ
Dialogue: 0,0:10:28.32,0:10:32.48,Main,,0,0,0,,فستتمكّنين حتمًا من إيقاظ قوّة دولغر بالكامل؛ بل ومضاعفتها
Dialogue: 0,0:10:32.65,0:10:34.88,Main,,0,0,0,,!معها حقٌّ يا أونيه-ني-ساما
Dialogue: 0,0:10:35.10,0:10:38.88,Main,,0,0,0,,!فلنلقّن ذلك الوغد درسًا قاسيًا ونعد إلى رفاقنا
Dialogue: 0,0:10:39.20,0:10:40.28,Main,,0,0,0,,!أرجوكِ
Dialogue: 0,0:10:40.36,0:10:41.68,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:10:43.36,0:10:46.16,Main,,0,0,0,,فهمت، سأبذل جهدي
Dialogue: 0,0:11:24.96,0:11:28.62,Main,,0,0,0,,معدّل تصاعدٍ مذهل، ستصل إلى المستوى النهائيّ عما قريب
Dialogue: 0,0:11:29.02,0:11:31.92,Main,,0,0,0,,لا تشوب الدرع أو الخاضعة للاختبار أيّ معضلة
Dialogue: 0,0:11:32.49,0:11:35.56,Main,,0,0,0,,لعلّ هذا يعود لتماثل بنية جسدها مع جسدي
Dialogue: 0,0:11:39.34,0:11:41.55,Main,,0,0,0,,!إنذار، إنذار
Dialogue: 0,0:11:41.79,0:11:45.76,Main,,0,0,0,,!يقترب جسمٌ مجهولٌ وضخم
Dialogue: 0,0:11:47.97,0:11:49.22,Main,,0,0,0,,ها قد أتى
Dialogue: 0,0:12:05.37,0:12:07.72,Main,,0,0,0,,!إنذار، إنذار
Dialogue: 0,0:12:07.79,0:12:12.25,Main,,0,0,0,,!يومير يقترب، تفصلنا عن مدى الإطلاق الفعّال 2200 نقطة
Dialogue: 0,0:12:26.25,0:12:29.18,Main,,0,0,0,,!اكسبوا مزيدًا من الوقت ولو لدقيقةٍ أو حتّى لثانية
Dialogue: 0,0:12:29.68,0:12:30.75,Main,,0,0,0,,!سنبذل قصارى جهدنا
Dialogue: 0,0:12:32.06,0:12:33.88,Main,,0,0,0,,اكتملت تهيئة ميل فارنا
Dialogue: 0,0:12:34.03,0:12:36.83,Main,,0,0,0,,يا لها من سرعة! لاح بصيصٌ من الأمل
Dialogue: 0,0:12:37.36,0:12:39.27,Main,,0,0,0,,نرجو عونكِ يا ميز-سان
Dialogue: 0,0:12:39.32,0:12:40.27,Main,,0,0,0,,حاضر
Dialogue: 0,0:12:47.16,0:12:48.06,Main,,0,0,0,,كايل-سان
Dialogue: 0,0:12:49.20,0:12:51.29,Main,,0,0,0,,أجسدكَ بخير؟
Dialogue: 0,0:12:51.75,0:12:54.04,Main,,0,0,0,,معظم جسدي آليّ
Dialogue: 0,0:12:54.49,0:12:57.25,Main,,0,0,0,,فهو جسدٌ صُنِعَ لغرض القتال فحسب
Dialogue: 0,0:12:59.17,0:13:03.59,Main,,0,0,0,,استشطتُ غيظًا حين رأيتُ ميل تعقد آمالها عليكِ
Dialogue: 0,0:13:04.19,0:13:07.18,Main,,0,0,0,,،بصفتي صديق طفولتها، عاهدتُ نفسي على الثأر لوالدها
Dialogue: 0,0:13:07.18,0:13:10.06,Main,,0,0,0,,وظللتُ متمسّكًا بهذا العهد طوال الوقت
Dialogue: 0,0:13:11.00,0:13:12.22,Main,,0,0,0,,لكنّني كنتُ مخطئًا
Dialogue: 0,0:13:12.31,0:13:15.80,Main,,0,0,0,,فنحن نقاتل في سبيل الانتصار
Dialogue: 0,0:13:16.52,0:13:17.98,Main,,0,0,0,,...كايل-سان
Dialogue: 0,0:13:18.51,0:13:22.78,Main,,0,0,0,,لا ريب في أنّكِ عبرتِ الزمن لتقودي دولغر
Dialogue: 0,0:13:23.07,0:13:26.28,Main,,0,0,0,,وتلك قوّتكِ، قوّتكِ وحدكِ
Dialogue: 0,0:13:26.89,0:13:31.55,Main,,0,0,0,,لا، لستُ جديرةً بهذا المديح أبدًا
Dialogue: 0,0:13:32.37,0:13:33.91,Main,,0,0,0,,لا تعبسي هكذا
Dialogue: 0,0:13:34.12,0:13:35.08,Main,,0,0,0,,...لكن
Dialogue: 0,0:13:35.16,0:13:40.08,Main,,0,0,0,,!كرّسنا ماضينا وحاضرنا ومستقبلنا في دولغر؛ محالٌ أن يُهزَم
Dialogue: 0,0:13:40.84,0:13:42.49,Main,,0,0,0,,أُوكل البقيّة إليكِ
Dialogue: 0,0:13:48.51,0:13:50.52,Main,,0,0,0,,واعتذري لتلك الصغيرة بالنيابة عنّي رجاءً
Dialogue: 0,0:14:14.43,0:14:15.26,Main,,0,0,0,,!أنلنا منه
Dialogue: 0,0:14:22.04,0:14:25.02,Main,,0,0,0,,!دُمّر القطاع السابع، دُمّر القطاع الرابع
Dialogue: 0,0:14:25.04,0:14:28.09,Main,,0,0,0,,!انقطع الاتصال بالقطاعات 11 و18 و20
Dialogue: 0,0:14:29.05,0:14:32.22,Main,,0,0,0,,!ألم تفلح كلّ هذه الهجمات في إعاقته حتّى؟
Dialogue: 0,0:14:32.30,0:14:34.11,Main,,0,0,0,,!ذلك الوحش
Dialogue: 0,0:14:34.56,0:14:37.52,Main,,0,0,0,,!اسحبوا القوّات الأماميّة وانشروا حاجز الأطوار
Dialogue: 0,0:14:53.41,0:14:54.66,Main,,0,0,0,,!اكتملت الاستعدادات
Dialogue: 0,0:14:54.86,0:14:56.16,Main,,0,0,0,,سنبدأ الآن يا ميز-سان
Dialogue: 0,0:14:56.62,0:14:57.40,Main,,0,0,0,,حاضر
Dialogue: 0,0:14:58.67,0:15:04.51,Main,,0,0,0,,بدء العدّ التنازليّ: خمسة، أربعة، ثلاثة، اثنان، واحد
Dialogue: 0,0:15:04.75,0:15:06.00,Main,,0,0,0,,!بدء التهيئة
Dialogue: 0,0:15:13.14,0:15:17.98,Main,,0,0,0,,...اجتزنا المستوى الأوّل! ويليه الثاني، الثالث، الرابع، الخامس
Dialogue: 0,0:15:18.39,0:15:19.77,Main,,0,0,0,,!استجابة مذهلة للأطوار
Dialogue: 0,0:15:22.60,0:15:25.94,Main,,0,0,0,,!المستوى التاسع عشر، العشرون، الحادي والعشرون
Dialogue: 0,0:15:27.18,0:15:31.95,Main,,0,0,0,,!لا بُدَّ لي من خوض هذا، من أجل الجميع، عليّ ذلك
Dialogue: 0,0:15:35.87,0:15:37.42,Main,,0,0,0,,!تبدّد الحاجز
Dialogue: 0,0:15:38.45,0:15:41.76,Main,,0,0,0,,المستوى الثالث والثلاثون، الرابع والثلاثون، الخامس والثلاثون
Dialogue: 0,0:15:42.32,0:15:43.04,Main,,0,0,0,,ما الخطب؟
Dialogue: 0,0:15:43.61,0:15:47.12,Main,,0,0,0,,!لا أدري، توقّف ارتفاع قيمة الطور فجأة
Dialogue: 0,0:15:47.36,0:15:48.42,Main,,0,0,0,,...أونيه-ني-ساما
Dialogue: 0,0:15:56.97,0:15:58.96,Main,,0,0,0,,!لِمَ؟ شارفنا على الانتهاء
Dialogue: 0,0:15:59.02,0:16:00.38,Main,,0,0,0,,!موجة الهجوم الثانية تقترب
Dialogue: 0,0:16:02.14,0:16:02.97,Main,,0,0,0,,!أهذه نهايتنا
Dialogue: 0,0:16:03.56,0:16:04.81,Main,,0,0,0,,!لا يزال لدينا خيارٌ أخير
Dialogue: 0,0:16:04.81,0:16:08.40,Main,,0,0,0,,!إن رفعناه دفعةً واحدة إلى المستوى النهائيّ فقد ننجح
Dialogue: 0,0:16:08.67,0:16:11.07,Main,,0,0,0,,!لم نجرّب أمرًا كهذا قطّ
Dialogue: 0,0:16:11.07,0:16:13.82,Main,,0,0,0,,!قد يودي هذا بحياة الخاضعة للاختبار في أسوأ الحالات
Dialogue: 0,0:16:14.20,0:16:16.37,Main,,0,0,0,,!لكن لا سبيل آخر أمامنا
Dialogue: 0,0:16:16.37,0:16:18.75,Main,,0,0,0,,!لا خيار أمامنا سوى التعويل عليها الآن أيّها المدير
Dialogue: 0,0:16:20.09,0:16:21.66,Main,,0,0,0,,!لا يسعني الموافقة على هذا
Dialogue: 0,0:16:33.05,0:16:35.68,Main,,0,0,0,,!اجتاز يومير المنطقة السابعة
Dialogue: 0,0:16:35.85,0:16:37.14,Main,,0,0,0,,!دع الأمر لي
Dialogue: 0,0:16:37.22,0:16:37.85,Main,,0,0,0,,!كايل
Dialogue: 0,0:16:47.23,0:16:48.19,Main,,0,0,0,,!ماذا؟
Dialogue: 0,0:16:56.37,0:16:57.32,Main,,0,0,0,,!كايل
Dialogue: 0,0:16:59.20,0:17:00.04,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:17:00.41,0:17:04.96,Main,,0,0,0,,!ستنجح أونيه-ني-ساما بلا شكّ
Dialogue: 0,0:17:06.71,0:17:08.81,Main,,0,0,0,,شكرًا لكِ يا ميل-تشان
Dialogue: 0,0:17:15.18,0:17:16.57,Main,,0,0,0,,!رفع الطاقة إلى الحدّ الأقصى
Dialogue: 0,0:17:24.52,0:17:27.98,Main,,0,0,0,,!مُخيف، سئمتُ من كلّ هذا
Dialogue: 0,0:17:28.31,0:17:29.79,Main,,0,0,0,,ما الّذي تفعلينه؟
Dialogue: 0,0:17:31.48,0:17:35.99,Main,,0,0,0,,!أتظنّين أنَّ البكاء سينقذ أحدًا أو يبهجه؟
Dialogue: 0,0:17:36.44,0:17:38.40,Main,,0,0,0,,!انهضي! انهضي فورًا
Dialogue: 0,0:17:38.70,0:17:40.97,Main,,0,0,0,,!لستُ مثلكَ
Dialogue: 0,0:17:42.62,0:17:44.25,Main,,0,0,0,,أعلم ذلك جيّدًا
Dialogue: 0,0:17:44.32,0:17:48.41,Main,,0,0,0,,!يتحتّم عليّ القتال من أجل ميل-تشان والجميع
Dialogue: 0,0:17:50.43,0:17:52.97,Main,,0,0,0,,!لكنّني لستُ بقوّتك
Dialogue: 0,0:17:53.21,0:17:55.96,Main,,0,0,0,,!لا أطيق تجرّع تلك المشاعر المريرة مجدّدًا
Dialogue: 0,0:18:00.80,0:18:02.62,Main,,0,0,0,,لا تعبسي هكذا
Dialogue: 0,0:18:03.87,0:18:09.00,Main,,0,0,0,,محالٌ للقوّة الّتي تكتنز ماضينا وحاضرنا ومستقبلنا أن تُهزم
Dialogue: 0,0:18:09.18,0:18:11.47,Main,,0,0,0,,وقع اختيار دولغر عليكِ
Dialogue: 0,0:18:12.56,0:18:13.50,Main,,0,0,0,,عليّ أنا؟
Dialogue: 0,0:18:24.20,0:18:25.23,Main,,0,0,0,,...دولغر
Dialogue: 0,0:18:29.82,0:18:31.71,Main,,0,0,0,,!تنبعث استجابة أطوارٍ غريبة من دولغر
Dialogue: 0,0:18:32.17,0:18:33.08,Main,,0,0,0,,!ما هذا؟
Dialogue: 0,0:18:35.34,0:18:37.67,Main,,0,0,0,,كنتَ تناديني إذن
Dialogue: 0,0:18:38.26,0:18:42.67,Main,,0,0,0,,صدقتَ، أنتَ مكمن قوّتي يا دولغر
Dialogue: 0,0:18:43.23,0:18:47.39,Main,,0,0,0,,فبفضلكَ بلغتُ هذا الموضع
Dialogue: 0,0:18:50.15,0:18:52.48,Main,,0,0,0,,!لننطلق معًا
Dialogue: 0,0:18:59.21,0:19:01.66,Main,,0,0,0,,!فعلتها! اجتازت المستوى النهائيّ
Dialogue: 0,0:19:02.11,0:19:03.47,Main,,0,0,0,,!تشغيل دولغر
Dialogue: 0,0:19:09.40,0:19:11.15,Main,,0,0,0,,أأنتِ بخير يا ميل-تشان؟
Dialogue: 0,0:19:12.21,0:19:14.88,Main,,0,0,0,,...رورو، فارنا، هاي
Dialogue: 0,0:19:15.21,0:19:16.72,Main,,0,0,0,,!أيّتها المديرة، يومير
Dialogue: 0,0:19:21.47,0:19:23.02,Main,,0,0,0,,را، فو
Dialogue: 0,0:19:27.88,0:19:28.46,Main,,0,0,0,,!اختفى
Dialogue: 0,0:19:31.52,0:19:33.69,Main,,0,0,0,,!استجابة أطوارٍ هائلة في الأجواء بالأعلى
Dialogue: 0,0:19:50.41,0:19:51.66,Main,,0,0,0,,!لن أُهزم هذه المرّة
Dialogue: 0,0:20:10.49,0:20:13.95,Main,,0,0,0,,!تماسكي أرجوكِ يا أونيه-ني-ساما
Dialogue: 0,0:20:20.51,0:20:22.17,Main,,0,0,0,,!آلمتني أيّها النذل
Dialogue: 0,0:20:22.27,0:20:27.10,Main,,0,0,0,,!كيف تجرؤ على ضرب وجه البطل؟
Dialogue: 0,0:20:30.36,0:20:33.07,Main,,0,0,0,,!تجرّع حتفك
Dialogue: 0,0:20:49.14,0:20:51.02,Main,,0,0,0,,!فعلها حقًّا
Dialogue: 0,0:21:16.76,0:21:20.76,Main,,0,0,0,,،هذا الطراز لا يُشبه أيًّا من الدروع الاصطناعيّة الّتي عثرنا عليها سابقًا
Dialogue: 0,0:21:21.17,0:21:26.22,Main,,0,0,0,,وفولنار البلاط الملكيّ على وشك الشروع بتحقيقٍ شامل
Dialogue: 0,0:21:27.59,0:21:30.31,Main,,0,0,0,,ما الخطب؟ تبدين شاردة الذهن
Dialogue: 0,0:21:31.48,0:21:33.98,Main,,0,0,0,,!مأ-معذرة، لا شيء على الإطلاق
Dialogue: 0,0:21:45.57,0:21:47.70,Main,,0,0,0,,يبدو تصرّف ميز-سان مريبًا حقًّا
Dialogue: 0,0:21:48.82,0:21:52.46,Main,,0,0,0,,!جلالتك! نُقِّبَ عن أثرٍ جديد
Dialogue: 0,0:21:52.51,0:21:53.21,Main,,0,0,0,,!ماذا؟
Dialogue: 0,0:24:11.51,0:24:15.39,Main,,0,0,0,,!أخيرًا، حانت تلك اللحظة المنشودة
Dialogue: 0,0:24:15.47,0:24:17.23,Main,,0,0,0,,!عذرًا على إطالة الانتظار يا رفاق
Dialogue: 0,0:24:17.47,0:24:20.35,Main,,0,0,0,,سنخوض تلك القصة في الحلقة القادمة أخيرًا
Dialogue: 0,0:24:20.48,0:24:23.10,Main,,0,0,0,,!وتصدّرت المركز الأوّل في بطاقات طلبات المتابعين باكتساح
Dialogue: 0,0:24:23.10,0:24:24.19,Main,,0,0,0,,!مشاهدتها واجبةٌ عليكم
Dialogue: 0,0:24:24.27,0:24:26.48,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:26.86,0:24:29.61,Main,,0,0,0,,الحدث المُرتقب، ينابيع الحبّ الساخنة
Dialogue: 0,0:24:30.81,0:24:33.49,Main,,0,0,0,,لكنّها قصةٌ لن يظهر فيها الفتيان
Dialogue: 0,0:24:34.04,0:24:36.25,Main,,0,0,0,,!ما حدث مرّتين سيتكرّر للمرّة الثالثة
Comment: 0,0:24:36.25,0:24:38.25,Signs,,0,0,0,,
Dialogue: 0,0:02:38.84,0:02:44.89,Signs,,0,0,0,,نزول القدّيس، نهوض درع الروم
Dialogue: 0,0:24:33.66,0:24:37.62,Signs,,0,0,0,,الحدث المُرتقب، ينابيع الحبّ الساخنة
