Dialogue: 0,0:00:01.34,0:00:02.31,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:15.53,0:02:19.28,Main,,0,0,0,,أيُّ لغزٍ يتوارى خلف قناع الملك الجديد يا ترى؟
Dialogue: 0,0:02:19.32,0:02:21.15,Main,,0,0,0,,!اقرؤوا هذا العدد وستعرفون فورًا
Dialogue: 0,0:02:22.00,0:02:24.94,Main,,0,0,0,,ما خطب هذه الجلبة يا ترى؟
Dialogue: 0,0:02:25.44,0:02:28.14,Main,,0,0,0,,،سمعتُ عن إقامة احتفالٍ
Dialogue: 0,0:02:28.21,0:02:30.78,Main,,0,0,0,,...بمناسبة اعتلاء الملك فارماونت العرش
Dialogue: 0,0:02:31.90,0:02:33.74,Main,,0,0,0,,!لكن لم أتوقّع كلّ هذا الزحام أبدًا
Dialogue: 0,0:02:34.49,0:02:36.55,Main,,0,0,0,,!من هنا يا أونيه-ني-ساما
Dialogue: 0,0:02:36.99,0:02:38.97,Main,,0,0,0,,!هيّا، أسرعي، أسرعي
Dialogue: 0,0:02:39.19,0:02:40.22,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:02:40.65,0:02:44.01,Main,,0,0,0,,!انتظري رجاءً يا ميل-ساما، يا ميل-ساما
Dialogue: 0,0:02:48.91,0:02:50.92,Main,,0,0,0,,احذروا من اللعوب الوسيم
Dialogue: 0,0:03:02.85,0:03:05.32,Main,,0,0,0,,!جلالتك، أودُّ الحديث معك
Dialogue: 0,0:03:17.59,0:03:19.22,Main,,0,0,0,,!خرجنا أخيرًا
Dialogue: 0,0:03:19.60,0:03:22.43,Main,,0,0,0,,عجبًا، أين سوليود-سان والآخرون يا ترى؟
Dialogue: 0,0:03:22.50,0:03:25.84,Main,,0,0,0,,!لا بُدَّ أنّنا افترقنا وسط هذا الحشد
Dialogue: 0,0:03:27.32,0:03:29.07,Main,,0,0,0,,!مؤلم، مؤلم
Dialogue: 0,0:03:29.34,0:03:31.74,Main,,0,0,0,,أعتذر، أأنتَ بخير؟
Dialogue: 0,0:03:31.87,0:03:33.43,Main,,0,0,0,,ما خطبك؟
Dialogue: 0,0:03:33.51,0:03:35.91,Main,,0,0,0,,!أشعر بألمٍ شديد يا أخي
Dialogue: 0,0:03:36.08,0:03:38.88,Main,,0,0,0,,!يبدو أنَّ عظامه كُسرتْ يا أخي
Dialogue: 0,0:03:38.95,0:03:39.94,Main,,0,0,0,,!لا يُعقل
Dialogue: 0,0:03:40.27,0:03:42.46,Main,,0,0,0,,!سمعتِ ما قاله أيّتها الفتاة
Dialogue: 0,0:03:42.65,0:03:44.28,Main,,0,0,0,,!تسببتِ في مصيبةٍ حقيقيّة
Dialogue: 0,0:03:44.65,0:03:47.20,Main,,0,0,0,,!لم تقترف ميل أيَّ خطأ
Dialogue: 0,0:03:47.93,0:03:50.54,Main,,0,0,0,,!هو من اصطدم بي من تلقاء نفسه
Dialogue: 0,0:03:50.69,0:03:52.09,Main,,0,0,0,,!ما الّذي قلتِه للتّو؟
Dialogue: 0,0:03:53.04,0:03:54.35,Main,,0,0,0,,!سحقًا لكِ، تعالي إلى هنا
Dialogue: 0,0:03:57.05,0:03:58.79,Main,,0,0,0,,!توقّفوا رجاءً
Dialogue: 0,0:03:59.58,0:04:01.68,Main,,0,0,0,,!تعالي إلى هنا
Dialogue: 0,0:04:02.30,0:04:04.47,Main,,0,0,0,,!كلّا، أطلق سراحي
Dialogue: 0,0:04:05.10,0:04:05.80,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:04:06.14,0:04:09.63,Main,,0,0,0,,!الأجدر بكِ القلق على نفسكِ بدلًا من غيركِ
Dialogue: 0,0:04:12.98,0:04:14.08,Main,,0,0,0,,!كُفّوا عن هذا في الحال
Dialogue: 0,0:04:14.58,0:04:15.31,Main,,0,0,0,,!من هناك؟
Dialogue: 0,0:04:15.39,0:04:16.57,Main,,0,0,0,,!أين تختبئ أيّها الوغد؟
Dialogue: 0,0:04:18.82,0:04:19.57,Main,,0,0,0,,!هناك
Dialogue: 0,0:04:22.83,0:04:25.69,Main,,0,0,0,,!أتتجمّعون للاعتداء على النساء والأطفال والتبلّي عليهم؟
Dialogue: 0,0:04:25.76,0:04:27.35,Main,,0,0,0,,!ما الّذي يدور في خلدكم بحقّ؟
Dialogue: 0,0:04:28.33,0:04:33.53,Main,,0,0,0,,!حتّى وإن غفرتِ السماء لأوغادٍ أمثالكم، فلن أغفر لكم أبدًا
Dialogue: 0,0:04:36.89,0:04:38.73,Main,,0,0,0,,!سأتولّى تأديبكم جميعًا دفعةً واحدة
Dialogue: 0,0:04:38.78,0:04:39.94,Main,,0,0,0,,!استعدّوا
Dialogue: 0,0:04:47.02,0:04:47.88,Main,,0,0,0,,!اغربوا عن وجهي
Dialogue: 0,0:04:48.01,0:04:49.35,Main,,0,0,0,,!لن تخطئكم ضربتي في المرّة القادمة
Dialogue: 0,0:04:50.39,0:04:51.48,Main,,0,0,0,,!ستدفعين الثمن غاليًا
Dialogue: 0,0:04:57.06,0:04:58.49,Main,,0,0,0,,!سُرقتِ الأضواء منّي تمامًا
Dialogue: 0,0:04:58.52,0:05:00.54,Main,,0,0,0,,!لم أتوقّع وجود فارسةٍ بهذه القوّة
Dialogue: 0,0:05:00.62,0:05:01.84,Main,,0,0,0,,من أنت؟
Dialogue: 0,0:05:02.36,0:05:03.24,Main,,0,0,0,,أنا؟
Dialogue: 0,0:05:03.66,0:05:06.60,Main,,0,0,0,,!أُدعى غولد، مجرّد لعوبٍ متواضع
Dialogue: 0,0:05:06.65,0:05:07.46,Main,,0,0,0,,!سُررتُ بمعرفتكم
Dialogue: 0,0:05:10.22,0:05:13.37,Main,,0,0,0,,!ثيابكَ هذه بهرجةٌ محضة ولا تدلُّ على التواضع البتّة
Dialogue: 0,0:05:14.84,0:05:17.40,Main,,0,0,0,,!هذا المظهر يُمثّل أسلوبي الخاص
Dialogue: 0,0:05:17.50,0:05:18.54,Main,,0,0,0,,!فلا تشغلوا بالكم به
Dialogue: 0,0:05:19.45,0:05:20.77,Main,,0,0,0,,!يا له من رجلٍ مستهتر
Dialogue: 0,0:05:23.39,0:05:27.00,Main,,0,0,0,,!لا نملك وقتًا نضيعه مع أمثاله يا ميل-ساما
Dialogue: 0,0:05:27.13,0:05:29.55,Main,,0,0,0,,!يتحتّم علينا البحث عن وولد والآخرين على وجه السرعة
Dialogue: 0,0:05:29.55,0:05:32.27,Main,,0,0,0,,ماذا؟ أتبحثون عن شخصٍ ما؟
Dialogue: 0,0:05:32.88,0:05:34.81,Main,,0,0,0,,!حسنٌ، دعوا الأمر عليّ
Dialogue: 0,0:05:35.12,0:05:36.69,Main,,0,0,0,,!سأساعدكم في البحث عنه
Dialogue: 0,0:05:37.07,0:05:39.23,Main,,0,0,0,,ما رأيكِ؟
Dialogue: 0,0:05:41.10,0:05:43.83,Main,,0,0,0,,!يا لكَ من رجلٍ لجوجٍ ومُتطفّل
Dialogue: 0,0:05:43.91,0:05:45.42,Main,,0,0,0,,!لا تقولي هذا
Dialogue: 0,0:05:45.48,0:05:49.53,Main,,0,0,0,,!ففي هذه الأيام العصيبة، يُعدُّ تجوّل الفتيات بمفردهنّ أمرًا في غاية الخطورة
Dialogue: 0,0:05:49.78,0:05:50.75,Main,,0,0,0,,أيامٌ عصيبة؟
Dialogue: 0,0:05:50.81,0:05:51.91,Main,,0,0,0,,!مرحبًا
Dialogue: 0,0:05:52.35,0:05:54.92,Main,,0,0,0,,!أهلًا بكَ يا غولد-سان
Dialogue: 0,0:05:54.92,0:05:56.68,Main,,0,0,0,,!تبدين فاتنةً كعادتكِ اليوم
Dialogue: 0,0:05:56.75,0:05:57.88,Main,,0,0,0,,!تأخّرتَ كثيرًا
Dialogue: 0,0:05:57.90,0:05:59.61,Main,,0,0,0,,!أين كنتَ تتسكّع طوال هذا الوقت؟
Dialogue: 0,0:05:59.66,0:06:02.55,Main,,0,0,0,,عجبًا! ما سرُّ كلّ هؤلاء الفتيات الفاتنات برفقتكَ اليوم؟
Dialogue: 0,0:06:04.54,0:06:05.87,Main,,0,0,0,,!لا تحسدوني هكذا
Dialogue: 0,0:06:05.96,0:06:08.03,Main,,0,0,0,,!على أيّ حالٍ، ستهجره جميعهنّ غدًا
Dialogue: 0,0:06:08.14,0:06:09.97,Main,,0,0,0,,ما بالكم تقسون عليَّ هكذا؟
Dialogue: 0,0:06:10.60,0:06:11.76,Main,,0,0,0,,!محقّةٌ في ذلك
Dialogue: 0,0:06:11.83,0:06:12.70,Main,,0,0,0,,!صحيح، تذكّرت
Dialogue: 0,0:06:12.97,0:06:15.11,Main,,0,0,0,,!أودُّ أن أسألكم جميعًا عن أمرٍ ما
Dialogue: 0,0:06:15.67,0:06:18.53,Main,,0,0,0,,!يبدو أنَّ غولد-سان يحظى بشعبيّةٍ غير متوقّعة
Dialogue: 0,0:06:19.12,0:06:20.36,Main,,0,0,0,,!بل مستهترٌ ليس إلّا
Dialogue: 0,0:06:20.51,0:06:23.78,Main,,0,0,0,,...الأفضل ألّا نعوّل على رجلٍ كهذا يا ميل-ساما
Dialogue: 0,0:06:24.28,0:06:25.23,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:06:26.78,0:06:28.68,Main,,0,0,0,,!ميل في سعادةٍ غامرة
Dialogue: 0,0:06:30.95,0:06:32.58,Main,,0,0,0,,!متى طلبتِ هذا يا ميل-ساما؟
Dialogue: 0,0:06:33.13,0:06:36.89,Main,,0,0,0,,...مع أنّنا جئنا للبحث عن سوليود-سان والآخرين
Dialogue: 0,0:06:37.13,0:06:41.09,Main,,0,0,0,,!حسنٌ، لا يسع المرء فِعل شيءٍ ومعدته خاوية
Dialogue: 0,0:06:41.37,0:06:43.92,Main,,0,0,0,,هلّا تذوّقتِ واحدةً يا ميز-سان؟
Dialogue: 0,0:06:50.24,0:06:51.59,Main,,0,0,0,,!ما هذه الرائحة الكريهة؟
Dialogue: 0,0:06:52.68,0:06:55.02,Main,,0,0,0,,!كيف تستسيغين أكل شيءٍ كهذا؟
Dialogue: 0,0:06:55.71,0:06:59.58,Main,,0,0,0,,!ثمار الغيدوريا هذه هي المفضّلة لدى بني جنسنا من الجنيّات
Dialogue: 0,0:06:59.65,0:07:02.48,Main,,0,0,0,,!ومن يتذوّقها مرّةً لا يقوى على مقاومتها أبدًا
Dialogue: 0,0:07:04.15,0:07:08.11,Main,,0,0,0,,!ما بيدنا حيلة، سننتظر حتّى تفرغ ميل-تشان من تناول طعامها
Dialogue: 0,0:07:11.76,0:07:14.73,Main,,0,0,0,,،زعمتَ قبل قليلٍ أنَّ الأيام عصيبة يا غولد
Dialogue: 0,0:07:14.80,0:07:16.95,Main,,0,0,0,,!لكنّ المدينة تبدو في غاية الهدوء والسكينة كما أرى
Dialogue: 0,0:07:17.60,0:07:21.88,Main,,0,0,0,,ما وجه الخطر والملك الجديد اعتلى العرش للتّو؟
Dialogue: 0,0:07:22.48,0:07:25.47,Main,,0,0,0,,!تكمن المشكلة في كون الملك رجلًا غريب الأطوار
Dialogue: 0,0:07:25.68,0:07:30.67,Main,,0,0,0,,!ملكٌ يلفّه الغموض، يضع قناعًا ليلًا نهارًا ولا يُري وجهه الحقيقيّ لأحد
Dialogue: 0,0:07:31.18,0:07:33.55,Main,,0,0,0,,!ذاك هو الملك المقنّع؛ فارماونت
Dialogue: 0,0:07:33.68,0:07:34.84,Main,,0,0,0,,الملك المقنّع؟
Dialogue: 0,0:07:36.69,0:07:39.18,Main,,0,0,0,,الملك المقنّع؟
Dialogue: 0,0:07:41.48,0:07:44.72,Main,,0,0,0,,!ولا يظهر أمام العامة إلّا في أضيق الحدود ولأمرٍ جلل
Dialogue: 0,0:07:45.18,0:07:49.36,Main,,0,0,0,,!ولذا، وجد بعض الحمقى في ذلك فرصةً لتدبير انقلاب
Dialogue: 0,0:07:50.00,0:07:51.19,Main,,0,0,0,,!انقلاب؟
Dialogue: 0,0:07:51.93,0:07:55.84,Main,,0,0,0,,!أجل، يتزعّم ذلك وغدٌ يُدعى دين مارش؛ وزير الخزانة
Dialogue: 0,0:07:55.91,0:07:58.41,Main,,0,0,0,,!وهو رجلٌ متأصلٌ في الشر
Dialogue: 0,0:07:58.64,0:08:02.75,Main,,0,0,0,,!واستغلاله لمنصبه لملء جيوبه وسلب الأموال أمرٌ ذائع الصيت
Dialogue: 0,0:08:03.05,0:08:04.16,Main,,0,0,0,,!يا له من أمرٍ شائن
Dialogue: 0,0:08:04.35,0:08:07.67,Main,,0,0,0,,!ما دامت جرائمه مكشوفةً هكذا، فلِمَ تتركونه طليقًا بلا عقاب؟
Dialogue: 0,0:08:08.33,0:08:12.49,Main,,0,0,0,,!لأنّه بارعٌ في التملّص وإخفاء أثره، ولا يدع أحدًا يُمسك عليه دليلًا
Dialogue: 0,0:08:12.69,0:08:14.82,Main,,0,0,0,,!لا أدري حقًّا ما السبيل للتعامل معه
Dialogue: 0,0:08:15.89,0:08:16.85,Main,,0,0,0,,...وعلاوةً على ذلك
Dialogue: 0,0:08:19.96,0:08:24.62,Main,,0,0,0,,!تدور شائعاتٌ عن ضلوع طائفة جاينا المقدّسة في هذه المؤامرة
Dialogue: 0,0:08:24.83,0:08:25.42,Main,,0,0,0,,!ماذا؟
Dialogue: 0,0:08:26.01,0:08:27.76,Main,,0,0,0,,!طائفة جاينا متورّطةٌ هنا أيضًا إذن
Dialogue: 0,0:08:28.74,0:08:31.26,Main,,0,0,0,,!تُرى ما الّذي يُدبّره هؤلاء الأوغاد؟
Dialogue: 0,0:08:57.73,0:08:59.33,Main,,0,0,0,,!سيّدي دين مارش
Dialogue: 0,0:08:59.44,0:09:00.42,Main,,0,0,0,,ما الأمر؟
Dialogue: 0,0:09:00.50,0:09:02.44,Main,,0,0,0,,!تواصلتُ مع أولئك الأشخاص كما أردت
Dialogue: 0,0:09:02.50,0:09:03.29,Main,,0,0,0,,!هكذا إذن
Dialogue: 0,0:09:03.45,0:09:04.64,Main,,0,0,0,,!امضِ في تنفيذ الخطة كما رُسِم لها
Dialogue: 0,0:09:04.84,0:09:05.94,Main,,0,0,0,,!وإيّاكَ أن ترتكب أيَّ هفوة
Dialogue: 0,0:09:06.01,0:09:06.90,Main,,0,0,0,,!حاضر
Dialogue: 0,0:09:07.11,0:09:10.98,Main,,0,0,0,,...بوتشومكين-دونو، لم يتبقَّ سوى القليل
Dialogue: 0,0:09:13.08,0:09:14.86,Main,,0,0,0,,!ما الّذي تقصده يا بوتشومكين؟
Dialogue: 0,0:09:15.05,0:09:17.04,Main,,0,0,0,,!سأكرّر قولي مجدّدًا ومجدّدًا
Dialogue: 0,0:09:17.12,0:09:21.74,Main,,0,0,0,,!فوّضني سيادة الزعيم بالولاية الكاملة على شؤون بالانيا
Dialogue: 0,0:09:22.62,0:09:24.46,Main,,0,0,0,,!لا حاجة لي بتدخّلكم غير المجدي
Dialogue: 0,0:09:24.96,0:09:28.42,Main,,0,0,0,,!أتعتزم رفض عوننا يا بوتشومكين؟
Dialogue: 0,0:09:28.80,0:09:35.50,Main,,0,0,0,,!فأنتم من عجزتم عن التعامل مع فتاتين صغيرتين، لن تكونوا سوى عبءٍ يعرقل مسعاي
Dialogue: 0,0:09:35.97,0:09:38.94,Main,,0,0,0,,!الزموا الهدوء وشاهدوا براعة أسلوبي
Dialogue: 0,0:09:41.64,0:09:43.34,Main,,0,0,0,,!ميز خصمٌ لا يُستهان به
Dialogue: 0,0:09:44.48,0:09:47.21,Main,,0,0,0,,!مع احترامي، لكنّكَ لستَ ندًّا لها
Dialogue: 0,0:09:52.82,0:09:54.24,Main,,0,0,0,,!وغد
Dialogue: 0,0:09:54.68,0:09:57.04,Main,,0,0,0,,!خطّتي محكمةٌ ولا تشوبها شائبة
Dialogue: 0,0:09:57.53,0:10:00.35,Main,,0,0,0,,!أنتظرُ منك الأخبار السارّة يا دين مارش
Dialogue: 0,0:10:12.34,0:10:15.09,Main,,0,0,0,,أين وجهتنا التالية يا غولد-سان؟
Dialogue: 0,0:10:15.64,0:10:18.03,Main,,0,0,0,,!سترون ذلك حين نصل
Dialogue: 0,0:10:20.04,0:10:24.11,Main,,0,0,0,,!ما دامت هذه الثمار بحوزتي، فلن أبالي بالمكان الّذي سنقصده
Dialogue: 0,0:10:24.86,0:10:26.99,Main,,0,0,0,,!حسنٌ، ها قد وصلنا
Dialogue: 0,0:10:29.18,0:10:30.99,Main,,0,0,0,,إلى هنا؟
Dialogue: 0,0:10:34.63,0:10:35.80,Main,,0,0,0,,!أنتم أوغادُ المرّة السابقة
Dialogue: 0,0:10:36.00,0:10:37.78,Main,,0,0,0,,!ما خطبكم؟
Dialogue: 0,0:10:38.03,0:10:40.44,Main,,0,0,0,,!أحسنتَ صنعًا يا غولد
Dialogue: 0,0:10:40.62,0:10:42.25,Main,,0,0,0,,!حاضر
Dialogue: 0,0:10:42.44,0:10:44.34,Main,,0,0,0,,!ما معنى هذا يا غولد-سان؟
Dialogue: 0,0:10:44.54,0:10:47.70,Main,,0,0,0,,!اعذروني، فلديَّ أسبابي الخاصة
Dialogue: 0,0:10:47.78,0:10:52.04,Main,,0,0,0,,،كانت الخطّة تقضي بأن يُنقذكم منّا ليكسب ثقتكم
Dialogue: 0,0:10:52.11,0:10:54.14,Main,,0,0,0,,!لكنَّ النتيجة جاءت على ما يُرام في النهاية
Dialogue: 0,0:10:54.72,0:10:57.30,Main,,0,0,0,,!أكنتم متواطئين معًا مُنذ البداية؟
Dialogue: 0,0:10:57.72,0:11:02.41,Main,,0,0,0,,،وقعتم في الفخ وسرتم خلف محتالٍ قادكم إلى زقاقٍ مهجورٍ كهذا
Dialogue: 0,0:11:03.07,0:11:05.95,Main,,0,0,0,,كم أنتم سُذّجٌ، أليس كذلك يا غولد؟
Dialogue: 0,0:11:07.24,0:11:08.71,Main,,0,0,0,,!هذا صحيحٌ تمامًا
Dialogue: 0,0:11:08.73,0:11:10.31,Main,,0,0,0,,!لكن لِمَ تفعلون هذا؟
Dialogue: 0,0:11:11.33,0:11:13.76,Main,,0,0,0,,!أتحسبون أنّي سأدعكم تفعلون ما يحلو لكم؟
Dialogue: 0,0:11:18.07,0:11:19.88,Main,,0,0,0,,!كنّا نتوقّع منكِ ذلك أيضًا
Dialogue: 0,0:11:20.00,0:11:21.98,Main,,0,0,0,,!فلن نسمح لكِ بهزيمتنا مرّتين
Dialogue: 0,0:11:24.41,0:11:25.71,Main,,0,0,0,,!ما هذا؟
Dialogue: 0,0:11:26.12,0:11:27.40,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:11:27.85,0:11:28.87,Main,,0,0,0,,!ميل-ساما
Dialogue: 0,0:11:29.75,0:11:31.62,Main,,0,0,0,,...ما الأمر؟ ينتابني نعاسٌ شديدٌ فجأة
Dialogue: 0,0:11:36.94,0:11:39.85,Main,,0,0,0,,غولد-سان... لِمَ فعلتَ هذا؟
Dialogue: 0,0:11:57.11,0:11:59.71,Main,,0,0,0,,أين أنا؟
Dialogue: 0,0:12:02.99,0:12:04.25,Main,,0,0,0,,...ميز الفتى
Dialogue: 0,0:12:05.45,0:12:07.87,Main,,0,0,0,,ماذا؟ ما الخطب؟
Dialogue: 0,0:12:12.73,0:12:13.58,Main,,0,0,0,,!تمهّل
Dialogue: 0,0:12:14.11,0:12:15.39,Main,,0,0,0,,!ما الّذي يجري؟
Dialogue: 0,0:12:17.47,0:12:19.79,Main,,0,0,0,,!مهلًا يا ميز الفتى
Dialogue: 0,0:12:20.06,0:12:21.30,Main,,0,0,0,,!أجبني على الأقل
Dialogue: 0,0:12:22.97,0:12:26.13,Main,,0,0,0,,!مهلًا، ألا تسمعني؟
Dialogue: 0,0:12:29.74,0:12:31.00,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:12:31.12,0:12:32.40,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:12:36.91,0:12:37.90,Main,,0,0,0,,أين نحن؟
Dialogue: 0,0:12:39.36,0:12:40.57,Main,,0,0,0,,أاستيقظتما؟
Dialogue: 0,0:12:42.03,0:12:43.18,Main,,0,0,0,,!أنتم؟
Dialogue: 0,0:12:46.66,0:12:49.50,Main,,0,0,0,,!ما الّذي تنوون فعله بنا بعد أن جلبتمونا إلى هنا؟
Dialogue: 0,0:12:49.79,0:12:51.24,Main,,0,0,0,,...لا يُعقل
Dialogue: 0,0:12:51.53,0:12:54.19,Main,,0,0,0,,!لا بأس بهذا، لا بأس بهذا
Dialogue: 0,0:12:54.19,0:12:56.04,Main,,0,0,0,,!لنستمتع قليلًا
Dialogue: 0,0:12:58.27,0:13:00.06,Main,,0,0,0,,!أتنويان فعل أمرٍ فاحشٍ كهذا؟
Dialogue: 0,0:13:00.40,0:13:01.20,Main,,0,0,0,,!يا لكما من دنيئين وقحين
Dialogue: 0,0:13:01.93,0:13:02.91,Main,,0,0,0,,!كلّا، ليس الأمر كذلك
Dialogue: 0,0:13:03.00,0:13:05.39,Main,,0,0,0,,!لا نعتزم التمادي إلى هذا الحدّ
Dialogue: 0,0:13:05.41,0:13:07.47,Main,,0,0,0,,!نُقسم لكما، نحن صادقون حقًّا
Dialogue: 0,0:13:08.04,0:13:09.62,Main,,0,0,0,,!ما شأن كلّ هذه الجلبة؟
Dialogue: 0,0:13:09.93,0:13:11.89,Main,,0,0,0,,!المعذرة منكَ يا سيّدي
Dialogue: 0,0:13:13.86,0:13:15.85,Main,,0,0,0,,أنتِ المدعوّة ميز إذن
Dialogue: 0,0:13:16.73,0:13:17.27,Main,,0,0,0,,من تكون؟
Dialogue: 0,0:13:17.86,0:13:21.55,Main,,0,0,0,,!هذا السيّد المبجّل دين مارش؛ وزير الخزانة
Dialogue: 0,0:13:21.55,0:13:22.70,Main,,0,0,0,,!أنت
Dialogue: 0,0:13:22.70,0:13:26.17,Main,,0,0,0,,،ثمّة شخصيّةٌ رفيعة تبتغي رؤيتكم
Dialogue: 0,0:13:26.37,0:13:28.72,Main,,0,0,0,,!ولذا أمرتُ رجالي بإحضاركم إلى هنا
Dialogue: 0,0:13:28.94,0:13:30.10,Main,,0,0,0,,شخصيّةٌ رفيعة؟
Dialogue: 0,0:13:30.43,0:13:33.47,Main,,0,0,0,,!ميز-سان، لا بُدَّ أنَّ للأمر صلةً بطائفة جاينا
Dialogue: 0,0:13:33.58,0:13:34.67,Main,,0,0,0,,!ماذا قلتِ؟
Dialogue: 0,0:13:35.24,0:13:38.28,Main,,0,0,0,,!ما الشرُّ الّذي تُدبّرونه بالتواطؤ مع جاينا؟
Dialogue: 0,0:13:38.38,0:13:39.92,Main,,0,0,0,,!لا حاجة لكِ بمعرفة ذلك
Dialogue: 0,0:13:40.62,0:13:43.95,Main,,0,0,0,,!ما عليكم سوى الانصياع لأوامرنا بطاعة
Dialogue: 0,0:13:45.15,0:13:46.51,Main,,0,0,0,,!لن يحدث هذا أبدًا
Dialogue: 0,0:13:46.79,0:13:50.00,Main,,0,0,0,,...رورو، بيسميا، لا، أغوني، بيرو
Dialogue: 0,0:13:53.73,0:13:55.58,Main,,0,0,0,,مُحال، لِمَ لم يحدث شيء؟
Dialogue: 0,0:13:55.98,0:13:58.90,Main,,0,0,0,,...رورو، بيسميا، لا، أغوني، بيرو
Dialogue: 0,0:14:01.64,0:14:02.70,Main,,0,0,0,,ما الخطب؟
Dialogue: 0,0:14:03.21,0:14:04.12,Main,,0,0,0,,!لا أدري
Dialogue: 0,0:14:04.12,0:14:06.80,Main,,0,0,0,,!لكن لِمَ لا يسعني استدعاء طوري؟
Dialogue: 0,0:14:08.81,0:14:10.19,Main,,0,0,0,,!يا لسوء حظّكِ
Dialogue: 0,0:14:10.38,0:14:15.00,Main,,0,0,0,,!خُلِطت قنبلة الدخان السابقة بعقارٍ سريٍّ كابحٍ للأطوار
Dialogue: 0,0:14:15.48,0:14:16.96,Main,,0,0,0,,...مُحال، هذا يعني
Dialogue: 0,0:14:17.32,0:14:21.22,Main,,0,0,0,,!ودون طوركِ، لستِ سوى فتاةٍ عاجزةٍ وضعيفة
Dialogue: 0,0:14:21.29,0:14:22.49,Main,,0,0,0,,!هل أدركتِ حجم ضعفكِ الآن؟
Dialogue: 0,0:14:22.56,0:14:24.89,Main,,0,0,0,,!تجرّعي مرارة عجزكِ
Dialogue: 0,0:14:27.93,0:14:29.09,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:14:31.77,0:14:34.00,Main,,0,0,0,,!لا تقلقي يا ميل-تشان
Dialogue: 0,0:14:34.07,0:14:38.27,Main,,0,0,0,,!حتّى لو عجزتُ عن استدعاء طوري، فسأحميكِ حتمًا
Dialogue: 0,0:14:39.94,0:14:41.45,Main,,0,0,0,,!يا للمفارقة المضحكة
Dialogue: 0,0:14:41.53,0:14:44.14,Main,,0,0,0,,!وما عساكِ أن تفعلي لها بحالكِ البائسة هذه؟
Dialogue: 0,0:14:44.21,0:14:46.78,Main,,0,0,0,,!تجاوز ادّعاؤكِ للشجاعة حدّه ليغدو مثيرًا للشفقة
Dialogue: 0,0:14:46.86,0:14:48.11,Main,,0,0,0,,!بل يبعث على الرثاء
Dialogue: 0,0:14:50.45,0:14:54.11,Main,,0,0,0,,!انقلوا هؤلاء إلى قصري، وتوخّوا الحذر الشديد
Dialogue: 0,0:15:02.73,0:15:06.57,Main,,0,0,0,,أونيه-ني-ساما، ما الّذي سيحلُّ بنا الآن؟
Dialogue: 0,0:15:06.99,0:15:08.64,Main,,0,0,0,,!لا تقلقي يا ميل-تشان
Dialogue: 0,0:15:08.91,0:15:10.73,Main,,0,0,0,,!سننجو من هذه المحنة قريبًا
Dialogue: 0,0:15:11.24,0:15:15.18,Main,,0,0,0,,!أجل، ذلك الوغد سينقذنا حتمًا
Dialogue: 0,0:15:20.15,0:15:22.62,Main,,0,0,0,,!ظهر أونيه-ني-ساما الفتى أخيرًا، كنتُ بانتظارك
Dialogue: 0,0:15:23.90,0:15:26.68,Main,,0,0,0,,...ميل-تشان، ليس الوقت مناسبًا لهذا
Dialogue: 0,0:15:26.70,0:15:28.56,Main,,0,0,0,,مهلًا، ما هذا؟
Dialogue: 0,0:15:28.92,0:15:30.52,Main,,0,0,0,,!مستحيل، لِمَ حدث هذا؟
Dialogue: 0,0:15:30.60,0:15:32.76,Main,,0,0,0,,!لِمَ لم يتغيّر كياني الداخليّ؟
Dialogue: 0,0:15:36.33,0:15:38.65,Main,,0,0,0,,!كُفّ عن إصدار هذا الصوت المقزّز
Dialogue: 0,0:15:38.67,0:15:41.19,Main,,0,0,0,,!لا يمكنني تصديق ما يحدث
Dialogue: 0,0:15:42.76,0:15:45.34,Main,,0,0,0,,!تبدو وكأنّكَ تتحدّث كفتاة يا أونيه-ني-ساما
Dialogue: 0,0:15:46.27,0:15:49.07,Main,,0,0,0,,!لستُ كفتاة، بل أنا فتاةٌ بالفعل
Dialogue: 0,0:15:49.14,0:15:53.44,Main,,0,0,0,,!تحوّل جسدي إلى فتى، لكن روحي بقيت أنثى
Dialogue: 0,0:15:54.95,0:15:56.82,Main,,0,0,0,,...الفتى صار فتاة
Dialogue: 0,0:15:56.89,0:16:00.30,Main,,0,0,0,,...وأونيه-ني-ساما يبقى أونيه-ني-ساما
Dialogue: 0,0:16:00.82,0:16:04.12,Main,,0,0,0,,!اسمع يا ميز الفتى، اخرج في الحال
Dialogue: 0,0:16:04.19,0:16:06.79,Main,,0,0,0,,!ميز الفتى، ألا تسمع ما أقوله؟
Dialogue: 0,0:16:08.20,0:16:09.56,Main,,0,0,0,,...لا يُعقل
Dialogue: 0,0:16:18.04,0:16:21.01,Main,,0,0,0,,!لا يسعني ولا يسع ميز-سان استخدام الطور
Dialogue: 0,0:16:21.08,0:16:23.00,Main,,0,0,0,,!نعتمد عليكِ يا رايبير-سان
Dialogue: 0,0:16:23.16,0:16:24.48,Main,,0,0,0,,...انتبهي لغيابنا رجاءً
Dialogue: 0,0:16:39.23,0:16:43.39,Main,,0,0,0,,!لا أصدّق أنّني تجشّمتُ عناء عبور ثلاثة جبال من أجل هذا الدواء
Dialogue: 0,0:16:44.23,0:16:48.26,Main,,0,0,0,,...لكن بمجرّد تسليمه له، سأكون أنا وهو
Dialogue: 0,0:16:48.60,0:16:50.26,Main,,0,0,0,,"!أحسنتِ صنعًا يا رانتشيكي"
Dialogue: 0,0:16:50.34,0:16:51.86,Main,,0,0,0,,"!لا شكر على واجب"
Dialogue: 0,0:16:51.94,0:16:53.53,Main,,0,0,0,,"!أحبّكِ! هلّا تزوّجتِ بي؟"
Dialogue: 0,0:16:53.61,0:16:55.10,Main,,0,0,0,,"!بكلِّ سرور"
Dialogue: 0,0:16:55.18,0:16:56.58,Main,,0,0,0,,"!رانتشيكي"
Dialogue: 0,0:16:56.65,0:16:58.14,Main,,0,0,0,,"!مهلًا، هذا مُخجل"
Dialogue: 0,0:16:58.25,0:16:59.47,Main,,0,0,0,,"!هيّا، لا بأس بهذا"
Dialogue: 0,0:16:59.58,0:17:01.45,Main,,0,0,0,,...وبعدها قُبلةٌ دافئة
Dialogue: 0,0:17:01.95,0:17:04.21,Main,,0,0,0,,!يا لها من فكرةٍ آسرة
Dialogue: 0,0:17:05.69,0:17:08.66,Main,,0,0,0,,!انتظرني يا عزيزي
Dialogue: 0,0:17:13.70,0:17:14.66,Main,,0,0,0,,...ميل-ساما
Dialogue: 0,0:17:22.44,0:17:26.20,Main,,0,0,0,,!يا جلالة الملك ناوكليف، يا له من خطأٍ فادحٍ ارتكبته
Dialogue: 0,0:17:26.71,0:17:31.37,Main,,0,0,0,,...إن مسَّ ميل-ساما أيُّ مكروه، فحينها
Dialogue: 0,0:17:35.38,0:17:37.28,Main,,0,0,0,,!أعادت هذه الرائحة الكريهة مجدّدًا؟
Dialogue: 0,0:17:38.05,0:17:39.08,Main,,0,0,0,,!تلك الجنيّة راندي
Dialogue: 0,0:17:40.62,0:17:41.99,Main,,0,0,0,,!أيعقل أنَّ هذا من فعلها؟
Dialogue: 0,0:18:06.08,0:18:07.14,Main,,0,0,0,,!أونيه-ني-ساما
Dialogue: 0,0:18:10.69,0:18:13.28,Main,,0,0,0,,!عُدتُ إلى هيئتي السابقة إذن
Dialogue: 0,0:18:13.56,0:18:14.59,Main,,0,0,0,,...ميز الفتى
Dialogue: 0,0:18:18.63,0:18:20.82,Main,,0,0,0,,أين ذهبتَ أيّها الأبله؟
Dialogue: 0,0:18:21.73,0:18:24.72,Main,,0,0,0,,،تمنّيتُ دومًا لو تختفي من حياتي
Dialogue: 0,0:18:27.50,0:18:31.20,Main,,0,0,0,,...لكن يبدو أنّني اعتدتُ الاتّكال عليه دون وعيٍ منّي
Dialogue: 0,0:18:31.68,0:18:33.83,Main,,0,0,0,,!وموقنةً بأنّه سينقذ الموقف مهما حدث
Dialogue: 0,0:18:35.01,0:18:39.00,Main,,0,0,0,,!مع أنّه متهوّرٌ وأنانيٌّ ومستهتر
Dialogue: 0,0:18:42.85,0:18:45.81,Main,,0,0,0,,...لكن... رغم ذلك
Dialogue: 0,0:18:46.69,0:18:49.32,Main,,0,0,0,,!لا يسعني حماية ميل-تشان بحالي هذه
Dialogue: 0,0:18:49.66,0:18:50.81,Main,,0,0,0,,ما العمل يا ترى؟
Dialogue: 0,0:18:51.00,0:18:52.80,Main,,0,0,0,,!إيّاكِ والاستسلام
Dialogue: 0,0:18:52.89,0:18:55.42,Main,,0,0,0,,!لا بُدَّ من وجود طريقةٍ للهروب من هذا المكان
Dialogue: 0,0:18:55.86,0:18:57.74,Main,,0,0,0,,!محقّةٌ في ذلك يا أونيه-ني-ساما
Dialogue: 0,0:18:57.93,0:19:02.87,Main,,0,0,0,,!لكنّي مجرّد فتاةٍ عاجزةٍ لا تقوى على فِعل شيءٍ الآن
Dialogue: 0,0:19:03.34,0:19:05.53,Main,,0,0,0,,!لا تقولي هذا يا أونيه-ني-ساما
Dialogue: 0,0:19:31.40,0:19:32.44,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:19:33.80,0:19:38.16,Main,,0,0,0,,!مرحبًا بكِ في قصري السريّ يا أميرة ميل
Dialogue: 0,0:19:38.16,0:19:39.37,Main,,0,0,0,,!ومرحبًا بكِ أنتِ أيضًا يا ميز
Dialogue: 0,0:19:43.28,0:19:44.62,Main,,0,0,0,,...دعوني أعرّفكم
Dialogue: 0,0:19:45.21,0:19:49.24,Main,,0,0,0,,!بالكونت بوتشومكين من طائفة جاينا المقدّسة
Dialogue: 0,0:19:54.56,0:19:56.02,Main,,0,0,0,,...مبعوث طائفة جاينا
Dialogue: 0,0:19:56.09,0:19:57.84,Main,,0,0,0,,!هو العقل المدبّر وراء كلّ هذا
Dialogue: 0,0:19:59.43,0:20:02.06,Main,,0,0,0,,!يتحتّم عليَّ توجيه الشكر إليكم
Dialogue: 0,0:20:02.43,0:20:05.40,Main,,0,0,0,,،فبفضل مجيئكم إلى بالانيا
Dialogue: 0,0:20:05.47,0:20:08.81,Main,,0,0,0,,!اتّحدت أطماعنا وغاياتنا معًا
Dialogue: 0,0:20:08.97,0:20:10.20,Main,,0,0,0,,ما الّذي تعنيه؟
Dialogue: 0,0:20:10.71,0:20:15.14,Main,,0,0,0,,،ديانة طائفة جاينا محظورةٌ في بالانيا
Dialogue: 0,0:20:15.21,0:20:18.37,Main,,0,0,0,,!ولذا، فإنّ تحرّكاتي مقيّدةٌ في هذه البلاد
Dialogue: 0,0:20:18.45,0:20:22.35,Main,,0,0,0,,...ولذلك تولّى دين مارش أسركم نيابةً عنّي
Dialogue: 0,0:20:22.78,0:20:28.22,Main,,0,0,0,,!ومقابل ذلك، ستُقدّم طائفة جاينا المقدّسة دعمًا كاملًا للانقلاب الّذي أُدبّره
Dialogue: 0,0:20:28.29,0:20:30.62,Main,,0,0,0,,!إنّه مخطّطٌ مثاليٌّ لا تشوبه شائبة
Dialogue: 0,0:20:31.13,0:20:34.75,Main,,0,0,0,,!إيّاكَ أن تنسى عهدكَ حين تغدو ملكًا على البلاد
Dialogue: 0,0:20:35.10,0:20:36.94,Main,,0,0,0,,!بالتأكيد، لن أنسى
Dialogue: 0,0:20:36.96,0:20:41.46,Main,,0,0,0,,!فإعلان ديانة جاينا دينًا رسميًّا للمملكة أمرٌ في غاية السهولة
Dialogue: 0,0:20:41.90,0:20:44.13,Main,,0,0,0,,!أنتَ وغدٌ خبيثٌ بحقّ
Dialogue: 0,0:20:44.21,0:20:46.67,Main,,0,0,0,,!بل كلانا سواءٌ في ذلك
Dialogue: 0,0:20:55.32,0:20:58.44,Main,,0,0,0,,!والآن، سنشرع في تنفيذ حكم الإعدام بحقّكم
Dialogue: 0,0:21:03.99,0:21:07.05,Main,,0,0,0,,!دين مارش، أيّها الأحمق المغفّل
Dialogue: 0,0:21:07.05,0:21:08.40,Main,,0,0,0,,!ميز-سان
Dialogue: 0,0:21:08.27,0:21:09.71,Top,,0,0,0,,!سأطاردكم بلعنتي حتّى بعد موتي
Dialogue: 0,0:21:09.26,0:21:12.33,Main,,0,0,0,,...إن بقينا هكذا... فلن
Dialogue: 0,0:21:22.08,0:21:26.24,Main,,0,0,0,,!حسمتُ هذه الجولة لصالحي يا شيك
Dialogue: 0,0:21:35.06,0:21:36.23,Main,,0,0,0,,!ما هذا
Dialogue: 0,0:21:39.73,0:21:43.06,Main,,0,0,0,,!عدالة السماء بالمرصاد للأشرار ولا يُفلت منها ظالم
Dialogue: 0,0:21:44.03,0:21:48.66,Main,,0,0,0,,...خطف الأطفال الأبرياء، والتواطؤ مع جاينا لتدبير انقلاب
Dialogue: 0,0:21:50.24,0:21:52.54,Main,,0,0,0,,!لم أشهد أوغادًا أحقر منكم قطّ
Dialogue: 0,0:21:53.78,0:21:56.47,Main,,0,0,0,,!أخيرًا أوقعتُ بكَ ونلتُ منك يا دين مارش
Dialogue: 0,0:21:57.25,0:21:58.74,Main,,0,0,0,,!غولد-سان؟
Dialogue: 0,0:21:59.38,0:22:01.71,Main,,0,0,0,,!ما الّذي تظنّ نفسك فاعله أيّها الوغد؟
Dialogue: 0,0:22:01.82,0:22:04.91,Main,,0,0,0,,!حان وقت حسابكما أيّها الوغدان
Dialogue: 0,0:22:04.99,0:22:09.42,Main,,0,0,0,,!خابت مؤامراتكما الدنيئة، وشهد هذا الهلال على جرمكما
Dialogue: 0,0:24:10.68,0:24:12.67,Main,,0,0,0,,!إعلان الحلقة القادمة
Dialogue: 0,0:24:12.96,0:24:15.56,Main,,0,0,0,,!اسمعي يا ميل، لننهِ هذا الأمر سريعًا ولنستمتع قليلًا
Dialogue: 0,0:24:15.92,0:24:18.09,Main,,0,0,0,,!يبدو أونيه-ني-ساما جامحًا اليوم
Dialogue: 0,0:24:18.27,0:24:21.56,Main,,0,0,0,,،تبًّا، بسبب غولد لا يسعني استخدام الطور
Dialogue: 0,0:24:21.56,0:24:24.00,Main,,0,0,0,,!وعلاوةً على ذلك، ظهر أوغاد جاينا
Dialogue: 0,0:24:24.33,0:24:27.20,Main,,0,0,0,,!سحقًا، ما الّذي يجدر بي فعله الآن؟
Dialogue: 0,0:24:27.61,0:24:29.61,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:30.12,0:24:31.69,Main,,0,0,0,,!قضاء العدالة المُطلقة
Dialogue: 0,0:24:32.46,0:24:34.11,Main,,0,0,0,,!إيّاكم وتفويتها
Dialogue: 0,0:24:34.83,0:24:37.10,Main,,0,0,0,,!تعجبني هيئتكَ هذه أيضًا يا أونيه-ني-ساما
Comment: 0,0:24:37.10,0:24:39.10,Main,,0,0,0,,
Dialogue: 0,0:02:48.06,0:02:54.07,Signs,,0,0,0,,احذروا من اللعوب الوسيم
Dialogue: 0,0:24:33.82,0:24:37.78,Signs,,0,0,0,,قضاء العدالة المُطلقة
