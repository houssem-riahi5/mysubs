Dialogue: 0,0:00:01.24,0:00:02.31,Main,,0,0,0,,!لنبدأ
Dialogue: 0,0:02:08.85,0:02:11.48,Main,,0,0,0,,أمتأكدةٌ أنّنا في الدرب الصحيح يا راندي؟
Dialogue: 0,0:02:12.77,0:02:15.69,Main,,0,0,0,,!لا ريب في وجودها وسط هذه الجبال
Dialogue: 0,0:02:15.78,0:02:18.11,Main,,0,0,0,,لا بُدَّ أنّنا اقتربنا منها كثيرًا الآن
Dialogue: 0,0:02:18.20,0:02:22.70,Main,,0,0,0,,سحقًا، هذا الضباب كثيفٌ للغاية، لا أكاد أرى ما هو أمامي
Dialogue: 0,0:02:27.29,0:02:28.04,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:02:28.12,0:02:29.08,Main,,0,0,0,,!ميل-ساما
Dialogue: 0,0:02:29.75,0:02:33.42,Main,,0,0,0,,!حسبكنّ، إن تباطأتنّ فسنتركنَّ خلفنا
Dialogue: 0,0:02:33.68,0:02:35.84,Main,,0,0,0,,!لا تقولي ذلك يا سوليود-سان
Dialogue: 0,0:02:36.25,0:02:37.64,Main,,0,0,0,,أأنتِ بخير يا ميل-تشان؟
Dialogue: 0,0:02:39.05,0:02:41.43,Main,,0,0,0,,!ميل بخير
Dialogue: 0,0:02:41.95,0:02:43.90,Main,,0,0,0,,!لنسرع الخُطى بدلًا من ذلك
Dialogue: 0,0:02:44.64,0:02:45.47,Main,,0,0,0,,...ميل-تشان
Dialogue: 0,0:02:48.77,0:02:50.86,Main,,0,0,0,,!هلمّوا إلى هنا جميعًا
Dialogue: 0,0:02:51.44,0:02:53.68,Main,,0,0,0,,!انظروا إلى ذلك يا رفاق
Dialogue: 0,0:02:54.57,0:02:56.80,Main,,0,0,0,,!عثرنا عليها أخيرًا
Dialogue: 0,0:03:02.66,0:03:05.23,Main,,0,0,0,,هذه ينابيع بارتونيا الساخنة المتوارثة
Dialogue: 0,0:03:05.33,0:03:09.62,Main,,0,0,0,,!يُقال إنّها تُعيد خمس سنواتٍ من الشباب
Dialogue: 0,0:03:14.75,0:03:17.21,Main,,0,0,0,,الحدث المُرتقب، ينابيع الحبّ الساخنة
Dialogue: 0,0:03:22.35,0:03:26.81,Main,,0,0,0,,يا له من شعورٍ رائع، كأنّي بُعثتُ من جديدٍ حقًّا
Dialogue: 0,0:03:27.64,0:03:32.65,Main,,0,0,0,,يبدو أنَّ شائعة استعادة خمس سنواتٍ من الشباب ليست مجرد كذبةٍ حقًّا
Dialogue: 0,0:03:34.33,0:03:39.28,Main,,0,0,0,,ما الخطب يا رايبير؟ أتشغلكِ نضارة بشرتكِ أنتِ أيضًا؟
Dialogue: 0,0:03:39.71,0:03:42.22,Main,,0,0,0,,مـ-ما تلك الضحكة المُريبة؟
Dialogue: 0,0:03:42.45,0:03:46.14,Main,,0,0,0,,،لا شيء، تتظاهرين بكونكِ سيّافةً مسترجلةً في العادة
Dialogue: 0,0:03:46.16,0:03:49.95,Main,,0,0,0,,لكنّكِ تبقين امرأةً في نهاية المطاف
Dialogue: 0,0:03:51.10,0:03:54.75,Main,,0,0,0,,...أتيتُ إلى هنا لأنّي سمعتُ شائعاتٍ
Dialogue: 0,0:03:54.75,0:03:57.85,Main,,0,0,0,,...عن تأثير أطوارٍ خاصةٍ في مياه هذا النبع
Dialogue: 0,0:03:58.47,0:04:00.31,Main,,0,0,0,,للتحقّق من ذلك فحسب
Dialogue: 0,0:04:01.69,0:04:05.21,Main,,0,0,0,,،فهذه المياه الطبيعيّة غنيةٌ بالراديوم
Dialogue: 0,0:04:05.28,0:04:07.18,Main,,0,0,0,,،وخلاصة الصبار من الغابة
Dialogue: 0,0:04:07.32,0:04:10.18,Main,,0,0,0,,،وتُفيد في تعزيز نضارة البشرة
Dialogue: 0,0:04:10.22,0:04:13.80,Main,,0,0,0,,وآلام الكتف والظهر، حتّى القشعريرة
Dialogue: 0,0:04:16.09,0:04:20.68,Main,,0,0,0,,!هذا العناد بالذات هو ما يُظهر أنوثتكِ
Dialogue: 0,0:04:21.61,0:04:23.05,Main,,0,0,0,,...على الأقل
Dialogue: 0,0:04:23.23,0:04:27.05,Main,,0,0,0,,لا أنسى واجبي كسيّافةٍ تتّخذ كافّة الاحتياطات دومًا
Dialogue: 0,0:04:27.16,0:04:29.91,Main,,0,0,0,,!ومن يحمل سيفه إلى حوض الاستحمام أصلًا؟
Dialogue: 0,0:04:36.83,0:04:37.50,Main,,0,0,0,,!مهلًا
Dialogue: 0,0:04:37.59,0:04:40.81,Main,,0,0,0,,!لا يجوز السباحة في حوض الاستحمام يا ميل-ساما
Dialogue: 0,0:04:43.48,0:04:46.72,Main,,0,0,0,,،تساءلتُ عن سبب رغبتهنَّ المفاجئة في المجيء إلى الجبل
Dialogue: 0,0:04:47.04,0:04:48.73,Main,,0,0,0,,يا لراحة بالهنّ
Dialogue: 0,0:04:49.60,0:04:54.51,Main,,0,0,0,,رغم أنَّ بارتونيا في خضمّ استعداداتها لخوض حربٍ ضدّ جاينا
Dialogue: 0,0:04:55.21,0:04:58.27,Main,,0,0,0,,أيصحُّ لنا تمضية الوقت هكذا يا ترى؟
Dialogue: 0,0:05:00.36,0:05:03.61,Main,,0,0,0,,لا طائل من التفكير في أمر جاينا الآن
Dialogue: 0,0:05:04.36,0:05:06.95,Main,,0,0,0,,سيشنُّ هؤلاء الأوغاد هجومهم عاجلًا أم آجلًا
Dialogue: 0,0:05:07.03,0:05:11.18,Main,,0,0,0,,وحينها لن نحظى بفرصةٍ للاسترخاء هكذا ثانيةً
Dialogue: 0,0:05:11.49,0:05:14.71,Main,,0,0,0,,أجل، يحتاج المحاربون إلى الراحة أيضًا
Dialogue: 0,0:05:14.75,0:05:19.17,Main,,0,0,0,,هذا النبع يُعيد خمس سنواتٍ من الشباب، لذا لا تتردّدي في الانضمام إلينا يا ميز-دونو
Dialogue: 0,0:05:19.38,0:05:23.59,Main,,0,0,0,,...كلّا، في الواقع... ما زلتُ يافعةً بما فيه الكفاية
Dialogue: 0,0:05:24.26,0:05:25.87,Main,,0,0,0,,!ماذا قلتِ؟
Dialogue: 0,0:05:25.90,0:05:28.78,Main,,0,0,0,,!إيّاكِ والتهاون يا أونيه-ني-ساما
Dialogue: 0,0:05:29.26,0:05:35.10,Main,,0,0,0,,!إن أهملتِ العناية اليومية، فستشيخ بشرة الفتاة الرقيقة سريعًا
Dialogue: 0,0:05:35.29,0:05:40.35,Main,,0,0,0,,!لذا انضمّي إلينا في الحوض، ولنستعدْ خمس سنواتٍ من الشباب مع ميل
Dialogue: 0,0:05:40.73,0:05:43.80,Main,,0,0,0,,وكم سيغدو عمركِ إن صغرتِ خمس سنواتٍ يا ميل-ساما؟
Dialogue: 0,0:05:43.87,0:05:48.32,Main,,0,0,0,,على أيّ حال، انضمّي إلينا يا ميز، أعدكِ ألّا أفعل شيئًا مُريبًا
Dialogue: 0,0:05:49.95,0:05:51.92,Main,,0,0,0,,وأنا أرجوكِ أيضًا
Dialogue: 0,0:05:52.33,0:05:56.60,Main,,0,0,0,,،دعي أمر البشرة جانبًا، فإن لم تدخلي النبع بصفتكِ سيّدة أطوار
Dialogue: 0,0:05:56.60,0:05:59.85,Main,,0,0,0,,فلن نتمكّن من كشف لغز الطور الكامن في هذه الينابيع
Dialogue: 0,0:06:00.17,0:06:03.71,Main,,0,0,0,,لكن أهذه الشائعات صحيحةٌ حقًّا يا راندي؟
Dialogue: 0,0:06:03.74,0:06:08.32,Main,,0,0,0,,!يستحيل أن يستعيد المرء شبابه بمجرد النزول في الماء دون وجود سرٍّ ما
Dialogue: 0,0:06:08.80,0:06:13.63,Main,,0,0,0,,،فضلًا عن أنَّ اكتشاف طورٍ جديدٍ قد يُسهم في إنهاء الصراع مع جاينا سريعًا
Dialogue: 0,0:06:13.77,0:06:17.52,Main,,0,0,0,,!وقد يُحقّق السلام في هذا العالم
Dialogue: 0,0:06:18.35,0:06:20.72,Main,,0,0,0,,...إنهاء المعركة ضدّ جاينا
Dialogue: 0,0:06:21.34,0:06:22.33,Main,,0,0,0,,...حينها
Dialogue: 0,0:06:24.16,0:06:25.16,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:06:25.77,0:06:31.37,Main,,0,0,0,,لستُ متأكدةً من قدرتي على المساعدة، لكن لنجرّب كلّ ما بوسعنا على أيّ حال
Dialogue: 0,0:06:32.46,0:06:33.74,Main,,0,0,0,,!هذا هو المطلوب
Dialogue: 0,0:06:34.00,0:06:37.58,Main,,0,0,0,,!تعالي، سأساعدكِ على خلع ملابسكِ
Dialogue: 0,0:06:37.58,0:06:41.38,Main,,0,0,0,,!مستحيل! هذا من واجب ميل
Dialogue: 0,0:06:42.79,0:06:47.17,Main,,0,0,0,,!توقّفي يا سوليود، يسعني فعل ذلك بنفسي
Dialogue: 0,0:06:49.63,0:06:50.91,Main,,0,0,0,,هذا مطمئن
Dialogue: 0,0:06:51.10,0:06:57.18,Main,,0,0,0,,بهذا قد نتمكّن من جمع بلورات الأطوار الخمسة الّتي تُشكّل هذا العالم
Dialogue: 0,0:06:57.61,0:07:02.90,Main,,0,0,0,,تمكّنتُ من الحصول على ثلاث بلوراتٍ بفضل مرافقتي لميز-سان
Dialogue: 0,0:07:03.76,0:07:07.49,Main,,0,0,0,,ولم يتبقَّ سوى ياقوت الماء وتوباز الأرض
Dialogue: 0,0:07:07.88,0:07:09.86,Main,,0,0,0,,الأطوار المرتبطة بالماء والأرض
Dialogue: 0,0:07:10.61,0:07:14.33,Main,,0,0,0,,وتتوفّر في هذا المكان كافة الشروط لاحتوائهما
Dialogue: 0,0:07:18.06,0:07:19.66,Main,,0,0,0,,!تبدين فاتنةً يا أونيه-ني-ساما
Dialogue: 0,0:07:19.75,0:07:26.21,Main,,0,0,0,,!الينابيع الساخنة هي الملاذ المثاليّ ليمرح الحبيبان كما يحلو لهما
Dialogue: 0,0:07:26.68,0:07:30.05,Main,,0,0,0,,!هذا يُخالف ما وعدتِ به يا سوليود-سان
Dialogue: 0,0:07:30.26,0:07:34.99,Main,,0,0,0,,!هيّا يا رفاق، ارموا ميز-سان في النبع على أيّ حال
Dialogue: 0,0:07:34.99,0:07:35.69,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:07:35.83,0:07:36.89,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:07:38.68,0:07:41.63,Main,,0,0,0,,!مهلًا! توقفا عن هذا
Dialogue: 0,0:07:47.79,0:07:49.85,Main,,0,0,0,,!أنا قادمةٌ أيضًا
Dialogue: 0,0:08:01.37,0:08:03.58,Main,,0,0,0,,!هذا تصرّفٌ فظٌّ منكنّ
Dialogue: 0,0:08:09.84,0:08:12.43,Main,,0,0,0,,ميل-تشان؟ سوليود-سان؟
Dialogue: 0,0:08:12.97,0:08:16.27,Main,,0,0,0,,رايبير-سان؟ راندي؟
Dialogue: 0,0:08:19.31,0:08:25.31,Main,,0,0,0,,!سحقًا، يا لقسوة ميل-تشان وميز، تركاني خلفهما وحدي
Dialogue: 0,0:08:25.65,0:08:29.00,Main,,0,0,0,,!يمضيان وقتهما في الاسترخاء بالينابيع حتّى هذه الساعة
Dialogue: 0,0:08:29.53,0:08:32.94,Main,,0,0,0,,!أريد أن أزداد جمالًا في ينبوع استعادة الشباب بدوري
Dialogue: 0,0:08:33.92,0:08:35.48,Main,,0,0,0,,!ميل-تشان
Dialogue: 0,0:08:36.72,0:08:38.75,Main,,0,0,0,,!رايبير-سان
Dialogue: 0,0:08:40.54,0:08:42.51,Main,,0,0,0,,!سوليود-سان
Dialogue: 0,0:08:44.83,0:08:49.42,Main,,0,0,0,,هذا غريب، أين ذهب الجميع يا ترى؟
Dialogue: 0,0:08:53.42,0:08:58.20,Main,,0,0,0,,!ما العمل الآن؟ سأضلّ طريقي إن بقيتُ وحدي هنا
Dialogue: 0,0:08:58.76,0:09:04.35,Main,,0,0,0,,!أرجوكم، اخرجوا ولا تقسوا عليّ
Dialogue: 0,0:09:14.45,0:09:15.36,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:09:23.04,0:09:28.00,Main,,0,0,0,,هذا المكان... أعرفه، رأيته من قبل
Dialogue: 0,0:09:28.04,0:09:29.46,Main,,0,0,0,,لكن أين يا ترى؟
Dialogue: 0,0:09:51.32,0:09:52.03,Main,,0,0,0,,ما الخطب؟
Dialogue: 0,0:09:57.95,0:09:59.93,Main,,0,0,0,,لم تأتِ إلى هنا مُنذ يومين أو ثلاثة
Dialogue: 0,0:10:02.24,0:10:06.12,Main,,0,0,0,,ماذا بكِ؟ ادخلي ولا تبقي واقفةً عند الباب
Dialogue: 0,0:10:16.72,0:10:21.13,Main,,0,0,0,,لِمَ تنظرين إليّ هكذا؟ لا تبدين مي الّتي أعرفها
Dialogue: 0,0:10:21.28,0:10:21.86,Main,,0,0,0,,مي؟
Dialogue: 0,0:10:22.52,0:10:24.31,Main,,0,0,0,,مي؟ كلّا، اسمي ميز
Dialogue: 0,0:10:24.42,0:10:25.64,Main,,0,0,0,,ومن هذا الرجل؟
Dialogue: 0,0:10:26.96,0:10:28.81,Main,,0,0,0,,ادخلي يا مي
Dialogue: 0,0:10:31.44,0:10:32.82,Main,,0,0,0,,!كلّا! ابتعد عنّي
Dialogue: 0,0:10:44.44,0:10:48.62,Main,,0,0,0,,أعلم، لا بُدَّ أنَّ والدي قد وبّخكِ مجدّدًا
Dialogue: 0,0:10:50.79,0:10:53.92,Main,,0,0,0,,لكن لا تُعيري كلامه أيَّ بال
Dialogue: 0,0:10:54.67,0:10:57.76,Main,,0,0,0,,...فمهما قال... سأظلُّ
Dialogue: 0,0:11:07.20,0:11:10.56,Main,,0,0,0,,فهمت، هكذا كان الأمر إذن
Dialogue: 0,0:11:15.82,0:11:17.21,Main,,0,0,0,,أخي
Dialogue: 0,0:11:45.64,0:11:49.56,Main,,0,0,0,,هذا سيئ، لِمَ يسعدني أمرٌ تافهٌ كهذا؟
Dialogue: 0,0:11:50.12,0:11:54.52,Main,,0,0,0,,ولِمَ ناديتُ ذلك الرجل بأخي الكبير أصلًا؟
Dialogue: 0,0:11:55.77,0:11:59.40,Main,,0,0,0,,ما هذا الشعور الّذي يبعث على الحنين يا ترى؟
Dialogue: 0,0:12:00.56,0:12:04.53,Main,,0,0,0,,أيعقل أنَّ هذه هي حقيقتي؟
Dialogue: 0,0:12:06.53,0:12:09.47,Main,,0,0,0,,إذن، ماذا عن ذلك العالم الّذي التقيتُ فيه بميل-تشان والآخرين؟
Dialogue: 0,0:12:11.16,0:12:11.89,Main,,0,0,0,,!هذا سيئ
Dialogue: 0,0:12:15.67,0:12:17.29,Main,,0,0,0,,!انتهيتُ أخيرًا
Dialogue: 0,0:12:17.50,0:12:21.80,Main,,0,0,0,,لا بُدَّ أنّكَ تتضوّر جوعًا كالعادة، هيّا لنتناول الغداء
Dialogue: 0,0:12:24.09,0:12:27.55,Main,,0,0,0,,كنتُ بانتظاره بفارغ الصبر، شكرًا لكِ كالعادة
Dialogue: 0,0:12:31.18,0:12:35.32,Main,,0,0,0,,!أتقصدين هذه؟ إنّها زوجتي
Dialogue: 0,0:12:35.35,0:12:37.12,Main,,0,0,0,,!زوجتكَ؟
Dialogue: 0,0:12:37.82,0:12:40.94,Main,,0,0,0,,!تعاهدنا على الحبّ الأبديّ
Dialogue: 0,0:12:41.15,0:12:42.40,Main,,0,0,0,,!حقًّا؟
Dialogue: 0,0:12:42.81,0:12:48.81,Main,,0,0,0,,!لكن إن وعدتِ بعدم اعتراض طريقنا، فسأسمح لكِ بأن تكوني إحدى زوجات أونيه-ني-ساما
Dialogue: 0,0:12:49.87,0:12:52.54,Main,,0,0,0,,...أونيه-ني-ساما؟ أيعقل أنّكِ
Dialogue: 0,0:12:56.78,0:12:58.01,Main,,0,0,0,,!لحظة
Dialogue: 0,0:12:58.11,0:13:02.24,Main,,0,0,0,,لِمَ ميل-تشان هنا؟ وليست ميل-تشان الّتي أعرفها حتّى؟
Dialogue: 0,0:13:02.40,0:13:05.93,Main,,0,0,0,,...وزوجها يشبه ميز الفتى لكنّه مختلفٌ نوعًا ما
Dialogue: 0,0:13:05.93,0:13:07.39,Main,,0,0,0,,...وأنا مي
Dialogue: 0,0:13:07.53,0:13:10.28,Main,,0,0,0,,!ما الّذي يجري هنا بحقّ؟
Dialogue: 0,0:13:11.90,0:13:15.29,Main,,0,0,0,,هذا يعني أنّه يخونكِ مع امرأةٍ أخرى
Dialogue: 0,0:13:17.10,0:13:18.56,Main,,0,0,0,,ر-رايبير-سان؟
Dialogue: 0,0:13:18.65,0:13:20.96,Main,,0,0,0,,تفضلي، نسيتِ الطبق الجانبيّ
Dialogue: 0,0:13:21.61,0:13:22.82,Main,,0,0,0,,!شكرًا لكِ
Dialogue: 0,0:13:23.60,0:13:24.29,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:13:26.25,0:13:30.08,Main,,0,0,0,,بالمناسبة، أنا وميز الفتى على علاقةٍ غراميةٍ أيضًا
Dialogue: 0,0:13:31.08,0:13:32.49,Main,,0,0,0,,!إذن هذه خيانةٌ ثلاثيّة
Dialogue: 0,0:13:32.95,0:13:34.83,Main,,0,0,0,,!مـ-مهلًا يا رايبير-سان
Dialogue: 0,0:13:34.96,0:13:36.17,Main,,0,0,0,,!لا تقلقي
Dialogue: 0,0:13:37.21,0:13:39.84,Main,,0,0,0,,فأنا أحبّ ميز-سان الفتاة أيضًا
Dialogue: 0,0:13:40.16,0:13:42.62,Main,,0,0,0,,!ليست هذه المشكلة أصلًا
Dialogue: 0,0:13:42.67,0:13:47.23,Main,,0,0,0,,أخبرتكِ ألّا تضيعي وقتكِ مع رجلٍ كهذا
Dialogue: 0,0:13:47.26,0:13:49.76,Main,,0,0,0,,فأنا مخلصةٌ لكِ وحدكِ دومًا
Dialogue: 0,0:13:50.30,0:13:51.68,Main,,0,0,0,,!حتّى أنتِ يا سوليود-سان؟
Dialogue: 0,0:13:52.14,0:13:55.60,Main,,0,0,0,,هيّا، هيّا، اختاريني أنا وانتهي من الأمر
Dialogue: 0,0:13:55.93,0:13:59.10,Main,,0,0,0,,!كلّا، بل اختاريني أنا يا ميز
Dialogue: 0,0:13:59.48,0:14:03.48,Main,,0,0,0,,!أونيه-ني-ساما اثنان في جسدٍ واحد، وواحدٌ في اثنين
Dialogue: 0,0:14:04.25,0:14:05.69,Main,,0,0,0,,!أنا في حيرةٍ من أمري
Dialogue: 0,0:14:07.02,0:14:11.56,Main,,0,0,0,,!ما الّذي يجري هنا بحقّ
Dialogue: 0,0:14:12.33,0:14:15.55,Main,,0,0,0,,مـ-ما الّذي يجري هنا؟
Dialogue: 0,0:14:29.97,0:14:32.44,Main,,0,0,0,,!وقعتْ مصيبةٌ يا رانتشيكي-سان
Dialogue: 0,0:14:32.54,0:14:37.48,Main,,0,0,0,,!حُبستْ ميز-سان ورفاقها في عالم الأحلام الّذي خلقته بحيرة الأطوار
Dialogue: 0,0:14:37.96,0:14:39.39,Main,,0,0,0,,طور؟ أحلام؟
Dialogue: 0,0:14:39.79,0:14:44.35,Main,,0,0,0,,بحيرة الأطوار مرآةٌ تعكس الرغبات الدفينة في أعماق القلوب
Dialogue: 0,0:14:45.52,0:14:48.99,Main,,0,0,0,,!لم أتوقّع وجودها في مكانٍ كهذا قطّ
Dialogue: 0,0:14:49.16,0:14:52.46,Main,,0,0,0,,!اشرحي الأمر بأسلوبٍ أوضح رجاءً
Dialogue: 0,0:14:52.88,0:14:58.99,Main,,0,0,0,,،باختصار، ينغمس من يدخل بحيرة الأطوار مؤقتًا في عالم أحلامه
Dialogue: 0,0:14:58.99,0:15:03.29,Main,,0,0,0,,!ليرفّه عن نفسه ويُجدّد روحه بتحقيق رغباته الدفينة
Dialogue: 0,0:15:04.55,0:15:07.21,Main,,0,0,0,,...أتعنين أنَّ استعادة خمس سنواتٍ من الشباب
Dialogue: 0,0:15:07.55,0:15:10.68,Main,,0,0,0,,!تجديد الشباب روحيًّا ونفسيًّا
Dialogue: 0,0:15:11.64,0:15:19.45,Main,,0,0,0,,!وبما أنَّ ميز-سان ورفاقها يجهلون ذلك، فستبتلع بحيرة الأطوار وعيهم ولن يتمكّنوا من الخروج أبدًا
Dialogue: 0,0:15:19.52,0:15:22.86,Main,,0,0,0,,!ماذا؟! لـ-لِمَ لم تُنقذيهم على الفور إذن؟
Dialogue: 0,0:15:23.16,0:15:29.87,Main,,0,0,0,,!طاقة الطور الصادرة عن بحيرة الأطوار تفوق طاقة الجنيّات بمراحل، وتتنافر معها
Dialogue: 0,0:15:31.60,0:15:35.36,Main,,0,0,0,,!ليتني تحقّقتُ من الأمر بدقّةٍ قبل المجيء
Dialogue: 0,0:15:36.49,0:15:37.49,Main,,0,0,0,,...ميز
Dialogue: 0,0:15:46.38,0:15:50.06,Main,,0,0,0,,من تحبّ أكثر من بيننا يا أونيه-ني-ساما؟
Dialogue: 0,0:15:50.63,0:15:53.64,Main,,0,0,0,,!احسم أمرك كرجلٍ وانتهِ من هذا التردّد
Dialogue: 0,0:15:53.84,0:15:56.22,Main,,0,0,0,,!ابتعدا عنّي أنتما الاثنان
Dialogue: 0,0:15:56.32,0:15:59.77,Main,,0,0,0,,!لن أفارقكِ أبدًا يا ميز
Dialogue: 0,0:16:02.99,0:16:07.74,Main,,0,0,0,,!ماذا؟ ترغبن جميعًا في نيل حبّي في نهاية المطاف
Dialogue: 0,0:16:09.07,0:16:11.60,Main,,0,0,0,,،لا يهمّ مَن أحبّ
Dialogue: 0,0:16:11.82,0:16:15.28,Main,,0,0,0,,!بل مشاعركم تُجاهي هي كلّ ما يهمّ
Dialogue: 0,0:16:15.80,0:16:18.08,Main,,0,0,0,,!هذا هو الحبّ الحقيقيّ
Dialogue: 0,0:16:21.37,0:16:23.92,Main,,0,0,0,,!وما ضير الخيانة المزدوجة أو الثلاثية؟
Dialogue: 0,0:16:24.00,0:16:25.83,Main,,0,0,0,,!أرحّب بكلّ من تأتي
Dialogue: 0,0:16:26.44,0:16:27.88,Main,,0,0,0,,!انظروا إلى هذا
Dialogue: 0,0:16:31.97,0:16:37.22,Main,,0,0,0,,!لن يعود الشباب ثانيةً، لذا سأعيش بحريّةٍ كما يحلو لي
Dialogue: 0,0:16:37.39,0:16:39.43,Main,,0,0,0,,!واحد، اثنان، واحد، اثنان
Dialogue: 0,0:16:42.27,0:16:46.17,Main,,0,0,0,,!مهلًا! وماذا عنّي أنا؟
Dialogue: 0,0:16:47.94,0:16:49.90,Main,,0,0,0,,!بات الوضع فوضويًّا للغاية
Dialogue: 0,0:17:05.08,0:17:08.06,Main,,0,0,0,,!ميل-تشان! أستر-سان! سوليود-سان
Dialogue: 0,0:17:08.19,0:17:08.75,Main,,0,0,0,,مي
Dialogue: 0,0:17:18.14,0:17:22.68,Main,,0,0,0,,مُحال، ما الّذي عليّ فعله؟
Dialogue: 0,0:17:24.60,0:17:26.96,Main,,0,0,0,,!ما الّذي يجدر بي فعله بالضبط؟
Dialogue: 0,0:17:28.90,0:17:29.85,Main,,0,0,0,,!ما الخطب؟
Dialogue: 0,0:17:30.36,0:17:34.03,Main,,0,0,0,,!بدأتْ بحيرة الأطوار في ابتلاع وعي ميز-سان ورفاقها
Dialogue: 0,0:17:38.06,0:17:40.03,Main,,0,0,0,,...أونيه-ني-ساما
Dialogue: 0,0:17:40.87,0:17:42.20,Main,,0,0,0,,...ميز
Dialogue: 0,0:17:43.87,0:17:45.61,Main,,0,0,0,,!انتظر أيّها الوغد
Dialogue: 0,0:17:46.19,0:17:48.42,Main,,0,0,0,,!ما بيدنا حيلة الآن
Dialogue: 0,0:17:49.26,0:17:54.19,Main,,0,0,0,,!عليكِ القفز إلى عالم الأحلام وإعادة الجميع إلى الواقع يا رانتشيكي-سان
Dialogue: 0,0:17:54.62,0:18:00.01,Main,,0,0,0,,إن أخطأتُ خطوةً واحدة، فستبتلعني بحيرة الأطوار أنا أيضًا؟
Dialogue: 0,0:18:00.51,0:18:04.75,Main,,0,0,0,,!ستكونين بخير ما دامتْ لديكِ إرادةٌ قويةٌ للعودة إلى الواقع
Dialogue: 0,0:18:04.81,0:18:08.88,Main,,0,0,0,,!وسيُصغي ميز-سان إلى كلامكِ حتمًا إن كنتِ حبيبته
Dialogue: 0,0:18:09.56,0:18:10.80,Main,,0,0,0,,حبيبته؟
Dialogue: 0,0:18:11.11,0:18:13.82,Main,,0,0,0,,!فالحبّ الحقيقيّ أقوى من الأحلام
Dialogue: 0,0:18:13.95,0:18:17.11,Main,,0,0,0,,!أنتِ الوحيدة القادرة على إنقاذ ميز-سان
Dialogue: 0,0:18:18.03,0:18:19.16,Main,,0,0,0,,...ميز
Dialogue: 0,0:18:20.20,0:18:21.28,Main,,0,0,0,,!حسنٌ
Dialogue: 0,0:18:21.58,0:18:25.44,Main,,0,0,0,,!انتظرني، سأريكَ معنى الحبّ الحقيقيّ الآن
Dialogue: 0,0:18:26.64,0:18:28.75,Main,,0,0,0,,!انتبهي على نفسكِ
Dialogue: 0,0:18:31.25,0:18:35.42,Main,,0,0,0,,!انهضي! لن تتمكّني من حماية اسم اليابان بهذا الضعف
Dialogue: 0,0:18:36.63,0:18:40.88,Main,,0,0,0,,لكن دموعي تنهمر، فأنا مجرد فتاة
Dialogue: 0,0:18:41.23,0:18:44.43,Main,,0,0,0,,!لا أفعل هذا بدافع الكراهية
Dialogue: 0,0:18:45.22,0:18:47.21,Main,,0,0,0,,...بل أنا... أنا
Dialogue: 0,0:18:47.58,0:18:50.81,Main,,0,0,0,,!مجرد وغدٍ مازوخيٍّ قادمٍ من عالمٍ موازٍ
Dialogue: 0,0:18:54.64,0:18:59.57,Main,,0,0,0,,!هيّا، اتّبعي نداء قلبكِ والقي بنفسكِ بين أحضاني
Dialogue: 0,0:19:04.28,0:19:06.62,Main,,0,0,0,,نداء قلبي
Dialogue: 0,0:19:08.29,0:19:09.92,Main,,0,0,0,,!ميز
Dialogue: 0,0:19:12.94,0:19:16.05,Main,,0,0,0,,!لن تتصدّي للكرات بهذا الوقوف المتردّد
Dialogue: 0,0:19:16.59,0:19:17.59,Main,,0,0,0,,!أيّتها الرئيسة
Dialogue: 0,0:19:17.61,0:19:18.20,Main,,0,0,0,,!حاضر
Dialogue: 0,0:19:18.63,0:19:23.40,Main,,0,0,0,,!عليَّ تلقينكِ قواعد هذا العالم
Dialogue: 0,0:19:24.38,0:19:28.98,Main,,0,0,0,,!وما المشكلة في ذلك أيّتها السيّدة؟ ألسنا في خضمّ دراما نهارية؟
Dialogue: 0,0:19:29.96,0:19:33.06,Main,,0,0,0,,!ستعود ابنتي من درس البيانو قريبًا
Dialogue: 0,0:19:37.82,0:19:41.49,Main,,0,0,0,,!ولّتْ دراما الشباب الملحمية
Dialogue: 0,0:19:45.71,0:19:48.29,Main,,0,0,0,,!لذا لا شيء يمنعنا الآن
Dialogue: 0,0:19:48.29,0:19:50.96,Main,,0,0,0,,!رُفعتْ كافة القيود يا أونيه-ني-ساما
Dialogue: 0,0:19:51.20,0:19:53.00,Main,,0,0,0,,!ميز
Dialogue: 0,0:19:53.16,0:19:56.08,Main,,0,0,0,,!انظر إلى جمالي الجديد
Dialogue: 0,0:19:56.70,0:19:59.90,Main,,0,0,0,,!رانتشيكي! ما الّذي أتى بكِ إلى هنا أنتِ أيضًا؟
Dialogue: 0,0:20:00.75,0:20:04.09,Main,,0,0,0,,!لن أسلّمكِ أونيه-ني-ساما مهما حييتِ
Dialogue: 0,0:20:07.01,0:20:08.24,Main,,0,0,0,,!أحبّكَ كثيرًا
Dialogue: 0,0:20:11.07,0:20:13.31,Main,,0,0,0,,!أعشقكَ من كلّ قلبي
Dialogue: 0,0:20:19.82,0:20:21.32,Main,,0,0,0,,!ميز
Dialogue: 0,0:20:21.77,0:20:25.92,Main,,0,0,0,,!تبًّا! أ-أنتِ بالذات من أمقته
Dialogue: 0,0:20:26.06,0:20:28.96,Main,,0,0,0,,!لنبنِ حبّنا الحقيقيّ معًا
Dialogue: 0,0:20:28.99,0:20:34.27,Main,,0,0,0,,!أمقتكِ لحالكِ، فكيف بجيشٍ كاملٍ منكِ؟
Dialogue: 0,0:20:38.52,0:20:39.21,Main,,0,0,0,,!الجميع
Dialogue: 0,0:20:44.13,0:20:46.47,Main,,0,0,0,,...عليَّ الذهاب
Dialogue: 0,0:20:48.05,0:20:49.39,Main,,0,0,0,,والعودة إلى رفاقي
Dialogue: 0,0:21:07.57,0:21:09.20,Main,,0,0,0,,هذا مُذهل
Dialogue: 0,0:21:15.63,0:21:17.26,Main,,0,0,0,,!كـ-كـ-كابوسٌ مروّع
Dialogue: 0,0:21:17.26,0:21:22.84,Main,,0,0,0,,!لا أريد العودة إلى عالمٍ كهذا ثانيةً أبدًا
Dialogue: 0,0:21:26.56,0:21:28.24,Main,,0,0,0,,...على أيّ حال
Dialogue: 0,0:21:28.49,0:21:32.52,Main,,0,0,0,,لا فائدة من الذهاب إلى الينابيع الساخنة إن كُنّا سنعود أكثر إنهاكًا ممّا كُنّا عليه
Dialogue: 0,0:21:33.15,0:21:36.51,Main,,0,0,0,,!لكن ميل تشعر بانتعاشٍ تامٍّ لسببٍ ما
Dialogue: 0,0:21:36.65,0:21:37.55,Main,,0,0,0,,!وأنا أيضًا
Dialogue: 0,0:21:37.80,0:21:43.04,Main,,0,0,0,,!أشعر وكأنّي حظيتُ بلحظاتٍ رومانسيةٍ مع أونيه-ني-ساما أضعاف المعتاد
Dialogue: 0,0:21:43.12,0:21:47.95,Main,,0,0,0,,!كنتُ موقنةً أنَّ ميز يُفضّل هذا العالم بوجودي الحقيقيّ فيه
Dialogue: 0,0:21:48.95,0:21:53.95,Main,,0,0,0,,بل هرب بدافع رغبته العارمة في الابتعاد عنكِ يا رانتشيكي-سان
Dialogue: 0,0:21:54.12,0:21:55.24,Main,,0,0,0,,أقلتِ شيئًا؟
Dialogue: 0,0:21:55.78,0:21:56.93,Main,,0,0,0,,!لا شيء على الإطلاق
Dialogue: 0,0:21:58.89,0:22:00.22,Main,,0,0,0,,...ومع ذلك
Dialogue: 0,0:22:00.79,0:22:04.28,Main,,0,0,0,,...إن كان ذلك العالم انعكاسًا لرغباتي الدفينة
Dialogue: 0,0:22:05.17,0:22:09.76,Main,,0,0,0,,فمَن كان ذلك الرجل الّذي رأيتُه وسط الضباب يا ترى؟
Dialogue: 0,0:24:10.28,0:24:13.53,Main,,0,0,0,,!حان وقت النشرة الجوية برفقة رانتشيكي وميل
Dialogue: 0,0:24:13.80,0:24:17.76,Main,,0,0,0,,،سيكون الطقس في بارتونيا الأسبوع القادم غائمًا وكئيبًا
Dialogue: 0,0:24:17.81,0:24:21.55,Main,,0,0,0,,وكأنّه يعكس اضطراب مشاعر الفتيات قبل المعركة الحاسمة
Dialogue: 0,0:24:21.55,0:24:25.90,Main,,0,0,0,,!كما يُتوقّع تساقط الصواعق في بعض المناطق، لذا توخّوا الحذر
Dialogue: 0,0:24:25.94,0:24:27.94,Main,,0,0,0,,في الحلقة القادمة من ميز: الفضاء المتفجّر
Dialogue: 0,0:24:28.02,0:24:30.40,Main,,0,0,0,,!اضطراب القلوب عشيّة المعركة
Dialogue: 0,0:24:30.44,0:24:31.71,Main,,0,0,0,,!نكتفي بهذا القدر اليوم
Dialogue: 0,0:24:32.24,0:24:35.37,Main,,0,0,0,,!إلى اللقاء
Comment: 0,0:24:35.37,0:24:37.37,Main,,0,0,0,,
Dialogue: 0,0:03:14.75,0:03:20.76,Signs,,0,0,0,,الحدث المُرتقب، ينابيع الحبّ الساخنة
Dialogue: 0,0:09:41.14,0:09:44.27,Note,,0,0,0,,إيكاروغا أكيرا
Dialogue: 0,0:24:33.70,0:24:37.66,Signs,,0,0,0,,!اضطراب القلوب عشيّة المعركة
