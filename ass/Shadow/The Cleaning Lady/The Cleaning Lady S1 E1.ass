Dialogue: 0,1:00:21.38,1:00:23.04,Default,,0,0,0,,.هل تراهنين؟ لن تنجح علاقتهما
Dialogue: 0,1:00:23.67,1:00:25.46,Default,,0,0,0,,.أعلنكما الآن زوجًا وزوجة
Dialogue: 0,1:00:25.54,1:00:28.25,Default,,0,0,0,,.سأقبل ذلك الرهان -\N.يمكنك الآن تقبيل العروس -
Dialogue: 0,1:00:29.42,1:00:30.71,Default,,0,0,0,,.يبدوان سعيدين
Dialogue: 0,1:00:31.63,1:00:33.42,Default,,0,0,0,,.يبدو الجميع سعداء في البداية
Dialogue: 0,1:00:43.67,1:00:46.42,Default,,0,0,0,,.لا ترميها. هذه علكة لذيذة -\N.حسنًا -
Dialogue: 0,1:00:47.42,1:00:50.75,Default,,0,0,0,,."علي التقاط صورة. إنها "ليدي لاك
Dialogue: 0,1:00:50.83,1:00:52.21,Default,,0,0,0,,"(ليدي لاك)"
Dialogue: 0,1:00:52.29,1:00:53.75,Default,,0,0,0,,.قفي إلى جانبي
Dialogue: 0,1:01:00.29,1:01:02.04,Default,,0,0,0,,.حسنًا، لننه هذا ونعود إلى المنزل
Dialogue: 0,1:01:02.13,1:01:04.08,Default,,0,0,0,,.ليس عليك تكرار الطلب
Dialogue: 0,1:01:11.75,1:01:15.38,Default,,0,0,0,,بحقك يا\N"في"
Dialogue: 0,1:01:15.46,1:01:17.13,Default,,0,0,0,,أيمكنني الاستمتاع بوقتي أيضًا؟
Dialogue: 0,1:01:17.21,1:01:20.58,Default,,0,0,0,,.رأيتك أنت وأختك تلهوان -\N.أخت زوجي -
Dialogue: 0,1:01:20.67,1:01:22.58,Default,,0,0,0,,.أنا متزوجة بأخيها
Dialogue: 0,1:01:22.67,1:01:24.54,Default,,0,0,0,,.الآن، المعذرة
Dialogue: 0,1:01:24.63,1:01:27.17,Default,,0,0,0,,أأنت مهتمة بالعمل كنادلة\Nللطاولات في الطابق السفلي؟
Dialogue: 0,1:01:27.25,1:01:29.29,Default,,0,0,0,,يمكنني تحقيق ذلك من أجلك يا\N"توني"
Dialogue: 0,1:01:29.38,1:01:33.71,Default,,0,0,0,,قالت -\N"فيونا"
Dialogue: 0,1:01:33.79,1:01:37.29,Default,,0,0,0,,.لا، شكرًا. لا أريد -\N.بحقك. كنت أحاول مساعدتك -
Dialogue: 0,1:01:40.29,1:01:43.21,Default,,0,0,0,,أتظنين أنك تترفعين عن ذلك؟ -\N.لا أحتاج إلى هذا النوع من المساعدات -
Dialogue: 0,1:01:44.42,1:01:46.21,Default,,0,0,0,,.اتركني الآن
Dialogue: 0,1:01:47.25,1:01:50.04,Default,,0,0,0,,.أتظنين أنك ذكية؟ يتطلب الأمر مكالمة واحدة
Dialogue: 0,1:01:50.13,1:01:53.33,Default,,0,0,0,,لن تجري تلك المكالمة\N،لأن توظيفنا غير قانوني
Dialogue: 0,1:01:53.42,1:01:56.13,Default,,0,0,0,,.والتبليغ عنا سيؤذيك وحدك فقط
Dialogue: 0,1:01:56.21,1:01:58.67,Default,,0,0,0,,إلى من تظنين نفسك تتحدثين؟
Dialogue: 0,1:01:58.75,1:02:00.71,Default,,0,0,0,,!لا تلمسني، قلت لك أن تتركني
Dialogue: 0,1:02:00.79,1:02:01.79,Default,,0,0,0,,.اتركها
Dialogue: 0,1:02:05.71,1:02:07.04,Default,,0,0,0,,"فيونا"\N!
Dialogue: 0,1:02:09.46,1:02:10.58,Default,,0,0,0,,.إنه لا يتنفس
Dialogue: 0,1:02:15.50,1:02:16.83,Default,,0,0,0,,.لا
Dialogue: 0,1:02:19.50,1:02:21.33,Default,,0,0,0,,يا للهول! ماذا تفعل؟
Dialogue: 0,1:02:40.25,1:02:42.58,Default,,0,0,0,,.اتصلوا بالطوارئ -\Nكيف أجدت فعل ذلك؟ -
Dialogue: 0,1:02:42.67,1:02:44.13,Default,,0,0,0,,.إنها طبيبة
Dialogue: 0,1:02:45.79,1:02:47.71,Default,,0,0,0,,.فلنخرج من هنا
Dialogue: 0,1:02:47.79,1:02:50.04,Default,,0,0,0,,"(لاس فيغاس)"
Dialogue: 0,1:02:50.13,1:02:51.79,Default,,0,0,0,,أأنت بخير؟ -\N.أجل -
Dialogue: 0,1:02:51.96,1:02:53.17,Default,,0,0,0,,هل سيكون بخير؟
Dialogue: 0,1:02:53.25,1:02:55.54,Default,,0,0,0,,.لا أظن أنه سيكون بخير يومًا، لكنه سيعيش
Dialogue: 0,1:02:55.63,1:02:59.25,Default,,0,0,0,,.إنه مثل أي وغد آخر. لكنك كنت مذهلة
Dialogue: 0,1:02:59.33,1:03:00.83,Default,,0,0,0,,،رؤيتك تفعلين ذلك
Dialogue: 0,1:03:00.96,1:03:03.88,Default,,0,0,0,,.يجدر بك إنقاذ الأرواح لا تنظيف المراحيض
Dialogue: 0,1:03:04.00,1:03:08.21,Default,,0,0,0,,لكن لم أختار؟ يمكنني إنقاذ الأرواح\N.فيما أنظف المراحيض
Dialogue: 0,1:03:19.54,1:03:20.96,Default,,0,0,0,,أحسنت يا\N"جاز"
Dialogue: 0,1:03:24.58,1:03:28.00,Default,,0,0,0,,.جاز"، لقد حط النسر" -\N.عُلم -
Dialogue: 0,1:03:28.54,1:03:31.75,Default,,0,0,0,,مهلًا. ماذا تفعلين هنا؟\N.تجاوزت الساعة الـ2 فجرًا
Dialogue: 0,1:03:31.83,1:03:34.08,Default,,0,0,0,,.لم أستطع النوم يا أمي -\Nأين -
Dialogue: 0,1:03:34.17,1:03:37.54,Default,,0,0,0,,.كان يُفترض أن يراقبك -\N-
Dialogue: 0,1:03:41.67,1:03:42.83,Default,,0,0,0,,.رأيتك
Dialogue: 0,1:03:42.96,1:03:44.13,Default,,0,0,0,,"كريس"\N!
Dialogue: 0,1:03:45.38,1:03:47.58,Default,,0,0,0,,أين أنت يا\N"كريس"
Dialogue: 0,1:03:51.00,1:03:53.42,Default,,0,0,0,,!أنت. اخلدي إلى النوم فورًا
Dialogue: 0,1:03:54.75,1:03:56.92,Default,,0,0,0,,.هذا جزائي بسبب ما فعلته في صغري
Dialogue: 0,1:03:57.00,1:03:58.75,Default,,0,0,0,,.إنهما ملاكان مقارنةً بك
Dialogue: 0,1:04:01.71,1:04:03.75,Default,,0,0,0,,ما الأمر يا أمي؟ -\N-
Dialogue: 0,1:04:03.83,1:04:06.79,Default,,0,0,0,,ماذا تظن نفسك فاعلًا\Nبترك أختك وحدها في الخارج؟
Dialogue: 0,1:04:06.88,1:04:07.96,Default,,0,0,0,,.إنها بخير
Dialogue: 0,1:04:08.04,1:04:11.38,Default,,0,0,0,,إلى أن يتصل أحدهم بمنظمات خدمات الطفل\Nويرحلونني، ثم ماذا سيحدث؟
Dialogue: 0,1:04:11.46,1:04:13.75,Default,,0,0,0,,،لو أنجزت واجباتك المنزلية\N.لربما تصرفت بعقلانية أكثر
Dialogue: 0,1:04:13.83,1:04:15.38,Default,,0,0,0,,.لا يهم
Dialogue: 0,1:04:15.46,1:04:18.04,Default,,0,0,0,,!لا تقل "لا يهم" أمامي
Dialogue: 0,1:04:22.58,1:04:25.25,Default,,0,0,0,,طابتك ليلتك يا -\N"توني"
Dialogue: 0,1:04:33.08,1:04:34.17,Default,,0,0,0,,"محلول مطهر"
Dialogue: 0,1:04:53.38,1:04:54.50,Default,,0,0,0,,"لوكا"\N…
Dialogue: 0,1:04:56.42,1:05:01.75,Default,,0,0,0,,أخبرتك بألا تنتظرني\N.وبألا تلعب ألعاب الفيديو حتى وقت متأخر
Dialogue: 0,1:05:01.83,1:05:03.75,Default,,0,0,0,,.لا ألعب. إنه أبي
Dialogue: 0,1:05:03.83,1:05:06.96,Default,,0,0,0,,أخبرته بأنني مستيقظ لأراقب\N"جاز"
Dialogue: 0,1:05:07.04,1:05:09.04,Default,,0,0,0,,متى ستعود إلى المنزل لتلعب مع والدك؟
Dialogue: 0,1:05:09.13,1:05:10.17,Default,,0,0,0,,"ماركو"\N.
Dialogue: 0,1:05:11.17,1:05:14.46,Default,,0,0,0,,.حسنًا، سمعت أمك\Nناولها الهاتف واخلد إلى النوم، اتفقنا؟
Dialogue: 0,1:05:16.38,1:05:19.29,Default,,0,0,0,,.الرياضة هي الحياة -\N.الرياضة هي الحياة -
Dialogue: 0,1:05:19.38,1:05:20.79,Default,,0,0,0,,اضرب قبضتك بقبضتي يا\N"لوكا"
Dialogue: 0,1:05:22.13,1:05:23.25,Default,,0,0,0,,.حسنًا
Dialogue: 0,1:05:25.00,1:05:27.88,Default,,0,0,0,,.أين كنت؟ كنت أحاول التواصل معك
Dialogue: 0,1:05:27.96,1:05:30.71,Default,,0,0,0,,أعمل ليلًا يا -\N"ماركو"
Dialogue: 0,1:05:30.79,1:05:33.04,Default,,0,0,0,,.تمكثين هناك لسنة منذ أن انسحب ذلك المتبرع
Dialogue: 0,1:05:33.13,1:05:35.46,Default,,0,0,0,,.بل ثمانية أشهر -\Nما الذي تغير إذًا؟ -
Dialogue: 0,1:05:35.54,1:05:37.38,Default,,0,0,0,,ما زلت هذه العيادات ترفض استقبال\N"لوكا"
Dialogue: 0,1:05:37.46,1:05:40.88,Default,,0,0,0,,نحن مسجلون في قائمة المتبرعين يا\N"ماركو"
Dialogue: 0,1:05:40.96,1:05:42.54,Default,,0,0,0,,.سنتحدث عن ذلك لاحقًا
Dialogue: 0,1:05:46.00,1:05:50.04,Default,,0,0,0,,.حسنًا يا عزيزي، حان وقت الإقلاع
Dialogue: 0,1:05:51.08,1:05:52.67,Default,,0,0,0,,."مثل "نيل آرمسترونغ
Dialogue: 0,1:05:52.75,1:05:54.21,Default,,0,0,0,,."و"تشينو روك
Dialogue: 0,1:05:55.04,1:05:57.46,Default,,0,0,0,,حسنًا. إلى أين تريد الذهاب أولًا؟
Dialogue: 0,1:05:58.50,1:06:00.42,Default,,0,0,0,,.المريخ. لا، زحل
Dialogue: 0,1:06:00.50,1:06:01.96,Default,,0,0,0,,زحل؟ -\N.أجل -
Dialogue: 0,1:06:02.13,1:06:04.29,Default,,0,0,0,,.هذا؟ حسنًا -
Dialogue: 0,1:06:04.42,1:06:07.92,Default,,0,0,0,,.لأن حوله حلقة -\N.حسنًا. الآن أغمض عينيك -
Dialogue: 0,1:06:09.00,1:06:10.38,Default,,0,0,0,,أغمض عينيك
Dialogue: 0,1:06:11.54,1:06:13.17,Default,,0,0,0,,.واخلد إلى النوم
Dialogue: 0,1:06:14.58,1:06:19.54,Default,,0,0,0,,.منعدم الوزن وحر
Dialogue: 0,1:06:22.42,1:06:24.54,Default,,0,0,0,,،يعاني نقصًا مناعيًا نادرًا
Dialogue: 0,1:06:24.63,1:06:27.38,Default,,0,0,0,,ولا تُوجد سجلات للمتبرعين\N.بنخاع عظمي في الديار
Dialogue: 0,1:06:27.46,1:06:29.17,Default,,0,0,0,,.وابني كمبودي فلبيني
Dialogue: 0,1:06:29.29,1:06:32.08,Default,,0,0,0,,.لذا يكاد يكون إيجاد تطابق آخر مستحيلًا
Dialogue: 0,1:06:32.79,1:06:35.92,Default,,0,0,0,,"أجل، لهذا السبب أحالتنا جامعة "كاليفورنيا\N.في "لوس أنجلوس" إلى عيادتكم
Dialogue: 0,1:06:38.25,1:06:39.71,Default,,0,0,0,,.أجل، هذا رقمي
Dialogue: 0,1:06:40.83,1:06:43.67,Default,,0,0,0,,!شكرًا. تبًا
Dialogue: 0,1:06:43.75,1:06:45.63,Default,,0,0,0,,ما العمل إن لم يعاودوا الاتصال بك؟
Dialogue: 0,1:06:45.71,1:06:48.13,Default,,0,0,0,,.سأكسر بابهم إن اضطُررت
Dialogue: 0,1:06:48.21,1:06:52.00,Default,,0,0,0,,."شكرًا يا "تينا -\N.ولا شيء لكما -
Dialogue: 0,1:06:52.08,1:06:55.54,Default,,0,0,0,,.كلاكما مطرود -\N.مهلًا، ماذا؟ لا يجوز أن تفعل ذلك -
Dialogue: 0,1:06:55.63,1:06:58.67,Default,,0,0,0,,خسرت أهم تعاقد لتقديم الطعام لدي\N.بسبب هذه الحيلة التي نفذتها
Dialogue: 0,1:06:58.75,1:07:01.63,Default,,0,0,0,,أجل، لكن -\N"توني"
Dialogue: 0,1:07:01.71,1:07:04.96,Default,,0,0,0,,.أخبرتكما بأن بعض المهام قد تكون صعبة -\N.تقصد الاغتصاب -
Dialogue: 0,1:07:05.83,1:07:07.96,Default,,0,0,0,,."حسنًا، عملنا ثلاث ليال مع "ستيفي
Dialogue: 0,1:07:08.04,1:07:10.08,Default,,0,0,0,,.بما أنك كلفتنا بهذه المهمة، أنت مدين لنا
Dialogue: 0,1:07:10.17,1:07:12.33,Default,,0,0,0,,أتظنين أنك ستتقاضين أجرًا\Nمقابل هذه المهمة؟
Dialogue: 0,1:07:12.42,1:07:15.46,Default,,0,0,0,,أجل. إلا إذا أردت أن ننشر\N.أنك لا تدفع الأجور
Dialogue: 0,1:07:15.54,1:07:17.42,Default,,0,0,0,,ستعطينا ما تدين لنا به
Dialogue: 0,1:07:17.50,1:07:20.63,Default,,0,0,0,,،لأن إن غادرنا جميعًا\N.فستخسر أكثر من تعاقد واحد
Dialogue: 0,1:07:24.21,1:07:27.42,Default,,0,0,0,,.أتعرفان؟ أنتما مزعجتان
Dialogue: 0,1:07:28.17,1:07:29.71,Default,,0,0,0,,.لا مزيد من المناوبات معًا
Dialogue: 0,1:07:51.58,1:07:53.96,Default,,0,0,0,,انظري إلى هذا يا\N"توني"
Dialogue: 0,1:07:54.04,1:07:56.38,Default,,0,0,0,,.من أجل عيد ميلاد ابنتي "شيلبي" الـ16
Dialogue: 0,1:07:56.46,1:07:58.25,Default,,0,0,0,,ستحبه ابنتك يا\N"ثيو"
Dialogue: 0,1:08:00.04,1:08:03.21,Default,,0,0,0,,.آرمان"، الشخص الأهم حاليًا"\N.تسرني رؤيتك يا صديقي
Dialogue: 0,1:08:03.29,1:08:05.17,Default,,0,0,0,,تسرني رؤيتك أيضًا يا\N"ثيو"
Dialogue: 0,1:08:05.25,1:08:07.79,Default,,0,0,0,,.سيحدث الأمر كما أردت حدوثه
Dialogue: 0,1:08:07.88,1:08:09.42,Default,,0,0,0,,.رائع. لنشرب مشروبًا. أنا ظمآن
Dialogue: 0,1:08:09.50,1:08:11.50,Default,,0,0,0,,مهلًا، ما خطبك يا رجل؟
Dialogue: 0,1:08:11.58,1:08:13.38,Default,,0,0,0,,.هيا، أظهر بعض الاحترام -\Nماذا؟ -
Dialogue: 0,1:08:13.46,1:08:15.71,Default,,0,0,0,,.أعرف أن أباك لم يربك لتتصرف هكذا
Dialogue: 0,1:08:15.83,1:08:17.83,Default,,0,0,0,,.اعتذر -\N.لا بأس. لم يرني -
Dialogue: 0,1:08:17.92,1:08:19.79,Default,,0,0,0,,.أي أحد لا يمكنه رؤيتك فهو أعمى
Dialogue: 0,1:08:19.88,1:08:23.42,Default,,0,0,0,,!هيا، اعتذر -\N.حسنًا. آسف -
Dialogue: 0,1:08:24.04,1:08:26.29,Default,,0,0,0,,اتفقنا؟ -\Nهل أنت راضية؟ -
Dialogue: 0,1:08:27.08,1:08:28.29,Default,,0,0,0,,.لا بأس
Dialogue: 0,1:08:30.29,1:08:32.17,Default,,0,0,0,,.لنذهب ونشرب ذلك المشروب -\Nأأنت بخير؟ -
Dialogue: 0,1:08:32.25,1:08:34.88,Default,,0,0,0,,.ولنجن مالًا وفيرًا -\N.أأنت بخير؟ أنا أمزح -
Dialogue: 0,1:08:41.04,1:08:43.33,Default,,0,0,0,,.قلت لا. هيا
Dialogue: 0,1:08:43.46,1:08:45.38,Default,,0,0,0,,أتطلب مني أن أخسر القتال؟
Dialogue: 0,1:08:45.46,1:08:48.08,Default,,0,0,0,,!تبًا لهذا الهراء -\N.أنا لا أطلب -
Dialogue: 0,1:08:48.17,1:08:50.13,Default,,0,0,0,,ديفا"؟" -\N.مستحيل -
Dialogue: 0,1:08:51.17,1:08:53.46,Default,,0,0,0,,بذلت قصارى جهدي من أجل هذا يا\N"ثيو"
Dialogue: 0,1:08:53.54,1:08:55.08,Default,,0,0,0,,.هذا ليس منوطًا بك
Dialogue: 0,1:08:56.21,1:08:58.75,Default,,0,0,0,,.اسمعي، لدي عائلتي. ابنتي
Dialogue: 0,1:08:58.83,1:09:01.25,Default,,0,0,0,,.هذا أهم منا جميعًا
Dialogue: 0,1:09:03.63,1:09:05.33,Default,,0,0,0,,.ستجعلين القتال يظهر بمظهر جيد
Dialogue: 0,1:09:06.17,1:09:07.50,Default,,0,0,0,,.ثم تخسرين شر خسارة
Dialogue: 0,1:09:20.29,1:09:22.04,Default,,0,0,0,,.يظنون دائمًا أنهم يملكوننا
Dialogue: 0,1:09:23.67,1:09:24.88,Default,,0,0,0,,.فقط إن سمحنا لهم بذلك
Dialogue: 0,1:09:40.79,1:09:42.13,Default,,0,0,0,,!أجل
Dialogue: 0,1:09:53.54,1:09:54.88,Default,,0,0,0,,!هيا. انهضي
Dialogue: 0,1:10:30.04,1:10:32.67,Default,,0,0,0,,."يعجبني ما تفعلينه يا "ديفا\N.يعجبني ما تفعلينه يا فتاة
Dialogue: 0,1:10:44.63,1:10:47.13,Default,,0,0,0,,أهلًا يا -\N"في"
Dialogue: 0,1:10:47.21,1:10:49.17,Default,,0,0,0,,.لو راهنت، لفزت بالرهان
Dialogue: 0,1:10:49.25,1:10:52.21,Default,,0,0,0,,ربما علينا المشاركة في القتالات\N.لأن الأجر سيكون أفضل
Dialogue: 0,1:10:52.29,1:10:53.50,Default,,0,0,0,,.هذا صحيح
Dialogue: 0,1:10:53.58,1:10:55.71,Default,,0,0,0,,."أفسح "ماني باكياو" المجال لـ"ليدي لاك
Dialogue: 0,1:10:55.79,1:10:58.58,Default,,0,0,0,,،"إن كنت "لادي لاك\N.فيُستحسن أن يتغير حظنا بسرعة
Dialogue: 0,1:10:59.88,1:11:02.63,Default,,0,0,0,,.ثيو"، لم ننته بعد" -\N.اسمع، سأتولى هذا -
Dialogue: 0,1:11:02.71,1:11:04.58,Default,,0,0,0,,سأتولى هذا، اتفقنا؟ -\N-
Dialogue: 0,1:11:04.67,1:11:06.63,Default,,0,0,0,,.لم يكن هناك ما يمكنني فعله -\N!تبًا لذلك -
Dialogue: 0,1:11:06.71,1:11:09.67,Default,,0,0,0,,.أنت -\N.أنا لها -
Dialogue: 0,1:11:09.75,1:11:11.75,Default,,0,0,0,,سنجد حلًا، اتفقنا؟
Dialogue: 0,1:11:11.83,1:11:13.50,Default,,0,0,0,,عليك أن تهدأ يا رجل، اتفقنا؟
Dialogue: 0,1:11:13.58,1:11:15.58,Default,,0,0,0,,.أجل يا رجل، نحن هادؤون -\N.أقسم إن هذا لم يحدث قط -
Dialogue: 0,1:11:15.67,1:11:16.71,Default,,0,0,0,,.حسنًا
Dialogue: 0,1:11:21.75,1:11:24.50,Default,,0,0,0,,ماذا كان ذلك؟ -\N.سئمت أعذاره -
Dialogue: 0,1:11:24.58,1:11:26.33,Default,,0,0,0,,.مهلًا، لا
Dialogue: 0,1:11:29.08,1:11:31.00,Default,,0,0,0,,.اخرج من هنا يا رجل
Dialogue: 0,1:11:31.08,1:11:32.63,Default,,0,0,0,,!اخرج من هنا فورًا
Dialogue: 0,1:12:22.29,1:12:24.00,Default,,0,0,0,,.أنا عاملة النظافة فحسب
Dialogue: 0,1:12:27.17,1:12:28.79,Default,,0,0,0,,.دعوني أنظف هذا نيابةً عنكم
Dialogue: 0,1:12:47.88,1:12:50.08,Default,,0,0,0,,.إن انتظرتم، سيتسرب الدم إلى الأسمنت
Dialogue: 0,1:12:50.17,1:12:51.88,Default,,0,0,0,,.سنُضطر إلى كسره
Dialogue: 0,1:12:53.21,1:12:54.92,Default,,0,0,0,,.بيروكسيد الصوديوم هو أفضل حل
Dialogue: 0,1:13:00.29,1:13:02.21,Default,,0,0,0,,من أنت؟ هل أنت متخصصة؟
Dialogue: 0,1:13:03.17,1:13:05.33,Default,,0,0,0,,.يمكنني مساعدتكم على إخفاء هذا
Dialogue: 0,1:13:06.42,1:13:08.17,Default,,0,0,0,,.سيفي مبيض وماء مغلي بالغرض
Dialogue: 0,1:13:08.25,1:13:10.04,Default,,0,0,0,,.ماء بارد
Dialogue: 0,1:13:10.13,1:13:11.42,Default,,0,0,0,,.تخلف الحرارة بقعة
Dialogue: 0,1:13:20.17,1:13:22.38,Default,,0,0,0,,.دعها تنجز عملها فحسب. ربما تتعلم شيئًا
Dialogue: 0,1:14:13.46,1:14:15.63,Default,,0,0,0,,.قال إنه سيطعم ابنه على هذه الأرضية
Dialogue: 0,1:14:18.29,1:14:21.29,Default,,0,0,0,,.أفتخر بعملي لأنني لدي عائلة تحتاج إلي
Dialogue: 0,1:14:25.29,1:14:28.21,Default,,0,0,0,,هل تودين احتساء مشروب؟ -\N.الوقت متأخر -
Dialogue: 0,1:14:29.75,1:14:31.83,Default,,0,0,0,,.اسمي "آرمان"، إن كان يشكل ذلك فارقًا
Dialogue: 0,1:14:35.08,1:14:37.25,Default,,0,0,0,,من أين أنت؟ -\N."كمبوديا" -
Dialogue: 0,1:14:39.00,1:14:40.50,Default,,0,0,0,,."أعيش في "الفلبين
Dialogue: 0,1:14:42.58,1:14:44.21,Default,,0,0,0,,.وسأعود قريبًا
Dialogue: 0,1:14:45.08,1:14:46.63,Default,,0,0,0,,.لا أريد أي مشكلات
Dialogue: 0,1:14:55.04,1:14:57.50,Default,,0,0,0,,"مبني على المسلسل الأرجنتيني الأصلي"
Dialogue: 0,1:15:03.17,1:15:05.46,Default,,0,0,0,,.علي العودة إلى عائلتي حقًا
Dialogue: 0,1:15:13.75,1:15:16.33,Default,,0,0,0,,.فلنوصلك إلى المنزل قبل أن يفتقدوك كثيرًا
Dialogue: 0,1:16:39.88,1:16:42.79,Default,,0,0,0,,.أفهمت؟ لهذا السبب أمي تحبك أكثر مني
Dialogue: 0,1:16:42.88,1:16:47.04,Default,,0,0,0,,رغم أنني لا أفهم سبب رغبتك في التنظيف\N.بعد التنظيف طوال الليل
Dialogue: 0,1:16:47.13,1:16:50.08,Default,,0,0,0,,.لا أرغب في التنظيف\N.إنما أريد أن تكون الأشياء نظيفة
Dialogue: 0,1:16:50.17,1:16:52.50,Default,,0,0,0,,أعرف أنك تعيشين حياة متواضعة\N.أيتها الطبيبة
Dialogue: 0,1:16:55.88,1:16:57.38,Default,,0,0,0,,.أنت
Dialogue: 0,1:16:57.46,1:16:59.33,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,1:16:59.42,1:17:02.54,Default,,0,0,0,,تفعلين هذا لتنفسي عن توترك. ما الخطب؟
Dialogue: 0,1:17:02.67,1:17:05.75,Default,,0,0,0,,.أحتاج إلى سيارتك\Nسأصطحب
Dialogue: 0,1:17:06.79,1:17:08.50,Default,,0,0,0,,.حسنًا. لنتحدث
Dialogue: 0,1:17:09.13,1:17:12.75,Default,,0,0,0,,ثمة سبب لعدم دخول معظم المهاجرين\N.غير الشرعيين إلى مستشفى
Dialogue: 0,1:17:12.83,1:17:17.08,Default,,0,0,0,,إن دخلت إلى هناك\N.وتحدثت إلى الشخص الخطأ فستهلكين
Dialogue: 0,1:17:17.17,1:17:19.29,Default,,0,0,0,,.مفهوم؟ علينا التواري عن الأنظار
Dialogue: 0,1:17:19.38,1:17:23.04,Default,,0,0,0,,لا، سئمت الانتظار. كل يوم يمر\Nيعرض
Dialogue: 0,1:17:23.13,1:17:24.83,Default,,0,0,0,,ماذا لو أصابني مكروه؟
Dialogue: 0,1:17:24.92,1:17:26.21,Default,,0,0,0,,…إن أصابك مكروه
Dialogue: 0,1:17:29.00,1:17:30.50,Default,,0,0,0,,."فسأعتني بـ"لوكا
Dialogue: 0,1:17:31.04,1:17:34.46,Default,,0,0,0,,لكن إن كان هناك أمر\N…تريدين التحدث عنه الآن
Dialogue: 0,1:17:41.83,1:17:43.29,Default,,0,0,0,,.أحتاج إلى مفاتيحك فحسب
Dialogue: 0,1:17:52.21,1:17:53.58,Default,,0,0,0,,،فقط
Dialogue: 0,1:17:54.13,1:17:55.79,Default,,0,0,0,,.انتبهي لكيلا توقفك الشرطة
Dialogue: 0,1:18:22.08,1:18:23.42,Default,,0,0,0,,.تفضل يا عزيزي
Dialogue: 0,1:18:27.83,1:18:29.00,Default,,0,0,0,,توني دي لا روزا"؟"
Dialogue: 0,1:18:31.96,1:18:34.04,Default,,0,0,0,,.سأعود بعد قليل يا عزيزي. ابق هنا فحسب
Dialogue: 0,1:18:35.25,1:18:36.58,Default,,0,0,0,,.صباح الخير
Dialogue: 0,1:18:36.67,1:18:38.54,Default,,0,0,0,,تحدثت إلى\N"الطبيب "رامتيج
Dialogue: 0,1:18:38.63,1:18:41.67,Default,,0,0,0,,وأرسل إلي تأشيرتك\N.من أجل إجراء عملية زرع نخاع عظمي
Dialogue: 0,1:18:41.75,1:18:42.75,Default,,0,0,0,,.انتهت صلاحيتها
Dialogue: 0,1:18:43.75,1:18:46.33,Default,,0,0,0,,انسحب المتبرع
Dialogue: 0,1:18:46.42,1:18:48.75,Default,,0,0,0,,…وكنا ننتظر تطابقًا آخر منذ
Dialogue: 0,1:18:48.83,1:18:50.67,Default,,0,0,0,,هل مُددت مدة تأشيرتك؟
Dialogue: 0,1:18:52.08,1:18:55.33,Default,,0,0,0,,.إنها قيد التنفيذ -\Nلم تُمدد مدتها إذًا؟ -
Dialogue: 0,1:18:57.83,1:18:59.67,Default,,0,0,0,,.يؤسفني أننا لا يمكننا مساعدتك
Dialogue: 0,1:19:02.92,1:19:04.21,Default,,0,0,0,,.رجاءً يا سيدتي
Dialogue: 0,1:19:05.75,1:19:08.88,Default,,0,0,0,,يحتاج ابني إلى هذا العلاج الجيني
Dialogue: 0,1:19:08.96,1:19:10.42,Default,,0,0,0,,.وإلا لن يعيش
Dialogue: 0,1:19:12.79,1:19:15.17,Default,,0,0,0,,هل سترفضين استقبال فتى بعمر الخامسة حقًا؟
Dialogue: 0,1:19:17.13,1:19:19.00,Default,,0,0,0,,ماذا لو كان ابنك؟
Dialogue: 0,1:19:19.08,1:19:22.38,Default,,0,0,0,,آسفة، لكن أي شخص لا يلتزم إجراءاتنا\N.يُعد غير مؤهل
Dialogue: 0,1:19:22.46,1:19:25.50,Default,,0,0,0,,،إن قرأت هذه الوثائق مجددًا\Nفستعرفين أنني طبيبة
Dialogue: 0,1:19:25.58,1:19:28.21,Default,,0,0,0,,في أحد أكثر المراكز الطبية ازدحامًا\Nفي
Dialogue: 0,1:19:28.29,1:19:30.21,Default,,0,0,0,,.بالطبع سألتزم -\N.أنت مهاجرة غير شرعية -
Dialogue: 0,1:19:30.29,1:19:34.88,Default,,0,0,0,,لا يمكننا المخاطرة بترحيل ابنك قبل انتهاء\N.الفترة التجريبية المقدرة بـ52 أسبوعًا
Dialogue: 0,1:19:34.96,1:19:36.54,Default,,0,0,0,,.الآن، المعذرة
Dialogue: 0,1:19:37.58,1:19:40.67,Default,,0,0,0,,معهد طب الخلايا الجذعية"، بم أساعدك؟"
Dialogue: 0,1:19:42.88,1:19:44.25,Default,,0,0,0,,أجل، ما اسمك؟
Dialogue: 0,1:19:50.50,1:19:52.13,Default,,0,0,0,,هيا يا\N"لوكا"
Dialogue: 0,1:19:52.21,1:19:54.96,Default,,0,0,0,,.لا. قلت إننا سنقابل الطبيب
Dialogue: 0,1:19:55.04,1:19:56.67,Default,,0,0,0,,.علينا الرحيل -\N.لا أريد الرحيل -
Dialogue: 0,1:19:56.75,1:19:58.58,Default,,0,0,0,,.هذا ظلم يا أمي
Dialogue: 0,1:19:58.71,1:20:00.83,Default,,0,0,0,,أعرف يا\N"لوكا"
Dialogue: 0,1:20:01.00,1:20:04.71,Default,,0,0,0,,لكن حان وقت الرحيل الآن، اتفقنا؟
Dialogue: 0,1:20:06.46,1:20:09.42,Default,,0,0,0,,.اتفقنا -\N.هذا ابني المطيع -
Dialogue: 0,1:20:09.50,1:20:11.42,Default,,0,0,0,,.خذ حقيبتك
Dialogue: 0,1:20:11.50,1:20:13.25,Default,,0,0,0,,.وداعًا
Dialogue: 0,1:20:26.79,1:20:28.96,Default,,0,0,0,,.أخبره بأنني أريد مقابلته
Dialogue: 0,1:21:01.13,1:21:06.08,Default,,0,0,0,,.أيًا كان ما تريده مني، ابتعد عن ابني
Dialogue: 0,1:21:06.17,1:21:07.96,Default,,0,0,0,,.لم أقل شيئًا لأحد
Dialogue: 0,1:21:08.04,1:21:10.25,Default,,0,0,0,,.لا أريد أن يلاحقني رجالك بهذه الطريقة
Dialogue: 0,1:21:10.33,1:21:11.83,Default,,0,0,0,,.أحسنت
Dialogue: 0,1:21:12.88,1:21:14.21,Default,,0,0,0,,.أريدك أن تعملي تحت إمرتنا
Dialogue: 0,1:21:14.29,1:21:17.25,Default,,0,0,0,,هذا أجرك لليلة الفائتة\N.وهاتف غير قابل للتتبع
Dialogue: 0,1:21:18.29,1:21:21.58,Default,,0,0,0,,.لا. أنا لست للبيع
Dialogue: 0,1:21:21.67,1:21:25.29,Default,,0,0,0,,،فعلت ما فعلته لأبقى حية\N.لكن هذه ليست طبيعتي
Dialogue: 0,1:21:25.38,1:21:28.67,Default,,0,0,0,,،اسمعي، لدينا طبيب يعمل تحت إمرتنا\N"الطبيب "سارويان
Dialogue: 0,1:21:30.33,1:21:32.17,Default,,0,0,0,,.لست شخصًا يمكن شراؤه
Dialogue: 0,1:21:32.25,1:21:35.38,Default,,0,0,0,,لا، من الواضح أنك امرأة\N.كانت تحظى بالاحترام
Dialogue: 0,1:21:35.46,1:21:37.79,Default,,0,0,0,,.هذا ما أعرضه عليك الآن
Dialogue: 0,1:21:37.88,1:21:40.92,Default,,0,0,0,,.اسمعي، أنا وأنت في بلد ليس بلدنا
Dialogue: 0,1:21:41.88,1:21:44.96,Default,,0,0,0,,.لا نتمتع بالامتيازات التي يتمتع بها غيرنا
Dialogue: 0,1:21:45.04,1:21:47.08,Default,,0,0,0,,،حين يتعلق الأمر بإبقاء ابنك حيًا
Dialogue: 0,1:21:47.17,1:21:49.71,Default,,0,0,0,,لا يتعلق الأمر بتنفيذ الأمور\Nبالطريقة الصحيحة أو الخطأ
Dialogue: 0,1:21:49.79,1:21:51.13,Default,,0,0,0,,.لكن بأي طريقة ممكنة
Dialogue: 0,1:21:51.21,1:21:53.71,Default,,0,0,0,,.أريدك أن تأخذي هذا وتفكري في ذلك
Dialogue: 0,1:21:57.67,1:21:58.83,Default,,0,0,0,,لماذا؟
Dialogue: 0,1:22:00.29,1:22:02.54,Default,,0,0,0,,لماذا تريدني أن أعمل لصالحك؟
Dialogue: 0,1:22:02.63,1:22:04.46,Default,,0,0,0,,.لأنك تعجبينني
Dialogue: 0,1:22:07.79,1:22:09.58,Default,,0,0,0,,.ولا أريد أن أُضطر إلى قتلك
Dialogue: 0,1:22:35.21,1:22:38.17,Default,,0,0,0,,في"، أحضرت بعض محاليل"\N.التنظيف الجديدة لأجربها
Dialogue: 0,1:22:38.25,1:22:39.54,Default,,0,0,0,,.تبًا للتنظيف
Dialogue: 0,1:22:39.63,1:22:41.21,Default,,0,0,0,,تبين أن\N"براندون"
Dialogue: 0,1:22:41.29,1:22:44.21,Default,,0,0,0,,هو مدير\N"غولدن فينيكس"
Dialogue: 0,1:22:44.29,1:22:47.33,Default,,0,0,0,,.سنقدم المشروبات بدلًا من تنظيف المراحيض
Dialogue: 0,1:22:47.42,1:22:51.29,Default,,0,0,0,,لم عساه يعين شخصًا من دون تأشيرة عمل\Nفي مكان كهذا؟
Dialogue: 0,1:22:51.38,1:22:54.75,Default,,0,0,0,,.إن نجحت علاقتي به، ربما يتغاضى عن الوثائق
Dialogue: 0,1:22:55.54,1:22:58.46,Default,,0,0,0,,تمهلي، لطالما تتسرعين في علاقاتك\N.بهؤلاء الرجال
Dialogue: 0,1:22:58.54,1:23:01.04,Default,,0,0,0,,ولقد تعلمت، اتفقنا؟\N.لذا لا أحتاج إلى انتقادك
Dialogue: 0,1:23:01.13,1:23:02.88,Default,,0,0,0,,.لا أنتقدك -\N.جيد -
Dialogue: 0,1:23:02.96,1:23:06.46,Default,,0,0,0,,لأنني سأقابله في الملهى الليلة\N.وقلت إنك قادمة
Dialogue: 0,1:23:07.25,1:23:12.29,Default,,0,0,0,,لا. أعمل ليال عديدة، لا يمكنني ترك\N"لوكا"
Dialogue: 0,1:23:12.38,1:23:16.75,Default,,0,0,0,,.لا، إنها مقابلة عمل. فرصة حقيقية
Dialogue: 0,1:23:16.83,1:23:19.50,Default,,0,0,0,,،"ولن نغادر إلا بعد أن ينام "لوكا
Dialogue: 0,1:23:19.63,1:23:22.96,Default,,0,0,0,,وسأحرص على أن يرعاه\N"كريس"
Dialogue: 0,1:23:23.83,1:23:25.08,Default,,0,0,0,,.بحقك
Dialogue: 0,1:23:25.17,1:23:29.38,Default,,0,0,0,,متى كانت آخر مرة تأنقنا وذهبنا للرقص فيها؟
Dialogue: 0,1:23:30.58,1:23:32.88,Default,,0,0,0,,.بحقك، لم تري "فيغاس" الحقيقية حتى
Dialogue: 0,1:23:35.33,1:23:36.38,Default,,0,0,0,,مرحبًا؟
Dialogue: 0,1:23:36.54,1:23:38.25,Default,,0,0,0,,مرحبًا. هذا مكتب\N"الطبيب "كيرشنر
Dialogue: 0,1:23:38.33,1:23:40.63,Default,,0,0,0,,أتصل لأحدد موعدًا من أجل\N"لوكا"
Dialogue: 0,1:23:40.71,1:23:42.25,Default,,0,0,0,,ما رأيك في الخميس القادم في الـ11؟
Dialogue: 0,1:23:42.33,1:23:44.13,Default,,0,0,0,,.أجل، هذا ممتاز
Dialogue: 0,1:23:45.17,1:23:47.54,Default,,0,0,0,,أجل، لكن ماذا عن الوثائق؟
Dialogue: 0,1:23:47.67,1:23:50.00,Default,,0,0,0,,بما أن\N"الطبيب "سارويان
Dialogue: 0,1:23:50.08,1:23:52.29,Default,,0,0,0,,.قال الطبيب إنها لن تكون مشكلة
Dialogue: 0,1:23:53.42,1:23:57.79,Default,,0,0,0,,"الطبيب "سارويان\N.؟ أجل، بالطبع
Dialogue: 0,1:23:57.88,1:24:01.13,Default,,0,0,0,,.عظيم. أتمنى لك يومًا سعيدًا -\N.أنت أيضًا. شكرًا -
Dialogue: 0,1:24:03.54,1:24:07.63,Default,,0,0,0,,.إنها عيادة الخلايا الجذعية\Nوسيفحصون
Dialogue: 0,1:24:09.00,1:24:11.71,Default,,0,0,0,,!رباه -\N.رباه! أنت "ليدي لاك" حقًا -
Dialogue: 0,1:24:13.58,1:24:16.50,Default,,0,0,0,,.حسنًا، لنفعلها. لنخرج ونستمتع بوقتنا
Dialogue: 0,1:24:16.58,1:24:20.88,Default,,0,0,0,,…أجل! مهلًا. ماذا سترتدين؟ لا
Dialogue: 0,1:24:20.96,1:24:23.46,Default,,0,0,0,,.لا عليك. سأتولى هذا\Nل
Dialogue: 0,1:24:23.54,1:24:24.96,Default,,0,0,0,,.لا، سأتولى هذا
Dialogue: 0,1:24:56.79,1:24:58.71,Default,,0,0,0,,!تأملي حالك. تأملي حالنا
Dialogue: 0,1:24:58.79,1:25:00.63,Default,,0,0,0,,.نحن مثيرتان كهذه النادلات
Dialogue: 0,1:25:00.71,1:25:03.08,Default,,0,0,0,,أتعرفين كم تجني هذه الفتيات في ليلة واحدة؟
Dialogue: 0,1:25:03.17,1:25:05.21,Default,,0,0,0,,.أكثر مما نجنيه في أسبوع -\N.هذا واضح من أحذيتهن -
Dialogue: 0,1:25:05.33,1:25:06.71,Default,,0,0,0,,أتقصدين أثداءهن؟
Dialogue: 0,1:25:07.71,1:25:10.50,Default,,0,0,0,,.ولا تقلقي، إن نجح هذا، فسنشتري زوجين
Dialogue: 0,1:25:12.50,1:25:13.63,Default,,0,0,0,,-\N"فيونا"
Dialogue: 0,1:25:13.71,1:25:15.29,Default,,0,0,0,,.أهلًا، لقد أتيت
Dialogue: 0,1:25:15.38,1:25:17.29,Default,,0,0,0,,…ولا بد أن هذه -\N-
Dialogue: 0,1:25:17.38,1:25:18.92,Default,,0,0,0,,.أختي من أم أخرى
Dialogue: 0,1:25:19.00,1:25:21.21,Default,,0,0,0,,سمعت كل شيء عنك يا\N"توني"
Dialogue: 0,1:25:21.29,1:25:23.58,Default,,0,0,0,,ما رأيكما في منصتنا للشخصيات المهمة؟
Dialogue: 0,1:25:23.67,1:25:27.08,Default,,0,0,0,,.لديها إطلالة مذهلة
Dialogue: 0,1:25:27.17,1:25:29.92,Default,,0,0,0,,.حجز الطاولات هنا يبدأ بألف دولار كحد أدنى
Dialogue: 0,1:25:30.00,1:25:31.75,Default,,0,0,0,,.إنه مصدر رزقنا
Dialogue: 0,1:25:31.83,1:25:37.25,Default,,0,0,0,,تتراوح أسعار الزجاجات من 600 دولار للفودكا\N.إلى 24 ألف لستة لترات من الشامبانيا
Dialogue: 0,1:25:37.33,1:25:39.08,Default,,0,0,0,,.بالإضافة إلى الإكرامية بالطبع
Dialogue: 0,1:25:39.79,1:25:42.75,Default,,0,0,0,,ما رأيكما في شرب مشروب آخر\Nثم ندردش لبعض الوقت؟
Dialogue: 0,1:25:42.83,1:25:44.50,Default,,0,0,0,,.أجل -\Nاتفقنا؟ -
Dialogue: 0,1:25:44.58,1:25:46.79,Default,,0,0,0,,هل أخبرتها؟ -\N.بالطبع -
Dialogue: 0,1:25:46.88,1:25:48.00,Default,,0,0,0,,.جيد
Dialogue: 0,1:25:48.08,1:25:51.50,Default,,0,0,0,,.حسنًا، سآخذهما وأعود بعد قليل
Dialogue: 0,1:25:51.58,1:25:52.71,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,1:25:54.54,1:25:56.63,Default,,0,0,0,,تخبرينني بماذا؟
Dialogue: 0,1:25:56.71,1:25:58.50,Default,,0,0,0,,.حسنًا، اسمعي، إليك ما سنفعله
Dialogue: 0,1:25:58.63,1:26:02.54,Default,,0,0,0,,قال\N"براندون"
Dialogue: 0,1:26:02.63,1:26:04.42,Default,,0,0,0,,نبيع ماذا؟
Dialogue: 0,1:26:04.50,1:26:06.25,Default,,0,0,0,,."إي" اختصارًا لـ"إكستاسي"
Dialogue: 0,1:26:06.33,1:26:09.08,Default,,0,0,0,,!أتقصدين المخدرات؟ "في"، لا
Dialogue: 0,1:26:09.25,1:26:11.63,Default,,0,0,0,,.إنه ليس مخدرًا. بل يُتناول في الحفلات
Dialogue: 0,1:26:11.71,1:26:13.92,Default,,0,0,0,,أهذه هي الطريقة الوحيدة\Nالتي سيعينك بها
Dialogue: 0,1:26:14.00,1:26:17.04,Default,,0,0,0,,.أجل، لكن يا عزيزتي، تخيلي أن نعمل هنا
Dialogue: 0,1:26:17.13,1:26:20.38,Default,,0,0,0,,بحقك. لـ15 عامًا، كنت أنتقل من وظيفة سيئة\N.إلى أخرى
Dialogue: 0,1:26:20.46,1:26:23.83,Default,,0,0,0,,هذه فرصتي لأجني مالًا وفيرًا\N.في مكان لا أخجل من العمل فيه
Dialogue: 0,1:26:24.79,1:26:26.38,Default,,0,0,0,,.لذا لا تفسدي هذا علي
Dialogue: 0,1:26:29.29,1:26:32.58,Default,,0,0,0,,إنها "ماريا". على الأرجح تتصل بي\N.لأحل محلها في مناوبتها الليلة
Dialogue: 0,1:26:33.21,1:26:36.00,Default,,0,0,0,,.في"، لا تفعلي هذا رجاءً"
Dialogue: 0,1:26:36.08,1:26:38.21,Default,,0,0,0,,.اذهبي فحسب
Dialogue: 0,1:26:42.25,1:26:44.46,Default,,0,0,0,,مرحبًا؟ -\Nما الذي يؤخرك؟ -
Dialogue: 0,1:26:44.54,1:26:47.38,Default,,0,0,0,,…أنا -\N.لا عليك، أنا قادم -
Dialogue: 0,1:26:47.46,1:26:50.96,Default,,0,0,0,,.لا، أنا لست في المنزل. أنا في الخارج\Nأنا في
Dialogue: 0,1:26:51.04,1:26:53.33,Default,,0,0,0,,.حسنًا، سأقبلك في نادي القمار إذًا
Dialogue: 0,1:27:09.17,1:27:11.17,Default,,0,0,0,,.علي تغيير ملابسي
Dialogue: 0,1:27:11.83,1:27:14.00,Default,,0,0,0,,.لا يُوجد وقت، لكن لن تتسخ ملابسك
Dialogue: 0,1:27:16.58,1:27:17.92,Default,,0,0,0,,.يليق هذا اللون بك
Dialogue: 0,1:27:21.29,1:27:24.25,Default,,0,0,0,,أردت أن أشكرك على الاتصال بالعيادة\N.من أجل ابني
Dialogue: 0,1:27:24.33,1:27:25.92,Default,,0,0,0,,.هذا ليس أمرًا جللًا
Dialogue: 0,1:27:26.71,1:27:28.38,Default,,0,0,0,,هل كان موعدًا غراميًا؟
Dialogue: 0,1:27:30.17,1:27:32.38,Default,,0,0,0,,.لا، كانت سهرة فتيات
Dialogue: 0,1:27:32.46,1:27:34.08,Default,,0,0,0,,.هذا جيد
Dialogue: 0,1:27:34.17,1:27:37.04,Default,,0,0,0,,.لا يمكن أن يتعلق كل شيء بابنك -\N.المعذرة -
Dialogue: 0,1:27:37.13,1:27:39.29,Default,,0,0,0,,.كانت أمي مدبرة منزل
Dialogue: 0,1:27:40.54,1:27:43.58,Default,,0,0,0,,.كانت تعمل لستة أو سبعة أيام في الأسبوع
Dialogue: 0,1:27:43.67,1:27:46.58,Default,,0,0,0,,.كان هناك أمر وحيد لطالما أردته لها
Dialogue: 0,1:27:46.67,1:27:48.29,Default,,0,0,0,,.أن أراها سعيدة فحسب
Dialogue: 0,1:27:48.38,1:27:51.38,Default,,0,0,0,,.أراهن بأن هذا بالضبط ما يريده ابنك لك
Dialogue: 0,1:27:53.21,1:27:54.67,Default,,0,0,0,,.هيا، فلنذهب
Dialogue: 0,1:28:07.42,1:28:09.96,Default,,0,0,0,,!أخرجوا كل هؤلاء الفتيات فورًا! سنوقف هذا
Dialogue: 0,1:28:14.21,1:28:15.25,Default,,0,0,0,,.اقتربي يا عزيزتي
Dialogue: 0,1:28:22.75,1:28:25.25,Default,,0,0,0,,.لم أقل أن تفعلوا هذا هنا قط\N.الآن، اذهبي واعثري عليها
Dialogue: 0,1:28:25.33,1:28:26.63,Default,,0,0,0,,.اسمعي
Dialogue: 0,1:28:26.71,1:28:29.58,Default,,0,0,0,,لا يجوز أن يعرف زعيمي\Nأن أيًا من هذا حدث هنا الليلة
Dialogue: 0,1:28:29.67,1:28:31.00,Default,,0,0,0,,.وإلا ستكون حياتي على المحك
Dialogue: 0,1:28:31.08,1:28:32.67,Default,,0,0,0,,.أريد أن يُنظف كل هذا بحلول الفجر
Dialogue: 0,1:28:32.75,1:28:35.21,Default,,0,0,0,,.هناك أمر آخر. لا تتحدثي إلى أي أحد هنا
Dialogue: 0,1:28:35.29,1:28:36.33,Default,,0,0,0,,مفهوم؟
Dialogue: 0,1:28:53.67,1:28:56.25,Default,,0,0,0,,.أين هو؟ حان وقت العودة إلى المنزل
Dialogue: 0,1:28:56.88,1:28:58.25,Default,,0,0,0,,.أسرعوا
Dialogue: 0,1:28:59.88,1:29:01.04,Default,,0,0,0,,.هيا
Dialogue: 0,1:29:12.25,1:29:14.67,Default,,0,0,0,,آسف. أأنت بخير؟
Dialogue: 0,1:29:16.88,1:29:19.88,Default,,0,0,0,,.بضع كدمات أخرى لن تقتلني
Dialogue: 0,1:29:23.58,1:29:27.75,Default,,0,0,0,,،لكن إن أردت إيذائي فعلًا\N.فيمكنني أن أريك بعض الحيل
Dialogue: 0,1:29:29.50,1:29:32.29,Default,,0,0,0,,.رباه، أنت جميلة
Dialogue: 0,1:29:33.29,1:29:34.42,Default,,0,0,0,,أنا\N"ناديا"
Dialogue: 0,1:29:35.58,1:29:38.42,Default,,0,0,0,,،انتهت الحفلة\N.لذا يمكنك العودة إلى المنزل الآن
Dialogue: 0,1:29:42.17,1:29:44.08,Default,,0,0,0,,أتريدين مني أن أتصل بأحد من أجلك؟
Dialogue: 0,1:29:45.13,1:29:47.63,Default,,0,0,0,,.أجل، يُفترض أن يأتي زوجي
Dialogue: 0,1:29:47.71,1:29:50.96,Default,,0,0,0,,تعلمت أن الأزواج\N.قد يكونون غير جديرين بالثقة
Dialogue: 0,1:29:51.54,1:29:52.58,Default,,0,0,0,,…لذا
Dialogue: 0,1:29:53.88,1:29:55.88,Default,,0,0,0,,.حسنًا، سأحضر لك بعض الماء
Dialogue: 0,1:29:55.96,1:29:59.96,Default,,0,0,0,,،هذا لطف بالغ منك يا عزيزتي\N.لكنني سأستلقي هنا لدقيقة أخرى
Dialogue: 0,1:30:59.25,1:31:00.29,Default,,0,0,0,,.أنت متسخة
Dialogue: 0,1:31:01.79,1:31:03.58,Default,,0,0,0,,أفضل مصطلح
Dialogue: 0,1:31:05.00,1:31:06.00,Default,,0,0,0,,.قذرة
Dialogue: 0,1:31:07.50,1:31:09.42,Default,,0,0,0,,.أرى أنك قابلت زوجتي
Dialogue: 0,1:31:09.50,1:31:12.17,Default,,0,0,0,,.أنت مفسد حفلات
Dialogue: 0,1:31:12.25,1:31:15.17,Default,,0,0,0,,.تعجبني. أعطها إكرامية مناسبة
Dialogue: 0,1:31:21.79,1:31:25.58,Default,,0,0,0,,ماذا قلت؟ قلت لك ألا تتحدثي\N.إلى أي أحد هنا
Dialogue: 0,1:31:25.71,1:31:28.92,Default,,0,0,0,,الآن أصبحت تأمرني بالتحدث\Nأو بعدم التحدث إلى أحد؟
Dialogue: 0,1:31:31.50,1:31:33.50,Default,,0,0,0,,.أفهم لماذا انسجمتما
Dialogue: 0,1:31:37.79,1:31:39.00,Default,,0,0,0,,.أحسنت
Dialogue: 0,1:32:12.46,1:32:13.58,Default,,0,0,0,,.يا للهول
Dialogue: 0,1:32:18.38,1:32:20.25,Default,,0,0,0,,يا للهول. هل تكفين عن التنظيف يومًا؟
Dialogue: 0,1:32:24.46,1:32:26.58,Default,,0,0,0,,هل ستبيعين مخدرات لصالح ذلك الرجل فعلًا؟
Dialogue: 0,1:32:26.75,1:32:29.38,Default,,0,0,0,,إنها الطريقة الوحيدة التي سيتغاضى بها\N.عن الوثائق في الملهى
Dialogue: 0,1:32:29.46,1:32:32.08,Default,,0,0,0,,وربما تكون الطريقة الوحيدة\N.التي سنخرج بها من هذا المأزق
Dialogue: 0,1:32:32.17,1:32:35.17,Default,,0,0,0,,.ليست لديك فكرة عن هوية هذا الرجل -\Nأنا لست حمقاء، اتفقنا؟ -
Dialogue: 0,1:32:35.25,1:32:37.21,Default,,0,0,0,,إذًا كيف عساك تفعلين هذا؟
Dialogue: 0,1:32:37.29,1:32:40.46,Default,,0,0,0,,تعظينني بشأن الذهاب إلى العيادة\Nمن أجل "لوكا"، لكن هذا مقبول؟
Dialogue: 0,1:32:40.54,1:32:44.75,Default,,0,0,0,,هذا ما سيتسبب في ترحيلك\Nأو أسوأ من ذلك يا
Dialogue: 0,1:32:44.83,1:32:48.08,Default,,0,0,0,,ماذا سيحدث إن عاد الطفلان إلى المنزل\Nولا يجدانك فجأةً؟
Dialogue: 0,1:32:49.92,1:32:53.50,Default,,0,0,0,,…في"، إن كنت بحاجة إلى المال" -\N.لا، لا يلزمني إحسانك -
Dialogue: 0,1:32:53.58,1:32:55.88,Default,,0,0,0,,،وإن كنت تظنين أنك أذكى مني بكثير
Dialogue: 0,1:32:55.96,1:32:57.96,Default,,0,0,0,,.فاخرجي من منزلي
Dialogue: 0,1:33:14.83,1:33:16.75,Default,,0,0,0,,"(إسعاف مقاطعة (كلارك"
Dialogue: 0,1:33:17.54,1:33:19.38,Default,,0,0,0,,خذوا المال وبطاقات الائتمان\N.إلى سيارة الإسعاف
Dialogue: 0,1:33:19.46,1:33:21.46,Default,,0,0,0,,.هيا! سنقابل الزعيم الآن
Dialogue: 0,1:33:21.54,1:33:23.04,Default,,0,0,0,,ماذا يجري؟
Dialogue: 0,1:33:23.13,1:33:25.46,Default,,0,0,0,,وجدت الشرطة جثة\N"ثيو"
Dialogue: 0,1:33:25.54,1:33:27.13,Default,,0,0,0,,.لكنهم سيأتون إلى هنا قريبًا
Dialogue: 0,1:33:27.21,1:33:29.13,Default,,0,0,0,,ماذا سيحدث لعائلته؟
Dialogue: 0,1:33:29.21,1:33:31.42,Default,,0,0,0,,.إن كان ذكيًا، لتكفل بذلك
Dialogue: 0,1:33:35.04,1:33:37.46,Default,,0,0,0,,.لكن شخصيات الناس ليست كما نريد دائمًا
Dialogue: 0,1:33:39.21,1:33:40.21,Default,,0,0,0,,.هيا
Dialogue: 0,1:34:14.83,1:34:17.63,Default,,0,0,0,,.خذي كيس النفايات ونظفي كل شيء جيدًا
Dialogue: 0,1:34:17.71,1:34:20.25,Default,,0,0,0,,سيعود\N"ماتيو"
Dialogue: 0,1:34:20.33,1:34:23.83,Default,,0,0,0,,هيا. سنقابل\N"هاياك"
Dialogue: 0,1:34:33.88,1:34:35.17,Default,,0,0,0,,.شكرًا
Dialogue: 0,1:34:36.33,1:34:37.71,Default,,0,0,0,,.أجل
Dialogue: 0,1:34:46.63,1:34:49.46,Default,,0,0,0,,.حسنًا، انقلوا كل الحقائب إلى الشاحنة. هيا
Dialogue: 0,1:34:49.54,1:34:51.25,Default,,0,0,0,,هل أخرجت كل شيء؟
Dialogue: 0,1:34:51.33,1:34:54.63,Default,,0,0,0,,كل النقود والأقراص الصلبة\N.وأجهزة سرقة البطاقات. أخرجت كل شيء
Dialogue: 0,1:34:55.79,1:34:58.88,Default,,0,0,0,,.شكرًا على تولي هذا الأمر\N.ما كان يجب أن يحدث ذلك قط
Dialogue: 0,1:34:58.96,1:35:01.88,Default,,0,0,0,,لو فعل\N"ثيو"
Dialogue: 0,1:35:01.96,1:35:03.67,Default,,0,0,0,,.رجاءً يا بني. ليس الآن
Dialogue: 0,1:35:06.00,1:35:09.50,Default,,0,0,0,,يداهمك الوقت. حددت الشرطة هوية جثة\N"ثيو"
Dialogue: 0,1:35:09.58,1:35:11.88,Default,,0,0,0,,.طلبت تنظيف المكان فيما نتحدث
Dialogue: 0,1:35:12.00,1:35:13.54,Default,,0,0,0,,.لن يكون هناك أي دليل ضدنا
Dialogue: 0,1:35:13.67,1:35:17.13,Default,,0,0,0,,.هذا صحيح. لأنني أتولى ذلك الآن
Dialogue: 0,1:35:17.21,1:35:18.96,Default,,0,0,0,,-\N"طارق"
Dialogue: 0,1:35:21.38,1:35:23.38,Default,,0,0,0,,.هاياك"، ما زالت عاملة النظافة في الداخل"
Dialogue: 0,1:35:25.33,1:35:27.63,Default,,0,0,0,,أتقصد عاملة النظافة\Nالتي يجب أن تكون ميتة بالفعل؟
Dialogue: 0,1:36:00.33,1:36:01.75,Default,,0,0,0,,.يا للهول
Dialogue: 0,1:36:08.13,1:36:09.92,Default,,0,0,0,,.تبًا
Dialogue: 0,1:36:16.42,1:36:17.67,Default,,0,0,0,,.تبًا
Dialogue: 0,1:36:32.63,1:36:34.38,Default,,0,0,0,,!هيا
Dialogue: 0,1:36:53.79,1:36:55.17,Default,,0,0,0,,هل أنت بخير؟
Dialogue: 0,1:37:08.38,1:37:09.71,Default,,0,0,0,,.لا تتحرك
Dialogue: 0,1:37:24.13,1:37:25.13,Default,,0,0,0,,."اتصل بالطبيب "سارويان\NI Ignored "now" to improve readability
Dialogue: 0,1:37:25.21,1:37:27.29,Default,,0,0,0,,.لا، علينا الخروج من هنا -\N.لا، لا يُوجد وقت -
Dialogue: 0,1:37:27.38,1:37:29.33,Default,,0,0,0,,.تسببت الشظية في جرح عميق. علي كي الجرح
Dialogue: 0,1:37:29.42,1:37:31.25,Default,,0,0,0,,!لا -\N!أنزله الآن -
Dialogue: 0,1:37:33.08,1:37:34.38,Default,,0,0,0,,هل تثق بي؟
Dialogue: 0,1:37:37.29,1:37:38.38,Default,,0,0,0,,.أجل
Dialogue: 0,1:37:39.54,1:37:42.08,Default,,0,0,0,,.أحتاج إلى سكين وقداحة. وأحضر بعض الكحول
Dialogue: 0,1:37:42.17,1:37:44.08,Default,,0,0,0,,.أمسكه بإحكام. بإحكام -\N.أجل -
Dialogue: 0,1:38:07.29,1:38:08.75,Default,,0,0,0,,.حسنًا، هيا بنا
Dialogue: 0,1:38:20.17,1:38:21.79,Default,,0,0,0,,أين تعلمت فعل ذلك؟
Dialogue: 0,1:38:23.29,1:38:25.92,Default,,0,0,0,,من تكونين يا\N"توني"
Dialogue: 0,1:38:33.08,1:38:34.46,Default,,0,0,0,,.أحسنت بالوثوق بك
Dialogue: 0,1:38:34.54,1:38:36.42,Default,,0,0,0,,لماذا تركتني لأموت؟
Dialogue: 0,1:38:36.50,1:38:38.83,Default,,0,0,0,,…عدت من أجلك حين اكتشفت أنهم
Dialogue: 0,1:38:38.92,1:38:39.92,Default,,0,0,0,,!هذا ليس كافيًا
Dialogue: 0,1:38:40.00,1:38:43.00,Default,,0,0,0,,،وافقت على التنظيف\N.لا أن أُعامل كأنني حثالة
Dialogue: 0,1:38:44.79,1:38:47.83,Default,,0,0,0,,.أتريدني أن أعمل لصالحك؟ احمني
Dialogue: 0,1:38:47.96,1:38:50.00,Default,,0,0,0,,.امنحني الاحترام الذي أستحقه
Dialogue: 0,1:38:52.17,1:38:56.33,Default,,0,0,0,,.وإن أصابني مكروه، فأقسم إنك ستحمي ابني
Dialogue: 0,1:39:01.08,1:39:02.67,Default,,0,0,0,,.أعدك بذلك
Dialogue: 0,1:39:30.75,1:39:32.21,Default,,0,0,0,,.تعازي على وفاة والدك
Dialogue: 0,1:39:33.50,1:39:36.42,Default,,0,0,0,,.اسمك "شيلبي"، صحيح؟ أنا عملت لصالحه
Dialogue: 0,1:39:36.50,1:39:38.08,Default,,0,0,0,,.إذًا تعرفين أنه كان مجرمًا
Dialogue: 0,1:39:40.21,1:39:42.88,Default,,0,0,0,,.أعرف أننا جميعًا نرتكب أخطاء
Dialogue: 0,1:39:46.88,1:39:48.42,Default,,0,0,0,,،لكن والدك
Dialogue: 0,1:39:49.25,1:39:51.79,Default,,0,0,0,,.لم يكف عن التحدث عن ابنته قط
Dialogue: 0,1:39:52.75,1:39:54.54,Default,,0,0,0,,.كان فخورًا بك جدًا
Dialogue: 0,1:39:57.17,1:39:58.63,Default,,0,0,0,,.وجدت هذه في مكتبه
Dialogue: 0,1:40:09.04,1:40:10.25,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,1:40:30.13,1:40:31.63,Default,,0,0,0,,كيف كانت الجنازة؟
Dialogue: 0,1:40:32.33,1:40:34.67,Default,,0,0,0,,.كانت حزينة
Dialogue: 0,1:40:35.21,1:40:37.08,Default,,0,0,0,,.هذا ليس ما أريد التحدث عنه
Dialogue: 0,1:40:37.17,1:40:39.29,Default,,0,0,0,,لن أبيع المخدرات، اتفقنا؟
Dialogue: 0,1:40:40.13,1:40:43.50,Default,,0,0,0,,.دعينا لا نتحدث عن الأمر
Dialogue: 0,1:40:43.58,1:40:46.08,Default,,0,0,0,,.ما كان علي انتقادك
Dialogue: 0,1:40:46.17,1:40:48.21,Default,,0,0,0,,.أعرف مدى صعوبة الوضع
Dialogue: 0,1:40:48.33,1:40:54.04,Default,,0,0,0,,ومرت بضعة أسابيع وانتهى بنا المطاف\N.موجودين في منزلك
Dialogue: 0,1:40:55.04,1:40:57.17,Default,,0,0,0,,.لذا سنجد منزلًا آخر
Dialogue: 0,1:40:57.25,1:40:58.50,Default,,0,0,0,,.توقفي
Dialogue: 0,1:41:00.29,1:41:02.50,Default,,0,0,0,,.لن تذهبي إلى أي مكان
Dialogue: 0,1:41:02.58,1:41:04.00,Default,,0,0,0,,…أنا فقط
Dialogue: 0,1:41:04.63,1:41:08.71,Default,,0,0,0,,.لن أفقد صديقتي المقربة، فقد استعدتك للتو
Dialogue: 0,1:41:15.50,1:41:17.04,Default,,0,0,0,,.شكرًا لك
Dialogue: 0,1:41:25.79,1:41:27.29,Default,,0,0,0,,صباح الخير يا\N"لوكا"
Dialogue: 0,1:41:31.46,1:41:32.96,Default,,0,0,0,,.لدي مفاجأة من أجلك
Dialogue: 0,1:41:33.63,1:41:34.71,Default,,0,0,0,,أتريد أن تراها؟
Dialogue: 0,1:41:35.13,1:41:37.33,Default,,0,0,0,,.أجل -\N.أجل. هيا، فلنذهب -
Dialogue: 0,1:41:42.29,1:41:44.50,Default,,0,0,0,,.حسنًا. اتبع أمك
Dialogue: 0,1:41:45.21,1:41:49.50,Default,,0,0,0,,.من هنا. هذا صحيح
Dialogue: 0,1:41:49.58,1:41:51.29,Default,,0,0,0,,.حسنًا، توقف هنا
Dialogue: 0,1:41:55.79,1:41:57.63,Default,,0,0,0,,.حسنًا، اقترب
Dialogue: 0,1:42:00.79,1:42:02.46,Default,,0,0,0,,.الآن، افتح عينيك
Dialogue: 0,1:42:04.13,1:42:06.13,Default,,0,0,0,,!مفاجأة
Dialogue: 0,1:42:07.79,1:42:09.38,Default,,0,0,0,,أمي، هل أحلم؟
Dialogue: 0,1:42:10.29,1:42:11.54,Default,,0,0,0,,.لا
Dialogue: 0,1:42:11.63,1:42:13.75,Default,,0,0,0,,.صنعت أمك صدفة أكبر من أجلك
Dialogue: 0,1:42:13.83,1:42:17.75,Default,,0,0,0,,.أحبك يا أمي -\Nأنا أيضًا يا -
Dialogue: 0,1:42:19.71,1:42:21.00,Default,,0,0,0,,!هيا، هيا بنا
Dialogue: 0,1:42:23.46,1:42:24.88,Default,,0,0,0,,!خلفك
Dialogue: 0,1:42:27.13,1:42:28.58,Default,,0,0,0,,.مهلًا\N"جاز"
Dialogue: 0,1:42:48.38,1:42:50.38,Default,,0,0,0,,.أشعر بأنني كبير جدًا هنا
Dialogue: 0,1:42:52.88,1:42:54.21,Default,,0,0,0,,.انظر إلى ذلك
Dialogue: 0,1:43:46.83,1:43:48.25,Default,,0,0,0,,.هذه هي
Dialogue: 0,1:43:51.79,1:43:53.33,Default,,0,0,0,,"مكتب التحقيقات الفيدرالي"
