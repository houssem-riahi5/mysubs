Dialogue: 0,0:00:05.77,0:00:06.70,Default,,0,0,0,,!شين-دونو
Dialogue: 0,0:00:07.95,0:00:11.23,Default,,0,0,0,,‫هذا الرجل... كم هو قوي!
Dialogue: 0,0:00:11.23,0:00:14.86,Default,,0,0,0,,عجبًا! أتحاول صدَّ ضربتي؟
Dialogue: 0,0:00:14.86,0:00:15.90,Default,,0,0,0,,‫شين...
Dialogue: 0,0:00:19.39,0:00:22.78,Default,,0,0,0,,لديهم سلاح فرسان أيضًا؟ من يكونون هؤلاء؟
Dialogue: 0,0:00:22.78,0:00:25.51,Default,,0,0,0,,‫انسحبوا! إنّها أوامر المخططة العسكرية!
Dialogue: 0,0:00:25.51,0:00:26.75,Default,,0,0,0,,‫انسحبوا مؤقتًا!
Dialogue: 0,0:00:32.17,0:00:34.43,Default,,0,0,0,,!اثبتوا في أماكنكم يا وحدة هي شين
Dialogue: 0,0:00:34.43,0:00:36.50,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:00:37.27,0:00:39.85,Default,,0,0,0,,‫من الخطر أن ننسحب ونُدير ظهورنا لهم الآن!
Dialogue: 0,0:00:39.85,0:00:43.54,Default,,0,0,0,,!حين نُحاصر، نحمي ظهور بعضنا البعض ونقاتل
Dialogue: 0,0:00:43.54,0:00:47.36,Default,,0,0,0,,!اصمدوا! فرسان سوسوي قادمون من الخلف
Dialogue: 0,0:00:47.83,0:00:49.59,Default,,0,0,0,,،ثمَّ سنعيد تنظيم صفوفنا
Dialogue: 0,0:00:49.59,0:00:53.45,Default,,0,0,0,,!ونسحق كلّ واحد من هؤلاء الأوغاد المتغطرسين نصّابي الفخاخ
Dialogue: 0,0:00:53.45,0:00:56.06,Default,,0,0,0,,!حتى ذلك الحين، اثبتوا في أماكنكم يا رفاق
Dialogue: 0,0:00:57.98,0:00:59.70,Default,,0,0,0,,إعادة تنظيم الصفوف إذن
Dialogue: 0,0:00:59.99,0:01:02.84,Default,,0,0,0,,أتظنون أن لديكم رفاهية إعادة تنظيم الصفوف؟
Dialogue: 0,0:01:05.83,0:01:08.08,Default,,0,0,0,,تشاو
Dialogue: 0,0:01:08.09,0:01:10.08,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:01:10.08,0:01:12.34,Default,,0,0,0,,اسمعوا يا حمقى شين
Dialogue: 0,0:01:12.34,0:01:15.84,Default,,0,0,0,,دعوني أشارككم كلمات جنرالنا، كيسوي
Dialogue: 0,0:01:15.84,0:01:17.65,Default,,0,0,0,,،هنا في كوكويو
Dialogue: 0,0:01:18.56,0:01:21.77,Default,,0,0,0,,من يربك عدوه سينتصر
Dialogue: 0,0:01:23.09,0:01:23.84,Default,,0,0,0,,‫ما...
Dialogue: 0,0:01:24.22,0:01:27.04,Default,,0,0,0,,!استولوا على أحد تلالنا؟
Dialogue: 0,0:02:58.57,0:02:59.33,Default,,0,0,0,,عبق ساحة المعركة
Dialogue: 0,0:02:59.33,0:03:01.74,Default,,0,0,0,,هناك أيّها القائد... دخان على أحد تلالنا\Nعبق ساحة المعركة
Dialogue: 0,0:03:01.74,0:03:03.39,Default,,0,0,0,,هناك أيّها القائد... دخان على أحد تلالنا
Dialogue: 0,0:03:03.39,0:03:06.02,Default,,0,0,0,,،كان يجب أن تكون وحدة هي شين قد تجاوزته
Dialogue: 0,0:03:06.02,0:03:09.05,Default,,0,0,0,,ويبدو أنّه من السابق لأوانه أن يكون الجناح الأيمن قد استولى عليه
Dialogue: 0,0:03:09.42,0:03:12.13,Default,,0,0,0,,هل تلك إحدى إشاراتنا؟
Dialogue: 0,0:03:12.13,0:03:15.25,Default,,0,0,0,,ذلك الخادم الأحمق
Dialogue: 0,0:03:20.60,0:03:22.08,Default,,0,0,0,,!انطلق يا شين
Dialogue: 0,0:03:22.08,0:03:24.40,Default,,0,0,0,,!اقضِ على ذلك الرجل الضخم
Dialogue: 0,0:03:24.40,0:03:25.79,Default,,0,0,0,,هل سيصمد حصانه؟
Dialogue: 0,0:03:26.95,0:03:28.13,Default,,0,0,0,,!أيّها الجنرال
Dialogue: 0,0:03:28.95,0:03:29.84,Default,,0,0,0,,جنرال؟
Dialogue: 0,0:03:38.20,0:03:39.45,Default,,0,0,0,,أنا مندهش
Dialogue: 0,0:03:39.45,0:03:42.21,Default,,0,0,0,,،حتّى ريوتو لا يستطيع تحمل ضربةٍ من فأسي الحربي
Dialogue: 0,0:03:42.21,0:03:44.46,Default,,0,0,0,,وها أنتَ قد فعلتها مرتين
Dialogue: 0,0:03:44.46,0:03:46.36,Default,,0,0,0,,!شين-دونو
Dialogue: 0,0:03:49.32,0:03:50.99,Default,,0,0,0,,!إنّه الملازم سوسوي
Dialogue: 0,0:03:50.99,0:03:52.29,Default,,0,0,0,,!ممتاز
Dialogue: 0,0:03:52.56,0:03:54.99,Default,,0,0,0,,...أظن أنَّ هذا يكفي أيّها الجنرال
Dialogue: 0,0:03:56.20,0:03:57.51,Default,,0,0,0,,أنا باتي
Dialogue: 0,0:03:57.83,0:04:02.47,Default,,0,0,0,,لم أتوقع أن أتبادل الضربات فجأةً مع الفريسة نفسها
Dialogue: 0,0:04:03.01,0:04:05.48,Default,,0,0,0,,يا لها من فرصة سانحة، لكن وقتنا انتهى
Dialogue: 0,0:04:05.94,0:04:09.93,Default,,0,0,0,,تطلع للقائنا القادم، سأحضر جيشًا حقيقيًّا
Dialogue: 0,0:04:10.09,0:04:12.35,Default,,0,0,0,,يا شين من وحدة هي شين
Dialogue: 0,0:04:12.96,0:04:14.37,Default,,0,0,0,,حسنٌ، لنا لقاء آخر
Dialogue: 0,0:04:14.37,0:04:14.92,Default,,0,0,0,,!مـ-ما؟
Dialogue: 0,0:04:15.75,0:04:18.97,Default,,0,0,0,,!أتمزح معي؟ أتظنني سأقف هنا وأدعكَ تهرب؟
Dialogue: 0,0:04:18.97,0:04:20.34,Default,,0,0,0,,!تمهل يا شين
Dialogue: 0,0:04:21.06,0:04:25.24,Default,,0,0,0,,!اترك المطاردة لوحدة سوسوي! لدينا ما أهم
Dialogue: 0,0:04:27.16,0:04:28.61,Default,,0,0,0,,...مشكلتنا الآن
Dialogue: 0,0:04:28.90,0:04:30.49,Default,,0,0,0,,في ذلك الاتجاه
Dialogue: 0,0:04:31.22,0:04:37.27,Default,,0,0,0,,يا لها من جرأةٍ أن تستخدم كِلا المساعدين منذ البداية يا كيسوي
Dialogue: 0,0:04:37.64,0:04:43.63,Default,,0,0,0,,من الضروري أن نفعل كلّ ما يلزم للاستيلاء على زمام المبادرة للقتال في كوكويو
Dialogue: 0,0:04:43.63,0:04:47.54,Default,,0,0,0,,لكن لديك الكثير لتخسره إن فشلت
Dialogue: 0,0:04:47.54,0:04:49.59,Default,,0,0,0,,هل أنتَ من النوع الّذي يُقامر؟
Dialogue: 0,0:04:49.87,0:04:51.40,Default,,0,0,0,,هذه ليست مقامرة
Dialogue: 0,0:04:52.11,0:04:56.94,Default,,0,0,0,,أثق بـ باتي وريوتو وفي قوتهما
Dialogue: 0,0:04:57.25,0:04:57.50,Default,,0,0,0,,تشاو
Dialogue: 0,0:04:57.50,0:05:00.38,Default,,0,0,0,,!ريوتو-سما! اكتملت الاستعدادات\Nتشاو
Dialogue: 0,0:05:00.38,0:05:00.39,Default,,0,0,0,,!ريوتو-سما! اكتملت الاستعدادات
Dialogue: 0,0:05:02.58,0:05:05.74,Default,,0,0,0,,!هل سنستولي حقًّا على ذلك التل وحدنا؟
Dialogue: 0,0:05:06.18,0:05:07.94,Default,,0,0,0,,...ذلك الارتفاع
Dialogue: 0,0:05:07.94,0:05:12.62,Default,,0,0,0,,!سنتلقى وابلًا من السهام والصخور من الأعلى بينما نزال نتسلق
Dialogue: 0,0:05:12.62,0:05:15.74,Default,,0,0,0,,!علاوةً على ذلك، لا نعلم عدد أعدائنا
Dialogue: 0,0:05:16.31,0:05:20.00,Default,,0,0,0,,الوحدة على قمة التل صغيرة وهذا مؤكد
Dialogue: 0,0:05:21.24,0:05:25.76,Default,,0,0,0,,ربما استخدموا روافدًا نهريةً لا نعرفها
Dialogue: 0,0:05:25.76,0:05:27.68,Default,,0,0,0,,للوصول إلى هذا الحد
Dialogue: 0,0:05:28.53,0:05:32.42,Default,,0,0,0,,لا يمكن لوحدةِ جيشٍ أكبر فعل هذا حتمًا
Dialogue: 0,0:05:33.01,0:05:36.17,Default,,0,0,0,,،ووحدة هي شين يمكنها التعامل مع وحدة صغيرة
Dialogue: 0,0:05:36.17,0:05:38.22,Default,,0,0,0,,حتّى لو كان العدو يمتلك الأفضلية الجغرافية
Dialogue: 0,0:05:38.65,0:05:41.46,Default,,0,0,0,,مع ذلك، هذا لا يعني أنّنا سنخرج سالمين
Dialogue: 0,0:05:41.46,0:05:42.58,Default,,0,0,0,,أعلم
Dialogue: 0,0:05:42.95,0:05:44.74,Default,,0,0,0,,،لكن إن لم نفعل ذلك الآن
Dialogue: 0,0:05:44.74,0:05:47.76,Default,,0,0,0,,سيتجمع العدو على ذلك التل ويحوله إلى حصن
Dialogue: 0,0:05:47.76,0:05:50.57,Default,,0,0,0,,وسنحتاج إلى جيش كبير لتلك المعركة
Dialogue: 0,0:05:53.15,0:05:55.78,Default,,0,0,0,,لذا إن كنّا سنستولي عليه، فيجب أن يكون الآن
Dialogue: 0,0:05:56.23,0:05:57.16,Default,,0,0,0,,أجل
Dialogue: 0,0:05:57.16,0:05:59.70,Default,,0,0,0,,لكن كيف نستولي على التل؟
Dialogue: 0,0:06:00.05,0:06:01.30,Default,,0,0,0,,لا تقلق
Dialogue: 0,0:06:01.74,0:06:04.66,Default,,0,0,0,,أيّ تكتيكاتٍ بسيطةٍ ستفي بالغرض
Dialogue: 0,0:06:04.97,0:06:06.18,Default,,0,0,0,,!اسمعوا
Dialogue: 0,0:06:06.18,0:06:09.01,Default,,0,0,0,,!أريد صفوفًا من الدروع دون أيّ فجوة
Dialogue: 0,0:06:09.01,0:06:13.05,Default,,0,0,0,,!سنواجه أمطرًا من السهام وجهًا لوجه ونواصل التسلق
Dialogue: 0,0:06:13.67,0:06:15.55,Default,,0,0,0,,هل سنفعل هذا؟
Dialogue: 0,0:06:16.27,0:06:18.22,Default,,0,0,0,,هل سنفعل هذا؟
Dialogue: 0,0:06:19.69,0:06:21.52,Default,,0,0,0,,!إذن، لننطلق
Dialogue: 0,0:06:21.82,0:06:23.88,Default,,0,0,0,,التل أكبر ممّا ظننا
Dialogue: 0,0:06:23.88,0:06:26.55,Default,,0,0,0,,لا يمكن للعدو الدفاع عنه كلّه بوحدةٍ صغيرةٍ فحسب
Dialogue: 0,0:06:26.55,0:06:30.11,Default,,0,0,0,,لذا سيصرخ دينيو ويستعرض تقدمه من الأمام مباشرةً
Dialogue: 0,0:06:30.11,0:06:31.94,Default,,0,0,0,,!يجب أن تصل السهام قريبًا
Dialogue: 0,0:06:31.94,0:06:32.77,Default,,0,0,0,,!ارفعوا الدروع
Dialogue: 0,0:06:32.77,0:06:34.56,Default,,0,0,0,,‫وفي هذه الأثناء،
Dialogue: 0,0:06:35.24,0:06:38.01,Default,,0,0,0,,فرقة رشيقة بقيادة شين وسوغين
Dialogue: 0,0:06:38.01,0:06:41.38,Default,,0,0,0,,ستتسلق من الخلف بعيدًا عن أنظار العدو
Dialogue: 0,0:06:41.98,0:06:46.82,Default,,0,0,0,,جيد، العدو مشتت تمامًا برجال دينيو في المقدمة
Dialogue: 0,0:06:55.18,0:06:57.56,Default,,0,0,0,,تمهلوا، ثمة بعض الحراس
Dialogue: 0,0:06:57.82,0:07:00.82,Default,,0,0,0,,عشرة... ربما عشرون
Dialogue: 0,0:07:02.86,0:07:05.56,Default,,0,0,0,,لا حراس آخرين حولنا
Dialogue: 0,0:07:08.56,0:07:10.39,Default,,0,0,0,,يمكننا الالتفاف يمينًا وتجاوزهم
Dialogue: 0,0:07:11.38,0:07:13.92,Default,,0,0,0,,سأواصل المضي في هذا الطريق
Dialogue: 0,0:07:14.16,0:07:16.11,Default,,0,0,0,,حسنٌ، هيا بنا
Dialogue: 0,0:07:23.77,0:07:27.11,Default,,0,0,0,,تشاو
Dialogue: 0,0:07:27.89,0:07:28.84,Default,,0,0,0,,هل أنتم مستعدون؟
Dialogue: 0,0:07:31.24,0:07:31.93,Default,,0,0,0,,!انطلقوا
Dialogue: 0,0:07:37.61,0:07:39.36,Default,,0,0,0,,!ما هذا؟
Dialogue: 0,0:07:43.15,0:07:46.73,Default,,0,0,0,,عـ-عجبًا! لم نرَ سهمًا واحدًا
Dialogue: 0,0:07:47.84,0:07:49.68,Default,,0,0,0,,ماذا قلت لكم؟
Dialogue: 0,0:07:50.16,0:07:53.39,Default,,0,0,0,,كوكويو تدور حول إرباك خصمك
Dialogue: 0,0:07:53.72,0:07:56.05,Default,,0,0,0,,تشاو
Dialogue: 0,0:07:56.28,0:07:57.95,Default,,0,0,0,,‫هذا سيئ!
Dialogue: 0,0:07:58.39,0:08:02.55,Default,,0,0,0,,...أدرك شين حين وصل إلى القمة
Dialogue: 0,0:08:02.55,0:08:06.52,Default,,0,0,0,,أنَّ الوحدتان اللتان ظهرتا من العدم لعبتا به كأنّه دمية
Dialogue: 0,0:08:06.84,0:08:07.17,Default,,0,0,0,,وحدة هي شين\Nالتل
Dialogue: 0,0:08:07.17,0:08:09.51,Default,,0,0,0,,،اعتقادًا منها أنَّ التل محتل\Nوحدة هي شين\Nالتل
Dialogue: 0,0:08:09.51,0:08:13.64,Default,,0,0,0,,فغيرت وحدة هي شين مسارها وتحركت للاستيلاء عليه\Nوحدة هي شين\Nالتل
Dialogue: 0,0:08:13.64,0:08:13.72,Default,,0,0,0,,وحدة هي شين\Nالتل
Dialogue: 0,0:08:13.72,0:08:14.17,Default,,0,0,0,,شين\Nوحدة هي شين\Nوحدتا باتي وريوتو\Nالتل المركزي\Nتشاو
Dialogue: 0,0:08:14.17,0:08:17.94,Default,,0,0,0,,أفسد هذا استراتيجيتهم المتمثلة في أن يكونوا أول من ينشئ\Nشين\Nوحدة هي شين\Nوحدتا باتي وريوتو\Nالتل المركزي\Nتشاو
Dialogue: 0,0:08:17.94,0:08:20.84,Default,,0,0,0,,،خط جبهة خلف التل المركزي\Nشين\Nوحدة هي شين\Nوحدتا باتي وريوتو\Nالتل المركزي\Nتشاو
Dialogue: 0,0:08:20.84,0:08:21.30,Default,,0,0,0,,شين\Nوحدة هي شين\Nوحدتا باتي وريوتو\Nالتل المركزي\Nتشاو
Dialogue: 0,0:08:21.30,0:08:25.00,Default,,0,0,0,,ممّا سمح لجيش "تشاو" بالوصول إلى التل المركزي أولًا\Nشين\Nوحدة هي شين\Nوحدتا باتي وريوتو\Nالتل المركزي\Nتشاو
Dialogue: 0,0:08:25.00,0:08:27.73,Default,,0,0,0,,وإنشاء خط جبهة في الجانب المقابل\Nشين\Nوحدة هي شين\Nوحدتا باتي وريوتو\Nالتل المركزي\Nتشاو
Dialogue: 0,0:08:27.73,0:08:27.98,Default,,0,0,0,,شين\Nوحدة هي شين\Nوحدتا باتي وريوتو\Nالتل المركزي\Nتشاو
Dialogue: 0,0:08:28.46,0:08:31.73,Default,,0,0,0,,،وبينما كان شين يتسلق التل
Dialogue: 0,0:08:31.76,0:08:32.08,Default,,0,0,0,,وحدة هي شين\Nالتل المركزي
Dialogue: 0,0:08:32.08,0:08:34.72,Default,,0,0,0,,أرسلت وحدة كيوكاي كشّافةً لوحدة هي شين\Nوحدة هي شين\Nالتل المركزي
Dialogue: 0,0:08:34.72,0:08:36.97,Default,,0,0,0,,أرسلت وحدة كيوكاي كشّافةً لوحدة هي شين
Dialogue: 0,0:08:38.58,0:08:39.58,Default,,0,0,0,,ما هذا؟
Dialogue: 0,0:08:40.54,0:08:44.30,Default,,0,0,0,,‫كوكويو ليست مجرد بحرٍ من الأشجار إذن!
Dialogue: 0,0:08:45.56,0:08:46.95,Default,,0,0,0,,،فور وصولنا مباشرةً
Dialogue: 0,0:08:47.72,0:08:50.35,Default,,0,0,0,,رأيت أعمدة الدخان تلك
Dialogue: 0,0:08:50.35,0:08:53.18,Default,,0,0,0,,كانت تلك علاماتٍ على وجود حياةٍ بشريّةٍ إذن
Dialogue: 0,0:08:54.46,0:08:55.83,Default,,0,0,0,,...في هذه الحالة
Dialogue: 0,0:08:56.40,0:08:58.60,Default,,0,0,0,,ستكون هناك مستوطنات أخرى أيضًا
Dialogue: 0,0:08:58.97,0:09:00.34,Default,,0,0,0,,تمهل قليلًا
Dialogue: 0,0:09:00.72,0:09:04.09,Default,,0,0,0,,لِمَ هم مرتاحو البال يعتنون بحقولهم هكذا؟
Dialogue: 0,0:09:04.90,0:09:07.77,Default,,0,0,0,,...وكلّ هؤلاء الأطفال يلعبون في الخارج
Dialogue: 0,0:09:07.77,0:09:11.78,Default,,0,0,0,,ألّا يعلمون أنّهم على شفا حرب؟
Dialogue: 0,0:09:12.10,0:09:15.91,Default,,0,0,0,,حتّى شين موطنٌ لعددٍ من هذه الأماكن النائية
Dialogue: 0,0:09:15.91,0:09:18.39,Default,,0,0,0,,الّتي بالكاد تبدو جزءًا من البلاد
Dialogue: 0,0:09:18.39,0:09:22.71,Default,,0,0,0,,لن أتفاجأ إن لم تصل أخبار الحرب إلى هذه الغابة الكثيفة
Dialogue: 0,0:09:24.16,0:09:26.24,Default,,0,0,0,,لنواصل التقدم يا كيوكاي
Dialogue: 0,0:09:26.24,0:09:28.57,Default,,0,0,0,,هذه مشكلتهم
Dialogue: 0,0:09:28.57,0:09:32.84,Default,,0,0,0,,قد يبدو الأمر قاسيًا، ولكن هذا لا يعنينا الآن
Dialogue: 0,0:09:36.59,0:09:38.61,Default,,0,0,0,,كيف لا يعنينا؟
Dialogue: 0,0:09:39.80,0:09:40.71,Default,,0,0,0,,نائبة القائد؟
Dialogue: 0,0:09:40.71,0:09:44.14,Default,,0,0,0,,اذهب وأبلغ شين بشأن هذه المستوطنة
Dialogue: 0,0:09:44.14,0:09:45.57,Default,,0,0,0,,‫حـ-حاضر!
Dialogue: 0,0:09:46.15,0:09:48.11,Default,,0,0,0,,أمّا البقية فابقوا على أهبة الاستعداد
Dialogue: 0,0:09:48.11,0:09:50.35,Default,,0,0,0,,سأذهب لتحذيرهم
Dialogue: 0,0:09:50.35,0:09:52.07,Default,,0,0,0,,!لا تفعلي ذلك يا كيوكاي
Dialogue: 0,0:09:52.07,0:09:55.65,Default,,0,0,0,,!نحن لا نُعدُ سوى غزاةٍ بالنسبة لهم
Dialogue: 0,0:09:55.65,0:09:58.07,Default,,0,0,0,,سأعود حالًا
Dialogue: 0,0:09:58.57,0:09:59.86,Default,,0,0,0,,‫أخبرتك...
Dialogue: 0,0:10:00.70,0:10:04.28,Default,,0,0,0,,أنَّ هذه الحرب تتعقد يا شين
Dialogue: 0,0:10:05.40,0:10:09.10,Default,,0,0,0,,،بعد وقت قصير من هذه الجلبة في الجانب الأيمن
Dialogue: 0,0:10:09.10,0:10:11.86,Default,,0,0,0,,اشتعل ميدان المعركة الأيسر أيضًا
Dialogue: 0,0:10:16.11,0:10:20.75,Default,,0,0,0,,هـ-هل يسير جيش كانكي دائمًا بهذه السرعة يا بايين-سان؟
Dialogue: 0,0:10:20.75,0:10:21.77,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:10:22.11,0:10:26.47,Default,,0,0,0,,...حسنٌ، نتحرك بسرعةٍ أكبر من هذه أحيانًا، ولكن
Dialogue: 0,0:10:27.53,0:10:30.77,Default,,0,0,0,,لا، نحن لا نسير بهذه السرعة دائمًا
Dialogue: 0,0:10:30.77,0:10:33.94,Default,,0,0,0,,،بسبب الاستراتيجية مع أنّي لا أعرف التفاصيل
Dialogue: 0,0:10:33.96,0:10:34.38,Default,,0,0,0,,شين\Nجيش رايدو\Nالتل المركزي
Dialogue: 0,0:10:34.38,0:10:37.03,Default,,0,0,0,,لكن جيش رايدو يندفع أولًا\Nشين\Nجيش رايدو\Nالتل المركزي
Dialogue: 0,0:10:37.03,0:10:39.91,Default,,0,0,0,,لإنشاء خط جبهة خلف التل المركزي\Nشين\Nجيش رايدو\Nالتل المركزي
Dialogue: 0,0:10:39.91,0:10:40.30,Default,,0,0,0,,شين\Nجيش رايدو\Nالتل المركزي
Dialogue: 0,0:10:40.33,0:10:43.10,Default,,0,0,0,,ونحن جيش رايدو؟
Dialogue: 0,0:10:43.10,0:10:46.00,Default,,0,0,0,,أجل، جيش رايدو، الصف الثاني
Dialogue: 0,0:10:46.49,0:10:47.67,Default,,0,0,0,,...ر-رايدو
Dialogue: 0,0:10:48.09,0:10:52.40,Default,,0,0,0,,ذلك الرجل المخيف ذو الوشم حول عينه اليسرى؟
Dialogue: 0,0:10:53.05,0:10:53.06,Default,,0,0,0,,أجل، رايدو مخيف حقًّا وقوي للغاية أيضًا
Dialogue: 0,0:10:53.06,0:10:56.78,Default,,0,0,0,,كان\Nأجل، رايدو مخيف حقًّا وقوي للغاية أيضًا
Dialogue: 0,0:10:56.78,0:10:56.80,Default,,0,0,0,,أجل، رايدو مخيف حقًّا وقوي للغاية أيضًا
Dialogue: 0,0:10:57.28,0:11:02.25,Default,,0,0,0,,واجه قائدنا وقتًا عصيبًا في ترويض عصابته
Dialogue: 0,0:11:02.25,0:11:04.85,Default,,0,0,0,,عصابته؟ ترويض؟
Dialogue: 0,0:11:04.85,0:11:08.34,Default,,0,0,0,,ماذا؟ لا تعرف هذه التفاصيل؟
Dialogue: 0,0:11:09.18,0:11:12.75,Default,,0,0,0,,،نحن الآن جميعًا جيش موحد تحت قيادة كانكي
Dialogue: 0,0:11:12.75,0:11:16.50,Default,,0,0,0,,لكننا كنّا عصابات لصوص منفصلين في السابق
Dialogue: 0,0:11:16.50,0:11:21.67,Default,,0,0,0,,فإذا بالقائد يسحق أو يقنع بعضنا بالعمل لديه عصابةً تلو الأخرى
Dialogue: 0,0:11:21.67,0:11:23.54,Default,,0,0,0,,هكذا أصبحنا بهذا الحجم الكبير
Dialogue: 0,0:11:23.54,0:11:25.41,Default,,0,0,0,,!مُذهل
Dialogue: 0,0:11:25.67,0:11:30.61,Default,,0,0,0,,إذن، نحن في فرقةٍ تحت قيادة رايدو الأكثر رعبًا بينهم جميعًا؟
Dialogue: 0,0:11:31.03,0:11:32.75,Default,,0,0,0,,أجل، شيء من هذا القبيل
Dialogue: 0,0:11:32.75,0:11:35.00,Default,,0,0,0,,لكن ثمة مجموعتان أخريان
Dialogue: 0,0:11:35.00,0:11:36.98,Default,,0,0,0,,تشكلان خطرًا حقيقيًّا
Dialogue: 0,0:11:36.98,0:11:39.06,Default,,0,0,0,,الأولى هي عشيرة زينو
Dialogue: 0,0:11:39.06,0:11:42.07,Default,,0,0,0,,يركضون بمحاذاتنا عبر الشجيرات على يسارنا
Dialogue: 0,0:11:42.07,0:11:45.17,Default,,0,0,0,,،كانوا عصابة لصوص خطيرة في الشمال
Dialogue: 0,0:11:45.17,0:11:48.49,Default,,0,0,0,,لكنّهم شرسون بحيث تظنهم مجرد جنود جانحين
Dialogue: 0,0:11:48.49,0:11:50.45,Default,,0,0,0,,المهم أنَّ هؤلاء الرجال مجانين بالحرب
Dialogue: 0,0:11:50.56,0:11:51.93,Default,,0,0,0,,...فـ-فهمت
Dialogue: 0,0:11:51.93,0:11:55.87,Default,,0,0,0,,،لديهم حتمًا أكبر قوةٍ عسكريةٍ في جيش كانكي
Dialogue: 0,0:11:55.87,0:11:58.31,Default,,0,0,0,,وسيقفزون بسعادةٍ إلى فكيّ الموت
Dialogue: 0,0:11:59.13,0:12:01.80,Default,,0,0,0,,خاصةً قائدهم زينو
Dialogue: 0,0:12:01.80,0:12:06.20,Default,,0,0,0,,إنّه وحش ضخم يمكنه ليُّ عنقِ ثورٍ بيدٍ واحدة
Dialogue: 0,0:12:06.68,0:12:11.27,Default,,0,0,0,,!رأيت موبو مرةً، لكن زينو يطغى عليه طولًا
Dialogue: 0,0:12:11.27,0:12:12.00,Default,,0,0,0,,‫ماذا؟!
Dialogue: 0,0:12:12.52,0:12:17.95,Default,,0,0,0,,دائمًا ما تبذل عشيرة زينو أقصى ما لديها كلّما دعت الحاجة إلى القوة
Dialogue: 0,0:12:17.95,0:12:20.01,Default,,0,0,0,,ثمة مشكلةٌ كبيرةٌ واحدةٌ فحسب
Dialogue: 0,0:12:20.46,0:12:25.73,Default,,0,0,0,,هؤلاء الرجال غير أنّهم وحوش بربرية، وتعطشهم للدماء دائم
Dialogue: 0,0:12:25.73,0:12:29.02,Default,,0,0,0,,إن لم تعجبهم فسيمزقونك إربًا حتّى لو كنتَ بصفهم
Dialogue: 0,0:12:30.85,0:12:34.32,Default,,0,0,0,,حتّى القائد نفسه يتجنب زينو
Dialogue: 0,0:12:34.32,0:12:37.02,Default,,0,0,0,,لذا لا تتجول في الجانب الأيسر، هل فهمت؟
Dialogue: 0,0:12:37.02,0:12:41.53,Default,,0,0,0,,!يـ-يا رفاق، إياكم أن تتجهوا يسارًا إن افترقنا
Dialogue: 0,0:12:43.77,0:12:48.15,Default,,0,0,0,,أما المجموعة الأخرى فهي خلفنا الآن
Dialogue: 0,0:12:48.15,0:12:49.51,Default,,0,0,0,,عصابة العشيرة
Dialogue: 0,0:12:49.51,0:12:50.98,Default,,0,0,0,,عصابة... العشيرة؟
Dialogue: 0,0:12:50.98,0:12:56.93,Default,,0,0,0,,إنّهم أكثر المجموعات وحشيةً في جيش كانكي، أهذا يوضح الأمر بما يكفي؟
Dialogue: 0,0:12:57.24,0:13:01.79,Default,,0,0,0,,يستمتعون بخوزقة الناس الأحياء على الأوتاد مثلًا
Dialogue: 0,0:13:01.79,0:13:04.02,Default,,0,0,0,,إنّهم مجانين بحقّ
Dialogue: 0,0:13:04.56,0:13:07.64,Default,,0,0,0,,يقولون إن أعظم مصيبة في الممالك الوسطى بأكملها
Dialogue: 0,0:13:07.64,0:13:09.48,Default,,0,0,0,,هي أن تأسرك العشيرة
Dialogue: 0,0:13:10.32,0:13:12.72,Default,,0,0,0,,!يـ-يا رفاق، واصلوا المضي قدمًا
Dialogue: 0,0:13:12.72,0:13:15.49,Default,,0,0,0,,!لا تتباطؤوا الآن
Dialogue: 0,0:13:16.88,0:13:18.14,Default,,0,0,0,,...يا بيهي
Dialogue: 0,0:13:18.71,0:13:23.44,Default,,0,0,0,,سيدعوننا نعود إلى وحدة هي شين حين ينتهي هذا، أليس كذلك؟
Dialogue: 0,0:13:23.44,0:13:24.68,Default,,0,0,0,,أظن ذلك
Dialogue: 0,0:13:25.06,0:13:27.10,Default,,0,0,0,,،كنتُ ثملًا، لذا ذاكرتي مشوشة بعض الشيء
Dialogue: 0,0:13:27.10,0:13:29.27,Default,,0,0,0,,...لكنّي واثق تمامًا أنَّ هذا ما قالوه
Dialogue: 0,0:13:36.70,0:13:39.14,Default,,0,0,0,,!جـ-جنرال كانكي
Dialogue: 0,0:13:39.65,0:13:42.41,Default,,0,0,0,,!القائد؟ ما الّذي تفعله هنا؟
Dialogue: 0,0:13:42.41,0:13:44.97,Default,,0,0,0,,هل أنتم الصف الثاني لرايدو؟
Dialogue: 0,0:13:44.97,0:13:46.30,Default,,0,0,0,,!أ-أجل
Dialogue: 0,0:13:46.30,0:13:49.20,Default,,0,0,0,,وصفٌ آخر في اليسار، يا رينغيوكو
Dialogue: 0,0:13:49.20,0:13:50.18,Default,,0,0,0,,يبدو كذلك
Dialogue: 0,0:13:50.18,0:13:54.94,Default,,0,0,0,,...هل ثمة خطب ما؟ لتأتي كلّ هذه المسافة بنفسك
Dialogue: 0,0:13:54.94,0:13:57.43,Default,,0,0,0,,حسنٌ... كما تعلم
Dialogue: 0,0:13:57.74,0:14:00.95,Default,,0,0,0,,أفسد ذلك الخادم على اليمين الأمر بالفعل
Dialogue: 0,0:14:00.95,0:14:02.06,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:14:02.39,0:14:03.64,Default,,0,0,0,,لنذهب
Dialogue: 0,0:14:03.64,0:14:04.80,Default,,0,0,0,,حسنٌ
Dialogue: 0,0:14:07.98,0:14:11.53,Default,,0,0,0,,مقامرة الملازم كيسوي أتت بثمارها
Dialogue: 0,0:14:11.53,0:14:17.16,Default,,0,0,0,,يجب أن تسير الأمور بسلاسةٍ بفضل جهود مساعديه، ممتن لذلك
Dialogue: 0,0:14:17.30,0:14:19.42,Default,,0,0,0,,إطراؤك غير مقنع يا غاكوي
Dialogue: 0,0:14:19.42,0:14:24.59,Default,,0,0,0,,قصر قامتك يعني رؤيةً جيدةً بالنسبة إلي، ممتن لذلك أيضًا
Dialogue: 0,0:14:24.59,0:14:26.17,Default,,0,0,0,,...غاكوي
Dialogue: 0,0:14:26.41,0:14:29.83,Default,,0,0,0,,حققت إنجازًا رائعًا يا كيسوي
Dialogue: 0,0:14:29.83,0:14:32.19,Default,,0,0,0,,كلّ الفضل يعود إلى باتي وريوتو
Dialogue: 0,0:14:35.13,0:14:36.01,Default,,0,0,0,,انظر
Dialogue: 0,0:14:36.01,0:14:42.65,Default,,0,0,0,,التل المركزي، الأكبر في كوكويو، والّذي سيقرر مصير هذه المعركة
Dialogue: 0,0:14:42.76,0:14:44.94,Default,,0,0,0,,اليسار لا يقلقني
Dialogue: 0,0:14:45.12,0:14:48.23,Default,,0,0,0,,احذروا من اليمين بينما نتقدم فحسب
Dialogue: 0,0:14:48.53,0:14:51.17,Default,,0,0,0,,ذلك التل المركزي سيكون لنا
Dialogue: 0,0:14:59.85,0:15:03.76,Default,,0,0,0,,هـ-هل أنتَ واثق من الاندفاع هكذا أيّها القائد؟
Dialogue: 0,0:15:03.76,0:15:05.06,Default,,0,0,0,,لا تقلق
Dialogue: 0,0:15:05.60,0:15:07.26,Default,,0,0,0,,!ما خطبك يا هذا؟
Dialogue: 0,0:15:07.26,0:15:09.13,Default,,0,0,0,,...ألا تعرف من قائدنا
Dialogue: 0,0:15:09.13,0:15:10.22,Default,,0,0,0,,ابتعدوا عن طريقي
Dialogue: 0,0:15:10.34,0:15:13.48,Default,,0,0,0,,!لا يفترض بنا قتلهم أيّها القائد
Dialogue: 0,0:15:15.10,0:15:17.60,Default,,0,0,0,,!تـ-توقف! أيّها الأحمق! نحن حلفاء
Dialogue: 0,0:15:17.93,0:15:21.14,Default,,0,0,0,,لم يتغير طاقمك قيد أنملة كما هو متوقع
Dialogue: 0,0:15:22.05,0:15:24.60,Default,,0,0,0,,لديَّ عمل لك يا زينو
Dialogue: 0,0:15:24.87,0:15:29.14,Default,,0,0,0,,استخدم قوتك لتمزيق ساحة معركة كوكويو
Dialogue: 0,0:15:30.24,0:15:31.94,Default,,0,0,0,,...كانكي
Dialogue: 0,0:15:33.49,0:15:34.92,Default,,0,0,0,,!لن تتجاوزونا
Dialogue: 0,0:15:38.06,0:15:40.04,Default,,0,0,0,,!حسنٌ، مررنا
Dialogue: 0,0:15:40.97,0:15:43.03,Default,,0,0,0,,!هناك في تلك المنطقة
Dialogue: 0,0:15:43.03,0:15:45.01,Default,,0,0,0,,!هذا سيئ، إنّه كمين
Dialogue: 0,0:15:47.43,0:15:49.89,Default,,0,0,0,,!شين-دونو! علينا الانسحاب
Dialogue: 0,0:15:49.89,0:15:51.62,Default,,0,0,0,,!لا يمكننا التقدم أكثر
Dialogue: 0,0:15:52.88,0:15:54.37,Default,,0,0,0,,!تبًّا
Dialogue: 0,0:15:54.37,0:15:55.26,Default,,0,0,0,,كافحت وحدة هي شين مع تكتيكات حرب العصابات الماكرة
Dialogue: 0,0:15:55.26,0:15:58.09,Default,,0,0,0,,وحدتا باتي وريوتو\Nوحدة هي شين\Nكافحت وحدة هي شين مع تكتيكات حرب العصابات الماكرة
Dialogue: 0,0:15:58.09,0:16:00.43,Default,,0,0,0,,ضدَّ أعدائهم، باتي وريوتو\Nوحدة هي شين\Nوحدتا باتي وريوتو
Dialogue: 0,0:16:00.43,0:16:00.61,Default,,0,0,0,,ضدَّ أعدائهم، باتي وريوتو
Dialogue: 0,0:16:00.61,0:16:00.79,Default,,0,0,0,,ولم يفلحوا في دفع الجبهة الأمامية للخلف
Dialogue: 0,0:16:00.79,0:16:02.95,Default,,0,0,0,,وحدتا باتي وريوتو\Nوحدة هي شين\Nولم يفلحوا في دفع الجبهة الأمامية للخلف
Dialogue: 0,0:16:02.95,0:16:03.51,Default,,0,0,0,,وحدة هي شين\Nوحدتا باتي وريوتو
Dialogue: 0,0:16:03.51,0:16:04.40,Default,,0,0,0,,أمّا طليعة جيش تشاو الرئيسي\Nوحدة هي شين\Nوحدتا باتي وريوتو
Dialogue: 0,0:16:04.40,0:16:06.40,Default,,0,0,0,,معسكر قيادة جيش كانكي\Nزينو\Nبيهي\Nرايدو\Nالتل المركزي\Nمعسكر قيادة كيشا وكيسوي\Nأمّا طليعة جيش تشاو الرئيسي\Nوحدة هي شين\Nوحدتا باتي وريوتو
Dialogue: 0,0:16:06.40,0:16:06.49,Default,,0,0,0,,طليعة جيش "تشاو" المركزي\Nالتل المركزي\Nأمّا طليعة جيش تشاو الرئيسي
Dialogue: 0,0:16:06.49,0:16:11.47,Default,,0,0,0,,فقد وصلت بالفعل إلى مسافة قريبة جدًّا من التل المركزي\Nالتل المركزي\Nطليعة جيش "تشاو" المركزي
Dialogue: 0,0:16:11.47,0:16:11.90,Default,,0,0,0,,التل المركزي\Nطليعة جيش "تشاو" المركزي
Dialogue: 0,0:16:12.49,0:16:14.91,Default,,0,0,0,,ألم يحن وقت صعوده بعد؟
Dialogue: 0,0:16:19.48,0:16:25.04,Default,,0,0,0,,فهمت، قد يكون الجيش في أضعف حالاته أثناء شق طريقه إلى القمة
Dialogue: 0,0:16:25.56,0:16:30.84,Default,,0,0,0,,يمكن للمعسكر الرئيسي الانتظار حتّى تنشئ الطليعة حصنًا
Dialogue: 0,0:16:30.84,0:16:35.68,Default,,0,0,0,,هذا صحيح، ولكن نحن غير مُطاردين من قِبل العدو الآن
Dialogue: 0,0:16:36.12,0:16:39.79,Default,,0,0,0,,هذا السيد أكثر حذرًا ممّا توقعت
Dialogue: 0,0:16:39.79,0:16:41.99,Default,,0,0,0,,ليس الأمر من باب الحذر
Dialogue: 0,0:16:43.19,0:16:46.60,Default,,0,0,0,,ببساطة، لم أشتم رائحة كانكي في الأسفل بعد
Dialogue: 0,0:16:49.42,0:16:51.28,Default,,0,0,0,,‫هـ-هذا...
Dialogue: 0,0:16:59.60,0:17:00.83,Default,,0,0,0,,هذه هي
Dialogue: 0,0:17:08.46,0:17:10.50,Default,,0,0,0,,!إنّه وحش
Dialogue: 0,0:17:11.01,0:17:15.46,Default,,0,0,0,,!يا رايدو-سان، ستسرق منّا عشيرة زينو الأضواء
Dialogue: 0,0:17:16.11,0:17:20.38,Default,,0,0,0,,...مع ذلك، إن كان القائد يستخدم زينو بالفعل
Dialogue: 0,0:17:22.85,0:17:26.69,Default,,0,0,0,,هـ-هل سيهاجم الصف الثاني أيضًا؟
Dialogue: 0,0:17:26.69,0:17:28.26,Default,,0,0,0,,‫أجل، حتمًا!
Dialogue: 0,0:17:28.27,0:17:28.53,Default,,0,0,0,,بيهي\Nرايدو\Nالتل المركزي\Nزينو
Dialogue: 0,0:17:28.53,0:17:32.28,Default,,0,0,0,,!عشيرة زينو ورايدو في طريقهما لسحق جبهة العدو\Nبيهي\Nرايدو\Nالتل المركزي\Nزينو
Dialogue: 0,0:17:32.28,0:17:32.78,Default,,0,0,0,,بيهي\Nرايدو\Nالتل المركزي\Nزينو
Dialogue: 0,0:17:33.27,0:17:35.78,Default,,0,0,0,,!وسنلحق بهما للانضمام إلى المعركة
Dialogue: 0,0:17:35.78,0:17:37.34,Default,,0,0,0,,...إذن، من الأفضل أن نسرع و
Dialogue: 0,0:17:37.93,0:17:38.75,Default,,0,0,0,,‫إنّه التل!
Dialogue: 0,0:17:38.75,0:17:40.00,Default,,0,0,0,,هل هو هذا؟
Dialogue: 0,0:17:40.00,0:17:43.24,Default,,0,0,0,,!إنّه ضخم! هذا جبل
Dialogue: 0,0:17:43.24,0:17:46.25,Default,,0,0,0,,أجل، إنّه ضخم، لهذا هو خطير جدًّا
Dialogue: 0,0:17:46.94,0:17:52.39,Default,,0,0,0,,نحن اللصوص السابقون قد عملنا في الجبال سابقًّا، لذا نعرف ما نفعله
Dialogue: 0,0:17:52.39,0:17:57.38,Default,,0,0,0,,!إن حولوا هذا الشيء إلى حصنٍ فلن تكون لدينا أيّ فرصة
Dialogue: 0,0:17:57.60,0:18:02.89,Default,,0,0,0,,لهذا استخدم القائد زينو ورقته الرابحة لمنع حدوث ذلك
Dialogue: 0,0:18:04.58,0:18:09.88,Default,,0,0,0,,!علينا منع جيش تشاو من احتلال ذلك التل
Dialogue: 0,0:18:10.31,0:18:11.71,Default,,0,0,0,,!تقرير عاجل
Dialogue: 0,0:18:11.71,0:18:13.47,Default,,0,0,0,,!انهار خط الجبهة في الجناح الأيمن
Dialogue: 0,0:18:13.47,0:18:15.74,Default,,0,0,0,,!يبدو أنَّ العدو قد اخترق صفوفنا
Dialogue: 0,0:18:16.93,0:18:19.49,Default,,0,0,0,,انهار خط الجبهة؟! اخترقوا صفوفنا؟
Dialogue: 0,0:18:19.80,0:18:22.69,Default,,0,0,0,,!لكن قوام جناحنا الأيمن 20 ألفًا
Dialogue: 0,0:18:23.38,0:18:26.38,Default,,0,0,0,,،لاختراق خطوط العدو في هذه الغابة الكثيفة
Dialogue: 0,0:18:26.38,0:18:29.36,Default,,0,0,0,,سيحتاجون إلى قوة جبارة
Dialogue: 0,0:18:29.82,0:18:35.14,Default,,0,0,0,,...لا بدّ أن كانكي قد أرسل أقوى فرقه، وهدفهم هو
Dialogue: 0,0:18:35.14,0:18:36.50,Default,,0,0,0,,!كيشا-سما
Dialogue: 0,0:18:36.77,0:18:39.01,Default,,0,0,0,,!تقرير من الطليعة المركزية
Dialogue: 0,0:18:39.53,0:18:42.10,Default,,0,0,0,,!اكتملت الاستعدادات لتسلق التل
Dialogue: 0,0:18:42.48,0:18:47.43,Default,,0,0,0,,كيشا-سما، أرجو منك تأجيل صعود الطليعة الآن
Dialogue: 0,0:18:48.69,0:18:51.38,Default,,0,0,0,,،اخترق العدو الجبهة اليمنى
Dialogue: 0,0:18:51.38,0:18:54.86,Default,,0,0,0,,وسيستهدفون بالتأكيد أجنحة الفرقة وهم في طريقهم إلى الأعلى
Dialogue: 0,0:18:55.03,0:18:55.36,Default,,0,0,0,,التل المركزي
Dialogue: 0,0:18:55.36,0:18:59.61,Default,,0,0,0,,تلقي أيّ ضربات على طول الطريق سيؤدي إلى خسائرٍ فادحة\Nالتل المركزي
Dialogue: 0,0:18:59.61,0:19:00.03,Default,,0,0,0,,التل المركزي
Dialogue: 0,0:19:02.58,0:19:03.97,Default,,0,0,0,,كيشا-سما؟
Dialogue: 0,0:19:03.97,0:19:06.28,Default,,0,0,0,,لم أطلب رأيك يا كيسوي
Dialogue: 0,0:19:07.50,0:19:10.88,Default,,0,0,0,,لا تقف بيني وبين كانكي اليوم
Dialogue: 0,0:19:11.40,0:19:13.92,Default,,0,0,0,,اجعل الطليعة تتخذ من التل حصنًا
Dialogue: 0,0:19:13.92,0:19:14.77,Default,,0,0,0,,!حاضر
Dialogue: 0,0:19:14.77,0:19:16.72,Default,,0,0,0,,!تقرير آخر
Dialogue: 0,0:19:16.72,0:19:18.90,Default,,0,0,0,,...العدو الّذي اخترق جبهتنا اليمنى
Dialogue: 0,0:19:18.90,0:19:21.09,Default,,0,0,0,,!على وشك اختراق قواتنا الاحتياطية أيضًا
Dialogue: 0,0:19:21.09,0:19:24.43,Default,,0,0,0,,!إنّهم في طريقهم لاقتحام التل المركزي
Dialogue: 0,0:19:27.90,0:19:31.60,Default,,0,0,0,,بدأ جيش تشاو بالتقدم نحو التل المركزي
Dialogue: 0,0:19:34.52,0:19:35.41,Default,,0,0,0,,!تبًّا
Dialogue: 0,0:19:35.70,0:19:39.33,Default,,0,0,0,,!بدأوا بالتسلق فعلًا! يا لجرأة هؤلاء
Dialogue: 0,0:19:39.33,0:19:42.31,Default,,0,0,0,,!يا زينو، علينا تأمين طريق إلى اليمين
Dialogue: 0,0:19:42.31,0:19:46.41,Default,,0,0,0,,!سنهجم على أجنحة هؤلاء الأغبياء الّذين يتباطؤون عند القاعدة
Dialogue: 0,0:19:46.41,0:19:48.92,Default,,0,0,0,,...مهمتك هنا
Dialogue: 0,0:19:48.92,0:19:52.42,Default,,0,0,0,,هي توجيه قوتي يا رايدو
Dialogue: 0,0:20:02.13,0:20:03.14,Default,,0,0,0,,!توقفوا
Dialogue: 0,0:20:20.73,0:20:25.98,Default,,0,0,0,,ذلك المدعو كيشا يقاتل بضراوةٍ أيضًا
Dialogue: 0,0:20:26.89,0:20:30.21,Default,,0,0,0,,الجزء الأكثر رعبًا في الحرب
Dialogue: 0,0:20:30.69,0:20:33.71,Default,,0,0,0,,،هو حين تظن أنّك تملك اليد العليا
Dialogue: 0,0:20:33.71,0:20:37.76,Default,,0,0,0,,لتجد نفسك تحدق في فكيّ الموت فجأةً
Dialogue: 0,0:20:37.76,0:20:42.26,Default,,0,0,0,,هل تفهمون كلامي أيّها القردة القرويون؟
Dialogue: 0,0:20:42.65,0:20:44.85,Default,,0,0,0,,أجل... بوضوح تام
Dialogue: 0,0:20:45.71,0:20:48.55,Default,,0,0,0,,!أنتَ تقول إنّك أحمق لعين
Dialogue: 0,0:21:00.67,0:21:03.86,Default,,0,0,0,,يبدو أنَّ غاكوي قد اشتبك مع العدو
Dialogue: 0,0:21:03.90,0:21:08.65,Default,,0,0,0,,هل سيكون بخير؟ فهؤلاء الّذين يتقدمون نحوهم ليسوا مجرد خصومٍ عاديين
Dialogue: 0,0:21:08.86,0:21:10.90,Default,,0,0,0,,سيكون غاكوي بخير
Dialogue: 0,0:21:10.90,0:21:14.37,Default,,0,0,0,,إنّه في وضع آمن 10 آلاف مرّةٍ من مقامرتك تلك
Dialogue: 0,0:21:15.17,0:21:16.33,Default,,0,0,0,,...وعلاوةً على ذلك
Dialogue: 0,0:21:16.33,0:21:20.81,Default,,0,0,0,,نزل كيشا-ساما بنفسه إلى الميدان، هؤلاء الأعداء على حافة الموت
Dialogue: 0,0:21:23.89,0:21:25.85,Default,,0,0,0,,...كيشا-سما
Dialogue: 0,0:21:26.88,0:21:30.80,Default,,0,0,0,,أشد رعبًا ممّا قيل عنه
Dialogue: 0,0:21:31.81,0:21:33.40,Default,,0,0,0,,كيف تنوي إيقافهم؟
Dialogue: 0,0:21:33.61,0:21:35.76,Default,,0,0,0,,لن أذهب إلى هناك لإيقافهم
Dialogue: 0,0:21:35.76,0:21:37.28,Default,,0,0,0,,بل سأذهب لاصطيادهم
Dialogue: 0,0:21:39.89,0:21:42.85,Default,,0,0,0,,!ولكن، العدو ليس في ذلك الاتجاه
Dialogue: 0,0:21:42.85,0:21:46.11,Default,,0,0,0,,ابقَ هناك وانتظر يا كيسوي
Dialogue: 0,0:21:46.11,0:21:49.34,Default,,0,0,0,,سأمتعكَ بصوت ذراع كانيين
Dialogue: 0,0:21:50.33,0:21:51.78,Default,,0,0,0,,وهي تتحطم
Dialogue: 0,0:21:55.65,0:21:57.71,Default,,0,0,0,,...يا... لهذا الثقل
Dialogue: 0,0:21:59.43,0:22:00.42,Default,,0,0,0,,!بيهي
Dialogue: 0,0:22:02.52,0:22:05.04,Default,,0,0,0,,!بيهي !بيهي
Dialogue: 0,0:22:05.04,0:22:06.49,Default,,0,0,0,,!بيهي
Dialogue: 0,0:22:07.19,0:22:09.09,Default,,0,0,0,,!أ... أنا بخير
Dialogue: 0,0:22:09.09,0:22:10.68,Default,,0,0,0,,...الأهم من ذلك
Dialogue: 0,0:22:11.39,0:22:13.31,Default,,0,0,0,,!اهربوا
Dialogue: 0,0:22:13.87,0:22:15.56,Default,,0,0,0,,!أيّها الحثالة
Dialogue: 0,0:22:15.56,0:22:18.82,Default,,0,0,0,,!يا لكم من جريئين حتّى تحاولوا شنَّ هجومٍ مباغتٍ على جيش كانكي
Dialogue: 0,0:22:22.82,0:22:24.87,Default,,0,0,0,,...قـ-قوي
Dialogue: 0,0:22:25.25,0:22:28.65,Default,,0,0,0,,...أن يُهزم جنود كانكي بهذه السهولة
Dialogue: 0,0:22:28.65,0:22:30.71,Default,,0,0,0,,الأمر ليس مجرد عامل مفاجأة
Dialogue: 0,0:22:30.71,0:22:34.30,Default,,0,0,0,,!هذه الوحدة المعادية... قوية بشكلٍ خطير
Dialogue: 0,0:22:35.11,0:22:37.33,Default,,0,0,0,,!أحسنتَ صنعًا يا كيشا-سما
Dialogue: 0,0:22:38.30,0:22:39.58,Default,,0,0,0,,كيشا؟
Dialogue: 0,0:22:39.90,0:22:41.09,Default,,0,0,0,,‫كيشا؟!
Dialogue: 0,0:22:41.83,0:22:45.65,Default,,0,0,0,,أليس كيشا هو القائد العام لجيش تشاو؟
Dialogue: 0,0:22:45.65,0:22:49.83,Default,,0,0,0,,يبدو أنَّ هذا هو صفهم الثاني يا كيشا-سما
Dialogue: 0,0:22:51.21,0:22:55.18,Default,,0,0,0,,ما الّذي يفعله قائدهم الأعلى هنا؟
Dialogue: 0,0:22:55.99,0:23:00.06,Default,,0,0,0,,ثمة بضع وحداتٍ أخرى تلحق بنا من الخلف
Dialogue: 0,0:23:00.25,0:23:02.39,Default,,0,0,0,,اسحقوهم جميعًا
Dialogue: 0,0:23:02.39,0:23:04.19,Default,,0,0,0,,لا تدعوا أيّ فرقةٍ تمرّ
Dialogue: 0,0:23:04.58,0:23:07.94,Default,,0,0,0,,هنا سنفصل رأسهم عن تعزيزاتهم
Dialogue: 0,0:23:08.30,0:23:09.69,Default,,0,0,0,,!فصل؟
Dialogue: 0,0:23:10.21,0:23:13.80,Default,,0,0,0,,أنتَ من بدأ هذا، ولا عودة الآن يا كانكي
Dialogue: 0,0:24:45.02,0:24:49.43,Default,,0,0,0,,كوكويو ليلًا
Dialogue: 0,0:24:49.43,0:24:53.08,Default,,0,0,0,,"الحلقة القادمة من المملكة: "كوكويو ليلًا\Nكوكويو ليلًا
Dialogue: 0,0:24:53.08,0:24:55.00,Default,,0,0,0,,كوكويو ليلًا
