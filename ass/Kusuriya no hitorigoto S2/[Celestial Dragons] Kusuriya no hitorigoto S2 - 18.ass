Dialogue: 0,0:01:42.17,0:01:43.46,Main,Jinshi,0,0,0,,المعذرة منكِ
Dialogue: 0,0:01:43.46,0:01:44.54,Main,Hongniang,0,0,0,,!جينشي-ساما
Dialogue: 0,0:01:45.10,0:01:47.51,Main,Jinshi,0,0,0,,هل أجاء المحظيّة غيوكويو المخاض؟
Dialogue: 0,0:01:47.51,0:01:48.40,Main,Hongniang,0,0,0,,أجل
Dialogue: 0,0:01:48.40,0:01:49.75,Main,Hongniang,0,0,0,,منذ الصّباح الباكر
Dialogue: 0,0:01:49.75,0:01:54.09,Main,Hongniang,0,0,0,,حدث هذا في وقتٍ أسبق من المقرّر إلّا أنَّ الاستعدادات الّلازمة جاهزةٌ
Dialogue: 0,0:01:54.79,0:01:55.76,Main,Hongniang,0,0,0,,تفضّل
Dialogue: 0,0:02:06.95,0:02:08.06,Main,Jinshi,0,0,0,,ما الوضع؟
Dialogue: 0,0:02:08.36,0:02:10.65,Main,Luomen,0,0,0,,حاليًا، حالتها مستقرّة
Dialogue: 0,0:02:11.03,0:02:14.72,Main,Luomen,0,0,0,,طالما أنَّ التّقلصات قلّت فلن تُبدي أيّ علاماتٍ للتّعب
Dialogue: 0,0:02:15.69,0:02:16.56,Main,Jinshi,0,0,0,,فهمتك
Dialogue: 0,0:02:17.21,0:02:20.57,Main,Luomen,0,0,0,,كما لم يتّضح يقينًا الموعد المقدّر للولادة
Dialogue: 0,0:02:21.15,0:02:22.95,Main,Jinshi,0,0,0,,ما وضع الجنين؟
Dialogue: 0,0:02:22.95,0:02:26.34,Main,Luomen,0,0,0,,إن كنت تقصد الولادة المقعديّة فلا تقلق بشأن ذلك
Dialogue: 0,0:02:26.34,0:02:29.93,Main,Luomen,0,0,0,,حقّق علاج ماوماو المفعول المراد
Dialogue: 0,0:02:31.67,0:02:32.73,Main,Jinshi,0,0,0,,...ماوماو
Dialogue: 0,0:02:34.63,0:02:37.70,Main,Jinshi,0,0,0,,مرّت عشرة أيّامٍ، على عدم عثورنا عليها
Dialogue: 0,0:02:38.49,0:02:39.69,Main,Jinshi,0,0,0,,أهي على ما يرام؟
Dialogue: 0,0:02:46.86,0:02:50.84,Main,Guen,0,0,0,,لـ-لومين-سان، أهنالك أيّ شيءٍ بمقدوري فعله للمساعدة؟
Dialogue: 0,0:02:50.84,0:02:52.85,Main,Yinghua,0,0,0,,تنحّ جانبًا أيّها الطّبيب
Dialogue: 0,0:02:52.85,0:02:55.46,Main,Guiyuan,0,0,0,,!هلّا تبتعد عن مدخل الباب رجاءً
Dialogue: 0,0:02:56.65,0:02:58.42,Main,Koku-u,0,0,0,,!انتبه للهرّة من فضلك
Dialogue: 0,0:02:58.42,0:02:59.47,Main,Guen,0,0,0,,!حـ-حسنٌ
Dialogue: 0,0:03:04.81,0:03:08.87,Main,Jinshi,0,0,0,,رؤية شخصٍ آخر مرتبكٍ أكثر منّي بعث في نفسي نوعًا من الهدوء
Dialogue: 0,0:03:13.47,0:03:15.85,Main,Jinshi,0,0,0,,عليه، سأرجع بعد برهةٍ
Dialogue: 0,0:03:15.85,0:03:17.75,Main,Jinshi,0,0,0,,في حال استجدّ أي شيءٍ فأعلميني عنه
Dialogue: 0,0:03:18.90,0:03:19.92,Main,Gaoshun,0,0,0,,!جينشي-ساما
Dialogue: 0,0:03:20.39,0:03:21.22,Main,Jinshi,0,0,0,,ما الأمر؟
Dialogue: 0,0:03:22.74,0:03:25.08,Main,Gaoshun,0,0,0,,أودّ أن أحدّثك عن المخصيّ المفقود
Dialogue: 0,0:03:29.19,0:03:31.31,Main,Jinshi,0,0,0,,بالتّالي، ما الّذي توصّلت له؟
Dialogue: 0,0:03:31.90,0:03:33.89,Main,Gaoshun,0,0,0,,"يُدعى المخصيّ "تيان
Dialogue: 0,0:03:33.89,0:03:36.91,Main,Gaoshun,0,0,0,,سمعت حديثًا مفاده أنّه عبد رقيقٍ سابقٍ من قبيلةٍ أجنبية
Dialogue: 0,0:03:36.91,0:03:40.82,Main,Gaoshun,0,0,0,,يبدو أنّه لم يكن يعرف أيّ فردٍ من المجموعة المفترض قدومه معها
Dialogue: 0,0:03:40.82,0:03:43.95,Main,Gaoshun,0,0,0,,أرجح القول، أنّه تسلّل من مكانٍ آخر
Dialogue: 0,0:03:45.72,0:03:47.95,Main,Jinshi,0,0,0,,بغية الدّخول إلى القصر الخلفي سرًا
Dialogue: 0,0:03:49.21,0:03:53.13,Main,Gaoshun,0,0,0,,امتنع عن التّقرّب من الآخرين ليتجنّب كشف نفسه
Dialogue: 0,0:03:53.13,0:03:56.11,Main,Gaoshun,0,0,0,,نتيجةً لذلك، ثمّة القليل من المعلومات المتواردة عنه
Dialogue: 0,0:03:58.31,0:03:59.13,Main,Jinshi,0,0,0,,ماذا بعد؟
Dialogue: 0,0:03:59.13,0:04:02.39,Main,Gaoshun,0,0,0,,ثمّة شاهدٌ شهده يتردّد بالدّعاء عند الضّريح
Dialogue: 0,0:04:02.83,0:04:05.66,Main,Jinshi,0,0,0,,إن كان متدينًا فلن يكون هذا الأمر محطًا للشّكّ
Dialogue: 0,0:04:06.51,0:04:07.85,Main,Gaoshun,0,0,0,,...إلّا أنَّ هذا
Dialogue: 0,0:04:12.86,0:04:15.85,Main,Jinshi,0,0,0,,في الجانب الشماليّ تتواجد المقبرة
Dialogue: 0,0:04:15.85,0:04:16.31,Main,Gaoshun,0,0,0,,أصبت
Dialogue: 0,0:04:16.94,0:04:21.94,Main,Gaoshun,0,0,0,,إنّها مقبرة معشوقات الإمبراطور الرّاحل العاملات ممّن وافتهنّ المنيّة في القصر الخلفي
Dialogue: 0,0:04:25.56,0:04:30.26,Main,Gaoshun,0,0,0,,شوهد تيان عند شاهد أحد القبور يدعو هناك
Dialogue: 0,0:04:35.08,0:04:42.94,Main,Jinshi,0,0,0,,في عهد الإمبراطور الرّاحل، لم يسمح للفتيات الصّغيرات اللّواتي فقدن زهرة عذريّتهنّ في سنٍ مبكرةٍ بمغادرة القصر الخلفي حتّى بعد مماتهنّ
Dialogue: 0,0:04:48.09,0:04:50.67,Main,Jinshi,0,0,0,,لم يدرجن ضمن السّجلات مطلقًا
Dialogue: 0,0:04:51.95,0:04:53.80,Main,Jinshi,0,0,0,,كما تلاشين في صمتٍ من هذه الحديقة
Dialogue: 0,0:05:01.91,0:05:03.53,Main,Jinshi,0,0,0,,أهذه عاملةٌ من المستوصف؟
Dialogue: 0,0:05:04.94,0:05:06.94,Main,Shenlü,0,0,0,,!أ-أرجو المعذرة
Dialogue: 0,0:05:12.33,0:05:13.58,Main,Jinshi,0,0,0,,...إنّها رائحة
Dialogue: 0,0:05:22.05,0:05:23.42,Main,Jinshi,0,0,0,,إلى أين ذهبت ماوماو؟
Dialogue: 0,0:05:29.32,0:05:30.70,Main,Jinshi,0,0,0,,عليّ الهدوء
Dialogue: 0,0:05:30.70,0:05:33.06,Main,Jinshi,0,0,0,,الآن، أؤدّي دور المخصيّ جينشي
Dialogue: 0,0:05:33.06,0:05:34.56,Main,Jinshi,0,0,0,,عليّ التصرّف كعادتي
Dialogue: 0,0:05:37.98,0:05:42.58,Main,Jinshi,0,0,0,,أريد أن أطرح عليكِ سؤالًا، يخصّ خادمةً ذات نمشٍ تخدم في جناح اليشم
Dialogue: 0,0:05:43.06,0:05:44.75,Main,Jinshi,0,0,0,,أتعين من أعنيه؟
Dialogue: 0,0:05:54.69,0:05:56.04,Main,Jinshi,0,0,0,,تعرفين أمرًا ما عنها، صحيح؟
Dialogue: 0,0:05:57.32,0:06:00.70,Main,Shenlü,0,0,0,,تبادرت من أعماق ذهني
Dialogue: 0,0:06:00.70,0:06:02.42,Main,Shenlü,0,0,0,,"ذكرى عتيقة"
Dialogue: 0,0:06:06.42,0:06:09.32,Main,Shenlü,0,0,0,,نادى على اسمي بصوته اللّطيف العذب
Dialogue: 0,0:06:10.50,0:06:14.24,Main,Shenlü,0,0,0,,كما أنّه أهداني حلوى أجنبيّة الصّنع لأتناولها
Dialogue: 0,0:06:27.80,0:06:29.15,Main,Jinshi,0,0,0,,ما الّذي تتحدّثين عنه؟
Dialogue: 0,0:06:29.78,0:06:34.33,Main,Shenlü,0,0,0,,لا أحد منكم كان يعرف ملامح وجهه جيدًا خلال شبابه، أليس كذلك؟
Dialogue: 0,0:06:35.05,0:06:38.41,Main,Shenlü,0,0,0,,بعد سنين، سمعت أنّه أصبح منغلقًا على نفسه على غير السّابق
Dialogue: 0,0:06:39.01,0:06:42.86,Main,Shenlü,0,0,0,,بعدما كبرت في السنّ، كفّ عن المجيء لزيارتي
Dialogue: 0,0:06:42.86,0:06:45.22,Main,Shenlü,0,0,0,,بتّ أسمع عن قصصه فحسب
Dialogue: 0,0:06:45.94,0:06:47.65,Main,Jinshi,0,0,0,,عن أيّ أحدٍ تقصدين؟
Dialogue: 0,0:06:47.65,0:06:49.93,Main,Shenlü,0,0,0,,أنت تشببه في مظهره تمامًا
Dialogue: 0,0:06:49.93,0:06:51.30,Main,Jinshi,0,0,0,,ما الّذي تتحدّثين عنه؟
Dialogue: 0,0:06:51.77,0:06:57.62,Main,Shenlü,0,0,0,,كان يمتلك حضرته أيضًا صوتًا أحلى من العسل الصّافي
Dialogue: 0,0:06:57.62,0:07:01.10,Main,Shenlü,0,0,0,,بملامح وجهٍ تنتمي لرجلٍ سماويّ
Dialogue: 0,0:07:02.09,0:07:07.88,Main,Shenlü,0,0,0,,لماذا يدّعي شخصٌ مثلك في منزلته الموقّرة بالإخصاء؟
Dialogue: 0,0:07:11.91,0:07:13.10,Main,Gaoshun,0,0,0,,أمسكوها
Dialogue: 0,0:07:13.78,0:07:14.97,Main,Shenlü,0,0,0,,أفلتوني
Dialogue: 0,0:07:14.97,0:07:16.12,Main,Gaoshun,0,0,0,,كفاكِ مقاومةً
Dialogue: 0,0:07:17.64,0:07:19.80,Main,Gaoshun,0,0,0,,جينشي-ساما، ما أوامرك؟
Dialogue: 0,0:07:22.38,0:07:23.56,Main,Gaoshun,0,0,0,,!جينشي-ساما
Dialogue: 0,0:07:31.63,0:07:33.47,Main,Gaoshun,0,0,0,,!ماذا يكون؟! أهو سمّ؟
Dialogue: 0,0:07:35.05,0:07:36.09,Main,Gaoshun,0,0,0,,أحضر الماء
Dialogue: 0,0:07:36.09,0:07:36.81,Main,Eunuch 1,0,0,0,,أمرك
Dialogue: 0,0:07:38.22,0:07:40.18,Main,Gaoshun,0,0,0,,جينشي-ساما، ما إرشاداتك؟
Dialogue: 0,0:07:42.69,0:07:43.60,Main,Gaoshun,0,0,0,,!جينشي-ساما
Dialogue: 0,0:07:48.60,0:07:50.50,Main,Gaoshun,0,0,0,,انقلها إلى العيادة الطبّية
Dialogue: 0,0:07:50.50,0:07:52.78,Main,Gaoshun,0,0,0,,احرص على ألّا تفعل شيئًا مشابهًا
Dialogue: 0,0:07:52.78,0:07:53.52,Main,Eunuch 2,0,0,0,,حاضر
Dialogue: 0,0:07:56.97,0:07:58.65,Main,Gaoshun,0,0,0,,تماسك لضبط نفسك
Dialogue: 0,0:07:58.65,0:08:01.24,Main,Gaoshun,0,0,0,,لا تجزع من خدعةٍ قالتها امرأةٌ عاملة
Dialogue: 0,0:08:02.60,0:08:03.92,Main,Jinshi,0,0,0,,!خدعة؟
Dialogue: 0,0:08:05.09,0:08:07.53,Main,Jinshi,0,0,0,,أخاطرت بحياتها من باب الخداع؟
Dialogue: 0,0:08:10.76,0:08:14.51,Main,Jinshi,0,0,0,,بدى محياها شاحبًا بعد أن رأتني أتبسّم في وجهها
Dialogue: 0,0:08:15.04,0:08:16.76,Main,Shenlü,0,0,0,,كان يمتلك حضرته أيضًا
Dialogue: 0,0:08:18.20,0:08:22.23,Main,Jinshi,0,0,0,,غاوشون، أتراي أبدو مشابهًا لذلك الشّخص؟
Dialogue: 0,0:08:22.67,0:08:25.78,Main,Jinshi,0,0,0,,هل أصبتها بالخوف لدرجةٍ جعلتها تشرب السمّ؟
Dialogue: 0,0:08:28.05,0:08:30.13,Main,Jinshi,0,0,0,,كنت دومًا ما أتذكّر ذلك الشّخص
Dialogue: 0,0:08:30.90,0:08:32.81,Main,Jinshi,0,0,0,,"على أنّه "رجلٌ عجوزٌ كهلٌ
Dialogue: 0,0:08:34.94,0:08:38.12,Main,Jinshi,0,0,0,,لم أشبه أيًا من أمّي أو أخي الأكبر على الإطلاق
Dialogue: 0,0:08:38.93,0:08:39.76,Main,Jinshi,0,0,0,,،عليه
Dialogue: 0,0:08:40.93,0:08:42.46,Main,Jinshi,0,0,0,,...عليه، صدّقت أنّ
Dialogue: 0,0:08:43.95,0:08:46.25,Main,Lady-in-Waiting A,0,0,0,,إلى من تعود ملامحه؟
Dialogue: 0,0:08:46.25,0:08:51.14,Main,Lady-in-Waiting A,0,0,0,,،بوضع ذائقة الإمبراطور في عين الاعتبار لا بدّ أنّها ليست عقيلة الإمبراطور نظرًا لصغر عمرها، أليس كذلك؟
Dialogue: 0,0:08:53.00,0:08:55.20,Main,Lady-in-Waiting B,0,0,0,,لهذا السّبب ما يقوله النّاس صائبٌ، صحيح؟
Dialogue: 0,0:08:55.20,0:08:56.66,Main,Lady-in-Waiting B,0,0,0,,"أنّه طفلٌ غير شرعي"
Dialogue: 0,0:09:04.35,0:09:07.51,Main,Jinshi,0,0,0,,صدّقت الشّائعات المتداولة عن عدم قرابتي بالنّسل
Dialogue: 0,0:09:07.95,0:09:10.52,Main,Jinshi,0,0,0,,"كما حاولت التهرّب من منصب "وليّ للعهد
Dialogue: 0,0:09:11.57,0:09:17.30,Main,Jinshi,0,0,0,,توسّلت أخي الأكبر "الإمبراطور" لأعرف السّبب وراء جعله أنتحل شخصيّة المخصيّ داخل حيّز القصر الخلفيّ؟
Dialogue: 0,0:09:17.30,0:09:18.35,Main,Jinshi,0,0,0,,ما مغزاه من ذلك؟
Dialogue: 0,0:09:19.99,0:09:21.88,Main,Jinshi,0,0,0,,لا أراه سوى أمرٍ مثيرٍ للسّخرية
Dialogue: 0,0:09:51.61,0:09:54.44,Main,Luomen,0,0,0,,...هذا كلّ يسع وسعي
Dialogue: 0,0:09:55.23,0:09:56.70,Main,Maomao,0,0,0,,فعله فحسب
Dialogue: 0,0:09:58.36,0:09:59.76,Main,Jinshi,0,0,0,,هذا صحيح
Dialogue: 0,0:09:59.76,0:10:01.58,Main,Jinshi,0,0,0,,عليّ تأجيل السّخرية من نفسي لاحقًا
Dialogue: 0,0:10:01.98,0:10:03.71,Main,Jinshi,0,0,0,,حاليًا، يجب عليّ فعل ما يتوجّب
Dialogue: 0,0:10:05.27,0:10:08.79,Main,Jinshi,0,0,0,,أهمّت عاملة القصر تلك بالدّعاء عند هذا القبر؟
Dialogue: 0,0:10:08.79,0:10:09.56,Main,Gaoshun,0,0,0,,نعم
Dialogue: 0,0:10:11.97,0:10:13.20,Main,Jinshi,0,0,0,,!كرز القدس؟
Dialogue: 0,0:10:13.20,0:10:14.63,Main,Jinshi,0,0,0,,يبدو أنَّ موسمها انتهى
Dialogue: 0,0:10:16.68,0:10:18.19,Main,Jinshi,0,0,0,,...تايـ...ـهو
Dialogue: 0,0:10:18.83,0:10:21.06,Main,Gaoshun,0,0,0,,إنّها عاملة قصرٍ توفّيت العام الماضي
Dialogue: 0,0:10:21.85,0:10:22.71,Main,Jinshi,0,0,0,,أصبت
Dialogue: 0,0:10:23.35,0:10:26.23,Main,Jinshi,0,0,0,,كانت غالبًا ما تحشد الفتيات لسرد خرافات الأشباح
Dialogue: 0,0:10:27.73,0:10:30.70,Main,Jinshi,0,0,0,,بلا شكّ، كانت وصيفةً لمحظيةٍ محددة
Dialogue: 0,0:10:37.96,0:10:39.31,Main,Jinshi,0,0,0,,...من أقاربها
Dialogue: 0,0:10:43.49,0:10:46.24,Main,Jinshi,0,0,0,,تبقّى شخصٌ وحيدٌ فحسب يربط تايهو بالنّسل...
Dialogue: 0,0:10:46.78,0:10:50.99,Main,Jinshi,0,0,0,,،في أيّام حكم الإمبراطور الرّاحل ولدت ابنةٌ من علاقة غير مشروعةٍ مع طبيبٍ من القصر
Dialogue: 0,0:10:53.69,0:10:56.07,Main,Jinshi,0,0,0,,...في حال كانت الفتاة على قيد الحياة
Dialogue: 0,0:11:02.29,0:11:03.56,Main,Gaoshun,0,0,0,,إلى أين ستتّجه؟
Dialogue: 0,0:11:03.56,0:11:04.67,Main,Jinshi,0,0,0,,"جناح العقيق"
Dialogue: 0,0:11:13.89,0:11:17.77,Main,Jinshi,0,0,0,,"مُنحت "محظيّة" الوصيفة تايهو للمسؤول "شويشو
Dialogue: 0,0:11:17.77,0:11:19.10,Main,Jinshi,0,0,0,,ما أنجبت له ابنةً لاحقًا
Dialogue: 0,0:11:19.79,0:11:21.95,Main,Jinshi,0,0,0,,"كانت تلك الفتاة هي القرينة "لولان
Dialogue: 0,0:11:22.61,0:11:26.81,Main,Jinshi,0,0,0,,إضافةً لذلك، الابنة الّتي أنجبتها تايهو والطّبيب من القصر الخلفيّ
Dialogue: 0,0:11:27.79,0:11:30.54,Main,Jinshi,0,0,0,,"اختفت دون أثرٍ مع ذلك الطّبيب"
Dialogue: 0,0:11:31.20,0:11:33.10,Main,Jinshi,0,0,0,,"بعدما نفي من القصر الخلفيّ"
Dialogue: 0,0:11:42.98,0:11:47.88,Main,Jinshi,0,0,0,,لربّما القرينة لولان تدري عن مكان ذلك الطّبيب وابنته المفقودة
Dialogue: 0,0:11:49.64,0:11:51.90,Main,Jinshi,0,0,0,,مع ذلك، يظلّ هذا مجرّد حدسٍ
Dialogue: 0,0:11:51.90,0:11:54.34,Main,Jinshi,0,0,0,,لعلّ هذه المجريات غير مرتبطةٍ في الحقيقة
Dialogue: 0,0:11:55.05,0:11:56.06,Main,Jinshi,0,0,0,,...بالرّغم من ذلك
Dialogue: 0,0:11:58.51,0:11:59.36,Main,Lady-in-Waiting A,0,0,0,,تفضّل
Dialogue: 0,0:12:00.67,0:12:03.15,Main,Jinshi,0,0,0,,في سبيل معرفة الأمر
Dialogue: 0,0:12:03.15,0:12:04.17,Main,Jinshi,0,0,0,,سأبذل كلّ جهدي
Dialogue: 0,0:12:10.45,0:12:12.81,Main,Jinshi,0,0,0,,عن قدومي المفاجيء لكِ خالص اعتذاري
Dialogue: 0,0:12:16.84,0:12:19.30,Main,Head Lady-in-Waiting,0,0,0,,"تقول إنّه: "لا مانع، لا عليك
Dialogue: 0,0:12:19.89,0:12:21.36,Main,Jinshi,0,0,0,,شكرًا جزيلًا
Dialogue: 0,0:12:22.69,0:12:25.29,Main,Jinshi,0,0,0,,إنّه من العجيب أنهنّ يبدنّ متشابهاتٍ دومًا
Dialogue: 0,0:12:25.29,0:12:27.40,Main,Jinshi,0,0,0,,يرتدن ثيابًا مبهرجاتٍ متطابقاتٍ
Dialogue: 0,0:12:27.40,0:12:29.55,Main,Jinshi,0,0,0,,ويضعن مستحضراتٍ تجعل أعينهنّ تبدو مشدودةً
Dialogue: 0,0:12:30.87,0:12:32.56,Main,Jinshi,0,0,0,,"يبدنّ أشبه "بالثّعالب
Dialogue: 0,0:12:33.66,0:12:36.69,Main,Jinshi,0,0,0,,...في هذه الأمسية، أودّ أن أطرح عليكِ سؤ
Dialogue: 0,0:12:40.20,0:12:40.94,Main,Gaoshun,0,0,0,,!جينشي-ساما؟
Dialogue: 0,0:12:43.48,0:12:44.36,Main,Head Lady-in-Waiting,0,0,0,,!ما أنت بفاعل؟
Dialogue: 0,0:12:47.73,0:12:50.33,Main,Jinshi,0,0,0,,أجزم أنّه كان لديكِ سبع وصيفاتٍ بلا ريب
Dialogue: 0,0:12:50.82,0:12:52.59,Main,Jinshi,0,0,0,,أين ذهبت الأخيرة؟
Dialogue: 0,0:12:54.02,0:12:58.95,Main,Jinshi,0,0,0,,أنا أرصد أسماء الوصيفات وأوجه الخادمات العاملات في القصر الخلفيّ
Dialogue: 0,0:12:59.87,0:13:03.82,Main,Jinshi,0,0,0,,مع ذلك، تبدّل تابعاتكِ ثيابهنّ ومستحضراتهنّ يوميًا
Dialogue: 0,0:13:04.34,0:13:07.39,Main,Jinshi,0,0,0,,إلّا أنّني حفظت السّمات الأسهل رصدًا
Dialogue: 0,0:13:07.71,0:13:11.91,Main,Jinshi,0,0,0,,على سبيل المثال، شكل شفاهكنّ ولون قزحيّة أعينكن
Dialogue: 0,0:13:12.82,0:13:14.25,Main,Jinshi,0,0,0,,...فضلًا عن ذلك
Dialogue: 0,0:13:16.20,0:13:17.74,Main,Jinshi,0,0,0,,مواقع تواجد شاماتكنّ
Dialogue: 0,0:13:19.38,0:13:20.95,Main,Jinshi,0,0,0,,!سولين؟
Dialogue: 0,0:13:20.95,0:13:22.86,Main,Jinshi,0,0,0,,!كلّا، بل أقصد "رينبو"؟
Dialogue: 0,0:13:23.43,0:13:24.81,Main,Jinshi,0,0,0,,إنّه اسمكِ
Dialogue: 0,0:13:27.75,0:13:30.04,Main,Jinshi,0,0,0,,دُبّر لهذه المسرحيّة منذ البداية، أليس كذلك؟
Dialogue: 0,0:13:30.67,0:13:32.94,Main,Jinshi,0,0,0,,"جلب حاشيةٍ غفيرةٍ في العدد"
Dialogue: 0,0:13:32.94,0:13:35.54,Main,Jinshi,0,0,0,,"اصطفاء خادماتٍ متشابهاتٍ في المظهر"
Dialogue: 0,0:13:35.99,0:13:39.35,Main,Jinshi,0,0,0,,"مرتدياتٍ ثيابًا مبهرجةً واضعاتٍ مستحضراتٍ غريبةٍ"
Dialogue: 0,0:13:39.99,0:13:42.59,Main,Jinshi,0,0,0,,كل ذلك كان لهذه اللّحظة
Dialogue: 0,0:13:43.61,0:13:44.50,Main,Sourin,0,0,0,,...جينشي
Dialogue: 0,0:13:44.50,0:13:45.13,Main,Jinshi,0,0,0,,!انطقي
Dialogue: 0,0:13:45.86,0:13:47.99,Main,Jinshi,0,0,0,,أين ذهبت الحقيقيّة؟
Dialogue: 0,0:13:50.58,0:13:52.46,Main,Jinshi,0,0,0,,أين ذهبت؟
Dialogue: 0,0:13:56.35,0:13:58.31,Main,Jinshi,0,0,0,,أين ذهبت القرينة لولان؟
Dialogue: 0,0:13:59.19,0:14:01.06,Main,Head Lady-in-Waiting,0,0,0,,لك خالص اعتذاري
Dialogue: 0,0:14:01.33,0:14:04.32,Main,Head Lady-in-Waiting,0,0,0,,لا تعرف رينبو حقًا شيئًا عن الأمر
Dialogue: 0,0:14:05.72,0:14:08.94,Main,Head Lady-in-Waiting,0,0,0,,أرجوك، اصفح عن فعلتها
Dialogue: 0,0:14:17.99,0:14:20.41,Main,Jinshi,0,0,0,,تبًا، عليّ التّحلّى بالهدوء
Dialogue: 0,0:14:23.58,0:14:26.55,Main,Jinshi,0,0,0,,عليه، ألم تسأليها إلى أين ذهبت؟
Dialogue: 0,0:14:27.08,0:14:28.05,Main,Head Lady-in-Waiting,0,0,0,,أجل
Dialogue: 0,0:14:28.05,0:14:29.98,Main,Head Lady-in-Waiting,0,0,0,,قيل لي أنّها لن تعود مطلقًا
Dialogue: 0,0:14:30.58,0:14:34.78,Main,Jinshi,0,0,0,,يبدو أنَّ القرينة رفيعة المقام غادرت القصر الخلفي بملء إرادتها
Dialogue: 0,0:14:50.29,0:14:52.72,Main,Jinshi,0,0,0,,لا جدوى من الإلحاح عليهنّ بالسّؤال
Dialogue: 0,0:14:56.66,0:14:58.65,Main,Gaoshun,0,0,0,,بحثنا عنها في كلّ بقاع القصر
Dialogue: 0,0:14:58.65,0:15:01.13,Main,Gaoshun,0,0,0,,إلّا أننا لم نتمكن من إيجاد القرينة لولان
Dialogue: 0,0:15:01.95,0:15:04.26,Main,Jinshi,0,0,0,,لا حاجة لدعوتها بالمحظيّة مجددًا
Dialogue: 0,0:15:05.95,0:15:08.38,Main,Jinshi,0,0,0,,مغادرة القصر الخلفي يعدّ جرمًا فادحًا
Dialogue: 0,0:15:08.78,0:15:10.94,Main,Jinshi,0,0,0,,بالأخص في حال كانت قرينةً رفيعة المقام
Dialogue: 0,0:15:12.31,0:15:14.64,Main,Jinshi,0,0,0,,لا بدّ أنها دبّرت لفعل ذلك كليًا
Dialogue: 0,0:15:15.05,0:15:16.00,Main,Gaoshun,0,0,0,,أجل
Dialogue: 0,0:15:17.19,0:15:20.44,Main,Jinshi,0,0,0,,"إدخال ابنة مسؤولٍ عالي الشّأن إلى القصر الخلفي"
Dialogue: 0,0:15:20.78,0:15:23.06,Main,Jinshi,0,0,0,,"يُعد صفقةً رابحةً للإمبراطور أيضًا"
Dialogue: 0,0:15:23.91,0:15:28.54,Main,Jinshi,0,0,0,,يمكنه حبسها "كأسيرةٍ" في قفص العصافير المعروف بالقصر الخلفي
Dialogue: 0,0:15:30.02,0:15:33.78,Main,Jinshi,0,0,0,,بدا أنَّ شويشو يولي اهتمامًا كبيرًا بابنته
Dialogue: 0,0:15:34.14,0:15:37.31,Main,Jinshi,0,0,0,,لكن لا يُدرى ما يضمره في الحقيقة؟
Dialogue: 0,0:15:40.53,0:15:43.17,Main,Jinshi,0,0,0,,ما الّذي كانت "ماوماو" ستفعله؟
Dialogue: 0,0:15:44.25,0:15:47.98,Main,Jinshi,0,0,0,,قالت مازحةً ذات مرةٍ أن الأمر أشبه بفصل المحظيّة الشّغالة من المهنة
Dialogue: 0,0:15:49.49,0:15:51.53,Main,Jinshi,0,0,0,,أذهبت معهم طواعيّةً؟
Dialogue: 0,0:15:52.23,0:15:55.30,Main,Jinshi,0,0,0,,إلّا أنّها لما كانت لتتكبّد عناء ترك التّنبيه لو كان الأمر كذلك
Dialogue: 0,0:15:56.26,0:15:59.39,Main,Jinshi,0,0,0,,إلى أين ذهبت بالضّبط؟ وما الغرض من ذلك؟
Dialogue: 0,0:16:05.34,0:16:06.52,Main,Lakan,0,0,0,,!ماذا؟
Dialogue: 0,0:16:06.90,0:16:08.72,Main,Lakan,0,0,0,,...أقلت إنّ ماوماو
Dialogue: 0,0:16:08.72,0:16:10.65,Main,Lakan,0,0,0,,مفقودةٌ؟
Dialogue: 0,0:16:16.59,0:16:19.45,Main,Lakan,0,0,0,,!اصبري يا ماوماو
Dialogue: 0,0:16:20.37,0:16:24.90,Main,Lakan,0,0,0,,!الآن، بابا آتٍ لينقذكِ
Dialogue: 0,0:16:27.10,0:16:29.75,Main,Onsou,0,0,0,,!لاكان-ساما
Dialogue: 0,0:16:31.39,0:16:33.30,Main,Jinshi,0,0,0,,كيف عرف الأمر؟
Dialogue: 0,0:16:33.30,0:16:35.76,Main,Basen,0,0,0,,يبدو أنَّ الأخبار تفشّت بطريقةٍ ما
Dialogue: 0,0:16:38.09,0:16:41.61,Main,Basen,0,0,0,,"إلى جانب ذلك، لم نتمكّن من تحديد موقع المسؤول "شويشو
Dialogue: 0,0:16:42.44,0:16:44.85,Main,Basen,0,0,0,,أهو متواطئٌ مع لولان يا ترى؟
Dialogue: 0,0:16:45.15,0:16:46.50,Main,Jinshi,0,0,0,,لا أعرف
Dialogue: 0,0:16:46.50,0:16:50.14,Main,Jinshi,0,0,0,,غير أنّه يعدّ فارًا بما أنّه والد المحظية الهاربة
Dialogue: 0,0:16:50.14,0:16:53.90,Main,Jinshi,0,0,0,,سيُعامل على أنّه مجرمٌ يحمل عداوةً تجاه الإمبراطور
Dialogue: 0,0:16:54.79,0:16:56.49,Main,Basen,0,0,0,,هكذا الأمر إذن
Dialogue: 0,0:16:57.05,0:16:58.00,Main,Basen,0,0,0,,صدقت
Dialogue: 0,0:16:58.00,0:17:00.58,Main,Basen,0,0,0,,"كذلك، عاملة القصر تلك من حادثة أمس؛ "شينلو
Dialogue: 0,0:17:01.16,0:17:03.07,Main,Basen,0,0,0,,لم تعد في حالةٍ حرجةٍ
Dialogue: 0,0:17:04.36,0:17:05.39,Main,Jinshi,0,0,0,,هل أفاقت؟
Dialogue: 0,0:17:06.11,0:17:07.67,Main,Basen,0,0,0,,ليس بعد
Dialogue: 0,0:17:09.22,0:17:13.28,Main,Basen,0,0,0,,"غير أن التحقيقات أسفرت عن كونها على درايةٍ بالمدعوّة "تايهو
Dialogue: 0,0:17:13.87,0:17:16.73,Main,Basen,0,0,0,,على الأغلب، انضمّت لهذا التّمرّد بناءً على ذلك
Dialogue: 0,0:17:17.66,0:17:19.35,Main,Jinshi,0,0,0,,أكافّة عاملات المستوصف متورّطات؟
Dialogue: 0,0:17:20.22,0:17:21.14,Main,Basen,0,0,0,,كلّا
Dialogue: 0,0:17:22.38,0:17:26.26,Main,Basen,0,0,0,,لم تعلم الأخريات أيّ شيءٍ عن التمرّد
Dialogue: 0,0:17:29.71,0:17:32.15,Main,Jinshi,0,0,0,,مع ذلك، يظلن متواطئاتٍ
Dialogue: 0,0:17:32.15,0:17:35.11,Main,Jinshi,0,0,0,,يبدو أنَّ جميعهنّ يكنّ ذات الضّغينة الدّفينة لدى شينلو
Dialogue: 0,0:17:36.36,0:17:42.49,Main,Jinshi,0,0,0,,،بعد رحيل الإمبراطور الرّاحل لمّا بلغ منهنّ الغضب أوجّه سلّطنه على القصر الخلفي بحدّ ذاته
Dialogue: 0,0:17:46.45,0:17:49.30,Main,Jinshi,0,0,0,,عليّ إيجاد لولان على الفور
Dialogue: 0,0:17:49.30,0:17:51.30,Main,Jinshi,0,0,0,,غير أنَّ المعلومات المتوفّرة غير كافية
Dialogue: 0,0:17:51.65,0:17:53.82,Main,Jinshi,0,0,0,,أيجدر بي أن أتقصّى عن شويشو أوّلًا؟
Dialogue: 0,0:17:54.92,0:17:55.90,Main,Jinshi,0,0,0,,كلّا
Dialogue: 0,0:17:55.90,0:17:57.80,Main,Jinshi,0,0,0,,يوجد شخصٌ آخر مكلّفٌ بفعل ذلك
Dialogue: 0,0:18:03.87,0:18:04.97,Main,Basen,0,0,0,,من عساه يكون؟
Dialogue: 0,0:18:05.78,0:18:06.39,Main,Jinshi,0,0,0,,ادخل
Dialogue: 0,0:18:08.33,0:18:09.94,Main,Lahan,0,0,0,,أستميحك المعذرة
Dialogue: 0,0:18:20.69,0:18:21.95,Main,Jinshi,0,0,0,,!أهذا عدّاد؟
Dialogue: 0,0:18:22.46,0:18:23.52,Main,Basen,0,0,0,,لم أتيت؟
Dialogue: 0,0:18:26.14,0:18:28.36,Main,Lahan,0,0,0,,إنّه لمن دواعي سروري لقياك
Dialogue: 0,0:18:28.36,0:18:30.50,Main,Lahan,0,0,0,,"أدعى "كان لاهان
Dialogue: 0,0:18:31.88,0:18:37.30,Main,Jinshi,0,0,0,,يتواجد في بلاط القصر الخارجيّ شخصان اثنان "يحملان لقب عشيرة "لا" ألّا هما: "لاكان ولاهان
Dialogue: 0,0:18:37.97,0:18:40.96,Main,Jinshi,0,0,0,,إنّه لقبٌ منحته العائلة الإمبراطورية منذ فترةٍ مديدةٍ
Dialogue: 0,0:18:42.42,0:18:44.20,Main,Jinshi,0,0,0,,!فردٌ من عشيرة "لا"؟
Dialogue: 0,0:18:44.20,0:18:46.07,Main,Jinshi,0,0,0,,لا بدّ أنّك ابن الاستراتيجي المتبنّى
Dialogue: 0,0:18:46.07,0:18:47.16,Main,Jinshi,0,0,0,,فيم أساعدك؟
Dialogue: 0,0:18:48.44,0:18:50.98,Main,Lahan,0,0,0,,أريد أن أريك ما جلبته بجعبتي
Dialogue: 0,0:18:59.00,0:19:00.08,Main,Jinshi,0,0,0,,...إنّه
Dialogue: 0,0:19:00.68,0:19:02.24,Main,Lahan,0,0,0,,ما قولك عنها؟
Dialogue: 0,0:19:03.72,0:19:05.66,Main,Jinshi,0,0,0,,سجلّ الماليّة التّابع لخزانة الأمّة
Dialogue: 0,0:19:06.08,0:19:07.40,Main,Lahan,0,0,0,,أصبت
Dialogue: 0,0:19:07.40,0:19:10.28,Main,Lahan,0,0,0,,أمرني والدي بالتّحقيق في أمرها
Dialogue: 0,0:19:10.28,0:19:14.35,Main,Lahan,0,0,0,,بما أنّه لم يعرف مُصدّر تلك البندقيّة فبات مُستاء البال على ذلك
Dialogue: 0,0:19:14.76,0:19:16.46,Main,Jinshi,0,0,0,,أنّى أن يقوده ذلك لخزانة الأمّة؟
Dialogue: 0,0:19:16.91,0:19:20.08,Main,Lahan,0,0,0,,بعد التّحقيق في أوضاع المسؤولين المعاقبين حديثًا
Dialogue: 0,0:19:20.80,0:19:22.12,Main,Lahan,0,0,0,,توصّل إلى الأمر
Dialogue: 0,0:19:22.60,0:19:28.16,Main,Lahan,0,0,0,,وددت لو تطّلع على المستندات الفعليّة إلّا أنّها كانت مأهولة الحجم
Dialogue: 0,0:19:28.89,0:19:31.63,Main,Lahan,0,0,0,,ما جعلني أقتبس منها هذه اللّفيفة بقدر الإمكان
Dialogue: 0,0:19:32.86,0:19:37.19,Main,Jinshi,0,0,0,,"ارتفعت أسعار المحاصيل على نحوٍ ملحوظٍ في السنوات القليلة الماضية"
Dialogue: 0,0:19:37.19,0:19:39.16,Main,Lahan,0,0,0,,هذا أمرٌ مثيرٌ للاهتمام، أليس كذلك؟
Dialogue: 0,0:19:39.16,0:19:41.93,Main,Lahan,0,0,0,,كما أنّه لم يطالنا أيّ جفافٌ ولا آفات جرادٍ
Dialogue: 0,0:19:42.44,0:19:44.30,Main,Lahan,0,0,0,,إضافةً لذلك، يوجد أمرٌ آخر
Dialogue: 0,0:19:44.30,0:19:46.66,Main,Lahan,0,0,0,,لسببٍ ما، زادت قيمة الحديد أيضًا
Dialogue: 0,0:19:47.31,0:19:49.99,Main,Lahan,0,0,0,,كذلك، أسعار سائر المعادن في جميع أنحاء البلاد
Dialogue: 0,0:19:52.27,0:19:56.43,Main,Lahan,0,0,0,,أتقام أيّ مشاريعٍ لتشييد بناياتٍ ضخمةٍ في بلادنا يا ترى؟
Dialogue: 0,0:19:56.85,0:20:01.26,Main,Lahan,0,0,0,,كما لم أجد مخططاتٍ لمثل هذه المشروعات أينما بحثت عنها
Dialogue: 0,0:20:01.90,0:20:05.04,Main,Jinshi,0,0,0,,من ناحية المكر والفطنة يشبه والده بالتّبنّي تمامًا
Dialogue: 0,0:20:06.12,0:20:07.76,Main,Jinshi,0,0,0,,استوعبت ما تقصده
Dialogue: 0,0:20:08.30,0:20:12.42,Main,Jinshi,0,0,0,,سعر محاصيل الحبوب زهيدٌ إلّا أنّه ينتج بكمياتٍ ضخمةٍ
Dialogue: 0,0:20:12.42,0:20:15.83,Main,Jinshi,0,0,0,,هذا الارتفاع الطّفيف في السّعر سيحدث فرقًا كبيرًا
Dialogue: 0,0:20:16.51,0:20:19.53,Main,Jinshi,0,0,0,,كما أنَّ هذا الفرق الطّفيف سيُوجد أحدًا يحرّض على النّهب
Dialogue: 0,0:20:20.10,0:20:22.40,Main,Jinshi,0,0,0,,بالإضافة إلى ذلك، ازدياد أسعار المعادن
Dialogue: 0,0:20:22.40,0:20:25.51,Main,Jinshi,0,0,0,,أوجد شخصًا ما اشترى كمياتٍ ضخمةً منها
Dialogue: 0,0:20:26.46,0:20:28.03,Main,Jinshi,0,0,0,,ألست تلمّح على ذلك؟
Dialogue: 0,0:20:28.54,0:20:29.90,Main,Lahan,0,0,0,,أنت محقٌ
Dialogue: 0,0:20:29.90,0:20:34.38,Main,Lahan,0,0,0,,من وجهة نظري، هذان الأمران يسلكان نفس النّهج تمامًا
Dialogue: 0,0:20:34.38,0:20:39.20,Main,Lahan,0,0,0,,بالإضافة لذلك، من يمكنهم الإقدام على مثل هذه المبادرة قلّة، أليس كذلك؟
Dialogue: 0,0:20:41.66,0:20:45.76,Main,Lahan,0,0,0,,بمقدوري الاستقصاء عن ذلك بشكلٍ مفصّلٍ أكثر
Dialogue: 0,0:20:47.10,0:20:52.51,Main,Lahan,0,0,0,,ألا يثير فضولك أن تعرف المصدر الّذي تتقاطع عنده كل هذه الوقائع؟
Dialogue: 0,0:21:00.10,0:21:02.07,Main,Jinshi,0,0,0,,عليه، ما الّذي ستطلبه في المقابل؟
Dialogue: 0,0:21:04.55,0:21:07.85,Main,Jinshi,0,0,0,,لم تحدّثني عن هذا الأمر من طيب خاطر، أليس كذلك؟
Dialogue: 0,0:21:07.85,0:21:08.74,Main,Basen,0,0,0,,!جينشي-ساما
Dialogue: 0,0:21:10.88,0:21:17.02,Main,Lahan,0,0,0,,بإمكانك أن تعطينا خصمًا جدّ قليـلٍ على هذه الفاتورة، أليس كذلك؟
Dialogue: 0,0:21:17.02,0:21:17.83,Main,Jinshi,0,0,0,,ماذا تكون؟
Dialogue: 0,0:21:18.11,0:21:22.27,Main,Lahan,0,0,0,,إنّها تكاليف إصلاح بوّابة القصر الخلفيّ المحطّمة من قبل والدي
Dialogue: 0,0:21:23.46,0:21:25.63,Main,Basen,0,0,0,,ألم يجني عواقب أفعاله؟
Dialogue: 0,0:21:26.01,0:21:26.93,Main,Jinshi,0,0,0,,حسنٌ
Dialogue: 0,0:21:26.93,0:21:28.39,Main,Basen,0,0,0,,ألا حرج في ذلك؟
Dialogue: 0,0:21:31.11,0:21:33.84,Main,Jinshi,0,0,0,,في المقابل، أودّ منك تحرى الأمر بشموليّةٍ
Dialogue: 0,0:21:33.84,0:21:36.40,Main,Jinshi,0,0,0,,تقصّى أمر مصدر الأموال والمعادن السّابق ذكرها
Dialogue: 0,0:21:36.40,0:21:38.34,Main,Jinshi,0,0,0,,كذلك المجريات التّابعة لهذه الأحداث
Dialogue: 0,0:21:42.71,0:21:44.65,Main,Lahan,0,0,0,,طلباتك أوامر
Dialogue: 0,0:21:46.65,0:21:48.50,Main,Jinshi,0,0,0,,...لسوف أستغلّ
Dialogue: 0,0:21:48.50,0:21:50.11,Main,Jinshi,0,0,0,,أي شيءٍ يُتاح أمامي
