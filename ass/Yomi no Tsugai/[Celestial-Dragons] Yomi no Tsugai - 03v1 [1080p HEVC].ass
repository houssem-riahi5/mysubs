Dialogue: 0,0:01:34.58,0:01:35.20,Main,,0,0,0,,تفضّل
Dialogue: 0,0:01:35.71,0:01:36.96,Main,,0,0,0,,طعامٌ وملابس لترتديها
Dialogue: 0,0:01:38.03,0:01:39.70,Main,,0,0,0,,ستلفت الأنظار بملابسك هذه
Dialogue: 0,0:01:40.16,0:01:41.38,Main,,0,0,0,,ارتدِ هذه مبدئيًّا
Dialogue: 0,0:01:47.74,0:01:48.88,Main,,0,0,0,,أهذا قميص؟
Dialogue: 0,0:01:48.88,0:01:52.33,Main,,0,0,0,,أجل، أجل، وهذا يشبه الهاكاما
Dialogue: 0,0:01:52.48,0:01:54.09,Main,,0,0,0,,وهذا أيضًا
Dialogue: 0,0:01:54.14,0:01:55.97,Main,,0,0,0,,حذاء من العالم السفليّ
Dialogue: 0,0:01:56.79,0:02:00.22,Main,,0,0,0,,مظهر العصابات هذا يلائمكَ يا سينباي
Dialogue: 0,0:02:00.58,0:02:02.12,Main,,0,0,0,,وما هذه؟
Dialogue: 0,0:02:02.16,0:02:04.39,Main,,0,0,0,,لا بُدَّ أنّكَ تعرف كرات الأرزّ
Dialogue: 0,0:02:04.96,0:02:06.43,Main,,0,0,0,,!أرزّ أبيض خالص؟
Dialogue: 0,0:02:06.63,0:02:07.76,Main,,0,0,0,,!وبِلا دخن؟
Dialogue: 0,0:02:07.88,0:02:09.39,Main,,0,0,0,,!وهذه بعشب البحر؟
Dialogue: 0,0:02:09.99,0:02:12.15,Main,,0,0,0,,!ألا تُعدُّ هذه مكوّناتٍ فاخرة؟
Dialogue: 0,0:02:13.72,0:02:15.76,Main,,0,0,0,,أظنّها كذلك في تلك القرية
Dialogue: 0,0:02:15.81,0:02:17.95,Main,,0,0,0,,كـ-كيف يُفتح هذا؟
Dialogue: 0,0:02:31.40,0:02:32.21,Main,,0,0,0,,تفضّل
Dialogue: 0,0:02:40.31,0:02:41.93,Main,,0,0,0,,!لذيذ
Dialogue: 0,0:02:42.60,0:02:46.06,Main,,0,0,0,,ما هذا؟ إنّه لذيذ، أهذا طعام الآلهة؟
Dialogue: 0,0:02:46.90,0:02:49.56,Main,,0,0,0,,هكذا إذن، كُل هذا أيضًا، كُل المزيد
Dialogue: 0,0:02:49.96,0:02:52.39,Main,,0,0,0,,أأنتَ عمّته؟
Dialogue: 0,0:02:54.94,0:02:59.06,Main,,0,0,0,,ليت لو كان بمقدور أسا تذوّق هذا الطعام
Dialogue: 0,0:03:01.00,0:03:02.58,Main,,0,0,0,,!يا ديرا
Dialogue: 0,0:03:04.19,0:03:05.54,Main,,0,0,0,,ما هذا المكان؟
Dialogue: 0,0:03:07.10,0:03:11.67,Main,,0,0,0,,تُسمى استراحة طريق، تُشبه ما كان يُعرف قديمًا بالمحطات القوافل
Dialogue: 0,0:03:11.67,0:03:13.67,Main,,0,0,0,,تضمّ مطاعم ودورات مياه
Dialogue: 0,0:03:14.15,0:03:16.25,Main,,0,0,0,,ويسعكَ شراءُ تذكاراتٍ محليّةٍ أيضًا
Dialogue: 0,0:03:20.16,0:03:21.94,Main,,0,0,0,,أتريدان إلقاء نظرةٍ بالداخل؟
Dialogue: 0,0:03:22.21,0:03:25.73,Main,,0,0,0,,كلّا، لا حاجة لذلك، سنبقى بجوار يورو
Dialogue: 0,0:03:25.81,0:03:28.69,Main,,0,0,0,,لِمَ لا تذهبان لتناول الطعام؟
Dialogue: 0,0:03:29.32,0:03:31.51,Main,,0,0,0,,سنحرس يورو بأنفسنا
Dialogue: 0,0:03:33.13,0:03:34.86,Main,,0,0,0,,سنقبل عرضكما إذن
Dialogue: 0,0:03:35.45,0:03:36.99,Main,,0,0,0,,لنذهب لتناول الطعام يا هانا-تشان
Dialogue: 0,0:03:37.08,0:03:37.62,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:03:37.97,0:03:40.78,Main,,0,0,0,,إيّاكما ولمس مقعد السائق
Dialogue: 0,0:03:40.98,0:03:43.89,Main,,0,0,0,,ألن نولي الخيول بالداخل أيّ نصيبٍ من الطعام؟
Dialogue: 0,0:03:44.25,0:03:46.01,Main,,0,0,0,,سأسقيها الزيت لاحقًا
Dialogue: 0,0:03:55.73,0:03:57.55,Main,,0,0,0,,ما مقدارُ ما بُحتَ لهُ به؟
Dialogue: 0,0:03:57.86,0:04:03.41,Main,,0,0,0,,إخباره بأنَّ من حسِبها أُخته طوال حياته لم تكن كذلك، كان كفيلًا بإفقاده صوابه
Dialogue: 0,0:04:03.68,0:04:06.55,Main,,0,0,0,,من الأفضل ألّا نُثقل كاهله بمزيدٍ من المعلومات
Dialogue: 0,0:04:06.55,0:04:08.39,Main,,0,0,0,,أنتَ لطيفٌ حقًّا
Dialogue: 0,0:04:08.78,0:04:10.68,Main,,0,0,0,,لا يزال فتًى غريرًا
Dialogue: 0,0:04:11.14,0:04:14.40,Main,,0,0,0,,أكره الأطفال لذا لا أفقه في هذا شيئًا
Dialogue: 0,0:04:15.27,0:04:17.10,Main,,0,0,0,,شكرًا على الطعام
Dialogue: 0,0:04:17.10,0:04:19.88,Main,,0,0,0,,إذن، ما خطّتنا الآن؟
Dialogue: 0,0:04:19.97,0:04:22.73,Main,,0,0,0,,أيكفي أن أُقلكُما إلى مخبئكَ يا سينباي؟
Dialogue: 0,0:04:22.73,0:04:26.52,Main,,0,0,0,,كلّا، فقد كُشف وجهي واسمي معًا
Dialogue: 0,0:04:26.52,0:04:29.01,Main,,0,0,0,,سأتخلّى عن مخبئي الحاليّ
Dialogue: 0,0:04:29.14,0:04:31.78,Main,,0,0,0,,أصبحتَ مُتشرّدًا وتعتني بطفل شخصٍ آخر إذن
Dialogue: 0,0:04:32.02,0:04:33.29,Main,,0,0,0,,يبدو هذا شاقًّا
Dialogue: 0,0:04:34.32,0:04:37.05,Main,,0,0,0,,لِمَ تتحدّثين وكأنَّ الأمر لا يَعنيكِ؟
Dialogue: 0,0:04:37.05,0:04:40.67,Main,,0,0,0,,ستتعاونين معي بصفتكِ خادمة تسوغاي من قرية هيغاشي
Dialogue: 0,0:04:40.84,0:04:44.37,Main,,0,0,0,,حسنٌ، سأفعلُ ما بوسعي على أيِّ حالٍ
Dialogue: 0,0:04:44.50,0:04:45.18,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:04:45.70,0:04:48.18,Main,,0,0,0,,لنتزوّج إذن يا هانا-تشان
Dialogue: 0,0:04:51.31,0:04:53.43,Main,,0,0,0,,!خاتم زواجنا
Dialogue: 0,0:04:53.62,0:04:56.02,Main,,0,0,0,,ألا يفارقُكِ ذاك الشيءُ أبدًا؟
Dialogue: 0,0:04:56.02,0:04:59.31,Main,,0,0,0,,!لِمَ عليَّ الزواج منكَ يا سينباي؟
Dialogue: 0,0:05:00.95,0:05:02.52,Main,,0,0,0,,إنّه زواجٌ صوريّ، صوريّ فحسب
Dialogue: 0,0:05:02.63,0:05:06.45,Main,,0,0,0,,علينا العيش وسط زحام الناس لحماية يورو من الآن فصاعدًا
Dialogue: 0,0:05:06.84,0:05:09.78,Main,,0,0,0,,،كما أنَّ أنباء الغرباء تجتاحُ الأرياف كالنار في الهشيم
Dialogue: 0,0:05:09.87,0:05:11.67,Main,,0,0,0,,لذا سنقصد مدينةً كبيرةً نوعًا ما
Dialogue: 0,0:05:12.48,0:05:15.64,Main,,0,0,0,,لكنّي أفتقر للثقة في قدرتي على حمايته بمفردي
Dialogue: 0,0:05:15.64,0:05:18.33,Main,,0,0,0,,!إذن لا داعي للزواج لفعل ذلك
Dialogue: 0,0:05:18.33,0:05:19.67,Main,,0,0,0,,!يسعنا السكن معًا فحسب
Dialogue: 0,0:05:19.97,0:05:22.27,Main,,0,0,0,,استئجار منزلٍ لعائلةٍ أيسرُ بكثيرٍ
Dialogue: 0,0:05:22.27,0:05:24.59,Main,,0,0,0,,فثقة الناس بهم تفوق غيرهم بأشواطٍ
Dialogue: 0,0:05:24.66,0:05:26.18,Main,,0,0,0,,...إن كان لا بدّ من التظاهر بأنّنا عائلة
Dialogue: 0,0:05:26.20,0:05:30.03,Main,,0,0,0,,!فيسعني التظاهر بأنّي أخت يورو-كن الكبرى إذن
Dialogue: 0,0:05:30.41,0:05:33.05,Main,,0,0,0,,!ويسعكَ التظاهر بأنّكَ والدنا الأعزب يا ديرا-سان
Dialogue: 0,0:05:33.29,0:05:36.66,Main,,0,0,0,,أبٌ تخلّتْ عنه زوجته ورمتْ الأطفال على كاهله؟
Dialogue: 0,0:05:36.75,0:05:38.13,Main,,0,0,0,,هربتْ على ما يبدو
Dialogue: 0,0:05:38.81,0:05:41.22,Main,,0,0,0,,أكان بسبب عنفٍ أُسريٍّ أم خيانةٍ يا ترى؟
Dialogue: 0,0:05:41.89,0:05:46.24,Main,,0,0,0,,أبٌ مُكافحٌ يواجهُ أعباءَ الحياة وحدهُ ليرعى أطفالهُ بعد وفاة زوجته؟
Dialogue: 0,0:05:46.24,0:05:48.00,Main,,0,0,0,,يا له من مسكين
Dialogue: 0,0:05:48.03,0:05:51.37,Main,,0,0,0,,يا لقسوة القدر، فلنقف بجانبه إن تعسّرت أموره
Dialogue: 0,0:05:51.78,0:05:56.48,Main,,0,0,0,,سنغدو حديث الجيران ومحطّ أنظارهم في كلتا الحالتين
Dialogue: 0,0:05:56.89,0:06:01.32,Main,,0,0,0,,لنتظاهر بأنَّ يورو ابني من زواج سابقٍ، وأنّي تزوّجتُ بشابّةٍ يافعةٍ
Dialogue: 0,0:06:01.48,0:06:03.43,Main,,0,0,0,,هذه مجرّد قصّةٍ مختلقةٍ لا غير
Dialogue: 0,0:06:03.70,0:06:04.83,Main,,0,0,0,,شكرًا لتفهّمكِ
Dialogue: 0,0:06:04.94,0:06:07.07,Main,,0,0,0,,لم أوافق بعدُ
Dialogue: 0,0:06:07.37,0:06:09.73,Main,,0,0,0,,من سيحمل اسم العائلة ويكون ربّ الأسرة؟
Dialogue: 0,0:06:10.05,0:06:10.82,Main,,0,0,0,,من سيكون؟
Dialogue: 0,0:06:12.26,0:06:13.92,Main,,0,0,0,,!كلّا
Dialogue: 0,0:06:14.00,0:06:19.43,Main,,0,0,0,,!قرّرتُ بالفعل أنّي سأتزوّج من جيسون ستاثام
Dialogue: 0,0:06:22.51,0:06:25.61,Main,,0,0,0,,أين يحتفظون بالخيول داخل هذا الصندوق الصغير يا ترى؟
Dialogue: 0,0:06:25.61,0:06:28.38,Main,,0,0,0,,تقنيات العالم السفليّ مذهلةٌ بحقّ
Dialogue: 0,0:06:29.52,0:06:31.27,Main,,0,0,0,,اعذراني يا سايو-ساما
Dialogue: 0,0:06:31.64,0:06:35.75,Main,,0,0,0,,استأثرتُ بالطعام لنفسي، ألا تشعران بالجوع؟
Dialogue: 0,0:06:36.17,0:06:38.88,Main,,0,0,0,,سيّدنا الجديد لطيفٌ حقًّا
Dialogue: 0,0:06:38.88,0:06:42.95,Main,,0,0,0,,لا تشغل بالك، فنحن لا نأكل طعام البشر
Dialogue: 0,0:06:44.04,0:06:47.91,Main,,0,0,0,,عفوًا، كيف أُناديكما يا سايو-ساما؟
Dialogue: 0,0:06:47.91,0:06:51.72,Main,,0,0,0,,نادنا بما شئت، ويسعكَ منحنا أسماءً جديدةً حتّى
Dialogue: 0,0:06:53.90,0:06:56.56,Main,,0,0,0,,الأيمن-ساما واليُسرى-ساما؟
Dialogue: 0,0:06:57.34,0:06:59.17,Main,,0,0,0,,هذا رسميٌّ للغاية
Dialogue: 0,0:06:59.17,0:07:03.39,Main,,0,0,0,,أنتَ سيّدنا، لذا يسعكَ التخلّي عن الرسميّات
Dialogue: 0,0:07:03.98,0:07:05.05,Main,,0,0,0,,...إذن
Dialogue: 0,0:07:06.82,0:07:09.34,Main,,0,0,0,,الأيمن واليُسرى
Dialogue: 0,0:07:11.03,0:07:12.32,Main,,0,0,0,,سأدخل في صلب الموضوع
Dialogue: 0,0:07:12.44,0:07:15.28,Main,,0,0,0,,أخبراني بكلّ ما تعرفانه عنّي وعن أختي
Dialogue: 0,0:07:20.59,0:07:25.59,Main,,0,0,0,,...لنبدأ بالقول إنّنا قبعنا عند مدخل قرية هيغاشي
Dialogue: 0,0:07:26.14,0:07:29.25,Main,,0,0,0,,لقرابة أربعمئة عامٍ
Dialogue: 0,0:07:29.72,0:07:32.60,Main,,0,0,0,,ولم نُبصر سوى من يدخلها ويخرج منها
Dialogue: 0,0:07:32.81,0:07:35.97,Main,,0,0,0,,كما أنّنا نجهل الكثير عمّا حدث داخل القرية
Dialogue: 0,0:07:36.54,0:07:39.98,Main,,0,0,0,,تناهى إلى مسامعنا حديث القرويّين عن ولادة توأمين
Dialogue: 0,0:07:40.40,0:07:43.95,Main,,0,0,0,,وبعد برهةٍ، بتنا نلمحكَ
Dialogue: 0,0:07:46.12,0:07:51.11,Main,,0,0,0,,كان والدكَ يصطحبكَ للصيد منذ نعومة أظفاركَ
Dialogue: 0,0:07:51.23,0:07:51.91,Main,,0,0,0,,أجل
Dialogue: 0,0:07:52.65,0:07:55.95,Main,,0,0,0,,علّمني والدي الصيد منذ أن وعيتُ على الدنيا
Dialogue: 0,0:07:56.50,0:08:00.49,Main,,0,0,0,,لكنّنا لم نُبصر شقيقتكَ التوأم قطّ
Dialogue: 0,0:08:00.84,0:08:06.40,Main,,0,0,0,,فظننّا أنَّها توفيتْ بسبب مرضٍ ما عقب ولادتِها
Dialogue: 0,0:08:06.82,0:08:09.49,Main,,0,0,0,,...لكن قبل عشرِ سنواتٍ
Dialogue: 0,0:08:23.40,0:08:28.37,Main,,0,0,0,,رأينا والديكَ يفرّانِ من القرية برفقة فتاةٍ صغيرةٍ
Dialogue: 0,0:08:29.15,0:08:32.92,Main,,0,0,0,,فتاةٌ صغيرةٌ تفوح منها رائحة دماءٍ تطابق رائحتك
Dialogue: 0,0:08:37.12,0:08:41.30,Main,,0,0,0,,وكبرتْ تلك الفتاة وعادتْ لتهاجم القرية
Dialogue: 0,0:08:42.14,0:08:47.42,Main,,0,0,0,,حسبتُ أنَّ والديَّ تخلّيا عنَّا نحنُ الاثنين
Dialogue: 0,0:08:50.75,0:08:53.03,Main,,0,0,0,,لكن تبيّن أنّهما تخلّيا عنّي وحدي
Dialogue: 0,0:09:02.57,0:09:09.23,Main,,0,0,0,,هذا يعني أنَّ من تدّعي أنّها أسا الحقيقيّة قد تعرف مكان والديّ
Dialogue: 0,0:09:10.64,0:09:11.34,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:09:12.51,0:09:13.25,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:09:14.63,0:09:16.12,Main,,0,0,0,,عذرًا عن التأخير
Dialogue: 0,0:09:18.44,0:09:20.41,Main,,0,0,0,,ما الخطب يا هانا-سان؟
Dialogue: 0,0:09:20.77,0:09:24.40,Main,,0,0,0,,لأسبابٍ شتّى، سنغدو وليّي أمركَ يا يورو-كن
Dialogue: 0,0:09:24.40,0:09:26.00,Main,,0,0,0,,نرجو تفهّمك
Dialogue: 0,0:09:26.40,0:09:27.50,Main,,0,0,0,,‫وليّي أمري؟
Dialogue: 0,0:09:27.50,0:09:30.95,Main,,0,0,0,,!نحنُ من سنتحملُ المسؤولية إن اقترفتَ حماقةً
Dialogue: 0,0:09:30.95,0:09:33.93,Main,,0,0,0,,،بالمناسبة يا يورو، سنواصلُ السفرَ لبعضِ الوقتِ
Dialogue: 0,0:09:33.93,0:09:35.74,Main,,0,0,0,,ألا تحتاج لقضاء حاجتك؟
Dialogue: 0,0:09:35.74,0:09:37.92,Main,,0,0,0,,كلّا، قضيتُها هناك للتوّ
Dialogue: 0,0:09:37.92,0:09:39.68,Main,,0,0,0,,!اقترف حماقةً بالفعل
Dialogue: 0,0:09:39.68,0:09:42.83,Main,,0,0,0,,وأيضًا، إيّاكَ والجلوس على سقف السيّارة
Dialogue: 0,0:09:42.83,0:09:44.13,Main,,0,0,0,,فهذا سيلفتُ الأنظار
Dialogue: 0,0:09:44.13,0:09:45.28,Main,,0,0,0,,أهذا ممنوعٌ؟
Dialogue: 0,0:09:46.18,0:09:48.25,Main,,0,0,0,,فقد كان سايو-ساما يجلسانِ فوقهُ طوال الوقت
Dialogue: 0,0:09:48.53,0:09:51.72,Main,,0,0,0,,لا يسع البشر العاديّين رؤية التسوغاي
Dialogue: 0,0:09:51.81,0:09:52.88,Main,,0,0,0,,حقًّا؟
Dialogue: 0,0:09:52.88,0:09:56.62,Main,,0,0,0,,لا يُبصرنا سوى مستخدمي التسوغاي أمثالك
Dialogue: 0,0:09:56.74,0:10:02.11,Main,,0,0,0,,ويسعنا نحن التسوغاي إظهار أنفسنا لبشرٍ محدّدين
Dialogue: 0,0:10:02.11,0:10:05.96,Main,,0,0,0,,وأحيانًا، يتمتعُ بعضُ البشر بحاسّةٍ تمكنُهم من رؤيتنا بمحض الصدفة
Dialogue: 0,0:10:07.50,0:10:09.15,Main,,0,0,0,,ما الخطب؟
Dialogue: 0,0:10:09.15,0:10:10.74,Main,,0,0,0,,علامَ ينبح؟
Dialogue: 0,0:10:16.62,0:10:18.92,Main,,0,0,0,,آل كاغيموري، أليس كذلك؟
Dialogue: 0,0:10:19.50,0:10:21.92,Main,,0,0,0,,أهُم مستخدمو تسوغاي؟
Dialogue: 0,0:10:22.15,0:10:24.77,Main,,0,0,0,,أجل، يضمونَ العديد منهمْ
Dialogue: 0,0:10:24.77,0:10:26.31,Main,,0,0,0,,أيّ نوعٍ من العشائر هُم؟
Dialogue: 0,0:10:26.31,0:10:28.42,Main,,0,0,0,,إنَّها عشيرةٌ مثيرةٌ للمتاعب
Dialogue: 0,0:10:28.42,0:10:32.06,Main,,0,0,0,,غادروا قرية هيغاشي وأسّسوا مكانةً لأنفسهم في العالم السفليّ
Dialogue: 0,0:10:32.48,0:10:35.22,Main,,0,0,0,,إنّهم بمثابة عشيرةٍ فرعيّةٍ للقرية
Dialogue: 0,0:10:35.83,0:10:39.29,Main,,0,0,0,,انفصلوا عن القرية بسبب اختلافٍ في الرؤى
Dialogue: 0,0:10:39.61,0:10:42.87,Main,,0,0,0,,بصراحةٍ، أفضّل ألّا أتورّط معهم
Dialogue: 0,0:10:43.13,0:10:49.88,Main,,0,0,0,,ثمّة صلاتٌ تجمعنا بشبكة سكّان قرية هيغاشي السابقين القابعين في العالم السفليِّ
Dialogue: 0,0:10:49.97,0:10:55.65,Main,,0,0,0,,وسرتْ شائعاتٌ مؤخّرًا عن وجود أحد التوأمين عند آل كاغيموري
Dialogue: 0,0:10:56.53,0:10:58.72,Main,,0,0,0,,وتبيّن أنَّ ذلك صحيح
Dialogue: 0,0:11:37.29,0:11:38.89,Main,,0,0,0,,هيّا، هيّا
Dialogue: 0,0:11:43.94,0:11:46.64,Main,,0,0,0,,هيّا، أغلق بسرعة
Dialogue: 0,0:11:52.84,0:11:54.38,Main,,0,0,0,,!أوي-تشان
Dialogue: 0,0:11:55.06,0:11:56.85,Main,,0,0,0,,لِمَ تهربين منّي؟
Dialogue: 0,0:11:57.79,0:11:59.78,Main,,0,0,0,,!كلّا، إيّاكَ والاقتراب
Dialogue: 0,0:11:59.99,0:12:02.10,Main,,0,0,0,,...حتّى لو قلتِ ذلك
Dialogue: 0,0:12:03.33,0:12:06.69,Main,,0,0,0,,لن يسعني قتلكِ إن لم أقترب
Dialogue: 0,0:12:10.57,0:12:11.82,Main,,0,0,0,,!لا تقترب
Dialogue: 0,0:12:12.23,0:12:13.66,Main,,0,0,0,,!إيّاكَ والاقتراب
Dialogue: 0,0:12:14.25,0:12:17.66,Main,,0,0,0,,...إن اقتربتَ أكثر
Dialogue: 0,0:12:21.33,0:12:25.99,Main,,0,0,0,,فستطأ منطقتي
Dialogue: 0,0:12:34.17,0:12:34.95,Main,,0,0,0,,مرحبًا
Dialogue: 0,0:12:35.48,0:12:36.34,Main,,0,0,0,,أوي-سان؟
Dialogue: 0,0:12:36.65,0:12:37.44,Main,,0,0,0,,معكِ جين
Dialogue: 0,0:12:38.32,0:12:41.65,Main,,0,0,0,,سوّيتُ الأمر مع ذلك المتعقّب
Dialogue: 0,0:12:46.04,0:12:50.24,Main,,0,0,0,,وأجبرته على التعهّد بعدم الاقتراب منكِ مجدّدًا
Dialogue: 0,0:12:51.54,0:12:53.91,Main,,0,0,0,,يسعكِ العودة للعمل في المتجر بأمانٍ الآن
Dialogue: 0,0:12:55.74,0:12:58.89,Main,,0,0,0,,سأُعلم المدير بذلك لاحقًا
Dialogue: 0,0:13:01.28,0:13:02.67,Main,,0,0,0,,طاب يومكِ
Dialogue: 0,0:13:31.18,0:13:32.35,Main,,0,0,0,,أيّتها الآنسة
Dialogue: 0,0:13:35.56,0:13:37.10,Main,,0,0,0,,أأنت ممّن يُبصرون؟
Dialogue: 0,0:13:40.19,0:13:42.13,Main,,0,0,0,,...حسنٌ
Dialogue: 0,0:13:47.26,0:13:48.58,Main,,0,0,0,,أبقِ الأمر سرًّا
Dialogue: 0,0:13:50.97,0:13:54.65,Main,,0,0,0,,لم يتناهَ إليَّ ولا إلى هانا-تشان تفاصيلُ كثيرةٌ
Dialogue: 0,0:13:54.65,0:13:57.77,Main,,0,0,0,,فعائلاتُنا تعيشُ في العالمِ السفليِّ منذُ أجيالٍ
Dialogue: 0,0:13:57.77,0:14:00.47,Main,,0,0,0,,وورثنا هذا العمل عن أسلافنا فحسب
Dialogue: 0,0:14:00.47,0:14:04.98,Main,,0,0,0,,،شدّدتِ الجدّةُ ياماها على إبقاء موقع قرية هيغاشي سرًّا عن الغرباء
Dialogue: 0,0:14:05.30,0:14:10.49,Main,,0,0,0,,وألحّتْ علينا بألّا نسلّم أسا ويورو لأيّ شخصٍ كان
Dialogue: 0,0:14:11.33,0:14:14.24,Main,,0,0,0,,أنا أؤمّن البضائع وأنقل المعلومات
Dialogue: 0,0:14:14.38,0:14:17.10,Main,,0,0,0,,أمّا أنا فأقوم بأعمالٍ شتّى هنا وهناك
Dialogue: 0,0:14:17.10,0:14:19.31,Main,,0,0,0,,ولم تطأ قدماي القرية قطّ
Dialogue: 0,0:14:19.31,0:14:22.44,Main,,0,0,0,,،أجهل ما يدور في خلد الجدّة وكبار القرية
Dialogue: 0,0:14:22.59,0:14:25.87,Main,,0,0,0,,لكن بصفتي من آل تاديرا، عليَّ الالتزام بقواعد أسلافي
Dialogue: 0,0:14:27.63,0:14:28.51,Main,,0,0,0,,صحيح
Dialogue: 0,0:14:28.61,0:14:32.93,Main,,0,0,0,,اسمي الحقيقيّ تاديرا ريو، لكن يسعكَ مناداتي بديرا كما عهدتَ
Dialogue: 0,0:14:34.14,0:14:38.56,Main,,0,0,0,,بدا أنَّ الجدّة تخشى أن يأخذوني
Dialogue: 0,0:14:39.19,0:14:42.51,Main,,0,0,0,,وقد ألحّتْ عليكَ في هذا الشأن أيضًا يا ديرا-سان
Dialogue: 0,0:14:44.67,0:14:47.45,Main,,0,0,0,,ما ماهيتُنا أنا وشقيقتي بالضّبط؟
Dialogue: 0,0:14:50.27,0:14:53.43,Main,,0,0,0,,،في يومٍ يتساوى فيه الليل والنهار بقرية هيغاشي
Dialogue: 0,0:14:53.51,0:14:56.23,Main,,0,0,0,,...إن وُلد توأمان ذكرٌ وأنثى يفصلُ بينهما مطلعُ الفجر
Dialogue: 0,0:14:56.56,0:14:59.18,Main,,0,0,0,,فسينشطرُ العالمُ في حقبةِ ولادتهما
Dialogue: 0,0:14:59.96,0:15:05.86,Main,,0,0,0,,وحسب علمنا، لم يقعْ هذا الأمرُ من بعدِكما إلّا قبل زهاءِ أربعمئة عامٍ
Dialogue: 0,0:15:06.53,0:15:10.40,Main,,0,0,0,,وُلد توأمان يفصلان الليل عن النهار في تلك القرية حينها
Dialogue: 0,0:15:11.07,0:15:15.12,Main,,0,0,0,,وانقسمتْ البلاد إلى شرقٍ وغربٍ ونشبتْ حربٌ طاحنةٌ في تلك الحقبة
Dialogue: 0,0:15:15.25,0:15:19.72,Main,,0,0,0,,وقبل ذلك انقسمتْ البلاد إلى شمالٍ وجنوبٍ في حربٍ أخرى
Dialogue: 0,0:15:20.26,0:15:24.33,Main,,0,0,0,,ودأبَ مستخدمو التسوغاي يحرّكون الخيوط خفاءً في كلتا الحقبتين
Dialogue: 0,0:15:25.14,0:15:28.86,Main,,0,0,0,,أنحن طفلان ملعونان وُجدنا نُثير الفوضى في العالم؟
Dialogue: 0,0:15:29.09,0:15:33.83,Main,,0,0,0,,كلّا، بل الطامعين في استغلال قوّتكما هم من يشعلون فتيل الحرب من تلقاء أنفسهم
Dialogue: 0,0:15:34.02,0:15:37.29,Main,,0,0,0,,!قوّة؟ لا أمتلك أيّ قوّةٍ
Dialogue: 0,0:15:37.29,0:15:38.76,Main,,0,0,0,,في الوقت الراهن
Dialogue: 0,0:15:38.76,0:15:43.12,Main,,0,0,0,,لديكَ المؤهلات لاكتساب القوّة
Dialogue: 0,0:15:43.12,0:15:46.82,Main,,0,0,0,,وأغلب الظنّ أنَّ أسا قد اكتسبتها بالفعل
Dialogue: 0,0:15:48.13,0:15:52.30,Main,,0,0,0,,تلك القوّة، إنّها "الفكّ" حتمًا
Dialogue: 0,0:15:54.35,0:15:59.52,Main,,0,0,0,,الفكّ"؛ قوّةٌ قادرةٌ على فكّ أيّ شيءٍ في العالم قسرًا"
Dialogue: 0,0:15:59.52,0:16:04.58,Main,,0,0,0,,يَسعها اختراق أعتى الحواجز وغيرها بكلّ سهولةٍ
Dialogue: 0,0:16:04.58,0:16:07.61,Main,,0,0,0,,وقرينتها هي "الختم"؛
Dialogue: 0,0:16:07.61,0:16:11.91,Main,,0,0,0,,قوّةٌ قادرةٌ على إغلاق أيّ شيءٍ في العالم قسرًا
Dialogue: 0,0:16:12.86,0:16:16.22,Main,,0,0,0,,ماذا يحدث حين يتصادم "الفتح" و"الختم" يا ترى؟
Dialogue: 0,0:16:16.40,0:16:17.90,Main,,0,0,0,,ستكون مفارقةً عجيبةً
Dialogue: 0,0:16:18.39,0:16:21.41,Main,,0,0,0,,أسبقَ لأحدٍ أن حازَ كِلتا القوتينِ معًا؟
Dialogue: 0,0:16:21.73,0:16:24.67,Main,,0,0,0,,ليس على حدّ علمنا
Dialogue: 0,0:16:24.67,0:16:28.58,Main,,0,0,0,,ممّا يعني أنَّ لا أحد يعرف ما سيؤول إليه الأمر إذن
Dialogue: 0,0:16:28.58,0:16:31.73,Main,,0,0,0,,،أليس جائزًا أن تكون تلك الأقاويل قد نسجت خيالًا واهيًا
Dialogue: 0,0:16:31.84,0:16:35.42,Main,,0,0,0,,وبات القرويون ينساقون خلفه عميانًا؟
Dialogue: 0,0:16:36.17,0:16:39.98,Main,,0,0,0,,بالحديث عن ذلك، كان هناك حاجزٌ يحيط بالقرية أيضًا
Dialogue: 0,0:16:40.10,0:16:42.47,Main,,0,0,0,,كيف كنتَ تعبرُه يا ديرا-سان؟
Dialogue: 0,0:16:42.78,0:16:46.23,Main,,0,0,0,,ثمّة مسارٌ محددٌ للعبورِ
Dialogue: 0,0:16:46.57,0:16:49.68,Main,,0,0,0,,مثل الدوران حول الصخور عدة مراتٍ بعكس عقارب الساعة
Dialogue: 0,0:16:49.92,0:16:54.50,Main,,0,0,0,,،ثمَّ الانعطاف يمينًا عند المفترق العودة عند التالي للعبور من الوادي
Dialogue: 0,0:16:55.06,0:16:58.75,Main,,0,0,0,,والانعطاف بزاويةٍ قائمةٍ عند الشجرة الضخمة
Dialogue: 0,0:16:58.75,0:17:00.75,Main,,0,0,0,,إنّه مسارٌ معقّدٌ كهذا
Dialogue: 0,0:17:01.39,0:17:07.75,Main,,0,0,0,,،وبما أنّي أنتمي لعشيرةٍ تعرف هذا المسار لذا يسعُني عبورُ حاجز قرية هيغاشي بحريّةٍ
Dialogue: 0,0:17:08.13,0:17:13.59,Main,,0,0,0,,كانتْ والدتُكَ من سكان العالم السفليّ، وقد قادتها الصدفة لسلوك ذلك المسار ودخول القرية
Dialogue: 0,0:17:16.90,0:17:18.72,Main,,0,0,0,,يحدث هذا بين الحين والآخر
Dialogue: 0,0:17:18.91,0:17:23.39,Main,,0,0,0,,إذ يضلُّ بعضُ المسافرين طريقهم وينتهي بهم المطافُ في القرية صدفةً
Dialogue: 0,0:17:40.23,0:17:41.25,Main,,0,0,0,,يورو
Dialogue: 0,0:17:42.38,0:17:48.11,Main,,0,0,0,,"في الموطن الّذي نشأتُ فيه، اسمكَ يعني "الليل
Dialogue: 0,0:17:49.39,0:17:55.94,Main,,0,0,0,,أتمنى أن أصطحبكَ ووالدكَ وأسا إلى هناك يومًا ما
Dialogue: 0,0:18:22.67,0:18:26.74,Main,,0,0,0,,اسحب السيفون بعد قضاء حاجتك
Dialogue: 0,0:18:27.37,0:18:28.67,Main,,0,0,0,,ثمَّ اغسل يديك
Dialogue: 0,0:18:32.78,0:18:36.72,Main,,0,0,0,,أمقت هذا الصوت الصاخب الّذي يشبه زئير التنين
Dialogue: 0,0:18:37.55,0:18:40.34,Main,,0,0,0,,وأطفئ أنوار الغرف الّتي لا تستخدمها
Dialogue: 0,0:18:41.85,0:18:45.73,Main,,0,0,0,,حسنٌ، حفظتُ قواعد دورات مياه العالم السفليّ عن ظهر قلبٍ
Dialogue: 0,0:18:50.63,0:18:54.66,Main,,0,0,0,,على أيّ حال، من المذهل ألّا يضطرّوا لسحب الماء من بئر
Dialogue: 0,0:18:54.73,0:18:58.60,Main,,0,0,0,,وكيف تشتعل النار بمجرّد ضغطة زرٍّ؟
Dialogue: 0,0:18:58.60,0:19:02.12,Main,,0,0,0,,ناهيكَ عن كثرة الأضواء الّتي تضيءُ أرجاء المدينة ليلًا
Dialogue: 0,0:19:02.48,0:19:06.32,Main,,0,0,0,,كما أنّي ذهلتُ من كثرة القلاع الحجريّة الشاهقة أيضًا
Dialogue: 0,0:19:06.44,0:19:09.33,Main,,0,0,0,,كمْ عدد الأسياد في العالم السفليّ يا ترى؟
Dialogue: 0,0:19:09.33,0:19:11.75,Main,,0,0,0,,إنّها ليستْ قلاعًا بل مجردُ منازلٍ
Dialogue: 0,0:19:12.07,0:19:16.15,Main,,0,0,0,,أخبرني ديرا-سان أنَّ العشرات يعيشون داخل المبنى الواحد
Dialogue: 0,0:19:16.15,0:19:18.76,Main,,0,0,0,,لا عجب في كثرة سكان العاصمة
Dialogue: 0,0:19:18.76,0:19:21.26,Main,,0,0,0,,كلّا، هذه ليست العاصمة
Dialogue: 0,0:19:21.46,0:19:25.46,Main,,0,0,0,,العاصمة هي طوكيو، ويقطنها أكثر من عشرة ملايين نسمةٍ
Dialogue: 0,0:19:25.51,0:19:26.83,Main,,0,0,0,,!عشرة ملايين؟
Dialogue: 0,0:19:27.00,0:19:28.73,Main,,0,0,0,,كم كوكو من الأرزّ يكفيهم يا ترى؟
Dialogue: 0,0:19:29.04,0:19:33.74,Main,,0,0,0,,أنّى لها ألّا تكون عاصمةً رغم كلّ هذا الحشد الغفير
Dialogue: 0,0:19:33.91,0:19:36.49,Main,,0,0,0,,حسنٌ، ما كان اسم هذا المكان؟
Dialogue: 0,0:19:36.96,0:19:38.66,Main,,0,0,0,,أخبرتْني به هانا-سان
Dialogue: 0,0:19:39.61,0:19:40.97,Main,,0,0,0,,محافظة غونتاما؟
Dialogue: 0,0:19:41.10,0:19:42.02,Main,,0,0,0,,محافظة غونتاما
Dialogue: 0,0:19:42.18,0:19:43.49,Main,,0,0,0,,حسنٌ، حفظتُه
Dialogue: 0,0:19:43.66,0:19:48.02,Main,,0,0,0,,يسهل التخفّي وسط هذا الحشد الغفير حتمًا
Dialogue: 0,0:19:48.20,0:19:50.41,Main,,0,0,0,,كإخفاء شجرةٍ في غابةٍ
Dialogue: 0,0:19:50.71,0:19:56.04,Main,,0,0,0,,وستبحث عن أختكَ وسط هذا الحشد الغفير إذن
Dialogue: 0,0:19:58.35,0:19:59.04,Main,,0,0,0,,أجل
Dialogue: 0,0:20:00.03,0:20:02.76,Main,,0,0,0,,أظنّ أنَّ ديرا-سان وهانا-سان شخصان طيّبان
Dialogue: 0,0:20:03.87,0:20:07.53,Main,,0,0,0,,،لكن، إن كانا متواطئين مع من ظننتها أختي طوال حياتي
Dialogue: 0,0:20:07.53,0:20:10.89,Main,,0,0,0,,...ومع أهل القرية الّذين كتموا هذا السرّ
Dialogue: 0,0:20:10.89,0:20:12.84,Main,,0,0,0,,فلن يسعني الوثوق بهما تمامًا
Dialogue: 0,0:20:13.38,0:20:18.06,Main,,0,0,0,,وكذلك لا يسعُني الوثوقُ بتلك الفتاة الّتي تدَّعي أنَّها أسا
Dialogue: 0,0:20:23.61,0:20:27.97,Main,,0,0,0,,ففرارُ والديّ من القرية برفقة طفلةٍ ينمّ عن خطبٍ جللٍ
Dialogue: 0,0:20:29.05,0:20:30.68,Main,,0,0,0,,أودّ لقاءها والتحدّث إليها
Dialogue: 0,0:20:31.42,0:20:35.33,Main,,0,0,0,,سأمسكُ بأسا تلك وأرغمُها على إرشادي إلى مكان والديَّ
Dialogue: 0,0:20:36.10,0:20:38.75,Main,,0,0,0,,أستُعينانني يا سايو-ساما؟
Dialogue: 0,0:20:39.06,0:20:42.75,Main,,0,0,0,,سنبحثُ عن شخص ما في هذا العالم السفليّ ونحن لا نعرف يميننا من يسارنا
Dialogue: 0,0:20:43.15,0:20:46.72,Main,,0,0,0,,مثيرٌ للاهتمام، لم نحظَ بتسليةٍ كهذه منذُ أربعمئة عامٍ
Dialogue: 0,0:20:47.06,0:20:48.60,Main,,0,0,0,,لنستمتع بهذا
Dialogue: 0,0:20:48.60,0:20:52.90,Main,,0,0,0,,لا يجدر بكَ قول هذا وسيّدنا في أمسّ الحاجة للمساعدة أيّها الأيمن
Dialogue: 0,0:20:52.99,0:20:56.11,Main,,0,0,0,,وماذا عنكِ أيّتها اليسرى؟
Dialogue: 0,0:20:59.95,0:21:01.36,Main,,0,0,0,,...ملاحقةُ الطرائدِ
Dialogue: 0,0:21:01.94,0:21:04.36,Main,,0,0,0,,أليقُ بساحتي من الفرار
Dialogue: 0,0:21:07.09,0:21:09.04,Main,,0,0,0,,حسنٌ، حسنٌ، فهمت
Dialogue: 0,0:21:09.24,0:21:10.36,Main,,0,0,0,,شكرًا لكِ
Dialogue: 0,0:21:12.00,0:21:13.00,Main,,0,0,0,,أهلًا بعودتكم
Dialogue: 0,0:21:13.00,0:21:14.10,Main,,0,0,0,,عُدنا
Dialogue: 0,0:21:14.26,0:21:18.38,Main,,0,0,0,,تواصلتْ معي هانا-تشان وأخبرتني أنّها وجدتْ منزلًا جديدًا
Dialogue: 0,0:21:18.78,0:21:21.48,Main,,0,0,0,,سنودّع النوم في السيّارة أخيرًا
Dialogue: 0,0:21:23.33,0:21:26.25,Main,,0,0,0,,بالمناسبة، أراكَ تستخدمُ ذاكَ الشيء كثيرًا
Dialogue: 0,0:21:26.25,0:21:27.22,Main,,0,0,0,,ما ماهيتُه؟
Dialogue: 0,0:21:27.22,0:21:28.18,Main,,0,0,0,,هذا؟
Dialogue: 0,0:21:30.30,0:21:32.78,Main,,0,0,0,,أظنُّ أنَّ مصطلح "الهاتفِ" لن يعني لكَ شيئًا
Dialogue: 0,0:21:33.49,0:21:36.26,Main,,0,0,0,,إنّه كإشارات دخانٍ لكنّه ينقل الكلمات ونبرات الصوت
Dialogue: 0,0:21:36.67,0:21:38.40,Main,,0,0,0,,كلّا، ليس وصفًا دقيقًا
Dialogue: 0,0:21:38.88,0:21:41.28,Main,,0,0,0,,حسنٌ، إنّه شيءٌ من هذا القبيل
Dialogue: 0,0:21:41.87,0:21:43.31,Main,,0,0,0,,فهمت
Dialogue: 0,0:21:43.31,0:21:45.52,Main,,0,0,0,,شيءٌ شبيهٌ بإشاراتِ الدخانِ إذن
Dialogue: 0,0:21:46.31,0:21:47.36,Main,,0,0,0,,فهمت
Dialogue: 0,0:21:49.37,0:21:52.07,Main,,0,0,0,,يا لسذاجة طبعهم المتأصل
Dialogue: 0,0:23:28.52,0:23:29.79,Main,,0,0,0,,سأعرفُكَ بهِما
Dialogue: 0,0:23:29.81,0:23:31.73,Main,,0,0,0,,هذا كوتيتسو وجيرو
Dialogue: 0,0:23:32.68,0:23:35.30,Main,,0,0,0,,يا يمين-سان، ماذا تفعل بعد قضاء حاجتك؟
Dialogue: 0,0:23:35.30,0:23:37.50,Main,,0,0,0,,!أُطفئ الأضواء
