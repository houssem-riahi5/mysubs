Dialogue: 0,0:00:26.30,0:00:28.41,Main,,0,0,0,,ثمّة طفلٌ آخر في بطنها
Dialogue: 0,0:00:28.55,0:00:30.63,Main,,0,0,0,,كانا توأمين كما توقعت
Dialogue: 0,0:00:32.31,0:00:34.55,Main,,0,0,0,,اقترب بزوغ الفجر
Dialogue: 0,0:00:34.55,0:00:36.92,Main,,0,0,0,,إياكِ والولادة بعد
Dialogue: 0,0:00:36.92,0:00:40.22,Main,,0,0,0,,!هذا طلبٌ مستحيلٌ أيّتها الجدّة
Dialogue: 0,0:00:40.31,0:00:41.77,Main,,0,0,0,,بل عليها ذلك
Dialogue: 0,0:00:42.24,0:00:44.97,Main,,0,0,0,,سنمضي في الأمر مهما بلغ خطره
Dialogue: 0,0:00:45.50,0:00:51.95,Main,,0,0,0,,فهذان الطفلان من سيحكمان التسوغاي يومًا ما
Dialogue: 0,0:01:17.93,0:01:21.73,Main,,0,0,0,,وُلِدَ الطفلان اللّذان يفصلان الليل عن النهار
Dialogue: 0,0:02:32.20,0:02:34.25,Main,,0,0,0,,!يا لها من آثار تنينٍ بديعة
Dialogue: 0,0:02:57.63,0:02:58.50,Main,,0,0,0,,!يورو
Dialogue: 0,0:02:58.82,0:03:01.90,Main,,0,0,0,,!أذهبتَ للصيد بمفردكَ مجدّدًا؟
Dialogue: 0,0:03:02.02,0:03:03.07,Main,,0,0,0,,‫أهلًا يا دانجي
Dialogue: 0,0:03:03.50,0:03:04.23,Main,,0,0,0,,عدتُ
Dialogue: 0,0:03:04.60,0:03:07.24,Main,,0,0,0,,لِمَ لمْ تُنادني؟
Dialogue: 0,0:03:07.24,0:03:08.11,Main,,0,0,0,,عذرًا
Dialogue: 0,0:03:08.38,0:03:11.38,Main,,0,0,0,,ماذا لو أصابكَ مكروهٌ أثناء وجودكَ وحيدًا في الجبال؟
Dialogue: 0,0:03:11.73,0:03:13.15,Main,,0,0,0,,!لن يسعكَ طلب المساعدة حتّى
Dialogue: 0,0:03:13.43,0:03:14.80,Main,,0,0,0,,لا تقلق، لا تقلق
Dialogue: 0,0:03:15.10,0:03:17.04,Main,,0,0,0,,فسايو-ساما سيحرسانني
Dialogue: 0,0:03:20.43,0:03:21.51,Main,,0,0,0,,!مذهل
Dialogue: 0,0:03:21.86,0:03:23.49,Main,,0,0,0,,أصطدتَ طائر تدرُّجٍ؟
Dialogue: 0,0:03:23.53,0:03:24.77,Main,,0,0,0,,!لا بُدَّ أنَّه كان أمرًا شاقًّا
Dialogue: 0,0:03:24.88,0:03:25.74,Main,,0,0,0,,كان هيّنًا
Dialogue: 0,0:03:25.74,0:03:27.72,Main,,0,0,0,,!تدرُّج مشويّ! تدرُّج مشويّ
Dialogue: 0,0:03:27.72,0:03:28.51,Main,,0,0,0,,بل سنطهوه في حساءٍ
Dialogue: 0,0:03:28.51,0:03:31.36,Main,,0,0,0,,لا، لا، شويه سيجعله أشهى وألذ
Dialogue: 0,0:03:30.41,0:03:32.38,Top,,0,0,0,,بل الحساء سيشبعنا أكثر
Dialogue: 0,0:03:32.38,0:03:33.43,Main,,0,0,0,,!هذا غير صحيح
Dialogue: 0,0:03:35.48,0:03:37.10,Main,,0,0,0,,أهلًا بعودتكَ يا يورو
Dialogue: 0,0:03:37.40,0:03:40.13,Main,,0,0,0,,عدتُ، يبدو أنَّ الطقس سيسوء
Dialogue: 0,0:03:40.81,0:03:43.11,Main,,0,0,0,,أستهطل الأمطار أخيرًا يا ترى؟
Dialogue: 0,0:03:43.61,0:03:45.26,Main,,0,0,0,,هل آتي لمساعدتكم لاحقًا؟
Dialogue: 0,0:03:45.33,0:03:46.87,Main,,0,0,0,,!أجل، ستكون خير عونٍ
Dialogue: 0,0:04:03.08,0:04:05.51,Main,,0,0,0,,عدتُ أيّتها الجدّة ياماها
Dialogue: 0,0:04:05.51,0:04:07.11,Main,,0,0,0,,أهلًا بعودتكَ يا يورو
Dialogue: 0,0:04:07.54,0:04:09.77,Main,,0,0,0,,جئتَ في الوقت المناسب يا دانجي
Dialogue: 0,0:04:10.75,0:04:11.72,Main,,0,0,0,,!أمّي
Dialogue: 0,0:04:11.82,0:04:13.49,Main,,0,0,0,,ساعدني في العمل
Dialogue: 0,0:04:13.49,0:04:15.06,Main,,0,0,0,,!وداعًا
Dialogue: 0,0:04:15.17,0:04:18.71,Main,,0,0,0,,!يا هذا! خذ من اجتهاد يورو عبرةً لك
Dialogue: 0,0:04:19.18,0:04:20.66,Main,,0,0,0,,هل أسا بخير؟
Dialogue: 0,0:04:20.81,0:04:24.63,Main,,0,0,0,,أجل، تؤدّي واجبها على أكمل وجهٍ كالمعتاد
Dialogue: 0,0:04:40.47,0:04:41.37,Main,,0,0,0,,أسا
Dialogue: 0,0:04:43.11,0:04:44.14,Main,,0,0,0,,كيف حالكِ؟
Dialogue: 0,0:04:46.41,0:04:49.93,Main,,0,0,0,,أهلًا بعودتكَ يا أخي
Dialogue: 0,0:04:53.47,0:04:55.43,Main,,0,0,0,,اصطدتُ طائر تدرُّجٍ اليوم
Dialogue: 0,0:04:55.43,0:04:57.61,Main,,0,0,0,,!هذا مذهلٌ يا أخي
Dialogue: 0,0:04:57.61,0:04:59.19,Main,,0,0,0,,‫ليس مُذهلًا
Dialogue: 0,0:04:59.65,0:05:02.40,Main,,0,0,0,,أردتُ اصطياد خنزيرٍ بريٍّ أو غزالٍ في الواقع
Dialogue: 0,0:05:02.95,0:05:05.71,Main,,0,0,0,,أخشى على المحاصيل لقلّة الأمطار هذا العام
Dialogue: 0,0:05:06.59,0:05:09.25,Main,,0,0,0,,وقد تشحُّ مؤونتنا في الشتاء
Dialogue: 0,0:05:09.70,0:05:13.78,Main,,0,0,0,,عليّ تكثيف الصيد وإعداد المزيد من اللحم المقدّد والمملّح
Dialogue: 0,0:05:14.64,0:05:19.83,Main,,0,0,0,,أسيضطرّ كبار القرية للنزول إلى العالم السفليّ للعمل يا ترى؟
Dialogue: 0,0:05:20.25,0:05:21.45,Main,,0,0,0,,ربّما
Dialogue: 0,0:05:22.64,0:05:24.77,Main,,0,0,0,,أستذهب للعمل هناك أيضًا يا أخي؟
Dialogue: 0,0:05:24.77,0:05:29.46,Main,,0,0,0,,لن أذهب، لِمَ برأيكِ أثقلتُ مهاراتي في الصيد؟
Dialogue: 0,0:05:30.34,0:05:33.07,Main,,0,0,0,,،ما دمتُ أؤدّي واجبي بتوفير اللحم الثمين
Dialogue: 0,0:05:33.14,0:05:35.51,Main,,0,0,0,,فلا حاجة لذهابي إلى العالم السفليّ للعمل
Dialogue: 0,0:05:36.25,0:05:40.89,Main,,0,0,0,,ألن تهجرنا وتختفي كما فعل والدانا؟
Dialogue: 0,0:05:40.98,0:05:43.33,Main,,0,0,0,,لا تقلقي يا أسا
Dialogue: 0,0:05:43.33,0:05:45.97,Main,,0,0,0,,لن أبرح هذه القرية مطلقًا
Dialogue: 0,0:05:45.97,0:05:49.31,Main,,0,0,0,,سأبقى بجواركِ ما دمتِ هنا
Dialogue: 0,0:05:49.74,0:05:51.20,Main,,0,0,0,,وسأحميكِ
Dialogue: 0,0:05:54.42,0:05:55.67,Main,,0,0,0,,أجل
Dialogue: 0,0:05:57.18,0:05:58.41,Main,,0,0,0,,يورو
Dialogue: 0,0:05:59.56,0:06:00.41,Main,,0,0,0,,ما الأمر؟
Dialogue: 0,0:06:01.97,0:06:04.17,Main,,0,0,0,,جاء ديرا-سان
Dialogue: 0,0:06:05.02,0:06:06.93,Main,,0,0,0,,فولاذٌ ممتاز
Dialogue: 0,0:06:07.97,0:06:10.24,Main,,0,0,0,,هذا من الرّجال الّذين ذهبوا للعمل خارجًا
Dialogue: 0,0:06:10.56,0:06:12.12,Main,,0,0,0,,عذرًا لأنّي أُثقل عليكَ دائمًا
Dialogue: 0,0:06:12.75,0:06:14.18,Main,,0,0,0,,كيف هي الأحوال في العالم السفليّ؟
Dialogue: 0,0:06:14.43,0:06:16.61,Main,,0,0,0,,ليس في أفضل أحواله
Dialogue: 0,0:06:16.70,0:06:18.42,Main,,0,0,0,,كما تتفشى فيه الأمراض
Dialogue: 0,0:06:18.84,0:06:22.05,Main,,0,0,0,,لذا سأبتاعُ أعشابكم الطبية بثمنٍ باهظٍ اليوم
Dialogue: 0,0:06:22.53,0:06:24.10,Main,,0,0,0,,سأقايض هذه بملح
Dialogue: 0,0:06:24.10,0:06:26.61,Main,,0,0,0,,ألديكَ بذور خضراواتٍ تتحمل الجفاف؟
Dialogue: 0,0:06:26.99,0:06:28.10,Main,,0,0,0,,طلبكَ مجابٌ
Dialogue: 0,0:06:28.45,0:06:31.50,Main,,0,0,0,,ستبلغ طفلتي عامها السابع قريبًا
Dialogue: 0,0:06:31.50,0:06:35.03,Main,,0,0,0,,فهمت، سأجلب معي كاهنًا في المرّة القادمة إذن
Dialogue: 0,0:06:36.58,0:06:39.19,Main,,0,0,0,,أعاني من صداعٍ مبرحٍ مؤخرًا
Dialogue: 0,0:06:39.69,0:06:41.34,Main,,0,0,0,,مسكنكِ المعتاد إذن
Dialogue: 0,0:06:41.65,0:06:43.07,Main,,0,0,0,,أعطني دواءً للمعدة
Dialogue: 0,0:06:43.07,0:06:44.27,Main,,0,0,0,,طلبكَ مجابٌ
Dialogue: 0,0:06:44.80,0:06:45.58,Main,,0,0,0,,ديرا-سان
Dialogue: 0,0:06:45.87,0:06:47.97,Main,,0,0,0,,أهلًا يا يورو، كيف حالك؟
Dialogue: 0,0:06:48.46,0:06:50.06,Main,,0,0,0,,‫أتبتغي شيئًا؟
Dialogue: 0,0:06:51.06,0:06:52.38,Main,,0,0,0,,لا أظنّ
Dialogue: 0,0:06:53.34,0:06:56.93,Main,,0,0,0,,"لا أريد شيئًا، ألديكَ هديةٌ لأسا؟"
Dialogue: 0,0:06:56.93,0:06:57.73,Main,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:07:00.44,0:07:01.51,Main,,0,0,0,,شكرًا لكَ
Dialogue: 0,0:07:02.95,0:07:04.48,Main,,0,0,0,,ألديكَ ريش طائر تدرُّج؟
Dialogue: 0,0:07:04.55,0:07:05.62,Main,,0,0,0,,!رائع
Dialogue: 0,0:07:05.65,0:07:07.23,Main,,0,0,0,,سيُباع بسعرٍ باهظ
Dialogue: 0,0:07:11.09,0:07:12.66,Main,,0,0,0,,يا لحظّه
Dialogue: 0,0:07:13.07,0:07:15.67,Main,,0,0,0,,ليتني أستطيع مغادرة القرية
Dialogue: 0,0:07:16.07,0:07:18.37,Main,,0,0,0,,أتظنّ العالم السفليّ بتلك الروعة؟
Dialogue: 0,0:07:18.88,0:07:22.89,Main,,0,0,0,,!فجلُّ من غادروا للعمل لم يعودوا
Dialogue: 0,0:07:23.74,0:07:26.33,Main,,0,0,0,,لا بُدَّ أنَّ العالم السفليّ مكانٌ رائعٌ للغاية
Dialogue: 0,0:07:26.63,0:07:28.00,Main,,0,0,0,,أتساءل حيال ذلك
Dialogue: 0,0:07:28.76,0:07:31.77,Main,,0,0,0,,أمَّا أنا فلا أمانع قضاء حياتي كلّها في هذه القرية
Dialogue: 0,0:07:32.32,0:07:37.60,Main,,0,0,0,,بالطبع، فلديكَ أختٌ صغرى ظريفة
Dialogue: 0,0:07:38.45,0:07:41.17,Main,,0,0,0,,لِمَ لا تغادران معًا إذن؟
Dialogue: 0,0:07:41.17,0:07:43.72,Main,,0,0,0,,سأرافقكما إن ساوركَ القلق
Dialogue: 0,0:07:43.72,0:07:47.00,Main,,0,0,0,,!ستتدنّس أسا إن رافقتكَ
Dialogue: 0,0:07:47.57,0:07:48.69,Main,,0,0,0,,!ماذا قلت؟
Dialogue: 0,0:07:49.34,0:07:51.49,Main,,0,0,0,,!لأسا واجبٌ مهمٌّ تؤدّيه
Dialogue: 0,0:07:51.99,0:07:55.54,Main,,0,0,0,,بالمناسبة، لم ألتقِ بأسا-تشان قطّ
Dialogue: 0,0:07:56.03,0:07:58.09,Main,,0,0,0,,لا يُسمح سوى لأشخاصٍ محددين برؤيتها
Dialogue: 0,0:07:58.09,0:08:01.12,Main,,0,0,0,,!لا تقل هذا يا أخي
Dialogue: 0,0:08:01.24,0:08:04.41,Main,,0,0,0,,!لا تظنَّ أنَّ سوقيًّا مثلكَ سيحظى برؤيتها
Dialogue: 0,0:08:04.95,0:08:06.24,Main,,0,0,0,,ماذا قلتَ أيّها الوغد؟
Dialogue: 0,0:08:06.35,0:08:08.26,Main,,0,0,0,,إذن عليكَ هزيمتي أولًا
Dialogue: 0,0:08:08.26,0:08:09.71,Main,,0,0,0,,!مستحيل! مستحيل! مستحيل! مستحيل! مستحيل
Dialogue: 0,0:08:13.67,0:08:15.06,Main,,0,0,0,,ما هذا الصوت؟
Dialogue: 0,0:08:15.28,0:08:17.00,Main,,0,0,0,,أليس زئير تنينٍ؟
Dialogue: 0,0:08:17.62,0:08:18.38,Main,,0,0,0,,!انظر
Dialogue: 0,0:08:19.02,0:08:21.09,Main,,0,0,0,,آثار تنينٍ بديعة أخرى
Dialogue: 0,0:08:32.11,0:08:36.23,Main,,0,0,0,,هذا ليس بزئيرٍ، صوته مختلف عن المعتاد
Dialogue: 0,0:08:36.76,0:08:40.45,Main,,0,0,0,,‫سمعتُ هذا الصوت مرارًا حين كنتُ أصطاد في أعماق الجبل
Dialogue: 0,0:08:40.91,0:08:42.97,Main,,0,0,0,,أليس الصوت صاخبًا نوعًا ما؟
Dialogue: 0,0:08:43.16,0:08:44.79,Main,,0,0,0,,أهو قريبٌ منّا؟
Dialogue: 0,0:08:44.79,0:08:47.18,Main,,0,0,0,,أسبق لكَ رؤية تنينٍ؟
Dialogue: 0,0:08:47.18,0:08:48.45,Main,,0,0,0,,كلّا، لم أرَ
Dialogue: 0,0:09:11.43,0:09:12.69,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:10:17.18,0:10:18.06,Main,,0,0,0,,!أيّتها الجدّة
Dialogue: 0,0:10:18.30,0:10:19.19,Main,,0,0,0,,!أيّتها الجدّة ياماها
Dialogue: 0,0:10:19.75,0:10:21.05,Main,,0,0,0,,ما الّذي يحدث؟
Dialogue: 0,0:10:21.05,0:10:24.19,Main,,0,0,0,,هذا وخيمٌ، يبدو أنَّ الحاجز اختُرِق
Dialogue: 0,0:10:24.63,0:10:25.91,Main,,0,0,0,,!كيف حدث ذلك؟
Dialogue: 0,0:10:26.06,0:10:29.15,Main,,0,0,0,,لا أدري، غير أنَّ يورو قد يكون هدفهم
Dialogue: 0,0:10:30.13,0:10:32.11,Main,,0,0,0,,على كلٍّ، علينا إخفاء يورو
Dialogue: 0,0:10:32.11,0:10:33.30,Main,,0,0,0,,!ائتوني به فورًا
Dialogue: 0,0:10:33.30,0:10:34.12,Main,,0,0,0,,!حاضر
Dialogue: 0,0:10:34.86,0:10:35.82,Main,,0,0,0,,أين يورو؟
Dialogue: 0,0:10:35.89,0:10:37.31,Main,,0,0,0,,!في الحقول السفلية غالبًا
Dialogue: 0,0:10:37.39,0:10:38.09,Main,,0,0,0,,!لنُسرع
Dialogue: 0,0:10:41.86,0:10:42.70,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:10:43.63,0:10:45.38,Main,,0,0,0,,ما الّذي يحدث؟
Dialogue: 0,0:10:48.24,0:10:50.23,Main,,0,0,0,,...قُتِلَ الجميع
Dialogue: 0,0:10:51.36,0:10:52.82,Main,,0,0,0,,ابقَ بقربي يا دانجي
Dialogue: 0,0:10:53.94,0:10:56.30,Main,,0,0,0,,!أرجو أن تكوني حيّةً يا أمّي
Dialogue: 0,0:11:04.21,0:11:05.34,Main,,0,0,0,,عثرنا على الفتى
Dialogue: 0,0:11:07.05,0:11:07.99,Main,,0,0,0,,!توقّف
Dialogue: 0,0:11:11.09,0:11:12.62,Main,,0,0,0,,!طار نحونا شيءٌ غريب
Dialogue: 0,0:11:12.83,0:11:15.26,Main,,0,0,0,,أجهل ماهيّته، لكنّه فتّاكٌ على ما يبدو
Dialogue: 0,0:11:21.63,0:11:24.24,Main,,0,0,0,,‫ذانكَ التنينان اللّذان رأيناهما آنفًا يحومان حول الجناح الخارجيّ
Dialogue: 0,0:11:24.63,0:11:26.78,Main,,0,0,0,,لا أظنّنا سنقوى على هزيمتهما
Dialogue: 0,0:11:27.02,0:11:28.98,Main,,0,0,0,,أذنكَ تنينانِ أصلًا؟
Dialogue: 0,0:11:35.83,0:11:40.15,Main,,0,0,0,,‫أغلب الظنّ أنَّ أمّي تعمل في القلعة الرئيسيّة كعادتها
Dialogue: 0,0:11:41.11,0:11:43.30,Main,,0,0,0,,وأنتَ ذاهبٌ للبحث عن أسا-تشان، أليس كذلك؟
Dialogue: 0,0:11:44.55,0:11:45.81,Main,,0,0,0,,ساعدني يا دانجي
Dialogue: 0,0:11:46.42,0:11:47.39,Main,,0,0,0,,في ماذا؟
Dialogue: 0,0:11:47.62,0:11:48.88,Main,,0,0,0,,ساعدني فحسب
Dialogue: 0,0:11:57.45,0:11:58.66,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:11:59.26,0:12:00.77,Main,,0,0,0,,طريقٌ مختصرٌ إلى القلعة
Dialogue: 0,0:12:00.83,0:12:03.09,Main,,0,0,0,,طريقٌ مختصرٌ... إلى القلعة؟
Dialogue: 0,0:12:03.24,0:12:04.61,Main,,0,0,0,,لم أعلم بوجوده قطّ
Dialogue: 0,0:12:04.76,0:12:05.82,Main,,0,0,0,,...أخبرتكَ
Dialogue: 0,0:12:06.26,0:12:08.67,Main,,0,0,0,,سايو-ساما سيحرساننا
Dialogue: 0,0:12:12.86,0:12:13.78,Main,,0,0,0,,...أسا
Dialogue: 0,0:12:14.21,0:12:15.29,Main,,0,0,0,,أرجو أن تكوني بخيرٍ
Dialogue: 0,0:12:16.86,0:12:18.13,Main,,0,0,0,,!يورو
Dialogue: 0,0:12:28.61,0:12:30.60,Main,,0,0,0,,مرحبًا
Dialogue: 0,0:12:36.15,0:12:37.14,Main,,0,0,0,,قضم
Dialogue: 0,0:12:43.50,0:12:44.40,Main,,0,0,0,,قضم
Dialogue: 0,0:12:45.82,0:12:46.98,Main,,0,0,0,,قضم، قضم
Dialogue: 0,0:12:48.24,0:12:49.28,Main,,0,0,0,,قضم، قضم
Dialogue: 0,0:12:52.69,0:12:53.23,Main,,0,0,0,,قضمة
Dialogue: 0,0:13:04.51,0:13:05.74,Main,,0,0,0,,...أُمّـ
Dialogue: 0,0:13:06.90,0:13:09.14,Main,,0,0,0,,أنا لا أقضم الأطفال
Dialogue: 0,0:13:12.16,0:13:12.85,Main,,0,0,0,,قضم
Dialogue: 0,0:13:17.07,0:13:19.25,Main,,0,0,0,,‫مرحبًا، معك غابو-تشان
Dialogue: 0,0:13:19.71,0:13:22.56,Main,,0,0,0,,أُطبِقت السيطرةُ على الجناحين الخارجيّ والأوسط تقريبًا
Dialogue: 0,0:13:24.32,0:13:26.40,Main,,0,0,0,,‫بوسع القوّات البريّة التقدّم الآن
Dialogue: 0,0:13:33.15,0:13:34.65,Main,,0,0,0,,أيّتها القوّات البريّة؟
Dialogue: 0,0:13:36.18,0:13:38.65,Main,,0,0,0,,!عجبًا، عجبًا، عجبًا
Dialogue: 0,0:13:38.81,0:13:40.05,Main,,0,0,0,,ما العمل الآن؟
Dialogue: 0,0:13:42.07,0:13:44.22,Main,,0,0,0,,اختُرِقَ الحاجز
Dialogue: 0,0:13:45.77,0:13:49.13,Main,,0,0,0,,مرحبًا، هانا-تشان؟ إنّه أنا
Dialogue: 0,0:13:50.72,0:13:53.17,Main,,0,0,0,,الاتّصال يعمل كما توقّعت، هذا سيئ
Dialogue: 0,0:13:53.93,0:13:55.81,Main,,0,0,0,,أترين الدخان من موقعكِ؟
Dialogue: 0,0:13:56.31,0:13:57.25,Main,,0,0,0,,فهمت
Dialogue: 0,0:13:58.20,0:14:00.30,Main,,0,0,0,,أيمكننا تغيير نقطة الالتقاء؟
Dialogue: 0,0:14:01.14,0:14:03.59,Main,,0,0,0,,...أجل، أغلب الظنّ أنَّ
Dialogue: 0,0:14:04.55,0:14:06.08,Main,,0,0,0,,أسا قد أتت
Dialogue: 0,0:14:21.88,0:14:23.58,Main,,0,0,0,,هكذا إذن
Dialogue: 0,0:14:28.42,0:14:29.54,Main,,0,0,0,,ذوقٌ رديء
Dialogue: 0,0:14:36.18,0:14:37.18,Main,,0,0,0,,ذوقٌ رديء
Dialogue: 0,0:14:57.80,0:14:58.50,Main,,0,0,0,,!أسا
Dialogue: 0,0:14:59.34,0:14:59.97,Main,,0,0,0,,نعم
Dialogue: 0,0:15:00.64,0:15:02.27,Main,,0,0,0,,إنّها أنا يا أخي
Dialogue: 0,0:15:02.97,0:15:04.16,Main,,0,0,0,,جئتُ لاصطحابكَ
Dialogue: 0,0:15:05.23,0:15:06.67,Main,,0,0,0,,...و
Dialogue: 0,0:15:09.01,0:15:11.18,Main,,0,0,0,,!لأقتلنَّ الجميع عداكَ يا أخي
Dialogue: 0,0:15:12.27,0:15:13.09,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:15:14.83,0:15:17.14,Main,,0,0,0,,ما الّذي تقولينه؟
Dialogue: 0,0:15:18.93,0:15:20.43,Main,,0,0,0,,...مُحالٌ أن تكون
Dialogue: 0,0:15:21.82,0:15:22.73,Main,,0,0,0,,...أختي
Dialogue: 0,0:15:24.01,0:15:26.74,Main,,0,0,0,,!من أمثالكِ
Dialogue: 0,0:15:26.87,0:15:28.33,Main,,0,0,0,,!ابتعدي عن طريقي
Dialogue: 0,0:15:34.50,0:15:37.73,Main,,0,0,0,,تنكروا في هيئة مروحيات إنقاذٍ جبليةٍ إذن؟
Dialogue: 0,0:15:46.57,0:15:50.24,Main,,0,0,0,,تتبعهم لمسار هروبي من الجوّ سيكون مزعجًا
Dialogue: 0,0:15:56.16,0:15:57.27,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:15:58.11,0:15:59.82,Main,,0,0,0,,!عجبًا، عجبًا
Dialogue: 0,0:16:00.27,0:16:03.84,Main,,0,0,0,,!يا لها من أسنانٍ متراصةٍ ببهاءٍ
Dialogue: 0,0:16:08.36,0:16:10.27,Main,,0,0,0,,أأنتَ ممّن يُبصرون أيّها العمّ؟
Dialogue: 0,0:16:15.61,0:16:17.40,Main,,0,0,0,,!يا لهُ من ميناء أسنانٍ مُبهر
Dialogue: 0,0:16:17.41,0:16:20.29,Main,,0,0,0,,أأنتَ مَن أبحتَ القوات البريّة أيّها العمّ؟
Dialogue: 0,0:16:32.86,0:16:36.24,Main,,0,0,0,,،المعذرة، أردتُ كسر سهمكَ لا غير
Dialogue: 0,0:16:37.18,0:16:39.01,Main,,0,0,0,,غير أنّي لم أعتد على هذا بعد
Dialogue: 0,0:16:58.10,0:17:00.42,Main,,0,0,0,,!خذ يورو واهرب يا ديرا
Dialogue: 0,0:17:06.13,0:17:07.80,Main,,0,0,0,,!اختبئا في العالم السفليّ
Dialogue: 0,0:17:08.14,0:17:09.86,Main,,0,0,0,,!إيّاكما أن تُكشفا
Dialogue: 0,0:17:10.07,0:17:11.30,Main,,0,0,0,,!حاضر
Dialogue: 0,0:17:12.59,0:17:14.17,Main,,0,0,0,,هل أنتِ بخيرٍ يا أمّي؟
Dialogue: 0,0:17:16.44,0:17:17.55,Main,,0,0,0,,يورو؟
Dialogue: 0,0:17:17.95,0:17:19.38,Main,,0,0,0,,!يورو
Dialogue: 0,0:17:43.14,0:17:45.75,Main,,0,0,0,,سننزل من الجبل فورًا يا يورو
Dialogue: 0,0:17:46.88,0:17:48.96,Main,,0,0,0,,ما الّذي يحدث هنا؟
Dialogue: 0,0:17:49.61,0:17:50.89,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:17:51.35,0:17:53.12,Main,,0,0,0,,!ما الّذي يحدث بحقّ؟
Dialogue: 0,0:17:53.29,0:17:54.75,Main,,0,0,0,,!اتبعني فحسب
Dialogue: 0,0:18:04.29,0:18:06.15,Main,,0,0,0,,!تبًّا، فاتتنا فرصة الهرب
Dialogue: 0,0:18:10.28,0:18:13.49,Main,,0,0,0,,سنُحاصَر إن عاد طقم الأسنان ذاك
Dialogue: 0,0:18:14.09,0:18:14.70,Main,,0,0,0,,...أسا
Dialogue: 0,0:18:16.57,0:18:18.20,Main,,0,0,0,,ماتت أسا
Dialogue: 0,0:18:19.62,0:18:22.15,Main,,0,0,0,,أماتت فعلًا؟
Dialogue: 0,0:18:22.37,0:18:23.87,Main,,0,0,0,,!رأيتها تتحرّك
Dialogue: 0,0:18:24.48,0:18:26.20,Main,,0,0,0,,وتركنا الجدّة خلفنا أيضًا
Dialogue: 0,0:18:26.94,0:18:28.61,Main,,0,0,0,,من تكون تلك المرأة؟
Dialogue: 0,0:18:29.50,0:18:31.13,Main,,0,0,0,,قالت إنّها ستقتل الجميع
Dialogue: 0,0:18:31.81,0:18:34.43,Main,,0,0,0,,!رغم أنّهم لم يقترفوا ذنبًا
Dialogue: 0,0:18:35.12,0:18:37.39,Main,,0,0,0,,لا وقت للشرح الآن
Dialogue: 0,0:18:40.95,0:18:43.21,Main,,0,0,0,,استخدم سايو-ساما
Dialogue: 0,0:18:44.13,0:18:45.33,Main,,0,0,0,,سايو-ساما؟
Dialogue: 0,0:18:45.58,0:18:46.54,Main,,0,0,0,,ماذا تعني؟
Dialogue: 0,0:18:47.20,0:18:47.92,Main,,0,0,0,,هذا
Dialogue: 0,0:18:48.83,0:18:51.97,Main,,0,0,0,,،ثمّة فجوةٌ في بلاط الحجر بين سايو-ساما
Dialogue: 0,0:18:51.97,0:18:53.25,Main,,0,0,0,,ضعه فيها
Dialogue: 0,0:18:55.06,0:18:56.88,Main,,0,0,0,,!لا أفقه حرفًا ممّا تقول
Dialogue: 0,0:18:56.98,0:18:58.87,Main,,0,0,0,,!هذا هديةٌ منّي
Dialogue: 0,0:18:59.07,0:18:59.59,Main,,0,0,0,,هدية؟
Dialogue: 0,0:18:59.74,0:19:00.69,Main,,0,0,0,,ماذا؟
Dialogue: 0,0:19:00.87,0:19:02.03,Main,,0,0,0,,!افعلها فحسب
Dialogue: 0,0:19:02.40,0:19:03.69,Main,,0,0,0,,!بل عليكَ فعلها
Dialogue: 0,0:19:03.92,0:19:04.76,Main,,0,0,0,,!يا يورو
Dialogue: 0,0:19:05.37,0:19:07.96,Main,,0,0,0,,!ما الّذي يحدث بحقّ؟
Dialogue: 0,0:19:08.39,0:19:10.88,Main,,0,0,0,,!لم يشرح لي أحدٌ شيئًا اليوم
Dialogue: 0,0:19:12.60,0:19:14.06,Main,,0,0,0,,!الفجوة مسدودةٌ بالقمامة
Dialogue: 0,0:19:14.12,0:19:15.12,Main,,0,0,0,,!أخرجها إذن
Dialogue: 0,0:19:16.98,0:19:18.36,Main,,0,0,0,,ذاك هو الفتى
Dialogue: 0,0:19:18.57,0:19:20.98,Main,,0,0,0,,!أمسكوا به، لا بأس بالتخلّص من البقيّة
Dialogue: 0,0:19:21.38,0:19:23.42,Main,,0,0,0,,!كان يجدر بكَ تنظيف المكان بانتظام
Dialogue: 0,0:19:25.04,0:19:26.64,Main,,0,0,0,,!أدخلته يا ديرا-سان
Dialogue: 0,0:19:29.82,0:19:32.44,Main,,0,0,0,,!لِمَ فعلتَ ذلك يا ديرا-سان؟
Dialogue: 0,0:20:00.11,0:20:01.23,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:20:41.81,0:20:44.18,Main,,0,0,0,,ذهبتْ وسيلة عودتي أدراجَ الرياح
Dialogue: 0,0:20:44.91,0:20:47.73,Main,,0,0,0,,سيكون النزول من الجبل سيرًا مزعجًا حقًّا
Dialogue: 0,0:20:49.93,0:20:51.42,Main,,0,0,0,,اهدآ
Dialogue: 0,0:20:52.94,0:20:54.88,Main,,0,0,0,,يبدو أنَّ شيئًا قد ظهر
Dialogue: 0,0:20:56.08,0:20:57.44,Main,,0,0,0,,تسوغاي من هذا؟
Dialogue: 0,0:20:58.77,0:21:00.90,Main,,0,0,0,,آمل أن يكون ضعيفًا
Dialogue: 0,0:21:09.41,0:21:11.51,Main,,0,0,0,,...مهلًا، مهلًا، مهلًا
Dialogue: 0,0:21:12.51,0:21:15.07,Main,,0,0,0,,سيّدنا هذه المرّة طفلٌ
Dialogue: 0,0:21:15.98,0:21:18.75,Main,,0,0,0,,ألا يبدو طوعَ بناننا أيّتها اليسرى؟
Dialogue: 0,0:21:19.72,0:21:22.28,Main,,0,0,0,,،سواءً كان طفلًا أم بالغًا
Dialogue: 0,0:21:22.52,0:21:26.54,Main,,0,0,0,,علينا إطاعة أوامر سيّدنا أيّها الأيمن
Dialogue: 0,0:21:28.29,0:21:33.60,Main,,0,0,0,,أشباح، أرواح، وحوش، كائناتٌ غامضةٌ، مسوخٌ
Dialogue: 0,0:21:34.21,0:21:35.51,Main,,0,0,0,,قرناءٌ
Dialogue: 0,0:21:35.79,0:21:40.61,Main,,0,0,0,,تتعددُ مسمياتُهم؛ إذ تتباينُ ألقابُهم بتباينِ الرواة
Dialogue: 0,0:21:41.48,0:21:45.21,Main,,0,0,0,,هذان زوجا التسوغاي اللّذان يأتمرانِ بأمرك
Dialogue: 0,0:21:51.83,0:21:52.95,Main,,0,0,0,,تسوغاي؟
Dialogue: 0,0:23:28.06,0:23:29.89,Main,,0,0,0,,مخرج القرية يقع فوقنا
Dialogue: 0,0:23:30.53,0:23:31.71,Main,,0,0,0,,...اسمع يا يورو
Dialogue: 0,0:23:31.92,0:23:36.72,Main,,0,0,0,,تذكر أنَّ سايو-ساما يحرسانكَ دائمًا
