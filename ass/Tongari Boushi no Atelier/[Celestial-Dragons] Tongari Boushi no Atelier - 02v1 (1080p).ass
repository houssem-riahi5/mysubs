Dialogue: 0,0:00:19.75,0:00:21.02,Main,,0,0,0,,رياح؟
Dialogue: 0,0:00:24.63,0:00:25.64,Main,,0,0,0,,أاستيقظتِ؟
Dialogue: 0,0:00:27.96,0:00:30.76,Main,,0,0,0,,استدعيتُ عربةً مجنّحةً
Dialogue: 0,0:00:32.44,0:00:35.14,Main,,0,0,0,,لا بُدَّ أنَّ الجوّ كان باردًا في السماء بملابس النوم
Dialogue: 0,0:00:35.61,0:00:37.25,Main,,0,0,0,,سنصل قريبًا
Dialogue: 0,0:00:39.89,0:00:41.78,Main,,0,0,0,,انظري، لاحَ لنا
Dialogue: 0,0:00:52.27,0:00:56.00,Main,,0,0,0,,ذاك مرسمي، وفيه ستدرسينَ
Dialogue: 0,0:02:31.98,0:02:36.01,Top,,0,0,0,,زرعتُ بذور أشواك الحراسة حول منزلكِ
Dialogue: 0,0:02:36.74,0:02:40.40,Main,,0,0,0,,ستنمو سريعًا وتشكّل حاجزًا
Dialogue: 0,0:02:40.80,0:02:44.64,Main,,0,0,0,,بما أنَّ منزلكِ قد تحجّر بفعل سحرٍ مجهول
Dialogue: 0,0:02:45.52,0:02:48.52,Main,,0,0,0,,كي لا يقترب منه أحدٌ بتهوّرٍ
Dialogue: 0,0:02:54.44,0:02:55.61,Main,,0,0,0,,...لذا
Dialogue: 0,0:02:57.31,0:02:58.31,Main,,0,0,0,,كوكو؟
Dialogue: 0,0:03:03.51,0:03:04.68,Main,,0,0,0,,ما الخطب؟
Dialogue: 0,0:03:05.54,0:03:10.24,Main,,0,0,0,,وعدتُ أمّي ألّا أتركها وحيدةً
Dialogue: 0,0:03:10.24,0:03:11.32,Main,,0,0,0,,...لكنّي
Dialogue: 0,0:03:12.28,0:03:13.33,Main,,0,0,0,,...كوكو
Dialogue: 0,0:03:18.55,0:03:22.40,Main,,0,0,0,,لا تلومي نفسكِ، فما كنتِ على درايةٍ بما تفعلينه
Dialogue: 0,0:03:35.28,0:03:37.40,Main,,0,0,0,,هيّا، اغسلي وجهكِ
Dialogue: 0,0:03:38.05,0:03:40.97,Main,,0,0,0,,أفرغي مآقيكِ من شجونها، ثمَّ تطلّعي للأمام
Dialogue: 0,0:03:43.76,0:03:45.92,Main,,0,0,0,,فمأواكِ سيكون هنا بدءًا من اليوم
Dialogue: 0,0:03:56.84,0:03:59.15,Main,,0,0,0,,عفوًا، ما هذا؟
Dialogue: 0,0:04:00.34,0:04:01.48,Main,,0,0,0,,إنّه ماءٌ
Dialogue: 0,0:04:05.39,0:04:08.66,Main,,0,0,0,,يبدو كرويًّا وطافيًا فلا يكادُ المرءُ يحسبه ماءً
Dialogue: 0,0:04:04.57,0:04:08.44,Top,,0,0,0,,نسيتُ تمامًا، تحتاجين إلى طقم ملابسٍ
Dialogue: 0,0:04:11.01,0:04:13.65,Main,,0,0,0,,كيف يُفترض بي استخدام هذا؟
Dialogue: 0,0:04:14.38,0:04:15.79,Main,,0,0,0,,!كيفري-سان
Dialogue: 0,0:04:18.33,0:04:21.91,Main,,0,0,0,,أخشى لمس سحرٍ أجهله
Dialogue: 0,0:04:22.05,0:04:23.87,Main,,0,0,0,,!ليس مخيفًا
Dialogue: 0,0:04:24.39,0:04:26.87,Main,,0,0,0,,إذ لا يُعدُّ سحرًا معقدًا
Dialogue: 0,0:04:29.60,0:04:31.80,Main,,0,0,0,,أتريدين أن تُعلّمكِ تيتيا؟
Dialogue: 0,0:04:35.45,0:04:37.52,Main,,0,0,0,,هذه قطرة ماءٍ طافية
Dialogue: 0,0:04:37.89,0:04:41.46,Main,,0,0,0,,سحرٌ يستخلص الماء من رطوبة الهواء
Dialogue: 0,0:04:41.90,0:04:43.12,Main,,0,0,0,,تُرفع هكذا
Dialogue: 0,0:04:43.38,0:04:44.51,Main,,0,0,0,,مدّي يديكِ
Dialogue: 0,0:04:45.63,0:04:49.28,Main,,0,0,0,,أميلي الصحن السفليّ ليتدفّق الماء
Dialogue: 0,0:04:50.81,0:04:51.89,Main,,0,0,0,,!مُذهل
Dialogue: 0,0:04:52.34,0:04:53.23,Main,,0,0,0,,شكرًا لكِ
Dialogue: 0,0:04:53.39,0:04:54.90,Main,,0,0,0,,!شكرًا لكِ
Dialogue: 0,0:04:55.65,0:04:58.89,Main,,0,0,0,,أحبّ أن يشكرني الآخرون
Dialogue: 0,0:04:58.89,0:05:00.78,Main,,0,0,0,,!لذا شكرًا لكِ
Dialogue: 0,0:05:01.37,0:05:04.42,Main,,0,0,0,,!حسنٌ... فهمت
Dialogue: 0,0:05:04.42,0:05:05.81,Main,,0,0,0,,!شكرًا لكِ
Dialogue: 0,0:05:05.94,0:05:08.58,Main,,0,0,0,,!بل الشكرُ لكِ على شكري مجدّدًا
Dialogue: 0,0:05:08.77,0:05:12.85,Main,,0,0,0,,!بل الشكرُ لكِ على شكركِ الّذي شكرتِ به شكري
Dialogue: 0,0:05:12.35,0:05:14.46,Top,,0,0,0,,تجاهليها إن كانت مزعجةً
Dialogue: 0,0:05:16.54,0:05:18.88,Main,,0,0,0,,ستصمتُ إن لم تلقَ منكِ ردًا
Dialogue: 0,0:05:19.60,0:05:24.42,Main,,0,0,0,,يا للؤمكِ يا ريتشي، كانت تيتيا تُساعدها فحسب
Dialogue: 0,0:05:26.48,0:05:28.18,Main,,0,0,0,,!قلمٌ وحبرٌ
Dialogue: 0,0:05:29.59,0:05:31.59,Main,,0,0,0,,أأنتما ساحرتان؟
Dialogue: 0,0:05:31.73,0:05:35.81,Main,,0,0,0,,نحن تلميذتان، نتتلمذ على يد كيفري-سينسي
Dialogue: 0,0:05:35.81,0:05:38.32,Main,,0,0,0,,مهلًا، ألستِ كذلك؟
Dialogue: 0,0:05:38.93,0:05:42.18,Main,,0,0,0,,ظننتكِ متدرّبةً مثلنا
Dialogue: 0,0:05:42.30,0:05:45.13,Main,,0,0,0,,أأنتِ في مثل سنّنا؟ من أيّ مرسمٍ أنتِ؟
Dialogue: 0,0:05:47.81,0:05:50.50,Main,,0,0,0,,لا أظنّني أرقى لمستوى المتدرّبة بعد
Dialogue: 0,0:05:50.86,0:05:54.61,Main,,0,0,0,,فقد رسمتُ السّحر البارحة لأوّل مرّة
Dialogue: 0,0:05:55.06,0:05:57.34,Main,,0,0,0,,وسأعيش هنا ابتداءً من اليوم
Dialogue: 0,0:06:01.15,0:06:02.15,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:06:02.94,0:06:05.84,Main,,0,0,0,,أيعقل... أنّكِ الفاعلة؟
Dialogue: 0,0:06:06.28,0:06:08.10,Main,,0,0,0,,فعلتُ ماذا؟
Dialogue: 0,0:06:15.90,0:06:17.68,Main,,0,0,0,,تناهتْ إلى مسامعنا شائعةٌ
Dialogue: 0,0:06:18.95,0:06:22.48,Main,,0,0,0,,،عن "جاهلةٍ" استخدمتْ سحرًا مُحرّمًا
Dialogue: 0,0:06:22.56,0:06:26.08,Main,,0,0,0,,وسُمِحَ لها بالتّتلمذ دون محو ذكرياتها
Dialogue: 0,0:06:28.24,0:06:29.25,Main,,0,0,0,,كوكو
Dialogue: 0,0:06:31.11,0:06:32.40,Main,,0,0,0,,أأنتِ بخير؟
Dialogue: 0,0:06:32.40,0:06:33.83,Main,,0,0,0,,...كيفري-سان
Dialogue: 0,0:06:34.50,0:06:37.38,Main,,0,0,0,,أرى أنّكنَّ تعارفتنَّ بالفعل
Dialogue: 0,0:06:37.67,0:06:40.19,Main,,0,0,0,,،متى ما أنهيتما مهامِّ الصباح يا ريتشي وتيتيا
Dialogue: 0,0:06:40.32,0:06:42.08,Main,,0,0,0,,فلتذهبا للمذاكرةِ في غرفتكما
Dialogue: 0,0:06:42.08,0:06:43.50,Main,,0,0,0,,!حاضر
Dialogue: 0,0:06:44.57,0:06:47.64,Main,,0,0,0,,خذي هذه الثياب، فالجميعُ هنا يرتدونها
Dialogue: 0,0:06:50.39,0:06:53.60,Main,,0,0,0,,لا تخافي، سأبينُ لكِ حقيقة الأمر جليًّا
Dialogue: 0,0:06:56.27,0:06:57.92,Main,,0,0,0,,أراها لاءمتْكِ تمامًا
Dialogue: 0,0:07:00.44,0:07:04.03,Main,,0,0,0,,حسنٌ، لنبدأ حديثنا عن السّحر
Dialogue: 0,0:07:07.55,0:07:12.09,Main,,0,0,0,,في غابر الزمان، لم يكن السّحرُ حكرًا على أحدٍ
Dialogue: 0,0:07:13.59,0:07:17.92,Main,,0,0,0,,كان يتطلّب معرفة مزيجٍ من نقوشٍ وحبرٍ ذو تركيبةٍ خاصّةٍ
Dialogue: 0,0:07:23.78,0:07:28.33,Main,,0,0,0,,إذ كان جزءًا لا يتجزأُ من حياة المرء آنذاك
Dialogue: 0,0:07:30.14,0:07:34.51,Main,,0,0,0,,غير أنّه تسبّب في نشوب صراعاتٍ لا حصر لها
Dialogue: 0,0:07:36.94,0:07:38.96,Main,,0,0,0,,،إنْ حازَ البشرُ قوةً لفعلِ أيّ شيءٍ
Dialogue: 0,0:07:39.10,0:07:40.87,Main,,0,0,0,,فلنْ يتورّعوا عن فِعلِ أيِّ شيءٍ
Dialogue: 0,0:07:41.71,0:07:44.39,Main,,0,0,0,,فقد خُطَّتْ آنذاك تعاويذُ سحريّةٌ مروّعةٌ
Dialogue: 0,0:07:49.17,0:07:51.89,Main,,0,0,0,,...فما كان من أصحابِ البصيرة القلائل
Dialogue: 0,0:07:52.09,0:07:55.86,Main,,0,0,0,,...إلّا أنْ كفّوا عن الصراعِ واتحدوا تحت لواءِ السّحرة
Dialogue: 0,0:07:56.03,0:07:58.49,Main,,0,0,0,,...ليمحوا أثر السّحر من ذاكرة النّاس
Dialogue: 0,0:07:58.67,0:08:02.81,Main,,0,0,0,,وتوريثه لتلاميذَ مختارينَ يتعهدون بصونِ الأمانةِ وتناقُلها
Dialogue: 0,0:08:04.09,0:08:06.16,Main,,0,0,0,,"كان ذلك "يوم العهد
Dialogue: 0,0:08:07.10,0:08:12.11,Main,,0,0,0,,ومُذ ذاك الحين، أُشيعَ أنَّ السّحر قوّةٌ لا يطوعُها إلّا صفوةٌ من البشر
Dialogue: 0,0:08:12.69,0:08:14.75,Main,,0,0,0,,،إن شاعتْ الحقيقة بين الملأِ
Dialogue: 0,0:08:14.86,0:08:17.39,Main,,0,0,0,,فسيستحيلُ العالمُ مرتعًا للغابِ ثانيةً
Dialogue: 0,0:08:18.03,0:08:21.41,Main,,0,0,0,,لذا يتوخّى الجميع الحذر لكتمان السرّ
Dialogue: 0,0:08:21.78,0:08:23.90,Main,,0,0,0,,وهذا ما جعل الألسنَ تتناقلُ أخبارَكِ
Dialogue: 0,0:08:24.24,0:08:25.43,Main,,0,0,0,,آسف
Dialogue: 0,0:08:26.21,0:08:29.15,Main,,0,0,0,,كلّا، جنيتُ هذا على نفسي
Dialogue: 0,0:08:30.13,0:08:33.16,Main,,0,0,0,,عفوًا، ما السّحر المحرّم؟
Dialogue: 0,0:08:34.69,0:08:36.82,Main,,0,0,0,,سحرٌ رُسم في عصر النّزاعات
Dialogue: 0,0:08:36.82,0:08:39.32,Main,,0,0,0,,وحُرّم في يوم العهد
Dialogue: 0,0:08:40.39,0:08:42.29,Main,,0,0,0,,إنّه سحرٌ لإيذاء النّاس
Dialogue: 0,0:08:44.80,0:08:46.79,Main,,0,0,0,,!أرجوكَ علّمني
Dialogue: 0,0:08:47.00,0:08:48.92,Main,,0,0,0,,!كلَّ ما يخصُّ السّحر الّذي حُرِّم عليَّ استخدامه
Dialogue: 0,0:08:49.18,0:08:50.22,Main,,0,0,0,,!أريد أن أعرف
Dialogue: 0,0:08:51.84,0:08:55.62,Main,,0,0,0,,أخشى ألّا أقوى على فعل شيءٍ وأنا غارقةٌ في جهلي
Dialogue: 0,0:08:57.95,0:09:00.27,Main,,0,0,0,,،عادةً ما أنصح تلاميذي بعدم التسرّع
Dialogue: 0,0:09:00.71,0:09:02.73,Main,,0,0,0,,لكن يصعب عليَّ قول ذلك لكِ
Dialogue: 0,0:09:05.25,0:09:06.41,Main,,0,0,0,,اتبعيني
Dialogue: 0,0:09:11.43,0:09:14.66,Main,,0,0,0,,،التعاويذ السّحريّة المحرّمة لا تُحصى
Dialogue: 0,0:09:14.79,0:09:17.76,Main,,0,0,0,,لكن تُصبح بسيطةً إن لُخِّصتْ
Dialogue: 0,0:09:18.75,0:09:20.81,Main,,0,0,0,,،السّحر الّذي يُلقى على جسد الإنسان مباشرةً
Dialogue: 0,0:09:20.97,0:09:22.90,Main,,0,0,0,,يُعدُّ محظورًا تحت أيِّ ظرفٍ كان
Dialogue: 0,0:09:23.49,0:09:26.82,Main,,0,0,0,,،كالتحوّل أو تغيير السّن
Dialogue: 0,0:09:26.82,0:09:29.83,Main,,0,0,0,,،والانتقال الآنيّ دون استخدام أبوابٍ أو وسائل نقلٍ
Dialogue: 0,0:09:30.56,0:09:32.90,Main,,0,0,0,,،والتلاعب بالأفكار والمشاعر
Dialogue: 0,0:09:33.04,0:09:35.39,Main,,0,0,0,,وإيذاء البشر أو شفائهم
Dialogue: 0,0:09:36.26,0:09:38.39,Main,,0,0,0,,لكن ثمّة استثناءٌ واحد
Dialogue: 0,0:09:39.05,0:09:41.14,Main,,0,0,0,,سحر محو الذكريات
Dialogue: 0,0:09:41.47,0:09:42.56,Main,,0,0,0,,بالضبط
Dialogue: 0,0:09:44.82,0:09:47.26,Main,,0,0,0,,تُلقى جُلّ التعاويذ السّحريّة على الأدوات
Dialogue: 0,0:09:48.73,0:09:50.83,Main,,0,0,0,,،كالعربات أو المصابيح
Dialogue: 0,0:09:58.16,0:10:01.50,Main,,0,0,0,,أو نوافذ كهذه
Dialogue: 0,0:10:21.18,0:10:22.67,Main,,0,0,0,,!بحيرة؟
Dialogue: 0,0:10:23.77,0:10:26.46,Main,,0,0,0,,كانت التّلال تكتنفُنا من كلِّ صوبٍ قبل لحظاتٍ
Dialogue: 0,0:10:27.29,0:10:28.79,Main,,0,0,0,,إنّها نافذةُ عبورٍ
Dialogue: 0,0:10:28.94,0:10:31.51,Main,,0,0,0,,تربط بين نافذتين دائريّتين تحملان النقش ذاته
Dialogue: 0,0:10:32.82,0:10:34.78,Main,,0,0,0,,أترين ذلك المبنى هناك؟
Dialogue: 0,0:10:35.70,0:10:37.00,Main,,0,0,0,,"إنّه "برج الكتب
Dialogue: 0,0:10:37.52,0:10:44.04,Main,,0,0,0,,تُنسخ فيه كلّ الكتب المتعلّقة بالسّحر فور كتابتها بغية حفظ المعرفة
Dialogue: 0,0:10:45.33,0:10:46.66,Main,,0,0,0,,...الكتاب المصوّر
Dialogue: 0,0:10:47.14,0:10:50.24,Main,,0,0,0,,!لنذهب إلى هناك الآن، لن أنام حتّى أجده
Dialogue: 0,0:10:50.24,0:10:51.05,Main,,0,0,0,,تمهّلي
Dialogue: 0,0:11:08.91,0:11:10.73,Main,,0,0,0,,كان ذلك اختبار الحكماء
Dialogue: 0,0:11:11.21,0:11:14.47,Main,,0,0,0,,،يحرس برج الكتب أربعة حكماء
Dialogue: 0,0:11:14.47,0:11:18.11,Main,,0,0,0,,ولا يدخله سوى السّحرة الّذين اجتازوا الاختبار
Dialogue: 0,0:11:18.99,0:11:21.95,Main,,0,0,0,,عليكِ الدراسة أولًا لدخول البرج
Dialogue: 0,0:11:23.04,0:11:23.95,Main,,0,0,0,,كوكو
Dialogue: 0,0:11:24.71,0:11:29.08,Main,,0,0,0,,سُعدتُ حين أبديتِ رغبتكِ في المعرفة سابقًا
Dialogue: 0,0:11:29.99,0:11:32.09,Main,,0,0,0,,الشعور بالخوف أمرٌ لا مفرّ منه
Dialogue: 0,0:11:32.42,0:11:33.44,Main,,0,0,0,,...لكن
Dialogue: 0,0:11:35.01,0:11:37.84,Main,,0,0,0,,التعاويذ الّتي لم تُحرّم
Dialogue: 0,0:11:42.88,0:11:45.75,Main,,0,0,0,,هي الّتي تجلب السعادة للبشر فحسب
Dialogue: 0,0:11:47.15,0:11:50.61,Main,,0,0,0,,لذا أودّ أن تتعرّفي على المزيد من الأسحار اللطيفة
Dialogue: 0,0:11:51.88,0:11:52.67,Main,,0,0,0,,هذا ما أشعر به
Dialogue: 0,0:11:53.91,0:11:55.05,Main,,0,0,0,,ما رأيكِ؟
Dialogue: 0,0:11:56.30,0:11:58.82,Main,,0,0,0,,حسنٌ يا كيفري-سينسي
Dialogue: 0,0:12:02.99,0:12:04.54,Main,,0,0,0,,هذه غرفتكِ
Dialogue: 0,0:12:08.00,0:12:09.87,Main,,0,0,0,,يبدو أنَّ أغوت ليست هنا
Dialogue: 0,0:12:09.87,0:12:11.42,Main,,0,0,0,,من أغوت؟
Dialogue: 0,0:12:11.42,0:12:13.29,Main,,0,0,0,,زميلتكِ في السّكن
Dialogue: 0,0:12:19.25,0:12:21.91,Main,,0,0,0,,ستتشاركان مساحة العمل
Dialogue: 0,0:12:22.09,0:12:23.68,Main,,0,0,0,,أمّا غرف النوم فمُنفصلةٌ
Dialogue: 0,0:12:26.24,0:12:28.08,Main,,0,0,0,,انزلي الدرج الخلفيّ
Dialogue: 0,0:12:28.34,0:12:29.85,Main,,0,0,0,,الغرفة مزوّدةٌ بقفلٍ لذا اطمئنّي
Dialogue: 0,0:12:31.50,0:12:33.06,Main,,0,0,0,,خذي قسطًا من الراحة
Dialogue: 0,0:12:33.46,0:12:36.58,Main,,0,0,0,,لديَّ شأنٌ لأقضيه، ناديني إن احتجتِ لشيءٍ
Dialogue: 0,0:12:47.52,0:12:49.53,Main,,0,0,0,,إنّه أنا، كيفري
Dialogue: 0,0:12:50.09,0:12:53.79,Main,,0,0,0,,شكرًا لسماحكِ لي باتّخاذ كوكو تلميذةً تحتَ جناحي
Dialogue: 0,0:12:55.20,0:12:55.80,Main,,0,0,0,,نعم
Dialogue: 0,0:12:57.15,0:12:57.87,Main,,0,0,0,,أجل
Dialogue: 0,0:12:58.50,0:12:59.76,Main,,0,0,0,,لم أخبرها بأمر الكتاب المصوّر بعد
Dialogue: 0,0:12:59.84,0:13:02.30,Main,,0,0,0,,إنّها مشوّشةٌ الآن
Dialogue: 0,0:13:05.19,0:13:07.86,Main,,0,0,0,,هكذا تبدو غرفة الساحرة إذن
Dialogue: 0,0:13:09.54,0:13:11.69,Main,,0,0,0,,ذلك مكتبي
Dialogue: 0,0:13:23.61,0:13:25.95,Main,,0,0,0,,سأنزل، لذا ابتعدي
Dialogue: 0,0:13:26.90,0:13:27.87,Main,,0,0,0,,آسفة
Dialogue: 0,0:13:38.75,0:13:40.31,Main,,0,0,0,,أنتِ أغوت، أليس كذلك؟
Dialogue: 0,0:13:40.53,0:13:41.17,Main,,0,0,0,,أنا كوكو
Dialogue: 0,0:13:41.17,0:13:41.98,Main,,0,0,0,,أدري
Dialogue: 0,0:13:42.64,0:13:44.70,Main,,0,0,0,,أنتِ الجاهلة الّتي يتحدّث عنها الجميع
Dialogue: 0,0:13:45.12,0:13:48.12,Main,,0,0,0,,سمعتُ أنّكِ ستغدين زميلتنا الجديدة
Dialogue: 0,0:13:49.44,0:13:51.94,Main,,0,0,0,,يؤسفني ما حلَّ بوالدتكِ
Dialogue: 0,0:13:52.73,0:13:54.81,Main,,0,0,0,,شـ-شكرًا لكِ
Dialogue: 0,0:13:55.04,0:13:56.77,Main,,0,0,0,,...بسبب ما اقترفتِهِ
Dialogue: 0,0:13:59.23,0:14:01.78,Main,,0,0,0,,لن تعود بشريّةً أبدَ الدهرِ
Dialogue: 0,0:14:03.44,0:14:05.79,Main,,0,0,0,,...جئتُ إلى هنا لإنقاذها
Dialogue: 0,0:14:06.65,0:14:08.12,Main,,0,0,0,,بأن أغدو ساحرةً
Dialogue: 0,0:14:10.49,0:14:13.06,Main,,0,0,0,,...ما فتِئنا نرسم أختام الإلقاء منذ نعومة أظفارنا
Dialogue: 0,0:14:13.06,0:14:14.88,Main,,0,0,0,,حتّى اسودّتْ أناملنا بالحبر
Dialogue: 0,0:14:15.22,0:14:17.53,Main,,0,0,0,,ولا نغدو متدرّباتٍ إلّا بعد اجتياز الاختبار
Dialogue: 0,0:14:17.71,0:14:20.16,Main,,0,0,0,,ولا نُقبل كمتدرّباتٍ إلّا بعد ذلك
Dialogue: 0,0:14:20.86,0:14:23.24,Main,,0,0,0,,أنتِ فتاةٌ عاديّةٌ لا تفقه شيئًا
Dialogue: 0,0:14:23.24,0:14:26.60,Main,,0,0,0,,يستحيل على جاهلةٍ مثلكِ أن تغدو ساحرةً
Dialogue: 0,0:14:30.08,0:14:33.00,Main,,0,0,0,,!ألقيتُ السّحر حين جرّبته
Dialogue: 0,0:14:33.53,0:14:35.23,Main,,0,0,0,,!لن أعرف ما لم أجرّب
Dialogue: 0,0:14:35.56,0:14:37.44,Main,,0,0,0,,أثبتي ذلك إذن
Dialogue: 0,0:14:37.65,0:14:39.53,Main,,0,0,0,,فغدًا ستخضعينَ للاختبار
Dialogue: 0,0:14:38.62,0:14:40.82,Top,,0,0,0,,!أغوت، كوكو
Dialogue: 0,0:14:40.93,0:14:42.90,Main,,0,0,0,,...الطّعام
Dialogue: 0,0:14:43.52,0:14:45.05,Main,,0,0,0,,!جاهز
Dialogue: 0,0:14:51.14,0:14:52.55,Main,,0,0,0,,ريتشي جائعةٌ أيضًا
Dialogue: 0,0:14:52.69,0:14:53.99,Main,,0,0,0,,!وتيتيا أيضًا
Dialogue: 0,0:14:54.24,0:14:57.01,Main,,0,0,0,,سنقيم حفلة ترحيبٍ بكوكو اليوم، أليس كذلك؟
Dialogue: 0,0:14:57.26,0:14:58.45,Main,,0,0,0,,الكثير من الطّعام
Dialogue: 0,0:15:06.83,0:15:08.41,Main,,0,0,0,,طعامُنا المعتاد
Dialogue: 0,0:15:09.38,0:15:11.81,Main,,0,0,0,,سينسي، ماذا عن حفل الترحيب؟
Dialogue: 0,0:15:12.10,0:15:15.74,Main,,0,0,0,,كان الأمر مفاجئًا، سنُقيم حفل الترحيب في وقتٍ آخر
Dialogue: 0,0:15:16.24,0:15:17.32,Main,,0,0,0,,أين أغوت؟
Dialogue: 0,0:15:17.32,0:15:19.13,Main,,0,0,0,,قالت إنّها ستأكل في غرفتها
Dialogue: 0,0:15:19.93,0:15:23.20,Main,,0,0,0,,أودّ لو نأكل جميعًا معًا بين الحين والآخر
Dialogue: 0,0:15:23.60,0:15:25.85,Main,,0,0,0,,حسنٌ، لنأكل
Dialogue: 0,0:15:26.62,0:15:29.36,Main,,0,0,0,,هلّا تفضّلتِ بالبدء يا كوكو؟
Dialogue: 0,0:15:30.20,0:15:31.15,Main,,0,0,0,,حـ-حسنٌ
Dialogue: 0,0:15:32.48,0:15:33.94,Main,,0,0,0,,لنتناول الطّعام
Dialogue: 0,0:15:33.94,0:15:35.58,Main,,0,0,0,,لنتناول الطّعام
Dialogue: 0,0:15:43.11,0:15:44.36,Main,,0,0,0,,لذيذ
Dialogue: 0,0:15:44.52,0:15:45.90,Main,,0,0,0,,أليس كذلك؟ أليس كذلك؟
Dialogue: 0,0:15:45.97,0:15:47.57,Main,,0,0,0,,خبزناه بأنفسنا
Dialogue: 0,0:15:47.98,0:15:49.83,Main,,0,0,0,,سينسي طاهٍ ماهرٌ
Dialogue: 0,0:15:49.83,0:15:50.97,Main,,0,0,0,,مُذهل
Dialogue: 0,0:15:51.67,0:15:53.97,Main,,0,0,0,,هذا بفضل القمح المزروع محليًّا
Dialogue: 0,0:16:02.70,0:16:05.75,Main,,0,0,0,,والخضروات المحصودة من الجوار لذيذةٌ أيضًا
Dialogue: 0,0:16:06.32,0:16:08.25,Main,,0,0,0,,شكرًا على الطّعام
Dialogue: 0,0:16:33.32,0:16:34.82,Main,,0,0,0,,...أمّي
Dialogue: 0,0:16:44.29,0:16:48.30,Main,,0,0,0,,قيل لي إنَّ عليَّ اجتياز اختبارٍ لأغدو متدرّبةً
Dialogue: 0,0:16:49.39,0:16:54.07,Main,,0,0,0,,لكن لم تُذكر أيُّ تفاصيلَ محدّدةٍ بشأن ما عليَّ فعله
Dialogue: 0,0:16:54.47,0:16:56.08,Main,,0,0,0,,ما الّذي لم يُذكر؟
Dialogue: 0,0:16:58.47,0:17:01.85,Main,,0,0,0,,ثمّة أمورٌ كثيرةٌ متعلّقةٌ بالسّحر لا تُذكر في الكتب
Dialogue: 0,0:17:01.85,0:17:05.38,Main,,0,0,0,,فالتعلّم بالممارسة أهمّ من القراءة
Dialogue: 0,0:17:05.83,0:17:07.01,Main,,0,0,0,,ما هذا؟
Dialogue: 0,0:17:07.50,0:17:10.65,Main,,0,0,0,,موادُّكِ السّحريّة، أدواتٌ لرسم السّحر
Dialogue: 0,0:17:14.02,0:17:16.60,Main,,0,0,0,,!يا لروعتها
Dialogue: 0,0:17:18.77,0:17:20.25,Main,,0,0,0,,...عصا الحبر السّحريّة
Dialogue: 0,0:17:20.70,0:17:21.39,Main,,0,0,0,,القلم
Dialogue: 0,0:17:22.59,0:17:25.65,Main,,0,0,0,,...في الواقع ما زلتُ خائفةً قليلًا، ولكن
Dialogue: 0,0:17:26.34,0:17:29.50,Main,,0,0,0,,!سأعيدكِ إلى طبيعتكِ حتمًا يا أمّي
Dialogue: 0,0:17:30.39,0:17:32.91,Main,,0,0,0,,أتطلّع لدروسكَ يا كيفري-سينسي
Dialogue: 0,0:17:33.34,0:17:35.04,Main,,0,0,0,,حسنٌ، لنبدأ
Dialogue: 0,0:17:42.29,0:17:45.24,Main,,0,0,0,,أأنتِ بخيرٍ يا كوكو؟ أتريدين أخذ قسطٍ من الراحة؟
Dialogue: 0,0:17:46.07,0:17:48.25,Main,,0,0,0,,أ-أنا بخير
Dialogue: 0,0:17:49.79,0:17:53.01,Main,,0,0,0,,إذن، اشرحي لي ما فهمتِه
Dialogue: 0,0:17:53.39,0:17:54.69,Main,,0,0,0,,حـ-حاضر
Dialogue: 0,0:17:55.18,0:18:00.04,Main,,0,0,0,,حسنٌ، يتكوّن السّحر من ثلاثة عناصر
Dialogue: 0,0:18:00.70,0:18:02.82,Main,,0,0,0,,الرمز في المنتصف
Dialogue: 0,0:18:02.82,0:18:06.41,Main,,0,0,0,,"وتحيط به خطوطٌ تُسمّى "الأسهم
Dialogue: 0,0:18:06.64,0:18:10.03,Main,,0,0,0,,"والدائرة الخارجيّة الّتي تحيط بهما تُسمّى "الحلقة
Dialogue: 0,0:18:10.23,0:18:11.42,Main,,0,0,0,,أنواع الرموز؛
Dialogue: 0,0:18:11.57,0:18:12.27,Main,,0,0,0,,،النار
Dialogue: 0,0:18:13.66,0:18:14.55,Main,,0,0,0,,،والماء
Dialogue: 0,0:18:15.38,0:18:16.42,Main,,0,0,0,,،والنور
Dialogue: 0,0:18:17.56,0:18:18.56,Main,,0,0,0,,والرياح
Dialogue: 0,0:18:18.72,0:18:21.66,Main,,0,0,0,,وهي تحدّد نوع السّحر
Dialogue: 0,0:18:22.12,0:18:25.33,Main,,0,0,0,,،وتحدّد الأسهم شكل السّحر
Dialogue: 0,0:18:25.48,0:18:27.92,Main,,0,0,0,,وحجمه، واتّجاهه
Dialogue: 0,0:18:28.91,0:18:31.94,Main,,0,0,0,,،وأخيرًا، حين تكتمل الدائرة الخارجيّة
Dialogue: 0,0:18:31.94,0:18:35.16,Main,,0,0,0,,يُثبّت الختم ويُفعّل السّحر
Dialogue: 0,0:18:36.80,0:18:39.93,Main,,0,0,0,,الحفظ وحده يستنزف طاقتي
Dialogue: 0,0:18:40.02,0:18:41.68,Main,,0,0,0,,!لكنّكِ تمكّنتِ من شرحه
Dialogue: 0,0:18:44.12,0:18:45.93,Main,,0,0,0,,!سأحاول الرسم
Dialogue: 0,0:18:46.04,0:18:48.00,Main,,0,0,0,,أحسنتِ، هذه الروحُ المطلوبة
Dialogue: 0,0:19:04.48,0:19:06.21,Main,,0,0,0,,لا يجوز رميها
Dialogue: 0,0:19:07.21,0:19:08.96,Main,,0,0,0,,!لا، لا تنظر
Dialogue: 0,0:19:08.96,0:19:11.43,Main,,0,0,0,,!لا يسعني أن أُرِيَكَ شيئًا كهذا
Dialogue: 0,0:19:11.53,0:19:15.46,Main,,0,0,0,,إنّه سيّئ، والخطوط متعرّجةٌ وغير متقنةٍ
Dialogue: 0,0:19:15.84,0:19:19.08,Main,,0,0,0,,هذا طبيعيّ، فقد بدأتِ للتوّ
Dialogue: 0,0:19:19.23,0:19:22.35,Main,,0,0,0,,والأهمُّ من ذلك هو ما يغيبُ عن ناظرَيْكِ
Dialogue: 0,0:19:22.75,0:19:25.73,Main,,0,0,0,,انظري هنا، حلقتكِ غير متّصلة
Dialogue: 0,0:19:25.98,0:19:28.77,Main,,0,0,0,,لن يُفعّل السّحر ما لم تكن الحلقةُ مُتّصلةً
Dialogue: 0,0:19:32.50,0:19:35.76,Main,,0,0,0,,من الطبيعيّ أن ترتجف يداكِ عند استخدام أداةٍ جديدةٍ
Dialogue: 0,0:19:35.98,0:19:38.62,Main,,0,0,0,,كمُهرةٍ وليدةٍ تحاولُ الوقوف أول مرّةٍ
Dialogue: 0,0:19:38.90,0:19:42.53,Main,,0,0,0,,ستعتادين الأمر سريعًا وتركضين بحريّةٍ
Dialogue: 0,0:19:44.37,0:19:47.89,Main,,0,0,0,,والآن، صِلي الخطوط وفعّليه
Dialogue: 0,0:20:02.57,0:20:05.23,Main,,0,0,0,,!آ-آسفة، آسفة، لم أتعمد ذلك
Dialogue: 0,0:20:08.23,0:20:11.23,Main,,0,0,0,,!آسفة، سأجفّفه، سأجفّفه
Dialogue: 0,0:20:12.52,0:20:14.34,Main,,0,0,0,,!اهدئي يا كوكو
Dialogue: 0,0:20:12.52,0:20:13.71,Top,,0,0,0,,!هل جفّ؟
Dialogue: 0,0:20:14.34,0:20:16.38,Main,,0,0,0,,آسفٌ يا أغوت، أأنتِ بخير؟
Dialogue: 0,0:20:15.83,0:20:16.99,Top,,0,0,0,,!ألم يجفّ بعد؟
Dialogue: 0,0:20:18.54,0:20:22.87,Main,,0,0,0,,لا بأس يا سينسي، لم أنزعج على إطلاقًا
Dialogue: 0,0:20:23.28,0:20:26.40,Main,,0,0,0,,الأهمّ من ذلك، أرني ختم الإلقاء الّذي رسمتْهُ كوكو
Dialogue: 0,0:20:27.41,0:20:28.37,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:20:30.36,0:20:31.63,Main,,0,0,0,,عرفتُ الخلل
Dialogue: 0,0:20:36.12,0:20:37.01,Main,,0,0,0,,انظري
Dialogue: 0,0:20:38.09,0:20:40.53,Main,,0,0,0,,هذا السهم أطول من البقيّة
Dialogue: 0,0:20:40.76,0:20:45.39,Main,,0,0,0,,تزايدَ الضغطُ من هنا ممّا أدّى لاندفاع الماء بقوّةٍ
Dialogue: 0,0:20:45.89,0:20:48.85,Main,,0,0,0,,ملاحظاتكِ دقيقةٌ كما عهدتكِ يا أغوت
Dialogue: 0,0:20:51.40,0:20:53.65,Main,,0,0,0,,أرى أنَّ بإمكاني تركُها تحتَ رعايتكِ دون قلقٍ
Dialogue: 0,0:20:59.86,0:21:04.07,Main,,0,0,0,,سأذهب إلى قاعة السّحرة الكبرى ليومين أو ثلاثةٍ
Dialogue: 0,0:21:04.27,0:21:07.62,Main,,0,0,0,,أعتمد عليكِ للاعتناء بكوكو أثناء غيابي يا أغوت
Dialogue: 0,0:21:08.23,0:21:09.90,Main,,0,0,0,,حاضر يا سينسي
Dialogue: 0,0:21:11.00,0:21:12.51,Main,,0,0,0,,!تمهّل رجاءً
Dialogue: 0,0:21:12.51,0:21:14.93,Main,,0,0,0,,ستتعلّمين الكثير من زميلاتكِ
Dialogue: 0,0:21:14.93,0:21:17.66,Main,,0,0,0,,راقبيها وتعلّمي منها جيّدًا يا كوكو
Dialogue: 0,0:21:19.20,0:21:21.41,Main,,0,0,0,,...سـ-سينسي
Dialogue: 0,0:21:25.40,0:21:28.58,Main,,0,0,0,,...عفوًا، آسفةٌ حقًّا، أنا
Dialogue: 0,0:21:28.58,0:21:30.49,Main,,0,0,0,,لا داعي للاعتذار مرارًا
Dialogue: 0,0:21:30.49,0:21:32.40,Main,,0,0,0,,ألم أقل إنّي لم أنزعج؟
Dialogue: 0,0:21:33.54,0:21:35.27,Main,,0,0,0,,والآن يا كوكو
Dialogue: 0,0:21:36.67,0:21:40.06,Main,,0,0,0,,أخبرتكِ البارحة بأن تُثبتي ذلك
Dialogue: 0,0:21:40.75,0:21:43.43,Main,,0,0,0,,ولّى زمن الدّروس الهيِّنة
Dialogue: 0,0:21:44.18,0:21:46.31,Main,,0,0,0,,سيبدأ اختباركِ الآن
Comment: 0,0:21:48.26,0:21:50.26,Main,,0,0,0,,Notes
Dialogue: 0,0:00:27.96,0:00:30.76,Note,,0,0,0,,العربة المُجنّحة: وسيلة نقل سحريّة مستوحاة من الأساطير، تجرُّها خيول مُجنّحة قادرة على التحليق في أعالي السماء
Dialogue: 0,0:17:07.50,0:17:10.65,Note,,0,0,0,,المواد السّحريّة: الأدوات الأساسيّة الّتي يستخدمها الساحر لرسم التعاويذ، وتشمل الحبر والقلم والورق الخاصّ
Dialogue: 0,0:04:35.00,0:04:37.52,Note,,0,0,0,,قطرة ماءٍ طافية: تعويذة سحريّة تستخلص الماء من رطوبة الهواء وتجمعه في فقاعة طافية
Dialogue: 0,0:06:18.95,0:06:22.48,Note,,0,0,0,,الجاهل: مصطلحٌ يُطلق على عامّة البشر الّذين لا يملكون القدرة على استخدام السّحر ويجهلون حقيقته
Dialogue: 0,0:08:03.93,0:08:06.16,Note,,0,0,0,,يوم العهد: اليوم الّذي اتّحد فيه السّحرة وتعهّدوا بإخفاء حقيقة السّحر عن عامّة البشر لحمايتهم من مخاطره
Dialogue: 0,0:10:27.02,0:10:28.79,Note,,0,0,0,,نافذة عبور: أداةٌ سحريّةٌ تربط بين مكانين مختلفين عبر نافذتين تحملان النقش السّحريّ ذاته
Dialogue: 0,0:11:08.91,0:11:10.73,Note,,0,0,0,,اختبار الحكماء: اختبارٌ يفرضه الحكماء الأربعة الّذين يحرسون برج الكتب على السّحرة لإثبات جدارتهم بالدخول
Dialogue: 0,0:14:10.37,0:14:13.52,Note,,0,0,0,,ختم الإلقاء: الدائرة السّحريّة الّتي تُرسم لتفعيل السّحر، وتتكوّن من الرمز والأسهم والحلقة
Dialogue: 0,0:17:18.61,0:17:21.39,Note,,0,0,0,,عصا الحبر: قلمٌ خاصٌّ يستخدمه السّحرة لرسم التعاويذ السّحريّة بحبرٍ خاصٍّ
Dialogue: 0,0:12:50.09,0:12:53.79,Note,,0,0,0,,!ملاحظة: لا أعرف صراحةً إذا كيفري بيتحدث مع "المشرفة عليه" في مجلس السّحرة أو مع شخص آخر
Dialogue: 0,0:14:51.14,0:14:53.98,Note,,0,0,0,,‫ملاحظة: هذه ظاهرة تُسمّى "Jidoushou" يقوم فيها الطفل بالتحدث عن نفسه بصيغة الغائب مستخدمًا اسمه بدلًا من ضمير المتكلم "أنا"
Dialogue: 0,0:19:35.98,0:19:38.62,Note,,0,0,0,,المُهر "ابن الخيل"؛ يُولد وسيقانه طويلة ونحيلة، وحين يحاول الوقوف أول مرّة يترنح وتصطدم ركبتاه ببعضهما ويسقط مرارًا
