Dialogue: 0,0:00:05.77,0:00:09.04,Main,,0,0,0,,أيكون الرياضي رياضيًّا منذ ولادته؟
Dialogue: 0,0:00:10.16,0:00:12.69,Main,,0,0,0,,وماذا عن رواد الفضاء أو الآيدول؟
Dialogue: 0,0:00:14.14,0:00:16.25,Main,,0,0,0,,لا يسع المرء معرفة مستقبله عند ولادته
Dialogue: 0,0:00:17.50,0:00:20.38,Main,,0,0,0,,ولكن، ماذا عن السحرة؟
Dialogue: 0,0:01:22.06,0:01:23.59,Main,,0,0,0,,أعتذر عن الفوضى
Dialogue: 0,0:01:23.97,0:01:25.68,Main,,0,0,0,,أوشكتُ على الانتهاء من الغسيل
Dialogue: 0,0:01:29.27,0:01:30.81,Main,,0,0,0,,سيعود إلى طبيعته في لمح البصر
Dialogue: 0,0:01:31.49,0:01:34.23,Main,,0,0,0,,!فهذا الينبوع مفعمٌ بالسحر
Dialogue: 0,0:01:58.65,0:02:00.63,Main,,0,0,0,,يبدو آسرًا في كلّ مرّةٍ أراه فيها
Dialogue: 0,0:02:00.93,0:02:03.52,Main,,0,0,0,,!يا لروعة السحر
Dialogue: 0,0:02:07.18,0:02:12.93,Top,,0,0,0,,يزخر العالم بالسحر، فهو معجزةٌ لا غنى عنها
Dialogue: 0,0:02:15.18,0:02:17.46,Top,,0,0,0,,لكنَّ آليّة عمله مجهولة
Dialogue: 0,0:02:18.91,0:02:22.11,Top,,0,0,0,,،إنَّما السَّحرةُ من لديهم القدرة على تسخير السِّحر
Dialogue: 0,0:02:24.06,0:02:28.00,Main,,0,0,0,,أمّا البشر العاديون فلا يسعهم سوى التنعّم ببركاته
Dialogue: 0,0:02:29.40,0:02:31.39,Main,,0,0,0,,ما كلُّ امرئٍ بقادرٍ على أن يغدو ساحرًا
Dialogue: 0,0:02:34.51,0:02:38.23,Main,,0,0,0,,يا لحظّ من وُهِبَ السحرَ منذُ ولادته
Dialogue: 0,0:02:45.53,0:02:47.42,Main,,0,0,0,,...أيّتها الملاءات، أيّتها الملاءات
Dialogue: 0,0:02:47.42,0:02:50.75,Main,,0,0,0,,!آمُركِ أن تتحوّلي إلى عباءةٍ طائرة
Dialogue: 0,0:02:56.05,0:02:56.79,Main,,0,0,0,,!مهلًا
Dialogue: 0,0:02:56.80,0:02:58.95,Main,,0,0,0,,!لا، هذا ليس ما قصدتُه بالطيران
Dialogue: 0,0:03:15.90,0:03:17.26,Main,,0,0,0,,!إنّها عربةٌ مجنّحة
Dialogue: 0,0:03:31.06,0:03:33.57,Main,,0,0,0,,!هذه أولُ مرّةٍ أرى عربةً مُجنّحةً تحطُّ رحالها
Dialogue: 0,0:03:35.91,0:03:39.23,Main,,0,0,0,,!أمّي، ثمّة عربةٌ مجنّحةٌ في الخارج
Dialogue: 0,0:03:40.32,0:03:41.83,Main,,0,0,0,,!أمّي
Dialogue: 0,0:03:43.17,0:03:45.30,Main,,0,0,0,,!أمّي
Dialogue: 0,0:03:52.71,0:03:54.84,Main,,0,0,0,,!المعذرة، لم ألحظك
Dialogue: 0,0:03:55.17,0:03:58.68,Main,,0,0,0,,بأسَ عليكِ، الذنبُ ذنبي لوقوفي عند الباب
Dialogue: 0,0:03:58.83,0:04:00.75,Main,,0,0,0,,!عجبًا، لا أصدّق هذا
Dialogue: 0,0:04:00.83,0:04:03.59,Main,,0,0,0,,!انظري، لم أتوقّع العثور على شيءٍ كهذا هنا
Dialogue: 0,0:04:03.77,0:04:07.20,Main,,0,0,0,,عجبًا، أليسَ تطريزُ أوراق النَّفلة صيحةً قديمةً ولّتْ؟
Dialogue: 0,0:04:07.23,0:04:10.45,Main,,0,0,0,,دعكِ من ذلك وانظري، إنّه دانتيلٌ من نسيج هاريان
Dialogue: 0,0:04:10.51,0:04:14.27,Main,,0,0,0,,يا للروعة، رغم أنّه طار من أسواق بلدة القلعة قبل أن يرتدَّ طرفنا
Dialogue: 0,0:04:14.37,0:04:17.94,Top,,0,0,0,,أصبنا بالمجيء إلى هنا على متن العربة المجنّحة
Dialogue: 0,0:04:15.35,0:04:18.75,Main,,0,0,0,,!إنّهم من جاؤوا على متن العربة المجنّحة
Dialogue: 0,0:04:20.48,0:04:22.12,Main,,0,0,0,,كلّا، لستُ معهنّ
Dialogue: 0,0:04:22.63,0:04:25.72,Main,,0,0,0,,أيّتها الخيّاطة، ألديكِ المزيد من هذا الدانتيل؟
Dialogue: 0,0:04:25.81,0:04:27.46,Main,,0,0,0,,!أجل، سآتيكِ في الحال
Dialogue: 0,0:04:27.46,0:04:29.45,Top,,0,0,0,,!انظري، هذا ظريفٌ أيضًا
Dialogue: 0,0:04:28.44,0:04:30.54,Main,,0,0,0,,!كوكو، لا تقفي متفرجةً هكذا وهُبّي لمساعدتي
Dialogue: 0,0:04:30.67,0:04:31.69,Top,,0,0,0,,ما رأيكِ بهذا؟
Dialogue: 0,0:04:32.16,0:04:34.00,Main,,0,0,0,,أيُّ خدمةٍ تبغيها أيّها السيّد؟
Dialogue: 0,0:04:34.13,0:04:36.15,Main,,0,0,0,,أبتغي قماشًا دخاني اللون
Dialogue: 0,0:04:36.31,0:04:37.80,Main,,0,0,0,,‫وإن كنتما مشغولتين فسأعودُ لاحقًا
Dialogue: 0,0:04:37.80,0:04:39.72,Main,,0,0,0,,يسعني أخذ مقاساتك
Dialogue: 0,0:04:39.88,0:04:40.72,Main,,0,0,0,,أنتِ؟
Dialogue: 0,0:04:40.72,0:04:42.65,Main,,0,0,0,,كوكو بارعةٌ في ذلك
Dialogue: 0,0:04:42.01,0:04:43.55,Top,,0,0,0,,!إنّه بديع
Dialogue: 0,0:04:42.65,0:04:44.14,Top,,0,0,0,,!هذا صحيح
Dialogue: 0,0:04:47.25,0:04:49.85,Main,,0,0,0,,أيسعني الذهاب لرؤية العربة المجنّحة حينَ أنتهي؟
Dialogue: 0,0:04:49.85,0:04:51.17,Main,,0,0,0,,ماذا قلتِ؟
Dialogue: 0,0:04:51.26,0:04:52.77,Main,,0,0,0,,!ثمّة عربةٌ مجنّحةٌ في الخارج
Dialogue: 0,0:04:53.35,0:04:54.52,Main,,0,0,0,,عربةٌ مجنّحة؟
Dialogue: 0,0:04:54.52,0:04:57.55,Main,,0,0,0,,إيّاكِ والعبث بممتلكات الزبائن
Dialogue: 0,0:04:57.55,0:04:59.40,Main,,0,0,0,,!لا تقلقي، سأكتفي بالنظر
Dialogue: 0,0:05:01.77,0:05:05.33,Main,,0,0,0,,أعدكِ ألّا أردّد رغبتي في غدوي ساحرةً مجدّدًا
Dialogue: 0,0:05:09.53,0:05:11.87,Main,,0,0,0,,لا بأس إن أنهيتِ عملكِ باكرًا
Dialogue: 0,0:05:12.04,0:05:13.54,Main,,0,0,0,,!مرحى
Dialogue: 0,0:05:14.65,0:05:17.16,Main,,0,0,0,,أعتذرُ عن التأخير، هلّا أعطيتني القياسات؟
Dialogue: 0,0:05:17.60,0:05:18.40,Main,,0,0,0,,تفضّلي
Dialogue: 0,0:05:18.40,0:05:20.05,Main,,0,0,0,,سأتولّى الأمر
Dialogue: 0,0:06:02.44,0:06:05.80,Main,,0,0,0,,يا لتركيزكِ الوقّاد، كما أنَّ يديكِ بارعتانِ
Dialogue: 0,0:06:06.10,0:06:08.93,Main,,0,0,0,,...خطوطكِ خاليةٌ من التردّد، وقصُّكِ مُتقنٌ
Dialogue: 0,0:06:09.09,0:06:11.69,Main,,0,0,0,,والأبرزُ هو صنيعكِ المتقنُ الّذي ينمُّ عن دقةٍ مُتناهيةٍ
Dialogue: 0,0:06:12.35,0:06:15.49,Main,,0,0,0,,ما كنتُ لأحسبَ أنَّ في هذه القرية حرفيّةً بهذه البراعة
Dialogue: 0,0:06:17.09,0:06:18.57,Main,,0,0,0,,هذا السحر بحقّ
Dialogue: 0,0:06:19.94,0:06:21.74,Main,,0,0,0,,!لـ-لـ-لـ-لـ-لـ-لا
Dialogue: 0,0:06:21.79,0:06:24.24,Main,,0,0,0,,!عملي لا يمتّ للسحر بصلةٍ
Dialogue: 0,0:06:24.45,0:06:27.34,Main,,0,0,0,,،السحرُ أكثر غموضًا وبريقًا
Dialogue: 0,0:06:27.34,0:06:29.45,Main,,0,0,0,,!ونفيسٌ وآسرٌ للناظرين
Dialogue: 0,0:06:29.45,0:06:32.60,Main,,0,0,0,,...كما أنّه أكثر... أكثر
Dialogue: 0,0:06:33.02,0:06:36.58,Main,,0,0,0,,شيءٌ ثـ-ثمينٌ بحقّ
Dialogue: 0,0:06:37.05,0:06:39.31,Main,,0,0,0,,ما الّذي أقوله؟
Dialogue: 0,0:06:39.94,0:06:42.13,Main,,0,0,0,,تحبّين السحر حقًّا
Dialogue: 0,0:06:44.72,0:06:46.64,Main,,0,0,0,,هل لي أن أعرف السبب؟
Dialogue: 0,0:06:52.42,0:06:56.41,Main,,0,0,0,,،حين أخذتني أمّي إلى مهرجان القلعة في صغري
Dialogue: 0,0:06:57.10,0:07:00.15,Main,,0,0,0,,لَقيتُ ساحرًا يضعُ قناعًا على وجهه
Dialogue: 0,0:07:17.90,0:07:19.50,Main,,0,0,0,,أنتِ هناك
Dialogue: 0,0:07:21.05,0:07:23.72,Main,,0,0,0,,أما ترغبينَ في ابتياعِ كتابٍ سحريٍّ مُصوّر؟
Dialogue: 0,0:07:26.32,0:07:27.76,Main,,0,0,0,,سحريّ؟
Dialogue: 0,0:07:27.91,0:07:31.56,Main,,0,0,0,,أهوى الكتب المصوّرة، ولكن ما السحر؟
Dialogue: 0,0:07:32.01,0:07:36.07,Main,,0,0,0,,السحرُ مُعجزةٌ تكسو العالم بالألوان
Dialogue: 0,0:07:37.62,0:07:40.11,Main,,0,0,0,,كالعربات المجنّحة الّتي تحلّق في السماء
Dialogue: 0,0:07:40.11,0:07:43.15,Main,,0,0,0,,وينبوع كوون الّذي يحافظ على صفاء مياهه
Dialogue: 0,0:07:43.25,0:07:48.72,Main,,0,0,0,,وحتّى أحجارُ الرصيف الّتي تتلألأُ حين تطؤُها قدماكِ
Dialogue: 0,0:07:48.77,0:07:50.82,Main,,0,0,0,,كلُّ ذلكَ سِحرٌ
Dialogue: 0,0:07:53.07,0:07:54.55,Main,,0,0,0,,!يا لروعته
Dialogue: 0,0:07:55.05,0:07:56.72,Main,,0,0,0,,!السحر مذهل
Dialogue: 0,0:07:56.85,0:07:58.36,Main,,0,0,0,,!كوكو تحبّ السحر
Dialogue: 0,0:07:59.04,0:08:01.46,Main,,0,0,0,,كما تَصحبُهُ عصًا سحريّةٌ كعطيّةٍ مجّانيّة
Dialogue: 0,0:08:04.96,0:08:07.72,Main,,0,0,0,,أهكذا استدرجكِ لابتياعِ هذا الشيء؟
Dialogue: 0,0:08:08.21,0:08:10.67,Main,,0,0,0,,!رغم أنّكِ كنتِ تتوقينَ لتذوّقِ الفراولة المشويّة
Dialogue: 0,0:08:10.82,0:08:11.61,Main,,0,0,0,,...اسمعي
Dialogue: 0,0:08:11.76,0:08:15.30,Main,,0,0,0,,كنتُ أطاردُ فراشةً فإذ بي أُبصر شخصًا يعتمر قبّعةً مدبّبةً
Dialogue: 0,0:08:15.35,0:08:17.30,Main,,0,0,0,,قَصَصْتِ عليَّ هذا آنفًا
Dialogue: 0,0:08:17.40,0:08:21.73,Main,,0,0,0,,!أخبرتُكِ، إنّه كتابٌ سحريٌّ مصوّرٌ، ومعه عصًا هديّة
Dialogue: 0,0:08:24.10,0:08:26.39,Main,,0,0,0,,هيّا يا كوكو، لنعد إلى المنزل
Dialogue: 0,0:08:26.52,0:08:27.52,Main,,0,0,0,,فقد تأخّر الوقت
Dialogue: 0,0:08:27.63,0:08:28.73,Main,,0,0,0,,!أمّي
Dialogue: 0,0:08:29.48,0:08:34.99,Main,,0,0,0,,!حين تكبر كوكو، ستغدو ساحرةً تلوّنُ بأطيافِها الدُّنيا
Dialogue: 0,0:08:35.26,0:08:36.36,Main,,0,0,0,,!هذا مُحال
Dialogue: 0,0:08:36.38,0:08:37.55,Main,,0,0,0,,لماذا؟
Dialogue: 0,0:08:38.54,0:08:39.37,Main,,0,0,0,,...كوكو
Dialogue: 0,0:08:40.05,0:08:45.23,Main,,0,0,0,,لا يغدو المرء ساحرًا ما لم يُولَدْ مجبولًا بقوّة السحر
Dialogue: 0,0:08:45.88,0:08:49.77,Main,,0,0,0,,فعامّة البشر لا يملكون المقومات اللازمة ليكونوا سحرةً
Dialogue: 0,0:08:51.54,0:08:53.45,Main,,0,0,0,,هيّا يا كوكو، لنعد إلى المنزل
Dialogue: 0,0:08:53.45,0:08:54.47,Main,,0,0,0,,!لكن انظري
Dialogue: 0,0:08:55.12,0:08:57.72,Main,,0,0,0,,!تضيء الأرض حين تطأها كوكو
Dialogue: 0,0:09:00.86,0:09:01.76,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:09:01.95,0:09:05.07,Main,,0,0,0,,،لو قُدِّر لهذا الضوء ألّا ينطفئَ حتّى نبلغَ بيتنا
Dialogue: 0,0:09:05.63,0:09:08.09,Main,,0,0,0,,فلعلّكِ تُمسينَ قادرةً على إلقاء السحر أيضًا
Dialogue: 0,0:09:17.82,0:09:20.82,Main,,0,0,0,,ومُذ ذاك، وُلِعْتُ بمشاهدة السحر
Dialogue: 0,0:09:20.82,0:09:22.92,Main,,0,0,0,,أو بالأحرى، لم أقوَ على الاستسلام
Dialogue: 0,0:09:22.92,0:09:25.42,Main,,0,0,0,,...هلّا أخبرتني بالمزيد عمّا حدث
Dialogue: 0,0:09:26.96,0:09:28.35,Main,,0,0,0,,ما الأمر؟
Dialogue: 0,0:09:29.09,0:09:29.97,Main,,0,0,0,,كوكو؟
Dialogue: 0,0:09:30.12,0:09:32.49,Main,,0,0,0,,!مهلًا، اهدآ
Dialogue: 0,0:09:33.42,0:09:34.90,Main,,0,0,0,,!رُويدكما
Dialogue: 0,0:09:44.35,0:09:46.47,Main,,0,0,0,,حسبكما، ما الّذي فعلتماه؟
Dialogue: 0,0:09:46.60,0:09:48.43,Main,,0,0,0,,!اخرس، هذا مؤلم
Dialogue: 0,0:09:48.43,0:09:49.59,Main,,0,0,0,,هل أنتما بخير؟
Dialogue: 0,0:09:49.59,0:09:50.59,Main,,0,0,0,,كوكو
Dialogue: 0,0:09:50.59,0:09:52.05,Main,,0,0,0,,ماذا حدث؟
Dialogue: 0,0:09:52.22,0:09:54.27,Main,,0,0,0,,!تحطّمتْ من تلقاء نفسها دون أن نلمسها
Dialogue: 0,0:09:54.85,0:09:57.38,Main,,0,0,0,,!غير صحيح، بل زحفَ تانال تحتها
Dialogue: 0,0:09:57.50,0:09:58.79,Main,,0,0,0,,!لا تكن واشيًا
Dialogue: 0,0:09:58.79,0:10:01.37,Main,,0,0,0,,ارتطم رأسه بها فانقلبتْ
Dialogue: 0,0:10:01.55,0:10:03.64,Main,,0,0,0,,!يا للمصيبة
Dialogue: 0,0:10:04.06,0:10:06.04,Main,,0,0,0,,!انظرنَ ما حلَّ بعربتنا المجنّحة
Dialogue: 0,0:10:06.24,0:10:08.30,Main,,0,0,0,,!استعرتُها من والدي
Dialogue: 0,0:10:08.44,0:10:12.25,Main,,0,0,0,,!أعتذرُ إليكنَّ عمّا سبّبه أطفالُ القرية من متاعب
Dialogue: 0,0:10:12.46,0:10:14.27,Main,,0,0,0,,ا-اعتذاركِ لن يجدي نفعًا
Dialogue: 0,0:10:14.27,0:10:16.41,Main,,0,0,0,,!لا يسعنا العودة بلا عربةٍ
Dialogue: 0,0:10:16.69,0:10:18.31,Main,,0,0,0,,لا أدري كيف أصيغُ قولي
Dialogue: 0,0:10:19.37,0:10:20.46,Main,,0,0,0,,المعذرة
Dialogue: 0,0:10:22.73,0:10:24.23,Main,,0,0,0,,أترغبون في أن أُصلحها؟
Dialogue: 0,0:10:25.91,0:10:28.98,Main,,0,0,0,,لا يبدو الضرر جسيمًا
Dialogue: 0,0:10:28.98,0:10:31.23,Main,,0,0,0,,مهلًا، من أنت؟
Dialogue: 0,0:10:31.50,0:10:34.80,Main,,0,0,0,,عذرًا، نسيتُ ارتداء علامتي المميّزة
Dialogue: 0,0:10:41.21,0:10:44.43,Main,,0,0,0,,أنا الساحر كيفري
Dialogue: 0,0:10:47.38,0:10:49.23,Main,,0,0,0,,!قبّعة مُدبّبة
Dialogue: 0,0:10:49.75,0:10:51.00,Main,,0,0,0,,أيسعكَ إصلاحها؟
Dialogue: 0,0:10:51.26,0:10:52.28,Main,,0,0,0,,أجل
Dialogue: 0,0:10:52.38,0:10:54.78,Main,,0,0,0,,أنقذتنا أيّها الساحر
Dialogue: 0,0:10:54.95,0:10:55.97,Main,,0,0,0,,ليس بالأمر الجلل
Dialogue: 0,0:10:56.65,0:10:59.54,Main,,0,0,0,,سأكتفي بإعادة إلقاء السّحر على لوح العربة السفليّ
Dialogue: 0,0:10:59.55,0:11:01.59,Main,,0,0,0,,!أرجو منكَ ذلك
Dialogue: 0,0:11:01.78,0:11:03.19,Main,,0,0,0,,اعتمدي عليَّ
Dialogue: 0,0:11:03.33,0:11:05.61,Main,,0,0,0,,...غير أنَّ فعل ذلك في الخارج قد يكون
Dialogue: 0,0:11:05.79,0:11:07.81,Main,,0,0,0,,!يسعكَ استخدام ورشتنا
Dialogue: 0,0:11:07.84,0:11:08.71,Main,,0,0,0,,!كوكو
Dialogue: 0,0:11:09.04,0:11:10.61,Main,,0,0,0,,!أرجوكِ يا أمّي
Dialogue: 0,0:11:12.32,0:11:13.26,Main,,0,0,0,,...لأنّه
Dialogue: 0,0:11:13.89,0:11:15.86,Main,,0,0,0,,ساحرٌ حقيقيّ
Dialogue: 0,0:11:17.19,0:11:19.81,Main,,0,0,0,,...لعلّ الفرصة تلوحُ لي
Dialogue: 0,0:11:20.91,0:11:23.63,Main,,0,0,0,,لأبصرَ اللحظة الّتي يُلقى فيها السحر
Dialogue: 0,0:11:32.72,0:11:38.12,Main,,0,0,0,,أريدُكِ أن تقفي حارسةً للباب لئلّا يسترقَ أحدٌ النظر أثناء إلقائي للسحر
Dialogue: 0,0:11:38.69,0:11:41.14,Main,,0,0,0,,إيّاكِ والسماح لأحدٍ بالدخول مهما حدث
Dialogue: 0,0:11:41.35,0:11:42.18,Main,,0,0,0,,أهذا واضح؟
Dialogue: 0,0:11:45.34,0:11:47.77,Main,,0,0,0,,سُبلُ الحياة ليستْ معبّدةً بالورودِ دومًا
Dialogue: 0,0:11:48.94,0:11:51.77,Main,,0,0,0,,لكن، لِمَ لا يرغبُ في أن يرى أحدٌ ذلك؟
Dialogue: 0,0:11:52.73,0:11:55.97,Main,,0,0,0,,،رغم شيوعِ السحر في أرجاءِ العالم
Dialogue: 0,0:11:56.15,0:11:58.85,Main,,0,0,0,,إلّا أنّنا نجهل كيفيّة إلقائه
Dialogue: 0,0:11:59.52,0:12:01.66,Main,,0,0,0,,ذلكَ أمرٌ مقتصرٌ على معرفةِ السحرةِ دون غيرِهم
Dialogue: 0,0:12:02.41,0:12:03.82,Main,,0,0,0,,إنّه سرّ
Dialogue: 0,0:12:11.68,0:12:12.65,Main,,0,0,0,,!كدتُ أنزلق
Dialogue: 0,0:12:15.01,0:12:16.69,Main,,0,0,0,,مهلًا، ما الّذي تفعلانه؟
Dialogue: 0,0:12:16.70,0:12:17.55,Main,,0,0,0,,!كُشِفَ أمرنا
Dialogue: 0,0:12:17.68,0:12:19.30,Main,,0,0,0,,لا بأس إن كانت هي فحسب
Dialogue: 0,0:12:19.30,0:12:21.27,Main,,0,0,0,,أيسعنا اختلاس النظر من هنا يا ترى؟
Dialogue: 0,0:12:22.45,0:12:23.21,Main,,0,0,0,,!مهلًا
Dialogue: 0,0:12:23.21,0:12:24.83,Main,,0,0,0,,!اخفضي صوتكِ
Dialogue: 0,0:12:24.83,0:12:26.56,Main,,0,0,0,,!‫تنحّيا
Dialogue: 0,0:12:39.11,0:12:41.04,Main,,0,0,0,,!ماذا؟ كم هذا مُمِلّ
Dialogue: 0,0:12:40.88,0:12:42.49,Top,,0,0,0,,!أنتَ محقّ
Dialogue: 0,0:12:50.45,0:12:51.46,Main,,0,0,0,,!ماذا يحدث؟
Dialogue: 0,0:13:23.04,0:13:24.30,Main,,0,0,0,,!لا يجدر بي فعل هذا
Dialogue: 0,0:13:24.51,0:13:26.24,Main,,0,0,0,,!لكنّي أتوق لرؤيته
Dialogue: 0,0:13:26.40,0:13:27.12,Main,,0,0,0,,!لكن لا يجوز
Dialogue: 0,0:13:54.86,0:13:56.30,Main,,0,0,0,,...إنّه يرسم
Dialogue: 0,0:14:00.31,0:14:03.17,Main,,0,0,0,,السحر بقلمٍ؟
Dialogue: 0,0:14:05.17,0:14:09.25,Main,,0,0,0,,!إذن، لم تكن تلك عصًا
Dialogue: 0,0:14:11.01,0:14:15.14,Main,,0,0,0,,...السحر لا يُلقى
Dialogue: 0,0:14:16.87,0:14:18.06,Main,,0,0,0,,!بل يُرسم
Dialogue: 0,0:14:19.75,0:14:20.92,Main,,0,0,0,,حسنٌ
Dialogue: 0,0:14:20.92,0:14:22.97,Main,,0,0,0,,انتهيتُ يا كوكو
Dialogue: 0,0:14:31.51,0:14:32.35,Main,,0,0,0,,كوكو؟
Dialogue: 0,0:14:32.48,0:14:33.41,Main,,0,0,0,,بوركَ عملكَ
Dialogue: 0,0:14:52.25,0:14:54.78,Main,,0,0,0,,اطمأنَّ قلبي قليلًا
Dialogue: 0,0:14:55.87,0:14:57.95,Main,,0,0,0,,...لشدّة ولعكِ بالسحر
Dialogue: 0,0:14:58.62,0:15:01.06,Main,,0,0,0,,خامرني ظنٌّ بأنّكِ ستبدينَ رغبةً في الرحيل مع الساحر
Dialogue: 0,0:15:01.51,0:15:04.37,Main,,0,0,0,,أو هذا ما خلتُكِ ستقولينه
Dialogue: 0,0:15:06.16,0:15:08.55,Main,,0,0,0,,غيّبَ الموتُ والدكِ إثر مرضٍ
Dialogue: 0,0:15:09.00,0:15:13.06,Main,,0,0,0,,...وإن فارقتِني أنتِ الأخرى، فلن تقوى أمُّكِ
Dialogue: 0,0:15:13.42,0:15:16.79,Main,,0,0,0,,!لن أقول ذلك، فلا يسعني ترككِ وحيدةً يا أمّي
Dialogue: 0,0:15:20.32,0:15:24.04,Main,,0,0,0,,شكرًا لكِ، أنتِ فتاةٌ بارّةٌ يا كوكو
Dialogue: 0,0:15:42.31,0:15:43.59,Main,,0,0,0,,طابت ليلتكِ
Dialogue: 0,0:15:44.02,0:15:45.36,Main,,0,0,0,,طابت ليلتكِ
Dialogue: 0,0:15:45.65,0:15:46.71,Main,,0,0,0,,!كوكو
Dialogue: 0,0:15:49.68,0:15:52.22,Main,,0,0,0,,لا عليكِ، طابت ليلتكِ
Dialogue: 0,0:15:52.91,0:15:54.22,Main,,0,0,0,,طابت ليلتكِ
Dialogue: 0,0:16:02.73,0:16:05.99,Main,,0,0,0,,خامرني ظنٌّ بأنّكِ ستبدينَ رغبةً في الرحيل مع الساحر
Dialogue: 0,0:16:23.69,0:16:26.46,Main,,0,0,0,,،كلّ هذه النقوش المرسومة في كتاب السحر المُصوّر
Dialogue: 0,0:16:27.14,0:16:30.29,Main,,0,0,0,,ولم تكن العصا السحريّة مجرّد هديّة
Dialogue: 0,0:16:31.33,0:16:34.15,Main,,0,0,0,,!إنّما القلمُ هو العصا السحريّة بعينِها
Dialogue: 0,0:16:48.03,0:16:51.60,Main,,0,0,0,,...آسفةٌ يا أمّي، لن أذهب إلى أيّ مكانٍ
Dialogue: 0,0:16:52.16,0:16:53.22,Main,,0,0,0,,لكنّي سأجرّب فحسب
Dialogue: 0,0:17:43.20,0:17:43.89,Main,,0,0,0,,!عجبًا
Dialogue: 0,0:17:46.75,0:17:49.21,Main,,0,0,0,,!ماذا؟ لم يفلح الأمر
Dialogue: 0,0:17:49.28,0:17:52.47,Main,,0,0,0,,بالطبع لن يكون الأمر بهذه السهولة
Dialogue: 0,0:18:18.96,0:18:21.63,Main,,0,0,0,,!أضاء، ألقيتُ السحر حقًّا
Dialogue: 0,0:18:21.65,0:18:24.87,Main,,0,0,0,,!مذهل، إنّه سحرٌ، سحرٌ حقيقيٌّ، سحرٌ حقيقيٌّ
Dialogue: 0,0:18:24.87,0:18:26.01,Main,,0,0,0,,!ما العمل؟ ما العمل؟
Dialogue: 0,0:18:26.87,0:18:28.70,Main,,0,0,0,,!السحر يُرسم كما توقّعت
Dialogue: 0,0:18:28.83,0:18:31.59,Main,,0,0,0,,لكنّي مُنعتُ من النظر، هل سأُوبّخُ إن كُشِفَ أمري يا تُرى؟
Dialogue: 0,0:18:36.72,0:18:39.71,Main,,0,0,0,,لكنّي سأرسمُ واحدةً أخرى، واحدةً أخرى فحسب
Dialogue: 0,0:18:53.59,0:18:54.71,Main,,0,0,0,,...كتابٌ مصوّر
Dialogue: 0,0:18:55.12,0:18:56.37,Main,,0,0,0,,كتابٌ مصوّر إذن
Dialogue: 0,0:18:58.04,0:19:00.15,Main,,0,0,0,,ما زال الأمرُ يؤرّقُني حقًّا
Dialogue: 0,0:19:03.15,0:19:04.06,Main,,0,0,0,,...أيُعقل
Dialogue: 0,0:19:07.21,0:19:08.23,Main,,0,0,0,,!كانت تعويذة نارٍ
Dialogue: 0,0:19:08.24,0:19:10.02,Main,,0,0,0,,!كلّا، كلّا، إيّاكِ والاحتراق
Dialogue: 0,0:19:12.52,0:19:13.55,Main,,0,0,0,,كان ذلك وشيكًا
Dialogue: 0,0:19:15.12,0:19:15.87,Main,,0,0,0,,...لكن
Dialogue: 0,0:19:17.75,0:19:19.70,Main,,0,0,0,,أظنّني بدأتُ أفهمُ الأمر تدريجيًّا
Dialogue: 0,0:19:20.31,0:19:23.56,Main,,0,0,0,,الرسومُ الكبيرةُ أقوى من نظيراتِها الصغيرة
Dialogue: 0,0:19:23.56,0:19:26.89,Main,,0,0,0,,وتصمدُ المرسومة بإتقانٍ أمدًا أطول من الرديئة
Dialogue: 0,0:19:27.62,0:19:30.72,Main,,0,0,0,,رسمها بحجمٍ كبيرٍ وبإتقانٍ أمرٌ عسيرٌ
Dialogue: 0,0:19:31.02,0:19:33.40,Main,,0,0,0,,رغم أنّه رسمها بسلاسةٍ حينها
Dialogue: 0,0:19:34.25,0:19:35.07,Main,,0,0,0,,!وجدتُها
Dialogue: 0,0:19:40.12,0:19:41.75,Main,,0,0,0,,كما توقّعت
Dialogue: 0,0:19:41.90,0:19:45.53,Main,,0,0,0,,يسعني رسمها بشكلٍ بديعٍ إن اتّبعتُ الخطوط الأصليّة
Dialogue: 0,0:19:55.12,0:19:56.18,Main,,0,0,0,,!انتهيت
Dialogue: 0,0:20:17.07,0:20:18.11,Main,,0,0,0,,رسمتِ، أليس كذلك؟
Dialogue: 0,0:20:18.40,0:20:19.57,Main,,0,0,0,,ما الّذي رسمتِه؟
Dialogue: 0,0:20:19.71,0:20:21.24,Main,,0,0,0,,أيَّ سحرٍ رسمتِ؟
Dialogue: 0,0:20:21.58,0:20:22.63,Main,,0,0,0,,لا أدري
Dialogue: 0,0:20:22.95,0:20:24.79,Main,,0,0,0,,إنّما تتبّعتُ نقوش الكتاب ليس إلّا
Dialogue: 0,0:20:24.83,0:20:25.80,Main,,0,0,0,,كوكو؟
Dialogue: 0,0:20:28.74,0:20:29.67,Main,,0,0,0,,!أمّي
Dialogue: 0,0:20:34.15,0:20:35.11,Main,,0,0,0,,!كوكو؟
Dialogue: 0,0:20:35.76,0:20:36.80,Main,,0,0,0,,!اهربي
Dialogue: 0,0:20:42.80,0:20:44.85,Main,,0,0,0,,...مُحال... لا يُعقل
Dialogue: 0,0:20:45.47,0:20:49.14,Main,,0,0,0,,!أمّي، أمّي، أمّي
Dialogue: 0,0:20:49.14,0:20:50.53,Top,,0,0,0,,!أمّي
Dialogue: 0,0:20:49.23,0:20:51.13,Main,,0,0,0,,!هذا... سحرٌ محرّم
Dialogue: 0,0:20:50.92,0:20:52.23,Top,,0,0,0,,!لا، أفلتني
Dialogue: 0,0:20:52.23,0:20:54.51,Top,,0,0,0,,!أفلتني، أفلتني
Dialogue: 0,0:20:52.23,0:20:54.79,Main,,0,0,0,,!كلّا، ستعلقين فيه أنتِ أيضًا
Dialogue: 0,0:20:54.55,0:20:56.08,Top,,0,0,0,,!عليَّ إنقاذ أمّي
Dialogue: 0,0:20:55.93,0:20:57.76,Main,,0,0,0,,!لا طائل من ذلك، فهو سحرٌ
Dialogue: 0,0:20:57.77,0:20:58.83,Main,,0,0,0,,وخبيثٌ أيضًا
Dialogue: 0,0:20:58.98,0:21:00.12,Main,,0,0,0,,!ويحي
Dialogue: 0,0:21:05.53,0:21:06.17,Main,,0,0,0,,!كوكو
Dialogue: 0,0:21:06.17,0:21:07.56,Main,,0,0,0,,!أمّي
Dialogue: 0,0:21:09.21,0:21:10.94,Main,,0,0,0,,!لا
Dialogue: 0,0:21:15.68,0:21:19.43,Main,,0,0,0,,آسفة، لم أكن أعلم شيئًا
Dialogue: 0,0:21:19.83,0:21:21.48,Main,,0,0,0,,من البديهي ألّا تعلمي
Dialogue: 0,0:21:22.16,0:21:24.72,Main,,0,0,0,,ظلَّ الأمرُ طيَّ الكتمانِ لتفادي وقوعِ حوادثَ كهذه
Dialogue: 0,0:21:25.54,0:21:29.13,Main,,0,0,0,,حبرٌ خاصٌّ، ودوائر سحريّةٌ محدّدة
Dialogue: 0,0:21:29.20,0:21:31.97,Main,,0,0,0,,سيغدو بمقدور أيٍّ كان إلقاء السحر إن توفّرا
Dialogue: 0,0:21:31.97,0:21:34.73,Main,,0,0,0,,إنّه السرّ المطلق للسحرة
Dialogue: 0,0:21:35.52,0:21:39.24,Main,,0,0,0,,وبما أنّكِ عرفتِه، فسيتحتّمُ عليَّ محو ذكرياتكِ
Dialogue: 0,0:21:43.04,0:21:44.45,Main,,0,0,0,,!لا تفعل
Dialogue: 0,0:21:44.45,0:21:48.12,Main,,0,0,0,,!من سينقذ أمّي إن مُحيتْ ذكرياتي؟
Dialogue: 0,0:21:48.90,0:21:50.62,Main,,0,0,0,,...يُؤسفني هذا، ولكن
Dialogue: 0,0:21:51.26,0:21:53.25,Main,,0,0,0,,،لا أذكر السحر الّذي رسمتُه
Dialogue: 0,0:21:53.39,0:21:56.16,Main,,0,0,0,,!لكنّي حفظتُ محتوى الكتاب المصوّر عن ظهر قلب
Dialogue: 0,0:21:56.16,0:21:58.68,Main,,0,0,0,,...وإن نسيتُ ذلك، فأمّي
Dialogue: 0,0:21:59.94,0:22:01.13,Main,,0,0,0,,كتابٌ مصوّر؟
Dialogue: 0,0:22:01.67,0:22:03.03,Main,,0,0,0,,!فهمت
Dialogue: 0,0:22:03.03,0:22:06.93,Main,,0,0,0,,!إن كان ذلك الكتاب المصوّر ملكًا لهم، فسأفقد أثرهم
Dialogue: 0,0:22:07.75,0:22:11.09,Main,,0,0,0,,!وإن محوتُ ذكرياتها، فسينقطعُ السبيل إليهم
Dialogue: 0,0:22:12.18,0:22:14.38,Main,,0,0,0,,تذكرين أيَّ نوع من الكتب كان، أليس كذلك؟
Dialogue: 0,0:22:14.49,0:22:15.06,Main,,0,0,0,,أجل
Dialogue: 0,0:22:15.68,0:22:17.59,Main,,0,0,0,,وفي أيِّ صفحةٍ كُتب ذلك؟
Dialogue: 0,0:22:17.69,0:22:19.25,Main,,0,0,0,,أجل، أجل
Dialogue: 0,0:22:21.13,0:22:24.22,Main,,0,0,0,,إن عثرنا على الكتاب ذاته، فسنجد الدائرة السحريّة
Dialogue: 0,0:22:26.95,0:22:31.37,Main,,0,0,0,,أيسعنا إنقاذ أمّي إن عرفنا الدائرة السحريّة؟
Dialogue: 0,0:22:33.96,0:22:35.26,Main,,0,0,0,,...لعلّ أملَ إنقاذها
Dialogue: 0,0:22:35.76,0:22:37.06,Main,,0,0,0,,لم ينقطعْ بعدُ
Dialogue: 0,0:22:37.73,0:22:38.96,Main,,0,0,0,,!كيفري-سان
Dialogue: 0,0:22:39.74,0:22:45.36,Main,,0,0,0,,!أرجوكَ لا تمحُ ذكرياتي، سأفعل أيّ شيءٍ لإنقاذ أمّي
Dialogue: 0,0:22:47.30,0:22:49.18,Main,,0,0,0,,أيسعكِ كتمان السرّ؟
Dialogue: 0,0:22:49.18,0:22:50.46,Main,,0,0,0,,!بالطبع
Dialogue: 0,0:22:52.04,0:22:53.85,Main,,0,0,0,,ألديكِ الإرادة للتعلّم؟
Dialogue: 0,0:22:53.85,0:22:55.87,Main,,0,0,0,,أتعلّم؟
Dialogue: 0,0:22:56.33,0:22:59.10,Main,,0,0,0,,متى ما تبيّنتْ الحقيقةُ، استحالَ مَحوها
Dialogue: 0,0:22:59.25,0:23:02.86,Main,,0,0,0,,لذا، عليكِ أن تغدي من العارفين بالسرّ
Dialogue: 0,0:23:03.44,0:23:06.75,Main,,0,0,0,,هذا سبيلُكِ الوحيدُ لتصوني ذكرياتكِ
Dialogue: 0,0:23:08.16,0:23:09.35,Main,,0,0,0,,...كوكو
Dialogue: 0,0:23:09.35,0:23:10.88,Main,,0,0,0,,...من الآن فصاعدًا
Dialogue: 0,0:23:12.50,0:23:14.51,Main,,0,0,0,,ستغدينَ ساحرة
