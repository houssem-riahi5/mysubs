Dialogue: 0,0:00:11.23,0:00:12.37,Main,RESISTANCE MEMBER 1,0,0,0,,!لم يُؤثّر فيه البتّة
Dialogue: 0,0:00:12.37,0:00:15.49,Main,RESISTANCE MEMBER 2,0,0,0,,!مُحالٌ القضاء على كائنٍ كهذا
Dialogue: 0,0:00:18.01,0:00:22.90,Main,MEREOLEONA,0,0,0,,في تلك اللحظة، أدركتُ وجود كيانٍ لا يُجدي سحري أمامه
Dialogue: 0,0:00:30.61,0:00:32.21,Main,MEREOLEONA,0,0,0,,...أجهلُ هويّتكَ، ولكن
Dialogue: 0,0:00:36.41,0:00:37.59,Main,MEREOLEONA,0,0,0,,ما غايتكَ؟
Dialogue: 0,0:00:38.87,0:00:41.69,Main,NACHT,0,0,0,,...أنتِ جامحةٌ حقًّا كما تصفكِ الشائعات، ولكن
Dialogue: 0,0:00:41.69,0:00:43.90,Main,NACHT,0,0,0,,هلّا ارتديتِ ثيابكِ أولًا؟
Dialogue: 0,0:00:45.58,0:00:47.66,Main,MEREOLEONA,0,0,0,,تبدو مثيرًا للاهتمام
Dialogue: 0,0:00:47.71,0:00:49.56,Main,MEREOLEONA,0,0,0,,هلّا تبارزنا قليلًا؟
Dialogue: 0,0:00:49.70,0:00:51.36,Main,NACHT,0,0,0,,أرفض رفضًا قاطعًا
Dialogue: 0,0:00:53.24,0:00:54.99,Main,MEREOLEONA,0,0,0,,!يامي وفانجانس إذن
Dialogue: 0,0:00:55.34,0:00:58.89,Main,MEREOLEONA,0,0,0,,،لا أبالي باختطاف هذين المأفونين
Dialogue: 0,0:00:58.89,0:01:01.08,Main,MEREOLEONA,0,0,0,,لكنّي مهتمّةٌ بمن اختطفهم
Dialogue: 0,0:01:02.76,0:01:07.78,Main,NACHT,0,0,0,,سأهيّئ لكِ الغريم الأمثل لاختبار ثمار تدريبكِ
Dialogue: 0,0:01:12.91,0:01:13.98,Main,MEREOLEONA,0,0,0,,...هذا حقًّا
Dialogue: 0,0:01:15.07,0:01:16.37,Main,MEREOLEONA,0,0,0,,!ممتعٌ للغاية
Dialogue: 0,0:01:21.02,0:01:23.67,Main,MEREOLEONA/I,0,0,0,,!أيقنتُ أنّي قادرةٌ على أن أزداد قوّةً
Dialogue: 0,0:01:25.48,0:01:26.94,Main,MEREOLEONA,0,0,0,,...سحر النّار
Dialogue: 0,0:01:34.58,0:01:36.08,Main,MEREOLEONA,0,0,0,,!تجسّد نيران الجحيم
Dialogue: 0,0:01:39.30,0:01:41.00,Main,ALBERT,0,0,0,,!يا لها من مانا مهولة
Dialogue: 0,0:01:41.64,0:01:45.79,Main,ALBERT,0,0,0,,!وكأنّ جسدها غدا المانا بعينها
Dialogue: 0,0:02:00.48,0:02:03.62,Main,MEREOLEONA,0,0,0,,،كبدايةٍ لإحراق كلّ شيء
Dialogue: 0,0:02:03.62,0:02:06.44,Main,MEREOLEONA,0,0,0,,!سأسحقُ أسطورةً اليوم
Dialogue: 0,0:02:27.38,0:02:29.88,Main,MEREOLEONA,0,0,0,,!نطاق المانا؛ إطلاق كامل
Dialogue: 0,0:02:33.83,0:02:38.10,Main,MEREOLEONA,0,0,0,,!كاليدوس براكيوم؛ برزخ الهاوية
Dialogue: 0,0:02:47.64,0:02:49.37,Main,MEREOLEONA,0,0,0,,،عُدْ إلى سباتك
Dialogue: 0,0:02:50.08,0:02:53.30,Main,MEREOLEONA,0,0,0,,!وليكن أبديًّا هذه المرّة
Dialogue: 0,0:04:28.40,0:04:33.00,Main,ZENON,0,0,0,,لم تكن الفئران المتسلّلة من المقاومة إذن
Dialogue: 0,0:04:33.44,0:04:36.76,Main,ZENON,0,0,0,,لِمَ لا تزال على قيد الحياة؟
Dialogue: 0,0:04:37.01,0:04:39.70,Main,YUNO,0,0,0,,!بفضل سحر القائد فانجانس
Dialogue: 0,0:04:40.17,0:04:42.02,Main,YUNO,0,0,0,,...سنستعيد القائد
Dialogue: 0,0:04:42.76,0:04:44.72,Main,YUNO,0,0,0,,!بعد أن نسحقك
Dialogue: 0,0:04:46.59,0:04:48.64,Main,YUNO,0,0,0,,أدركُ حقيقة قدراته؛
Dialogue: 0,0:04:49.04,0:04:51.21,Main,YUNO,0,0,0,,،دفاعٌ مطلقٌ بسحر العظام
Dialogue: 0,0:04:51.60,0:04:54.26,Main,YUNO,0,0,0,,،وصلابةٌ وسرعة تجدّدٍ كاسحتان
Dialogue: 0,0:04:54.26,0:04:56.90,Main,YUNO,0,0,0,,ولا تُجدي معظم الهجمات الجسديّة نفعًا ضدّه
Dialogue: 0,0:04:57.61,0:05:00.69,Main,ZENON,0,0,0,,هكذا إذن، يا لحماقتك
Dialogue: 0,0:05:01.18,0:05:03.13,Main,ZENON,0,0,0,,...لو لزمتَ مملكتكَ صامتًا
Dialogue: 0,0:05:03.13,0:05:05.91,Main,ZENON,0,0,0,,لعشتَ أطول قليلًا
Dialogue: 0,0:05:06.38,0:05:11.17,Main,LANGRIS,0,0,0,,سمعتُ أنّكَ عثتَ فسادًا كما يحلو لكَ في غيابي
Dialogue: 0,0:05:11.62,0:05:16.30,Main,LANGRIS,0,0,0,,!لستُ ممّن يقفون مكتوفي الأيدي أمام وغدٍ مثلك
Dialogue: 0,0:05:16.30,0:05:18.48,Main,LANGRIS,0,0,0,,!سقوط رئيس الملائكة
Dialogue: 0,0:05:19.09,0:05:21.09,Main,ZENON,0,0,0,,!ساحرٌ مكانيّ إذن
Dialogue: 0,0:05:24.51,0:05:27.97,Main,YUNO,0,0,0,,،فضلًا عن ذلك، يملك فضاءً مطلقًا بقوى الشيطان
Dialogue: 0,0:05:28.63,0:05:30.77,Main,YUNO,0,0,0,,،يُحكِم سيطرته التامّة على مانا المكان
Dialogue: 0,0:05:30.77,0:05:34.25,Main,YUNO,0,0,0,,ويقمع تحكّم خصمه بالمانا تمامًا
Dialogue: 0,0:05:34.96,0:05:39.99,Main,ZENON,0,0,0,,لكنتَ أقوى ساحرٍ مكانيٍّ لولا وجودي
Dialogue: 0,0:05:39.99,0:05:44.85,Main,LANGRIS,0,0,0,,مضت فترةٌ طويلةٌ مُنذ أن صادفتُ من يتحدّث معي بتطاولٍ
Dialogue: 0,0:05:45.20,0:05:49.20,Main,LANGRIS,0,0,0,,سحر المكان؛ إبادة رئيس الملائكة
Dialogue: 0,0:05:49.81,0:05:55.81,Main,ZENON,0,0,0,,...أدركُ أنّك أُرسلتَ لمجابهة سحري المكانيّ، ولكن
Dialogue: 0,0:05:56.11,0:06:00.42,Main,ZENON,0,0,0,,سحر المكان؛ الهيمنة المكانيّة
Dialogue: 0,0:06:03.32,0:06:08.93,Main,LANGRIS,0,0,0,,!لا يسع المرء حتّى الحفاظ على سحره داخل هذا الفضاء
Dialogue: 0,0:06:09.71,0:06:12.18,Main,LANGRIS,0,0,0,,!كلّ هذا النطاق الشاسع دون أن يحرّك ساكنًا؟
Dialogue: 0,0:06:12.86,0:06:14.75,Main,LANGRIS,0,0,0,,أجرفتكَ مشاعرك؟
Dialogue: 0,0:06:14.75,0:06:18.68,Main,LANGRIS,0,0,0,,مرافقة من تجرّع مرارة الهزيمة سابقًا قمّةُ الحماقة
Dialogue: 0,0:06:19.22,0:06:23.95,Main,LANGRIS,0,0,0,,أنتَ كقائدكَ تمامًا؛ تتخذ خياراتٍ حمقاء
Dialogue: 0,0:06:24.43,0:06:26.84,Main,ZENON,0,0,0,,كبرياءٌ وأحلامٌ جوفاء
Dialogue: 0,0:06:26.84,0:06:29.33,Main,ZENON,0,0,0,,...تمسّككما بمثل هذه الترهات
Dialogue: 0,0:06:29.69,0:06:34.37,Main,ZENON,0,0,0,,هو ما سيرديكما قتلى دون أن تُزحزحاني خطوةً واحدةً
Dialogue: 0,0:06:36.39,0:06:38.45,Main,YUNO,0,0,0,,!هيّا بنا يا بيل
Dialogue: 0,0:06:42.12,0:06:44.59,Main,BELL,0,0,0,,!ها أنتَ ذا أيّها الهيكل العظمي البغيض
Dialogue: 0,0:06:49.98,0:06:53.00,Main,BELL,0,0,0,,!لن أغفرَ لكَ ما فعلته آنذاك
Dialogue: 0,0:06:53.93,0:06:56.79,Main,BELL,0,0,0,,!سنهزمكَ أنا ويونو حتمًا
Dialogue: 0,0:06:59.09,0:07:00.90,Main,YUNO,0,0,0,,!غوص الأرواح
Dialogue: 0,0:07:08.03,0:07:10.47,Main,YUNO,0,0,0,,!روح بورياس
Dialogue: 0,0:07:11.35,0:07:15.29,Main,ZENON,0,0,0,,!ما هذا الضغط وهيئة ذلك السّحر؟
Dialogue: 0,0:07:15.60,0:07:19.79,Main,ZENON,0,0,0,,لكن يستحيل إطلاق أيّ قوّةٍ داخل هذا الفضاء
Dialogue: 0,0:07:20.07,0:07:22.55,Main,YUNO,0,0,0,,!أنا من سيغدو إمبراطور السّحر
Dialogue: 0,0:07:23.04,0:07:26.43,Main,YUNO,0,0,0,,!لن أرضى بالبقاء مهزومًا أمامك
Dialogue: 0,0:07:27.74,0:07:31.13,Main,ZENON,0,0,0,,!أعجزُ عن التحكّم بالمانا داخل الفضاء المُطلق
Dialogue: 0,0:07:31.13,0:07:34.31,Main,ZENON,0,0,0,,أيهيمن عليها بقوّةٍ أعتى؟
Dialogue: 0,0:07:34.77,0:07:36.81,Main,ZENON,0,0,0,,...كلّا، بل هو
Dialogue: 0,0:07:38.87,0:07:41.32,Main,ZENON,0,0,0,,!محبوبٌ من المانا
Dialogue: 0,0:07:45.04,0:07:48.82,Main,YUNO,0,0,0,,"سنفنى دون أن نُجبرك على التزحزح خطوةً واحدةً"
Dialogue: 0,0:07:48.82,0:07:50.20,Main,YUNO,0,0,0,,أهذا ما قلته؟
Dialogue: 0,0:07:58.06,0:07:59.33,Main,YUNO,0,0,0,,من سيهلك؟
Dialogue: 0,0:07:59.71,0:08:04.08,Main,YUNO,0,0,0,,!فلتفْنَ نادمًا على تطاولكَ على الفجر الذهبيّ
Dialogue: 0,0:08:05.51,0:08:09.51,Main,LANGRIS,0,0,0,,تمقتُ الهزيمة كالموت تمامًا أنتَ أيضًا
Dialogue: 0,0:08:10.60,0:08:11.60,Main,LANGRIS,0,0,0,,!يسعنا فعلها
Dialogue: 0,0:08:11.83,0:08:14.47,Main,LANGRIS,0,0,0,,،سنهزمه ونوقف هبوط كليفوث
Dialogue: 0,0:08:15.17,0:08:17.50,Main,LANGRIS,0,0,0,,!ونُنقذ القائد فانجانس
Dialogue: 0,0:08:23.81,0:08:28.24,Main,VANICA,0,0,0,,قيل إنَّ ثمّة دخلاء، لكن لا أثر للظريفة نويل-تشان بينكما
Dialogue: 0,0:08:28.64,0:08:33.49,Main,VANICA,0,0,0,,أرِيَاني إن كان القتال معكما ممتعًا أم لا
Dialogue: 0,0:08:34.30,0:08:35.49,Main,VANICA,0,0,0,,...مبدئيًّا
Dialogue: 0,0:08:35.65,0:08:38.90,Main,VANICA,0,0,0,,لا طائل من الحديث معكما إن عجزتما عن هزمهما
Dialogue: 0,0:08:40.07,0:08:41.87,Main,CHARLOTTE,0,0,0,,سحر تكوين العليق؛
Dialogue: 0,0:08:42.23,0:08:43.88,Main,CHARLOTTE,0,0,0,,أشجار عليق صيد الجثث
Dialogue: 0,0:08:44.31,0:08:45.25,Main,VANICA,0,0,0,,...مع ذلك
Dialogue: 0,0:08:45.25,0:08:49.55,Main,VANICA,0,0,0,,أظنّهما قويّين للغاية بفضل تعديلات موريس ولعنتي
Dialogue: 0,0:08:54.76,0:08:55.97,Main,RILL,0,0,0,,سحر الرسم؛
Dialogue: 0,0:08:56.93,0:08:58.97,Main,RILL,0,0,0,,تموّج باطن الأرض
Dialogue: 0,0:08:59.69,0:09:01.87,Main,RILL,0,0,0,,مداعبة الحوريات
Dialogue: 0,0:09:10.90,0:09:15.17,Main,VANICA,0,0,0,,...استحضار شتّى العناصر بسحر الرسم أمرٌ ممتع، ولكن
Dialogue: 0,0:09:15.17,0:09:17.49,Main,VANICA,0,0,0,,أهذا كلّ ما لديكَ يا ترى؟
Dialogue: 0,0:09:17.75,0:09:21.02,Main,VANICA,0,0,0,,،أمّا سحر العليق فميؤوسٌ منه تمامًا
Dialogue: 0,0:09:21.02,0:09:24.52,Main,VANICA,0,0,0,,وبمعزلٍ عن التوافق، تبدين عبئًا يُعيقه فحسب
Dialogue: 0,0:09:26.27,0:09:30.40,Main,VANICA,0,0,0,,،تمنّيتُ لو نازلتُ ذلك القزم ذا سحر إلغاء السّحر الّذي أطاح بأخي دانتي
Dialogue: 0,0:09:30.40,0:09:33.83,Main,VANICA,0,0,0,,وذاك الكهل مستخدم سحر الظلام
Dialogue: 0,0:09:34.26,0:09:37.61,Main,VANICA,0,0,0,,أردتُ جعلهما دميتين لألهو بهما
Dialogue: 0,0:09:37.61,0:09:41.65,Main,VANICA,0,0,0,,،لكن بموته ستُفتح بوابة العالم السفليّ
Dialogue: 0,0:09:41.65,0:09:43.23,Main,VANICA,0,0,0,,لذا سأتحلّى بالصبر
Dialogue: 0,0:09:43.48,0:09:47.11,Main,VANICA,0,0,0,,،على أيّ حال، استطاع زينون أسره
Dialogue: 0,0:09:47.32,0:09:50.18,Main,VANICA,0,0,0,,لعلّه لم يكن بتلك القوّة
Dialogue: 0,0:09:53.01,0:09:56.70,Main,CHARLOTTE,0,0,0,,،طيلة الأشهر الستّة الماضية، وإلى جانب مهامي القياديّة
Dialogue: 0,0:09:56.78,0:09:59.78,Main,CHARLOTTE,0,0,0,,عكفتُ على دراسة طريقة مانا مملكة هارت
Dialogue: 0,0:10:00.25,0:10:03.45,Main,POTROF,0,0,0,,!شارلوت-سان عبقريّةٌ حقًّا
Dialogue: 0,0:10:04.47,0:10:08.29,Main,MEMBER 1,0,0,0,,أتدرس القائدة تلك المصفوفات مجدّدًا؟
Dialogue: 0,0:10:08.38,0:10:11.42,Main,MEMBER 2,0,0,0,,!إنّها جادّةٌ بطبعها، لذا لا تعرف متى تتوقّف
Dialogue: 0,0:10:11.42,0:10:15.43,Main,CHARLOTTE,0,0,0,,،رغم قوّة اللعنة الّتي كبّلتْ سحري
Dialogue: 0,0:10:15.89,0:10:19.68,Main,CHARLOTTE,0,0,0,,...لكنّي طوّعتُها وسخّرتُها لصالحي
Dialogue: 0,0:10:20.21,0:10:22.09,Main,CHARLOTTE,0,0,0,,أو هكذا خِلتُ، غير أنّي كنتُ مخطئةً
Dialogue: 0,0:10:23.10,0:10:26.93,Main,CHARLOTTE,0,0,0,,كانت اللعنة قيدًا باطشًا يُكبّل سحري
Dialogue: 0,0:10:27.00,0:10:32.94,Main,CHARLOTTE,0,0,0,,!وبإتقان طريقة المانا، استنبطتُ الاستخدام الحقيقيّ للعليق الملعون
Dialogue: 0,0:10:33.24,0:10:34.90,Main,CHARLOTTE,0,0,0,,...قالت لي دوروثي
Dialogue: 0,0:10:35.37,0:10:39.29,Main,DOROTHY,0,0,0,,،سحر اللعنات في هذا العالم منبثقٌ من ميغيكيولا
Dialogue: 0,0:10:39.29,0:10:42.04,Main,DOROTHY,0,0,0,,وميغيكيولا هي أصل اللعنات قاطبةً
Dialogue: 0,0:10:43.46,0:10:46.53,Main,CHARLOTTE,0,0,0,,...بسببكِ أنتِ
Dialogue: 0,0:10:49.06,0:10:51.01,Main,CHARLOTTE,0,0,0,,!ازددتُ قوّةً تفوق الوصف
Dialogue: 0,0:10:52.24,0:10:55.89,Main,RILL,0,0,0,,...نشرتْ طريقة المانا داخل تعاويذي
Dialogue: 0,0:10:57.94,0:11:01.79,Main,RILL,0,0,0,,أترى تربة المانا والماء العذب ساعدا على نموّها؟
Dialogue: 0,0:11:02.13,0:11:04.94,Main,CHARLOTTE,0,0,0,,طريقة المانا؛ سحر العليق المُطوّر
Dialogue: 0,0:11:07.00,0:11:08.72,Main,CHARLOTTE,0,0,0,,فردوس الورود الزرقاء
Dialogue: 0,0:11:11.22,0:11:13.94,Main,CHARLOTTE,0,0,0,,،كلّما اشتدت لعنة العدو ضراوةً
Dialogue: 0,0:11:13.94,0:11:17.24,Main,CHARLOTTE,0,0,0,,امتصّت تلك اللعنة لتتفتّح بجمالٍ آسر
Dialogue: 0,0:11:17.45,0:11:21.01,Main,VANICA,0,0,0,,أتتلاشى قوّة اللعنة المفروضة عليهما؟
Dialogue: 0,0:11:22.33,0:11:23.72,Main,MEGICULA,0,0,0,,...تلك البشريّة
Dialogue: 0,0:11:23.72,0:11:26.72,Main,MEGICULA,0,0,0,,،حرّفت اللعنة الواقعة عليها
Dialogue: 0,0:11:26.72,0:11:29.84,Main,MEGICULA,0,0,0,,وسخّرتها كسحرٍ مضادٍّ للعنات؟
Dialogue: 0,0:11:30.32,0:11:33.65,Main,MEGICULA,0,0,0,,...أن يوجد من يقدر على هذا
Dialogue: 0,0:11:33.65,0:11:34.90,Main,MEGICULA,0,0,0,,!أمرٌ مثيرٌ للاهتمام حقًّا
Dialogue: 0,0:11:37.79,0:11:41.29,Main,CHARLOTTE,0,0,0,,،صقْل مهاراتي مع فرسان السّحر
Dialogue: 0,0:11:42.04,0:11:43.65,Main,CHARLOTTE,0,0,0,,،وتناسخ الإلف
Dialogue: 0,0:11:44.43,0:11:46.88,Main,CHARLOTTE,0,0,0,,...وطريقة مانا مملكة هارت
Dialogue: 0,0:11:48.08,0:11:51.62,Main,CHARLOTTE,0,0,0,,!غدا كلّ ما مضى زادًا أمدّ سحري بالقوّة
Dialogue: 0,0:11:53.16,0:11:56.25,Main,CHARLOTTE,0,0,0,,،هذا وردي الأزرق الراهن
Dialogue: 0,0:11:56.25,0:11:57.82,Main,CHARLOTTE,0,0,0,,...وهذا
Dialogue: 0,0:12:01.53,0:12:04.20,Main,CHARLOTTE,0,0,0,,!وردي الأحمر الأصيل
Dialogue: 0,0:12:05.37,0:12:11.13,Main,CHARLOTTE,0,0,0,,!يسعني الآن تسخير الورود الزرقاء والحمراء معًا
Dialogue: 0,0:12:11.35,0:12:14.82,Main,CHARLOTTE,0,0,0,,سحر العليق الحقيقيّ؛ ملكة العليق
Dialogue: 0,0:12:15.86,0:12:19.84,Main,CHARLOTTE,0,0,0,,...سأنقذك وأُريكَ القوّة الّتي بلغتُها
Dialogue: 0,0:12:20.57,0:12:21.56,Main,CHARLOTTE,0,0,0,,!يا يامي
Dialogue: 0,0:12:22.33,0:12:27.59,Main,RILL,0,0,0,,!أغدت شارلوت-سان قائدةً دون أن تطلق سحرها الأصليّ حتّى؟
Dialogue: 0,0:12:33.36,0:12:36.65,Main,VANICA,0,0,0,,!عثرتُ على الغريم المثالي
Dialogue: 0,0:12:38.61,0:12:42.24,Main,CHARLOTTE,0,0,0,,يؤسفني إخباركِ بأنّي لن أنازلكِ أصلًا
Dialogue: 0,0:12:42.24,0:12:43.92,Main,VANICA,0,0,0,,!ما الّذي تهذين به؟
Dialogue: 0,0:12:43.92,0:12:46.79,Main,VANICA,0,0,0,,...سأتخلّص من هذا في طرفة عين
Dialogue: 0,0:12:47.07,0:12:50.66,Main,CHARLOTTE,0,0,0,,لن تُجدي القوّة الغاشمة نفعًا أمام هذا العليق؛
Dialogue: 0,0:12:50.66,0:12:54.54,Main,CHARLOTTE,0,0,0,,فكلّما عظمت لعنة الخصم، أحكم تقييده أكثر
Dialogue: 0,0:12:54.82,0:12:58.31,Main,MEGICULA,0,0,0,,أيُعقل أنّها استغلّت قوّتي ضدّي؟
Dialogue: 0,0:12:58.31,0:13:01.63,Main,VANICA,0,0,0,,!هيّا، تسلّي معي قليلًا
Dialogue: 0,0:13:01.63,0:13:03.18,Main,VANICA,0,0,0,,!أرجوكِ
Dialogue: 0,0:13:03.18,0:13:04.38,Main,CHARLOTTE,0,0,0,,،تهاونتِ
Dialogue: 0,0:13:04.38,0:13:08.09,Main,CHARLOTTE,0,0,0,,واستكبرتِ وأهملتِ الحذر، وها هي النتيجة
Dialogue: 0,0:13:08.09,0:13:10.42,Main,VANICA,0,0,0,,!لا تقولي هذا
Dialogue: 0,0:13:10.42,0:13:15.36,Main,VANICA,0,0,0,,!أنا واثقةٌ من أنّنا سنخوض معركةً ممتعةً للغاية
Dialogue: 0,0:13:15.36,0:13:19.07,Main,CHARLOTTE,0,0,0,,أمقتُ النسوة العابثات من أمثالكِ
Dialogue: 0,0:13:19.52,0:13:22.39,Main,CHARLOTTE,0,0,0,,اذبلي وافني دون أن تنالي مبتغاكِ؛
Dialogue: 0,0:13:22.39,0:13:24.21,Main,CHARLOTTE,0,0,0,,...فهذا هو
Dialogue: 0,0:13:25.38,0:13:26.73,Main,CHARLOTTE,0,0,0,,!عقابي لكِ
Dialogue: 0,0:13:30.71,0:13:33.71,Main,JACK,0,0,0,,!منجل الموت؛ التمزيق الجامح
Dialogue: 0,0:13:37.57,0:13:39.54,Main,DANTE,0,0,0,,...علوم سحر موريس
Dialogue: 0,0:13:39.54,0:13:43.87,Main,DANTE,0,0,0,,عزّزتْ قدرة جسدي على التجدّد التلقائيّ
Dialogue: 0,0:13:44.22,0:13:47.79,Main,DANTE,0,0,0,,...إن كان هناك ما يقدر على خدشي
Dialogue: 0,0:13:50.13,0:13:52.81,Main,DANTE,0,0,0,,فلن يكون سوى سحر إلغاء السّحر فحسب
Dialogue: 0,0:13:53.50,0:13:54.83,Main,NACHT,0,0,0,,كما توقّعت
Dialogue: 0,0:13:54.93,0:13:56.73,Main,NACHT,0,0,0,,...مع ذلك، لكي نظفر بالنصر
Dialogue: 0,0:13:57.03,0:13:59.90,Main,JACK,0,0,0,,!ما زلتُ في مستهلّ تقطيعك
Dialogue: 0,0:13:59.99,0:14:04.60,Main,NACHT,0,0,0,,علينا الرهان على سحر جاك الّذي يقطع ما يعجز أيّ نصلٍ عن قطعه
Dialogue: 0,0:14:05.20,0:14:06.33,Main,NACHT,0,0,0,,...لكن
Dialogue: 0,0:14:06.33,0:14:08.24,Main,DANTE,0,0,0,,هذا واقع الحال إذن
Dialogue: 0,0:14:10.21,0:14:12.37,Main,DANTE,0,0,0,,لا حاجة لي بكما
Dialogue: 0,0:14:12.80,0:14:15.95,Main,DANTE,0,0,0,,سحر الجاذبيّة؛ حضرة ملك الشياطين
Dialogue: 0,0:14:16.91,0:14:21.63,Main,NACHT,0,0,0,,أيقوى جاك أساسًا على الهجوم تحت وطأة سحر الجاذبيّة؟
Dialogue: 0,0:14:21.63,0:14:22.99,Main,NACHT,0,0,0,,سلوتوس
Dialogue: 0,0:14:29.23,0:14:31.74,Main,NACHT,0,0,0,,اتّحاد الشياطين؛ نمط إيكووس
Dialogue: 0,0:14:31.74,0:14:33.64,Main,NACHT,0,0,0,,خاصيّة الحصانة المنيعة
Dialogue: 0,0:14:35.10,0:14:39.27,Main,DANTE,0,0,0,,أثمّة ممسوسٌ آخر غير فتى إلغاء السّحر ذاك؟
Dialogue: 0,0:14:40.90,0:14:41.82,Main,DANTE,0,0,0,,!عجبًا
Dialogue: 0,0:14:42.90,0:14:46.91,Main,NACHT,0,0,0,,كنتَ مفعمًا بالحماسة قبل قليل، فما الّذي دهاك؟
Dialogue: 0,0:14:47.03,0:14:49.76,Main,NACHT,0,0,0,,...ألا يكبر فيكَ سوى قامتكَ وغرورك
Dialogue: 0,0:14:49.83,0:14:51.88,Main,NACHT,0,0,0,,أيّها القائد السرعوف؟
Dialogue: 0,0:14:52.43,0:14:54.83,Main,NACHT,0,0,0,,!يسهل التشدّق بالكلام
Dialogue: 0,0:14:54.83,0:14:57.58,Main,NACHT,0,0,0,,هلّا برهنتَ على بأسكَ بفعلك؟
Dialogue: 0,0:14:57.85,0:14:59.50,Main,JACK,0,0,0,,...أيّها الـ
Dialogue: 0,0:14:59.96,0:15:02.67,Main,DANTE,0,0,0,,!إيّاكَ... وتجاهلي
Dialogue: 0,0:15:03.31,0:15:07.25,Main,NACHT,0,0,0,,!أتحدّث إلى القائد هناك حاليًا
Dialogue: 0,0:15:16.09,0:15:19.80,Main,DANTE,0,0,0,,!بديع، أرني مزيدًا من الحقد الدفين
Dialogue: 0,0:15:20.23,0:15:23.82,Main,DANTE,0,0,0,,أستُسلّيني إلى أن تُفتح البوّابة يا ترى؟
Dialogue: 0,0:15:24.13,0:15:26.84,Main,NACHT,0,0,0,,يسعني مبادلته الضربات، غير أنّي أفتقر لضربةٍ حاسمة
Dialogue: 0,0:15:26.95,0:15:28.72,Main,NACHT,0,0,0,,لا يسعني الإطاحة به بمفردي
Dialogue: 0,0:15:29.43,0:15:32.08,Main,NACHT,0,0,0,,لا بُدَّ من إتاحة الفرصة لجاك كي يشنّ هجومه
Dialogue: 0,0:15:32.55,0:15:34.76,Main,DANTE,0,0,0,,...أمّا أنتَ الزاحف أرضًا
Dialogue: 0,0:15:34.86,0:15:36.71,Main,DANTE,0,0,0,,!سمعتُه يُناديك بالقائد
Dialogue: 0,0:15:37.18,0:15:39.46,Main,DANTE,0,0,0,,لكنّك مثيرٌ للضجر حقًّا
Dialogue: 0,0:15:39.46,0:15:40.31,Main,DANTE,0,0,0,,!تنحَّ جانبًا
Dialogue: 0,0:15:49.03,0:15:51.41,Main,JACK,0,0,0,,،كان والدي صيّادًا من العوام
Dialogue: 0,0:15:51.41,0:15:54.56,Main,JACK,0,0,0,,يقتات على صيد الطرائد الصغيرة والطيور
Dialogue: 0,0:15:54.98,0:15:58.83,Main,JACK,0,0,0,,"كانت لازمته الدائمة؛ "إيّاك ومقارعة من يبدو أشدّ منك بأسًا
Dialogue: 0,0:15:59.57,0:16:02.40,Main,JACK,0,0,0,,كان رجلًا واقعيًّا ومتحفّظًا
Dialogue: 0,0:16:04.59,0:16:09.04,Main,JACK,0,0,0,,،وحين تبيّن أنَّ سحري يُشكّل نصالًا قاطعة
Dialogue: 0,0:16:09.13,0:16:12.13,Main,JACK,0,0,0,,استبشر خيرًا بأنّه يلائم مهنة الصيد
Dialogue: 0,0:16:12.73,0:16:14.93,Main,JACK,0,0,0,,...وعلى خطى والدي
Dialogue: 0,0:16:14.93,0:16:17.88,Main,JACK,0,0,0,,واصلتُ صيد الكائنات الضعيفة وتمزيقها
Dialogue: 0,0:16:26.06,0:16:29.76,Main,YOUNG JACK,0,0,0,,أهكذا سأقضي سائر أيّام حياتي يا ترى؟
Dialogue: 0,0:16:36.18,0:16:41.27,Main,JACK,0,0,0,,وحين بلغتُ الثالثة عشرة، عاد أبي من الجبل جثّةً هامدة
Dialogue: 0,0:16:41.94,0:16:44.77,Main,JACK,0,0,0,,"فقلتُ في نفسي؛ "لا عجب في ذلك
Dialogue: 0,0:16:45.31,0:16:49.43,Main,JACK,0,0,0,,قيل إنّه صادف سيّد الجبل أثناء رحلة صيده
Dialogue: 0,0:16:50.19,0:16:54.21,Main,JACK,0,0,0,,إذ بدت آثار مخالب هائلةٍ محفورةً في ظهره
Dialogue: 0,0:17:08.03,0:17:10.38,Main,YOUNG JACK,0,0,0,,لا بأس، يسعني الانتصار
Dialogue: 0,0:17:24.07,0:17:26.21,Main,YOUNG JACK,0,0,0,,سأنضمّ إلى فرسان السّحر
Dialogue: 0,0:17:33.89,0:17:34.99,Main,NACHT,0,0,0,,...هذا الرجل
Dialogue: 0,0:17:35.58,0:17:38.24,Main,NACHT,0,0,0,,!يُحرّك نصاله على جسده ليشحذها
Dialogue: 0,0:17:39.83,0:17:41.71,Main,JACK,0,0,0,,...كلّ ما أبتغيه
Dialogue: 0,0:17:42.01,0:17:45.66,Main,DANTE,0,0,0,,!يا لعاركَ وأنتَ تزحف محتميًا بالآخرين
Dialogue: 0,0:17:45.84,0:17:48.85,Main,JACK,0,0,0,,...هو أن أقتنص كلّ من يزعم أنّه قويٌّ أمامي
Dialogue: 0,0:17:48.85,0:17:53.22,Main,DANTE,0,0,0,,حتّى يامي سوكيهيرو أمتعني رغم كونه قائدًا مثلك
Dialogue: 0,0:17:55.98,0:17:57.75,Main,JACK,0,0,0,,!وأمزّقهُ إربًا
Dialogue: 0,0:18:00.76,0:18:02.48,Main,NACHT,0,0,0,,!شطَر الجاذبيّة إلى نصفين
Dialogue: 0,0:18:02.68,0:18:05.96,Main,JACK,0,0,0,,!فلتجرّبْ هذا بجسدكَ إذن
Dialogue: 0,0:18:08.93,0:18:13.11,Main,DANTE,0,0,0,,مهما كابدتَ في الهجوم، فلن تقدر حشرة مثلك على قتلي
Dialogue: 0,0:18:17.07,0:18:22.05,Main,JACK,0,0,0,,!إيّاكَ... والاستخفاف بالحشرات
Dialogue: 0,0:18:25.38,0:18:28.07,Main,JACK,0,0,0,,،ليست الغلبة لمن تصبّ التوقّعات في صالحه
Dialogue: 0,0:18:28.15,0:18:31.65,Main,JACK,0,0,0,,!بل لمن ينجو في صراع البقاء
Dialogue: 0,0:18:31.87,0:18:34.38,Main,DANTE,0,0,0,,!أعجزُ عن التجدّد؟
Dialogue: 0,0:18:35.45,0:18:38.22,Main,NACHT,0,0,0,,يبدو أنّي أسأتُ تقديرك
Dialogue: 0,0:18:45.71,0:18:47.73,Main,MEREOLEONA,0,0,0,,!أهذا أقصى ما لديكَ أيّها الشيطان؟
Dialogue: 0,0:18:47.73,0:18:49.95,Main,ALBERT,0,0,0,,!يا لها من ساحرةٍ فذّة
Dialogue: 0,0:18:49.95,0:18:52.57,Main,ALBERT,0,0,0,,!أسقطت الشيطان الأثريّ بمفردها
Dialogue: 0,0:18:53.33,0:18:54.36,Main,RALPH,0,0,0,,!أيّها الرفاق
Dialogue: 0,0:18:55.41,0:18:56.40,Main,ALBERT,0,0,0,,!رالف
Dialogue: 0,0:18:56.40,0:18:57.88,Main,RALPH,0,0,0,,!القائد ألبرت
Dialogue: 0,0:18:58.59,0:19:00.13,Main,ALBERT,0,0,0,,يسرّني أنّكَ بخير
Dialogue: 0,0:19:00.20,0:19:02.48,Main,ALBERT,0,0,0,,التقيتَ ناهات-دونو بدوركَ إذن
Dialogue: 0,0:19:02.55,0:19:03.62,Main,RALPH,0,0,0,,!أجل
Dialogue: 0,0:19:03.87,0:19:08.54,Main,RALPH,0,0,0,,!غدا يونو-ساما متمرّسًا في سحر الرياح
Dialogue: 0,0:19:09.31,0:19:11.80,Main,RALPH,0,0,0,,،ويُشبه سييل-ساما تمام الشبه
Dialogue: 0,0:19:11.99,0:19:15.30,Main,RALPH,0,0,0,,ويحمل قلبًا جسورًا ورثه عن لويس-ساما
Dialogue: 0,0:19:16.47,0:19:17.62,Main,ALBERT,0,0,0,,فهمت
Dialogue: 0,0:19:18.76,0:19:20.31,Main,ALBERT,0,0,0,,...سحر الرياح
Dialogue: 0,0:19:20.65,0:19:24.29,Main,ALBERT,0,0,0,,!لكن الأمل معقودٌ على يونو-ساما وأولئك الفرسان
Dialogue: 0,0:19:39.23,0:19:40.62,Main,NACHT,0,0,0,,هكذا إذن
Dialogue: 0,0:19:40.62,0:19:43.29,Main,NACHT,0,0,0,,...يبدو أنَّ نخبة فرسان السّحر الأعتى في مملكتنا
Dialogue: 0,0:19:43.29,0:19:46.37,Main,NACHT,0,0,0,,أشدُّ بأسًا ممّا تصوّرتُ بكثير
Dialogue: 0,0:19:47.38,0:19:51.50,Main,NACHT,0,0,0,,ما زال أمامنا متسعٌ من الوقت قبل انفتاح بوّابة العالم السفليّ
Dialogue: 0,0:19:53.59,0:19:56.59,Main,DANTE,0,0,0,,أتعتزم إمتاعي أنتَ أيضًا؟
Dialogue: 0,0:19:56.90,0:20:00.50,Main,JACK,0,0,0,,!اخرس ومتْ سريعًا
Dialogue: 0,0:20:02.83,0:20:04.20,Main,NACHT/YUNO/CHARLOTTE,0,0,0,,ما هذا الشعور؟
Dialogue: 0,0:20:09.30,0:20:10.30,Main,RALPH,0,0,0,,ما هذا؟
Dialogue: 0,0:20:14.54,0:20:16.13,Main,NACHT,0,0,0,,!جذورٌ عملاقة؟
Dialogue: 0,0:20:16.13,0:20:17.49,Main,NACHT,0,0,0,,!كليفوث
Dialogue: 0,0:20:18.15,0:20:19.10,Main,NACHT,0,0,0,,!بلوميدي
Dialogue: 0,0:20:20.83,0:20:21.93,Main,NACHT,0,0,0,,اتّحاد
Dialogue: 0,0:20:26.85,0:20:28.58,Main,NACHT,0,0,0,,نمط فيليس
Dialogue: 0,0:20:29.22,0:20:32.17,Main,NACHT,0,0,0,,سحر الظلال؛ عين الظلّ السماويّ البصيرة
Dialogue: 0,0:20:36.40,0:20:38.74,Main,NACHT,0,0,0,,،في باطن الأرض حيث تجري طقوس هبوط كليفوث
Dialogue: 0,0:20:38.74,0:20:41.30,Main,NACHT,0,0,0,,!أستشعر انبعاثُ مانا لشخصٍ آخر غير يامي وفانجانس
Dialogue: 0,0:20:41.84,0:20:43.50,Main,NACHT,0,0,0,,...إن لم تخني الذاكرة، فهذا الشخص
Dialogue: 0,0:20:43.50,0:20:47.48,Main,NACHT,0,0,0,,موريس؛ عالم السّحر المنفيّ من مملكة داياموند
Dialogue: 0,0:20:51.31,0:20:56.36,Main,NACHT,0,0,0,,يبدو أنَّ تصرّفات فانيكا الهوجاء تؤتي ثمارها حينًا
Dialogue: 0,0:20:56.70,0:20:58.43,Main,NACHT,0,0,0,,...بفضل حكمة مملكة هارت
Dialogue: 0,0:20:58.43,0:21:02.42,Main,NACHT,0,0,0,,توصّلتُ إلى طريقةٍ لتسريع نمو شجرة كليفوث
Dialogue: 0,0:21:03.46,0:21:05.94,Main,NACHT,0,0,0,,...أن أحظى بمثل هذه الموهبة
Dialogue: 0,0:21:05.94,0:21:09.49,Main,NACHT,0,0,0,,عوضًا عن فقداني لبصري مُنذ ولادتي؛
Dialogue: 0,0:21:11.58,0:21:14.45,Main,NACHT,0,0,0,,!موهبة الاستحواذ الشيطانيّ
Dialogue: 0,0:21:15.81,0:21:17.71,Main,NACHT,0,0,0,,...بتسخير قوى الشيطان
Dialogue: 0,0:21:17.71,0:21:22.94,Main,NACHT,0,0,0,,تسنّى لي انتزاع حكمة لولوبيتشكا وغرسها في داخلي
Dialogue: 0,0:21:24.27,0:21:26.26,Main,NACHT,0,0,0,,...أجهلُ كيف حدث هذا، ولكن
Dialogue: 0,0:21:26.26,0:21:29.54,Main,NACHT,0,0,0,,!أيُعقل أنَّ موريس يعمل كمُحفّزٍ لفتح البوابة؟
Dialogue: 0,0:21:31.24,0:21:33.02,Main,NACHT,0,0,0,,!ستُفتح بوابة العالم السفليّ
Dialogue: 0,0:21:33.02,0:21:34.11,Main,NACHT,0,0,0,,!هذا سيّئ
Dialogue: 0,0:21:34.11,0:21:35.77,Main,NACHT,0,0,0,,!لا بُدَّ من القضاء على موريس
Dialogue: 0,0:21:50.83,0:21:53.11,Main,NACHT,0,0,0,,خاصيّة فيليس؛ خفّة الحركة
Dialogue: 0,0:21:53.11,0:21:54.58,Main,NACHT,0,0,0,,...هذان
Dialogue: 0,0:21:55.22,0:21:57.13,Main,NAAMAH,0,0,0,,أخطأتُ هدفي
Dialogue: 0,0:21:57.13,0:21:58.52,Main,LILITH,0,0,0,,أمّا أنا فأصبتُه
Dialogue: 0,0:21:58.84,0:22:01.45,Main,NAAMAH,0,0,0,,كلُّ شيءٍ يبعث على البهجة الآن
Dialogue: 0,0:22:01.45,0:22:03.68,Main,LILITH,0,0,0,,أجل، ممتعٌ للغاية
Dialogue: 0,0:22:04.22,0:22:06.35,Main,NACHT,0,0,0,,!شيطانان من الرتبة العليا
