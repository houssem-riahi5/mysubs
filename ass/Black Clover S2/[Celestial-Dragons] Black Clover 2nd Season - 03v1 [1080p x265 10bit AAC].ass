Dialogue: 0,0:00:01.45,0:00:03.09,Main,NACHT,0,0,0,,...بوابة العالم السفليّ
Dialogue: 0,0:00:03.73,0:00:04.47,Main,NACHT,0,0,0,,!هذا سيّئ
Dialogue: 0,0:00:04.47,0:00:05.98,Main,NACHT,0,0,0,,!لا بُدَّ من القضاء على موريس
Dialogue: 0,0:00:19.09,0:00:20.94,Main,NACHT,0,0,0,,!فيليس؛ خفّة الحركة
Dialogue: 0,0:00:21.26,0:00:22.66,Main,NACHT,0,0,0,,...هذان
Dialogue: 0,0:00:23.28,0:00:25.31,Main,NACHT,0,0,0,,!شيطانان من الرتبة العليا
Dialogue: 0,0:00:32.17,0:00:34.55,Main,NACHT,0,0,0,,...بولميدي يرتعدُ خوفًا
Dialogue: 0,0:00:34.81,0:00:36.72,Main,NACHT,0,0,0,,...الطبقة الأولى من العالم السفليّ
Dialogue: 0,0:00:36.72,0:00:39.33,Main,NACHT,0,0,0,,وشيطانان من الرتبة العليا
Dialogue: 0,0:00:39.77,0:00:42.81,Main,NACHT,0,0,0,,...ظننتُ أنَّ قوّتهما ستضاهي الثالوث المظلم، لكن
Dialogue: 0,0:00:47.56,0:00:50.65,Main,LILITH,0,0,0,,ما رأيكَ بزيادة وطأة هجومنا قليلًا؟
Dialogue: 0,0:00:51.22,0:00:53.66,Main,NAAMAH,0,0,0,,أجل، لنفعل ذلك
Dialogue: 0,0:01:23.00,0:01:25.42,Main,NACHT,0,0,0,,!قوّتهما تتجاوز كلّ الحدود
Dialogue: 0,0:01:25.42,0:01:28.33,Main,NAAMAH,0,0,0,,!ما أطيب طعم هذه المانا يا ليليث
Dialogue: 0,0:01:28.33,0:01:30.23,Main,LILITH,0,0,0,,أجل يا ناهاما
Dialogue: 0,0:01:30.62,0:01:32.30,Main,NACHT,0,0,0,,!إنّهما يلهوان فحسب
Dialogue: 0,0:01:40.44,0:01:41.74,Main,SPADE CITIZEN 1,0,0,0,,...تلك الجذور
Dialogue: 0,0:01:42.23,0:01:46.62,Main,SPADE CITIZEN 1,0,0,0,,أتسحبُ المانا من الأجواء والمحيط؟
Dialogue: 0,0:01:50.99,0:01:55.45,Main,ALBERT,0,0,0,,!ما هذا الكمُّ الهائل من المانا المشؤومة؟
Dialogue: 0,0:02:05.43,0:02:07.61,Main,ALBERT,0,0,0,,!أأولئك... شياطين؟
Dialogue: 0,0:02:11.90,0:02:14.23,Main,MEREOLEONA,0,0,0,,‫هذه المانا تُشبه ما شعرتُ به آنذاك
Dialogue: 0,0:02:28.75,0:02:31.09,Main,MEREOLEONA,0,0,0,,!بدأ النزال الحقيقيّ الآن إذن
Dialogue: 0,0:02:38.67,0:02:43.14,Main,ZENON,0,0,0,,لم أستطع هزيمته بـ80% من قوّتي
Dialogue: 0,0:02:43.14,0:02:45.06,Main,YUNO,0,0,0,,!هذه نهايتك يا زينون
Dialogue: 0,0:02:45.68,0:02:46.56,Main,ZENON,0,0,0,,...لكن
Dialogue: 0,0:02:46.88,0:02:48.53,Main,ZENON,0,0,0,,!هذا مؤسف
Dialogue: 0,0:02:50.44,0:02:51.80,Main,CHARLOTTE,0,0,0,,...هذا
Dialogue: 0,0:02:51.80,0:02:55.99,Main,CHARLOTTE,0,0,0,,!كبحتُ قوّة اللّعنة، لكنَّ المانا تفيض
Dialogue: 0,0:02:58.62,0:03:00.38,Main,DANTE,0,0,0,,...البّوابة الأولى
Dialogue: 0,0:03:01.37,0:03:04.75,Main,DANTE,0,0,0,,كانت الحاجز الّذي يجعل عقودنا مع الشياطين ناقصةً
Dialogue: 0,0:03:05.14,0:03:08.32,Main,DANTE,0,0,0,,!لكنّها فُتحتْ الآن
Dialogue: 0,0:03:09.24,0:03:12.88,Main,DANTE/ZENON/VANICA,0,0,0,,قوّة الشيطان 100%‫!
Dialogue: 0,0:03:26.38,0:03:29.53,Main,DANTE,0,0,0,,حسنٌ، هلّا استكملنا نزالنا؟
Dialogue: 0,0:05:05.94,0:05:08.70,Main,DANTE,0,0,0,,...ساءني إزعاجكَ وأنتَ مستلقٍ
Dialogue: 0,0:05:09.48,0:05:13.04,Main,DANTE,0,0,0,,!لكنّي أرغب في أن تُسليني أكثر قليلًا
Dialogue: 0,0:05:26.09,0:05:28.81,Main,VANICA,0,0,0,,‫كان ذلك لئيمًا!
Dialogue: 0,0:05:28.81,0:05:32.34,Main,VANICA,0,0,0,,!رغم كلّ هذا الحبّ الّذي أكنّهُ لكِ
Dialogue: 0,0:05:32.77,0:05:35.79,Main,VANICA,0,0,0,,!هيّا، لنذهب معًا
Dialogue: 0,0:05:45.16,0:05:49.37,Main,YUNO,0,0,0,,!قدرتهُ على تجديد العظام والبطش قد زادتْ ضراوةً
Dialogue: 0,0:05:49.37,0:05:52.51,Main,YUNO,0,0,0,,!حتّى كلّ إصاباته تماثلت للشفاء بالكامل
Dialogue: 0,0:05:52.92,0:05:57.66,Main,ZENON,0,0,0,,!لم يكن نصركم سوى حلمٍ عابرٍ زائل
Dialogue: 0,0:06:00.77,0:06:01.83,Main,NACHT,0,0,0,,!سحقًا
Dialogue: 0,0:06:01.88,0:06:03.59,Main,NACHT,0,0,0,,!يتوافدون من كلّ مكان
Dialogue: 0,0:06:04.23,0:06:08.01,Main,NACHT,0,0,0,,!تركُ موريس دون رادعٍ سيزيد الأوضاع سوءًا
Dialogue: 0,0:06:08.47,0:06:11.69,Main,NACHT,0,0,0,,!لا خيار أمامي سوى التوجه للقضاء عليه فورًا
Dialogue: 0,0:06:12.62,0:06:16.68,Main,NACHT,0,0,0,,!لكن، كيف لي بالفرار في مواجهة هذين الشيطانين العتاة؟
Dialogue: 0,0:06:16.76,0:06:19.35,Main,NACHT,0,0,0,,!لا بُدَّ لأحدهم أن يشغلهما أيضًا
Dialogue: 0,0:06:19.93,0:06:22.98,Main,NACHT,0,0,0,,...القضاء على موريس وكبح هذين الشيطانين
Dialogue: 0,0:06:23.29,0:06:25.73,Main,NACHT,0,0,0,,...السبيل الأمثل لظفرنا هو
Dialogue: 0,0:06:28.64,0:06:29.80,Main,NACHT,0,0,0,,...بولميدي
Dialogue: 0,0:06:31.33,0:06:32.96,Main,NACHT,0,0,0,,مُت معي
Dialogue: 0,0:06:34.33,0:06:37.58,Main,ZENON,0,0,0,,الهلاكُ سيكون مصيركم أنتم حتمًا
Dialogue: 0,0:06:38.19,0:06:39.93,Main,ZENON,0,0,0,,...لكن اطمئنوا
Dialogue: 0,0:06:40.40,0:06:43.34,Main,ZENON,0,0,0,,فلم يعد لديكم ديارٌ تعودون إليها على أيّ حال
Dialogue: 0,0:06:43.34,0:06:44.41,Main,YUNO,0,0,0,,!ماذا؟
Dialogue: 0,0:06:50.27,0:06:52.26,Main,REKKA,0,0,0,,!انظروا هناك
Dialogue: 0,0:07:13.85,0:07:16.46,Main,CLOVER MALE CITIZEN,0,0,0,,!إنّه شيطان
Dialogue: 0,0:07:18.57,0:07:20.80,Narrator,NARRATOR,0,0,0,,...يتخلّق الشياطين معجزةً
Dialogue: 0,0:07:20.80,0:07:24.17,Narrator,NARRATOR,0,0,0,,تلتقي فيها ضغائن البشر بسطوة العالم السفليّ
Dialogue: 0,0:07:24.65,0:07:25.99,Narrator,NARRATOR,0,0,0,,...في سالف العصر والآوان
Dialogue: 0,0:07:25.99,0:07:32.14,Narrator,NARRATOR,0,0,0,,،كان في مملكة سبيد شابّان من الأسرة الملكيّة يتمتعان بقدراتٍ سحريّةٍ هائلة
Dialogue: 0,0:07:32.24,0:07:34.16,Narrator,NARRATOR,0,0,0,,،وكانا أوفى الصديقين
Dialogue: 0,0:07:34.77,0:07:37.88,Narrator,NARRATOR,0,0,0,,...غير أنَّ البغضاء تدبتْ بينهما مع مرور الوقت
Dialogue: 0,0:07:37.88,0:07:44.09,Narrator,NARRATOR,0,0,0,,فتحوّلا إلى شيطانين عتيقين، واقتتلا، ثمَّ خُتما في النّهاية
Dialogue: 0,0:07:44.86,0:07:49.77,Main,ZENON,0,0,0,,أيقظنا الشيطانين العتيقين اللّذين كانت تحرسهما عائلة غرينبريول
Dialogue: 0,0:07:50.09,0:07:53.70,Main,ZENON,0,0,0,,...أطلقناهما لإلهائكم، لكن
Dialogue: 0,0:07:53.70,0:07:57.95,Main,ZENON,0,0,0,,،بما أنَّ كلّ فرسان السّحر قد احتشدوا هنا
Dialogue: 0,0:07:57.95,0:08:01.58,Main,ZENON,0,0,0,,فهل تظنون أن دياركم ستسلم من الدمار؟
Dialogue: 0,0:08:04.50,0:08:06.46,Main,MEREOLEONA,0,0,0,,...يمتص المانا عبر أجنحته
Dialogue: 0,0:08:10.69,0:08:13.10,Main,MEREOLEONA,0,0,0,,!فتتعاظم قوّته السّحريّة أكثر فأكثر
Dialogue: 0,0:08:19.22,0:08:22.01,Main,JULIUS,0,0,0,,بهذا الجسد العليل، لا قَبل لي بمنازلتهم قطّ
Dialogue: 0,0:08:22.81,0:08:25.29,Main,JULIUS,0,0,0,,أحتاجُ إلى وقتٍ لإطلاق كامل قوّتي
Dialogue: 0,0:08:25.73,0:08:28.06,Main,JULIUS,0,0,0,,!فلتصمدوا جميعًا حتّى ذلك الحين
Dialogue: 0,0:08:29.05,0:08:32.28,Main,JULIUS,0,0,0,,معذرةً، بيد أنّي بحاجةٍ إلى عونك
Dialogue: 0,0:08:32.84,0:08:34.10,Main,JULIUS,0,0,0,,أعتمد عليك
Dialogue: 0,0:08:40.36,0:08:41.41,Main,CLOVER CITIZEN 2,0,0,0,,‫ا-اهربوا!
Dialogue: 0,0:08:41.63,0:08:42.91,Main,MAGIC KNIGHT 1,0,0,0,,!إنه ضخمٌ للغاية
Dialogue: 0,0:08:43.10,0:08:44.61,Main,MAGIC KNIGHT 1,0,0,0,,!لا حيلة لنا أمامه
Dialogue: 0,0:08:48.40,0:08:51.58,Main,KAISER,0,0,0,,!سحر الدوامة؛ النطاق الحلزونيّ
Dialogue: 0,0:08:56.73,0:08:59.35,Main,KAISER,0,0,0,,!لا تدعوه يتقدم خطوةً أخرى
Dialogue: 0,0:08:59.35,0:09:03.31,Main,SOL,0,0,0,,...بينما يحد القائد كايزر وفرسان الأوركا الأرجوانيّة من زحفه
Dialogue: 0,0:09:03.31,0:09:05.81,Main,SOL,0,0,0,,!علينا إجلاء المواطنين إلى مكان آمن
Dialogue: 0,0:09:12.61,0:09:14.03,Main,KIRSCH,0,0,0,,سحر أزهار الساكورا؛
Dialogue: 0,0:09:14.03,0:09:14.89,Main,NEBRA,0,0,0,,سحر الضباب؛
Dialogue: 0,0:09:14.89,0:09:16.96,Main,KIRSCH,0,0,0,,!عاصفة الأزهار العاتيّة
Dialogue: 0,0:09:16.96,0:09:17.74,Main,NEBRA,0,0,0,,!الوهم السّرمديّ
Dialogue: 0,0:09:22.51,0:09:23.41,Main,NEBRA,0,0,0,,!سوليد
Dialogue: 0,0:09:24.92,0:09:28.67,Main,SOLID,0,0,0,,!سحر تكوين الماء؛ زئير ثعبان البحر
Dialogue: 0,0:09:34.17,0:09:35.18,Main,SOLID,0,0,0,,!سحقًا
Dialogue: 0,0:09:35.71,0:09:38.14,Main,SOLID,0,0,0,,...تبًّا! سحري الّذي تدربتُ عليه لستة أشهر
Dialogue: 0,0:09:38.49,0:09:41.05,Main,SOLID,0,0,0,,!لم يستطع سوى تغيير مسار هجومه فحسب
Dialogue: 0,0:09:50.80,0:09:52.19,Main,KAISER,0,0,0,,...قوّته السّحريّة
Dialogue: 0,0:09:52.19,0:09:54.19,Main,NEBRA/SOLIDP,0,0,0,,!تتجاوز كلّ تصورٍ
Dialogue: 0,0:09:54.19,0:09:57.20,Main,KIRSCH,0,0,0,,!مع ذلك، يفتقرُ إلى الجمال
Dialogue: 0,0:10:07.37,0:10:10.92,Main,DAMNATIO,0,0,0,,!سحر الميزان: ضبط الكفّة
Dialogue: 0,0:10:13.61,0:10:16.01,Main,DAMNATIO,0,0,0,,قوّته السّحريّة هائلةٌ للغاية
Dialogue: 0,0:10:16.01,0:10:18.93,Main,DAMNATIO,0,0,0,,...كما توقعت، في مواجهة طاقةٍ سحريّةٍ جبارةٍ كهذه
Dialogue: 0,0:10:19.17,0:10:21.97,Main,DAMNATIO,0,0,0,,لا بدَّ من ردّها بسحرٍ يُضاهيها هولًا وقوةً
Dialogue: 0,0:10:24.92,0:10:26.27,Main,CLOVER CITIZEN 3,0,0,0,,...ذلك السّحر
Dialogue: 0,0:10:28.15,0:10:29.08,Main,CLOVER CITIZEN 4,0,0,0,,...ذلك
Dialogue: 0,0:10:34.69,0:10:36.05,Main,CLOVER CITIZEN 5,0,0,0,,!إمبراطور السّحر
Dialogue: 0,0:10:36.05,0:10:37.53,Main,CLOVER CITIZEN 6,0,0,0,,!إنّه إمبراطور السّحر
Dialogue: 0,0:10:38.02,0:10:41.11,Main,WIZARD KING,0,0,0,,قدمتُ زمن جسدي عشر سنين للأمام
Dialogue: 0,0:10:41.62,0:10:44.03,Main,WIZARD KING,0,0,0,,...رغم ما يحدّ من الوقت وقدراتي
Dialogue: 0,0:10:44.55,0:10:46.83,Main,WIZARD KING,0,0,0,,...فإن توحيد قوتي مع دامناتيو-كن
Dialogue: 0,0:10:49.29,0:10:50.25,Main,DAMNATIO,0,0,0,,!الآن
Dialogue: 0,0:10:59.03,0:11:01.75,Main,WIZARD KING,0,0,0,,!امنحني القوّة مرّةً أخرى
Dialogue: 0,0:11:05.15,0:11:06.31,Main,JULIUS,0,0,0,,!أنفد الوقت بالفعل؟
Dialogue: 0,0:11:06.67,0:11:07.41,Main,JULIUS,0,0,0,,!لماذا؟
Dialogue: 0,0:11:07.50,0:11:08.85,Main,JULIUS,0,0,0,,!هذا أسرع ممّا توقعت
Dialogue: 0,0:11:09.90,0:11:11.77,Main,CLOVER CITIZEN 8,0,0,0,,!إمبراطور السّحر؟
Dialogue: 0,0:11:13.09,0:11:15.91,Main,DAMNATIO,0,0,0,,!لم أعد أستطيع كبح قوّته أكثر من هذا
Dialogue: 0,0:11:32.99,0:11:37.20,Main,EVERYONE,0,0,0,,في هذا العالم، السّحرُ هو كلّ شيء
Dialogue: 0,0:11:37.79,0:11:39.21,Main,MAGIC KNIGHT 2,0,0,0,,انتهى أمرنا
Dialogue: 0,0:11:44.97,0:11:46.72,Main,YUNO,0,0,0,,!‫خابتكَ الظنون
Dialogue: 0,0:11:47.07,0:11:49.95,Main,YUNO,0,0,0,,!فهو ما يزال في مملكة كلوفر
Dialogue: 0,0:12:06.31,0:12:07.74,Main,JULIUS,0,0,0,,!أستا-كن
Dialogue: 0,0:12:14.27,0:12:15.71,Main,ASTA,0,0,0,,!لننطلق يا ليبي
Dialogue: 0,0:12:15.71,0:12:16.96,Main,LIEBE,0,0,0,,!أجل
Dialogue: 0,0:12:16.96,0:12:18.34,Main,ASTA/LIEBE,0,0,0,,!اتحاد
Dialogue: 0,0:12:23.38,0:12:24.81,Main,ASTA,0,0,0,,!لننطلق يا ليبي
Dialogue: 0,0:12:24.81,0:12:25.76,Main,LIEBE,0,0,0,,!أجل
Dialogue: 0,0:12:25.76,0:12:27.15,Main,ASTA/LIEBE,0,0,0,,!اتحاد
Dialogue: 0,0:12:39.02,0:12:42.86,Main,DAMNATIO,0,0,0,,!أمَحى كلّ تلك المانا العاتية بسهولةٍ؟
Dialogue: 0,0:12:55.62,0:12:58.83,Main,ASTA,0,0,0,,هيئتنا هذه لا تدوم سوى خمس دقائق فحسب
Dialogue: 0,0:12:59.04,0:13:01.80,Main,ASTA,0,0,0,,!سنُرديه صريعًا
Dialogue: 0,0:13:04.59,0:13:06.17,Main,ASTA,0,0,0,,...يا رئيس مجلس السّحر
Dialogue: 0,0:13:07.00,0:13:08.04,Main,ASTA,0,0,0,,راقبني جيّدًا
Dialogue: 0,0:13:08.57,0:13:09.47,Main,ASTA,0,0,0,,...سأقوم
Dialogue: 0,0:13:10.44,0:13:13.77,Main,ASTA,0,0,0,,!بحماية هذه المملكة رفقة شيطاني
Dialogue: 0,0:13:14.98,0:13:17.48,Main,CLOVER CITIZEN 10,0,0,0,,!أذلك... شيطان؟
Dialogue: 0,0:13:17.48,0:13:18.74,Main,CLOVER CITIZEN 11,0,0,0,,!إنّه شيطان
Dialogue: 0,0:13:21.52,0:13:25.99,Main,CLOVER CITIZEN 11,0,0,0,,!جاء شيطانٌ رفقة الشيطان العتيق لإبادة مملكتنا
Dialogue: 0,0:13:25.99,0:13:27.03,Main,REBECCA,0,0,0,,‫أنتَ مخطئ!
Dialogue: 0,0:13:27.61,0:13:29.23,Main,REBECCA,0,0,0,,!إنّه أستا
Dialogue: 0,0:13:29.57,0:13:30.87,Main,REBECCA,0,0,0,,!أستا
Dialogue: 0,0:13:31.27,0:13:34.32,Main,REBECCA,0,0,0,,!أستا من سيحمي هذه المملكة
Dialogue: 0,0:13:35.59,0:13:37.12,Main,SOLID,0,0,0,,...سحقًا، سحقًا
Dialogue: 0,0:13:37.12,0:13:39.00,Main,SOLID,0,0,0,,!لذلك القروي
Dialogue: 0,0:13:39.35,0:13:43.06,Main,KIRSCH,0,0,0,,مظهره مقيتٌ ولا يمتُّ لذائقتي بصلةٍ قطّ
Dialogue: 0,0:13:43.56,0:13:46.26,Main,KIRSCH,0,0,0,,!لكنَّ فيه نوعًا من الجمال
Dialogue: 0,0:13:46.55,0:13:52.14,Main,SOL,0,0,0,,!لم أتوقع أن ذلك القزم سيصل إلى هذا المستوى الخيالي
Dialogue: 0,0:13:52.81,0:13:54.26,Main,KLAUS,0,0,0,,!يسعك فعلها
Dialogue: 0,0:13:55.21,0:13:57.64,Main,KLAUS,0,0,0,,،ليس لأنّكَ ممسوسٌ بشيطانٍ
Dialogue: 0,0:13:58.17,0:14:01.48,Main,KLAUS,0,0,0,,!بل لأنّكَ فارس سحرٍ أكثر من غيرك
Dialogue: 0,0:14:01.96,0:14:05.53,Main,KLAUS,0,0,0,,!انطلق يا أستا
Dialogue: 0,0:14:47.03,0:14:50.03,Main,JULIUS,0,0,0,,،الشيطان العتيق كتلةٌ ضخمةٌ من المانا الهائلة
Dialogue: 0,0:14:50.38,0:14:52.43,Main,JULIUS,0,0,0,,...يتصدى لأيِّ سحر كان
Dialogue: 0,0:14:52.43,0:14:57.65,Main,JULIUS,0,0,0,,ويسحق كلّ ما يعترض طريقه بهجماتٍ بدائيّةٍ ومباشرة
Dialogue: 0,0:14:58.19,0:15:02.13,Main,JULIUS,0,0,0,,!ولهذا السبب تحديدًا لا يسعه كبح هجمات إبطال السّحر
Dialogue: 0,0:15:39.59,0:15:41.83,Main,ASTA,0,0,0,,!مرحى
Dialogue: 0,0:15:41.83,0:15:43.52,Main,GIMODELO,0,0,0,,!هذا سيّئ، هذا سيّئ
Dialogue: 0,0:15:43.52,0:15:45.34,Main,GIMODELO,0,0,0,,...بهذا المعدل، سيّدي
Dialogue: 0,0:15:45.51,0:15:47.71,Main,GIMODELO,0,0,0,,...سيلقى سيّدي ناهات
Dialogue: 0,0:15:48.90,0:15:51.97,Main,ASTA,0,0,0,,!حسنٌ، لنتوجه إلى مملكة سبيد
Dialogue: 0,0:15:52.51,0:15:56.72,Main,ASTA,0,0,0,,!رغم قولي هذا، فإن الوصول سيستغرق وقتًا طويلًا حتّى بهيئة الاتّحاد
Dialogue: 0,0:15:56.94,0:16:01.48,Main,GIMODELO,0,0,0,,،لا يسعني الانتقال آنيًّا لمسافاتٍ شاسعةٍ دون وجود سيّدي ناهات
Dialogue: 0,0:16:01.48,0:16:05.48,Main,GIMODELO,0,0,0,,!كما أنّه ليس في وضعٍ يسمح له بفعل ذلك حاليًّا
Dialogue: 0,0:16:06.57,0:16:07.86,Main,ASTA,0,0,0,,ما العمل إذن؟
Dialogue: 0,0:16:11.87,0:16:15.68,Main,ASTA,0,0,0,,!انفكّ الاتّحاد أسرع ممّا ظننت
Dialogue: 0,0:16:13.44,0:16:15.68,Top,LIEBE,0,0,0,,!أيّها الغبي! استخدم سيف قاطع الشياطين للطيران بسرعة
Dialogue: 0,0:16:20.80,0:16:22.16,Main,LIEBE,0,0,0,,!مؤلم
Dialogue: 0,0:16:22.16,0:16:24.81,Main,FINRAL,0,0,0,,!ها أنتَ ذا تزداد قوّةً جبارةً مجدّدًا
Dialogue: 0,0:16:25.43,0:16:29.85,Main,FINRAL,0,0,0,,لكن، أليس من الجفاء أن تحاول الذهاب بمفردك؟
Dialogue: 0,0:16:30.72,0:16:31.54,Main,ASTA,0,0,0,,!حسنٌ
Dialogue: 0,0:16:42.93,0:16:45.60,Main,ALBERT,0,0,0,,!احموا المواطنين
Dialogue: 0,0:16:45.60,0:16:49.67,Main,ALBERT,0,0,0,,!كافحوا بشرف قوّة دفاع السّحرة
Dialogue: 0,0:17:01.88,0:17:03.50,Main,SALLY,0,0,0,,!من هنا! من هنا
Dialogue: 0,0:17:05.95,0:17:07.00,Main,MOTHER,0,0,0,,أين نحن؟
Dialogue: 0,0:17:07.30,0:17:11.12,Main,MAKUSA,0,0,0,,!سحر تكوين الثلج؛ ملاذ رجل الثلج
Dialogue: 0,0:17:12.25,0:17:15.51,Main,MAKUSA,0,0,0,,!أنتما بخير الآن، المكان آمنٌ هنا
Dialogue: 0,0:17:15.75,0:17:17.21,Main,MAKUSA,0,0,0,,!تفضّلا بالدخول
Dialogue: 0,0:17:17.21,0:17:19.35,Main,MOTHER,0,0,0,,شـ-شكرًا جزيلًا لك
Dialogue: 0,0:17:22.71,0:17:26.27,Main,MAKUSA,0,0,0,,،سأخفي المواطنين عن الشياطين بسحر الثلج
Dialogue: 0,0:17:26.36,0:17:28.86,Main,MAKUSA,0,0,0,,بينما ينقلهم فالتوس-سان بسحره المكانيّ
Dialogue: 0,0:17:29.05,0:17:30.00,Main,SEKKE,0,0,0,,!فوها
Dialogue: 0,0:17:30.18,0:17:31.77,Main,SEKKE,0,0,0,,...وإن اكتشفوا أمرنا
Dialogue: 0,0:17:31.77,0:17:33.99,Main,SEKKE,0,0,0,,‫فسأستخدم سحري لإسقاطهم!
Dialogue: 0,0:17:34.15,0:17:35.97,Main,SEKKE,0,0,0,,!لا تكتشفونا... لا تكتشفونا
Dialogue: 0,0:17:35.99,0:17:37.36,Main,SEKKE,0,0,0,,!فوها
Dialogue: 0,0:17:41.70,0:17:45.96,Main,ALBERT,0,0,0,,!سحقًا، إنّهم أقوياء وبأعداد غفيرة
Dialogue: 0,0:18:00.41,0:18:01.99,Main,FUEGOLEON,0,0,0,,...رغم اختلاف ممالكنا
Dialogue: 0,0:18:01.99,0:18:05.10,Main,FUEGOLEON,0,0,0,,فإن رغبتنا في حماية مواطنينا واحدة
Dialogue: 0,0:18:05.33,0:18:06.56,Main,RESISTANCE,0,0,0,,!روح النار
Dialogue: 0,0:18:06.65,0:18:08.53,Main,RESISTANCE,0,0,0,,!يا لروعتها المُهيبة
Dialogue: 0,0:18:20.90,0:18:22.87,Main,MAKUSA,0,0,0,,!هذا سيّئ، اكتشفوا موقعنا
Dialogue: 0,0:18:35.67,0:18:36.80,Main,MAKUSA,0,0,0,,!تبًّا
Dialogue: 0,0:18:46.52,0:18:47.27,Main,MAKUSA,0,0,0,,...ما
Dialogue: 0,0:18:47.27,0:18:48.06,Main,SEKKE,0,0,0,,!فوها؟
Dialogue: 0,0:18:48.66,0:18:51.44,Main,RESISTANCE,0,0,0,,!ما هذا السّحر الجبار الّذي تجلّى للتّو؟
Dialogue: 0,0:18:51.79,0:18:55.69,Main,RESISTANCE,0,0,0,,!استهدف الشياطين وحدها دون أن يمسنا بسوءٍ
Dialogue: 0,0:18:56.29,0:18:57.82,Main,FUEGOLEON,0,0,0,,!أهلًا بقدومكم
Dialogue: 0,0:18:59.02,0:19:02.68,Main,NOELLE,0,0,0,,!لن ندعكم تعيثون فسادًا في هذا العالم
Dialogue: 0,0:19:07.33,0:19:08.99,Main,DRYAD,0,0,0,,!أهلًا وسهلًا
Dialogue: 0,0:19:08.99,0:19:11.77,Main,DRYAD,0,0,0,,!مرحبًا، أنا دوريادي
Dialogue: 0,0:19:11.77,0:19:13.33,Main,DRYAD,0,0,0,,!كنتُ أعلم أنّكم قادمون
Dialogue: 0,0:19:13.57,0:19:15.97,Main,DRYAD,0,0,0,,،بهذا المعدل، ستتدفق الشياطين بأعداد هائلة
Dialogue: 0,0:19:15.97,0:19:19.22,Main,DRYAD,0,0,0,,وستتعرض إليسيا لدمارٍ شاملٍ أيضًا
Dialogue: 0,0:19:19.22,0:19:21.61,Main,DRYAD,0,0,0,,لهذا سأمد لكم يد العون
Dialogue: 0,0:19:21.61,0:19:23.72,Main,NOELLE/MIMOSA/LEOPOLD,0,0,0,,!ليست كما تخيلناها
Dialogue: 0,0:19:23.97,0:19:26.84,Main,PATRY,0,0,0,,ما سنعلمه لكم هو السّحر المُطلق
Dialogue: 0,0:19:27.21,0:19:30.11,Main,PATRY,0,0,0,,...إنّه التجسيد المُطلق لكلّ ما يملكه السّاحر من قوّة
Dialogue: 0,0:19:30.45,0:19:32.51,Main,PATRY,0,0,0,,ممّا يجعله تعويذةً فريدةً لا مثيل لها
Dialogue: 0,0:19:32.51,0:19:34.23,Main,PATRY,0,0,0,,إنّه جوهر السّحر
Dialogue: 0,0:19:34.89,0:19:39.40,Main,PATRY,0,0,0,,،عادةً ما يقتصر استخدامها على نخبة الإيف ذوي المانا الهائلة وحدهم
Dialogue: 0,0:19:39.40,0:19:41.87,Main,PATRY,0,0,0,,فالبشر يفتقرون إلى القدر الكافي من السّحر
Dialogue: 0,0:19:42.47,0:19:44.45,Main,DRYAD,0,0,0,,...غير أنّه
Dialogue: 0,0:19:44.72,0:19:48.98,Main,DRYAD,0,0,0,,...بفضل إتقانكم لأساليب المانا في مملكة هارت
Dialogue: 0,0:19:48.98,0:19:53.68,Main,DRYAD,0,0,0,,!استخلصتم سحرًا حقيقيًّا يرتكز على كمياتٍ هائلةٍ من مانا الطبيعة
Dialogue: 0,0:19:54.86,0:19:58.96,Main,NOELLE,0,0,0,,‫لم تذهب أشهر تدريبنا الستّة ‫‫في مملكة هارت سدى!
Dialogue: 0,0:19:58.96,0:20:02.84,Main,MIMOSA,0,0,0,,...في إليسيا، أدركنا جوهر الأرواح
Dialogue: 0,0:20:02.84,0:20:05.34,Main,CHARMY,0,0,0,,...وقربنا أجسادنا من المانا
Dialogue: 0,0:20:05.34,0:20:08.22,Main,LUCK,0,0,0,,...وبفضل القوّة الخارقة للسّحر الحقيقيّ
Dialogue: 0,0:20:08.45,0:20:10.73,Main,LEOPOLD,0,0,0,,!اكتسبنا السّحر المُطلق
Dialogue: 0,0:20:10.73,0:20:11.98,Main,NOELLE,0,0,0,,سحر الماء
Dialogue: 0,0:20:11.98,0:20:13.23,Main,GAJA/LUCK,0,0,0,,سحر البرق
Dialogue: 0,0:20:13.23,0:20:14.23,Main,SARADO,0,0,0,,سحر الأرض
Dialogue: 0,0:20:14.23,0:20:15.23,Main,CHARMY,0,0,0,,سحر القطن
Dialogue: 0,0:20:15.23,0:20:16.73,Main,MIMOSA/POTROF,0,0,0,,سحر النبات
Dialogue: 0,0:20:16.73,0:20:17.98,Main,SMURIK,0,0,0,,سحر الرياح
Dialogue: 0,0:20:17.98,0:20:19.23,Main,LEOPOLD/FLOGA,0,0,0,,سحر النّار
Dialogue: 0,0:20:19.56,0:20:20.57,Main,ALL,0,0,0,,!المُطلق
Dialogue: 0,0:20:36.74,0:20:38.25,Main,SALLY,0,0,0,,!مُذهل
Dialogue: 0,0:20:38.70,0:20:43.13,Main,SALLY,0,0,0,,!يستخدمون تلك التعاويذ لتفادي إصابة حُلفائهم
Dialogue: 0,0:20:43.13,0:20:44.91,Main,SALLY,0,0,0,,ما الّذي حدث يا ترى؟
Dialogue: 0,0:20:44.91,0:20:46.65,Main,SALLY,0,0,0,,كيف تعمل يا ترى؟
Dialogue: 0,0:20:46.65,0:20:49.91,Main,SALLY,0,0,0,,!أتساءل إن كانوا سيسمحون لي بدراستها لاحقًا
Dialogue: 0,0:20:49.91,0:20:52.14,Main,NOELLE,0,0,0,,!انتظري فحسب يا فانيكا
Dialogue: 0,0:20:57.43,0:21:01.75,Main,MID-LEVEL DEVIL 1,0,0,0,,!أيّها الحمقى العاجزون، تتدافعون للخروج أولًا
Dialogue: 0,0:21:01.75,0:21:04.63,Main,MID-LEVEL DEVIL 2,0,0,0,,ما الّذي يُخيفكم يا ترى؟
Dialogue: 0,0:21:07.18,0:21:08.73,Main,MID-LEVEL DEVIL 2,0,0,0,,‫لنلعب التقاط الكرة!
Dialogue: 0,0:21:08.73,0:21:10.41,Main,MID-LEVEL DEVIL 2,0,0,0,,!ستكون أنتَ الكرة
Dialogue: 0,0:21:10.65,0:21:12.06,Main,LUCK,0,0,0,,...إنّهم
Dialogue: 0,0:21:12.06,0:21:13.04,Main,MIMOSA,0,0,0,,أجل
Dialogue: 0,0:21:13.04,0:21:14.84,Main,MIMOSA,0,0,0,,!شياطين ذوات رتبة متوسطة
Dialogue: 0,0:21:14.84,0:21:19.92,Main,MID-LEVEL DEVIL 3,0,0,0,,!اللّعب مع التهام هذه المانا الشهيّة أمرٌ لا يُعلى عليه
Dialogue: 0,0:21:19.92,0:21:25.05,Main,MID-LEVEL DEVIL 1,0,0,0,,لكن اللّعب مع البشر سيكون أكثر متعةً حتمًا
Dialogue: 0,0:21:26.99,0:21:29.61,Main,MID-LEVEL DEVIL 1,0,0,0,,!هيّا، لنلعب أيّها البشر
Dialogue: 0,0:21:29.61,0:21:32.39,Main,MID-LEVEL DEVIL 1,0,0,0,,!أسمعونا صرخاتكم العذبة
Dialogue: 0,0:21:38.19,0:21:41.32,Main,LUCK,0,0,0,,!يبدو أنّي وجدتُ خصومًا مثاليّين للعب معهم
Dialogue: 0,0:21:41.50,0:21:45.17,Main,LUCK,0,0,0,,...لنكتشف معًا مبلغ بأس سحري المُطلق
Dialogue: 0,0:21:45.86,0:21:49.26,Main,LUCK,0,0,0,,!باللّعب مع أولئك
Dialogue: 0,0:22:01.29,0:22:02.86,Main,MID-LEVEL DEVIL 3,0,0,0,,!ما خطب هذا الفتى؟
Dialogue: 0,0:22:02.89,0:22:04.15,Main,MID-LEVEL DEVIL 3,0,0,0,,!متى ظهر
Dialogue: 0,0:22:04.68,0:22:06.90,Main,LUCK,0,0,0,,سحر البرق المُطلق؛
Dialogue: 0,0:22:07.46,0:22:10.26,Main,LUCK,0,0,0,,!إمبراطور البرق القاطع
Dialogue: 0,0:22:13.24,0:22:14.91,Main,LUCK,0,0,0,,ماذا؟
Dialogue: 0,0:22:15.03,0:22:18.47,Main,LUCK,0,0,0,,!إن كنتم عاجزين عن رؤيتي، فلا مجال للعب إذن
